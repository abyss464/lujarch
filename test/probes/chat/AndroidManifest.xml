<?xml version="1.0" encoding="utf-8"?>
<!-- A messaging app: conversations it offers as bubbles, and notifications that open it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lujarch.probe.chat"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Probe chat"
        android:icon="@mipmap/ic_chat"
        android:debuggable="true"
        android:allowBackup="false">

        <activity
            android:name=".Chat"
            android:exported="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:label="Probe chat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".Post" android:exported="true">
            <intent-filter>
                <action android:name="org.lujarch.probe.chat.POST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
