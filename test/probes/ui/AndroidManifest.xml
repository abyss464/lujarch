<?xml version="1.0" encoding="utf-8"?>
<!-- The screen reader of the tests: an instrumentation that keeps the accessibility tree of the
     screen one connection away, without waiting for the screen to be still. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lujarch.probe.ui"
    android:versionCode="1"
    android:versionName="1.0">

    <application android:label="Probe screen reader" android:hasCode="true" />

    <instrumentation
        android:name=".Server"
        android:targetPackage="org.lujarch.probe.ui" />
</manifest>
