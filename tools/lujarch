# Tree: pins, sync, patches


def cmd_pin(_args):
    host = Host()
    revert_patches(host.tree)
    out = subprocess.run(["repo", "manifest", "-r", "-o", str(ROOT / "upstream.xml")],
                         cwd=host.tree, capture_output=True, text=True)
    if out.returncode:
        die(f"repo manifest failed:\n{out.stderr.strip()}")
    count = (ROOT / "upstream.xml").read_text(encoding="utf-8").count("<project ")
    log(f"upstream.xml: {count} projects at the tree's commits")
    apply_patches(host.tree)
    return 0


# In the tree, each patch is one commit on top of its project's pinned commit. Only commits made
# here count as patch commits: committed at time 0 by PATCH_IDENTITY, with the patch's path as
# subject and the hash of the file they were made from as PATCH_TRAILER. The files are the source;
# the commits are rebuilt from them whenever they differ.
PATCH_IDENTITY = {
    "GIT_AUTHOR_NAME": "Lujarch", "GIT_AUTHOR_EMAIL": "patches@lujarch",
    "GIT_AUTHOR_DATE": "@0 +0000", "GIT_COMMITTER_NAME": "Lujarch",
    "GIT_COMMITTER_EMAIL": "patches@lujarch", "GIT_COMMITTER_DATE": "@0 +0000",
}
PATCH_TRAILER = "Patch-Blob"
APPLYING = "lujarch-applying"
EXPORT = ["-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
          "-c", "diff.relative=false", "-c", "core.quotePath=true",
          "diff", "--no-color", "--no-ext-diff", "--no-textconv", "--no-renames",
          "--binary", "--full-index"]
PATCH_NAME_RE = re.compile(r"^\d{4}-[a-z0-9]+(?:-[a-z0-9]+)*\.patch$")


def order_entries():
    path = SYSTEM / "order"
    if not path.exists():
        return []
    return [l.strip() for l in path.read_text(encoding="utf-8").split("\n") if l.strip()]


TOOL_PATCHES = ROOT / "tools" / "patches"


def patch_dirs():
    """The patch directories in application order, as (entry, patches/ path): the build
    system's own, which reach no image, then those of system/order."""
    result = [("tools", TOOL_PATCHES)] if TOOL_PATCHES.is_dir() else []
    for entry in order_entries():
        pdir = SYSTEM / entry / "patches"
        if not pdir.is_dir():
            die(f"system/order: {entry} has no patches/ directory")
        result.append((entry, pdir))
    return result


def patch_series():
    """Every patch in application order, as (patch file, project path)."""
    series = []
    for _, pdir in patch_dirs():
        for p in sorted(pdir.rglob("*.patch")):
            series.append((p, p.parent.relative_to(pdir).as_posix()))
    return series


def series_by_project():
    series = {}
    for patch, project in patch_series():
        series.setdefault(project, []).append(patch)
    return series


def upstream_projects():
    """Every project of upstream.xml as {tree path: pinned commit}."""
    text = (ROOT / "upstream.xml").read_text(encoding="utf-8")
    projects = {}
    for tag in re.findall(r"<project\s[^>]*>", text):
        name = re.search(r'\bname="([^"]+)"', tag)
        path = re.search(r'\bpath="([^"]+)"', tag)
        revision = re.search(r'\brevision="([0-9a-f]{40})"', tag)
        if name and revision:
            projects[(path or name).group(1)] = revision.group(1)
    return projects


def pgit(where, *args, env=None, input=None, check=False):
    run = subprocess.run(["git", "-C", str(where), *args], capture_output=True, text=True,
                         encoding="utf-8", errors="replace", env=env, input=input)
    if check and run.returncode:
        die(f"git {args[0]} in {where}: {run.stderr.strip()}")
    return run


def blob_id(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def patch_message(patch, data):
    return f"{rel(patch)}\n\n{PATCH_TRAILER}: {blob_id(data)}\n"


def git_dir(where):
    return Path(pgit(where, "rev-parse", "--absolute-git-dir", check=True).stdout.strip())


def changes(where):
    """The project's changes. A repository of its own checked out inside the project (a project of
    upstream.xml, such as KernelSU-Next in the kernel) is none of them."""
    lines = pgit(where, "status", "--porcelain").stdout.strip().split("\n")
    return "\n".join(l for l in lines if l and not (
        l.startswith("?? ") and l.endswith("/") and (where / l[3:] / ".git").exists()))


def unmerged(where):
    return sorted(set(pgit(where, "diff", "--name-only", "--diff-filter=U").stdout.split()))


def diff_bytes(where, *revs):
    run = subprocess.run(["git", "-C", str(where), *EXPORT, *revs], capture_output=True)
    if run.returncode:
        die(f"git diff in {where}: {run.stderr.decode(errors='replace').strip()}")
    return run.stdout


def project_heads(tree, projects):
    def head(project):
        out = pgit(tree / project, "rev-parse", "HEAD")
        return project, out.stdout.strip() if out.returncode == 0 else None
    with ThreadPoolExecutor(16) as pool:
        return dict(pool.map(head, projects))


def commits_since(where, base):
    """The commits from base to HEAD, oldest first, as (commit, subject, blob, made here)."""
    out = pgit(where, "log", "--reverse", "--format=%H%x1f%ct%x1f%B%x1e", f"{base}..HEAD",
               check=True)
    result = []
    for record in out.stdout.split("\x1e"):
        record = record.strip("\n")
        if not record.strip():
            continue
        commit, ctime, body = record.split("\x1f", 2)
        m = re.search(rf"^{PATCH_TRAILER}: ([0-9a-f]{{40}})$", body, re.MULTILINE)
        result.append((commit, body.split("\n", 1)[0], m and m.group(1),
                       ctime == "0" and m is not None))
    return result


def patch_base(where):
    """The upstream commit under a project's patch commits, and those commits, oldest first."""
    out = pgit(where, "log", "--first-parent", "--format=%H%x1f%ct%x1f%B%x1e", "HEAD",
               check=True)
    for record in out.stdout.split("\x1e"):
        record = record.strip("\n")
        if not record.strip():
            continue
        commit, ctime, body = record.split("\x1f", 2)
        if ctime != "0" or not re.search(rf"^{PATCH_TRAILER}: ", body, re.MULTILINE):
            return commit, commits_since(where, commit)
    die(f"{where}: no upstream commit under its patch commits")


def in_sync(made, patch):
    _, subject, blob, ours = made
    return ours and subject == rel(patch) and blob == blob_id(patch.read_bytes())


def commit_index(where, message):
    """Commit the project's index on HEAD the way patch commits are made."""
    tree = pgit(where, "write-tree", check=True).stdout.strip()
    commit = pgit(where, "commit-tree", tree, "-p", "HEAD", "-F", "-",
                  env={**os.environ, **PATCH_IDENTITY}, input=message, check=True).stdout.strip()
    pgit(where, "update-ref", "--no-deref", "HEAD", commit, check=True)
    return commit


def conflict_files(where, resolving=False):
    """Files a patch still conflicts in: leftover markers, rejected hunks, and, until the
    resolution starts, unmerged paths."""
    found = set() if resolving else set(unmerged(where))
    rejects = pgit(where, "ls-files", "--others", "--", "*.rej").stdout.split("\n")
    found |= {r for r in rejects if r}
    listed = pgit(where, "diff", "--name-only", "HEAD").stdout.split("\n")
    listed += pgit(where, "ls-files", "--others", "--exclude-standard").stdout.split("\n")
    for name in filter(None, listed):
        text = read_text(where / name)
        if text and re.search(r"^(<{7}|>{7}) ", text, re.MULTILINE):
            found.add(name)
    return sorted(found)


def apply_one(where, patch):
    """Apply one patch as a commit. On a conflict, leave it in the tree to be resolved."""
    data = patch.read_bytes()
    run = pgit(where, "apply", "--3way", "--whitespace=nowarn", str(patch))
    if run.returncode == 0 and not unmerged(where):
        commit_index(where, patch_message(patch, data))
        return True
    if not unmerged(where) and not changes(where):
        # No three-way merge without the blobs the patch was made from: apply what fits.
        pgit(where, "apply", "--reject", "--whitespace=nowarn", str(patch))
    (git_dir(where) / APPLYING).write_text(rel(patch) + "\n")
    return False


def finish_applying(where, project, wanted):
    marker = git_dir(where) / APPLYING
    patch = ROOT / marker.read_text().strip()
    if patch not in wanted:
        die(f"{project}: {rel(patch)} is being resolved but is no longer a patch of it; "
            f"drop the resolution with git -C {where} reset --hard, delete {marker}")
    left = conflict_files(where, resolving=True)
    if left:
        die(f"{project}: {rel(patch)} still conflicts in " + ", ".join(left))
    pgit(where, "add", "-A", check=True)
    data = diff_bytes(where, "--cached", "HEAD")
    if not data:
        die(f"{project}: the resolution of {rel(patch)} changes nothing")
    patch.write_bytes(data)
    commit_index(where, patch_message(patch, data))
    marker.unlink()
    log(f"{project}: {rel(patch)} resolved and saved")


def apply_patches(tree):
    """Bring every project to its pinned commit plus its patches, one commit per patch."""
    pins = upstream_projects()
    series = series_by_project()
    for project in series:
        if project not in pins:
            die(f"patches for {project}, which upstream.xml does not have")
    heads = project_heads(tree, pins)
    applied = kept = 0
    for project, pinned in pins.items():
        wanted = series.get(project, [])
        if not wanted and heads[project] == pinned:
            continue
        where = tree / project
        if heads[project] is None:
            die(f"{project} is not in the tree (lujarch sync)")
        if (git_dir(where) / APPLYING).exists():
            finish_applying(where, project, wanted)
        elif changes(where):
            die(f"{project} has changes no patch holds: lujarch save them, or discard them")
        base, made = patch_base(where)
        if base != pinned:
            die(f"{project} is on {base[:12]}, upstream.xml pins {pinned[:12]} (lujarch sync)")
        k = 0
        while k < min(len(made), len(wanted)) and in_sync(made[k], wanted[k]):
            k += 1
        if k < len(made):
            pgit(where, "checkout", "-q", "--detach", made[k - 1][0] if k else pinned, check=True)
        kept += k
        for patch in wanted[k:]:
            if not apply_one(where, patch):
                die(f"{rel(patch)} does not apply cleanly to {project}. Resolve these files in "
                    f"{where}, then run lujarch patch again:\n  "
                    + "\n  ".join(conflict_files(where) or ["(nothing applied)"]))
            applied += 1
            log(f"applied {rel(patch)}")
    if applied or kept:
        log(f"patches: {applied} applied, {kept} already in the tree")


def settled_projects(tree, pins):
    """The patched projects already at their pin with exactly their patches, as patch commits made
    from the same patch files, and nothing else changed. A sync has nothing to do there: moving
    them would only touch every file their patches change, and so rebuild it."""
    heads = project_heads(tree, pins)
    settled = set()
    for project, wanted in series_by_project().items():
        pinned, where = pins.get(project), tree / project
        if pinned is None or heads.get(project) in (None, pinned) or changes(where) \
                or (git_dir(where) / APPLYING).exists():
            continue
        base, made = patch_base(where)
        if base == pinned and len(made) == len(wanted) and all(map(in_sync, made, wanted)):
            settled.add(project)
    return settled


def revert_patches(tree, keep=()):
    """Bring every project but those in keep back to the upstream commit under its patch
    commits."""
    pins = upstream_projects()
    heads = project_heads(tree, pins)
    for project, pinned in pins.items():
        if heads[project] in (None, pinned) or project in keep:
            continue
        where = tree / project
        if (git_dir(where) / APPLYING).exists():
            die(f"{project}: a patch is being resolved there; finish it with lujarch patch")
        if changes(where):
            die(f"{project} has changes no patch holds: lujarch save them, or discard them")
        base, made = patch_base(where)
        if made:
            pgit(where, "checkout", "-q", "--detach", base, check=True)
            log(f"reverted {len(made)} patch{'es' if len(made) > 1 else ''} in {project}")


EXTRA_MANIFEST = ".lujarch-files"


def extra_files(host):
    """vendor/extra as the tools stage it: every feature and device directory without its
    patches and tests, each device's files from its stock release, what the features' scripts
    generate, what the tools generate from system/ and git (the renames' overlays, the settings
    mirror, the version's init file), and the two makefiles LineageOS includes from
    vendor/extra."""
    files = {}
    for device, pin in lock_file().get("stock", {}).items():
        dump = stock_dump_dir(host, pin)
        if not pin.get("files"):
            continue
        if not (dump / STOCK_UNPACKED).is_file():
            die(f"{device} takes files from {pin['release']}, which is not unpacked: "
                f"lujarch stock {device}")
        for name, digest in sorted(pin.get("files", {}).items()):
            src = dump / name
            data = src.read_bytes() if src.is_file() else None
            if data is None or hashlib.sha256(data).hexdigest() != digest:
                die(f"{device}: {name} of {pin['release']} is missing or differs from lock.toml")
            files[f"device/{device}/stock/{name}"] = data
    features, devices = [], []
    tracked = set(repo_files())
    for kind, found in (("features", features), ("device", devices)):
        base = SYSTEM / kind
        for d in sorted(p for p in base.iterdir() if p.is_dir()) if base.is_dir() else []:
            staged = False
            for src in sorted(p for p in tracked if d in p.parents):
                inner = src.relative_to(d)
                if inner.parts[0] in ("patches", "tests", "components") or src.name == ".gitkeep":
                    continue
                files[f"{kind}/{d.name}/{inner.as_posix()}"] = src.read_bytes()
                staged = True
            if staged:
                found.append(d.name)
    files.update(component_files(host))
    files.update(prebuilt_files(host))
    files.update(generated_files(host))
    files.update(download_files())
    if not files:
        return {}

    def products(name):
        meta = SYSTEM / "features" / name / "feature.toml"
        only = load_toml(meta).get("devices") if meta.is_file() else None
        return [device_config(d)["product"] for d in only] if only else None

    def guarded(makefile, line, head=()):
        out = list(head)
        ordered = sorted(features, key=lambda f: (f != "core", f))
        for name in ordered:
            if f"features/{name}/{makefile}" not in files:
                continue
            only = products(name)
            if only:
                out.append(f"ifneq ($(filter {' '.join(only)},$(TARGET_PRODUCT)),)")
            out.append(line.format(path=f"vendor/extra/features/{name}/{makefile}"))
            if only:
                out.append("endif")
        for name in devices:
            if f"device/{name}/{makefile}" in files:
                out += [f"ifeq ($(TARGET_PRODUCT),{device_config(name)['product']})",
                        line.format(path=f"vendor/extra/device/{name}/{makefile}"), "endif"]
        return "# Generated by tools/lujarch from system/.\n" + "\n".join(out) + "\n"

    if "features/core/Android.bp" in files:
        files["features/core/generated/settings-mirror.txt"] = settings_mirror().encode()
        files["features/core/generated/Android.bp"] = settings_libraries(features).encode()
    files.update(rename_files(host, features))
    if "features/branding/Android.bp" in files:
        files["features/branding/generated/version.rc"] = version_rc()
    arch = []
    for path in sorted((SYSTEM / "device").glob("*/device.toml")):
        config = load_toml(path)
        arch += [f"ifeq ($(TARGET_PRODUCT),{config['product']})",
                 f"LUJARCH_ARCH := {config.get('arch', 'arm64')}", "endif"]
    files["product.mk"] = guarded("product.mk", "$(call inherit-product, {path})",
                                  head=arch).encode()
    files["BoardConfigExtra.mk"] = guarded("board.mk", "include {path}").encode()
    return files


