def host_package(host, tree):
    """The Cuttlefish host tools, unpacked from the vm build's cvd-host_package.tar.gz."""
    package = tree / "out" / "host" / "linux-x86" / "cvd-host_package.tar.gz"
    if not package.is_file():
        die(f"no {package}: lujarch build vm")
    target = host.out / "vm" / "host"
    stamp = target / ".package-mtime"
    mtime = str(package.stat().st_mtime_ns)
    # Every virtual device starts from these tools: one start unpacks them while the others wait.
    target.parent.mkdir(parents=True, exist_ok=True)
    with open(target.parent / ".host.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if stamp.is_file() and stamp.read_text() == mtime:
            return target
        if target.exists():
            shutil.rmtree(target)
        target.mkdir(parents=True)
        log(f"unpacking the Cuttlefish host tools into {target}")
        if subprocess.run(["tar", "-xzf", str(package), "-C", str(target)]).returncode:
            die(f"could not unpack {package}")
        stamp.write_text(mtime)
    return target


def vm_paths(host):
    """The vm build, its unpacked host tools, the runtime home and the host-capability stand-in."""
    info_path = device_info_path(host, "vm")
    if not info_path.is_file():
        die("no vm build: lujarch build vm")
    info = json.loads(info_path.read_text())
    base = host.out / "vm"
    home = host.out / VM_DIR / "home"
    home.mkdir(parents=True, exist_ok=True)
    # Cuttlefish asks Debian's cuttlefish-common package whether the host can run its VM
    # managers; the container provides everything that package would.
    common = base / "cuttlefish-common"
    query = common / "capability_query.py"
    if not query.is_file():
        common.mkdir(parents=True, exist_ok=True)
        query.write_text("#!/bin/sh\nexit 0\n")
        query.chmod(0o755)
    # Cuttlefish gives its files to the groups Debian's package creates; in the container they
    # are the user's own group.
    group = base / "group"
    gid = os.getgid()
    own = ("cvdnetwork", "kvm")
    lines = [l for l in Path("/etc/group").read_text().split("\n")
             if l.strip() and l.split(":", 1)[0] not in own]
    lines += [f"{name}:x:{gid}:" for name in own]
    group.write_text("\n".join(lines) + "\n")
    return info, host_package(host, host.tree), home, common


def container_state():
    out = subprocess.run(["docker", "inspect", "-f", "{{.State.Status}}", VM_CONTAINER],
                         capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else None


def adb_binary(host_out):
    built = host_out / "bin" / "adb"
    return str(built) if built.is_file() else "adb"


def adb(host_out, *args, timeout=30, input=None):
    return subprocess.run([adb_binary(host_out), "-s", f"127.0.0.1:{ADB_PORT}", *args],
                          capture_output=True, text=True, timeout=timeout, input=input)


def booted(host_out):
    subprocess.run([adb_binary(host_out), "connect", f"127.0.0.1:{ADB_PORT}"],
                   capture_output=True, text=True, timeout=30)
    try:
        out = adb(host_out, "shell", "getprop", "sys.boot_completed")
    except subprocess.TimeoutExpired:
        return False
    return out.returncode == 0 and out.stdout.strip() == "1"


def wait_booted(host_out, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if container_state() != "running":
            return False
        if booted(host_out):
            return True
        crash = system_server_crash(host_out)
        if crash:
            die(f"the system server keeps dying while the device starts: {crash}")
        time.sleep(5)
    return False


# How often the system server starts, from the start of the device or from a restart of the
# framework, before it is taken to keep dying.
SYSTEM_SERVER_STARTS = 3


def system_server_starts(host_out):
    """How often the system server has started since the device started, or None."""
    try:
        said = adb(host_out, "shell", "getprop", "sys.system_server.start_count", timeout=10)
    except subprocess.TimeoutExpired:
        return None
    count = said.stdout.strip()
    return int(count) if said.returncode == 0 and count.isdigit() else None


def system_server_crash(host_out, before=0):
    """When the system server has started SYSTEM_SERVER_STARTS times since it had started before
    times, how often it started and the crash that ended the first of those starts, from the
    crash log (its last lines when it names no such crash); else None."""
    count = system_server_starts(host_out)
    if count is None or count - before < SYSTEM_SERVER_STARTS:
        return None
    starts = adb(host_out, "logcat", "-d", "-b", "events", "-s", "system_server_start",
                 timeout=60).stdout
    pids = [pid for pid, n in re.findall(
        r"^\S+ \S+\s+(\d+)\s+\d+ I system_server_start: \[(\d+),", starts, re.M) if int(n) > before]
    crash = adb(host_out, "logcat", "-d", "-b", "crash", timeout=60).stdout.split("\n")

    def written_by(pid):
        return [line for line in crash if line.split()[2:3] == [pid]]

    for pid in pids:
        lines = written_by(pid)
        # A native crash is written by the crash dumper, which names the process it dumps.
        dumper = next((line.split()[2] for line in crash if f"pid: {pid}, " in line), None)
        lines = lines or (written_by(dumper) if dumper else [])
        # The runtime repeats a crash it could not report.
        lines = lines[:next((i for i, line in enumerate(lines) if "Couldn't report crash" in line),
                            len(lines))]
        if lines:
            return f"it started {count} times; its crash as process {pid}:\n" + "\n".join(
                lines[:40])
    return f"it started {count} times; the crash log ends:\n" + "\n".join(crash[-30:])


def screen_nodes(host_out):
    """The on-screen elements as (text, centre x, centre y), from a uiautomator dump."""
    adb(host_out, "shell", "uiautomator", "dump", "/data/local/tmp/ui.xml")
    xml = adb(host_out, "shell", "cat", "/data/local/tmp/ui.xml").stdout
    nodes = []
    for node in re.findall(r"<node [^>]*>", xml):
        text = re.search(r' text="([^"]*)"', node)
        bounds = re.search(r'bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"', node)
        if text and bounds:
            x1, y1, x2, y2 = map(int, bounds.groups())
            nodes.append((text.group(1), (x1 + x2) // 2, (y1 + y2) // 2))
    return nodes


def adb_root(host_out):
    """Restarts adbd as root unless it runs as root; true when it does."""
    if adb(host_out, "shell", "id", "-u").stdout.strip() == "0":
        return True
    adb(host_out, "root")
    for _ in range(12):
        time.sleep(2)
        subprocess.run([adb_binary(host_out), "connect", f"127.0.0.1:{ADB_PORT}"],
                       capture_output=True, text=True, timeout=30)
        try:
            if adb(host_out, "shell", "id", "-u").stdout.strip() == "0":
                return True
        except subprocess.TimeoutExpired:
            pass
    return False


def provision(host_out):
    """Leaves a booted virtual device ready for tests: set up, awake while it runs, Developer
    options and Rooted debugging on, adb as root, on the virtual Wi-Fi network."""
    for command in (
        ["settings", "put", "secure", "user_setup_complete", "1"],
        ["settings", "put", "global", "device_provisioned", "1"],
        ["settings", "put", "global", "development_settings_enabled", "1"],
        # LineageOS' setup wizard comes back at every start while it is enabled.
        ["pm", "disable-user", "--user", "0", "org.lineageos.setupwizard"],
        ["svc", "power", "stayon", "true"],
        ["input", "keyevent", "KEYCODE_WAKEUP"],
        ["wm", "dismiss-keyguard"],
    ):
        adb(host_out, "shell", *command)
    if not adb_root(host_out):
        # Rooted debugging is switched only by the system user, through its Developer options row.
        adb(host_out, "shell", "am", "start", "-W", "-a",
            "android.settings.APPLICATION_DEVELOPMENT_SETTINGS")
        for _ in range(10):
            row = [n for n in screen_nodes(host_out) if n[0] == "Rooted debugging"]
            if row:
                adb(host_out, "shell", "input", "tap", str(row[0][1]), str(row[0][2]))
                break
            adb(host_out, "shell", "input", "swipe", "540", "1600", "540", "700", "300")
            time.sleep(1)
        else:
            die("Rooted debugging is not in Developer options")
        if not adb_root(host_out):
            die("adb does not run as root after Rooted debugging was turned on")
    # Wi-Fi takes a while to come up after a start; it is joined once it is on.
    for _ in range(30):
        status = adb(host_out, "shell", "cmd", "wifi", "status").stdout
        if 'connected to "VirtWifi"' in status:
            break
        if "Wifi is enabled" in status:
            adb(host_out, "shell", "cmd", "wifi", "connect-network", "VirtWifi", "open")
        time.sleep(2)
    else:
        log("the virtual device did not join its Wi-Fi network")
    adb(host_out, "shell", "am", "start", "-a", "android.intent.action.MAIN",
        "-c", "android.intent.category.HOME")


BOOT_IMAGE = "dex_bootjars"
BOOT_CLASSPATH = "system/etc/classpaths/bootclasspath.pb"


def proto_fields(data):
    """The (number, value) of each varint and length-delimited field of a protobuf message."""
    i = 0

    def varint():
        nonlocal i
        value = shift = 0
        while True:
            byte = data[i]
            i += 1
            value |= (byte & 0x7F) << shift
            shift += 7
            if byte < 0x80:
                return value

    while i < len(data):
        key = varint()
        if key & 7 == 0:
            yield key >> 3, varint()
        elif key & 7 == 2:
            size = varint()
            yield key >> 3, data[i:i + size]
            i += size
        else:
            die(f"protobuf wire type {key & 7} is not read")


def boot_classpath(product):
    """The image's boot classpath jars, as paths from the root, from the classpath configuration
    the system derives its BOOTCLASSPATH from (ExportedClasspathsJars, Jar.path)."""
    config = product / BOOT_CLASSPATH
    if not config.is_file():
        die(f"no {config}: the device's full build writes it")
    return {path.decode() for number, jar in proto_fields(config.read_bytes()) if number == 1
            for field, path in proto_fields(jar) if field == 1}


INIT_RC = re.compile(r"/etc/init/[^/]+\.rc$")


class Modules:
    """A product's modules, from its module-info.json, and the files each installs into the image
    (paths relative to the product directory)."""

    def __init__(self, host, product):
        self.dir = product
        self.info = json.loads((product / "module-info.json").read_text())
        self.tree_product = os.path.relpath(product, host.tree)

    def own(self, name):
        rels = (os.path.relpath(path, self.tree_product)
                for path in self.info.get(name, {}).get("installed") or [])
        return [rel for rel in rels if not rel.startswith("..") and rel.split("/", 1)[0] not in (
            "system_other", "fake_packages", "obj", "testcases", "data", "symbols")]

    def installs(self, names):
        """What these modules and the modules they require install."""
        files, seen, queue = [], set(), list(names)
        while queue:
            name = queue.pop()
            if name in seen or name not in self.info:
                continue
            seen.add(name)
            queue += self.info[name].get("required") or []
            for rel in self.own(name):
                if rel not in files:
                    files.append(rel)
        return files

    def services(self, files):
        """The init services of the modules that install or require one of these files, each
        with those files."""
        wanted, found = set(files), {}
        for name, entry in self.info.items():
            if not any(INIT_RC.search(path) for path in entry.get("installed") or []):
                continue
            needs = wanted.intersection(self.installs([name]))
            if not needs:
                continue
            # A module the image does not hold has no service in the device.
            for rc in (r for r in self.own(name) if INIT_RC.search(r) and (self.dir / r).is_file()):
                for line in (self.dir / rc).read_text().split("\n"):
                    words = line.split()
                    if len(words) > 2 and words[0] == "service":
                        found.setdefault(words[1], set()).update(needs)
        return found


def module_files(mods, modules):
    """The modules to build and copy for the named ones, the files they install into the image
    with the modules they require, and the names module-info.json does not know. The runtime uses
    the boot image only with the jars it was compiled from, so a module of the boot image unit
    (the boot image and the boot classpath jars of the system partition) brings the whole unit."""
    named = [m for m in dict.fromkeys(modules) if m in mods.info]
    unknown = [m for m in dict.fromkeys(modules) if m not in mods.info]
    jars = {os.path.join(mods.tree_product, p.lstrip("/")) for p in boot_classpath(mods.dir)
            if p.startswith("/system/")}
    unit = [BOOT_IMAGE, *sorted(name for name, entry in mods.info.items()
                                if jars.intersection(entry.get("installed") or []))]
    if set(mods.installs(named)).intersection(rel for name in unit for rel in mods.own(name)):
        named += [m for m in unit if m not in named]
    return named, mods.installs(named), unknown


# What the virtual device boots, by product directory, with the list its image is packed with
# (Name, and SHA256 of the file or of a link's target). launch_cvd rewrites super.img when it
# first starts from it, so an image's time does not tell what it holds; its list does.
VM_PARTITIONS = {
    "system": "installed-files.json", "system_ext": "installed-files-system_ext.json",
    "product": "installed-files-product.json", "vendor": "installed-files-vendor.json",
    "odm": "installed-files-odm.json", "system_dlkm": "installed-files-system_dlkm.json",
    "vendor_dlkm": "installed-files-vendor_dlkm.json",
    "odm_dlkm": "installed-files-odm_dlkm.json",
}
# The ramdisks of the boot images, which only a build packs: vm sync cannot copy into them.
VM_RAMDISKS = {
    "ramdisk": "installed-files-ramdisk.json",
    "vendor_ramdisk": "installed-files-vendor-ramdisk.json",
}


def unpacked_files(info):
    """The files installed into the directories the virtual device boots from since the images
    were packed, by module builds, that the images lack or hold with other content (paths
    relative to the product directory). A file installed before the last full build and left out
    of its images is none of the product's."""
    product = Path(info["product_out"])
    found = []
    for part, listing in {**VM_PARTITIONS, **VM_RAMDISKS}.items():
        try:
            held = {e["Name"]: e["SHA256"] for e in json.loads((product / listing).read_text())}
            since = info.get("packed") or (product / listing).stat().st_mtime
        except OSError:
            continue
        for top, dirs, names in os.walk(product / part):
            for name in names + [d for d in dirs if os.path.islink(os.path.join(top, d))]:
                path = Path(top) / name
                if path.lstat().st_mtime <= since:
                    continue
                if path.is_symlink():
                    digest = hashlib.sha256(os.readlink(path).encode()).hexdigest()
                else:
                    digest = sha256_file(path)
                rel = path.relative_to(product).as_posix()
                if held.get("/" + rel) != digest:
                    found.append(rel)
    return sorted(found)


def listed(files, most=20):
    return "\n".join([f"  {f}" for f in files[:most]]
                     + ([f"  and {len(files) - most} more"] if len(files) > most else []))


# What reads a file of the image, by its path in its partition, and so what makes the running
# device use a new copy. Init and the kernel read these only when the device starts:
READ_AT_START = ("etc/init/", "etc/selinux/", "etc/vintf/", "etc/classpaths/",
                 "etc/linker.config.pb", "framework/", "apex/", "lib/modules/")
# The framework reads its packages and the system configuration when it starts:
READ_BY_FRAMEWORK = ("app/", "priv-app/", "overlay/", "etc/permissions/", "etc/sysconfig/",
                     "etc/default-permissions/")
# A process keeps the programs and libraries it started with:
CODE = ("bin/", "xbin/", "lib/", "lib64/")


def partition_path(rel):
    return rel.split("/", 1)[-1]


def device_differs(host_out, product, files):
    """The files the running device lacks or holds with other content than the built ones."""
    script = ('while read -r f; do if [ -L "$f" ]; then echo "L $(readlink "$f")"; '
              'elif [ -f "$f" ]; then sha256sum "$f" | cut -d " " -f 1; else echo -; fi; done')
    read = adb(host_out, "shell", script, input="".join(f"/{f}\n" for f in files), timeout=600)
    held = read.stdout.split("\n")[:len(files)]
    if read.returncode or len(held) != len(files):
        die(f"could not read the device's copies: {read.stderr.strip()}")

    def built(rel):
        path = product / rel
        return f"L {os.readlink(path)}" if path.is_symlink() else sha256_file(path)

    return [f for f, copy in zip(files, held) if copy != built(f)]


def moved_resource_ids(host, host_out, product, files):
    """Of these files, the framework's resource packages (the .apk files of a partition's
    framework/) whose built copy gives one of the device copy's resource ids to another resource
    or to none, with how many: the apps and the system server hold those ids as compiled."""
    packages = [f for f in files
                if partition_path(f).startswith("framework/") and f.endswith(".apk")]
    if not packages:
        return []
    aapt2 = host.tree / "out" / "host" / "linux-x86" / "bin" / "aapt2"
    if not aapt2.is_file():
        die(f"no {aapt2}, which reads resource ids: lujarch build vm aapt2")

    def ids(apk):
        dump = subprocess.run([str(aapt2), "dump", "resources", str(apk)], capture_output=True,
                              text=True)
        if dump.returncode:
            die(f"aapt2 dump resources {apk}: {dump.stderr.strip()}")
        return dict(re.findall(r"^\s+resource (0x[0-9a-f]{8}) (\S+)", dump.stdout, re.M))

    moved = []
    with tempfile.TemporaryDirectory() as tmp:
        for rel in packages:
            copy = Path(tmp) / Path(rel).name
            pull = adb(host_out, "pull", "/" + rel, str(copy), timeout=300)
            said = (pull.stdout + pull.stderr).strip()
            if pull.returncode and "No such file" in said:
                continue
            if pull.returncode:
                die(f"adb pull /{rel}: {said}")
            held, built = ids(copy), ids(product / rel)
            count = sum(1 for number, name in held.items() if built.get(number) != name)
            if count:
                moved.append(f"{rel} ({count} ids)")
    return moved


def stale_code(host_out, files):
    """The processes that run a copy of these programs or libraries other than the one in place,
    which they started with before it was replaced, as 'NAME (PID): PATH'."""
    paths = {"/" + f for f in files if partition_path(f).startswith(CODE)}
    if not paths:
        return []
    patterns = [arg for path in sorted(paths) for arg in ("-e", f" {path} (deleted)")]
    maps = adb(host_out, "shell", shlex.join(["grep", "-H", "-F", *patterns])
               + " /proc/[0-9]*/maps 2>/dev/null").stdout
    found = {}
    for line in maps.split("\n"):
        where, _, entry = line.partition(":")
        path = entry.split(None, 5)[-1].removesuffix(" (deleted)") if entry else ""
        if path in paths:
            found[where.split("/")[2]] = path
    names = dict(line.split(None, 1) for line in adb(
        host_out, "shell", "ps", "-A", "-o", "PID,NAME").stdout.split("\n")[1:] if line.strip())
    return [f"{names.get(pid, '?')} ({pid}): {path}" for pid, path in sorted(found.items())]


def restart_services(host_out, names):
    """Restarts those of these init services that run, as init restarts a service, and waits for
    each to run again; the names of those it restarted."""
    names = sorted(names)
    if not names:
        return []
    query = "; ".join(f"getprop init.svc.{n}; getprop init.svc_debug_pid.{n}" for n in names)

    def states():
        props = adb(host_out, "shell", query).stdout.split("\n") + [""] * 2 * len(names)
        return {n: (props[2 * i], props[2 * i + 1]) for i, n in enumerate(names)}

    before = states()
    running = [n for n in names if before[n][0] == "running"]
    for name in running:
        adb(host_out, "shell", "setprop", "ctl.restart", name)
    deadline = time.monotonic() + 30
    while True:
        now = states()
        waiting = [n for n in running if now[n][0] != "running" or now[n][1] in ("", before[n][1])]
        if not waiting:
            return running
        if time.monotonic() > deadline:
            die("not running again after its restart: "
                + ", ".join(f"{n} ({now[n][0] or 'gone'})" for n in waiting) + "; adb logcat")
        time.sleep(0.5)


# What toolbox's stop and start, with no service named, stop and start: the framework and the
# services it draws, plays and routes with.
FRAMEWORK_SERVICES = ("netd", "surfaceflinger", "audioserver", "zygote", "zygote_next",
                      "zygote_secondary")


def restart_framework(host_out):
    """Restarts the framework (zygote, system_server and every app, with FRAMEWORK_SERVICES),
    which then reads its packages and the system configuration again, and waits until it has
    unlocked the user again."""
    query = "; ".join([f"getprop init.svc.{name}" for name in FRAMEWORK_SERVICES]
                      + ["service check activity"])
    before = system_server_starts(host_out) or 0
    adb(host_out, "shell", "stop", timeout=120)
    # Init stops them in the background, and servicemanager lets go of the stopped system server's
    # services only once it has ended; a system server started before gets those dead services
    # and dies with them.
    deadline = time.monotonic() + 120
    while True:
        said = adb(host_out, "shell", query).stdout.split("\n") + [""] * len(FRAMEWORK_SERVICES)
        if (all(state in ("", "stopped") for state in said[:len(FRAMEWORK_SERVICES)])
                and "not found" in said[len(FRAMEWORK_SERVICES)]):
            break
        if time.monotonic() > deadline:
            die("the framework did not stop")
        time.sleep(0.2)
    adb(host_out, "shell", "start", timeout=120)
    deadline = time.monotonic() + 600
    while time.monotonic() < deadline:
        time.sleep(2)
        user = adb(host_out, "shell", "cmd", "activity", "get-started-user-state", "0")
        if user.stdout.strip() == "RUNNING_UNLOCKED":
            provision(host_out)
            return
        crash = system_server_crash(host_out, before)
        if crash:
            die(f"the system server keeps dying after the framework's restart: {crash}")
    die("the framework did not come back after its restart")


def restart_device(host_out, files):
    """Restarts the virtual device with its data kept, then labels the files with the file
    contexts that start loaded, and restarts it once more when that changed a label."""
    # The package manager keeps each package's parsed manifest under a key that an APEX's
    # packages do not change when the APEX is replaced; it parses them again without its cache.
    adb(host_out, "shell", "rm -rf /data/system/package_cache/*")
    adb(host_out, "reboot", timeout=60)
    time.sleep(10)
    if not wait_booted(host_out, 600):
        die("the virtual device did not come back after the copy")
    provision(host_out)
    # Labels of new file contexts can be set only once the start loaded them, on writable
    # partitions again (a start mounts them read-only).
    remount = adb(host_out, "remount", timeout=300)
    if remount.returncode:
        die(f"adb remount: {(remount.stdout + remount.stderr).strip()}")
    before = adb(host_out, "shell", "ls", "-Z", *["/" + f for f in files]).stdout
    relabel = adb(host_out, "shell", "restorecon", *["/" + f for f in files])
    if relabel.returncode:
        die(f"restorecon: {(relabel.stdout + relabel.stderr).strip()}")
    if adb(host_out, "shell", "ls", "-Z", *["/" + f for f in files]).stdout != before:
        log("relabelled with the new file contexts; restarting the virtual device once more")
        adb(host_out, "reboot", timeout=60)
        time.sleep(10)
        if not wait_booted(host_out, 600):
            die("the virtual device did not come back after relabelling")
        provision(host_out)


def vm_sync(host, info, host_out, modules):
    """Copies what the named modules install, or with none the files the images lack, into the
    running virtual device where it holds other content, keeping its data, and restarts what reads
    the copied files: the init services whose modules install or require them, the framework for
    its packages and the system configuration, and the whole device for what it reads only when
    it starts, for files no known reader reads, and when a replaced program still runs."""
    product = Path(info["product_out"])
    mods = Modules(host, product)
    if modules:
        synced, files, unknown = module_files(mods, modules)
        if unknown:
            die(f"no module {', '.join(unknown)} in {product / 'module-info.json'}")
        if not files:
            die("the modules install nothing into the image")
    else:
        synced, files = [], unpacked_files(info)
        if not files:
            log("the images hold every installed file; nothing to copy")
            return 0
        boot = [f for f in files if f.split("/", 1)[0] in VM_RAMDISKS]
        if boot:
            die(f"the boot images lack these files, which only a build packs "
                f"(lujarch build vm):\n{listed(boot)}")
    missing = [f for f in files if not os.path.lexists(product / f)]
    if missing:
        die(f"not built: {', '.join(missing)} (lujarch build vm {' '.join(modules)})")
    if not adb_root(host_out):
        provision(host_out)
    changed = device_differs(host_out, product, files)
    log(f"the device holds {len(files) - len(changed)} of the {len(files)} files as built")
    moved = moved_resource_ids(host, host_out, product, changed)
    if moved:
        die("the build moves resource ids that the running system's apps and system server hold "
            f"as compiled, in:\n{listed(moved)}\nthese come only with a full build and a fresh "
            "start: lujarch build vm, lujarch vm stop, lujarch vm start")
    if changed:
        remount = adb(host_out, "remount", timeout=300)
        said = (remount.stdout + remount.stderr).strip()
        if remount.returncode and "reboot" not in said.lower():
            die(f"adb remount: {said}")
        if "reboot" in said.lower():
            # The first remount turns verification off, which takes effect at the next start.
            log("making the system partitions writable; restarting the virtual device once")
            adb(host_out, "reboot", timeout=60)
            time.sleep(10)
            if not wait_booted(host_out, 600) or not adb_root(host_out):
                die("the virtual device did not come back after making its partitions writable")
            remount = adb(host_out, "remount", timeout=300)
            if remount.returncode:
                die(f"adb remount: {(remount.stdout + remount.stderr).strip()}")
    for rel in changed:
        if (product / rel).is_symlink():
            target = os.readlink(product / rel)
            link = adb(host_out, "shell", "ln", "-sfn", target, "/" + rel)
            if link.returncode:
                die(f"ln -s {target} /{rel}: {(link.stdout + link.stderr).strip()}")
            log(f"linked /{rel} to {target}")
            continue
        push = adb(host_out, "push", str(product / rel), "/" + rel, timeout=600)
        if push.returncode:
            die(f"adb push {rel}: {(push.stdout + push.stderr).strip()}")
        log(f"copied /{rel}")
    if changed:
        state = device_state_path(host)
        record = json.loads(state.read_text()) if state.is_file() else {"image": None}
        record["synced"] = sorted(set(record.get("synced", [])) | set(synced or ["unpacked files"]))
        state.write_text(json.dumps(record, indent=2) + "\n")
    services = mods.services(changed) if changed else {}
    needed = set().union(*services.values())
    framework = [f for f in changed if partition_path(f).startswith(READ_BY_FRAMEWORK)]
    at_start = [f for f in changed if partition_path(f).startswith(READ_AT_START)
                or f.endswith(".prop")
                or not (f in framework or f in needed or partition_path(f).startswith(CODE))]
    restarted = []
    if at_start:
        log(f"restarting the virtual device, its data kept, for files read only when it starts "
            f"or by no known reader:\n{listed(at_start)}")
        restart_device(host_out, files)
        restarted.append("the device")
    else:
        if changed:
            relabel = adb(host_out, "shell", "restorecon", *["/" + f for f in changed])
            if relabel.returncode:
                die(f"restorecon: {(relabel.stdout + relabel.stderr).strip()}")
        if framework:
            log(f"restarting the framework, which reads {', '.join('/' + f for f in framework[:3])}"
                f"{' and more' if len(framework) > 3 else ''} when it starts")
            restart_framework(host_out)
            restarted.append("the framework")
        for name in restart_services(host_out, services):
            log(f"restarted the init service {name}")
            restarted.append(name)
        # Programs an earlier run of a restarted service left can take a moment to end.
        deadline = time.monotonic() + 10
        while (stale := stale_code(host_out, files)) and time.monotonic() < deadline:
            time.sleep(1)
        if stale:
            log(f"restarting the virtual device, its data kept, for processes that run replaced "
                f"programs:\n{listed(stale)}")
            restart_device(host_out, files)
            restarted.append("the device")
    if changed:
        # Settings search indexes the pages again only when the build's fingerprint changes, as an
        # update changes it; a copy keeps it, so the index is dropped and built from the copies.
        adb(host_out, "shell", "pm", "clear", "com.android.settings.intelligence")
    log(f"synced {len(files)} files{' of ' + ' '.join(synced) if synced else ''}, "
        f"copied {len(changed)}; restarted {', '.join(restarted) or 'nothing'}; "
        f"adb 127.0.0.1:{ADB_PORT}")
    return 0


SCREENSHOT_FORMATS = (".png", ".jpg", ".webp")


def vm_screenshot(host, path, frames, interval):
    """Writes what the virtual device's display shows, composited as the browser view shows it:
    SystemUI's screen decorations and the boot animation included, which adb's screencap leaves
    out. Several frames start interval seconds apart and are numbered PATH-01, PATH-02, ..."""
    if container_state() != "running":
        die("the virtual device is not running (lujarch vm start)")
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    target = Path(path).resolve() if path else host.out / VM_DIR / "screenshots" / f"{stamp}.png"
    if target.suffix not in SCREENSHOT_FORMATS:
        die(f"{target.name}: the display is written as {', '.join(SCREENSHOT_FORMATS)}")
    if frames > 1:
        targets = [target.with_name(f"{target.stem}-{i:02}{target.suffix}")
                   for i in range(1, frames + 1)]
    else:
        targets = [target]
    target.parent.mkdir(parents=True, exist_ok=True)
    # The streamer in the container writes the file; the runtime home is the one directory both
    # sides see.
    home = host.out / VM_DIR / "home"
    staged = home / f".screenshot-{os.getpid()}{target.suffix}"
    start = time.monotonic()
    for i, dest in enumerate(targets):
        time.sleep(max(0.0, start + i * interval - time.monotonic()))
        try:
            run = subprocess.run(
                ["docker", "exec", "-e", "HOME=/cf/home", "-e", f"CUTTLEFISH_INSTANCE={VM_INSTANCE}",
                 VM_CONTAINER, "/cf/host/bin/cvd_internal_display", "screenshot",
                 f"--instance_num={VM_INSTANCE}", f"--screenshot_path=/cf/home/{staged.name}"],
                capture_output=True, text=True, timeout=60)
        except subprocess.TimeoutExpired:
            run = None
        if run is None or run.returncode or not staged.is_file():
            said = "no answer in 60 s" if run is None else (run.stdout + run.stderr).strip()
            launcher = home / "cuttlefish" / "instances" / f"cvd-{VM_INSTANCE}" / "logs" / "launcher.log"
            die(f"the display was not captured: {said}\nIt is captured by the streamer "
                f"(/cf/host/bin/webRTC); log {launcher}")
        shutil.move(staged, dest)
        print(dest, flush=True)
    return 0


def device_state_path(host):
    """What the running virtual device boots: the commit of its images and the modules copied
    into it since (vm sync). Tests record results only for a device that runs one clean
    commit's images and nothing else."""
    return host.out / VM_DIR / "device.json"


def copy_images(host, info):
    """The images the virtual device boots, copied (as reflinks: no space, no time) out of the
    build's output, which the next build rewrites while the device runs."""
    images = host.out / VM_DIR / "images"
    if images.exists():
        shutil.rmtree(images)
    images.mkdir(parents=True)
    for f in Path(info["product_out"]).iterdir():
        if f.is_file():
            r = subprocess.run(["cp", "--reflink=always", str(f), str(images / f.name)],
                               capture_output=True, text=True)
            if r.returncode:
                die(f"copying {f.name} to {images}: {r.stderr.strip()} (the build output and "
                    "the outputs must be on one file system that shares extents)")
    return images


def cmd_vm(args):
    host = Host()
    if args.action == "screenshot":
        return vm_screenshot(host, args.path, args.frames, args.interval)
    info, host_out, home, common = vm_paths(host)
    state = container_state()
    if args.action == "stop":
        if state is None:
            log("the virtual device is not running")
            return 0
        if state == "running":
            subprocess.run(["docker", "exec", "-e", f"CUTTLEFISH_INSTANCE={VM_INSTANCE}",
                            VM_CONTAINER, "/cf/host/bin/stop_cvd"],
                           capture_output=True, timeout=120)
        device_state_path(host).unlink(missing_ok=True)
        return subprocess.run(["docker", "rm", "-f", VM_CONTAINER], capture_output=True).returncode
    if args.action == "sync":
        if state != "running" or not booted(host_out):
            die("the virtual device is not running (lujarch vm start)")
        return vm_sync(host, info, host_out, args.modules)
    if args.action == "status":
        up = "booted" if state == "running" and booted(host_out) else (state or "not running")
        unpacked = unpacked_files(info)
        print(f"vm: {up}; build {info['commit']} ({info['built']}); adb 127.0.0.1:{ADB_PORT}; "
              f"screen {WEBRTC_URL}"
              + (f"; the images lack {len(unpacked)} files installed since they were packed"
                 if unpacked else ""))
        return 0 if up == "booted" else 1
    if state == "running":
        die("the virtual device is already running (lujarch vm stop)")
    unpacked = unpacked_files(info)
    if unpacked and not args.packed:
        how = "lujarch build vm packs them; lujarch vm start --packed boots the images as they are"
        if all(f.split("/", 1)[0] in VM_PARTITIONS for f in unpacked):
            how += ", and lujarch vm sync then copies the files in"
        die(f"the images lack {len(unpacked)} files installed since they were packed:\n"
            f"{listed(unpacked)}\n{how}")
    if unpacked:
        log(f"booting images that lack {len(unpacked)} files installed since they were packed")
    if state is not None:
        subprocess.run(["docker", "rm", "-f", VM_CONTAINER], capture_output=True)
    device_state_path(host).unlink(missing_ok=True)
    images = copy_images(host, info)
    vm = device_config("vm")
    display = device_config(vm["display_of"])["display"] if vm.get("display_of") else {}
    command = [
        "docker", "run", "-d", "--name", VM_CONTAINER,
        "--user", f"{os.getuid()}:{os.getgid()}",
        "-v", "/etc/passwd:/etc/passwd:ro", "-v", f"{host.out / 'vm' / 'group'}:/etc/group:ro",
        "--device", "/dev/kvm", "--device", "/dev/vhost-vsock", "--device", "/dev/vhost-net",
        # Docker's default seccomp and AppArmor profiles refuse AF_VSOCK sockets, Cuttlefish's
        # channel to the guest; outside a container Cuttlefish runs without either profile.
        "--security-opt", "seccomp=unconfined", "--security-opt", "apparmor=unconfined",
        # crosvm opens more files than a container's default soft limit of 1024.
        "--ulimit", "nofile=524288:524288",
        "-v", f"{host_out}:/cf/host:ro", "-v", f"{images}:/cf/images",
        "-v", f"{home}:/cf/home", "-v", f"{common}:/usr/lib/cuttlefish-common/bin:ro",
        "-e", "HOME=/cf/home", "-e", "ANDROID_HOST_OUT=/cf/host",
        "-e", "ANDROID_PRODUCT_OUT=/cf/images", "-w", "/cf/home",
    ]
    cpus = host.get("computer", "cpus")
    if cpus:
        command += ["--cpuset-cpus", cpus]
    for port in VM_PORTS:
        ports, _, proto = port.partition("/")
        command += ["-p", f"127.0.0.1:{ports}:{ports}" + (f"/{proto}" if proto else "")]
    command += [
        host.get("vm", "image", "debian:trixie-slim"),
        "/cf/host/bin/launch_cvd", "--report_anonymous_usage_stats=n", "--resume=false",
        "--enable_tap_devices=false", "--system_image_dir=/cf/images",
        f"--base_instance_num={VM_INSTANCE}",
        f"--tcp_port_range={VM_ICE_PORTS.replace('-', ':')}",
        f"--udp_port_range={VM_ICE_PORTS.replace('-', ':')}",
        f"--cpus={host.get('vm', 'cpus', 4)}", f"--memory_mb={host.get('vm', 'memory_mb', 8192)}",
        "--data_policy=always_create", f"--blank_data_image_mb={host.get('vm', 'data_mb', 16384)}",
    ]
    if display:
        command += [f"--x_res={display['width']}", f"--y_res={display['height']}",
                    f"--dpi={display['density']}", f"--refresh_rate_hz={display['refresh_hz']}"]
    logfile = host.out / "logs" / f"vm-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}.log"
    logfile.parent.mkdir(parents=True, exist_ok=True)
    log(f"starting the virtual device from {info['product_out']}; log {logfile}")
    run = subprocess.run(command, capture_output=True, text=True)
    if run.returncode:
        die(f"docker run failed: {run.stderr.strip()}")

    def save_log():
        out = subprocess.run(["docker", "logs", VM_CONTAINER], capture_output=True, text=True)
        logfile.write_text(out.stdout + out.stderr)

    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        if container_state() != "running":
            save_log()
            print("\n".join(logfile.read_text(errors="replace").split("\n")[-30:]), file=sys.stderr)
            die(f"the virtual device stopped while booting; log {logfile}")
        if booted(host_out):
            save_log()
            provision(host_out)
            device_state_path(host).write_text(json.dumps({
                "image": info.get("image"), "packed": not unpacked, "synced": [],
            }, indent=2) + "\n")
            log(f"booted and ready; adb 127.0.0.1:{ADB_PORT} as root; screen {WEBRTC_URL}")
            return 0
        crash = system_server_crash(host_out)
        if crash:
            save_log()
            logcat = logfile.with_name(f"{logfile.stem}-logcat.txt")
            logcat.write_text(adb(host_out, "logcat", "-d", "-b", "all", timeout=120).stdout)
            die(f"the system server keeps dying while the device starts: {crash}\n"
                f"log {logfile}, logcat {logcat}")
        time.sleep(10)
    save_log()
    die(f"not booted after {args.timeout} s; log {logfile}")


