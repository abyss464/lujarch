def entry_of(patch):
    parts = Path(rel(patch)).parts
    return "tools" if parts[0] == "tools" else f"{parts[1]}/{parts[2]}"


def entry_patches(entry):
    return TOOL_PATCHES if entry == "tools" else SYSTEM / entry / "patches"


def reproduces(where, parent, commit, patch):
    """Whether a patch file applied on parent gives commit's tree."""
    with tempfile.TemporaryDirectory() as tmp:
        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "index")}
        if pgit(where, "read-tree", parent, env=env).returncode:
            return False
        if pgit(where, "apply", "--cached", str(patch), env=env).returncode:
            return False
        tree = pgit(where, "write-tree", env=env).stdout.strip()
    return tree == pgit(where, "rev-parse", f"{commit}^{{tree}}").stdout.strip()


def save_project(tree, project, entry, args, pinned, wanted):
    where = tree / project
    if (git_dir(where) / APPLYING).exists():
        die(f"{project}: a patch is being resolved there; finish it with lujarch patch")
    base, made = patch_base(where)
    if base != pinned or len(made) != len(wanted) or \
            not all(in_sync(m, p) for m, p in zip(made, wanted)):
        die(f"{project} is not upstream.xml plus its patches; lujarch patch first")
    pdir = entry_patches(entry) / project
    existing = sorted(pdir.glob("*.patch")) if pdir.is_dir() else []
    new = False
    if args.patch:
        target = pdir / args.patch
        if target not in existing:
            die(f"{entry} has no patch {args.patch} for {project}")
    elif args.name:
        number = max((int(p.name[:4]) for p in existing), default=0) + 1
        target = pdir / f"{number:04d}-{args.name}.patch"
        if not PATCH_NAME_RE.match(target.name):
            die(f"{target.name}: a patch is named NNNN-<what>.patch, <what> in kebab-case")
        new = True
    elif len(existing) == 1:
        target = existing[0]
    elif not existing:
        die(f"{entry} has no patch for {project}: name a new one with --name")
    else:
        die(f"{entry} has several patches for {project}: choose one with --patch ("
            + ", ".join(p.name for p in existing) + ")")

    pgit(where, "add", "-A", check=True)
    work = commit_index(where, "lujarch save\n")
    order = ["tools"] + order_entries()
    after = sorted(wanted + ([target] if new else []),
                   key=lambda p: (order.index(entry_of(p)), p.name))
    by_patch = {p: m[0] for m, p in zip(made, wanted)}
    todo = []
    for p in after:
        if p == target and new:
            todo.append(f"pick {work}")
        else:
            todo.append(f"pick {by_patch[p]}")
            if p == target:
                todo.append(f"fixup {work}")
    with tempfile.NamedTemporaryFile("w", suffix=".todo", delete=False) as f:
        f.write("\n".join(todo) + "\n")
    env = {**os.environ, **PATCH_IDENTITY, "GIT_SEQUENCE_EDITOR": f"cp {shlex.quote(f.name)}",
           "GIT_EDITOR": "true"}
    run = pgit(where, "-c", "core.hooksPath=/dev/null", "-c", "rebase.autoSquash=false",
               "rebase", "-q", "-i", pinned, env=env)
    os.unlink(f.name)
    if run.returncode:
        pgit(where, "rebase", "--abort")
        pgit(where, "reset", "-q", "--mixed", "HEAD~1", check=True)
        later = re.search(r"[Cc]ould not apply [0-9a-f]+\.*\s*(\S+)", run.stdout + run.stderr)
        die(f"{project}: the change to {rel(target)} conflicts with a later patch"
            + (f", {later.group(1)}" if later else "") + "; the change is back in the tree")

    rebased = commits_since(where, pinned)
    parent = pinned
    for (commit, _, _, _), p in zip(rebased, after):
        if p == target or not p.exists() or not reproduces(where, f"{commit}^", commit, p):
            data = diff_bytes(where, f"{commit}^", commit)
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_bytes(data)
            log(f"saved {rel(p)}" if p == target else f"rewrote {rel(p)}, its context moved")
        tree_id = pgit(where, "rev-parse", f"{commit}^{{tree}}", check=True).stdout.strip()
        parent = pgit(where, "commit-tree", tree_id, "-p", parent, "-F", "-",
                      env={**os.environ, **PATCH_IDENTITY},
                      input=patch_message(p, p.read_bytes()), check=True).stdout.strip()
    pgit(where, "update-ref", "--no-deref", "HEAD", parent, check=True)


def cmd_save(args):
    host = Host()
    tree = host.tree
    entry = args.entry.strip("/")
    if entry.startswith("system/"):
        entry = entry[len("system/"):]
    if entry != "tools":
        if not re.fullmatch(r"(features|device)/[a-z0-9-]+", entry) or not (SYSTEM / entry).is_dir():
            die(f"{args.entry}: not tools or a feature or device directory under system/")
        if entry not in order_entries():
            die(f"{entry} is not in system/order; add it where its patches apply")
    pins = upstream_projects()
    if args.projects:
        projects = [p.strip("/") for p in args.projects]
        for p in projects:
            if p not in pins:
                die(f"{p} is not a project of upstream.xml")
    else:
        with ThreadPoolExecutor(16) as pool:
            projects = [p for p, dirty in pool.map(lambda p: (p, changes(tree / p)), pins) if dirty]
    projects = [p for p in projects if changes(tree / p)]
    if not projects:
        log("no changes in the tree")
