# check


class Findings:
    def __init__(self):
        self.items = []

    def add(self, path, line, message):
        self.items.append((rel(path) if isinstance(path, Path) else path, line, message))

    def report(self):
        for path, line, message in sorted(self.items):
            print(f"{path}:{line}: {message}" if line else f"{path}: {message}")
        return len(self.items)


def target_files():
    if not TARGET.is_dir():
        return []
    return sorted(p for p in TARGET.glob("*.md") if p.name not in ITEMLESS)


def parse_target(path, findings=None):
    """Items of one target file as (id, verify, line). Format problems go to findings."""
    def bad(line, message):
        if findings is not None:
            findings.add(path, line, message)

    lines = path.read_text(encoding="utf-8").split("\n")
    items = []
    codes = set()
    in_fence = False
    seen_title = False
    i = 0
    while i < len(lines):
        line = lines[i]
        n = i + 1
        if line.startswith("```"):
            in_fence = not in_fence
            i += 1
            continue
        if in_fence:
            i += 1
            continue
        for pattern, what in FORBIDDEN_IN_TARGET:
            if pattern.search(line):
                bad(n, f"{what} in the target")
        if line.startswith("#"):
            if line.startswith("# "):
                if seen_title or items:
                    bad(n, "a second title")
                seen_title = True
            elif line.startswith("## "):
                pass
            elif line.startswith("### "):
                m = ITEM_RE.match(line)
                if not m:
                    bad(n, "item heading is not '### <CODE>-<n> <title>'")
                else:
                    code, number = m.group(1), int(m.group(2))
                    codes.add(code)
                    expected = len(items) + 1
                    if number != expected:
                        bad(n, f"item number {number}, expected {expected}")
                    verify = None
                    j = i + 1
                    while j < len(lines) and not lines[j].strip():
                        j += 1
                    for field in FIELDS:
                        prefix = f"- {field}: "
                        if j < len(lines) and lines[j].startswith(prefix):
                            if field == "Verify":
                                verify = lines[j][len(prefix):].strip()
                                if verify not in VERIFY_VALUES:
                                    bad(j + 1, f"Verify is '{verify}', not vm or phone")
                            j += 1
                        else:
                            bad(j + 1, f"missing or misplaced field '{field}'")
                            break
                    items.append((f"{code}-{number}", verify, n))
            else:
                bad(n, "heading outside the target format")
        elif not seen_title and line.strip():
            bad(n, "the file does not start with '# <title>'")
            seen_title = True
        i += 1
    if len(codes) > 1:
        bad(0, "more than one item prefix: " + ", ".join(sorted(codes)))
    return items, codes


def check_target(findings):
    owners = {}
    ids = set()
    for path in target_files():
        items, codes = parse_target(path, findings)
        for code in codes:
            if code in owners:
                findings.add(path, 0, f"prefix {code} is also used by {owners[code]}")
            owners.setdefault(code, rel(path))
        ids.update(item_id for item_id, _, _ in items)
    features = SYSTEM / "features"
    if features.is_dir():
        for feature in sorted(p for p in features.iterdir() if p.is_dir()):
            if not (TARGET / f"{feature.name}.md").exists():
                findings.add(feature, 0, f"no target/{feature.name}.md")
            meta = feature / "feature.toml"
            if meta.exists():
                prefix = load_toml(meta).get("prefix")
                if prefix and owners.get(prefix) not in (None, f"target/{feature.name}.md"):
                    findings.add(meta, 0, f"prefix {prefix} belongs to {owners[prefix]}")
    return ids


def check_files(findings):
    for path in repo_files():
        name = rel(path)
        if path.suffix.lower() in (".md", ".txt") and RECORD_RE.match(path.stem):
            findings.add(path, 0, "a record file; the repository holds only the target")
        text = read_text(path)
        if text is None:
            continue
        def translation(file):
            return "/res/values-zh-rCN/" in f"/{file}" or "/res/values-ja/" in f"/{file}"

        cjk_allowed = name in CJK_ALLOWED_FILES or translation(name)
        # In a patch, the translation files it changes.
        patched = None
        for n, line in enumerate(text.split("\n"), 1):
            if path.suffix == ".patch" and line.startswith("diff --git "):
                patched = line.rsplit(" b/", 1)[-1]
            # A patch's removed and context lines are the upstream project's own text.
            upstream = path.suffix == ".patch" and line[:1] in ("-", " ", "@") and not (
                line.startswith("--- ") or line.startswith("@@@"))
            for pattern in () if upstream else LEGACY:
                if pattern.search(line):
                    findings.add(path, n, "legacy name; the system is Lujarch")
                    break
            if not (cjk_allowed or (patched and translation(patched))) and CJK_RE.search(line):

                findings.add(path, n, "Chinese or Japanese text outside the READMEs and terms.md")


def check_references(findings, ids):
    for path in repo_files():
        parts = rel(path).split("/")
        if not ("tests" in parts or parts[0] == "test" or path.name == "settings.toml"):
            continue
        text = read_text(path)
        if text is None:
            continue
        for n, line in enumerate(text.split("\n"), 1):
            for m in VERIFIES_RE.finditer(line):
                for item_id in re.findall(ID_RE, m.group(1)):
                    if item_id not in ids:
                        findings.add(path, n, f"{item_id} is not a target item")
        if path.name == "settings.toml":
            try:
                entries = tomllib.loads(text)
            except tomllib.TOMLDecodeError as e:
                findings.add(path, 0, f"not valid TOML: {e}")
                continue
            for key, entry in entries.items():
                item_id = entry.get("item") if isinstance(entry, dict) else None
                if item_id not in ids:
                    findings.add(path, 0, f"switch {key}: item {item_id} is not a target item")
                if not isinstance(entry, dict):
                    continue
                if not re.fullmatch(r"[a-z0-9]+(?:_[a-z0-9]+)*", key):
                    findings.add(path, 0, f"switch {key}: a key is snake_case")
                if entry.get("table") not in ("global", "secure"):
                    findings.add(path, 0, f"switch {key}: table is global or secure")
                kind = SETTING_TYPES.get(entry.get("type"))
                if kind is None:
                    findings.add(path, 0, f"switch {key}: type is bool, int or string")
                elif type(entry.get("default")) is not kind:
                    findings.add(path, 0, f"switch {key}: default is not a {entry.get('type')}")


def check_lock(findings):
    path = ROOT / "lock.toml"
    if not path.exists():
        findings.add("lock.toml", 0, "missing")
        return
    try:
        lock = load_toml(path)
    except tomllib.TOMLDecodeError as e:
        findings.add(path, 0, f"not valid TOML: {e}")
        return
    for section, key in (("upstream", "manifest"), ("upstream", "branch"),
                         ("upstream", "aosp"), ("build", "variant")):
        if key not in lock.get(section, {}):
            findings.add(path, 0, f"missing {section}.{key}")
    for device, pin in lock.get("stock", {}).items():
        if not isinstance(pin, dict):
            findings.add(path, 0, f"stock.{device} is not a table with release, urls and sha256")
            continue
        if not (SYSTEM / "device" / device / "device.toml").is_file():
            findings.add(path, 0, f"stock.{device}: no such device")
        for key in ("release", "urls", "sha256"):
            if key not in pin:
                findings.add(path, 0, f"missing stock.{device}.{key}")
        for name, digest in pin.get("files", {}).items():
            if not re.fullmatch(r"[0-9a-f]{64}", str(digest)):
                findings.add(path, 0, f"stock.{device}.files: {name} has no sha256")
    pins = lock.get("components", {})
    for name, pin in pins.items():
        if not re.fullmatch(r"[0-9a-f]{40}", str(pin.get("commit", ""))):
            findings.add(path, 0, f"components.{name}: commit is not a full commit id")
    for feature, name, spec in feature_components():
        if name not in pins:
            findings.add(path, 0, f"component {name} of {feature} is not pinned")
        if spec.get("build") not in ("go", "cargo") or "module" not in spec:
            findings.add(SYSTEM / "features" / feature / "feature.toml", 0,
                         f"component {name}: build (go or cargo) and module are required")
    manifest = ROOT / "upstream.xml"
    if not manifest.exists():
        findings.add("upstream.xml", 0, "missing")
    else:
        text = manifest.read_text(encoding="utf-8")
        for n, line in enumerate(text.split("\n"), 1):
            if "<project " in line and not re.search(r'revision="[0-9a-f]{40}"', line):
                findings.add(manifest, n, "a project not pinned to a commit")


def check_devices(findings):
    for path in sorted((SYSTEM / "device").glob("*/device.toml")):
        try:
            data = load_toml(path)
        except tomllib.TOMLDecodeError as e:
            findings.add(path, 0, f"not valid TOML: {e}")
            continue
        for key in ("codename", "product"):
            if key not in data:
                findings.add(path, 0, f"missing {key}")
        if data.get("codename") != path.parent.name:
            findings.add(path, 0, f"codename is not the directory's name, {path.parent.name}")
        of = data.get("display_of")
        if of and not (SYSTEM / "device" / of / "device.toml").is_file():
            findings.add(path, 0, f"display_of names no device: {of}")


def check_order(findings):
    with_patches = set()
    for kind in ("features", "device"):
        base = SYSTEM / kind
        if base.is_dir():
            with_patches |= {f"{kind}/{p.name}" for p in base.iterdir() if (p / "patches").is_dir()}
    path = SYSTEM / "order"
    listed = []
    if path.exists():
        for n, line in enumerate(path.read_text(encoding="utf-8").split("\n"), 1):
            entry = line.strip()
            if not entry:
                continue
            if entry in listed:
                findings.add(path, n, f"{entry} listed twice")
            elif entry not in with_patches:
                findings.add(path, n, f"{entry} has no patches/ directory")
            listed.append(entry)
    else:
        findings.add("system/order", 0, "missing")
    for entry in sorted(with_patches - set(listed)):
        findings.add("system/order", 0, f"{entry} has patches but is not listed")
    projects = upstream_projects() if (ROOT / "upstream.xml").exists() else {}
    for entry in sorted(with_patches) + (["tools"] if TOOL_PATCHES.is_dir() else []):
        pdir = entry_patches(entry)
        for path in sorted(p for p in pdir.rglob("*") if p.is_file()):
            project = path.parent.relative_to(pdir).as_posix()
            if not PATCH_NAME_RE.match(path.name):
                findings.add(path, 0, "a patch is named NNNN-<what>.patch, <what> in kebab-case")
            elif project not in projects:
                findings.add(path, 0, f"{project} is not a project of upstream.xml")


def check_approvals(findings):
    if git("rev-parse", "--verify", "-q", "refs/heads/main").returncode:
        return
    out = git("log", "main", "--first-parent", "--format=%H%x1f%B%x1e", "--", "target/*.md")
    for record in out.stdout.split("\x1e"):
        if not record.strip():
            continue
        commit, _, body = record.strip().partition("\x1f")
        if not re.search(r"^Approved-by: \S", body, re.MULTILINE):
            findings.add("target/", 0, f"commit {commit[:12]} on main changes the target without Approved-by")


def cmd_check(_args):
    findings = Findings()
    ids = check_target(findings)
    check_files(findings)
    check_references(findings, ids)
    check_lock(findings)
    check_devices(findings)
    check_order(findings)
    check_approvals(findings)
    count = findings.report()
    print(f"lujarch check: {count} finding{'s' if count != 1 else ''}", file=sys.stderr)
    return 1 if count else 0


