# Tests


TEST_TIMEOUT = 900
TEST_TIMEOUT_RE = re.compile(r"timeout:\s*(\d+)")


def discover_tests():
    """Every test of the features and devices as (id, path, items it verifies)."""
    tests = []
    for path in sorted(SYSTEM.glob("*/*/tests/*.py")):
        if path.name.startswith("_"):
            continue
        text = read_text(path) or ""
        items = sorted({i for m in VERIFIES_RE.finditer(text) for i in re.findall(ID_RE, m.group(1))})
        tests.append((f"{path.parent.parent.name}/{path.stem}", path, items))
    return tests


def item_levels():
    return {i: v for p in target_files() for i, v, _ in parse_target(p)[0]}


def recordable(host, host_out):
    """Why results cannot be recorded for HEAD, or None: a clean worktree, and a device that
    runs exactly HEAD's packed images with nothing copied in since."""
    if git("status", "--porcelain").stdout.strip():
        return "the worktree has changes"
    head = git("rev-parse", "HEAD").stdout.strip()
    state = device_state_path(host)
    if not state.is_file():
        return "the virtual device was not started by lujarch vm start"
    record = json.loads(state.read_text())
    image = record.get("image") or ""
    if image.endswith("-dirty") or not image or not head.startswith(image):
        return f"the device runs the images of {image or 'an unknown build'}, not {head[:12]}"
    if not record.get("packed"):
        return "the device booted images that lack installed files"
    if record.get("synced"):
        return f"modules were copied into the device since it started: {', '.join(record['synced'])}"
    version = adb(host_out, "shell", "getprop", "ro.lujarch.version").stdout.strip()
    if not version.split("-")[-1] or not head.startswith(version.split("-")[-1]):
        return f"the device reports version {version or 'none'}"
    return None


def merge_results(path, head, runs):
    data = json.loads(path.read_text()) if path.is_file() else {}
    tests = data.get("tests", {})
    tests.update(runs)
    items = {}
    for run in tests.values():
        for item in run["items"]:
            ok = run["result"] == "pass"
            items[item] = "pass" if items.get(item, "pass") == "pass" and ok else "fail"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"commit": head, "items": dict(sorted(items.items())),
                                "tests": dict(sorted(tests.items()))}, indent=2) + "\n")
    return items


def test_device(host):
    """The running virtual device's host tools and the environment a test runs in
    (test/lib/lujarch_test.py), once adb runs as root on the device."""
    info, host_out, _, _ = vm_paths(host)
    if container_state() != "running" or not booted(host_out):
        die("the virtual device is not running (lujarch vm start)")
    if not adb_root(host_out):
        die("adb cannot run as root on the virtual device")
    sdk = host.get("paths", "android_sdk")
    env = dict(os.environ)
    env.update({
        "PYTHONPATH": str(ROOT / "test" / "lib"), "PYTHONDONTWRITEBYTECODE": "1",
        "LUJARCH_ADB": adb_binary(host_out), "LUJARCH_SERIAL": f"127.0.0.1:{ADB_PORT}",
        "LUJARCH_TOOL": str(ROOT / "tools" / "lujarch"), "LUJARCH_ROOT": str(ROOT),
        "LUJARCH_TREE": str(host.tree), "LUJARCH_PROBES": str(host.out / "test" / "probes"),
        "LUJARCH_PRODUCT_OUT": info["product_out"], "LUJARCH_DEVICES": str(host.out / "devices"),
    })
    if sdk:
        env["LUJARCH_SDK"] = str(Path(os.path.expanduser(sdk)))
    return host_out, env


def test_start(host_out):
    """Every test starts from the unlocked home screen of an awake device."""
    adb(host_out, "shell", "svc power stayon true; input keyevent KEYCODE_WAKEUP; "
        "wm dismiss-keyguard; input keyevent KEYCODE_HOME")


def run_script(host, script, args):
    """Runs a Python file on the virtual device as a test runs, in a test's environment, from the
    unlocked home screen and in its output folder <out>/test/work/scratch/<name> (work-<n> for
    instance n), and records nothing; its output goes to the terminal and its exit status is the
    command's."""
    path = Path(script).resolve()
    if not path.is_file():
        die(f"no file {script}")
    host_out, env = test_device(host)
    out = host.out / "test" / TEST_WORK / "scratch" / path.stem
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    env["LUJARCH_TEST_OUT"] = str(out)
    test_start(host_out)
    log(f"{path.name} on 127.0.0.1:{ADB_PORT}; output in {out}")
    return subprocess.run([sys.executable, str(path), *args], cwd=out, env=env).returncode


def cmd_test(args):
    host = Host()
    if args.script:
        if args.selectors:
            die("--script runs one file; its arguments follow it")
        return run_script(host, args.script[0], args.script[1:])
    levels = item_levels()
    tests = discover_tests()
    if args.selectors:
        chosen = []
        for test_id, path, items in tests:
            feature = test_id.split("/", 1)[0]
            if any(s in (test_id, feature, path.stem, str(path)) or s in items
                   for s in args.selectors):
                chosen.append((test_id, path, items))
        tests = chosen
    if not tests:
        die("no test matches")
    unknown = [(t, [i for i in items if i not in levels]) for t, _, items in tests]
    unknown = [(t, u) for t, u in unknown if u]
    if unknown:
        die("tests name items the target lacks: "
            + "; ".join(f"{t}: {', '.join(u)}" for t, u in unknown))
    phone = [(t, p, i) for t, p, i in tests if any(levels[x] == "phone" for x in i)]
    vm_tests = [(t, p, i) for t, p, i in tests if (t, p, i) not in phone]
    for t, _, _ in phone:
        log(f"{t}: verifies phone items; runs on a Xiaomi 13, not here")
    if not vm_tests:
        return 0
    host_out, env = test_device(host)
    head = git("rev-parse", "HEAD").stdout.strip()
    why = recordable(host, host_out)
    base = host.out / "test" / (head if why is None else TEST_WORK)
    log(f"results for {head[:12]} in {base}" if why is None
        else f"results not recorded for {head[:12]}: {why}; output in {base}")
    runs = {}
    failed = []
    for test_id, path, items in vm_tests:
        out = base / test_id
        if out.exists():
            shutil.rmtree(out)
        out.mkdir(parents=True)
        env["LUJARCH_TEST_OUT"] = str(out)
        m = TEST_TIMEOUT_RE.search(read_text(path) or "")
        timeout = int(m.group(1)) if m else TEST_TIMEOUT
        test_start(host_out)
        log(f"{test_id} ({', '.join(items) or 'no item'})")
        start = time.monotonic()
        with open(out / "log.txt", "w") as logf:
            try:
                r = subprocess.run([sys.executable, str(path)], cwd=out, env=env, stdout=logf,
                                   stderr=subprocess.STDOUT, timeout=timeout)
                result = "pass" if r.returncode == 0 else "fail"
            except subprocess.TimeoutExpired:
                logf.write(f"\nFAILED: no end within {timeout} s\n")
                result = "fail"
        seconds = round(time.monotonic() - start)
        tail = [l for l in (out / "log.txt").read_text(errors="replace").splitlines() if l.strip()]
        log(f"  {result} in {seconds} s" + (f": {tail[-1][:200]}" if result != "pass" and tail else ""))
        runs[test_id] = {"items": items, "result": result, "seconds": seconds}
        if result != "pass":
            failed.append(test_id)
    merged = merge_results(base / "results.json", head, runs)
    passed = sum(1 for v in merged.values() if v == "pass")
    log(f"{len(runs) - len(failed)} of {len(runs)} tests passed; items passing in {base.name}: "
        f"{passed} of {len(merged)}")
    return 1 if failed else 0


