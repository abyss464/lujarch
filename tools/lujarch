# Release (process/release-flow.md)

RELEASE_DEVICE = "fuxi"
RELEASE_GOALS = ("droid", "target-files-package", "otatools")
RELEASE_TAG_RE = re.compile(r"^lujarch-(\d+)$")


def release_tags():
    """{n: tag} of every release tag lujarch-<n>."""
    tags = git("tag", "--list", "lujarch-*").stdout.split()
    return {int(m.group(1)): tag for tag in tags if (m := RELEASE_TAG_RE.match(tag))}


def untested(host, commit):
    """Why the commit has not passed the test flow: its results lack a pass of an item with
    Verify: vm. Empty when it passed."""
    path = host.out / "test" / commit / "results.json"
    try:
        results = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return [f"no test results for {commit[:12]}: {path}"]
    except (OSError, ValueError) as e:
        return [f"{path}: {e}"]
    if results.get("commit") != commit:
        return [f"{path} holds the results of {results.get('commit')}"]
    items = results.get("items", {})
    failed, missing = [], []
    for target in target_files():
        for item, verify, _ in parse_target(target)[0]:
            if verify == "vm" and items.get(item) != "pass":
                (failed if item in items else missing).append(item)
    return ([f"{len(failed)} items with Verify: vm failed: {', '.join(failed)}"] if failed else []) \
        + ([f"{len(missing)} items with Verify: vm have no result: {', '.join(missing)}"]
           if missing else [])


def release_refusals(host, commit, untested_ok=False):
    """What keeps the commit from being released (process/release-flow.md, Preconditions); with
    untested_ok, a commit that has not passed the test flow is not refused."""
    refusals = []
    branch = git("symbolic-ref", "-q", "--short", "HEAD").stdout.strip()
    if branch != "main":
        refusals.append(f"HEAD is {'on ' + branch if branch else 'detached'}, not on main")
    changed = [l for l in git("status", "--porcelain", "--untracked-files=all").stdout.split("\n")
               if l.strip()]
    if changed:
        refusals.append("the worktree has changes:\n" + listed(changed, 10))
    if cmd_check(None):
        refusals.append("lujarch check reports findings")
    for tag in git("tag", "--points-at", commit, "--list", "lujarch-*").stdout.split():
        written = (host.out / "releases" / f"{tag}-{commit[:12]}").is_dir()
        refusals.append(f"{commit[:12]} is already tagged {tag}" + ("" if written else
                        f", and its release wrote no artifacts (git tag -d {tag} removes the tag)"))
    return refusals if untested_ok else refusals + untested(host, commit)


def target_at(rev):
    """{file name: (title, [(item, item title, item text)], text)} of target/ at a revision."""
    out = {}
    with tempfile.TemporaryDirectory() as tmp:
        for name in pgit(ROOT, "ls-tree", "--name-only", f"{rev}:target", check=True).stdout.split():
            if not name.endswith(".md"):
                continue
            text = pgit(ROOT, "show", f"{rev}:target/{name}", check=True).stdout
            lines = text.split("\n")
            title = next((l[2:].strip() for l in lines if l.startswith("# ")), name)
            items = []
            if name not in ITEMLESS:
                path = Path(tmp) / name
                path.write_text(text, encoding="utf-8")
                for item, _, line in parse_target(path)[0]:
                    body = []
                    for l in lines[line:]:
                        if l.startswith("#"):
                            break
                        body.append(l)
                    items.append((item, lines[line - 1].split(" ", 2)[2], "\n".join(body).strip()))
            out[name] = (title, items, text)
    return out


def release_notes(n, commit, tags, untested_lines=()):
    """Lujarch n's notes: the change of target/ since the release before it, or the target's items
    by feature for the first release."""
    now = target_at(tags[n])
    lines = [f"# Lujarch {n}", ""]
    if untested_lines:
        lines += ["Released at the owner's request before it passed the test flow:", "",
                  *(f"- {l}" for l in untested_lines), ""]
    previous = max((m for m in tags if m < n), default=None)
    if previous is None:
        lines += [f"Commit {commit}, the first release. Its target:", ""]
        for title, items, _ in (now[name] for name in sorted(now)):
            if items:
                lines += [f"## {title}", "", *(f"- {i} {t}" for i, t, _ in items), ""]
        return "\n".join(lines)
    before = target_at(tags[previous])
    since = git("rev-list", "-n", "1", tags[previous]).stdout.strip()
    lines += [f"Commit {commit}. The target's changes since Lujarch {previous} ({since[:12]}):", ""]
    changes = False
    for name in sorted(set(now) | set(before)):
        title, new, text = now.get(name) or (before[name][0], [], "")
        _, old, old_text = before.get(name) or (title, [], "")
        old_by_title = {t: (i, body) for i, t, body in old}
        entries = [f"- Added: {i} {t}" for i, t, _ in new if t not in old_by_title]
        entries += [f"- Changed: {i} {t}" for i, t, body in new
                    if t in old_by_title and old_by_title[t][1] != body]
        titles = {t for _, t, _ in new}
        entries += [f"- Removed: {t} (Lujarch {previous}'s {i})" for i, t, _ in old if t not in titles]
        if name in ITEMLESS and text != old_text:
            entries.append(f"- The wording of target/{name} changed")
        if entries:
            lines += [f"## {title}", "", *entries, ""]
            changes = True
    if not changes:
        lines += [f"The target is Lujarch {previous}'s.", ""]
    return "\n".join(lines)


def remove_worktree(source):
    if source.exists():
        git("worktree", "remove", "--force", str(source))
    git("worktree", "prune")


def cmd_release(args):
    """Releases HEAD as lujarch-<n>-<commit> (process/release-flow.md)."""
    host = Host()
    commit = git("rev-parse", "HEAD").stdout.strip()
    refusals = release_refusals(host, commit, args.untested)
    untested_lines = untested(host, commit) if args.untested else []
    if refusals:
        die(f"{commit[:12]} is not released:\n" + "\n".join(f"- {r}" for r in refusals))
    keys = host.path_of("paths", "keys")
    tags = release_tags()
    n = max(tags, default=0) + 1
    tag, name = f"lujarch-{n}", f"lujarch-{n}-{commit[:12]}"
    releases = host.out / "releases"
    dest, work = releases / name, releases / f".{name}"
    source, signing, artifacts = work / "source", work / "sign", work / "artifacts"
    if dest.exists():
        die(f"{dest} exists")
    remove_worktree(source)
    shutil.rmtree(work, ignore_errors=True)
    if git("tag", tag, commit).returncode:
        die(f"could not tag {commit[:12]} {tag}")
    log(f"tagged {commit[:12]} {tag}")
    written = False
    lock = None
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    try:
        signing.mkdir(parents=True)
        add = git("worktree", "add", "--detach", str(source), tag)
        if add.returncode:
            die(f"git worktree add {source}: {add.stderr.strip()}")
        lock = build_lock(host)
        env = dict(os.environ, **{BUILD_LOCK_FD: str(lock.fileno())})
        started = time.time()
        for step in (["sync"], ["build", RELEASE_DEVICE, *RELEASE_GOALS]):
            log(f"lujarch {' '.join(step)}, from {source}")
            if subprocess.run([sys.executable, str(source / "tools" / "lujarch"), *step], env=env,
                              pass_fds=(lock.fileno(),)).returncode:
                die(f"lujarch {step[0]} failed")
        info = json.loads(device_info_path(host, RELEASE_DEVICE).read_text())
        product_out = Path(info["product_out"])
        target = (product_out / "obj" / "PACKAGING" / "target_files_intermediates"
                  / f"{device_config(RELEASE_DEVICE)['product']}-target_files.zip")
        if not commit.startswith(info["commit"]) or not target.is_file() \
                or target.stat().st_mtime < started:
            die(f"the build left no target files of {commit[:12]} ({target})")
        version = version_rc()
        with zipfile.ZipFile(target) as z:
            if not any(i.file_size == len(version) and z.read(i) == version
                       for i in z.infolist() if i.filename.endswith(".rc")):
                die(f"the image's version is not {tag}'s:\n{version.decode()}")
        app_keys = [f"--app-key={spec['module']}.apk={spec['key']}"
                    for _, _, spec in feature_components() if spec.get("key")]
        log("signing with the release keys")
        if subprocess.run([sys.executable, str(source / "release" / "sign.py"),
                           "--tree", str(host.tree), "--keys", str(keys), *app_keys, str(target),
                           str(signing)], env=build_environment()).returncode:
            die("signing failed")
        log("verifying the signed release")
        if subprocess.run([sys.executable, str(source / "release" / "verify.py"),
                           "--tree", str(host.tree), "--product-out", str(product_out),
                           "--source", str(source), "--keys-of", str(signing / "keys.txt"),
                           "--unsigned", str(target),
                           "--signed", str(signing / "signed-target_files.zip"),
                           "--ota", str(signing / "ota.zip")],
                          env=dict(build_environment(), TMPDIR=str(signing / "tmp"))).returncode:
            die("the signed release does not verify")
        lock.close()
        lock = None
        artifacts.mkdir()
        (signing / "ota.zip").rename(artifacts / f"{name}.zip")
        (signing / "images.zip").rename(artifacts / f"{name}-images.zip")
        (artifacts / "notes.md").write_text(
            release_notes(n, commit, {**tags, n: tag}, untested_lines), encoding="utf-8")
        (artifacts / "sha256").write_text("".join(
            f"{p.name}: {sha256_file(p)}\n" for p in sorted(artifacts.iterdir())))
        artifacts.rename(dest)
        written = True
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        if lock is not None:
            lock.close()
        remove_worktree(source)
        shutil.rmtree(work, ignore_errors=True)
        if not written:
            git("tag", "-d", tag)
            log(f"removed the tag {tag}")
    log(f"released {tag}: {dest}")
    print(dest)
    return 0


