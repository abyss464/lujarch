# Build


def mem_available_gb():
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) // 1048576
    return 0


# The memory a build leaves to the desktop and everything else running.
DESKTOP_RESERVE_GB = 10
# The analysis's Go memory limit (GOMEMLIMIT): its live heap peaks at about 29 GB, under a 38 GB
# limit it runs as fast as under more, and the rest of the build holds under 1 GB beside it
# (BESIDE_ANALYSIS_GB). The limit is part of the analysis's command line, so it stays one value:
# a limit that followed free memory would make every build run the analysis again.
ANALYSIS_GO_GB = 38
BESIDE_ANALYSIS_GB = 2
# The least memory cap of a build that analyses the tree.
BUILD_MIN_GB = ANALYSIS_GO_GB + BESIDE_ANALYSIS_GB
# The least memory cap of a build that reuses the last analysis: Kati holds up to 17 GB, then siso
# 23 GB and its two jobs.
NINJA_MIN_GB = 28
# How long a build waits for the memory it needs to come free.
MEMORY_WAIT_MIN = 20


def clip(text, width):
    return text if len(text) <= width else f"{text[:width * 2 // 3 - 3]} ... {text[-(width // 3):]}"


def memory_holders():
    """What holds the computer's memory, largest first, one line each: the programs, by the
    resident anonymous memory of all their processes, and the files of every memory-backed file
    system, by the deepest directories holding 512 MB or more."""
    home = str(Path.home())
    programs = {}
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            argv = (proc / "cmdline").read_bytes().decode(errors="replace").split("\0")
            anon = re.search(r"^RssAnon:\s+(\d+)", (proc / "status").read_text(), re.M)
        except OSError:
            continue
        if not argv[0] or not anon:
            continue
        kb, name = int(anon.group(1)), Path(argv[0]).name
        cmd = clip(" ".join(a for a in argv if a).replace(home, "~"), 110)
        total, count, largest = programs.get(name, (0, 0, (0, "")))
        programs[name] = (total + kb, count + 1, max(largest, (kb, f"pid {proc.name}: {cmd}")))
    held = []
    for name, (kb, count, (_, largest)) in sorted(programs.items(), key=lambda p: -p[1][0])[:6]:
        processes = f" ({count} processes)" if count > 1 else ""
        held.append((kb << 10, f"{name}{processes}, the largest {largest}"))
    for line in Path("/proc/mounts").read_text().split("\n"):
        fields = line.split()
        if len(fields) < 3 or fields[2] != "tmpfs":
            continue
        mount = fields[1].replace("\\040", " ")
        try:
            fs = os.statvfs(mount)
        except OSError:
            continue
        used = (fs.f_blocks - fs.f_bfree) * fs.f_frsize
        if used < 1 << 30:
            continue
        du = subprocess.run(["du", "-x", "-k", "-0", mount], capture_output=True, text=True)
        big = {}
        for entry in du.stdout.split("\0"):
            size, _, path = entry.partition("\t")
            if path and path != mount and int(size) >= 1 << 19:
                big[path] = int(size) << 10
        deepest = sorted((p for p in big if not any(q.startswith(p + "/") for q in big)),
                         key=lambda p: -big[p])[:4]
        held.append((used, f"files in {mount}" + "".join(
            f"\n{big[p] / 2**30:17.1f} GB  {clip(p.replace(home, '~'), 100)}" for p in deepest)))
    return "\n".join(f"  {size / 2**30:5.1f} GB  {text}" for size, text in sorted(held)[::-1])


def wait_for_memory(need, what="a build"):
    """Free memory in GB once it reaches need, waited for up to MEMORY_WAIT_MIN minutes."""
    gb = mem_available_gb()
    if gb >= need:
        return gb
    log(f"only {gb} GB of memory free: {what} needs {need}; waiting up to {MEMORY_WAIT_MIN} min "
        f"for it to come free. What holds memory:\n{memory_holders()}")
    start = time.monotonic()
    while time.monotonic() - start < MEMORY_WAIT_MIN * 60:
        time.sleep(15)
        gb = mem_available_gb()
        if gb >= need:
            log(f"{gb} GB of memory free after {(time.monotonic() - start) / 60:.1f} min")
            return gb
    die(f"only {gb} GB of memory free after {MEMORY_WAIT_MIN} min: {what} needs {need} (or set "
        f"build.memory_max in host.toml). What holds memory:\n{memory_holders()}")


def analysed_before(tree, product):
    """Whether Soong has analysed the tree for the product: only then does it refuse to analyse
    it again when the build forbids it (SOONG_ENFORCE_NO_REANALYSIS); a first analysis it runs."""
    return (tree / "out" / "soong" / f"soong.environment.used.{product}.build").is_file()


def build_budget(host, reusable):
    """The build's memory cap, pressure point and jobs, and whether it may analyse the tree: from
    host.toml; else from free memory, once enough is free for the analysis, or, while less is free
    and the last analysis is reusable, for a build that reuses it."""
    mem_max = host.get("build", "memory_max") or ""
    analyse = True
    if not mem_max:
        # Android 17's analysis of the virtual device grows past 60 GB unless GOMEMLIMIT holds
        # it; squeezed by the cap instead, it stalls for hours.
        full = BUILD_MIN_GB + DESKTOP_RESERVE_GB
        if reusable and mem_available_gb() < full:
            gb = wait_for_memory(NINJA_MIN_GB + DESKTOP_RESERVE_GB,
                                 "a build that reuses the last analysis")
            analyse = gb >= full
        else:
            gb = wait_for_memory(full, "a build that analyses the tree")
        mem_max = f"{min(gb - DESKTOP_RESERVE_GB, 60)}G"
    mem_high = host.get("build", "memory_high") or mem_max
    jobs = int(host.get("build", "jobs", 0) or 0) or fitting_jobs(mem_max)
    return mem_max, mem_high, jobs, analyse


# Of the caller's environment a build sees only these: the build writes its whole environment
# into its logs (out/soong*.log), and a session's environment can hold secrets.
BUILD_ENV_KEEP = ("PATH", "HOME", "USER", "LOGNAME", "SHELL", "TERM", "LANG", "LANGUAGE", "TMPDIR",
                  "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS")


def build_environment():
    return {k: v for k, v in os.environ.items() if k in BUILD_ENV_KEEP}


def fitting_jobs(mem_max):
    # siso keeps about 26 GB, and every Java or R8 job, which no job pool limits, up to 4 GB.
    return max(2, (int(mem_max.rstrip("G")) - 26) // 4)


def run_scoped(command, script, logfile, mode, **kwargs):
    """Runs a build script with bash under command, which puts it in its own systemd scope, its
    output into the log, and returns its exit status and what the scope used: its peak memory,
    its anonymous memory at most (sampled every 2 s; the file cache, which the cap reclaims, left
    out), how often it reached the cap, and how many processes the cap killed. The scope ends with
    this process, however it ends: the script stops its scope once a pipe whose other end only
    this process holds closes, and an interrupted run waits until the scope is gone."""
    used = {"peak": 0, "anon": 0, "max": 0, "oom_kill": 0}
    own = Path("/proc/self/cgroup").read_text()
    scope = None
    end, held = os.pipe()
    guard = (f"[ -e /proc/self/fd/{end} ] && (exec >/dev/null 2>&1; trap '' INT HUP TERM; "
             f"read -r -u {end} _; systemctl --user stop --no-block "
             f'"$(basename "$(cut -d: -f3- /proc/self/cgroup)")") &\nexec {end}<&-\n')
    try:
        with open(logfile, mode) as f, subprocess.Popen(
                [*command, "bash", "-c", guard + script], stdout=f, stderr=subprocess.STDOUT,
                pass_fds=(end,), **kwargs) as proc:
            os.close(end)
            end = None
            try:
                while True:
                    try:
                        if scope is None:
                            group = Path(f"/proc/{proc.pid}/cgroup").read_text()
                            if group != own:
                                scope = Path("/sys/fs/cgroup" + group.split("::", 1)[1].strip())
                        if scope is not None:
                            stat = dict(l.split()
                                        for l in (scope / "memory.stat").read_text().splitlines())
                            events = dict(l.split() for l in
                                          (scope / "memory.events").read_text().splitlines())
                            used["anon"] = max(used["anon"], int(stat["anon"]))
                            used["peak"] = max(used["peak"],
                                               int((scope / "memory.peak").read_text()))
                            used["max"] = int(events["max"])
                            used["oom_kill"] = int(events["oom_kill"])
                    except (OSError, KeyError, ValueError):
                        pass
                    try:
                        return proc.wait(timeout=2), used
                    except subprocess.TimeoutExpired:
                        pass
            finally:
                os.close(held)
                held = None
                if proc.returncode is None and scope is not None:
                    log(f"stopping the build ({scope.name})")
                    deadline = time.monotonic() + 120
                    while scope.exists() and time.monotonic() < deadline:
                        time.sleep(0.5)
                    if scope.exists():
                        log(f"the build's scope {scope.name} did not stop; killing its script")
                        proc.kill()
    finally:
        for fd in (end, held):
            if fd is not None:
                os.close(fd)


def analysis_seconds(tree, since):
    """How long the analysis (soong_build) ran, when the build that started at since ran it."""
    metrics = tree / "out" / "soong" / "siso_metrics.json"
    try:
        if metrics.stat().st_mtime >= since:
            for line in metrics.read_text().split("\n"):
                if '"g.bootstrap.build.ninja"' in line:
                    return json.loads(line)["duration"]
    except (OSError, ValueError, KeyError):
        pass
    return None


def release_config(tree):
    path = tree / "vendor" / "lineage" / "vars" / "aosp_target_release"
    for line in path.read_text().split("\n"):
        if line.startswith("aosp_target_release="):
            return line.split("=", 1)[1].strip()
    die(f"no aosp_target_release in {path}")


def device_info_path(host, device):
    return host.out / "devices" / f"{device}.json"


# The descriptor on which a release holds the build lock for the builds it runs.
BUILD_LOCK_FD = "LUJARCH_BUILD_LOCK_FD"


def build_lock(host):
    """Takes the one lock of every Android build on the computer, waiting while another holds
    it, until the process ends; a build a release runs holds it on the release's descriptor."""
    lock_path = host.path_of("build", "lock")
    if os.environ.get(BUILD_LOCK_FD):
        lock = os.fdopen(int(os.environ[BUILD_LOCK_FD]), "a")
    else:
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        lock = open(lock_path, "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log(f"another build holds {lock_path}; waiting")
        fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def cmd_build(args):
    host = Host()
    tree = host.tree
    device = device_config(args.device)
    variant = lock_file()["build"]["variant"]
    lunch = f"{device['product']}-{release_config(tree)}-{variant}"
    lock = build_lock(host)

    if not args.modules and device.get("platform") == "cuttlefish":
        args.modules = ["droid", "out/host/linux-x86/cvd-host_package.tar.gz"]
    elif args.modules:
        # vm sync finds what the modules install in module-info.json, and copies the boot image
        # unit whole (module_files).
        brought = ["module-info"]
        last = device_info_path(host, args.device)
        if last.is_file():
            product = Path(json.loads(last.read_text())["product_out"])
            if all((product / f).is_file() for f in ("module-info.json", BOOT_CLASSPATH)):
                brought += module_files(Modules(host, product), args.modules)[0]
        args.modules += [m for m in brought if m not in args.modules]
    modules = " ".join(shlex.quote(m) for m in args.modules)

    prepare_tree(host)
    verify_tree(tree)
    pin = lock_file().get("stock", {}).get(args.device)
    if pin and pin.get("files") and not (stock_dump_dir(host, pin) / STOCK_UNPACKED).is_file():
        die(f"{args.device} needs files of its stock release: lujarch stock {args.device}")
    mem_max, mem_high, jobs, analyse = build_budget(host, analysed_before(tree, device["product"]))
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    logs = host.out / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    logfile = logs / f"build-{args.device}-{stamp}.log"
    info = device_info_path(host, args.device)
    info.parent.mkdir(parents=True, exist_ok=True)
    product_out_file = info.with_suffix(".product_out")

    def script(jobs):
        return f"""
set +eu
cd {shlex.quote(str(tree))}
source build/envsetup.sh >/dev/null || exit 1
lunch {shlex.quote(lunch)} >/dev/null || exit 1
get_build_var PRODUCT_OUT > {shlex.quote(str(product_out_file))} || exit 1
m -j{jobs} {modules}
"""
    env = build_environment()
    built_at = str(int(time.time()))
    env.update({
        # What a build writes names no person, computer or time zone; its build number is the
        # time it started.
        "TZ": "UTC",
        "BUILD_USERNAME": "lujarch",
        "BUILD_HOSTNAME": "lujarch",
        "BUILD_DATETIME": built_at,
        "BUILD_NUMBER": built_at,
        "LC_ALL": "C",
        "USE_CCACHE": "1",
        "CCACHE_EXEC": "/usr/bin/ccache",
        "CCACHE_DIR": str(host.path_of("paths", "ccache")),
        "NINJA_HIGHMEM_NUM_JOBS": str(host.get("build", "highmem_jobs", 3)),
        # The analysis's Go heap stays under the cap (tools/patches/build/soong).
        "GOMEMLIMIT": f"{ANALYSIS_GO_GB}GiB",
    })
    env.update({k: str(v) for k, v in device.get("build", {}).get("env", {}).items()})
    cpus = host.get("computer", "cpus")

    def run(jobs, mode):
        scope = ["systemd-run", "--user", "--scope", "--quiet", "--collect",
                 "-p", f"MemoryHigh={mem_high}", "-p", f"MemoryMax={mem_max}",
                 "-p", "MemorySwapMax=0", "-p", "CPUWeight=20", "-p", "IOWeight=20"]
        if cpus:
            scope += ["taskset", "-c", cpus]
        # Under a cap that does not hold the analysis, Soong stops before it analyses the tree.
        held = {} if analyse else {"SOONG_ENFORCE_NO_REANALYSIS": "true"}
        return run_scoped(scope, script(jobs), logfile, mode, cwd=tree, env={**env, **held})

    def begin():
        log(f"building {args.device} ({lunch}{', ' + modules if modules else ''}): "
            f"{jobs} jobs, memory cap {mem_max}"
            f"{'' if analyse else ', reusing the last analysis'}; log {logfile}")

    def merged(used, more):
        return {k: max(v, more[k]) if k in ("peak", "anon") else v + more[k]
                for k, v in used.items()}

    try:
        with open("/proc/self/oom_score_adj", "w") as f:
            f.write("1000")
    except OSError:
        log("could not raise the build's oom_score_adj")
    # A build stopped from outside stops its scope before it ends (run_scoped).
    for stop in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(stop, lambda number, _: sys.exit(128 + number))
    begin()
    start, started = time.monotonic(), time.time()
    status, used = run(jobs, "w")
    refusal = re.search(r"Reanalysis will run due to ([^\n]*)",
                        logfile.read_text(errors="replace")) if status and not analyse else None
    if refusal:
        log(f"the build analyses the tree again: {refusal.group(1).rstrip('.')}")
        mem_max, mem_high, jobs, analyse = build_budget(host, False)
        begin()
        status, more = run(jobs, "a")
        used = merged(used, more)
    if status < 0 or status in (137, 143):
        # The scope's memory cap killed the build: it goes on from where it stopped with half
        # the jobs.
        jobs = max(2, jobs // 2)
        log(f"the build hit its memory cap (exit {status}); continuing with {jobs} jobs")
        status, more = run(jobs, "a")
        used = merged(used, more)
    minutes = int((time.monotonic() - start) // 60)
    # What the build used, so that its cap and jobs follow from measured builds.
    analysis = analysis_seconds(tree, started)
    usage = (f"memory: cap {mem_max}, {jobs} jobs; peak {used['peak'] / 2**30:.1f}G, anonymous "
             f"at most {used['anon'] / 2**30:.1f}G; the cap reached {used['max']} times, "
             f"{used['oom_kill']} processes killed by it; "
             + (f"analysis {analysis:.0f} s" if analysis is not None else "no analysis"))
    if status:
        print("\n".join(logfile.read_text(errors="replace").split("\n")[-40:]), file=sys.stderr)
    with open(logfile, "a") as f:
        f.write(f"\n[lujarch] {usage}\n")
    log(usage)
    if status:
        die(f"build failed after {minutes} min (exit {status}); log {logfile}")
    product_out = product_out_file.read_text().strip()
    product_out_file.unlink()
    commit = git("describe", "--always", "--dirty", "--exclude=*").stdout.strip()
    # When the images were last packed (unpacked_files): a module build installs files and
    # packs no image.
    if not args.modules or "droid" in args.modules:
        packed, image = time.time(), commit
    else:
        before = json.loads(info.read_text()) if info.is_file() else {}
        packed, image = before.get("packed"), before.get("image")
    info.write_text(json.dumps({
        "device": args.device, "lunch": lunch, "product_out": str(tree / product_out),
        "modules": args.modules, "commit": commit, "built": stamp, "packed": packed,
        "image": image,
    }, indent=2) + "\n")
    log(f"built {args.device} in {minutes} min")
    return 0


