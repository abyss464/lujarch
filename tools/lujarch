ROOT = Path(__file__).resolve().parent.parent
TARGET = ROOT / "target"
SYSTEM = ROOT / "system"
ITEMLESS = {"terms.md"}

ITEM_RE = re.compile(r"^### ([A-Z]{2,5})-(\d+) \S")
FIELDS = ("Home", "Switch", "Default", "Verify")
VERIFY_VALUES = {"vm", "phone"}
ID_RE = r"[A-Z]{2,5}-\d+"
VERIFIES_RE = re.compile(rf"verifies:\s*({ID_RE}(?:\s*,\s*{ID_RE})*)")

FORBIDDEN_IN_TARGET = [
    (re.compile(r"\b(?:19|20)\d{2}-\d{2}-\d{2}\b"), "date"),
    (re.compile(r"\bD-\d{3}\b"), "decision reference"),
    (re.compile(r"\b(?:TODO|TBD|FIXME)\b"), "unfinished marker"),
]
LEGACY = [re.compile(r"fuxi-?os", re.IGNORECASE), re.compile(r"\bFuxi[A-Z]")]
CJK_RANGES = ((0x3000, 0x303F), (0x3040, 0x30FF), (0x3400, 0x4DBF), (0x4E00, 0x9FFF),
              (0xF900, 0xFAFF), (0xFF00, 0xFFEF))
CJK_RE = re.compile("[" + "".join(f"{chr(a)}-{chr(b)}" for a, b in CJK_RANGES) + "]")
CJK_ALLOWED_FILES = {"README.md", "target/terms.md"}
RECORD_RE = re.compile(
    r"^(?:plans?|pending|state|status|decisions?|changelog|changes|history|todo|roadmap|"
    r"known[-_]issues|notes|journal|releases)$",
    re.IGNORECASE,
)

