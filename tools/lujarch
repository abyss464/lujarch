def main():
    parser = argparse.ArgumentParser(prog="lujarch", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("check", help="check the repository against process/")
    test = sub.add_parser("test", help="run the tests of the target's items")
    test.add_argument("selectors", nargs="*",
                      help="items, features or tests to run (default: every test)")
    test.add_argument("--script", nargs=argparse.REMAINDER, metavar="FILE",
                      help="FILE [ARG...]: run FILE with the arguments after it as a test runs, in "
                           "its own output folder, recording nothing")
    status = sub.add_parser("status", help="progress of the target")
    status.add_argument("--list", action="store_true", help="list the items without a test")
    sub.add_parser("pin", help="write upstream.xml from the tree's commits")
    sub.add_parser("sync", help="sync the tree to upstream.xml and apply the patches")
    sub.add_parser("fetch", help="download the pinned prebuilts the host lacks and build the apps")
    sub.add_parser("patch", help="apply the patches of system/order")
    sub.add_parser("unpatch", help="revert the patches of system/order")
    save = sub.add_parser("save", help="save the tree's changes into an entry's patches")
    save.add_argument("entry", help="tools, features/<feature> or device/<device>")
    save.add_argument("projects", nargs="*", help="projects to save (default: every changed one)")
    which = save.add_mutually_exclusive_group()
    which.add_argument("--name", help="start a new patch NNNN-<name>.patch")
    which.add_argument("--patch", help="the entry's patch file to fold the changes into")
    stock = sub.add_parser("stock", help="download and unpack a device's stock release")
    stock.add_argument("device")
    stock.add_argument("--add", nargs="+", metavar="GLOB",
                       help="pin the stock files matching these paths into lock.toml")
    build = sub.add_parser("build", help="build a device or some of its modules")
    build.add_argument("device")
    build.add_argument("modules", nargs="*")
    release = sub.add_parser("release", help="tag, build, sign and verify a release of HEAD")
    release.add_argument("--untested", action="store_true",
                         help="only when the owner asks: release HEAD before it passed the test "
                              "flow; the release notes list what had not passed")
    vm = sub.add_parser("vm", help="the virtual device").add_subparsers(dest="action",
                                                                       required=True)
    start = vm.add_parser("start", help="boot the vm build with empty data, ready for tests")
    start.add_argument("--timeout", type=int, default=900, help="seconds to wait for the boot")
    start.add_argument("--packed", action="store_true",
                       help="boot the images even when they lack files installed since they "
                            "were packed")
    vm.add_parser("stop", help="stop the virtual device")
    vm.add_parser("status", help="whether the virtual device is booted, and its build")
    sync = vm.add_parser("sync", help="copy built modules into the running device and restart "
                                      "what reads them")
    sync.add_argument("modules", nargs="*",
                      help="the modules to copy (none: the files the images lack)")
    shot = vm.add_parser("screenshot", help="write what the display shows, decorations included")
    shot.add_argument("path", nargs="?",
                      help=f"{', '.join(SCREENSHOT_FORMATS)} (default: <out>/vm/screenshots/)")
    shot.add_argument("--frames", type=int, default=1, help="how many frames to take")
    shot.add_argument("--interval", type=float, default=0.5,
                      help="seconds from the start of one frame to the next")
    args = parser.parse_args()
    return {
        "check": cmd_check, "status": cmd_status, "pin": cmd_pin, "sync": cmd_sync,
        "patch": cmd_patch, "unpatch": cmd_unpatch, "save": cmd_save, "stock": cmd_stock,
        "build": cmd_build, "fetch": cmd_fetch, "test": cmd_test,
        "vm": cmd_vm, "release": cmd_release,
    }[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
