# status


def test_results():
    host = host_or_none()
    head = git("rev-parse", "HEAD")
    if host is None or head.returncode or not host.get("paths", "out"):
        return set()
    path = host.path_of("paths", "out") / "test" / head.stdout.strip() / "results.json"
    try:
        items = json.loads(path.read_text(encoding="utf-8")).get("items", {})
    except (OSError, ValueError):
        return set()
    return {item_id for item_id, result in items.items() if result == "pass"}


def unmet_conventions():
    """Services started from a script and daemons listening on a socket (process/conventions.md)."""
    found = []
    for path in repo_files():
        name = rel(path)
        if not name.startswith("system/") or path.suffix != ".rc":
            continue
        text = read_text(path) or ""
        scripts = {p.name for p in path.parent.parent.rglob("*")
                   if p.is_file() and (read_text(p) or "").startswith("#!")}
        for n, line in enumerate(text.split("\n"), 1):
            words = line.split()
            if len(words) >= 3 and words[0] == "service" and os.path.basename(words[2]) in scripts:
                found.append(f"{name}:{n}: service {words[1]} runs a script")
            if words[:1] == ["socket"]:
                found.append(f"{name}:{n}: socket {words[1] if len(words) > 1 else ''}")
    return found


def cmd_status(args):
    covered = set()
    for path in repo_files():
        parts = rel(path).split("/")
        if "tests" in parts or parts[0] == "test":
            text = read_text(path)
            if text:
                for m in VERIFIES_RE.finditer(text):
                    covered.update(re.findall(ID_RE, m.group(1)))
    verified = test_results()
    rows = []
    totals = [0, 0, 0, 0, 0]
    for path in target_files():
        items, _ = parse_target(path)
        vm = sum(1 for _, v, _ in items if v == "vm")
        phone = sum(1 for _, v, _ in items if v == "phone")
        cov = [i for i, _, _ in items if i in covered]
        ver = [i for i, _, _ in items if i in verified]
        row = [len(items), vm, phone, len(cov), len(ver)]
        totals = [a + b for a, b in zip(totals, row)]
        rows.append((path.stem, row, [i for i, _, _ in items if i not in covered]))
    widths = (7, 6, 7, 8, 10)
    print(f"{'file':<16}{'items':>7}{'vm':>6}{'phone':>7}{'tested':>8}{'verified':>10}")
    for name, row, _ in rows:
        print(f"{name:<16}" + "".join(f"{v:>{w}}" for v, w in zip(row, widths)))
    print(f"{'total':<16}" + "".join(f"{v:>{w}}" for v, w in zip(totals, widths)))
    if args.list:
        for name, _, missing in rows:
            if missing:
                print(f"\n{name}: no test for " + ", ".join(missing))
    unmet = unmet_conventions()
    if unmet:
        print("\nnot yet meeting process/conventions.md (Services and IPC):")
        for line in unmet:
            print(f"  {line}")
    return 0


# ---------------------------------------------------------------------------
# Tree: pins, sync, patches


def cmd_pin(_args):
    host = Host()
    revert_patches(host.tree)
    out = subprocess.run(["repo", "manifest", "-r", "-o", str(ROOT / "upstream.xml")],
                         cwd=host.tree, capture_output=True, text=True)
    if out.returncode:
        die(f"repo manifest failed:\n{out.stderr.strip()}")
    count = (ROOT / "upstream.xml").read_text(encoding="utf-8").count("<project ")
    log(f"upstream.xml: {count} projects at the tree's commits")
    apply_patches(host.tree)
    return 0


# In the tree, each patch is one commit on top of its project's pinned commit. Only commits made
# here count as patch commits: committed at time 0 by PATCH_IDENTITY, with the patch's path as
# subject and the hash of the file they were made from as PATCH_TRAILER. The files are the source;
# the commits are rebuilt from them whenever they differ.
PATCH_IDENTITY = {
    "GIT_AUTHOR_NAME": "Lujarch", "GIT_AUTHOR_EMAIL": "patches@lujarch",
    "GIT_AUTHOR_DATE": "@0 +0000", "GIT_COMMITTER_NAME": "Lujarch",
    "GIT_COMMITTER_EMAIL": "patches@lujarch", "GIT_COMMITTER_DATE": "@0 +0000",
}
PATCH_TRAILER = "Patch-Blob"
APPLYING = "lujarch-applying"
EXPORT = ["-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
          "-c", "diff.relative=false", "-c", "core.quotePath=true",
          "diff", "--no-color", "--no-ext-diff", "--no-textconv", "--no-renames",
          "--binary", "--full-index"]
PATCH_NAME_RE = re.compile(r"^\d{4}-[a-z0-9]+(?:-[a-z0-9]+)*\.patch$")


def order_entries():
    path = SYSTEM / "order"
    if not path.exists():
        return []
    return [l.strip() for l in path.read_text(encoding="utf-8").split("\n") if l.strip()]


TOOL_PATCHES = ROOT / "tools" / "patches"


def patch_dirs():
    """The patch directories in application order, as (entry, patches/ path): the build
    system's own, which reach no image, then those of system/order."""
    result = [("tools", TOOL_PATCHES)] if TOOL_PATCHES.is_dir() else []
    for entry in order_entries():
        pdir = SYSTEM / entry / "patches"
        if not pdir.is_dir():
            die(f"system/order: {entry} has no patches/ directory")
        result.append((entry, pdir))
    return result


def patch_series():
    """Every patch in application order, as (patch file, project path)."""
    series = []
    for _, pdir in patch_dirs():
        for p in sorted(pdir.rglob("*.patch")):
            series.append((p, p.parent.relative_to(pdir).as_posix()))
    return series


def series_by_project():
    series = {}
    for patch, project in patch_series():
        series.setdefault(project, []).append(patch)
    return series


def upstream_projects():
    """Every project of upstream.xml as {tree path: pinned commit}."""
    text = (ROOT / "upstream.xml").read_text(encoding="utf-8")
    projects = {}
    for tag in re.findall(r"<project\s[^>]*>", text):
        name = re.search(r'\bname="([^"]+)"', tag)
        path = re.search(r'\bpath="([^"]+)"', tag)
        revision = re.search(r'\brevision="([0-9a-f]{40})"', tag)
        if name and revision:
            projects[(path or name).group(1)] = revision.group(1)
    return projects


def pgit(where, *args, env=None, input=None, check=False):
    run = subprocess.run(["git", "-C", str(where), *args], capture_output=True, text=True,
                         encoding="utf-8", errors="replace", env=env, input=input)
    if check and run.returncode:
        die(f"git {args[0]} in {where}: {run.stderr.strip()}")
    return run


def blob_id(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def patch_message(patch, data):
    return f"{rel(patch)}\n\n{PATCH_TRAILER}: {blob_id(data)}\n"


def git_dir(where):
    return Path(pgit(where, "rev-parse", "--absolute-git-dir", check=True).stdout.strip())


def changes(where):
    return pgit(where, "status", "--porcelain").stdout.strip()


def unmerged(where):
    return sorted(set(pgit(where, "diff", "--name-only", "--diff-filter=U").stdout.split()))


def diff_bytes(where, *revs):
    run = subprocess.run(["git", "-C", str(where), *EXPORT, *revs], capture_output=True)
    if run.returncode:
        die(f"git diff in {where}: {run.stderr.decode(errors='replace').strip()}")
    return run.stdout


def project_heads(tree, projects):
    def head(project):
        out = pgit(tree / project, "rev-parse", "HEAD")
        return project, out.stdout.strip() if out.returncode == 0 else None
    with ThreadPoolExecutor(16) as pool:
        return dict(pool.map(head, projects))


def commits_since(where, base):
    """The commits from base to HEAD, oldest first, as (commit, subject, blob, made here)."""
    out = pgit(where, "log", "--reverse", "--format=%H%x1f%ct%x1f%B%x1e", f"{base}..HEAD",
               check=True)
    result = []
    for record in out.stdout.split("\x1e"):
        record = record.strip("\n")
        if not record.strip():
            continue
        commit, ctime, body = record.split("\x1f", 2)
        m = re.search(rf"^{PATCH_TRAILER}: ([0-9a-f]{{40}})$", body, re.MULTILINE)
        result.append((commit, body.split("\n", 1)[0], m and m.group(1),
                       ctime == "0" and m is not None))
    return result


def patch_base(where):
    """The upstream commit under a project's patch commits, and those commits, oldest first."""
    out = pgit(where, "log", "--first-parent", "--format=%H%x1f%ct%x1f%B%x1e", "HEAD",
               check=True)
    for record in out.stdout.split("\x1e"):
        record = record.strip("\n")
        if not record.strip():
            continue
        commit, ctime, body = record.split("\x1f", 2)
        if ctime != "0" or not re.search(rf"^{PATCH_TRAILER}: ", body, re.MULTILINE):
            return commit, commits_since(where, commit)
    die(f"{where}: no upstream commit under its patch commits")


def in_sync(made, patch):
    _, subject, blob, ours = made
    return ours and subject == rel(patch) and blob == blob_id(patch.read_bytes())


def commit_index(where, message):
    """Commit the project's index on HEAD the way patch commits are made."""
    tree = pgit(where, "write-tree", check=True).stdout.strip()
    commit = pgit(where, "commit-tree", tree, "-p", "HEAD", "-F", "-",
                  env={**os.environ, **PATCH_IDENTITY}, input=message, check=True).stdout.strip()
    pgit(where, "update-ref", "--no-deref", "HEAD", commit, check=True)
    return commit


def conflict_files(where, resolving=False):
    """Files a patch still conflicts in: leftover markers, rejected hunks, and, until the
    resolution starts, unmerged paths."""
    found = set() if resolving else set(unmerged(where))
    rejects = pgit(where, "ls-files", "--others", "--", "*.rej").stdout.split("\n")
    found |= {r for r in rejects if r}
    listed = pgit(where, "diff", "--name-only", "HEAD").stdout.split("\n")
    listed += pgit(where, "ls-files", "--others", "--exclude-standard").stdout.split("\n")
    for name in filter(None, listed):
        text = read_text(where / name)
        if text and re.search(r"^(<{7}|>{7}) ", text, re.MULTILINE):
            found.add(name)
    return sorted(found)


def apply_one(where, patch):
    """Apply one patch as a commit. On a conflict, leave it in the tree to be resolved."""
    data = patch.read_bytes()
    run = pgit(where, "apply", "--3way", "--whitespace=nowarn", str(patch))
    if run.returncode == 0 and not unmerged(where):
        commit_index(where, patch_message(patch, data))
        return True
    if not unmerged(where) and not changes(where):
        # No three-way merge without the blobs the patch was made from: apply what fits.
        pgit(where, "apply", "--reject", "--whitespace=nowarn", str(patch))
    (git_dir(where) / APPLYING).write_text(rel(patch) + "\n")
    return False


def finish_applying(where, project, wanted):
    marker = git_dir(where) / APPLYING
    patch = ROOT / marker.read_text().strip()
    if patch not in wanted:
        die(f"{project}: {rel(patch)} is being resolved but is no longer a patch of it; "
            f"drop the resolution with git -C {where} reset --hard, delete {marker}")
    left = conflict_files(where, resolving=True)
    if left:
        die(f"{project}: {rel(patch)} still conflicts in " + ", ".join(left))
    pgit(where, "add", "-A", check=True)
    data = diff_bytes(where, "--cached", "HEAD")
    if not data:
        die(f"{project}: the resolution of {rel(patch)} changes nothing")
    patch.write_bytes(data)
    commit_index(where, patch_message(patch, data))
    marker.unlink()
    log(f"{project}: {rel(patch)} resolved and saved")


def apply_patches(tree):
    """Bring every project to its pinned commit plus its patches, one commit per patch."""
    pins = upstream_projects()
    series = series_by_project()
    for project in series:
        if project not in pins:
            die(f"patches for {project}, which upstream.xml does not have")
    heads = project_heads(tree, pins)
    applied = kept = 0
    for project, pinned in pins.items():
        wanted = series.get(project, [])
        if not wanted and heads[project] == pinned:
            continue
        where = tree / project
        if heads[project] is None:
            die(f"{project} is not in the tree (lujarch sync)")
        if (git_dir(where) / APPLYING).exists():
            finish_applying(where, project, wanted)
        elif changes(where):
            die(f"{project} has changes no patch holds: lujarch save them, or discard them")
        base, made = patch_base(where)
        if base != pinned:
            die(f"{project} is on {base[:12]}, upstream.xml pins {pinned[:12]} (lujarch sync)")
        k = 0
        while k < min(len(made), len(wanted)) and in_sync(made[k], wanted[k]):
            k += 1
        if k < len(made):
            pgit(where, "checkout", "-q", "--detach", made[k - 1][0] if k else pinned, check=True)
        kept += k
        for patch in wanted[k:]:
            if not apply_one(where, patch):
                die(f"{rel(patch)} does not apply cleanly to {project}. Resolve these files in "
                    f"{where}, then run lujarch patch again:\n  "
                    + "\n  ".join(conflict_files(where) or ["(nothing applied)"]))
            applied += 1
            log(f"applied {rel(patch)}")
    if applied or kept:
        log(f"patches: {applied} applied, {kept} already in the tree")


def revert_patches(tree):
    """Bring every project back to the upstream commit under its patch commits."""
    pins = upstream_projects()
    heads = project_heads(tree, pins)
    for project, pinned in pins.items():
        if heads[project] in (None, pinned):
            continue
        where = tree / project
        if (git_dir(where) / APPLYING).exists():
            die(f"{project}: a patch is being resolved there; finish it with lujarch patch")
        if changes(where):
            die(f"{project} has changes no patch holds: lujarch save them, or discard them")
        base, made = patch_base(where)
        if made:
            pgit(where, "checkout", "-q", "--detach", base, check=True)
            log(f"reverted {len(made)} patch{'es' if len(made) > 1 else ''} in {project}")


EXTRA_MANIFEST = ".lujarch-files"


def extra_files(host):
    """vendor/extra as the tools stage it: every feature and device directory without its
    patches and tests, each device's files from its stock release, and the two makefiles
    LineageOS includes from vendor/extra."""
    files = {}
    for device, pin in lock_file().get("stock", {}).items():
        dump = stock_dump_dir(host, pin)
        if not pin.get("files"):
            continue
        if not (dump / STOCK_UNPACKED).is_file():
            die(f"{device} takes files from {pin['release']}, which is not unpacked: "
                f"lujarch stock {device}")
        for name, digest in sorted(pin.get("files", {}).items()):
            src = dump / name
            data = src.read_bytes() if src.is_file() else None
            if data is None or hashlib.sha256(data).hexdigest() != digest:
                die(f"{device}: {name} of {pin['release']} is missing or differs from lock.toml")
            files[f"device/{device}/stock/{name}"] = data
    features, devices = [], []
    tracked = set(repo_files())
    for kind, found in (("features", features), ("device", devices)):
        base = SYSTEM / kind
        for d in sorted(p for p in base.iterdir() if p.is_dir()) if base.is_dir() else []:
            staged = False
            for src in sorted(p for p in tracked if d in p.parents):
                inner = src.relative_to(d)
                if inner.parts[0] in ("patches", "tests", "components") or src.name == ".gitkeep":
                    continue
                files[f"{kind}/{d.name}/{inner.as_posix()}"] = src.read_bytes()
                staged = True
            if staged:
                found.append(d.name)
    files.update(component_files(host))
    if not files:
        return {}

    def products(name):
        meta = SYSTEM / "features" / name / "feature.toml"
        only = load_toml(meta).get("devices") if meta.is_file() else None
        return [device_config(d)["product"] for d in only] if only else None

    def guarded(makefile, line):
        out = []
        ordered = sorted(features, key=lambda f: (f != "core", f))
        for name in ordered:
            if f"features/{name}/{makefile}" not in files:
                continue
            only = products(name)
            if only:
                out.append(f"ifneq ($(filter {' '.join(only)},$(TARGET_PRODUCT)),)")
            out.append(line.format(path=f"vendor/extra/features/{name}/{makefile}"))
            if only:
                out.append("endif")
        for name in devices:
            if f"device/{name}/{makefile}" in files:
                out += [f"ifeq ($(TARGET_PRODUCT),{device_config(name)['product']})",
                        line.format(path=f"vendor/extra/device/{name}/{makefile}"), "endif"]
        return "# Generated by tools/lujarch from system/.\n" + "\n".join(out) + "\n"

    if "features/core/Android.bp" in files:
        files["features/core/generated/settings-mirror.txt"] = settings_mirror().encode()
        files["features/core/generated/Android.bp"] = settings_libraries(features).encode()
    files["product.mk"] = guarded("product.mk", "$(call inherit-product, {path})").encode()
    files["BoardConfigExtra.mk"] = guarded("board.mk", "include {path}").encode()
    return files


SETTING_TYPES = {"bool": bool, "int": int, "string": str}


def feature_settings():
    """Every switch of every feature's settings.toml, as (feature, key, entry)."""
    out = []
    base = SYSTEM / "features"
    for path in sorted(base.glob("*/settings.toml")) if base.is_dir() else []:
        for key, entry in load_toml(path).items():
            out.append((path.parent.name, key, entry))
    return out


def settings_mirror():
    """settings key, mirror property and default of every Global switch, one per line."""
    lines = []
    for feature, key, entry in feature_settings():
        if entry.get("table") != "global":
            continue
        name = feature.replace("-", "_")
        default = entry["default"]
        if isinstance(default, bool):
            default = int(default)
        lines.append(f"lujarch_{name}_{key}\tlujarch.setting.{name}.{key}\t{default}\n")
    return "".join(lines)


def settings_libraries(features):
    """The defaults of Lujarch Settings: every feature's page library, Lujarch<Feature>Settings."""
    libs = [f for f in features if f != "core" and (SYSTEM / "features" / f / "src" / "settings").is_dir()]
    names = "".join(f'        "Lujarch{"".join(w.title() for w in f.split("-"))}Settings",\n'
                    for f in libs)
    return ("// Generated by tools/lujarch from system/.\n"
            "java_defaults {\n"
            '    name: "lujarch_settings_features",\n'
            f"    static_libs: [\n{names}    ],\n"
            "}\n")


# ---------------------------------------------------------------------------
# Components: programs a feature builds outside the tree


# The API level the components are linked for.
COMPONENT_API = 34
GO_ARCH = {"arm64": "arm64", "x86_64": "amd64"}
RUST_ARCH = {"arm64": "aarch64", "x86_64": "x86_64"}


def device_arches():
    return sorted({load_toml(p).get("arch", "arm64")
                   for p in (SYSTEM / "device").glob("*/device.toml")})


def feature_components():
    """Every component of every feature.toml, as (feature, name, spec)."""
    out = []
    for path in sorted((SYSTEM / "features").glob("*/feature.toml")):
        for name, spec in load_toml(path).get("components", {}).items():
            out.append((path.parent.name, name, spec))
    return out


def component_patches(feature, name):
    return sorted((SYSTEM / "features" / feature / "components" / name).glob("*.patch"))


def tree_rust(tree):
    text = (tree / "build" / "soong" / "rust" / "config" / "global.go").read_text()
    m = re.search(r'RustDefaultVersion\s*=\s*"([^"]+)"', text)
    if not m:
        die("no RustDefaultVersion in build/soong/rust/config/global.go")
    bin_dir = tree / "prebuilts" / "rust-toolchain" / "linux-x86" / m.group(1) / "bin"
    if not (bin_dir / "cargo").is_file():
        die(f"no cargo in {bin_dir}")
    return bin_dir


def component_source(host, name, pin):
    """A checkout of the component's pinned commit, from its repository on this computer."""
    repo = host.path_of("sources", name)
    commit = pin["commit"]
    if pgit(repo, "cat-file", "-e", f"{commit}^{{commit}}").returncode:
        die(f"{repo} has no commit {commit} of {name} (lock.toml); fetch it there")
    src = host.out / "components" / name / "src"
    if not (src / ".git").is_dir():
        src.parent.mkdir(parents=True, exist_ok=True)
        if subprocess.run(["git", "clone", "-q", "--no-checkout", str(repo), str(src)]).returncode:
            die(f"could not clone {repo}")
    if pgit(src, "cat-file", "-e", f"{commit}^{{commit}}").returncode:
        pgit(src, "fetch", "-q", str(repo), commit, check=True)
    pgit(src, "checkout", "-q", "--force", "--detach", commit, check=True)
    pgit(src, "clean", "-q", "-fdx", check=True)
    return src


def build_component(host, feature, name, spec, arch):
    """The component's binary for arch, built once for each pin, patch series and toolchain."""
    tree = host.tree
    pin = lock_file().get("components", {}).get(name)
    if not pin or "commit" not in pin:
        die(f"component {name} of {feature} has no commit in lock.toml")
    ndk = host.path_of("paths", "ndk") / "toolchains" / "llvm" / "prebuilt" / "linux-x86_64" / "bin"
    clang = ndk / f"{RUST_ARCH[arch]}-linux-android{COMPONENT_API}-clang"
    if not clang.is_file():
        die(f"no {clang}")
    patches = component_patches(feature, name)
    if spec["build"] == "go":
        toolchain = host.path_of("paths", "go") / "bin"
    elif spec["build"] == "cargo":
        toolchain = tree_rust(tree)
    else:
        die(f"component {name}: build is go or cargo")
    digest = hashlib.sha256()
    toolchain_version = subprocess.run(
        [str(toolchain / "go"), "version"] if spec["build"] == "go"
        else [str(toolchain / "rustc"), "--version"],
        capture_output=True, text=True).stdout.strip()
    for part in (json.dumps(spec, sort_keys=True), json.dumps(pin, sort_keys=True), arch,
                 str(clang), str(toolchain.resolve()), toolchain_version):
        digest.update(part.encode() + b"\0")
    for patch in patches:
        digest.update(patch.read_bytes())
    out = host.out / "components" / name / arch / digest.hexdigest()[:16] / spec["module"]
    if out.is_file():
        return out
    src = component_source(host, name, pin)
    env = dict(os.environ, LC_ALL="C", TZ="UTC")
    log(f"building component {name} ({pin.get('version', pin['commit'][:12])}, {arch})")
    if spec["build"] == "go":
        env.update({"GOROOT": str(toolchain.parent), "GOTOOLCHAIN": "local", "GOPROXY": "off",
                    "GOFLAGS": "-mod=mod",
                    "GOCACHE": str(host.out / "components" / "go-cache")})
        # The modules come from the computer's module cache, checked against go.sum.
        if subprocess.run([str(toolchain / "go"), "mod", "vendor"], cwd=src, env=env).returncode:
            die(f"{name}: go mod vendor failed (are its modules in the module cache?)")
    for patch in patches:
        if subprocess.run(["git", "apply", str(patch)], cwd=src).returncode:
            die(f"{name}: {rel(patch)} does not apply")
    out.parent.mkdir(parents=True, exist_ok=True)
    if spec["build"] == "go":
        version = pin["version"] + spec.get("version_suffix", "")
        stamp = pgit(src, "show", "-s", "--format=%ct", pin["commit"], check=True).stdout.strip()
        ldflags = " ".join([*(f"-X '{v}={version}'" for v in spec.get("version_vars", [])),
                            *(f"-X '{v}={stamp}'" for v in spec.get("stamp_vars", [])),
                            *spec.get("ldflags", []), "-w", "-s", "-buildid="])
        env.update({"GOFLAGS": "-mod=vendor", "CGO_ENABLED": "1", "GOOS": "android",
                    "GOARCH": GO_ARCH[arch], "CC": str(clang)})
        cmd = [str(toolchain / "go"), "build", "-trimpath", "-ldflags", ldflags, "-o", str(out)]
        if spec.get("tags"):
            cmd += ["-tags", ",".join(spec["tags"])]
        built = subprocess.run([*cmd, spec.get("package", ".")], cwd=src, env=env).returncode == 0
    else:
        target = f"{RUST_ARCH[arch]}-linux-android"
        triple = target.upper().replace("-", "_")
        env.update({"RUSTC": str(toolchain / "rustc"), "RUSTC_WRAPPER": "",
                    "CARGO_BUILD_RUSTC_WRAPPER": "",
                    "CARGO_TARGET_DIR": str(host.out / "components" / name / "target"),
                    # Android's standard library is built to abort on a panic.
                    "CARGO_PROFILE_RELEASE_PANIC": "abort",
                    f"CARGO_TARGET_{triple}_LINKER": str(clang),
                    f"CC_{target.replace('-', '_')}": str(clang),
                    f"AR_{target.replace('-', '_')}": str(ndk / "llvm-ar")})
        built = subprocess.run([str(toolchain / "cargo"), "build", "--offline", "--locked",
                                "--release", "--quiet", "--target", target], cwd=src,
                               env=env).returncode == 0
        if built:
            shutil.copyfile(Path(env["CARGO_TARGET_DIR"]) / target / "release" / spec["binary"],
                            out)
    pgit(src, "checkout", "-q", "--force", pin["commit"], check=True)
    pgit(src, "clean", "-q", "-fdx", check=True)
    if not built:
        out.unlink(missing_ok=True)
        die(f"component {name} did not build for {arch}")
    return out


def component_files(host):
    """vendor/extra/features/<feature>/prebuilt/<arch>/<module> of every component."""
    files = {}
    for feature, name, spec in feature_components():
        for arch in device_arches():
            path = build_component(host, feature, name, spec, arch)
            files[f"features/{feature}/prebuilt/{arch}/{spec['module']}"] = path.read_bytes()
    return files


def staged_edits(dest):
    """Files of vendor/extra changed in the tree since the tools staged it."""
    manifest = dest / EXTRA_MANIFEST
    if not dest.exists():
        return []
    if not manifest.is_file():
        return ["vendor/extra was not staged by lujarch"]
    known = dict(line.split(" ", 1)[::-1] for line in manifest.read_text().split("\n") if line)
    edits = []
    for path in sorted(p for p in dest.rglob("*") if p.is_file() and p != manifest):
        name = path.relative_to(dest).as_posix()
        if known.pop(name, None) != blob_id(path.read_bytes()):
            edits.append(name)
    return edits + sorted(known)


def stage_extra(host, tree):
    """Stage vendor/extra from system/; a file edited there in the tree stops it."""
    dest = tree / "vendor" / "extra"
    edits = staged_edits(dest)
    if edits:
        die("vendor/extra was edited in the tree; make the change in system/ instead:\n  "
            + "\n  ".join(edits[:40]))
    files = extra_files(host)
    for path in sorted(p for p in dest.rglob("*") if p.is_file()) if dest.exists() else []:
        name = path.relative_to(dest).as_posix()
        if name != EXTRA_MANIFEST and name not in files:
            path.unlink()
    for name, data in files.items():
        path = dest / name
        if not path.is_file() or path.read_bytes() != data:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
    if dest.exists():
        for d in sorted((p for p in dest.rglob("*") if p.is_dir()), reverse=True):
            if not any(d.iterdir()):
                d.rmdir()
    if files:
        (dest / EXTRA_MANIFEST).write_text(
            "".join(f"{blob_id(data)} {name}\n" for name, data in sorted(files.items())))
    elif dest.exists():
        (dest / EXTRA_MANIFEST).unlink(missing_ok=True)
        dest.rmdir()


def unstage_extra(tree):
    dest = tree / "vendor" / "extra"
    edits = staged_edits(dest)
    if edits:
        die("vendor/extra was edited in the tree; make the change in system/ instead:\n  "
            + "\n  ".join(edits[:40]))
    if dest.exists():
        shutil.rmtree(dest)
        log("removed vendor/extra")


def prepare_tree(host):
    apply_patches(host.tree)
    stage_extra(host, host.tree)


