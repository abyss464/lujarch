def component_source(host, name, pin):
    """A checkout of the component's pinned commit, from its repository on this computer."""
    repo = host.path_of("sources", name)
    commit = pin["commit"]
    if pgit(repo, "cat-file", "-e", f"{commit}^{{commit}}").returncode:
        die(f"{repo} has no commit {commit} of {name} (lock.toml); fetch it there")
    src = host.out / "components" / name / "src"
    if not (src / ".git").is_dir():
        src.parent.mkdir(parents=True, exist_ok=True)
        if subprocess.run(["git", "clone", "-q", "--no-checkout", str(repo), str(src)]).returncode:
            die(f"could not clone {repo}")
    if pgit(src, "cat-file", "-e", f"{commit}^{{commit}}").returncode:
        pgit(src, "fetch", "-q", str(repo), commit, check=True)
    pgit(src, "checkout", "-q", "--force", "--detach", commit, check=True)
    pgit(src, "clean", "-q", "-fdx", check=True)
    return src


APP_BUILDS = ("gradle", "flutter")
FLUTTER_PLATFORM = {"arm64": "android-arm64", "x86_64": "android-x64"}


def component_arches(spec):
    """The architectures a component is built for: an app built by Gradle once for all."""
    return ["common"] if spec["build"] == "gradle" else device_arches()


def flutter_sdk(host, commit):
    """A checkout of the Flutter SDK at commit, from its repository on this computer."""
    repo = host.path_of("sources", "flutter")
    sdk = host.out / "components" / "flutter" / commit[:12]
    if not (sdk / "bin" / "flutter").is_file():
        if pgit(repo, "cat-file", "-e", f"{commit}^{{commit}}").returncode:
            die(f"{repo} has no Flutter commit {commit} (lock.toml); fetch it there")
        sdk.parent.mkdir(parents=True, exist_ok=True)
        if subprocess.run(["git", "clone", "-q", str(repo), str(sdk)]).returncode:
            die(f"could not clone {repo}")
        pgit(sdk, "checkout", "-q", "--force", "--detach", commit, check=True)
    return sdk


def app_component(host, feature, name, spec, arch, build=False):
    """The APK of an app component for arch. Only `lujarch fetch` builds apps, since Gradle and
    Flutter download what a build needs; every other step takes the APK fetch kept, one for
    each pin, patch series, recipe and toolchain."""
    pin = lock_file().get("components", {}).get(name)
    if not pin or "commit" not in pin:
        die(f"component {name} of {feature} has no commit in lock.toml")
    jdk = host.path_of("paths", "jdk")
    patches = component_patches(feature, name)
    digest = hashlib.sha256()
    for part in (json.dumps(spec, sort_keys=True), json.dumps(pin, sort_keys=True), arch,
                 str(jdk.resolve())):
        digest.update(part.encode() + b"\0")
    for patch in patches:
        digest.update(patch.read_bytes())
    out = host.out / "components" / name / arch / digest.hexdigest()[:16] / spec["module"]
    if out.is_file() or not build:
        if not out.is_file():
            die(f"app {name} ({arch}) is not built for its pin: lujarch fetch")
        return out
    src = component_source(host, name, pin)
    for patch in patches:
        if subprocess.run(["git", "apply", str(patch)], cwd=src).returncode:
            die(f"{name}: {rel(patch)} does not apply")
    sdk = host.path_of("paths", "android_sdk")
    gradle = host.path_of("paths", "gradle")
    # No Gradle or Kotlin daemon outlives the build (Flutter starts Gradle itself, so the
    # setting is Gradle's own, where every build of these apps reads it).
    gradle.mkdir(parents=True, exist_ok=True)
    (gradle / "gradle.properties").write_text(
        "# Written by tools/lujarch.\norg.gradle.daemon=false\n"
        "kotlin.compiler.execution.strategy=in-process\n")
    # UTF-8, since apps carry files named in other scripts.
    env = dict(os.environ, LC_ALL="C.UTF-8", TZ="UTC", JAVA_HOME=str(jdk), ANDROID_HOME=str(sdk),
               ANDROID_SDK_ROOT=str(sdk), GRADLE_USER_HOME=str(gradle))
    work = src / spec.get("dir", ".")
    log(f"building app {name} ({pin.get('version', pin['commit'][:12])}, {arch})")
    if spec["build"] == "gradle":
        cmd = ["./gradlew", "--console=plain", spec["task"]]
        apk = work / spec["output"]
    else:
        flutter = flutter_sdk(host, pin["flutter"])
        env.update({"PUB_CACHE": str(host.path_of("paths", "pub")),
                    "FLUTTER_ROOT": str(flutter), "FLUTTER_SUPPRESS_ANALYTICS": "true",
                    "PATH": f"{flutter / 'bin'}:{env.get('PATH', '')}"})
        cmd = [str(flutter / "bin" / "flutter"), "build", "apk", "--release",
               "--target-platform", FLUTTER_PLATFORM[arch], *spec.get("args", [])]
        apk = work / spec["output"].format(abi={"arm64": "arm64-v8a", "x86_64": "x86_64"}[arch])
    built = subprocess.run(cmd, cwd=work, env=env).returncode == 0 and apk.is_file()
    if built:
        out.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(apk, out)
    pgit(src, "checkout", "-q", "--force", pin["commit"], check=True)
    pgit(src, "clean", "-q", "-fdx", check=True)
    if not built:
        die(f"app {name} did not build for {arch}")
    return out


def build_component(host, feature, name, spec, arch):
    """The component's binary for arch, built once for each pin, patch series and toolchain."""
    if spec["build"] in APP_BUILDS:
        return app_component(host, feature, name, spec, arch)
    tree = host.tree
    pin = lock_file().get("components", {}).get(name)
    if not pin or "commit" not in pin:
        die(f"component {name} of {feature} has no commit in lock.toml")
    ndk = host.path_of("paths", "ndk") / "toolchains" / "llvm" / "prebuilt" / "linux-x86_64" / "bin"
    clang = ndk / f"{RUST_ARCH[arch]}-linux-android{COMPONENT_API}-clang"
    if not clang.is_file():
        die(f"no {clang}")
    patches = component_patches(feature, name)
    if spec["build"] == "go":
        toolchain = host.path_of("paths", "go") / "bin"
    elif spec["build"] == "cargo":
        toolchain = tree_rust(tree)
    else:
        die(f"component {name}: build is go, cargo, gradle or flutter")
    digest = hashlib.sha256()
    toolchain_version = subprocess.run(
        [str(toolchain / "go"), "version"] if spec["build"] == "go"
        else [str(toolchain / "rustc"), "--version"],
        capture_output=True, text=True).stdout.strip()
    for part in (json.dumps(spec, sort_keys=True), json.dumps(pin, sort_keys=True), arch,
                 str(clang), str(toolchain.resolve()), toolchain_version):
        digest.update(part.encode() + b"\0")
    for patch in patches:
        digest.update(patch.read_bytes())
    out = host.out / "components" / name / arch / digest.hexdigest()[:16] / spec["module"]
    if out.is_file():
        return out
    src = component_source(host, name, pin)
    env = dict(os.environ, LC_ALL="C", TZ="UTC")
    log(f"building component {name} ({pin.get('version', pin['commit'][:12])}, {arch})")
    if spec["build"] == "go":
        env.update({"GOROOT": str(toolchain.parent), "GOTOOLCHAIN": "local", "GOPROXY": "off",
                    "GOFLAGS": "-mod=mod",
                    "GOCACHE": str(host.out / "components" / "go-cache")})
        # The modules come from the computer's module cache, checked against go.sum.
        if subprocess.run([str(toolchain / "go"), "mod", "vendor"], cwd=src, env=env).returncode:
            die(f"{name}: go mod vendor failed (are its modules in the module cache?)")
    for patch in patches:
        if subprocess.run(["git", "apply", str(patch)], cwd=src).returncode:
            die(f"{name}: {rel(patch)} does not apply")
    out.parent.mkdir(parents=True, exist_ok=True)
    if spec["build"] == "go":
        version = pin["version"] + spec.get("version_suffix", "")
        stamp = pgit(src, "show", "-s", "--format=%ct", pin["commit"], check=True).stdout.strip()
        ldflags = " ".join([*(f"-X '{v}={version}'" for v in spec.get("version_vars", [])),
                            *(f"-X '{v}={stamp}'" for v in spec.get("stamp_vars", [])),
                            *spec.get("ldflags", []), "-w", "-s", "-buildid="])
        env.update({"GOFLAGS": "-mod=vendor", "CGO_ENABLED": "1", "GOOS": "android",
                    "GOARCH": GO_ARCH[arch], "CC": str(clang)})
        cmd = [str(toolchain / "go"), "build", "-trimpath", "-ldflags", ldflags, "-o", str(out)]
        if spec.get("tags"):
            cmd += ["-tags", ",".join(spec["tags"])]
        built = subprocess.run([*cmd, spec.get("package", ".")], cwd=src, env=env).returncode == 0
    else:
        target = f"{RUST_ARCH[arch]}-linux-android"
        triple = target.upper().replace("-", "_")
        env.update({"RUSTC": str(toolchain / "rustc"), "RUSTC_WRAPPER": "",
                    "CARGO_BUILD_RUSTC_WRAPPER": "",
                    "CARGO_TARGET_DIR": str(host.out / "components" / name / "target"),
                    # Android's standard library is built to abort on a panic.
                    "CARGO_PROFILE_RELEASE_PANIC": "abort",
                    f"CARGO_TARGET_{triple}_LINKER": str(clang),
                    f"CC_{target.replace('-', '_')}": str(clang),
                    f"AR_{target.replace('-', '_')}": str(ndk / "llvm-ar")})
        built = subprocess.run([str(toolchain / "cargo"), "build", "--offline", "--locked",
                                "--release", "--quiet", "--target", target], cwd=src,
                               env=env).returncode == 0
        if built:
            shutil.copyfile(Path(env["CARGO_TARGET_DIR"]) / target / "release" / spec["binary"],
                            out)
    pgit(src, "checkout", "-q", "--force", pin["commit"], check=True)
    pgit(src, "clean", "-q", "-fdx", check=True)
    if not built:
        out.unlink(missing_ok=True)
        die(f"component {name} did not build for {arch}")
    return out


def component_files(host):
    """vendor/extra/features/<feature>/prebuilt/<arch>/<module> of every component, with `.apk`
    for an app (the build reads an app's manifest only from a file named so)."""
    files = {}
    for feature, name, spec in feature_components():
        suffix = ".apk" if spec["build"] in APP_BUILDS else ""
        for arch in component_arches(spec):
            path = build_component(host, feature, name, spec, arch)
            files[f"features/{feature}/prebuilt/{arch}/{spec['module']}{suffix}"] = path.read_bytes()
    return files


def feature_prebuilts():
    """Every prebuilt of every feature.toml, as (feature, name, spec)."""
    out = []
    for path in sorted((SYSTEM / "features").glob("*/feature.toml")):
        for name, spec in load_toml(path).get("prebuilts", {}).items():
            out.append((path.parent.name, name, spec))
    return out


def prebuilt_cache(host, pin):
    """A pinned prebuilt in the host's prebuilts directory, named by its sha256."""
    return host.path_of("paths", "prebuilts") / pin["sha256"]


def prebuilt_files(host):
    """vendor/extra/features/<feature>/prebuilt/<arch>/<module> of every pinned prebuilt."""
    files = {}
    pins = lock_file().get("prebuilts", {})
    for feature, name, spec in feature_prebuilts():
        for arch, pin in pins.get(name, {}).items():
            if not isinstance(pin, dict):
                continue
            path = prebuilt_cache(host, pin)
            if not path.is_file():
                die(f"prebuilt {name} for {arch} is not fetched (lujarch fetch)")
            if sha256_file(path) != pin["sha256"]:
                die(f"{path} does not match the sha256 of prebuilt {name} for {arch}")
            files[f"features/{feature}/prebuilt/{arch}/{spec['module']}"] = path.read_bytes()
    return files


def feature_downloads():
    """Every download of every feature.toml, as (feature, name, spec)."""
    out = []
    for path in sorted((SYSTEM / "features").glob("*/feature.toml")):
        for name, spec in load_toml(path).get("downloads", {}).items():
            out.append((path.parent.name, name, spec))
    return out


def download_files():
    """vendor/extra/features/<feature>/downloads: the lock.toml pins of what the feature's
    programs download on the device, as "<name>.<key>: <value>" lines."""
    pins = lock_file().get("downloads", {})
    lines = {}
    for feature, name, _spec in feature_downloads():
        pin = pins.get(name)
        if not isinstance(pin, dict):
            die(f"download {name} of {feature} is not pinned in lock.toml")
        out = lines.setdefault(feature, [])
        for key in ("url", "version", "sha256"):
            out.append(f"{name}.{key}: {pin[key]}\n")
    return {f"features/{feature}/downloads": "".join(out).encode() for feature, out in lines.items()}


def cmd_fetch(_args):
    """Downloads the pinned prebuilts the host does not have yet, builds the apps, and makes the
    generated files that need tools beyond Python."""
    host = Host()
    for name, pins in lock_file().get("prebuilts", {}).items():
        for arch, pin in pins.items():
            if not isinstance(pin, dict):
                continue
            path = prebuilt_cache(host, pin)
            if path.is_file() and sha256_file(path) == pin["sha256"]:
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            part = path.with_suffix(".part")
            log(f"fetching {name} for {arch}: {pin['url']}")
            run = subprocess.run(["curl", "-fL", "--retry", "5", "-o", str(part), pin["url"]])
            if run.returncode:
                die(f"download of {name} for {arch} failed")
            if sha256_file(part) != pin["sha256"]:
                part.unlink()
                die(f"{pin['url']} does not match its sha256 in lock.toml")
            part.rename(path)
    log("every pinned prebuilt is fetched")
    for feature, name, spec in feature_components():
        if spec["build"] in APP_BUILDS:
            for arch in component_arches(spec):
                app_component(host, feature, name, spec, arch, build=True)
    log("every app is built")
    for feature, name, spec in feature_generated():
        if not spec.get("fetch"):
            continue
        for tool in spec["fetch"]:
            if not shutil.which(tool):
                die(f"{name} of {feature} needs {tool}")
        path = generated_cache(host, feature, name, spec)
        if path.exists():
            continue
        log(f"making {name} of {feature}")
        work = host.out / "generated" / feature / name / "work"
        run_generator(feature, name, spec, path, work)
        shutil.rmtree(work, ignore_errors=True)
    log("every generated file is made")
    return 0


# ---------------------------------------------------------------------------
# Generated files: made by a feature's own scripts from its sources


def feature_generated():
    """Every [generated.<name>] of every feature.toml, as (feature, name, spec)."""
    out = []
    for path in sorted((SYSTEM / "features").glob("*/feature.toml")):
        for name, spec in load_toml(path).get("generated", {}).items():
            out.append((path.parent.name, name, spec))
    return out


def generated_sources(script):
    """The script and the modules of its own directory it imports."""
    finder = modulefinder.ModuleFinder(path=[str(script.parent)])
    finder.run_script(str(script))
    found = {Path(m.__file__).resolve() for m in finder.modules.values() if m.__file__}
    return sorted(p for p in found if p.parent == script.parent.resolve())


def generated_digest(feature, spec):
    """The sources of a generated file and the versions of the tools it runs, as one digest."""
    script = SYSTEM / "features" / feature / spec["script"]
    digest = hashlib.sha256()
    for path in generated_sources(script):
        digest.update(path.name.encode() + b"\0" + path.read_bytes())
    for tool in spec.get("fetch", []):
        run = subprocess.run([tool, "--version"], capture_output=True, text=True)
        digest.update(f"{tool} {run.stdout.strip().splitlines()[0] if run.stdout.strip() else ''}".encode())
    return digest.hexdigest()


def run_generator(feature, name, spec, out, work):
    script = SYSTEM / "features" / feature / spec["script"]
    out.parent.mkdir(parents=True, exist_ok=True)
    work.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(out.name + ".part")
    shutil.rmtree(tmp, ignore_errors=True)
    if subprocess.run([sys.executable, str(script), str(tmp), str(work)]).returncode or not tmp.exists():
        die(f"{feature}: {spec['script']} did not make {name}")
    shutil.rmtree(out, ignore_errors=True)
    tmp.replace(out)


def generated_output(staged, path):
    """A generated file, or every file of a generated directory, as staged paths and contents."""
    if path.is_file():
        return {staged: path.read_bytes()}
    return {f"{staged}/{p.relative_to(path).as_posix()}": p.read_bytes()
            for p in sorted(path.rglob("*")) if p.is_file()}


def generated_cache(host, feature, name, spec):
    return (host.out / "generated" / feature / name / generated_digest(feature, spec)[:16]
            / spec["output"])


def generated_files(host):
    """vendor/extra/features/<feature>/generated/<output> of every generated file or directory:
    made now, or for one that needs tools beyond Python (`fetch`), the one `lujarch fetch` made
    for its sources."""
    files = {}
    for feature, name, spec in feature_generated():
        staged = f"features/{feature}/generated/{spec['output']}"
        if spec.get("fetch"):
            path = generated_cache(host, feature, name, spec)
            if not path.exists():
                die(f"{name} of {feature} is not made for its sources: lujarch fetch")
            files.update(generated_output(staged, path))
            continue
        with tempfile.TemporaryDirectory() as tmp:
            out = Path(tmp) / spec["output"]
            run_generator(feature, name, spec, out, Path(tmp) / "work")
            files.update(generated_output(staged, out))
    return files


def staged_edits(dest):
    """Files of vendor/extra changed in the tree since the tools staged it."""
    manifest = dest / EXTRA_MANIFEST
    if not dest.exists():
        return []
    if not manifest.is_file():
        return ["vendor/extra was not staged by lujarch"]
    known = dict(line.split(" ", 1)[::-1] for line in manifest.read_text().split("\n") if line)
    edits = []
    for path in sorted(p for p in dest.rglob("*") if p.is_file() and p != manifest):
        name = path.relative_to(dest).as_posix()
        if known.pop(name, None) != blob_id(path.read_bytes()):
            edits.append(name)
    return edits + sorted(known)


def stage_extra(host, tree):
    """Stage vendor/extra from system/; a file edited there in the tree stops it."""
    dest = tree / "vendor" / "extra"
    edits = staged_edits(dest)
    if edits:
        die("vendor/extra was edited in the tree; make the change in system/ instead:\n  "
            + "\n  ".join(edits[:40]))
    files = extra_files(host)
    for path in sorted(p for p in dest.rglob("*") if p.is_file()) if dest.exists() else []:
        name = path.relative_to(dest).as_posix()
        if name != EXTRA_MANIFEST and name not in files:
            path.unlink()
    for name, data in files.items():
        path = dest / name
        if not path.is_file() or path.read_bytes() != data:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
    if dest.exists():
        for d in sorted((p for p in dest.rglob("*") if p.is_dir()), reverse=True):
            if not any(d.iterdir()):
                d.rmdir()
    if files:
        (dest / EXTRA_MANIFEST).write_text(
            "".join(f"{blob_id(data)} {name}\n" for name, data in sorted(files.items())))
    elif dest.exists():
        (dest / EXTRA_MANIFEST).unlink(missing_ok=True)
        dest.rmdir()


def unstage_extra(tree):
    dest = tree / "vendor" / "extra"
    edits = staged_edits(dest)
    if edits:
        die("vendor/extra was edited in the tree; make the change in system/ instead:\n  "
            + "\n  ".join(edits[:40]))
    if dest.exists():
        shutil.rmtree(dest)
        log("removed vendor/extra")


def prepare_tree(host):
    apply_patches(host.tree)
    stage_extra(host, host.tree)


# ---------------------------------------------------------------------------
# Stock releases

STOCK_UNPACKED = ".lujarch-unpacked"
STOCK_PARTITIONS = ("odm", "product", "system", "system_ext", "vendor")


def stock_package(host, pin):
    name = Path(pin["urls"][0].split("?", 1)[0]).name
    return host.path_of("paths", "stock") / pin["release"] / name


def stock_dump_dir(host, pin):
    """<stock>/<release>/<package name>/: the package's partitions, unpacked next to it."""
    package = stock_package(host, pin)
    return package.parent / package.name.removesuffix(".zip")


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(1 << 22):
            digest.update(chunk)
    return digest.hexdigest()


def stock_dump(host, device):
    """Download, check and unpack a device's stock release; return its unpacked partitions."""
    pin = lock_file().get("stock", {}).get(device)
    if not pin:
        die(f"lock.toml pins no stock release for {device}")
    dump = stock_dump_dir(host, pin)
    if (dump / STOCK_UNPACKED).is_file():
        return pin, dump
    package = stock_package(host, pin)
    package.parent.mkdir(parents=True, exist_ok=True)
    if not package.is_file() or package.with_name(package.name + ".aria2").exists():
        log(f"downloading {pin['release']} into {package.parent}")
        if shutil.which("aria2c"):
            run = subprocess.run(["aria2c", "-q", "--continue=true", "-x16", "-s16", "-k4M",
                                  "--max-tries=10", "--retry-wait=10", "--file-allocation=none",
                                  "-d", str(package.parent), "-o", package.name, *pin["urls"]])
        else:
            run = subprocess.run(["curl", "-fL", "--retry", "5", "-C", "-", "-o", str(package),
                                  pin["urls"][0]])
        if run.returncode:
            die(f"download of {pin['release']} failed")
    if sha256_file(package) != pin["sha256"]:
        die(f"{package} does not match lock.toml's sha256")
    log(f"unpacking {pin['release']} into {dump}")
    env = dict(os.environ)
    env["PATH"] = f"{env.get('PATH', '')}:{host.tree / 'out' / 'host' / 'linux-x86' / 'bin'}"
    run = subprocess.run([sys.executable, str(host.tree / "tools" / "extract-utils" / "extract.py"),
                          str(package)], cwd=host.tree, env=env)
    empty = [p for p in STOCK_PARTITIONS if not (dump / p).is_dir() or not any((dump / p).iterdir())]
    if run.returncode or empty:
        for p in empty:
            if (dump / p).is_dir():
                (dump / p).rmdir()
        die(f"unpacking {package} failed" + (f": no {', '.join(empty)}" if empty else ""))
    (dump / STOCK_UNPACKED).write_text(pin["sha256"] + "\n")
    return pin, dump


def pin_stock_files(device, names):
    """Write the sha256 of each named stock file into lock.toml's stock.<device>.files."""
    path = ROOT / "lock.toml"
    text = path.read_text(encoding="utf-8")
    header = f"[stock.{device}.files]"
    lines = text.rstrip("\n").split("\n")
    if header in lines:
        start = lines.index(header) + 1
        end = next((i for i in range(start, len(lines)) if lines[i].startswith("[")), len(lines))
    else:
        lines += ["", header]
        start = end = len(lines)
    entries = {}
    for line in lines[start:end]:
        if line.strip():
            key, _, value = line.partition("=")
            entries[key.strip().strip('"')] = value.strip().strip('"')
    entries.update(names)
    body = [f'"{k}" = "{v}"' for k, v in sorted(entries.items())]
    lines[start:end] = body + ([""] if end < len(lines) else [])
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def cmd_stock(args):
    host = Host()
    pin, dump = stock_dump(host, args.device)
    if args.add:
        found = {}
        for pattern in args.add:
            matches = sorted(p for p in dump.glob(pattern) if p.is_file())
            if not matches:
                die(f"nothing in {pin['release']} matches {pattern}")
            for p in matches:
                found[p.relative_to(dump).as_posix()] = sha256_file(p)
        pin_stock_files(args.device, found)
        log(f"pinned {len(found)} file{'s' if len(found) != 1 else ''} of {pin['release']}")
    print(f"{args.device}: {pin['release']} unpacked in {dump}; "
          f"{len(lock_file()['stock'][args.device].get('files', {}))} files pinned")
    return 0


def verify_tree(tree):
    """The tree must be exactly upstream.xml plus the patches."""
    pins = upstream_projects()
    series = series_by_project()

    def state(project):
        where = tree / project
        head = pgit(where, "rev-parse", "HEAD").stdout.strip()
        return project, head, changes(where)
    with ThreadPoolExecutor(16) as pool:
        states = list(pool.map(state, pins))
    problems = []
    for project, head, dirty in states:
        if dirty:
            problems.append(f"{project}: changes no patch holds")
        elif not series.get(project) and head != pins[project]:
            problems.append(f"{project}: not on its pinned commit")
    if problems:
        die("the tree is not upstream.xml plus the patches (lujarch save, or discard):\n  "
            + "\n  ".join(problems[:40]))


