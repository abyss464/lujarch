def main():
    parser = argparse.ArgumentParser(prog="lujarch", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("check", help="check the repository against process/")
    status = sub.add_parser("status", help="progress of the target")
    status.add_argument("--list", action="store_true", help="list the items without a test")
    sub.add_parser("pin", help="write upstream.xml from the tree's commits")
    sub.add_parser("sync", help="sync the tree to upstream.xml and apply the patches")
    sub.add_parser("patch", help="apply the patches of system/order")
    sub.add_parser("unpatch", help="revert the patches of system/order")
    build = sub.add_parser("build", help="build a device or some of its modules")
    build.add_argument("device")
    build.add_argument("modules", nargs="*")
    vm = sub.add_parser("vm", help="the virtual device")
    vm.add_argument("action", choices=("start", "stop", "status"))
    vm.add_argument("--timeout", type=int, default=900, help="seconds to wait for the boot")
    args = parser.parse_args()
    return {
        "check": cmd_check, "status": cmd_status, "pin": cmd_pin, "sync": cmd_sync,
        "patch": cmd_patch, "unpatch": cmd_unpatch, "build": cmd_build, "vm": cmd_vm,
    }[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
