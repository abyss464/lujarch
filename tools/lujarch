# Renames: texts that name LineageOS, said with Lujarch

RENAMED = re.compile(r"\bLineage(?:OS)?\b")
RENAMED_ELEMENT = re.compile(
    r'<(string|plurals|string-array)\b([^>]*\bname="([^"]+)"[^>]*)>(.*?)</\1>', re.S)
OVERLAY_HEADER = """<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/lujarch from {source}. -->
"""


def feature_renames():
    """Every [renames.<name>] of every feature.toml, as (feature, name, spec)."""
    out = []
    for path in sorted((SYSTEM / "features").glob("*/feature.toml")):
        for name, spec in load_toml(path).get("renames", {}).items():
            out.append((path.parent.name, name, spec))
    return out


def renamed(body):
    """body with Lujarch for LineageOS in its text, its markup as it is."""
    return "".join(part if part.startswith("<") else RENAMED.sub("Lujarch", part)
                   for part in re.split(r"(<[^>]+>)", body))


def renamed_values(tree, feature, name, spec):
    """{values directory: [resource element]} of every string of spec's resource directories
    whose text names LineageOS, with Lujarch in its place; the strings under keep stay."""
    keep, kept, out = set(spec.get("keep", [])), set(), {}
    for res in spec["res"]:
        base = tree / res
        if not base.is_dir():
            die(f"{feature}: renames.{name}: {res} is not in the tree")
        for values in sorted(base.glob("values*")):
            for xml in sorted(values.glob("*.xml")):
                for m in RENAMED_ELEMENT.finditer(xml.read_text(encoding="utf-8")):
                    tag, attrs, key, body = m.groups()
                    if not RENAMED.search(re.sub(r"<[^>]+>", "", body)):
                        continue
                    if key in keep:
                        kept.add(key)
                        continue
                    out.setdefault(values.name, []).append(
                        f"<{tag}{attrs}>{renamed(body)}</{tag}>")
    if keep - kept:
        die(f"{feature}: renames.{name} keeps strings that name no LineageOS: "
            + ", ".join(sorted(keep - kept)))
    if not out:
        die(f"{feature}: renames.{name}: no string of {', '.join(spec['res'])} names LineageOS")
    return out


def rename_files(host, features):
    """features/<feature>/generated/: one static overlay per [renames.<name>], and renames.mk
    that installs them."""
    files, modules = {}, {}
    for feature, name, spec in feature_renames():
        if feature not in features:
            continue
        word = "".join(w.title() for w in name.split("-"))
        module = f"Lujarch{''.join(w.title() for w in feature.split('-'))}{word}"
        base = f"features/{feature}/generated/{name}"
        source = ", ".join(spec["res"])
        for values, elements in renamed_values(host.tree, feature, name, spec).items():
            files[f"{base}/res/{values}/strings.xml"] = (
                OVERLAY_HEADER.format(source=source)
                + '<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">\n'
                + "".join(f"    {e}\n" for e in elements) + "</resources>\n").encode()
        files[f"{base}/AndroidManifest.xml"] = (
            OVERLAY_HEADER.format(source=source)
            + '<manifest xmlns:android="http://schemas.android.com/apk/res/android"\n'
            + f'    package="org.lujarch.{feature.replace("-", "")}.overlay.'
            + f'{name.replace("-", "")}">\n'
            + f'    <overlay\n        android:targetPackage="{spec["package"]}"\n'
            + '        android:isStatic="true" />\n</manifest>\n').encode()
        modules.setdefault(feature, []).append((module, name))
    for feature, entries in modules.items():
        files[f"features/{feature}/generated/Android.bp"] = (
            "// Generated by tools/lujarch from system/.\n" + "".join(
                f'\nruntime_resource_overlay {{\n    name: "{module}",\n'
                f'    manifest: "{name}/AndroidManifest.xml",\n'
                f'    resource_dirs: ["{name}/res"],\n    system_ext_specific: true,\n}}\n'
                for module, name in entries)).encode()
        files[f"features/{feature}/generated/renames.mk"] = (
            "# Generated by tools/lujarch from system/.\nPRODUCT_PACKAGES += \\\n"
            + " \\\n".join(f"    {module}" for module, _ in entries) + "\n").encode()
    return files


def version_rc():
    """The init file that sets ro.lujarch.version: <n>-<commit> for a release (a commit tagged
    lujarch-<n>), or the commit alone. It stays a module's file: as a make variable it would
    make every commit rerun the product configuration."""
    commit = git("rev-parse", "--short=12", "HEAD").stdout.strip()
    tags = git("tag", "--points-at", "HEAD", "--list", "lujarch-*").stdout.split()
    numbers = sorted(int(t.split("-", 1)[1]) for t in tags if t.split("-", 1)[1].isdigit())
    version = f"{numbers[-1]}-{commit}" if numbers else commit
    return ("# Generated by tools/lujarch from git.\n"
            f"on early-init\n    setprop ro.lujarch.version {version}\n").encode()


SETTING_TYPES = {"bool": bool, "int": int, "string": str}


def feature_settings():
    """Every switch of every feature's settings.toml, as (feature, key, entry)."""
    out = []
    base = SYSTEM / "features"
    for path in sorted(base.glob("*/settings.toml")) if base.is_dir() else []:
        for key, entry in load_toml(path).items():
            out.append((path.parent.name, key, entry))
    return out


def settings_mirror():
    """settings key, mirror property and default of every Global switch, one per line."""
    lines = []
    for feature, key, entry in feature_settings():
        if entry.get("table") != "global":
            continue
        name = feature.replace("-", "_")
        default = entry["default"]
        if isinstance(default, bool):
            default = int(default)
        lines.append(f"lujarch_{name}_{key}\tlujarch.setting.{name}.{key}\t{default}\n")
    return "".join(lines)


def settings_libraries(features):
    """The defaults of Lujarch Settings: every feature's page library, Lujarch<Feature>Settings."""
    libs = [f for f in features if f != "core" and (SYSTEM / "features" / f / "src" / "settings").is_dir()]
    names = "".join(f'        "Lujarch{"".join(w.title() for w in f.split("-"))}Settings",\n'
                    for f in libs)
    return ("// Generated by tools/lujarch from system/.\n"
            "java_defaults {\n"
            '    name: "lujarch_settings_features",\n'
            f"    static_libs: [\n{names}    ],\n"
            "}\n")


