# Stock releases

STOCK_UNPACKED = ".lujarch-unpacked"
STOCK_PARTITIONS = ("odm", "product", "system", "system_ext", "vendor")


def stock_package(host, pin):
    name = Path(pin["urls"][0].split("?", 1)[0]).name
    return host.path_of("paths", "stock") / pin["release"] / name


def stock_dump_dir(host, pin):
    """<stock>/<release>/<package name>/: the package's partitions, unpacked next to it."""
    package = stock_package(host, pin)
    return package.parent / package.name.removesuffix(".zip")


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(1 << 22):
            digest.update(chunk)
    return digest.hexdigest()


def stock_dump(host, device):
    """Download, check and unpack a device's stock release; return its unpacked partitions."""
    pin = lock_file().get("stock", {}).get(device)
    if not pin:
        die(f"lock.toml pins no stock release for {device}")
    dump = stock_dump_dir(host, pin)
    if (dump / STOCK_UNPACKED).is_file():
        return pin, dump
    package = stock_package(host, pin)
    package.parent.mkdir(parents=True, exist_ok=True)
    if not package.is_file() or package.with_name(package.name + ".aria2").exists():
        log(f"downloading {pin['release']} into {package.parent}")
        if shutil.which("aria2c"):
            run = subprocess.run(["aria2c", "-q", "--continue=true", "-x16", "-s16", "-k4M",
                                  "--max-tries=10", "--retry-wait=10", "--file-allocation=none",
                                  "-d", str(package.parent), "-o", package.name, *pin["urls"]])
        else:
            run = subprocess.run(["curl", "-fL", "--retry", "5", "-C", "-", "-o", str(package),
                                  pin["urls"][0]])
        if run.returncode:
            die(f"download of {pin['release']} failed")
    if sha256_file(package) != pin["sha256"]:
        die(f"{package} does not match lock.toml's sha256")
    log(f"unpacking {pin['release']} into {dump}")
    env = dict(os.environ)
    env["PATH"] = f"{env.get('PATH', '')}:{host.tree / 'out' / 'host' / 'linux-x86' / 'bin'}"
    run = subprocess.run([sys.executable, str(host.tree / "tools" / "extract-utils" / "extract.py"),
                          str(package)], cwd=host.tree, env=env)
    empty = [p for p in STOCK_PARTITIONS if not (dump / p).is_dir() or not any((dump / p).iterdir())]
    if run.returncode or empty:
        for p in empty:
            if (dump / p).is_dir():
                (dump / p).rmdir()
        die(f"unpacking {package} failed" + (f": no {', '.join(empty)}" if empty else ""))
    (dump / STOCK_UNPACKED).write_text(pin["sha256"] + "\n")
    return pin, dump


def pin_stock_files(device, names):
    """Write the sha256 of each named stock file into lock.toml's stock.<device>.files."""
    path = ROOT / "lock.toml"
    text = path.read_text(encoding="utf-8")
    header = f"[stock.{device}.files]"
    lines = text.rstrip("\n").split("\n")
    if header in lines:
        start = lines.index(header) + 1
        end = next((i for i in range(start, len(lines)) if lines[i].startswith("[")), len(lines))
    else:
        lines += ["", header]
        start = end = len(lines)
    entries = {}
    for line in lines[start:end]:
        if line.strip():
            key, _, value = line.partition("=")
            entries[key.strip().strip('"')] = value.strip().strip('"')
    entries.update(names)
    body = [f'"{k}" = "{v}"' for k, v in sorted(entries.items())]
    lines[start:end] = body + ([""] if end < len(lines) else [])
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def cmd_stock(args):
    host = Host()
    pin, dump = stock_dump(host, args.device)
    if args.add:
        found = {}
        for pattern in args.add:
            matches = sorted(p for p in dump.glob(pattern) if p.is_file())
            if not matches:
                die(f"nothing in {pin['release']} matches {pattern}")
            for p in matches:
                found[p.relative_to(dump).as_posix()] = sha256_file(p)
        pin_stock_files(args.device, found)
        log(f"pinned {len(found)} file{'s' if len(found) != 1 else ''} of {pin['release']}")
    print(f"{args.device}: {pin['release']} unpacked in {dump}; "
          f"{len(lock_file()['stock'][args.device].get('files', {}))} files pinned")
    return 0


def verify_tree(tree):
    """The tree must be exactly upstream.xml plus the patches."""
    pins = upstream_projects()
    series = series_by_project()

    def state(project):
        where = tree / project
        head = pgit(where, "rev-parse", "HEAD").stdout.strip()
        return project, head, changes(where)
    with ThreadPoolExecutor(16) as pool:
        states = list(pool.map(state, pins))
    problems = []
    for project, head, dirty in states:
        if dirty:
            problems.append(f"{project}: changes no patch holds")
        elif not series.get(project) and head != pins[project]:
            problems.append(f"{project}: not on its pinned commit")
    if problems:
        die("the tree is not upstream.xml plus the patches (lujarch save, or discard):\n  "
            + "\n  ".join(problems[:40]))


def cmd_patch(_args):
    prepare_tree(Host())
    return 0


def cmd_unpatch(_args):
    tree = Host().tree
