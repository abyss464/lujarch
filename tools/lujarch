#!/usr/bin/env python3
"""The Lujarch repository's command line.

  lujarch check                     check the repository against process/; exit 1 on any finding
  lujarch status [--list]           progress of the target, and code not yet meeting a convention
  lujarch pin                       write upstream.xml from the commits the tree has checked out
  lujarch sync                      sync the tree to upstream.xml, then apply the patches
  lujarch patch | unpatch           apply or revert the patches of system/order in the tree
  lujarch build DEVICE [MODULE...]  build a device (fuxi, vm), or some of its modules
  lujarch vm start|stop|status      the virtual device
"""

import argparse
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGET = ROOT / "target"
SYSTEM = ROOT / "system"
ITEMLESS = {"terms.md"}

ITEM_RE = re.compile(r"^### ([A-Z]{2,5})-(\d+) \S")
FIELDS = ("Home", "Switch", "Default", "Verify")
VERIFY_VALUES = {"vm", "phone"}
ID_RE = r"[A-Z]{2,5}-\d+"
VERIFIES_RE = re.compile(rf"verifies:\s*({ID_RE}(?:\s*,\s*{ID_RE})*)")

FORBIDDEN_IN_TARGET = [
    (re.compile(r"\b(?:19|20)\d{2}-\d{2}-\d{2}\b"), "date"),
    (re.compile(r"\bD-\d{3}\b"), "decision reference"),
    (re.compile(r"\b(?:TODO|TBD|FIXME)\b"), "unfinished marker"),
]
LEGACY = [re.compile(r"fuxi-?os", re.IGNORECASE), re.compile(r"\bFuxi[A-Z]")]
# The one-time migration names the previous system's packages, paths and properties.
LEGACY_ALLOWED = ("owner/process/migration.md", "owner/migrate/")
CJK_RANGES = ((0x3000, 0x303F), (0x3040, 0x30FF), (0x3400, 0x4DBF), (0x4E00, 0x9FFF),
              (0xF900, 0xFAFF), (0xFF00, 0xFFEF))
CJK_RE = re.compile("[" + "".join(f"{chr(a)}-{chr(b)}" for a, b in CJK_RANGES) + "]")
CJK_ALLOWED_FILES = {"README.md", "owner/README.md", "target/terms.md"}
RECORD_RE = re.compile(
    r"^(?:plans?|pending|state|status|decisions?|changelog|changes|history|todo|roadmap|"
    r"known[-_]issues|notes|journal|releases)$",
    re.IGNORECASE,
)

ADB_PORT = 6520
WEBRTC_URL = "https://localhost:8443"
VM_CONTAINER = "lujarch-vm"
VM_PORTS = ("6520", "8443", "15550-15599/tcp", "15550-15599/udp")


def log(message):
    print(f"[lujarch] {message}", file=sys.stderr, flush=True)


def die(message):
    print(f"[lujarch] {message}", file=sys.stderr, flush=True)
    sys.exit(1)


def git(*args, cwd=ROOT):
    return subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)


# ---------------------------------------------------------------------------
# Repository files


def repo_files():
    """Every file of the worktree that git would track."""
    out = git("ls-files", "-z", "--cached", "--others", "--exclude-standard")
    if out.returncode == 0:
        return sorted(ROOT / p for p in out.stdout.split("\0") if p and (ROOT / p).is_file())
    files = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d != ".git"]
        files += [Path(dirpath) / f for f in filenames]
    return sorted(files)


def read_text(path):
    try:
        data = path.read_bytes()
    except OSError:
        return None
    if b"\0" in data:
        return None
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return None


def rel(path):
    return path.relative_to(ROOT).as_posix()


def load_toml(path):
    with open(path, "rb") as f:
        return tomllib.load(f)


def lock_file():
    return load_toml(ROOT / "lock.toml")


def device_config(name):
    path = SYSTEM / "device" / name / "device.toml"
    if not path.is_file():
        known = sorted(p.parent.name for p in (SYSTEM / "device").glob("*/device.toml"))
        die(f"no device {name}; devices: {', '.join(known)}")
    return load_toml(path)


# ---------------------------------------------------------------------------
# Host configuration


class Host:
    def __init__(self):
        path = os.environ.get("LUJARCH_HOST")
        if not path:
            base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
            path = os.path.join(base, "lujarch", "host.toml")
        self.path = Path(path)
        try:
            self.data = load_toml(self.path)
        except FileNotFoundError:
            die(f"no host configuration at {self.path} (process/layout.md, Host configuration)")
        except tomllib.TOMLDecodeError as e:
            die(f"{self.path}: {e}")
        self.base = self.path.resolve().parent

    def get(self, section, key, default=None):
        return self.data.get(section, {}).get(key, default)

    def path_of(self, section, key):
        value = self.get(section, key)
        if not value:
            die(f"{self.path}: {section}.{key} is not set")
        p = Path(os.path.expanduser(value))
        return p if p.is_absolute() else self.base / p

    @property
    def tree(self):
        tree = self.path_of("paths", "tree")
        if not (tree / ".repo").is_dir():
            die(f"{tree} is not a repo checkout")
        return tree

    @property
    def out(self):
        out = self.path_of("paths", "out")
        out.mkdir(parents=True, exist_ok=True)
        return out


def host_or_none():
    try:
        return Host()
    except SystemExit:
        return None


# ---------------------------------------------------------------------------
# check


class Findings:
    def __init__(self):
        self.items = []

    def add(self, path, line, message):
        self.items.append((rel(path) if isinstance(path, Path) else path, line, message))

    def report(self):
        for path, line, message in sorted(self.items):
            print(f"{path}:{line}: {message}" if line else f"{path}: {message}")
        return len(self.items)


def target_files():
    if not TARGET.is_dir():
        return []
    return sorted(p for p in TARGET.glob("*.md") if p.name not in ITEMLESS)


def parse_target(path, findings=None):
    """Items of one target file as (id, verify, line). Format problems go to findings."""
    def bad(line, message):
        if findings is not None:
            findings.add(path, line, message)

    lines = path.read_text(encoding="utf-8").split("\n")
    items = []
    codes = set()
    in_fence = False
    seen_title = False
    i = 0
    while i < len(lines):
        line = lines[i]
        n = i + 1
        if line.startswith("```"):
            in_fence = not in_fence
            i += 1
            continue
        if in_fence:
            i += 1
            continue
        for pattern, what in FORBIDDEN_IN_TARGET:
            if pattern.search(line):
                bad(n, f"{what} in the target")
        if line.startswith("#"):
            if line.startswith("# "):
                if seen_title or items:
                    bad(n, "a second title")
                seen_title = True
            elif line.startswith("## "):
                pass
            elif line.startswith("### "):
                m = ITEM_RE.match(line)
                if not m:
                    bad(n, "item heading is not '### <CODE>-<n> <title>'")
                else:
                    code, number = m.group(1), int(m.group(2))
                    codes.add(code)
                    expected = len(items) + 1
                    if number != expected:
                        bad(n, f"item number {number}, expected {expected}")
                    verify = None
                    j = i + 1
                    while j < len(lines) and not lines[j].strip():
                        j += 1
                    for field in FIELDS:
                        prefix = f"- {field}: "
                        if j < len(lines) and lines[j].startswith(prefix):
                            if field == "Verify":
                                verify = lines[j][len(prefix):].strip()
                                if verify not in VERIFY_VALUES:
                                    bad(j + 1, f"Verify is '{verify}', not vm or phone")
                            j += 1
                        else:
                            bad(j + 1, f"missing or misplaced field '{field}'")
                            break
                    items.append((f"{code}-{number}", verify, n))
            else:
                bad(n, "heading outside the target format")
        elif not seen_title and line.strip():
            bad(n, "the file does not start with '# <title>'")
            seen_title = True
        i += 1
    if len(codes) > 1:
        bad(0, "more than one item prefix: " + ", ".join(sorted(codes)))
    return items, codes


def check_target(findings):
    owners = {}
    ids = set()
    for path in target_files():
        items, codes = parse_target(path, findings)
        for code in codes:
            if code in owners:
                findings.add(path, 0, f"prefix {code} is also used by {owners[code]}")
            owners.setdefault(code, rel(path))
        ids.update(item_id for item_id, _, _ in items)
    features = SYSTEM / "features"
    if features.is_dir():
        for feature in sorted(p for p in features.iterdir() if p.is_dir()):
            if not (TARGET / f"{feature.name}.md").exists():
                findings.add(feature, 0, f"no target/{feature.name}.md")
            meta = feature / "feature.toml"
            if meta.exists():
                prefix = load_toml(meta).get("prefix")
                if prefix and owners.get(prefix) not in (None, f"target/{feature.name}.md"):
                    findings.add(meta, 0, f"prefix {prefix} belongs to {owners[prefix]}")
    return ids


def check_files(findings):
    for path in repo_files():
        name = rel(path)
        if path.suffix.lower() in (".md", ".txt") and RECORD_RE.match(path.stem):
            findings.add(path, 0, "a record file; the repository holds only the target")
        text = read_text(path)
        if text is None:
            continue
        legacy_allowed = name.startswith(LEGACY_ALLOWED)
        cjk_allowed = (
            name in CJK_ALLOWED_FILES
            or "/res/values-zh-rCN/" in f"/{name}"
            or "/res/values-ja/" in f"/{name}"
        )
        for n, line in enumerate(text.split("\n"), 1):
            if not legacy_allowed:
                for pattern in LEGACY:
                    if pattern.search(line):
                        findings.add(path, n, "legacy name; the system is Lujarch")
                        break
            if not cjk_allowed and CJK_RE.search(line):
                findings.add(path, n, "Chinese or Japanese text outside the READMEs and terms.md")


def check_references(findings, ids):
    for path in repo_files():
        parts = rel(path).split("/")
        if not ("tests" in parts or parts[0] == "test" or path.name == "settings.toml"):
            continue
        text = read_text(path)
        if text is None:
            continue
        for n, line in enumerate(text.split("\n"), 1):
            for m in VERIFIES_RE.finditer(line):
                for item_id in re.findall(ID_RE, m.group(1)):
                    if item_id not in ids:
                        findings.add(path, n, f"{item_id} is not a target item")
        if path.name == "settings.toml":
            try:
                entries = tomllib.loads(text)
            except tomllib.TOMLDecodeError as e:
                findings.add(path, 0, f"not valid TOML: {e}")
                continue
            for key, entry in entries.items():
                item_id = entry.get("item") if isinstance(entry, dict) else None
                if item_id not in ids:
                    findings.add(path, 0, f"switch {key}: item {item_id} is not a target item")


def check_lock(findings):
    path = ROOT / "lock.toml"
    if not path.exists():
        findings.add("lock.toml", 0, "missing")
        return
    try:
        lock = load_toml(path)
    except tomllib.TOMLDecodeError as e:
        findings.add(path, 0, f"not valid TOML: {e}")
        return
    for section, key in (("upstream", "manifest"), ("upstream", "branch"),
                         ("upstream", "aosp"), ("build", "variant")):
        if key not in lock.get(section, {}):
            findings.add(path, 0, f"missing {section}.{key}")
    manifest = ROOT / "upstream.xml"
    if not manifest.exists():
        findings.add("upstream.xml", 0, "missing")
    else:
        text = manifest.read_text(encoding="utf-8")
        for n, line in enumerate(text.split("\n"), 1):
            if "<project " in line and not re.search(r'revision="[0-9a-f]{40}"', line):
                findings.add(manifest, n, "a project not pinned to a commit")


def check_devices(findings):
    for path in sorted((SYSTEM / "device").glob("*/device.toml")):
        try:
            data = load_toml(path)
        except tomllib.TOMLDecodeError as e:
            findings.add(path, 0, f"not valid TOML: {e}")
            continue
        for key in ("codename", "product"):
            if key not in data:
                findings.add(path, 0, f"missing {key}")
        if data.get("codename") != path.parent.name:
            findings.add(path, 0, f"codename is not the directory's name, {path.parent.name}")
        of = data.get("display_of")
        if of and not (SYSTEM / "device" / of / "device.toml").is_file():
            findings.add(path, 0, f"display_of names no device: {of}")


def check_order(findings):
    with_patches = set()
    for kind in ("features", "device"):
        base = SYSTEM / kind
        if base.is_dir():
            with_patches |= {f"{kind}/{p.name}" for p in base.iterdir() if (p / "patches").is_dir()}
    path = SYSTEM / "order"
    listed = []
    if path.exists():
        for n, line in enumerate(path.read_text(encoding="utf-8").split("\n"), 1):
            entry = line.strip()
            if not entry:
                continue
            if entry in listed:
                findings.add(path, n, f"{entry} listed twice")
            elif entry not in with_patches:
                findings.add(path, n, f"{entry} has no patches/ directory")
            listed.append(entry)
    else:
        findings.add("system/order", 0, "missing")
    for entry in sorted(with_patches - set(listed)):
        findings.add("system/order", 0, f"{entry} has patches but is not listed")


def check_approvals(findings):
    if git("rev-parse", "--verify", "-q", "refs/heads/main").returncode:
        return
    out = git("log", "main", "--first-parent", "--format=%H%x1f%B%x1e", "--", "target/*.md")
    for record in out.stdout.split("\x1e"):
        if not record.strip():
            continue
        commit, _, body = record.strip().partition("\x1f")
        if not re.search(r"^Approved-by: \S", body, re.MULTILINE):
            findings.add("target/", 0, f"commit {commit[:12]} on main changes the target without Approved-by")


def cmd_check(_args):
    findings = Findings()
    ids = check_target(findings)
    check_files(findings)
    check_references(findings, ids)
    check_lock(findings)
    check_devices(findings)
    check_order(findings)
    check_approvals(findings)
    count = findings.report()
    print(f"lujarch check: {count} finding{'s' if count != 1 else ''}", file=sys.stderr)
    return 1 if count else 0


# ---------------------------------------------------------------------------
# status


def test_results():
    host = host_or_none()
    head = git("rev-parse", "HEAD")
    if host is None or head.returncode or not host.get("paths", "out"):
        return set()
    path = host.path_of("paths", "out") / "test" / head.stdout.strip() / "results.json"
    try:
        items = json.loads(path.read_text(encoding="utf-8")).get("items", {})
    except (OSError, ValueError):
        return set()
    return {item_id for item_id, result in items.items() if result == "pass"}


def unmet_conventions():
    """Services started from a script and daemons listening on a socket (process/conventions.md)."""
    found = []
    for path in repo_files():
        name = rel(path)
        if not name.startswith("system/") or path.suffix != ".rc":
            continue
        text = read_text(path) or ""
        scripts = {p.name for p in path.parent.parent.rglob("*")
                   if p.is_file() and (read_text(p) or "").startswith("#!")}
        for n, line in enumerate(text.split("\n"), 1):
            words = line.split()
            if len(words) >= 3 and words[0] == "service" and os.path.basename(words[2]) in scripts:
                found.append(f"{name}:{n}: service {words[1]} runs a script")
            if words[:1] == ["socket"]:
                found.append(f"{name}:{n}: socket {words[1] if len(words) > 1 else ''}")
    return found


def cmd_status(args):
    covered = set()
    for path in repo_files():
        parts = rel(path).split("/")
        if "tests" in parts or parts[0] == "test":
            text = read_text(path)
            if text:
                for m in VERIFIES_RE.finditer(text):
                    covered.update(re.findall(ID_RE, m.group(1)))
    verified = test_results()
    rows = []
    totals = [0, 0, 0, 0, 0]
    for path in target_files():
        items, _ = parse_target(path)
        vm = sum(1 for _, v, _ in items if v == "vm")
        phone = sum(1 for _, v, _ in items if v == "phone")
        cov = [i for i, _, _ in items if i in covered]
        ver = [i for i, _, _ in items if i in verified]
        row = [len(items), vm, phone, len(cov), len(ver)]
        totals = [a + b for a, b in zip(totals, row)]
        rows.append((path.stem, row, [i for i, _, _ in items if i not in covered]))
    widths = (7, 6, 7, 8, 10)
    print(f"{'file':<16}{'items':>7}{'vm':>6}{'phone':>7}{'tested':>8}{'verified':>10}")
    for name, row, _ in rows:
        print(f"{name:<16}" + "".join(f"{v:>{w}}" for v, w in zip(row, widths)))
    print(f"{'total':<16}" + "".join(f"{v:>{w}}" for v, w in zip(totals, widths)))
    if args.list:
        for name, _, missing in rows:
            if missing:
                print(f"\n{name}: no test for " + ", ".join(missing))
    unmet = unmet_conventions()
    if unmet:
        print("\nnot yet meeting process/conventions.md (Services and IPC):")
        for line in unmet:
            print(f"  {line}")
    return 0


# ---------------------------------------------------------------------------
# Tree: pins, sync, patches


def cmd_pin(_args):
    host = Host()
    out = subprocess.run(["repo", "manifest", "-r", "-o", str(ROOT / "upstream.xml")],
                         cwd=host.tree, capture_output=True, text=True)
    if out.returncode:
        die(f"repo manifest failed:\n{out.stderr.strip()}")
    count = (ROOT / "upstream.xml").read_text(encoding="utf-8").count("<project ")
    log(f"upstream.xml: {count} projects at the tree's commits")
    return 0


def patch_dirs():
    """The patch directories of system/order, in order, as (entry, patches/ path)."""
    path = SYSTEM / "order"
    entries = [l.strip() for l in path.read_text(encoding="utf-8").split("\n") if l.strip()] \
        if path.exists() else []
    result = []
    for entry in entries:
        pdir = SYSTEM / entry / "patches"
        if not pdir.is_dir():
            die(f"system/order: {entry} has no patches/ directory")
        result.append((entry, pdir))
    return result


def patch_series():
    """Every patch in application order, as (patch file, project path)."""
    series = []
    for _, pdir in patch_dirs():
        for p in sorted(pdir.rglob("*.patch")):
            series.append((p, p.parent.relative_to(pdir).as_posix()))
    return series


def git_apply(project, patch, *flags):
    return subprocess.run(["git", "-C", str(project), "apply", *flags, str(patch)],
                          capture_output=True, text=True)


def apply_patches(tree):
    count = 0
    for patch, project in patch_series():
        where = tree / project
        if not where.is_dir():
            die(f"{rel(patch)}: no project {project} in the tree")
        if git_apply(where, patch, "--reverse", "--check").returncode == 0:
            continue
        check = git_apply(where, patch, "--check")
        if check.returncode:
            die(f"{rel(patch)} does not apply to {project}:\n{check.stderr.strip()}")
        git_apply(where, patch)
        count += 1
        log(f"applied {rel(patch)}")
    log(f"patches: {count} applied, {len(patch_series()) - count} already in the tree")


def revert_patches(tree):
    for patch, project in reversed(patch_series()):
        where = tree / project
        if where.is_dir() and git_apply(where, patch, "--reverse", "--check").returncode == 0:
            git_apply(where, patch, "--reverse")
            log(f"reverted {rel(patch)}")


def cmd_patch(_args):
    apply_patches(Host().tree)
    return 0


def cmd_unpatch(_args):
    revert_patches(Host().tree)
    return 0


def cmd_sync(_args):
    host = Host()
    tree = host.tree
    local = tree / ".repo" / "local_manifests"
    extra = sorted(local.glob("*.xml")) if local.is_dir() else []
    if extra:
        die("upstream.xml holds every project; the tree has local manifests besides it: "
            + ", ".join(str(p) for p in extra))
    revert_patches(tree)
    env = dict(os.environ)
    gitconfig = host.get("sync", "gitconfig")
    if gitconfig:
        env["GIT_CONFIG_GLOBAL"] = str(host.path_of("sync", "gitconfig"))
    jobs = str(host.get("sync", "jobs", 8))
    log(f"repo sync to upstream.xml in {tree}")
    run = subprocess.run(["repo", "sync", "-m", str(ROOT / "upstream.xml"), "-j", jobs,
                          "--no-tags", "--no-clone-bundle", "--optimized-fetch",
                          "--retry-fetches=5"], cwd=tree, env=env)
    if run.returncode:
        die("repo sync failed")
    pull_lfs(tree, env)
    apply_patches(tree)
    return 0


def pull_lfs(tree, env):
    """repo does not always fetch git LFS content; the build rejects pointer files."""
    manifest = (ROOT / "upstream.xml").read_text(encoding="utf-8")
    for path in re.findall(r'<project [^>]*\bpath="([^"]+)"', manifest):
        attributes = tree / path / ".gitattributes"
        if not attributes.is_file() or "filter=lfs" not in attributes.read_text(errors="replace"):
            continue
        files = subprocess.run(["git", "-C", str(tree / path), "lfs", "ls-files"],
                               capture_output=True, text=True, env=env)
        if any(line.split()[1:2] == ["-"] for line in files.stdout.split("\n")):
            log(f"git lfs pull: {path}")
            if subprocess.run(["git", "-C", str(tree / path), "lfs", "pull"], env=env).returncode:
                die(f"git lfs pull failed in {path}")


# ---------------------------------------------------------------------------
# Build


def mem_available_gb():
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) // 1048576
    return 0


def build_budget(host):
    """The build's memory cap, pressure point and jobs: from host.toml, or from free memory."""
    gb = mem_available_gb()
    mem_max = host.get("build", "memory_max") or ""
    if not mem_max:
        # Android 17's soong_build analysis peaks above 52 GB with Go's default heap growth
        # (GOGC below keeps it lower); squeezed under its peak it stalls for hours.
        cap = min(gb - 12, 60)
        if cap < 44:
            die(f"only {gb} GB of memory free: a build needs at least 56 "
                "(or set build.memory_max in host.toml)")
        mem_max = f"{cap}G"
    mem_high = host.get("build", "memory_high") or f"{int(mem_max.rstrip('G')) - 1}G"
    jobs = int(host.get("build", "jobs", 0) or 0) or min(int(mem_max.rstrip("G")) // 3, 26)
    return mem_max, mem_high, jobs


def release_config(tree):
    path = tree / "vendor" / "lineage" / "vars" / "aosp_target_release"
    for line in path.read_text().split("\n"):
        if line.startswith("aosp_target_release="):
            return line.split("=", 1)[1].strip()
    die(f"no aosp_target_release in {path}")


def device_info_path(host, device):
    return host.out / "devices" / f"{device}.json"


def cmd_build(args):
    host = Host()
    tree = host.tree
    device = device_config(args.device)
    variant = lock_file()["build"]["variant"]
    lunch = f"{device['product']}-{release_config(tree)}-{variant}"
    if not args.modules and device.get("platform") == "cuttlefish":
        args.modules = ["droid", "out/host/linux-x86/cvd-host_package.tar.gz"]
    modules = " ".join(shlex.quote(m) for m in args.modules)

    lock_path = host.path_of("build", "lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock = open(lock_path, "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log(f"another build holds {lock_path}; waiting")
        fcntl.flock(lock, fcntl.LOCK_EX)

    apply_patches(tree)
    mem_max, mem_high, jobs = build_budget(host)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    logs = host.out / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    logfile = logs / f"build-{args.device}-{stamp}.log"
    info = device_info_path(host, args.device)
    info.parent.mkdir(parents=True, exist_ok=True)
    product_out_file = info.with_suffix(".product_out")

    script = f"""
set +eu
cd {shlex.quote(str(tree))}
source build/envsetup.sh >/dev/null || exit 1
lunch {shlex.quote(lunch)} >/dev/null || exit 1
get_build_var PRODUCT_OUT > {shlex.quote(str(product_out_file))} || exit 1
m -j{jobs} {modules}
"""
    env = dict(os.environ)
    env.update({
        "LC_ALL": "C",
        "USE_CCACHE": "1",
        "CCACHE_EXEC": "/usr/bin/ccache",
        "CCACHE_DIR": str(host.path_of("paths", "ccache")),
        "NINJA_HIGHMEM_NUM_JOBS": str(host.get("build", "highmem_jobs", 3)),
        "GOGC": "50",
    })
    command = ["bash", "-c", script]
    cpus = host.get("build", "cpus")
    if cpus:
        command = ["taskset", "-c", cpus, *command]
    command = ["systemd-run", "--user", "--scope", "--quiet", "--collect",
               "-p", f"MemoryHigh={mem_high}", "-p", f"MemoryMax={mem_max}",
               "-p", "MemorySwapMax=0", "-p", "CPUWeight=20", "-p", "IOWeight=20", *command]
    try:
        with open("/proc/self/oom_score_adj", "w") as f:
            f.write("1000")
    except OSError:
        log("could not raise the build's oom_score_adj")
    log(f"building {args.device} ({lunch}{', ' + modules if modules else ''}): "
        f"{jobs} jobs, memory cap {mem_max}; log {logfile}")
    start = time.monotonic()
    with open(logfile, "w") as f:
        run = subprocess.run(command, cwd=tree, env=env, stdout=f, stderr=subprocess.STDOUT)
    minutes = int((time.monotonic() - start) // 60)
    if run.returncode:
        tail = logfile.read_text(errors="replace").split("\n")[-40:]
        print("\n".join(tail), file=sys.stderr)
        die(f"build failed after {minutes} min (exit {run.returncode}); log {logfile}")
    product_out = product_out_file.read_text().strip()
    product_out_file.unlink()
    commit = git("describe", "--always", "--dirty", "--exclude=*").stdout.strip()
    info.write_text(json.dumps({
        "device": args.device, "lunch": lunch, "product_out": str(tree / product_out),
        "modules": args.modules, "commit": commit, "built": stamp,
    }, indent=2) + "\n")
    log(f"built {args.device} in {minutes} min")
    return 0


