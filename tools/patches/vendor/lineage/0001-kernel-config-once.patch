diff --git a/build/tasks/kernel.mk b/build/tasks/kernel.mk
index 15ce95b74109c88f58055b1a6a6ce754577f5b05..2a370ce5ae23a33bf822933dee88ddcf2cae06f6 100644
--- a/build/tasks/kernel.mk
+++ b/build/tasks/kernel.mk
@@ -517,7 +517,9 @@ ifeq ($(FULL_KERNEL_BUILD),true)
 $(KERNEL_OUT):
 	mkdir -p $(KERNEL_OUT)
 
-$(KERNEL_CONFIG): $(KERNEL_OUT) $(ALL_KERNEL_DEFCONFIG_SRCS)
+# The output directory only has to exist: its time changes with every kernel build, and as a
+# normal prerequisite it would regenerate .config and so relink the kernel each time.
+$(KERNEL_CONFIG): $(ALL_KERNEL_DEFCONFIG_SRCS) | $(KERNEL_OUT)
 	@echo "Building Kernel Config"
 	$(call make-kernel-config,$(KERNEL_OUT),$(ALL_KERNEL_DEFCONFIG_SRCS))
 
