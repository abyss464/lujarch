<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lujarch.storage.settings">

    <uses-permission android:name="android.permission.LUJARCH_STORAGE" />

    <application>
        <!-- Settings > Apps > (app) > Storage & cache > Storage limit, opened from Storage & cache
             in Settings. -->
        <activity
            android:name="org.lujarch.storage.settings.StorageLimitActivity"
            android:exported="true"
            android:label="@string/storage_limit_title"
            android:theme="@style/Theme.LujarchSettings">
            <intent-filter>
                <action android:name="org.lujarch.storage.action.STORAGE_LIMIT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
