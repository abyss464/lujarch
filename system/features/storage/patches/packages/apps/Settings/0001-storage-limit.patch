@@ -152,6 +162,61 @@ public class AppStorageSettings extends AppInfoWithHeader
     public void onResume() {
         super.onResume();
         updateSize();
+        updateStorageLimit();
+    }
+
+    /**
+     * Lujarch's Storage (STO-1): Storage limit with what the app holds against it, or Off; the
+     * row opens the app's Storage limit page. Apps of the system have none.
+     */
+    private void updateStorageLimit() {
+        final Preference pref = findPreference(KEY_LUJARCH_STORAGE_LIMIT);
+        if (pref == null) {
+            return;
+        }
+        final String packageName = mPackageName;
+        final int userId = mUserId;
+        if (packageName == null || mAppEntry == null
+                || UserHandle.getAppId(mAppEntry.info.uid) < Process.FIRST_APPLICATION_UID) {
+            pref.setVisible(false);
+            return;
+        }
+        pref.setOnPreferenceClickListener(p -> {
+            final Intent intent = new Intent(LujarchStorage.ACTION_STORAGE_LIMIT)
+                    .setPackage(LujarchBackground.SETTINGS_PACKAGE)
+                    .putExtra(Intent.EXTRA_PACKAGE_NAME, packageName);
+            try {
+                startActivity(intent);
+            } catch (ActivityNotFoundException e) {
+                Log.e("lujarch_storage", "no Storage limit page for " + packageName, e);
+            }
+            return true;
+        });
+        final Context context = getContext().getApplicationContext();
+        ThreadUtils.postOnBackgroundThread(() -> {
+            String summary;
+            try {
+                final ILujarchStorage storage = LujarchStorage.get();
+                final LujarchStorageLimit l = storage != null
+                        ? storage.getLimit(packageName, userId) : null;
+                if (l == null) {
+                    summary = "";
+                } else if (!l.on) {
+                    summary = context.getString(R.string.lujarch_storage_limit_off);
+                } else {
+                    final long held = Math.max(0, l.dataBytes) + Math.max(0, l.cacheBytes);
+                    summary = context.getString(l.state == LujarchStorage.STATE_FULL
+                            ? R.string.lujarch_storage_limit_full : R.string.lujarch_storage_limit_of,
+                            Formatter.formatFileSize(context, held),
+                            Formatter.formatFileSize(context, l.storageBytes));
+                }
+            } catch (RemoteException | RuntimeException e) {
+                Log.e("lujarch_storage", "the storage limit of " + packageName + " is not known", e);
+                summary = "";
+            }
+            final String shown = summary;
+            ThreadUtils.postOnMainThread(() -> pref.setSummary(shown));
+        });
     }
 
     @Override
