+binder::Status InstalldNativeService::getLujarchAppSpace(const std::optional<std::string>& uuid,
+        int32_t uid, std::vector<int64_t>* _aidl_return) {
+    ENFORCE_UID(AID_SYSTEM);
+    CHECK_ARGUMENT_UUID(uuid);
+    if (multiuser_get_app_id(uid) < AID_APP_START || multiuser_get_app_id(uid) > AID_APP_END) {
+        return error("Not an app uid: " + std::to_string(uid));
+    }
+    const std::string volume = uuid.value_or("");
+    const gid_t cacheGid = multiuser_get_cache_gid(multiuser_get_user_id(uid),
+            multiuser_get_app_id(uid));
+    *_aidl_return = {GetOccupiedSpaceForUid(volume, uid),
+            GetOccupiedSpaceForGid(volume, cacheGid)};
+    return ok();
+}
+
+binder::Status InstalldNativeService::setLujarchAppSpaceLimit(
+        const std::optional<std::string>& uuid, int32_t uid, int64_t bytes) {
+    ENFORCE_UID(AID_SYSTEM);
+    CHECK_ARGUMENT_UUID(uuid);
+    if (multiuser_get_app_id(uid) < AID_APP_START || multiuser_get_app_id(uid) > AID_APP_END) {
+        return error("Not an app uid: " + std::to_string(uid));
+    }
+    if (bytes < 0) {
+        return error("A negative limit for uid " + std::to_string(uid));
+    }
+    if (!SetSpaceLimitForUid(uuid.value_or(""), uid, bytes)) {
+        return error("Failed to set the space limit of uid " + std::to_string(uid));
+    }
+    return ok();
+}
