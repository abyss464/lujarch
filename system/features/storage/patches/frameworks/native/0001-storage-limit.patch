+bool SetSpaceLimitForUid(const std::string& uuid, uid_t uid, int64_t bytes) {
+    const std::string device = FindQuotaDeviceForUuid(uuid);
+    if (device.empty()) {
+        LOG(ERROR) << "No quota on the volume of " << uuid << " to limit UID " << uid;
+        return false;
+    }
+    struct dqblk dq = {};
+    // Only the block limits change; the inode limits stay as they are.
+    dq.dqb_valid = QIF_BLIMITS;
+    dq.dqb_bhardlimit = (bytes + QIF_DQBLKSIZE - 1) / QIF_DQBLKSIZE;
+    dq.dqb_bsoftlimit = 0;
+    if (quotactl(QCMD(Q_SETQUOTA, USRQUOTA), device.c_str(), uid,
+            reinterpret_cast<char*>(&dq)) != 0) {
+        PLOG(ERROR) << "Failed to set the space limit of UID " << uid << " on " << device;
+        return false;
+    }
+    LOG(INFO) << "Space limit of UID " << uid << ": " << (bytes == 0 ? "none" :
+            std::to_string(bytes) + " bytes");
+    return true;
+}
