+
+package com.android.internal.app;
+
+/**
+ * An app's storage limit, as the owner set it, and the app's use against it (STO-1).
+ * @hide
+ */
+parcelable LujarchStorageLimit {
+    /** Use storage limit. */
+    boolean on;
+    /** The most its User data and Cache together hold. */
+    long storageBytes;
+    /** When it is full: LujarchStorage.FULL_CLEAR_CACHE or FULL_STOP. */
+    int action;
+
+    // The rest is filled by getLimit only.
+    /** What it holds now: its User data, without Cache, and its Cache; -1 each when not known. */
+    long dataBytes;
+    long cacheBytes;
+    /** LujarchStorage.STATE_*. */
+    int state;
+    /** Since when it is full, as System.currentTimeMillis(); 0 when it is not, or not known. */
+    long sinceMillis;
+    /** When its cache was last cleared for its limit; 0 when never. */
+    long lastClearMillis;
+    /** The phone's storage, the largest limit. */
+    long maxBytes;
+}
