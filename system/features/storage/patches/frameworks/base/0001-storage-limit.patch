+package com.android.internal.app;
+
+import com.android.internal.app.LujarchStorageLimit;
+
+/**
+ * How much of the phone's storage each app may keep for itself (Lujarch's Storage). Callers hold
+ * android.permission.LUJARCH_STORAGE.
+ * @hide
+ */
+interface ILujarchStorage {
+    /** The app's storage limit and its use against it (STO-1); null when it is not installed. */
+    @nullable LujarchStorageLimit getLimit(String packageName, int userId);
+
+    /** Sets the app's storage limit; only the fields the owner sets are read. */
+    void setLimit(String packageName, int userId, in LujarchStorageLimit limit);
+}
