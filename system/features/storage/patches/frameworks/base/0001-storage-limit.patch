+
+package com.android.server.storage;
+
+import android.annotation.Nullable;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.IPackageDataObserver;
+import android.content.pm.PackageManager;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.Process;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.os.storage.StorageManager;
+import android.util.ArrayMap;
+import android.util.ArraySet;
+import android.util.AtomicFile;
+import android.util.Slog;
+import android.util.SparseArray;
+
+import com.android.internal.app.ILujarchStorage;
+import com.android.internal.app.LujarchStorage;
+import com.android.internal.app.LujarchStorageLimit;
+import com.android.server.SystemService;
+import com.android.server.pm.Installer;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.FileReader;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Lujarch's Storage (STO-1): the storage limits the owner sets for apps, kept in a file and set
+ * as each app uid's quota on the data volume, which the kernel holds. An app whose limit clears
+ * its cache first may hold its limit and its cache, the room clearing frees: it never runs out
+ * before clearing would have let it, and its cache is cleared once it nears its limit.
+ */
+public final class LujarchStorageService extends ILujarchStorage.Stub {
+    static final String TAG = "lujarch_storage";
+    private static final File DIR = new File("/data/lujarch/storage");
+    /** How often an app with a limit is watched; more often near its limit. */
+    private static final long WATCH_MS = 1_000;
+    private static final long WATCH_NEAR_MS = 250;
+    /** Within this of its limit, an app is full. */
+    private static final long FULL_NEAR_BYTES = 4L << 20;
+    /** A cache this small is not worth clearing. */
+    private static final long CACHE_MIN_BYTES = 1L << 20;
+    /** A cache is cleared again no sooner than this after the last clear. */
+    private static final long CLEAR_AGAIN_MS = 1_000;
+    /** The quota follows the cache once it is this far from it. */
+    private static final long QUOTA_STEP_BYTES = 1L << 20;
+
+    public static final class Lifecycle extends SystemService {
+        private LujarchStorageService mService;
+
+        public Lifecycle(Context context) {
+            super(context);
+        }
+
+        @Override
+        public void onStart() {
+            mService = new LujarchStorageService(getContext());
+            publishBinderService(LujarchStorage.SERVICE, mService);
+        }
+
+        @Override
+        public void onBootPhase(int phase) {
+            if (phase == SystemService.PHASE_SYSTEM_SERVICES_READY) {
+                mService.systemReady();
+            }
+        }
+    }
+
+    /** What the owner set for one app. */
+    private static final class Limit {
+        boolean on;
+        long storageBytes = LujarchStorage.DEFAULT_BYTES;
+        int action = LujarchStorage.FULL_CLEAR_CACHE;
+        /** When its cache was last cleared for its limit; 0 when never. */
+        long lastClearMillis;
+    }
+
+    /** What one uid holds against its limit, as last watched. */
+    private static final class Watch {
+        long used = -1;
+        long cache = -1;
+        boolean full;
+        long sinceMillis;
+        /** A cache clear asked for and not yet done. */
+        boolean clearing;
+        /** The quota last set; -1 before. */
+        long quotaBytes = -1;
+        long lastClearElapsed = -CLEAR_AGAIN_MS;
+    }
+
+    private final Context mContext;
+    private final Installer mInstaller;
+    private final File mFile = new File(DIR, "limits");
+    private final Handler mHandler;
+    private final Object mLock = new Object();
+    /** "uid:package" to its limit. */
+    private final ArrayMap<String, Limit> mLimits = new ArrayMap<>();
+    /** The uids with a limit that is on, to what they hold. */
+    private final SparseArray<Watch> mWatches = new SparseArray<>();
+    private final Runnable mWatch = this::watch;
+
+    private LujarchStorageService(Context context) {
+        mContext = context;
+        mInstaller = new Installer(context);
+        mInstaller.onStart();
+        final HandlerThread thread = new HandlerThread(TAG, Process.THREAD_PRIORITY_BACKGROUND);
+        thread.start();
+        // A failure of Storage's own work is logged and ends that piece of work only.
+        mHandler = new Handler(thread.getLooper()) {
+            @Override
+            public void dispatchMessage(android.os.Message msg) {
+                try {
+                    super.dispatchMessage(msg);
+                } catch (RuntimeException e) {
+                    Slog.e(TAG, "Storage's work failed", e);
+                }
+            }
+        };
+    }
+
+    private void systemReady() {
+        final IntentFilter removed = new IntentFilter(Intent.ACTION_PACKAGE_FULLY_REMOVED);
+        removed.addDataScheme("package");
+        mContext.registerReceiverForAllUsers(new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                final String pkg = intent.getData() != null
+                        ? intent.getData().getSchemeSpecificPart() : null;
+                final int uid = intent.getIntExtra(Intent.EXTRA_UID, -1);
+                if (pkg != null && uid >= 0) {
+                    remove(uid, pkg);
+                }
+            }
+        }, removed, null, mHandler);
+        mHandler.post(() -> {
+            checkEnforced();
+            load();
+            dropRemoved();
+            applyAll();
+            watch();
+        });
+    }
+
+    private static String key(int uid, String packageName) {
+        return uid + ":" + packageName;
+    }
+
+    private static int uidOfKey(String key) {
+        return Integer.parseInt(key.substring(0, key.indexOf(':')));
+    }
+
+    private static String packageOfKey(String key) {
+        return key.substring(key.indexOf(':') + 1);
+    }
+
+    /** The kernel holds the limits only where the data volume counts user quotas with limits. */
+    private void checkEnforced() {
+        try (BufferedReader r = new BufferedReader(new FileReader("/proc/mounts"))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                final String[] f = line.split(" ");
+                if (f.length > 3 && "/data".equals(f[1])) {
+                    if (!(f[3] + ",").contains("usrquota,")) {
+                        Slog.e(TAG, "/data is mounted without usrquota (" + f[3]
+                                + "): storage limits are not held");
+                    }
+                    return;
+                }
+            }
+            Slog.e(TAG, "/data is not in /proc/mounts");
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot read /proc/mounts", e);
+        }
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // The owner's limits
+
+    /** One line an app: "uid:package", then on, storage, action and the last clear, by tabs. */
+    private void load() {
+        if (!mFile.exists()) {
+            return;
+        }
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(
+                new FileInputStream(mFile), StandardCharsets.UTF_8))) {
+            String line;
+            synchronized (mLock) {
+                mLimits.clear();
+                while ((line = r.readLine()) != null) {
+                    final String[] f = line.split("\t");
+                    if (f.length != 5) {
+                        Slog.w(TAG, "a line of " + mFile + " is not understood: " + line);
+                        continue;
+                    }
+                    try {
+                        uidOfKey(f[0]);
+                        final Limit l = new Limit();
+                        l.on = "1".equals(f[1]);
+                        l.storageBytes = Long.parseLong(f[2]);
+                        l.action = Integer.parseInt(f[3]);
+                        l.lastClearMillis = Long.parseLong(f[4]);
+                        mLimits.put(f[0], l);
+                    } catch (NumberFormatException | StringIndexOutOfBoundsException e) {
+                        Slog.w(TAG, "a line of " + mFile + " is not understood: " + line, e);
+                    }
+                }
+            }
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot read " + mFile, e);
+        }
+    }
+
+    private void save() {
+        final StringBuilder out = new StringBuilder();
+        synchronized (mLock) {
+            for (int i = 0; i < mLimits.size(); i++) {
+                final Limit l = mLimits.valueAt(i);
+                out.append(mLimits.keyAt(i)).append('\t').append(l.on ? 1 : 0).append('\t')
+                        .append(l.storageBytes).append('\t').append(l.action).append('\t')
+                        .append(l.lastClearMillis).append('\n');
+            }
+        }
+        final AtomicFile file = new AtomicFile(mFile);
+        FileOutputStream stream = null;
+        try {
+            stream = file.startWrite();
+            stream.write(out.toString().getBytes(StandardCharsets.UTF_8));
+            file.finishWrite(stream);
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot write " + mFile, e);
+            if (stream != null) {
+                file.failWrite(stream);
+            }
+        }
+    }
+
+    /** Limits of apps removed while the system was not running. */
+    private void dropRemoved() {
+        final PackageManager pm = mContext.getPackageManager();
+        final ArrayMap<String, Integer> gone = new ArrayMap<>();
+        synchronized (mLock) {
+            for (int i = 0; i < mLimits.size(); i++) {
+                final String k = mLimits.keyAt(i);
+                final int uid = uidOfKey(k);
+                int now;
+                try {
+                    now = pm.getPackageUidAsUser(packageOfKey(k), UserHandle.getUserId(uid));
+                } catch (PackageManager.NameNotFoundException e) {
+                    now = -1;
+                }
+                if (now != uid) {
+                    gone.put(k, uid);
+                }
+            }
+        }
+        for (int i = 0; i < gone.size(); i++) {
+            remove(gone.valueAt(i), packageOfKey(gone.keyAt(i)));
+        }
+    }
+
+    private void remove(int uid, String packageName) {
+        final boolean had;
+        synchronized (mLock) {
+            had = mLimits.remove(key(uid, packageName)) != null;
+        }
+        if (had) {
+            Slog.i(TAG, packageName + " (" + uid + ") is removed: its storage limit with it");
+            save();
+            apply(uid);
+        }
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // Holding them
+
+    /** The smallest limit that is on among the uid's packages, which share its quota; 0 for none. */
+    private long limitOf(int uid) {
+        long bytes = 0;
+        synchronized (mLock) {
+            for (int i = 0; i < mLimits.size(); i++) {
+                final Limit l = mLimits.valueAt(i);
+                if (l.on && uidOfKey(mLimits.keyAt(i)) == uid
+                        && (bytes == 0 || l.storageBytes < bytes)) {
+                    bytes = l.storageBytes;
+                }
+            }
+        }
+        return bytes;
+    }
+
+    /** The package of the uid whose limit that is on clears its cache first; null for none. */
+    @Nullable
+    private String clearsCache(int uid) {
+        synchronized (mLock) {
+            for (int i = 0; i < mLimits.size(); i++) {
+                final Limit l = mLimits.valueAt(i);
+                if (l.on && l.action == LujarchStorage.FULL_CLEAR_CACHE
+                        && uidOfKey(mLimits.keyAt(i)) == uid) {
+                    return packageOfKey(mLimits.keyAt(i));
+                }
+            }
+        }
+        return null;
+    }
+
+    private void applyAll() {
+        final ArraySet<Integer> uids = new ArraySet<>();
+        synchronized (mLock) {
+            for (int i = 0; i < mLimits.size(); i++) {
+                uids.add(uidOfKey(mLimits.keyAt(i)));
+            }
+        }
+        for (int i = 0; i < uids.size(); i++) {
+            apply(uids.valueAt(i));
+        }
+    }
+
+    /**
+     * Sets the uid's quota as its limit says, or none, and watches it while its limit is on.
+     * The watch sets the quota of a limit that clears the cache first.
+     */
+    private void apply(int uid) {
+        final long bytes = limitOf(uid);
+        final Watch w;
+        synchronized (mLock) {
+            if (bytes > 0) {
+                w = new Watch();
+                final Watch was = mWatches.get(uid);
+                if (was != null) {
+                    w.full = was.full;
+                    w.sinceMillis = was.sinceMillis;
+                    w.lastClearElapsed = was.lastClearElapsed;
+                }
+                mWatches.put(uid, w);
+            } else {
+                w = null;
+                mWatches.delete(uid);
+            }
+        }
+        if (w == null || clearsCache(uid) == null) {
+            setQuota(uid, bytes, w);
+        }
+        mHandler.removeCallbacks(mWatch);
+        mHandler.post(mWatch);
+    }
+
+    private void setQuota(int uid, long bytes, @Nullable Watch w) {
+        try {
+            mInstaller.setLujarchAppSpaceLimit(null, uid, bytes);
+            if (w != null) {
+                w.quotaBytes = bytes;
+            }
+        } catch (Installer.InstallerException e) {
+            Slog.e(TAG, "cannot set the storage limit of uid " + uid + " to " + bytes, e);
+        }
+    }
+
+    /** Reads what each limited uid holds, clears caches as their limits say, notes when full. */
+    private void watch() {
+        final int[] uids;
+        synchronized (mLock) {
+            uids = new int[mWatches.size()];
+            for (int i = 0; i < uids.length; i++) {
+                uids[i] = mWatches.keyAt(i);
+            }
+        }
+        boolean near = false;
+        for (int uid : uids) {
+            final long limit = limitOf(uid);
+            if (limit <= 0) {
+                continue;
+            }
+            long[] space;
+            try {
+                space = mInstaller.getLujarchAppSpace(null, uid);
+            } catch (Installer.InstallerException e) {
+                Slog.e(TAG, "cannot read what uid " + uid + " holds", e);
+                space = new long[] {-1, -1};
+            }
+            final long margin = Math.max(32L << 20, limit / 50);
+            final String clearPackage = clearsCache(uid);
+            final Watch w;
+            synchronized (mLock) {
+                w = mWatches.get(uid);
+                if (w == null) {
+                    continue;
+                }
+                w.used = space[0];
+                w.cache = space[1];
+                final boolean full = w.used >= 0 && w.used >= limit - FULL_NEAR_BYTES;
+                if (full != w.full) {
+                    w.full = full;
+                    w.sinceMillis = full ? System.currentTimeMillis() : 0;
+                    Slog.i(TAG, "uid " + uid + (full ? " is full: " : " is within its limit: ")
+                            + w.used + " of " + limit + " bytes");
+                }
+            }
+            if (w.used < 0 || w.cache < 0) {
+                if (w.quotaBytes != limit) {
+                    setQuota(uid, limit, w);
+                }
+                continue;
+            }
+            // The limit and the cache: what the app may hold until its cache is cleared.
+            if (clearPackage != null
+                    && Math.abs(limit + w.cache - w.quotaBytes) >= QUOTA_STEP_BYTES) {
+                setQuota(uid, limit + w.cache, w);
+            }
+            near |= w.used >= limit - 2 * margin;
+            if (clearPackage != null && w.used >= limit - margin && w.cache >= CACHE_MIN_BYTES
+                    && !w.clearing
+                    && SystemClock.elapsedRealtime() - w.lastClearElapsed >= CLEAR_AGAIN_MS) {
+                clearCache(uid, clearPackage, w);
+            }
+        }
+        mHandler.removeCallbacks(mWatch);
+        if (uids.length > 0) {
+            mHandler.postDelayed(mWatch, near ? WATCH_NEAR_MS : WATCH_MS);
+        }
+    }
+
+    private void clearCache(int uid, String packageName, Watch w) {
+        w.clearing = true;
+        w.lastClearElapsed = SystemClock.elapsedRealtime();
+        Slog.i(TAG, packageName + " (" + uid + ") is near its storage limit: clearing its cache of "
+                + w.cache + " bytes");
+        final IPackageDataObserver observer = new IPackageDataObserver.Stub() {
+            @Override
+            public void onRemoveCompleted(String pkg, boolean succeeded) {
+                mHandler.post(() -> {
+                    synchronized (mLock) {
+                        w.clearing = false;
+                        w.lastClearElapsed = SystemClock.elapsedRealtime();
+                        final Limit l = mLimits.get(key(uid, packageName));
+                        if (succeeded && l != null) {
+                            l.lastClearMillis = System.currentTimeMillis();
+                        }
+                    }
+                    if (succeeded) {
+                        save();
+                    } else {
+                        Slog.e(TAG, "cannot clear the cache of " + packageName + " (" + uid + ")");
+                    }
+                    watch();
+                });
+            }
+        };
+        mContext.getPackageManager().deleteApplicationCacheFilesAsUser(packageName,
+                UserHandle.getUserId(uid), observer);
+    }
+
+    // -------------------------------------------------------------------------------------------
+    // The API
+
+    private void enforce() {
+        mContext.enforceCallingOrSelfPermission(LujarchStorage.PERMISSION, TAG);
+    }
+
+    private int uidOf(String packageName, int userId) {
+        try {
+            return mContext.getPackageManager().getPackageUidAsUser(packageName, userId);
+        } catch (PackageManager.NameNotFoundException e) {
+            throw new IllegalArgumentException(packageName + " is not installed for user "
+                    + userId);
+        }
+    }
+
+    /** The phone's storage, as Settings shows it. */
+    private long maxBytes() {
+        return mContext.getSystemService(StorageManager.class).getPrimaryStorageSize();
+    }
+
+    @Override
+    public LujarchStorageLimit getLimit(String packageName, int userId) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final int uid;
+            try {
+                uid = mContext.getPackageManager().getPackageUidAsUser(packageName, userId);
+            } catch (PackageManager.NameNotFoundException e) {
+                return null;
+            }
+            final LujarchStorageLimit out = new LujarchStorageLimit();
+            synchronized (mLock) {
+                final Limit l = mLimits.get(key(uid, packageName));
+                final Limit d = l != null ? l : new Limit();
+                out.on = d.on;
+                out.storageBytes = d.storageBytes;
+                out.action = d.action;
+                out.lastClearMillis = d.lastClearMillis;
+            }
+            long[] space;
+            try {
+                space = mInstaller.getLujarchAppSpace(null, uid);
+            } catch (Installer.InstallerException e) {
+                Slog.e(TAG, "cannot read what " + packageName + " (" + uid + ") holds", e);
+                space = new long[] {-1, -1};
+            }
+            out.cacheBytes = space[1];
+            out.dataBytes = space[0] >= 0 && space[1] >= 0 ? Math.max(0, space[0] - space[1])
+                    : space[0];
+            out.state = LujarchStorage.STATE_OFF;
+            if (out.on) {
+                final long limit = limitOf(uid);
+                final boolean full = space[0] >= 0 && space[0] >= limit - FULL_NEAR_BYTES;
+                out.state = full ? LujarchStorage.STATE_FULL : LujarchStorage.STATE_WITHIN;
+                synchronized (mLock) {
+                    final Watch w = mWatches.get(uid);
+                    out.sinceMillis = full && w != null && w.full ? w.sinceMillis : 0;
+                }
+            }
+            out.maxBytes = maxBytes();
+            return out;
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public void setLimit(String packageName, int userId, LujarchStorageLimit in) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final int uid = uidOf(packageName, userId);
+            if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+                throw new IllegalArgumentException(packageName + " is part of the system");
+            }
+            final long max = maxBytes();
+            if (in.storageBytes < LujarchStorage.MIN_BYTES || in.storageBytes > max) {
+                throw new IllegalArgumentException("a storage limit outside "
+                        + LujarchStorage.MIN_BYTES + " to " + max + " bytes");
+            }
+            if (in.action != LujarchStorage.FULL_CLEAR_CACHE
+                    && in.action != LujarchStorage.FULL_STOP) {
+                throw new IllegalArgumentException("no such action " + in.action);
+            }
+            synchronized (mLock) {
+                final String k = key(uid, packageName);
+                final Limit l = mLimits.containsKey(k) ? mLimits.get(k) : new Limit();
+                l.on = in.on;
+                l.storageBytes = in.storageBytes;
+                l.action = in.action;
+                mLimits.put(k, l);
+            }
+            Slog.i(TAG, packageName + " (" + uid + "): storage limit " + (in.on ? "on, "
+                    + in.storageBytes + " bytes, " + (in.action == LujarchStorage.FULL_CLEAR_CACHE
+                    ? "clear its cache first" : "stop it saving") : "off"));
+            mHandler.post(() -> {
+                save();
+                apply(uid);
+            });
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+}
