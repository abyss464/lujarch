+package com.android.internal.app;
+
+import android.os.IBinder;
+import android.os.ServiceManager;
+
+/**
+ * Lujarch's Storage for the pages that show it: how much of the phone's storage an app may keep
+ * for itself (STO-1).
+ *
+ * @hide
+ */
+public final class LujarchStorage {
+    /** The system service, {@link ILujarchStorage}. */
+    public static final String SERVICE = "lujarch_storage";
+    /** Held by the callers of {@link ILujarchStorage}. */
+    public static final String PERMISSION = "android.permission.LUJARCH_STORAGE";
+
+    /** When it is full: its cache is cleared first, and it saves on into the room that frees. */
+    public static final int FULL_CLEAR_CACHE = 0;
+    /** When it is full: it cannot save more. */
+    public static final int FULL_STOP = 1;
+
+    /** Use storage limit is off. */
+    public static final int STATE_OFF = 0;
+    public static final int STATE_WITHIN = 1;
+    /** At its limit: it cannot save more. */
+    public static final int STATE_FULL = 2;
+
+    /** Sizes of storage limits are in MB of 1000 * 1000 bytes, as Android shows sizes. */
+    public static final long MB = 1_000_000L;
+    /** The smallest storage limit. */
+    public static final long MIN_BYTES = 100 * MB;
+    /** The limit once Use storage limit is first turned on. */
+    public static final long DEFAULT_BYTES = 4_000 * MB;
+
+    /**
+     * Settings > Apps > (app) > Storage & cache > Storage limit, for
+     * Intent.EXTRA_PACKAGE_NAME.
+     */
+    public static final String ACTION_STORAGE_LIMIT = "org.lujarch.storage.action.STORAGE_LIMIT";
+
+    private LujarchStorage() {
+    }
+
+    /** The system service; null before it is published. */
+    public static ILujarchStorage get() {
+        final IBinder binder = ServiceManager.getService(SERVICE);
+        return binder != null ? ILujarchStorage.Stub.asInterface(binder) : null;
+    }
+}
