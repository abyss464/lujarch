+    // ---------------------------------------------------------------------------------------
+    // The window's lifecycle
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        viewTreeObserver.addOnComputeInternalInsetsListener(this)
+        settings.register()
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        viewTreeObserver.removeOnComputeInternalInsetsListener(this)
+        settings.unregister()
+        touchMonitor.stop()
+    }
+
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        super.onLayout(changed, l, t, r, b)
+        if (changed) {
+            if (dockTopFraction.isNaN()) dockTopFraction = DOCK_TOP / (height / density)
+            dockTop = clampDockTop(dockTopFraction * height)
+            items.values.forEach {
+                fitWindow(it)
+                if (it.w.value == 0f) growIn(it)
+            }
+            place(animate = true, stagger = true)
+            ownSprings.forEach { it.snap(it.target.toFloat()) }
+            syncTasks()
+        } else {
+            items.values.forEach { placeView(it) }
+        }
+    }
+
+    /** The display's size or density changed. */
+    fun onDisplaySizeChanged() {
+        requestLayout()
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Bubbles, as BubbleController reports them
+
+    /** A bubble was added: its card goes on top of the dock (WIN-4). */
+    fun addBubble(bubble: Bubble) {
+        val existing = items[bubble.key]
+        if (existing != null) {
+            existing.bubble = bubble
+            existing.view.bind()
+            return
+        }
+        val item = LujarchSmallWindowItem(bubble, context, this)
+        item.view.tag = item
+        item.lastUsed = SystemClock.uptimeMillis()
+        item.lastMessage = bubble.flyoutMessage?.message
+        initWindow(item)
+        items[bubble.key] = item
+        dock.add(0, item)
+        item.view.elevation = dp(CARD_Z)
+        addView(item.view, LayoutParams(0, 0))
+        item.view.bind()
+        listen(item)
+        if (width > 0) growIn(item)
+        if (item.counts) enforceLimit(item)
+        place(animate = true, stagger = true)
+        syncTasks()
+    }
+
+    /** A new shape grows out of the top of the dock. */
+    private fun growIn(item: LujarchSmallWindowItem) {
+        snapItem(item, slotFrame(0), scale = cardScale(item))
+        item.alpha.snap(0f)
+        item.lift.snap(0.6f)
+    }
+
+    /**
+     * A bubble went away: its shape fades where it is while the dock closes up; then the bubble's
+     * task view is cleaned up, which ends its task unless it already left the bubble (full screen,
+     * Recents).
+     */
+    fun removeBubble(bubble: Bubble) {
+        val item = items.remove(bubble.key)
+        if (item == null) {
+            post { finishRemoval(bubble) }
+            return
+        }
+        dock.remove(item)
+        if (open === item) {
+            open = null
+            updateTouchMonitor()
+        }
+        if (menuFor === item) hideMenu()
+        item.leaving = true
+        item.alpha.to(0f)
+        item.lift.to(0.8f)
+        if (!LujarchSpring.animated()) item.alpha.snap(0f)
+        place(animate = true, stagger = true)
+    }
+
+    private fun gone(item: LujarchSmallWindowItem) {
+        detachTask(item)
+        removeView(item.view)
+        finishRemoval(item.bubble)
+        if (items.isEmpty()) controller.onAllBubblesAnimatedOut()
+    }
+
+    private fun finishRemoval(bubble: Bubble) {
+        val transition = bubble.currentTransition
+        if (transition != null) transition.continueCollapse() else bubble.cleanupViews()
+    }
+
+    /** The bubble's task view reports to its shape from the start, attached or not. */
+    private fun listen(item: LujarchSmallWindowItem) {
+        if (item.listener != null) return
+        val btv = item.bubble.bubbleTaskView ?: return
+        item.listener =
+            BubbleTaskViewListener(context, btv, item.view, manager,
+                object : BubbleTaskViewListener.Callback {
+                    override fun onTaskCreated() = onContentDrawn(item, true)
+
+                    override fun onContentVisibilityChanged(visible: Boolean) =
+                        onContentDrawn(item, visible)
+
+                    override fun onBackPressed() {
+                        if (item === open) controller.collapseStack()
+                    }
+
+                    override fun onTaskInfoChanged(taskInfo: ActivityManager.RunningTaskInfo) {
+                        onTaskInfo(item, taskInfo)
+                    }
+                })
+        item.listener?.setBubble(item.bubble)
+    }
+
+    /** A bubble's notification or icon changed: a new message counts on its card (WIN-13). */
+    fun updateBubble(bubble: Bubble) {
+        val item = items[bubble.key] ?: return
+        item.bubble = bubble
+        val message = bubble.flyoutMessage?.message
+        if (item.isConversation && message != null && message != item.lastMessage) {
+            item.lastMessage = message
+            if (item !== open) item.unread++
+        }
+        item.view.bind()
+    }
+
+    fun setBubbleSuppressed(bubble: Bubble, suppressed: Boolean) {
+        val item = items[bubble.key] ?: return
+        item.view.visibility = if (suppressed) INVISIBLE else VISIBLE
+    }
+
+    /** Expansion or selection changed in BubbleData: the selected bubble's window opens. */
+    fun onStackChanged() {
+        val selected = data.selectedBubble as? Bubble
+        val wanted = if (data.isExpanded && selected != null) items[selected.key] else null
+        if (wanted === open) return
+        val previous = open
+        if (previous != null) {
+            // The window that was open becomes the top card (WIN-4).
+            dock.remove(previous)
+            dock.add(0, previous)
+            previous.view.elevation = dp(CARD_Z)
+        }
+        hideMenu()
+        open = wanted
+        if (wanted != null) {
+            dock.remove(wanted)
+            wanted.lastUsed = SystemClock.uptimeMillis()
+            wanted.unread = 0
+            wanted.view.elevation = dp(WINDOW_Z)
+            if (wanted.isConversation && !wanted.opened) {
+                wanted.opened = true
+                enforceLimit(wanted)
+            }
+        }
+        belowTouched = false
+        updateTouchMonitor()
+        place(animate = true, stagger = true)
+        syncTasks()
+    }
+
+    fun hasItems(): Boolean = items.isNotEmpty()
+
+    /** Whether another small window than [taskView]'s shows its app: the bubbles' root task stays. */
+    fun showsTaskOtherThan(taskView: TaskViewTaskController): Boolean =
+        items.values.any { it.taskView != null && it.taskView?.controller !== taskView }
+
+    // ---------------------------------------------------------------------------------------
+    // The limit (WIN-8)
+
+    private fun enforceLimit(newcomer: LujarchSmallWindowItem) {
+        val counted = items.values.filter { it.counts && !it.leaving }
+        var excess = counted.size - settings.maxWindows
+        if (excess <= 0) return
+        val candidates =
+            counted.filter { it !== newcomer && it !== open }.sortedBy { it.lastUsed }
+        for (item in candidates) {
+            if (excess <= 0) break
+            moveToRecents(item)
+            excess--
+        }
+    }
+
+    /**
+     * Makes the small window an ordinary task behind the app on screen, so that it is a card in
+     * Recents and its app keeps running.
+     */
+    private fun moveToRecents(item: LujarchSmallWindowItem) {
+        val bubble = item.bubble
+        val taskView = bubble.bubbleTaskView?.taskView
+        val task = taskView?.taskInfo
+        if (taskView == null || task == null) {
+            controller.dismissBubble(bubble, Bubbles.DISMISS_AGED)
+            return
+        }
+        Log.i(TAG, "moving ${bubble.key} (task ${task.taskId}) to Recents: over the limit")
+        val wct =
+            if (controller.bubbleHelper.isAppBubbleTask(task)) {
+                BubbleUtils.getExitBubbleTransaction(controller.bubbleHelper, task.token,
+                    taskView.captionInsetsOwner)
+            } else {
+                WindowContainerTransaction().apply {
+                    setWindowingMode(task.token, WindowConfiguration.WINDOWING_MODE_UNDEFINED)
+                    setAlwaysOnTop(task.token, false)
+                    setTaskForceExcludedFromRecents(task.token, false)
+                    setInterceptBackPressedOnTaskRoot(task.token, false)
+                    setDisablePip(task.token, false)
+                    setLaunchNextToBubble(task.token, false)
+                    setDisableLaunchAdjacent(task.token, false)
+                    setBounds(task.token, Rect())
+                }
+            }
+        wct.reorder(task.token, false /* onTop */)
+        taskView.controller.taskOrganizer.applyTransaction(wct)
+        taskView.controller.notifyTaskRemovalStarted(task)
+    }
+
+    private fun onSettingsChanged() {
+        if (!settings.enabled) {
+            // Off (WIN-1): the dock and its rail are gone; the apps stay in Recents.
+            items.values.filter { !it.isConversation }.forEach { moveToRecents(it) }
+            return
+        }
+        items.values.lastOrNull { it.counts }?.let { enforceLimit(it) }
+        updateTouchMonitor()
+        place(animate = true, stagger = true)
+        syncTasks()
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Geometry
+
+    private fun dp(v: Float): Float = v * density
+
+    val headerHeight: Float
+        get() = dp(HEADER)
+
+    private val margin: Float
+        get() = dp(MARGIN)
+
+    private val statusBar: Int
+        get() =
+            rootWindowInsets?.getInsetsIgnoringVisibility(WindowInsets.Type.statusBars())?.top
+                ?: 0
+
+    private val topLimit: Float
+        get() = max(margin, statusBar.toFloat())
+
+    private val bottomLimit: Float
+        get() = min(height - margin, imeTop - margin)
+
+    private fun cardScale(item: LujarchSmallWindowItem): Float =
+        dp(CARD_W) / max(1, item.layoutW)
+
+    private fun initWindow(item: LujarchSmallWindowItem) {
+        val w = if (width > 0) width else resources.displayMetrics.widthPixels
+        val h = if (height > 0) height else resources.displayMetrics.heightPixels
+        item.layoutW = w
+        item.layoutH = h
+        item.taskW = w
+        item.taskH = h
+        item.winScale = dp(WINDOW_W) / w
+        item.winX = dp(WINDOW_X)
+        item.winY = dp(WINDOW_Y)
+        fitWindow(item)
+    }
+
+    /** Keeps the window at least 160 dp wide and 12 dp inside the screen's edges (WIN-2). */
+    private fun fitWindow(item: LujarchSmallWindowItem) {
+        if (width == 0 || height == 0 || item.layoutW == 0) return
+        val maxW = width - 2 * margin
+        val maxH = bottomLimit - topLimit
+        var s = item.winScale
+        s = min(s, maxW / item.layoutW)
+        s = min(s, (maxH - headerHeight) / item.layoutH)
+        s = max(s, dp(MIN_W) / item.layoutW)
+        item.winScale = s
+        val w = item.layoutW * s
+        val h = headerHeight + item.layoutH * s
+        item.winX = item.winX.coerceIn(margin, max(margin, width - margin - w))
+        item.winY = item.winY.coerceIn(topLimit, max(topLimit, bottomLimit - h))
+    }
+
+    private class Frame(
+        val x: Float,
+        val y: Float,
+        val w: Float,
+        val h: Float,
+        val radius: Float,
+        val turn: Float,
+        val window: Float,
+        val icon: Float,
+    )
+
+    private fun dockX(): Float = if (dockRight) width - dp(DOCK_MARGIN + CARD_W) else dp(DOCK_MARGIN)
+
+    private fun slotFrame(i: Int): Frame =
+        if (folded) {
+            val x =
+                if (dockRight) width - dp(RAIL_W) + dp((RAIL_W - RAIL_ICON) / 2)
+                else dp((RAIL_W - RAIL_ICON) / 2)
+            Frame(x, railTopFor(dockTop) + dp(RAIL_PAD) + i * dp(RAIL_STEP), dp(RAIL_ICON),
+                dp(RAIL_ICON), dp(RAIL_ICON / 2), 0f, 0f, 1f)
+        } else {
+            Frame(dockX(), dockTop + dp(CARD_FROM_HANDLE) + i * dp(CARD_STEP), dp(CARD_W),
+                dp(CARD_H), dp(CARD_RADIUS), 1f, 0f, 0f)
+        }
+
+    private fun windowFrame(item: LujarchSmallWindowItem): Frame {
+        val s = item.winScale
+        var y = item.winY
+        val h = headerHeight + item.layoutH * s
+        // Over the input method the window waits above it.
+        if (y + h > bottomLimit) y = max(topLimit, bottomLimit - h)
+        return Frame(item.winX, y, item.layoutW * s, h, dp(WINDOW_RADIUS), 0f, 1f, 0f)
+    }
+
+    private fun railTopFor(top: Float): Float = top + dp(RAIL_FROM_HANDLE)
+
+    private fun clampDockTop(top: Float): Float {
+        val cards = max(1, dock.size)
+        val span = dp(CARD_FROM_HANDLE) + (cards - 1) * dp(CARD_STEP) + dp(CARD_H)
+        return top.coerceIn(topLimit, max(topLimit, height - margin - span))
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Motion
+
+    private fun target(item: LujarchSmallWindowItem, f: Frame, scale: Float) {
+        item.x.to(f.x)
+        item.y.to(f.y)
+        item.w.to(f.w)
+        item.h.to(f.h)
+        item.radius.to(f.radius)
+        item.turn.to(f.turn)
+        item.window.to(f.window)
+        item.icon.to(f.icon)
+        item.scale.to(scale)
+        item.alpha.to(if (item.leaving) 0f else 1f)
+        if (gesture?.holds(item) != true) item.lift.to(if (item.leaving) 0.8f else 1f)
+        item.content.to(if (wantsContent(item) && item.contentDrawn) 1f else 0f)
+    }
+
+    private fun snapItem(item: LujarchSmallWindowItem, f: Frame, scale: Float) {
+        item.x.snap(f.x)
+        item.y.snap(f.y)
+        item.w.snap(f.w)
+        item.h.snap(f.h)
+        item.radius.snap(f.radius)
+        item.turn.snap(f.turn)
+        item.window.snap(f.window)
+        item.icon.snap(f.icon)
+        item.scale.snap(scale)
+    }
+
+    /** Sets every shape's target; [stagger]: the cards follow each other (WIN-9). */
+    private fun place(animate: Boolean, stagger: Boolean = false) {
+        if (width == 0) return
+        val now = SystemClock.uptimeMillis()
+        dockTop = clampDockTop(dockTop)
+        if (recentsShown) {
+            placeInRecents(now)
+            updateCompositionOrder()
+            if (!animate || !LujarchSpring.animated()) {
+                items.values.forEach { item -> item.springs.forEach { it.snap(it.target.toFloat()) } }
+                ownSprings.forEach { it.snap(it.target.toFloat()) }
+            }
+            clock.start()
+            invalidate()
+            return
+        }
+        dock.forEachIndexed { i, item ->
+            if (gesture?.holds(item) == true) return@forEachIndexed
+            val f = slotFrame(i)
+            target(item, f, if (folded) dp(RAIL_ICON) / max(1, item.layoutW) else cardScale(item))
+            item.startAt = if (stagger) now + i * LujarchSpring.STAGGER_MS else now
+            item.view.elevation = dp(CARD_Z) - i * dp(0.5f)
+        }
+        open?.let { item ->
+            if (gesture?.holds(item) != true) {
+                target(item, windowFrame(item), item.winScale)
+            }
+            item.startAt = now
+        }
+        val visibleDock = dock.isNotEmpty() && settings.enabled
+        if (gesture !is DockDrag) {
+            handleX.to(dockX() + dp((CARD_W - HANDLE_W) / 2))
+            handleY.to(dockTop)
+        }
+        handleAlpha.to(if (visibleDock && !folded) 1f else 0f)
+        if (gesture !is RailDrag) railTop.to(railTopFor(dockTop))
+        railHeight.to(dp(RAIL_PAD * 2) + max(0, dock.size - 1) * dp(RAIL_STEP) + dp(RAIL_ICON))
+        railAlpha.to(if (visibleDock && folded) 1f else 0f)
+        menuAlpha.to(if (menuFor != null) 1f else 0f)
+        updateCompositionOrder()
+        if (!animate || !LujarchSpring.animated()) {
+            items.values.forEach { item -> item.springs.forEach { it.snap(it.target.toFloat()) } }
+            ownSprings.forEach { it.snap(it.target.toFloat()) }
+        }
+        clock.start()
+        invalidate()
+    }
+
+    /**
+     * The open window first, then the cards in their order, side by side in the strip above
+     * Recents' cards where its Running layer shows what runs, each with its live screen.
+     */
+    private fun placeInRecents(now: Long) {
+        val shown = listOfNotNull(open) + dock
+        val h = dp(RECENTS_TILE_H)
+        val w = h * dp(CARD_W) / dp(CARD_H)
+        val gap = dp(RECENTS_GAP)
+        val total = shown.size * w + max(0, shown.size - 1) * gap
+        var x = (width - total) / 2f
+        val y = statusBar + dp(RECENTS_TOP)
+        shown.forEachIndexed { i, item ->
+            target(item, Frame(x, y, w, h, dp(CARD_RADIUS) * h / dp(CARD_H), 0f, 0f, 0f),
+                w / max(1, item.layoutW))
+            item.startAt = now + i * LujarchSpring.STAGGER_MS
+            x += w + gap
+        }
+        handleAlpha.to(0f)
+        railAlpha.to(0f)
+        menuAlpha.to(0f)
+    }
+
+    /** Recents opened or closed (Launcher reports it). */
+    fun setRecentsShown(shown: Boolean) {
+        if (shown == recentsShown) return
+        recentsShown = shown
+        if (shown) {
+            hideMenu()
+            gesture = null
+        }
+        updateTouchMonitor()
+        place(animate = true, stagger = true)
+        syncTasks()
+    }
+
+    private fun onFrame(ms: Long): Boolean {
+        val now = SystemClock.uptimeMillis()
+        var moving = false
+        val threshold = 0.5 / density
+        for (item in items.values.toList() + leavingItems()) {
+            if (now >= item.startAt) {
+                for (s in item.springs) s.step(ms, if (s === item.x || s === item.y ||
+                        s === item.w || s === item.h || s === item.radius) 0.5 else 0.002)
+            }
+            if (item.springs.any { !it.atRest }) moving = true
+            placeView(item)
+        }
+        for (s in ownSprings) {
+            s.step(ms, 0.5)
+            if (!s.atRest) moving = true
+        }
+        // Shapes that left are removed once they have faded.
+        for (item in leavingItems()) {
+            if (item.alpha.atRest) gone(item)
+        }
+        if (!moving) syncTasks()
+        invalidate()
+        return moving || gesture != null
+    }
+
+    private fun leavingItems(): List<LujarchSmallWindowItem> =
+        (0 until childCount).mapNotNull { (getChildAt(it) as? LujarchSmallWindowItemView)?.let {
+            v -> v.tag as? LujarchSmallWindowItem } }.filter { it.leaving }
+
+    private fun placeView(item: LujarchSmallWindowItem) {
+        val v = item.view
+        v.tag = item
+        val l = item.x.value.roundToInt()
+        val t = item.y.value.roundToInt()
+        val r = (item.x.value + item.w.value).roundToInt()
+        val b = (item.y.value + item.h.value).roundToInt()
+        if (v.measuredWidth != r - l || v.measuredHeight != b - t || v.isLayoutRequested) {
+            v.measure(
+                MeasureSpec.makeMeasureSpec(max(1, r - l), MeasureSpec.EXACTLY),
+                MeasureSpec.makeMeasureSpec(max(1, b - t), MeasureSpec.EXACTLY),
+            )
+        }
+        v.layout(l, t, max(l + 1, r), max(t + 1, b))
+        v.apply(headerHeight, dockRight)
+    }
+
+    /** The order the task views are composited in, as the shapes stack (WIN-4). */
+    private fun updateCompositionOrder() {
+        val order = ArrayList<LujarchSmallWindowItem>()
+        (gesture as? CardDrag)?.item?.let { order.add(it) }
+        open?.let { if (it !in order) order.add(it) }
+        dock.forEach { if (it !in order) order.add(it) }
+        order.forEachIndexed { i, item -> item.taskView?.setCompositionOrder(-1 - i) }
+        (gesture as? CardDrag)?.item?.view?.elevation = dp(DRAG_Z)
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The apps' tasks: visible while their screen shows
+
+    /** Whether the app's live screen shows in the shape (WIN-6, WIN-7). */
+    private fun wantsContent(item: LujarchSmallWindowItem): Boolean {
+        if (item.leaving || !settings.enabled) return false
+        if (item === open) return true
+        if (recentsShown) return !item.isConversation
+        if (gesture?.holds(item) == true && item.taskView != null) return true
+        return !item.isConversation && !folded && settings.livePreviews
+    }
+
+    /**
+     * Attaches the task view of every shape that shows its app's screen and detaches the others
+     * once their screen has faded: a task is visible exactly while its view is attached, so apps
+     * in the rail or behind a card without a preview are in the background (WIN-6).
+     */
+    private fun syncTasks() {
+        for (item in items.values) {
+            val want = wantsContent(item)
+            if (want && item.taskView == null) {
+                attachTask(item)
+            } else if (!want && item.taskView != null && item.content.value <= 0.001f) {
+                detachTask(item)
+            }
+            item.content.to(if (want && item.contentDrawn) 1f else 0f)
+        }
+        updateCompositionOrder()
+        syncFocus()
+        clock.start()
+    }
+
+    private fun attachTask(item: LujarchSmallWindowItem) {
+        val btv = item.bubble.bubbleTaskView ?: return
+        val tv = btv.taskView
+        (tv.parent as? ViewGroup)?.let { if (it !== item.view) it.removeView(tv) }
+        listen(item)
+        tv.setSurfaceLifecycle(SurfaceView.SURFACE_LIFECYCLE_FOLLOWS_VISIBILITY)
+        tv.setCaptionInsets(null)
+        tv.setEnableSurfaceClipping(true)
+        tv.setZOrderedOnTop(false, true)
+        tv.visibility = VISIBLE
+        tv.alpha = 0f
+        if (tv.parent == null) {
+            item.view.addView(tv, 0, LayoutParams(item.taskW, item.taskH))
+        }
+        item.taskView = tv
+        item.view.onTaskViewChanged()
+        item.view.requestLayout()
+        updateCompositionOrder()
+    }
+
+    private fun detachTask(item: LujarchSmallWindowItem) {
+        val tv = item.taskView ?: return
+        item.taskView = null
+        item.contentDrawn = false
+        item.content.snap(0f)
+        if (tv.parent === item.view) item.view.removeView(tv)
+        item.view.onTaskViewChanged()
+    }
+
+    private fun onContentDrawn(item: LujarchSmallWindowItem, drawn: Boolean) {
+        item.contentDrawn = drawn
+        item.focusable = null
+        syncFocus()
+        item.content.to(if (drawn && wantsContent(item)) 1f else 0f)
+        clock.start()
+    }
+
+    private fun onTaskInfo(item: LujarchSmallWindowItem, info: ActivityManager.RunningTaskInfo) {
+        val d = info.taskDescription ?: return
+        val color =
+            when {
+                Color.alpha(d.statusBarColor) == 0xff -> d.statusBarColor
+                Color.alpha(d.backgroundColor) == 0xff -> d.backgroundColor
+                else -> 0
+            }
+        if (color != item.headerColor) {
+            item.headerColor = color
+            item.view.invalidate()
+        }
+    }
+
+    fun cardColor(item: LujarchSmallWindowItem): Int =
+        if (item.isConversation) conversationColor else placeholderColor
+
+    fun handleColor(item: LujarchSmallWindowItem): Int {
+        val bg = if (item.headerColor != 0) item.headerColor else windowColor
+        return if (Color.luminance(bg) > 0.5f) Color.argb(160, 0, 0, 0)
+        else Color.argb(170, 255, 255, 255)
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // What a person does with the windows, the cards, the dock and the rail
+
+    private fun openItem(item: LujarchSmallWindowItem) {
+        hideMenu()
+        if (item === open) return
+        controller.expandStackAndSelectBubble(item.bubble)
+    }
+
+    private fun moveToDock() {
+        hideMenu()
+        controller.collapseStack()
+    }
+
+    private fun close(item: LujarchSmallWindowItem) {
+        hideMenu()
+        controller.dismissBubble(item.bubble, Bubbles.DISMISS_USER_GESTURE)
+    }
+
+    /** Full screen (WIN-2): the small window becomes an ordinary app in Recents. */
+    private fun fullScreen(item: LujarchSmallWindowItem) {
+        hideMenu()
+        val tv = item.bubble.bubbleTaskView?.taskView ?: return
+        if (tv.taskInfo == null) return
+        tv.moveToFullscreen()
+    }
+
+    /**
+     * A touch going down while a window is open: on the app below, it moves the window to the
+     * dock (WIN-3), or, with that switch off, gives the app below the focus; on the window, the
+     * window takes the focus back.
+     */
+    private fun onTouchBelow(x: Float, y: Float) {
+        val item = open ?: return
+        if (gesture != null) return
+        tmpRectF.set(item.x.value, item.y.value, item.x.value + item.w.value,
+            item.y.value + item.h.value)
+        tmpRectF.inset(-dp(EDGE_TOUCH), -dp(EDGE_TOUCH))
+        if (tmpRectF.contains(x, y)) {
+            belowTouched = false
+            syncFocus()
+            return
+        }
+        if (y < statusBar || y > height - dp(GESTURE_AREA) || y >= imeTop) return
+        if (ownRegionContains(x, y)) return
+        if (settings.dockOnTouch) {
+            moveToDock()
+        } else {
+            belowTouched = true
+            syncFocus()
+        }
+    }
+
+    /**
+     * Only the open window's task may take the focus, and not after a touch on the app below:
+     * Back, keys and the input method then go to the app being used.
+     */
+    private fun syncFocus() {
+        for (item in items.values) {
+            val want = item === open && !belowTouched && !recentsShown
+            if (item.focusable == want) continue
+            val task = item.bubble.bubbleTaskView?.taskView?.taskInfo ?: continue
+            item.focusable = want
+            val wct = WindowContainerTransaction()
+            wct.setFocusable(task.token, want)
+            controller.taskOrganizer.applyTransaction(wct)
+        }
+    }
+
+    private fun updateTouchMonitor() {
+        if (open != null && !recentsShown && isAttachedToWindow) {
+            touchMonitor.start(display?.displayId ?: 0)
+        } else {
+            touchMonitor.stop()
+        }
+    }
+
+    private fun showMenu(item: LujarchSmallWindowItem) {
+        menuFor = item
+        val w = dp(MENU_W)
+        val h = dp(MENU_ITEM_H) * 3 + dp(12f)
+        val cx = item.x.value + item.w.value / 2
+        val left = (cx - w / 2).coerceIn(dp(8f), width - dp(8f) - w)
+        var top = item.y.value + headerHeight + dp(6f)
+        if (top + h > height - margin) top = max(topLimit, item.y.value - h - dp(6f))
+        menuRect.set(left, top, left + w, top + h)
+        place(animate = true)
+    }
+
+    private fun hideMenu() {
+        if (menuFor == null) return
+        menuFor = null
+        menuAlpha.to(0f)
+        if (!LujarchSpring.animated()) menuAlpha.snap(0f)
+        clock.start()
+    }
+
+    override fun dispatchDraw(canvas: Canvas) {
+        drawRail(canvas)
+        drawHandle(canvas)
+        super.dispatchDraw(canvas)
+        drawMenu(canvas)
+    }
+
+    private fun drawHandle(canvas: Canvas) {
+        val a = handleAlpha.value
+        if (a <= 0.01f) return
+        val x = handleX.value + dp(HANDLE_W) / 2
+        val y = handleY.value + dp(HANDLE_H) / 2
+        val pw = dp(30f)
+        val ph = dp(5f)
+        tmpRectF.set(x - pw / 2, y - ph / 2, x + pw / 2, y + ph / 2)
+        paint.style = Paint.Style.FILL
+        paint.color = Color.argb((191 * a).roundToInt(), 60, 48, 44)
+        canvas.drawRoundRect(tmpRectF, ph / 2, ph / 2, paint)
+        paint.style = Paint.Style.STROKE
+        paint.strokeWidth = dp(1f)
+        paint.color = Color.argb((153 * a).roundToInt(), 255, 255, 255)
+        canvas.drawRoundRect(tmpRectF, ph / 2, ph / 2, paint)
+        paint.style = Paint.Style.FILL
+    }
+
+    private fun drawRail(canvas: Canvas) {
+        val a = railAlpha.value
+        if (a <= 0.01f) return
+        val w = dp(RAIL_W)
+        val left = if (dockRight) width - w else 0f
+        tmpRectF.set(left, railTop.value, left + w, railTop.value + railHeight.value)
+        val r = w / 2
+        paint.style = Paint.Style.FILL
+        paint.color = Color.argb((219 * a).roundToInt(), 40, 30, 27)
+        paint.setShadowLayer(dp(9f), 0f, dp(3f), Color.argb((71 * a).roundToInt(), 0, 0, 0))
+        // Rounded towards the middle of the screen, flat against the edge.
+        canvas.save()
+        canvas.clipRect(left, tmpRectF.top - dp(20f), left + w, tmpRectF.bottom + dp(20f))
+        val ext = if (dockRight) RectF(tmpRectF.left, tmpRectF.top, tmpRectF.right + r,
+            tmpRectF.bottom) else RectF(tmpRectF.left - r, tmpRectF.top, tmpRectF.right,
+            tmpRectF.bottom)
+        canvas.drawRoundRect(ext, r, r, paint)
+        canvas.restore()
+        paint.clearShadowLayer()
+    }
+
+    private fun drawMenu(canvas: Canvas) {
+        val a = menuAlpha.value
+        if (a <= 0.01f) return
+        val r = dp(16f)
+        paint.style = Paint.Style.FILL
+        paint.color = withAlpha(menuColor, a)
+        paint.setShadowLayer(dp(12f), 0f, dp(4f), Color.argb((115 * a).roundToInt(), 0, 0, 0))
+        canvas.drawRoundRect(menuRect, r, r, paint)
+        paint.clearShadowLayer()
+        menuPaint.color = withAlpha(menuTextColor, a)
+        val rowH = dp(MENU_ITEM_H)
+        for (i in 0..2) {
+            val top = menuRect.top + dp(6f) + i * rowH
+            val icon = menuIcons[i]
+            val size = dp(18f).roundToInt()
+            val il = (menuRect.left + dp(16f)).roundToInt()
+            val it = (top + (rowH - size) / 2).roundToInt()
+            icon?.setBounds(il, it, il + size, it + size)
+            icon?.setTint(withAlpha(conversationSubTextColor, a))
+            icon?.draw(canvas)
+            canvas.drawText(menuLabels[i], 0, menuLabels[i].length,
+                menuRect.left + dp(46f), top + rowH / 2 + menuPaint.textSize * 0.36f, menuPaint)
+        }
+    }
+
+    private fun withAlpha(color: Int, a: Float): Int =
+        Color.argb((Color.alpha(color) * a.coerceIn(0f, 1f)).roundToInt(), Color.red(color),
+            Color.green(color), Color.blue(color))
+
+    // ---------------------------------------------------------------------------------------
+    // Touches
+
+    private abstract inner class Gesture(val downX: Float, val downY: Float) {
+        var moved = false
+
+        open fun holds(item: LujarchSmallWindowItem): Boolean = false
+
+        fun move(ev: MotionEvent) {
+            if (!moved && hypot(ev.rawX - downX, ev.rawY - downY) < touchSlop) return
+            if (!moved) {
+                moved = true
+                hideMenu()
+                onStart()
+            }
+            onMove(ev.rawX - downX, ev.rawY - downY, ev.rawX, ev.rawY)
+        }
+
+        open fun onStart() {}
+
+        abstract fun onMove(dx: Float, dy: Float, x: Float, y: Float)
+
+        abstract fun onUp(vx: Float, vy: Float)
+
+        open fun onTap() {}
+
+        open fun onCancel() = onUp(0f, 0f)
+    }
+
+    /** The handle moves the window anywhere on the screen (WIN-2); a tap opens its menu. */
+    private inner class HeaderDrag(val item: LujarchSmallWindowItem, x: Float, y: Float) :
+        Gesture(x, y) {
+        private val startX = item.winX
+        private val startY = windowFrame(item).y
+
+        override fun holds(item: LujarchSmallWindowItem) = moved && item === this.item
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            val f = windowFrame(item)
+            item.winX = (startX + dx).coerceIn(margin, max(margin, width - margin - f.w))
+            item.winY = (startY + dy).coerceIn(topLimit, max(topLimit, bottomLimit - f.h))
+            item.x.snap(item.winX)
+            item.y.snap(item.winY)
+        }
+
+        override fun onUp(vx: Float, vy: Float) {
+            place(animate = true)
+        }
+
+        override fun onTap() {
+            if (menuFor === item) hideMenu() else showMenu(item)
+        }
+    }
+
+    /**
+     * The lower right corner scales the window and the app together, keeping its layout; the
+     * right and the bottom edge change its width or height, and the app lays itself out at the
+     * new size. Past the screen's limit, letting go shows the app full screen (WIN-2).
+     */
+    private inner class Resize(
+        val item: LujarchSmallWindowItem,
+        val corner: Boolean,
+        val right: Boolean,
+        x: Float,
+        y: Float,
+    ) : Gesture(x, y) {
+        private val start = windowFrame(item)
+        private val startScale = item.winScale
+        private val startLayoutW = item.layoutW
+        private val startLayoutH = item.layoutH
+        private var over = false
+
+        override fun holds(item: LujarchSmallWindowItem) = moved && item === this.item
+
+        override fun onStart() {
+            outlineAlpha = 1f
+        }
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            val maxW = width - margin - start.x
+            val maxH = bottomLimit - start.y
+            val minW = dp(MIN_W)
+            if (corner) {
+                val byWidth = start.w + dx
+                val heightFor = { w: Float -> headerHeight + startLayoutH * (w / startLayoutW) }
+                var limit = maxW
+                if (heightFor(limit) > maxH) {
+                    limit = (maxH - headerHeight) / startLayoutH * startLayoutW
+                }
+                over = byWidth > limit + dp(OVERSHOOT)
+                val w = byWidth.coerceIn(minW, limit + rubber(byWidth - limit))
+                item.winScale = w / startLayoutW
+            } else if (right) {
+                val byWidth = start.w + dx
+                over = byWidth > maxW + dp(OVERSHOOT)
+                val w = byWidth.coerceIn(minW, maxW + rubber(byWidth - maxW))
+                item.layoutW = (w / startScale).roundToInt()
+            } else {
+                val byHeight = start.h + dy
+                over = byHeight > maxH + dp(OVERSHOOT)
+                val h = byHeight.coerceIn(headerHeight + dp(MIN_H), maxH + rubber(byHeight - maxH))
+                item.layoutH = ((h - headerHeight) / startScale).roundToInt()
+            }
+            val f = windowFrame(item)
+            snapItem(item, f, item.winScale)
+            outlineAlpha = if (over) 1f else 0.95f
+            item.view.invalidate()
+        }
+
+        private fun rubber(past: Float): Float = if (past <= 0f) 0f else past * 0.2f
+
+        override fun onUp(vx: Float, vy: Float) {
+            outlineAlpha = OUTLINE_ALPHA
+            if (over) {
+                // The window goes back to its size as it was, then becomes the app full screen.
+                item.winScale = startScale
+                item.layoutW = startLayoutW
+                item.layoutH = startLayoutH
+                place(animate = true)
+                fullScreen(item)
+                return
+            }
+            fitWindow(item)
+            if (item.layoutW != item.taskW || item.layoutH != item.taskH) {
+                // The app lays itself out at the new size.
+                item.taskW = item.layoutW
+                item.taskH = item.layoutH
+                item.taskView?.layoutParams = LayoutParams(item.taskW, item.taskH)
+                item.view.requestLayout()
+            }
+            place(animate = true)
+        }
+    }
+
+    /**
+     * A card picked up: into the middle of the screen it opens there, onto the close circle it
+     * closes, back on the dock it takes that place in the stack (WIN-4).
+     */
+    private inner class CardDrag(val item: LujarchSmallWindowItem, x: Float, y: Float) :
+        Gesture(x, y) {
+        private val grabX = x - item.x.value
+        private val grabY = y - item.y.value
+        private var overClose = false
+
+        override fun holds(item: LujarchSmallWindowItem) = moved && item === this.item
+
+        override fun onStart() {
+            dismissView.show()
+            item.lift.to(DRAG_LIFT)
+            item.turn.to(0f)
+            updateCompositionOrder()
+        }
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            item.x.snap(x - grabX)
+            item.y.snap(y - grabY)
+            val circle = dismissView.circle
+            val cx = circle.x + dismissView.x + circle.width / 2f
+            val cy = circle.y + dismissView.y + circle.height / 2f
+            val near = hypot(x - cx, y - cy) < dp(CLOSE_RADIUS)
+            if (near != overClose) {
+                overClose = near
+                item.lift.to(if (near) CLOSE_LIFT else DRAG_LIFT)
+                circle.animate().scaleX(if (near) 1.15f else 1f).scaleY(if (near) 1.15f else 1f)
+                    .setDuration(200).start()
+            }
+            clock.start()
+        }
+
+        override fun onUp(vx: Float, vy: Float) {
+            dismissView.hide()
+            val x = item.x.value + grabX
+            val y = item.y.value + grabY
+            val edgeX = if (dockRight) width - dp(EDGE_COLUMN) else dp(EDGE_COLUMN)
+            when {
+                overClose -> close(item)
+                abs(x - edgeX) > dp(INTO_SCREEN) -> {
+                    // Opens where it was let go.
+                    val f = windowFrame(item)
+                    item.winX = x - f.w / 2
+                    item.winY = y - headerHeight
+                    fitWindow(item)
+                    if (folded) folded = false
+                    openItem(item)
+                }
+                else -> {
+                    val slot =
+                        ((y - grabY + dp(CARD_H) / 2 - dockTop - dp(CARD_FROM_HANDLE) -
+                            dp(CARD_H) / 2) / dp(CARD_STEP)).roundToInt()
+                    dock.remove(item)
+                    dock.add(slot.coerceIn(0, dock.size), item)
+                }
+            }
+            gesture = null
+            item.lift.to(1f)
+            place(animate = true, stagger = false)
+        }
+
+        override fun onTap() {
+            if (folded) {
+                folded = false
+                place(animate = true, stagger = true)
+                syncTasks()
+            } else {
+                openItem(item)
+            }
+        }
+    }
+
+    /**
+     * The handle above the top card: up and down along the edge, past the middle to the other
+     * edge, past the screen's edge into the rail (WIN-5, WIN-6).
+     */
+    private inner class DockDrag(x: Float, y: Float) : Gesture(x, y) {
+        private val startTop = dockTop
+        private val startHandleX = handleX.value
+        private var dx = 0f
+        private var dy = 0f
+
+        override fun holds(item: LujarchSmallWindowItem) = moved && item in dock
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            this.dx = dx
+            this.dy = dy
+            handleX.snap(startHandleX + dx)
+            handleY.snap(startTop + dy)
+            dock.forEachIndexed { i, item ->
+                val f = slotFrame(i)
+                item.x.snap(f.x + dx)
+                item.y.snap(f.y - dockTop + startTop + dy)
+            }
+            clock.start()
+        }
+
+        override fun onUp(vx: Float, vy: Float) {
+            val outward = if (dockRight) dx else -dx
+            val centre = dockX() + dx + dp(CARD_W) / 2
+            dockTop = clampDockTop(startTop + dy)
+            if (outward > dp(FOLD_PUSH)) {
+                folded = true
+            } else {
+                dockRight = centre >= width / 2f
+            }
+            saveDock()
+            gesture = null
+            place(animate = true, stagger = true)
+            syncTasks()
+        }
+
+        override fun onTap() {}
+    }
+
+    /** The rail: a tap unfolds the dock, a drag moves it along the edge (WIN-6). */
+    private inner class RailDrag(x: Float, y: Float) : Gesture(x, y) {
+        private val startTop = dockTop
+        private var dy = 0f
+
+        override fun holds(item: LujarchSmallWindowItem) = moved && item in dock
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            this.dy = dy
+            railTop.snap(railTopFor(startTop + dy))
+            dock.forEachIndexed { i, item ->
+                val f = slotFrame(i)
+                item.y.snap(f.y + dy)
+            }
+            clock.start()
+        }
+
+        override fun onUp(vx: Float, vy: Float) {
+            dockTop = clampDockTop(startTop + dy)
+            saveDock()
+            gesture = null
+            place(animate = true)
+        }
+
+        override fun onTap() {
+            folded = false
+            place(animate = true, stagger = true)
+            syncTasks()
+        }
+    }
+
+    private inner class MenuTap(val index: Int, val item: LujarchSmallWindowItem, x: Float,
+        y: Float) : Gesture(x, y) {
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {}
+
+        override fun onUp(vx: Float, vy: Float) {}
+
+        override fun onTap() {
+            when (index) {
+                0 -> fullScreen(item)
+                1 -> moveToDock()
+                else -> close(item)
+            }
+        }
+    }
+
+    private inner class Outside(x: Float, y: Float) : Gesture(x, y) {
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {}
+
+        override fun onUp(vx: Float, vy: Float) {}
+
+        override fun onTap() = hideMenu()
+    }
+
+    private fun saveDock() {
+        dockTopFraction = dockTop / max(1, height)
+        prefs.edit().putBoolean(KEY_RIGHT, dockRight).putFloat(KEY_TOP, dockTopFraction).apply()
+    }
+
+    private fun hit(x: Float, y: Float): Gesture? {
+        menuFor?.let { item ->
+            if (menuRect.contains(x, y)) {
+                val i = ((y - menuRect.top - dp(6f)) / dp(MENU_ITEM_H)).toInt().coerceIn(0, 2)
+                return MenuTap(i, item, x, y)
+            }
+            return Outside(x, y)
+        }
+        open?.let { item ->
+            val f = windowFrame(item)
+            val right = f.x + f.w
+            val bottom = f.y + f.h
+            val e = dp(EDGE_TOUCH)
+            val c = dp(CORNER_TOUCH)
+            if (x in right - c..right + e && y in bottom - c..bottom + e) {
+                return Resize(item, corner = true, right = false, x, y)
+            }
+            if (x in right - e..right + e && y in f.y + dp(EDGE_INSET)..bottom - c) {
+                return Resize(item, corner = false, right = true, x, y)
+            }
+            if (y in bottom - e..bottom + e && x in f.x + dp(EDGE_INSET)..right - c) {
+                return Resize(item, corner = false, right = false, x, y)
+            }
+            if (x in f.x..right && y in f.y..f.y + headerHeight + dp(4f)) {
+                return HeaderDrag(item, x, y)
+            }
+            if (x in f.x..right && y in f.y..bottom) return null
+        }
+        if (!folded) {
+            for (item in dock) {
+                if (itemRect(item).contains(x, y)) return CardDrag(item, x, y)
+            }
+            if (dock.isNotEmpty() && handleRect().contains(x, y)) return DockDrag(x, y)
+        } else if (dock.isNotEmpty() && railRect().contains(x, y)) {
+            return RailDrag(x, y)
+        }
+        return null
+    }
+
+    private fun itemRect(item: LujarchSmallWindowItem): RectF =
+        RectF(item.x.value, item.y.value, item.x.value + item.w.value, item.y.value + item.h.value)
+
+    private fun handleRect(): RectF {
+        val extra = dp(8f)
+        return RectF(handleX.value, handleY.value - extra, handleX.value + dp(HANDLE_W),
+            handleY.value + dp(HANDLE_H))
+    }
+
+    private fun railRect(): RectF {
+        val w = dp(RAIL_W)
+        val left = if (dockRight) width - w else 0f
+        return RectF(left, railTop.value, left + w, railTop.value + railHeight.value)
+    }
+
+    private fun ownRegionContains(x: Float, y: Float): Boolean {
+        if (!folded) {
+            if (dock.any { itemRect(it).contains(x, y) }) return true
+            if (dock.isNotEmpty() && handleRect().contains(x, y)) return true
+        } else if (dock.isNotEmpty() && railRect().contains(x, y)) {
+            return true
+        }
+        return menuFor != null && menuRect.contains(x, y)
+    }
+
+    override fun dispatchTouchEvent(ev: MotionEvent): Boolean {
+        when (ev.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                gesture = hit(ev.x, ev.y)
+                if (gesture == null) return super.dispatchTouchEvent(ev)
+                velocity?.recycle()
+                velocity = VelocityTracker.obtain()
+                velocity?.addMovement(ev)
+                // While a finger holds a shape, the whole screen follows it.
+                requestApplyTouchRegion()
+                clock.start()
+                return true
+            }
+            MotionEvent.ACTION_MOVE -> {
+                velocity?.addMovement(ev)
+                gesture?.move(ev) ?: return super.dispatchTouchEvent(ev)
+                return true
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                val g = gesture ?: return super.dispatchTouchEvent(ev)
+                velocity?.addMovement(ev)
+                velocity?.computeCurrentVelocity(1000)
+                val vx = velocity?.xVelocity ?: 0f
+                val vy = velocity?.yVelocity ?: 0f
+                velocity?.recycle()
+                velocity = null
+                if (ev.actionMasked == MotionEvent.ACTION_CANCEL) {
+                    if (g.moved) g.onCancel()
+                } else if (g.moved) {
+                    g.onUp(vx, vy)
+                } else {
+                    g.onTap()
+                }
+                if (gesture === g) gesture = null
+                requestApplyTouchRegion()
+                place(animate = true)
+                return true
+            }
+        }
+        return gesture != null || super.dispatchTouchEvent(ev)
+    }
+
+    /** The touchable region is computed again on the traversal an invalidation brings. */
+    private fun requestApplyTouchRegion() {
+        invalidate()
+    }
+
+    /** The window takes touches on the handle, the corner, the edges, the cards and the rail. */
+    override fun onComputeInternalInsets(info: ViewTreeObserver.InternalInsetsInfo) {
+        info.setTouchableInsets(ViewTreeObserver.InternalInsetsInfo.TOUCHABLE_INSETS_REGION)
+        val region = info.touchableRegion
+        region.setEmpty()
+        if (visibility != VISIBLE || items.isEmpty() || recentsShown) return
+        if (gesture != null || menuFor != null) {
+            region.set(0, 0, width, height)
+            return
+        }
+        if (!folded) {
+            for (item in dock) region.op(rect(itemRect(item)), Region.Op.UNION)
+            if (dock.isNotEmpty()) region.op(rect(handleRect()), Region.Op.UNION)
+        } else if (dock.isNotEmpty()) {
+            region.op(rect(railRect()), Region.Op.UNION)
+        }
+        open?.let { item ->
+            val f = windowFrame(item)
+            val right = (f.x + f.w).roundToInt()
+            val bottom = (f.y + f.h).roundToInt()
+            val e = dp(EDGE_TOUCH).roundToInt()
+            val c = dp(CORNER_TOUCH).roundToInt()
+            // The app's screen takes its own touches...
+            region.op(f.x.roundToInt(), f.y.roundToInt(), right, bottom, Region.Op.DIFFERENCE)
+            // ...apart from the handle, the corner and the edges.
+            region.op(f.x.roundToInt(), f.y.roundToInt(), right,
+                (f.y + headerHeight).roundToInt() + dp(4f).roundToInt(), Region.Op.UNION)
+            region.op(right - c, bottom - c, right + e, bottom + e, Region.Op.UNION)
+            region.op(right - e, (f.y + dp(EDGE_INSET)).roundToInt(), right + e, bottom - c,
+                Region.Op.UNION)
+            region.op((f.x + dp(EDGE_INSET)).roundToInt(), bottom - e, right - c, bottom + e,
+                Region.Op.UNION)
+        }
+    }
+
+    private fun rect(r: RectF): Rect {
+        r.roundOut(tmpRect)
+        return Rect(tmpRect)
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The input method
+
+    fun setImeVisible(visible: Boolean, imeHeight: Int) {
+        imeTop = if (visible && imeHeight > 0) height - imeHeight else Int.MAX_VALUE
+        place(animate = true)
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Transitions into a small window (BubbleTransitions)
+
+    override fun isExpanded(): Boolean = open != null
+
+    override fun canExpandView(bubble: BubbleViewProvider): Boolean =
+        (bubble as? Bubble)?.bubbleTaskView != null
+
+    override fun prepareConvertedView(bubble: BubbleViewProvider): BubbleViewProvider? {
+        val b = bubble as? Bubble ?: return null
+        val item = items[b.key] ?: return null
+        val prior = open?.bubble?.takeIf { it !== b }
+        if (open !== item) {
+            open?.let { dock.add(0, it) }
+            dock.remove(item)
+            open = item
+            item.view.elevation = dp(WINDOW_Z)
+            updateTouchMonitor()
+        }
+        attachTask(item)
+        return prior
+    }
+
+    override fun animateConvert(
+        startT: SurfaceControl.Transaction,
+        startBounds: Rect,
+        startScale: Float,
+        snapshot: SurfaceControl,
+        taskLeash: SurfaceControl?,
+        animFinish: Runnable,
+    ) {
+        startT.apply()
+        val item = open
+        if (item == null) {
+            removeSnapshot(snapshot)
+            animFinish.run()
+            return
+        }
+        // The app's full screen shrinks into the window: one shape changing its place and size.
+        val scale = startBounds.width() * startScale / max(1, item.layoutW)
+        snapItem(item,
+            Frame(startBounds.left.toFloat(), startBounds.top.toFloat() - headerHeight,
+                startBounds.width() * startScale, startBounds.height() * startScale +
+                headerHeight, 0f, 0f, 1f, 0f), scale)
+        item.alpha.snap(1f)
+        item.lift.snap(1f)
+        item.contentDrawn = true
+        item.content.snap(1f)
+        place(animate = true)
+        postDelayed({ removeSnapshot(snapshot) }, SNAPSHOT_MS)
+        whenAtRest(item) { animFinish.run() }
+    }
+
+    override fun animateExpand(previousBubble: BubbleViewProvider?, animFinish: Runnable?) {
+        val item = open
+        if (item == null) {
+            animFinish?.run()
+            return
+        }
+        place(animate = true, stagger = true)
+        syncTasks()
+        if (animFinish != null) whenAtRest(item) { animFinish.run() }
+    }
+
+    override fun removeViewFromTransition(view: View?) {}
+
+    override fun cancelAnimation(): WindowAnimationState? = null
+
+    private fun removeSnapshot(snapshot: SurfaceControl) {
+        if (!snapshot.isValid) return
+        SurfaceControl.Transaction().remove(snapshot).apply()
+    }
+
+    private fun whenAtRest(item: LujarchSmallWindowItem, action: () -> Unit) {
+        val check =
+            object : Runnable {
+                override fun run() {
+                    if (item.springs.all { it.atRest } || !isAttachedToWindow) action()
+                    else postDelayed(this, 16)
+                }
+            }
+        post(check)
+    }
+
+    /**
+     * Full screen (WIN-2): the task leaves the window, and its surface grows from where the
+     * window shows it to the whole screen along the same spring.
+     */
+    fun animateToFullscreen(
+        bubble: Bubble,
+        change: TransitionInfo.Change,
+        info: TransitionInfo,
+        startT: SurfaceControl.Transaction,
+        onPlucked: Runnable,
+        finish: Runnable,
+    ) {
+        val item = items[bubble.key]
+        val leash = change.leash
+        val root = info.getRoot(0).leash
+        if (item == null || !leash.isValid) {
+            startT.apply()
+            onPlucked.run()
+            finish.run()
+            return
+        }
+        val f = windowFrame(item)
+        val s = item.winScale
+        val end = change.endAbsBounds
+        val offset = info.getRoot(0).offset
+        val x = LujarchSpring(f.x)
+        val y = LujarchSpring(f.y + headerHeight)
+        val scale = LujarchSpring(s)
+        val radius = LujarchSpring(dp(WINDOW_RADIUS))
+        x.to((end.left - offset.x).toFloat())
+        y.to((end.top - offset.y).toFloat())
+        scale.to(end.width().toFloat() / max(1, item.layoutW))
+        radius.to(0f)
+        startT.reparent(leash, root)
+            .setPosition(leash, x.value, y.value)
+            .setMatrix(leash, s, 0f, 0f, s)
+            .setWindowCrop(leash, item.layoutW, item.layoutH)
+            .setCornerRadius(leash, dp(WINDOW_RADIUS) / s)
+            .setAlpha(leash, 1f)
+            .setLayer(leash, Int.MAX_VALUE)
+            .show(leash)
+            .apply()
+        item.view.visibility = INVISIBLE
+        onPlucked.run()
+        val springs = arrayOf(x, y, scale, radius)
+        if (!LujarchSpring.animated()) springs.forEach { it.snap(it.target.toFloat()) }
+        val t = SurfaceControl.Transaction()
+        LujarchFrameClock { ms ->
+            springs.forEach { it.step(ms, 0.002) }
+            if (!leash.isValid) {
+                finish.run()
+                return@LujarchFrameClock false
+            }
+            val k = scale.value
+            t.setPosition(leash, x.value, y.value)
+                .setMatrix(leash, k, 0f, 0f, k)
+                .setWindowCrop(leash, end.width(), end.height())
+                .setCornerRadius(leash, radius.value / max(k, 0.01f))
+                .apply()
+            val moving = springs.any { !it.atRest }
+            if (!moving) {
+                t.setMatrix(leash, 1f, 0f, 0f, 1f).setCornerRadius(leash, 0f).apply()
+                finish.run()
+            }
+            moving
+        }.start()
+    }
+
+    fun dump(pw: java.io.PrintWriter, prefix: String) {
+        pw.println("${prefix}LujarchSmallWindows:")
+        pw.println("$prefix  open=${open?.bubble?.key} folded=$folded right=$dockRight " +
+            "top=$dockTop limit=${settings.maxWindows} live=${settings.livePreviews}")
+        for (item in items.values) {
+            pw.println("$prefix  ${item.bubble.key} dock=${dock.indexOf(item)} " +
+                "frame=${item.x.value.roundToInt()},${item.y.value.roundToInt()} " +
+                "${item.w.value.roundToInt()}x${item.h.value.roundToInt()} " +
+                "layout=${item.layoutW}x${item.layoutH} scale=${item.winScale} " +
+                "task=${item.taskView?.taskInfo?.taskId} drawn=${item.contentDrawn} " +
+                "unread=${item.unread} counts=${item.counts}")
+        }
+    }
+
+    companion object {
+        private const val TAG = "lujarch_windows"
+        private const val PREFS = "lujarch_small_windows"
+        private const val KEY_RIGHT = "dock_right"
+        private const val KEY_TOP = "dock_top"
+
+        // dp, from the design of target/windows.md
+        const val CARD_W = 108f
+        const val CARD_H = 150f
+        const val CARD_RADIUS = 20f
+        const val CARD_STEP = 142f
+        const val CARD_FROM_HANDLE = 30f
+        const val DOCK_MARGIN = 10f
+        const val DOCK_TOP = 200f
+        const val HANDLE_W = 56f
+        const val HANDLE_H = 26f
+        const val HEADER = 22f
+        const val WINDOW_RADIUS = 22f
+        const val WINDOW_W = 258f
+        const val WINDOW_X = 12f
+        const val WINDOW_Y = 124f
+        const val MIN_W = 160f
+        const val MIN_H = 120f
+        const val MARGIN = 12f
+        const val OVERSHOOT = 30f
+        const val RAIL_W = 34f
+        const val RAIL_ICON = 22f
+        const val RAIL_STEP = 32f
+        const val RAIL_PAD = 16f
+        const val RAIL_FROM_HANDLE = 20f
+        const val FOLD_PUSH = 40f
+        const val EDGE_COLUMN = 118f
+        const val INTO_SCREEN = 120f
+        const val CLOSE_RADIUS = 60f
+        const val EDGE_TOUCH = 10f
+        const val EDGE_INSET = 40f
+        const val CORNER_TOUCH = 32f
+        const val GESTURE_AREA = 24f
+        const val MENU_W = 176f
+        const val MENU_ITEM_H = 48f
+        const val CARD_Z = 8f
+        const val WINDOW_Z = 16f
+        const val DISMISS_Z = 20f
+        const val DRAG_Z = 24f
+        const val DRAG_LIFT = 1.06f
+        const val CLOSE_LIFT = 0.82f
+        const val OUTLINE_ALPHA = 0.85f
+        const val SNAPSHOT_MS = 150L
+        const val RECENTS_TILE_H = 104f
+        const val RECENTS_GAP = 10f
+        const val RECENTS_TOP = 16f
+        /** A card's turn of 16 degrees, as the width a turned card shows. */
+        const val TURN_SCALE = 0.92f
+    }
+}
