+    /**
+     * Whether the app takes the touches on its screen: only in the open window; a card's or a
+     * slot's touches are the dock's or Recents', and the app's screen hides nothing below.
+     */
+    var touchable: Boolean? = null
+    var lastUsed = 0L
+    /** Where its Recents card was, while it converts into its window (WIN-11). */
+    var fromCard: Rect? = null
+    /** Growing into the full screen: it has left the dock and its window (WIN-2). */
+    var toFullScreen = false
+    var leaving = false
+
+    /**
+     * Its name: a conversation's as its app names it (the shortcut), which a rebuilt notification's
+     * title may put after the sender; else the app's.
+     */
+    val name: CharSequence?
+        get() = (if (isConversation) bubble.shortcutInfo?.shortLabel ?: bubble.title else null)
+            ?: bubble.appName
+
+    val isConversation: Boolean
+        get() = bubble.isChat
+
+    val counts: Boolean
+        get() = !bubble.isChat || opened
+}
+
+/** Draws one [LujarchSmallWindowItem] around its task view, as its springs place it. */
+@SuppressLint("ViewConstructor")
+class LujarchSmallWindowItemView(
+    context: Context,
+    private val host: LujarchSmallWindowsView,
+    private val item: LujarchSmallWindowItem,
+) : FrameLayout(context) {
+    private val density = resources.displayMetrics.density
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val stroke = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
+    private val shade = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val namePaint = TextPaint(Paint.ANTI_ALIAS_FLAG)
+    private val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG)
+    private val countPaint = TextPaint(Paint.ANTI_ALIAS_FLAG)
+    private val rect = RectF()
+    private val path = Path()
+    private val clip = Rect()
+    private var appIcon: Drawable? = null
+    private var avatar: Drawable? = null
+    private var textLayout: StaticLayout? = null
+    private var textLayoutWidth = 0
+    private var shownRadius = -1f
+    private val lastClip = Rect()
+    private var screenX = 0f
+    private var screenY = 0f
+    private var screenRadius = 0f
+
+    init {
+        setWillNotDraw(false)
+        clipChildren = false
+        clipToPadding = false
+        outlineProvider =
+            object : ViewOutlineProvider() {
+                override fun getOutline(view: View, outline: Outline) {
+                    val top = (host.headerHeight * item.window.value).roundToInt()
+                    outline.setRoundRect(0, top, view.width, view.height, item.radius.value)
+                    outline.alpha = item.alpha.value
+                }
+            }
+        loadResources()
+        countPaint.textSize = 11.5f * density
+        countPaint.isFakeBoldText = true
+        countPaint.textAlign = Paint.Align.CENTER
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_YES
+    }
+
+    /** Text sizes that follow the font size. */
+    fun loadResources() {
+        namePaint.textSize = 12.5f * density * resources.configuration.fontScale
+        textPaint.textSize = 11f * density * resources.configuration.fontScale
+        textLayout = null
+        invalidate()
+    }
+
+    /** Takes the bubble's icon, picture, name and last message. */
+    fun bind() {
+        val b = item.bubble
+        appIcon = b.appBadge?.newIcon(context) ?: (b.bubbleIcon as? BubbleIcon.AppIcon)
+            ?.bitmapInfo?.newIcon(context)
+        avatar =
+            when (val icon = b.bubbleIcon) {
+                is BubbleIcon.Custom -> android.graphics.drawable.BitmapDrawable(resources, icon.bitmap)
+                is BubbleIcon.AppIcon -> icon.bitmapInfo.newIcon(context)
+                null -> null
+            }
+        if (b.isChat) {
+            b.flyoutMessage?.senderAvatar?.let { avatar = it }
+        }
+        textLayout = null
+        contentDescription = item.name
+        invalidate()
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        setMeasuredDimension(
+            MeasureSpec.getSize(widthMeasureSpec),
+            MeasureSpec.getSize(heightMeasureSpec),
+        )
+        item.taskView?.measure(
+            MeasureSpec.makeMeasureSpec(item.taskW, MeasureSpec.EXACTLY),
+            MeasureSpec.makeMeasureSpec(item.taskH, MeasureSpec.EXACTLY),
+        )
+    }
+
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        item.taskView?.layout(0, 0, item.taskW, item.taskH)
+    }
+
+    /** Applies the springs' values: the shape's turn, the task's scale, place, crop, corners. */
+    fun apply(header: Float) {
+        val w = width.toFloat()
+        val h = height.toFloat()
+        val turn = item.turn.value
+        val turnScale = 1f - (1f - LujarchSmallWindowsView.TURN_SCALE) * kotlin.math.abs(turn)
+        val lift = item.lift.value
+        pivotX = if (turn > 0.01f) w else if (turn < -0.01f) 0f else w / 2f
+        pivotY = h / 2f
+        scaleX = turnScale * lift
+        scaleY = lift
+        alpha = item.alpha.value
+        invalidateOutline()
+        val tv = item.taskView ?: run {
+            invalidate()
+            return
+        }
+        val s = max(item.scale.value, 0.01f)
+        val top = header * item.window.value
+        placeScreen(w, h, top, s)
+        tv.pivotX = 0f
+        tv.pivotY = 0f
+        tv.scaleX = s
+        tv.scaleY = s
+        tv.translationX = screenX
+        tv.translationY = top + screenY
+        tv.alpha = item.content.value * (1f - item.icon.value)
+        if (clip != lastClip) {
+            lastClip.set(clip)
+            tv.setClipBounds(Rect(clip))
+        }
+        val r = screenRadius / s
+        val sc = tv.surfaceControl?.takeIf { it.isValid }
+        if (sc != null && kotlin.math.abs(r - shownRadius) > 0.5f) {
+            shownRadius = r
+            tv.setCornerRadius(r)
+            // A SurfaceView hands its radius to the surface only when it updates the surface for
+            // another reason; without this the task keeps the corners it was created with. The
+            // task view draws no frames of its own: the corners go with the window's next one.
+            val t = SurfaceControl.Transaction().setCornerRadius(sc, r)
+            tv.rootSurfaceControl?.applyTransactionOnDraw(t) ?: t.apply()
+        }
+        invalidate()
+    }
+
+    /**
+     * Places the app's screen in a shape of [w] by [h] whose screen starts [top] down, at the
+     * scale [s]: filling a window, centred on a card or in a slot of Recents (WIN-4). Sets
+     * [screenX], [screenY], the part of it shown ([clip]) and its corners.
+     */
+    private fun placeScreen(w: Float, h: Float, top: Float, s: Float) {
+        val spareW = w - item.taskW * s
+        val spareH = h - top - item.taskH * s
+        val centred = 1f - item.window.value
+        screenX = if (item.anchorRight) spareW else spareW / 2 * centred
+        screenY = if (item.anchorBottom) spareH else spareH / 2 * centred
+        val l = floor(-screenX / s).toInt().coerceIn(0, max(0, item.taskW - 1))
+        val t = floor(-screenY / s).toInt().coerceIn(0, max(0, item.taskH - 1))
+        val r = ceil((w - screenX) / s).toInt().coerceIn(l + 1, max(l + 1, item.taskW))
+        val b = ceil((h - top - screenY) / s).toInt().coerceIn(t + 1, max(t + 1, item.taskH))
+        clip.set(l, t, r, b)
+        val onCard = LujarchSmallWindowsView.CARD_SCREEN_RADIUS * density *
+            min(1f, h / (LujarchSmallWindowsView.CARD_H * density))
+        screenRadius = onCard + (item.radius.value - onCard) * item.window.value
+    }
+
+    /**
+     * Where the app's screen shows now, in the small windows' window: its left and top, its
+     * scale across and down (a card's turn and lift included), the width and height of the part
+     * shown, in the app's pixels, and its corner radius on the screen.
+     */
+    fun screenPlace(header: Float): FloatArray {
+        val w = width.toFloat()
+        val h = height.toFloat()
+        val s = max(item.scale.value, 0.01f)
+        val top = header * item.window.value
+        placeScreen(w, h, top, s)
+        val sx = scaleX
+        val sy = scaleY
+        return floatArrayOf(
+            left + pivotX + (screenX - pivotX) * sx,
+            this.top + pivotY + (top + screenY - pivotY) * sy,
+            s * sx,
+            s * sy,
+            clip.width().toFloat(),
+            clip.height().toFloat(),
+            screenRadius * min(sx, sy),
+        )
+    }
+
+    fun onTaskViewChanged() {
+        shownRadius = -1f
+        lastClip.setEmpty()
+    }
+
+    override fun dispatchDraw(canvas: Canvas) {
+        val w = width.toFloat()
+        val h = height.toFloat()
+        if (w <= 0f || h <= 0f) return
+        val radius = item.radius.value
+        val window = item.window.value
+        val icon = item.icon.value
+        // The body under the app's screen; a window's handle floats above it, over what is below.
+        rect.set(0f, host.headerHeight * window, w, h)
+        fill.color = blend(host.cardColor(item), host.windowColor, window)
+        canvas.drawRoundRect(rect, radius, radius, fill)
+        super.dispatchDraw(canvas)
+        val cardness = (1f - window) * (1f - icon)
+        val content = item.content.value * (1f - icon)
+        if (item.isConversation) {
+            drawConversation(canvas, w, h, (1f - window) * (1f - icon) + 0f)
+        } else if (content < 1f) {
+            drawAppPlaceholder(canvas, w, h, (1f - content) * (1f - icon))
+        }
+        if (icon > 0f) drawRailIcon(canvas, w, h, icon)
+        if (cardness > 0f && !item.isConversation && content > 0f) {
+            drawBadge(canvas, h, cardness * content)
+        }
+        if (item.turn.value != 0f) {
+            drawShade(canvas, w, h, kotlin.math.abs(item.turn.value) * cardness,
+                item.turn.value > 0f)
+        }
+        if (cardness > 0f) drawRim(canvas, w, h, cardness)
+        if (window > 0f) drawChrome(canvas, w, h, window)
+    }
+
+    /** A card's edge, so that a card reads as lying on the one it covers. */
+    private fun drawRim(canvas: Canvas, w: Float, h: Float, a: Float) {
+        stroke.strokeWidth = density
+        stroke.strokeCap = Paint.Cap.BUTT
+        stroke.color = withAlpha(host.rimColor, a)
+        val o = stroke.strokeWidth / 2
+        rect.set(o, o, w - o, h - o)
+        canvas.drawRoundRect(rect, item.radius.value - o, item.radius.value - o, stroke)
+    }
+
+    private fun drawAppPlaceholder(canvas: Canvas, w: Float, h: Float, a: Float) {
+        if (a <= 0f) return
+        val icon = appIcon ?: return
+        val size = min(48f * density, min(w, h) * 0.5f)
+        val name = item.bubble.appName ?: ""
+        val cx = w / 2f
+        val cy = h / 2f - if (name.isNotEmpty()) 10f * density else 0f
+        icon.setBounds(
+            (cx - size / 2).roundToInt(),
+            (cy - size / 2).roundToInt(),
+            (cx + size / 2).roundToInt(),
+            (cy + size / 2).roundToInt(),
+        )
+        icon.alpha = (a * 255).roundToInt()
+        icon.draw(canvas)
+        icon.alpha = 255
+        if (name.isNotEmpty() && h > 80f * density) {
+            namePaint.color = withAlpha(host.cardTextColor, a)
+            namePaint.textAlign = Paint.Align.CENTER
+            val label =
+                TextUtils.ellipsize(name, namePaint, w - 16f * density, TextUtils.TruncateAt.END)
+            canvas.drawText(label, 0, label.length, cx, cy + size / 2 + 18f * density, namePaint)
+        }
+    }
+
+    private fun drawBadge(canvas: Canvas, h: Float, a: Float) {
+        val icon = appIcon ?: return
+        // The badge keeps its place on the card as the card shrinks into a slot in Recents.
+        val k = min(1f, width / (LujarchSmallWindowsView.CARD_W * density))
+        val size = 22f * density * k
+        val margin = 8f * density * k
+        // In the lower corner towards the middle of the screen.
+        val left = if (item.turn.value >= 0f) margin else width - margin - size
+        val top = h - margin - size
+        fill.color = withAlpha(Color.WHITE, a * 0.9f)
+        canvas.drawCircle(left + size / 2, top + size / 2, size / 2 + 2f * density * k, fill)
+        icon.setBounds(left.roundToInt(), top.roundToInt(), (left + size).roundToInt(),
+            (top + size).roundToInt())
+        icon.alpha = (a * 255).roundToInt()
+        icon.draw(canvas)
+        icon.alpha = 255
+    }
+
+    private fun drawConversation(canvas: Canvas, w: Float, h: Float, a: Float) {
+        if (a <= 0.01f) return
+        val size = min(52f * density, w * 0.5f)
+        val cx = w / 2f
+        val message = item.lastMessage
+        val name = item.name ?: ""
+        val textBlock = 16f * density + if (message.isNullOrEmpty()) 0f else 34f * density
+        // Centered in what the card above leaves visible, so that the count is never under it.
+        val covered = host.coveredTop(item)
+        val top = covered + (h - covered - size - 8f * density - textBlock) / 2f
+        drawAvatar(canvas, cx, top + size / 2, size, a)
+        if (item.unread > 0) {
+            // The unread count at the picture's upper outer corner.
+            val r = 10f * density
+            val bx = cx + size / 2 + 4f * density - r
+            val by = top - 4f * density + r
+            fill.color = withAlpha(host.accentColor, a)
+            canvas.drawCircle(bx, by, r, fill)
+            countPaint.color = withAlpha(host.onAccentColor, a)
+            val count = if (item.unread > 99) "99+" else item.unread.toString()
+            canvas.drawText(count, bx, by + countPaint.textSize * 0.36f, countPaint)
+        }
+        namePaint.color = withAlpha(host.conversationTextColor, a)
+        namePaint.textAlign = Paint.Align.CENTER
+        val nameText =
+            TextUtils.ellipsize(name, namePaint, w - 16f * density, TextUtils.TruncateAt.END)
+        val nameY = top + size + 8f * density + namePaint.textSize
+        canvas.drawText(nameText, 0, nameText.length, cx, nameY, namePaint)
+        if (!message.isNullOrEmpty()) {
+            val width = (w - 20f * density).roundToInt().coerceAtLeast(1)
+            if (textLayout == null || textLayoutWidth != width) {
+                textLayoutWidth = width
+                textLayout =
+                    StaticLayout.Builder.obtain(message, 0, message.length, textPaint, width)
+                        .setAlignment(Layout.Alignment.ALIGN_CENTER)
+                        .setMaxLines(2)
+                        .setEllipsize(TextUtils.TruncateAt.END)
+                        .build()
+            }
+            textPaint.color = withAlpha(host.conversationSubTextColor, a)
+            canvas.save()
+            canvas.translate((w - width) / 2f, nameY + 6f * density)
+            textLayout?.draw(canvas)
+            canvas.restore()
+        }
+    }
+
+    private fun drawAvatar(canvas: Canvas, cx: Float, cy: Float, size: Float, a: Float) {
+        val d = avatar ?: appIcon ?: return
+        canvas.save()
+        path.reset()
+        path.addCircle(cx, cy, size / 2, Path.Direction.CW)
+        canvas.clipPath(path)
+        d.setBounds((cx - size / 2).roundToInt(), (cy - size / 2).roundToInt(),
+            (cx + size / 2).roundToInt(), (cy + size / 2).roundToInt())
+        d.alpha = (a * 255).roundToInt()
+        d.draw(canvas)
+        d.alpha = 255
+        canvas.restore()
+    }
+
+    private fun drawRailIcon(canvas: Canvas, w: Float, h: Float, a: Float) {
+        val size = min(w, h)
+        val cx = w / 2f
+        val cy = h / 2f
+        if (item.isConversation) {
+            drawAvatar(canvas, cx, cy, size, a)
+            stroke.strokeWidth = (if (item.unread > 0) 2f else 1.5f) * density
+            stroke.color =
+                if (item.unread > 0) withAlpha(host.accentColor, a)
+                else withAlpha(Color.WHITE, a * 0.7f)
+            canvas.drawCircle(cx, cy, size / 2 + stroke.strokeWidth / 2, stroke)
+            if (item.unread > 0) {
+                stroke.strokeWidth = 3f * density
+                stroke.color = withAlpha(host.accentColor, a * 0.25f)
+                canvas.drawCircle(cx, cy, size / 2 + 3.5f * density, stroke)
+            }
+        } else {
+            val d = appIcon ?: return
+            d.setBounds(0, 0, size.roundToInt(), size.roundToInt())
+            d.alpha = (a * 255).roundToInt()
+            d.draw(canvas)
+            d.alpha = 255
+            stroke.strokeWidth = 1.5f * density
+            stroke.color = withAlpha(Color.WHITE, a * 0.7f)
+            canvas.drawCircle(cx, cy, size / 2 + 0.75f * density, stroke)
+        }
+    }
+
+    private fun drawShade(canvas: Canvas, w: Float, h: Float, a: Float, right: Boolean) {
+        if (a <= 0.01f) return
+        // The side turned away from the viewer is the one towards the middle of the screen.
+        val far = if (right) 0f else w
+        val near = if (right) w else 0f
+        shade.shader =
+            LinearGradient(far, 0f, near, 0f, Color.argb((46 * a).roundToInt(), 0, 0, 0),
+                Color.TRANSPARENT, Shader.TileMode.CLAMP)
+        canvas.drawRoundRect(rect, item.radius.value, item.radius.value, shade)
+    }
+
+    private fun drawChrome(canvas: Canvas, w: Float, h: Float, a: Float) {
+        val header = host.headerHeight * a
+        // The handle along the top edge, as the dock's.
+        host.drawHandlePill(canvas, w / 2, header / 2, a)
+        // The thin outline, whose every edge and corner resizes the window.
+        stroke.strokeWidth = 1.5f * density
+        stroke.strokeCap = Paint.Cap.BUTT
+        stroke.color = withAlpha(host.accentColor, a * host.outlineAlpha)
+        val o = stroke.strokeWidth / 2
+        rect.set(-o, header - o, w + o, h + o)
+        canvas.drawRoundRect(rect, item.radius.value + o, item.radius.value + o, stroke)
+    }
+
+    private fun withAlpha(color: Int, a: Float): Int =
+        Color.argb((Color.alpha(color) * a.coerceIn(0f, 1f)).roundToInt(), Color.red(color),
+            Color.green(color), Color.blue(color))
+
+    private fun blend(from: Int, to: Int, t: Float): Int {
+        val k = t.coerceIn(0f, 1f)
+        return Color.argb(
+            (Color.alpha(from) + (Color.alpha(to) - Color.alpha(from)) * k).roundToInt(),
+            (Color.red(from) + (Color.red(to) - Color.red(from)) * k).roundToInt(),
+            (Color.green(from) + (Color.green(to) - Color.green(from)) * k).roundToInt(),
+            (Color.blue(from) + (Color.blue(to) - Color.blue(from)) * k).roundToInt(),
+        )
+    }
+}
