+
+package com.android.wm.shell.bubbles
+
+import android.animation.ValueAnimator
+import android.view.Choreographer
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.exp
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+/**
+ * The one spring of WIN-9: damping ratio 0.8, natural frequency 16 rad/s, unit mass. It overshoots
+ * by about 1.5 % and settles in about half a second. Stepped in closed form by the gap between
+ * frame times, so it follows the same path at any frame rate.
+ */
+class LujarchSpring(value: Float = 0f) {
+    var pos = value.toDouble()
+        private set
+    var vel = 0.0
+        private set
+    var target = value.toDouble()
+        private set
+
+    val value: Float
+        get() = pos.toFloat()
+
+    val atRest: Boolean
+        get() = pos == target && vel == 0.0
+
+    /** Moves the target; a velocity, when given, replaces the current one (a fling). */
+    fun to(value: Float, velocity: Float = Float.NaN) {
+        target = value.toDouble()
+        if (!velocity.isNaN()) vel = velocity.toDouble()
+    }
+
+    /** Puts the spring at rest at [value]: what a finger holding the thing does. */
+    fun snap(value: Float) {
+        pos = value.toDouble()
+        target = pos
+        vel = 0.0
+    }
+
+    /** Advances by [ms] milliseconds; [threshold] is the distance that counts as there. */
+    fun step(ms: Long, threshold: Double) {
+        if (atRest) return
+        val t = ms / 1000.0
+        val x0 = pos - target
+        val wd = W0 * sqrt(1 - Z * Z)
+        val sc = (Z * W0 * x0 + vel) / wd
+        val e = exp(-Z * W0 * t)
+        val x = e * (x0 * cos(wd * t) + sc * sin(wd * t))
+        val v = x * -W0 * Z + e * (-wd * x0 * sin(wd * t) + wd * sc * cos(wd * t))
+        pos = x + target
+        vel = v
+        if (abs(x) < threshold && abs(v) < threshold * 20) {
+            pos = target
+            vel = 0.0
+        }
+    }
+
+    companion object {
+        const val Z = 0.8
+        const val W0 = 16.0
+        /** Cards moving together start one after another at this interval. */
+        const val STAGGER_MS = 35L
+
+        /** Whether motion plays: off with Settings > Accessibility > Remove animations. */
+        @JvmStatic
+        fun animated(): Boolean = ValueAnimator.areAnimatorsEnabled()
+    }
+}
+
+/**
+ * Where a moving thing was over its last moments, frame by frame, so that what trails it can be
+ * placed where it was a while ago. [at] sets [x] and [y].
+ */
+class LujarchTrail {
+    private val times = LongArray(SIZE)
+    private val xs = FloatArray(SIZE)
+    private val ys = FloatArray(SIZE)
+    private var count = 0
+    private var head = 0
+    var x = 0f
+        private set
+    var y = 0f
+        private set
+
+    fun clear() {
+        count = 0
+        head = 0
+    }
+
+    fun add(time: Long, x: Float, y: Float) {
+        head = (head + 1) % SIZE
+        times[head] = time
+        xs[head] = x
+        ys[head] = y
+        if (count < SIZE) count++
+    }
+
+    /** Where it was at [time]: between the frames around it, or at the oldest one kept. */
+    fun at(time: Long) {
+        if (count == 0) return
+        var i = head
+        for (n in 0 until count) {
+            if (times[i] <= time) {
+                val newer = (i + 1) % SIZE
+                if (i == head || times[newer] == times[i]) {
+                    x = xs[i]
+                    y = ys[i]
+                } else {
+                    val k = (time - times[i]).toFloat() / (times[newer] - times[i])
+                    x = xs[i] + (xs[newer] - xs[i]) * k
+                    y = ys[i] + (ys[newer] - ys[i]) * k
+                }
+                return
+            }
+            if (n < count - 1) i = (i - 1 + SIZE) % SIZE
+        }
+        x = xs[i]
+        y = ys[i]
+    }
+
+    private companion object {
+        /** About a second of frames: more than the last card trails by. */
+        const val SIZE = 128
+    }
+}
+
+/**
+ * Drives every spring of the small windows from one frame callback, so that what moves together
+ * is placed in the same frame. [onFrame] steps the springs and places the views; it returns
+ * whether anything still moves.
+ */
+class LujarchFrameClock(private val onFrame: (Long) -> Boolean) : Choreographer.FrameCallback {
+    private val choreographer = Choreographer.getInstance()
+    private var lastNanos = 0L
+    private var posted = false
+
+    fun start() {
+        if (posted) return
+        posted = true
+        lastNanos = 0L
+        choreographer.postFrameCallback(this)
+    }
+
+    override fun doFrame(frameTimeNanos: Long) {
+        posted = false
+        val ms = if (lastNanos == 0L) 0L else (frameTimeNanos - lastNanos) / 1_000_000L
+        lastNanos = frameTimeNanos
+        if (onFrame(ms.coerceIn(0L, 64L))) {
+            posted = true
+            choreographer.postFrameCallback(this)
+        }
+    }
+}
