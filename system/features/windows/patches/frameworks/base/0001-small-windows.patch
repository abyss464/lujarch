+package com.android.systemui.statusbar.notification.lujarch.smallwindow;
+
+import android.animation.Animator;
+import android.animation.AnimatorListenerAdapter;
+import android.animation.ValueAnimator;
+import android.util.Log;
+import android.view.HapticFeedbackConstants;
+import android.view.MotionEvent;
+import android.view.ViewParent;
+import android.view.animation.Interpolator;
+import android.view.animation.PathInterpolator;
+
+import androidx.annotation.Nullable;
+
+import com.android.systemui.statusbar.notification.row.ExpandableNotificationRow;
+import com.android.systemui.statusbar.notification.stack.NotificationStackScrollLayout;
+import com.android.systemui.statusbar.notification.stack.ViewState;
+
+/**
+ * Pulling a heads-up down (target/windows.md, WIN-12): the heads-up follows the finger; past
+ * 48 dp the hint "Release to open in a small window" shows under it (with a threshold haptic);
+ * released there, the heads-up fades where it is while what a tap on it would open opens in a
+ * small window; released before it, the heads-up settles back. Pushing it up stays Android's
+ * gesture.
+ *
+ * <p>The heads-up's own touch helper hands the gesture over once it is a downward drag past the
+ * touch slop, in place of expanding the shade from it. The row is moved by its translation, which
+ * the notification stack sets again on its next layout, so the pull leaves nothing behind.
+ */
+public final class HeadsUpSmallWindowPull {
+    private static final String TAG = LujarchSmallWindowsNotifications.TAG;
+
+    /** How far the heads-up is pulled before letting go opens the small window. */
+    private static final float THRESHOLD_DP = 48f;
+    /** Past the threshold the heads-up follows with resistance, up to this much further. */
+    private static final float OVERPULL_DP = 80f;
+    private static final float OVERPULL_FACTOR = 0.4f;
+    private static final float HINT_GAP_DP = 16f;
+
+    private static final Interpolator EMPHASIZED_DECELERATE =
+            new PathInterpolator(0.05f, 0.7f, 0.1f, 1f);
+    private static final Interpolator EMPHASIZED_ACCELERATE =
+            new PathInterpolator(0.3f, 0f, 0.8f, 0.15f);
+    private static final long SETTLE_MS = 350;
+    private static final long HINT_IN_MS = 200;
+    private static final long FADE_MS = 150;
+
+    private final LujarchSmallWindowsNotifications mHost;
+
+    private boolean mActive;
+    /** The heads-up stopped being one during the pull: the rest of the gesture does nothing. */
+    private boolean mAbandoned;
+    /** The row the finger picked (a group's child, or a notification on its own). */
+    @Nullable private ExpandableNotificationRow mPicked;
+    /** The row the stack places, which is moved. */
+    @Nullable private ExpandableNotificationRow mRow;
+    @Nullable private NotificationStackScrollLayout mStack;
+    @Nullable private SmallWindowPullHint mHint;
+    @Nullable private String mKey;
+    private int mPointerId;
+    private float mStartY;
+    private float mBaseY;
+    private float mOffset;
+    private boolean mPast;
+    @Nullable private ValueAnimator mSettle;
+    @Nullable private ValueAnimator mHintAnimator;
+
+    HeadsUpSmallWindowPull(LujarchSmallWindowsNotifications host) {
+        mHost = host;
+    }
+
+    public boolean isActive() {
+        return mActive;
+    }
+
+    /**
+     * Starts the pull of {@code picked} from {@code y} (the touch's coordinates) when it is a
+     * pinned heads-up that may open in a small window; false leaves the gesture to the shade.
+     */
+    public boolean start(@Nullable ExpandableNotificationRow picked, float y, int pointerId) {
+        if (picked == null || mActive || !picked.isPinned()) return false;
+        final ExpandableNotificationRow row = picked.getNotificationParent() != null
+                ? picked.getNotificationParent() : picked;
+        final ViewParent parent = row.getParent();
+        if (!(parent instanceof NotificationStackScrollLayout stack)) return false;
+        // A heads-up still sliding in is placed by its own animation: leave it to the shade.
+        if (ViewState.isAnimatingY(row)) return false;
+        final String key = picked.getKey();
+        if (!mHost.canOpen(key)) return false;
+        finishPrevious();
+        mActive = true;
+        mAbandoned = false;
+        mPicked = picked;
+        mRow = row;
+        mStack = stack;
+        mKey = key;
+        mPointerId = pointerId;
+        mStartY = y;
+        mBaseY = row.getTranslationY();
+        mOffset = 0f;
+        mPast = false;
+        mHint = new SmallWindowPullHint(stack.getContext());
+        stack.getOverlay().add(mHint);
+        placeHint();
+        Log.d(TAG, "Pulling " + key + " toward a small window");
+        return true;
+    }
+
+    /** The rest of the gesture once it is a pull; true while it consumes the events. */
+    public boolean onTouchEvent(MotionEvent event) {
+        if (!mActive) return false;
+        int index = event.findPointerIndex(mPointerId);
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_POINTER_UP: {
+                if (event.getPointerId(event.getActionIndex()) == mPointerId) {
+                    // Another finger carries on from where this one left the heads-up.
+                    final int next = event.getActionIndex() == 0 ? 1 : 0;
+                    if (next < event.getPointerCount()) {
+                        final float y = event.getY(next);
+                        mStartY = y - pulledDistance();
+                        mPointerId = event.getPointerId(next);
+                    }
+                }
+                break;
+            }
+            case MotionEvent.ACTION_MOVE:
+                if (index < 0) index = 0;
+                move(event.getY(index));
+                break;
+            case MotionEvent.ACTION_UP:
+                release();
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                settle();
+                break;
+            default:
+                break;
+        }
+        return true;
+    }
+
+    private float px(float dp) {
+        return mRow != null ? dp * mRow.getResources().getDisplayMetrics().density : dp;
+    }
+
+    /** The finger's travel that gives the current offset (the inverse of the resistance). */
+    private float pulledDistance() {
+        final float threshold = px(THRESHOLD_DP);
+        return mOffset <= threshold ? mOffset : threshold + (mOffset - threshold) / OVERPULL_FACTOR;
+    }
+
+    private void move(float y) {
+        if (mAbandoned) return;
+        final float dy = Math.max(0f, y - mStartY);
+        final float threshold = px(THRESHOLD_DP);
+        final float offset = dy <= threshold ? dy
+                : threshold + Math.min((dy - threshold) * OVERPULL_FACTOR, px(OVERPULL_DP));
+        apply(offset);
+        final boolean past = dy >= threshold;
+        if (past != mPast && !mAbandoned) {
+            mPast = past;
+            if (mRow != null) {
+                mRow.performHapticFeedback(past
+                        ? HapticFeedbackConstants.GESTURE_THRESHOLD_ACTIVATE
+                        : HapticFeedbackConstants.GESTURE_THRESHOLD_DEACTIVATE);
+            }
+            animateHint(past);
+        }
+    }
+
+    private boolean stillHeadsUp() {
+        return mRow != null && mPicked != null && mRow.isAttachedToWindow()
+                && mPicked.isPinned();
+    }
+
+    private void apply(float offset) {
+        mOffset = offset;
+        if (!stillHeadsUp()) {
+            // Timed out or replaced under the finger: the stack animates it; let it.
+            Log.d(TAG, "Heads-up " + mKey + " left during the pull");
+            mAbandoned = true;
+            animateHint(false);
+            return;
+        }
+        mRow.setTranslationY(mBaseY + offset);
+        placeHint();
+    }
+
+    private void placeHint() {
+        if (mHint == null || mRow == null || mStack == null) return;
+        final float bottom = mRow.getTop() + mRow.getTranslationY() + mRow.getActualHeight()
+                - mRow.getClipBottomAmount();
+        mHint.setAnchor(mStack.getWidth() / 2f, bottom + px(HINT_GAP_DP), mStack.getWidth());
+    }
+
+    private void animateHint(boolean show) {
+        final SmallWindowPullHint hint = mHint;
+        if (hint == null) return;
+        if (mHintAnimator != null) mHintAnimator.cancel();
+        final ValueAnimator animator = ValueAnimator.ofFloat(hint.getShown(), show ? 1f : 0f);
+        animator.setDuration(show ? HINT_IN_MS : FADE_MS);
+        animator.setInterpolator(show ? EMPHASIZED_DECELERATE : EMPHASIZED_ACCELERATE);
+        animator.addUpdateListener(a -> hint.setShown((float) a.getAnimatedValue()));
+        animator.start();
+        mHintAnimator = animator;
+    }
+
+    private void release() {
+        if (!mActive) return;
+        if (mAbandoned) {
+            finish();
+            return;
+        }
+        if (mPast && mHost.openFromHeadsUp(mKey)) {
+            leave();
+        } else {
+            settle();
+        }
+    }
+
+    /**
+     * Released past the threshold: the heads-up fades where it is while the small window opens,
+     * then leaves the heads-up slot without an exit of its own; the stack gives the row its place
+     * and opacity back when it next lays it out.
+     */
+    private void leave() {
+        mActive = false;
+        animateHint(false);
+        final ExpandableNotificationRow row = mRow;
+        final String key = mKey;
+        final ValueAnimator fade = ValueAnimator.ofFloat(1f, 0f);
+        fade.setDuration(FADE_MS);
+        fade.setInterpolator(EMPHASIZED_ACCELERATE);
+        fade.addUpdateListener(a -> {
+            if (row != null && stillHeadsUp()) row.setAlpha((float) a.getAnimatedValue());
+        });
+        fade.addListener(new AnimatorListenerAdapter() {
+            @Override
+            public void onAnimationEnd(Animator animation) {
+                if (key != null) mHost.removeHeadsUp(key);
+                cleanUp();
+            }
+        });
+        mSettle = fade;
+        fade.start();
+    }
+
+    /** Released before the threshold (or the gesture was cancelled): it settles back. */
+    private void settle() {
+        mActive = false;
+        animateHint(false);
+        if (mAbandoned || mOffset == 0f) {
+            cleanUp();
+            return;
+        }
+        final ValueAnimator back = ValueAnimator.ofFloat(mOffset, 0f);
+        back.setDuration(SETTLE_MS);
+        back.setInterpolator(EMPHASIZED_DECELERATE);
+        back.addUpdateListener(a -> {
+            mOffset = (float) a.getAnimatedValue();
+            if (stillHeadsUp()) {
+                mRow.setTranslationY(mBaseY + mOffset);
+                placeHint();
+            }
+        });
+        back.addListener(new AnimatorListenerAdapter() {
+            @Override
+            public void onAnimationEnd(Animator animation) {
+                cleanUp();
+            }
+        });
+        mSettle = back;
+        back.start();
+    }
+
+    private void finish() {
+        mActive = false;
+        animateHint(false);
+        cleanUp();
+    }
+
+    /** A new pull ends what the last one left running. */
+    private void finishPrevious() {
+        if (mSettle != null) {
+            mSettle.end();
+            mSettle = null;
+        }
+        cleanUp();
+    }
+
+    private void cleanUp() {
+        if (mHintAnimator != null && mHintAnimator.isRunning()) {
+            // The hint fades out first; it is removed when that ends.
+            final SmallWindowPullHint hint = mHint;
+            final NotificationStackScrollLayout stack = mStack;
+            mHintAnimator.addListener(new AnimatorListenerAdapter() {
+                @Override
+                public void onAnimationEnd(Animator animation) {
+                    if (stack != null && hint != null) stack.getOverlay().remove(hint);
+                }
+            });
+        } else if (mStack != null && mHint != null) {
+            mStack.getOverlay().remove(mHint);
+        }
+        mHint = null;
+        mHintAnimator = null;
+        mSettle = null;
+        mPicked = null;
+        mRow = null;
+        mStack = null;
+        mKey = null;
+    }
+}
