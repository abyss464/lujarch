+package com.android.systemui.statusbar.notification.lujarch.smallwindow;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import android.text.TextPaint;
+import android.text.TextUtils;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.android.systemui.res.R;
+
+/**
+ * The hint under a heads-up pulled past the threshold: the system's bubble icon and "Release to
+ * open in a small window" on an accent pill, centred under the heads-up. Drawn in the
+ * notification stack's overlay, so it needs no window of its own; it rises into place as it
+ * fades in.
+ */
+final class SmallWindowPullHint extends Drawable {
+    private static final float HEIGHT_DP = 40f;
+    private static final float PAD_START_DP = 14f;
+    private static final float PAD_END_DP = 18f;
+    private static final float ICON_DP = 18f;
+    private static final float GAP_DP = 8f;
+    private static final float TEXT_SP = 14f;
+    private static final float RISE_DP = 10f;
+    private static final float SHADOW_RADIUS_DP = 12f;
+    private static final float SHADOW_DY_DP = 8f;
+    private static final float EDGE_DP = 16f;
+
+    private final float mDensity;
+    private final int mAccent;
+    private final TextPaint mText = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    @Nullable private final Drawable mIcon;
+    private final String mLabel;
+    private final RectF mPill = new RectF();
+
+    private float mCenterX;
+    private float mTop;
+    private float mMaxWidth = Float.MAX_VALUE;
+    /** 0 hidden, 1 shown: its alpha, and how far it has risen into place. */
+    private float mShown;
+    private CharSequence mShownLabel;
+
+    SmallWindowPullHint(Context context) {
+        mDensity = context.getResources().getDisplayMetrics().density;
+        final float fontScale = context.getResources().getConfiguration().fontScale;
+        mAccent = context.getColor(com.android.internal.R.color.materialColorPrimary);
+        final int onAccent = context.getColor(com.android.internal.R.color.materialColorOnPrimary);
+        mText.setColor(onAccent);
+        mText.setTextSize(TEXT_SP * mDensity * (fontScale > 0 ? fontScale : 1f));
+        mText.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
+        mFill.setStyle(Paint.Style.FILL);
+        mLabel = context.getString(R.string.lujarch_small_window_pull_hint);
+        mShownLabel = mLabel;
+        final Drawable icon = context.getDrawable(
+                com.android.wm.shell.R.drawable.bubble_ic_create_bubble);
+        if (icon != null) {
+            mIcon = icon.mutate();
+            mIcon.setTint(onAccent);
+        } else {
+            mIcon = null;
+        }
+    }
+
+    private float px(float dp) {
+        return dp * mDensity;
+    }
+
+    /** Centres the hint at {@code centerX}, its top at {@code top} (the stack's coordinates). */
+    void setAnchor(float centerX, float top, float stackWidth) {
+        mCenterX = centerX;
+        mTop = top;
+        mMaxWidth = stackWidth > 0 ? stackWidth - 2 * px(EDGE_DP) : Float.MAX_VALUE;
+        update();
+    }
+
+    void setShown(float shown) {
+        mShown = Math.max(0f, Math.min(1f, shown));
+        update();
+    }
+
+    float getShown() {
+        return mShown;
+    }
+
+    private void update() {
+        final float chrome = px(PAD_START_DP) + px(ICON_DP) + px(GAP_DP) + px(PAD_END_DP);
+        final float available = Math.max(0f, mMaxWidth - chrome);
+        mShownLabel = TextUtils.ellipsize(mLabel, mText, available, TextUtils.TruncateAt.END);
+        final float width = chrome + mText.measureText(mShownLabel, 0, mShownLabel.length());
+        final float top = mTop + px(RISE_DP) * (1f - mShown);
+        mPill.set(mCenterX - width / 2f, top, mCenterX + width / 2f, top + px(HEIGHT_DP));
+        final float shadow = px(SHADOW_RADIUS_DP) + px(SHADOW_DY_DP);
+        setBounds(Math.round(mPill.left - shadow), Math.round(mPill.top - shadow),
+                Math.round(mPill.right + shadow), Math.round(mPill.bottom + shadow));
+        invalidateSelf();
+    }
+
+    @Override
+    public void draw(@NonNull Canvas canvas) {
+        if (mShown <= 0f) return;
+        final int alpha = Math.round(255 * mShown);
+        final float radius = mPill.height() / 2f;
+        mFill.setColor(mAccent);
+        mFill.setAlpha(alpha);
+        mFill.setShadowLayer(px(SHADOW_RADIUS_DP), 0f, px(SHADOW_DY_DP),
+                Color.argb(Math.round(128 * mShown), 0, 0, 0));
+        canvas.drawRoundRect(mPill, radius, radius, mFill);
+        float x = mPill.left + px(PAD_START_DP);
+        if (mIcon != null) {
+            final int size = Math.round(px(ICON_DP));
+            final int iconTop = Math.round(mPill.centerY() - size / 2f);
+            mIcon.setBounds(Math.round(x), iconTop, Math.round(x) + size, iconTop + size);
+            mIcon.setAlpha(alpha);
+            mIcon.draw(canvas);
+        }
+        x += px(ICON_DP) + px(GAP_DP);
+        mText.setAlpha(alpha);
+        final Paint.FontMetrics fm = mText.getFontMetrics();
+        final float baseline = mPill.centerY() - (fm.ascent + fm.descent) / 2f;
+        canvas.drawText(mShownLabel, 0, mShownLabel.length(), x, baseline, mText);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        // Its alpha is its shown fraction.
+    }
+
+    @Override
+    public void setColorFilter(@Nullable ColorFilter colorFilter) {
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
