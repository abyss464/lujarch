+package com.android.wm.shell.bubbles
+
+import android.content.Context
+import android.database.ContentObserver
+import android.net.Uri
+import android.os.Handler
+import android.os.UserHandle
+import android.provider.Settings
+
+/**
+ * Whether bubbles show as small windows (target/windows.md): set by BubbleController whenever it
+ * picks the views for its mode, read where bubble code outside the views decides what a small
+ * window needs (each task its own bounds, the dock's own limit).
+ */
+object LujarchSmallWindowsMode {
+    @JvmStatic @Volatile var active = false
+}
+
+/**
+ * The switches of Settings > Display > Small windows, as the current user set them, each read
+ * live. Use small windows is Android's own bubbles switch, Settings.Secure notification_bubbles.
+ */
+class LujarchSmallWindowsSettings(
+    private val context: Context,
+    private val handler: Handler,
+    private val onChange: () -> Unit,
+) {
+    private val resolver = context.contentResolver
+    private val observer =
+        object : ContentObserver(handler) {
+            override fun onChange(selfChange: Boolean, uri: Uri?) {
+                onChange()
+            }
+        }
+    private var registered = false
+
+    /** WIN-1: Use small windows. */
+    val enabled: Boolean
+        get() = secure(Settings.Secure.NOTIFICATION_BUBBLES, 1) != 0
+
+    /** WIN-3: Move to dock when the app below is touched. */
+    val dockOnTouch: Boolean
+        get() = secure(DOCK_ON_TOUCH, 1) != 0
+
+    /** WIN-7: Live previews in the dock. */
+    val livePreviews: Boolean
+        get() = secure(LIVE_PREVIEWS, 1) != 0
+
+    /** WIN-8: At most, 2 to 4; a stored value outside counts as the nearest. */
+    val maxWindows: Int
+        get() = secure(MAX, 4).coerceIn(2, 4)
+
+    fun register() {
+        if (registered) return
+        registered = true
+        for (key in listOf(Settings.Secure.NOTIFICATION_BUBBLES, DOCK_ON_TOUCH, LIVE_PREVIEWS, MAX)) {
+            resolver.registerContentObserver(
+                Settings.Secure.getUriFor(key),
+                false,
+                observer,
+                UserHandle.USER_ALL,
+            )
+        }
+    }
+
+    fun unregister() {
+        if (!registered) return
+        registered = false
+        resolver.unregisterContentObserver(observer)
+    }
+
+    private fun secure(key: String, default: Int): Int =
+        Settings.Secure.getIntForUser(resolver, key, default, UserHandle.USER_CURRENT)
+
+    companion object {
+        const val DOCK_ON_TOUCH = "lujarch_windows_dock_on_touch"
+        const val LIVE_PREVIEWS = "lujarch_windows_live_previews"
+        const val MAX = "lujarch_windows_max"
+    }
+}
