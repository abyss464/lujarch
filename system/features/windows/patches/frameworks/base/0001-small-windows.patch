+package com.android.wm.shell.bubbles
+
+import android.content.Context
+import android.hardware.input.InputManager
+import android.os.Looper
+import android.view.InputEvent
+import android.view.InputEventReceiver
+import android.view.InputMonitor
+import android.view.MotionEvent
+
+/**
+ * Watches where touches go down on the display while a small window is open, without taking
+ * them: a touch on the app below moves the window to the dock and still reaches that app (WIN-3).
+ */
+class LujarchSmallWindowsTouchMonitor(
+    context: Context,
+    private val onDown: (Float, Float) -> Unit,
+) {
+    private val inputManager = context.getSystemService(InputManager::class.java)
+    private var monitor: InputMonitor? = null
+    private var receiver: InputEventReceiver? = null
+
+    fun start(displayId: Int) {
+        if (monitor != null) return
+        val m = inputManager.monitorGestureInput(NAME, displayId)
+        monitor = m
+        receiver =
+            object : InputEventReceiver(m.inputChannel, Looper.myLooper()) {
+                override fun onInputEvent(event: InputEvent) {
+                    try {
+                        if (event is MotionEvent && event.actionMasked == MotionEvent.ACTION_DOWN) {
+                            onDown(event.rawX, event.rawY)
+                        }
+                    } finally {
+                        finishInputEvent(event, false)
+                    }
+                }
+            }
+    }
+
+    fun stop() {
+        receiver?.let {
+            receiver = null
+            it.dispose()
+        }
+        monitor?.let {
+            monitor = null
+            it.dispose()
+        }
+    }
+
+    private companion object {
+        const val NAME = "lujarch-small-windows"
+    }
+}
