+package com.android.systemui.statusbar.notification.lujarch.smallwindow;
+
+import android.app.Notification;
+import android.app.PendingIntent;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.android.internal.statusbar.IStatusBarService;
+import com.android.internal.statusbar.NotificationVisibility;
+import com.android.systemui.dagger.SysUISingleton;
+import com.android.systemui.plugins.ActivityStarter;
+import com.android.systemui.settings.UserTracker;
+import com.android.systemui.shade.ShadeController;
+import com.android.systemui.statusbar.notification.collection.NotifPipeline;
+import com.android.systemui.statusbar.notification.collection.NotificationEntry;
+import com.android.systemui.statusbar.notification.collection.coordinator.Coordinator;
+import com.android.systemui.statusbar.notification.headsup.HeadsUpManager;
+import com.android.systemui.statusbar.policy.KeyguardStateController;
+import com.android.systemui.util.settings.SecureSettings;
+import com.android.systemui.wmshell.BubblesManager;
+import com.android.wm.shell.bubbles.Bubbles;
+
+import dagger.Lazy;
+
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+/**
+ * Small windows from notifications (target/windows.md, WIN-12, WIN-13): pulling a heads-up down
+ * ({@link HeadsUpSmallWindowPull}) and the small-window button of a notification in the shade
+ * open what a tap on the notification would open, in a small window. A conversation that offers
+ * itself as a bubble becomes that bubble, which makes it a selected conversation of its app.
+ * Both are there while Use small windows and Notifications in Settings > Display > Small windows
+ * are on.
+ */
+@SysUISingleton
+public class LujarchSmallWindowsNotifications implements Coordinator {
+    static final String TAG = "lujarch_windows";
+    private static final String KEY_NOTIFICATIONS = "lujarch_windows_notifications";
+
+    @Nullable private static volatile LujarchSmallWindowsNotifications sInstance;
+
+    private final Optional<Bubbles> mBubbles;
+    private final Optional<BubblesManager> mBubblesManager;
+    private final SecureSettings mSecureSettings;
+    private final UserTracker mUserTracker;
+    private final IStatusBarService mStatusBarService;
+    private final Lazy<ActivityStarter> mActivityStarter;
+    private final Lazy<ShadeController> mShadeController;
+    private final Lazy<HeadsUpManager> mHeadsUpManager;
+    private final Lazy<KeyguardStateController> mKeyguardState;
+    private final HeadsUpSmallWindowPull mPull;
+    @Nullable private NotifPipeline mPipeline;
+
+    @Inject
+    public LujarchSmallWindowsNotifications(
+            Optional<Bubbles> bubbles,
+            Optional<BubblesManager> bubblesManager,
+            SecureSettings secureSettings,
+            UserTracker userTracker,
+            IStatusBarService statusBarService,
+            Lazy<ActivityStarter> activityStarter,
+            Lazy<ShadeController> shadeController,
+            Lazy<HeadsUpManager> headsUpManager,
+            Lazy<KeyguardStateController> keyguardState) {
+        mBubbles = bubbles;
+        mBubblesManager = bubblesManager;
+        mSecureSettings = secureSettings;
+        mUserTracker = userTracker;
+        mStatusBarService = statusBarService;
+        mActivityStarter = activityStarter;
+        mShadeController = shadeController;
+        mHeadsUpManager = headsUpManager;
+        mKeyguardState = keyguardState;
+        mPull = new HeadsUpSmallWindowPull(this);
+        sInstance = this;
+    }
+
+    @Override
+    public void attach(@NonNull NotifPipeline pipeline) {
+        mPipeline = pipeline;
+    }
+
+    /** The pull of a heads-up toward a small window, once notifications are set up. */
+    @Nullable
+    public static HeadsUpSmallWindowPull headsUpPull() {
+        final LujarchSmallWindowsNotifications instance = sInstance;
+        return instance != null ? instance.mPull : null;
+    }
+
+    /** The small windows of notifications, once they are set up. */
+    @Nullable
+    public static LujarchSmallWindowsNotifications get() {
+        return sInstance;
+    }
+
+    private boolean switchesOn() {
+        final int user = mUserTracker.getUserId();
+        return mSecureSettings.getIntForUser(Settings.Secure.NOTIFICATION_BUBBLES, 1, user) != 0
+                && mSecureSettings.getIntForUser(KEY_NOTIFICATIONS, 1, user) != 0;
+    }
+
+    /** A conversation that offers itself as a bubble (WIN-13). */
+    private static boolean offersBubble(@NonNull NotificationEntry entry) {
+        final Notification.BubbleMetadata metadata = entry.getBubbleMetadata();
+        return metadata != null && entry.getRanking() != null
+                && entry.getRanking().getConversationShortcutInfo() != null;
+    }
+
+    /**
+     * Whether the notification can open in a small window now: the switches are on, and a tap on
+     * it opens an activity, or it is a conversation that offers itself as a bubble.
+     */
+    public boolean canOpen(@Nullable NotificationEntry entry) {
+        if (entry == null || mBubbles.isEmpty() || !switchesOn()) {
+            return false;
+        }
+        if (entry.isBubble()) return mBubblesManager.isPresent();
+        if (offersBubble(entry) && mBubblesManager.isPresent()) return true;
+        final PendingIntent intent = entry.getSbn().getNotification().contentIntent;
+        return intent != null && intent.isActivity();
+    }
+
+    /** {@link #canOpen(NotificationEntry)} for the notification with this key. */
+    public boolean canOpen(@Nullable String key) {
+        return key != null && mPipeline != null && canOpen(mPipeline.getEntry(key));
+    }
+
+    /** The small-window button of the notification with this key. */
+    public void open(@NonNull String key) {
+        final NotificationEntry entry = mPipeline != null ? mPipeline.getEntry(key) : null;
+        if (canOpen(entry)) open(entry);
+    }
+
+    /** The heads-up let go past its threshold. */
+    boolean openFromHeadsUp(@Nullable String key) {
+        final NotificationEntry entry =
+                key != null && mPipeline != null ? mPipeline.getEntry(key) : null;
+        if (!canOpen(entry)) return false;
+        open(entry);
+        return true;
+    }
+
+    /** The heads-up that opened leaves its slot. */
+    void removeHeadsUp(@NonNull String key) {
+        mHeadsUpManager.get().removeNotification(key, true /* releaseImmediately */,
+                "lujarch small window");
+    }
+
+    /**
+     * Opens the notification in a small window as a tap would open it, after unlocking when the
+     * phone is locked: its content intent as an app's small window, or, for a conversation that
+     * offers a bubble, that bubble.
+     */
+    public void open(@NonNull NotificationEntry entry) {
+        final String key = entry.getKey();
+        final Runnable action = () -> {
+            if (entry.isBubble() && mBubblesManager.isPresent()) {
+                Log.i(TAG, "conversation " + key + " opens its small window");
+                mBubblesManager.get().expandStackAndSelectBubble(entry);
+            } else if (offersBubble(entry) && mBubblesManager.isPresent()) {
+                Log.i(TAG, "conversation " + key + " opens in a small window");
+                mBubblesManager.get().onUserChangedBubble(entry, true /* shouldBubble */);
+            } else {
+                final PendingIntent intent = entry.getSbn().getNotification().contentIntent;
+                final UserHandle user = entry.getSbn().getUser().getIdentifier()
+                        == UserHandle.USER_ALL ? mUserTracker.getUserHandle()
+                        : entry.getSbn().getUser();
+                Log.i(TAG, "notification " + key + " opens in a small window");
+                mBubbles.get().showPendingIntentInSmallWindow(intent, user);
+                countAsTap(entry);
+            }
+            mShadeController.get().animateCollapseShade();
+        };
+        if (mKeyguardState.get().isShowing()) {
+            mActivityStarter.get().dismissKeyguardThenExecute(() -> {
+                action.run();
+                return false;
+            }, null, true /* afterKeyguardGone */);
+        } else {
+            action.run();
+        }
+    }
+
+    /** As a tap: the system clears a notification that cancels itself when tapped. */
+    private void countAsTap(@NonNull NotificationEntry entry) {
+        try {
+            mStatusBarService.onNotificationClick(entry.getKey(),
+                    NotificationVisibility.obtain(entry.getKey(), entry.getRanking().getRank(),
+                            mPipeline != null ? mPipeline.getAllNotifs().size() : 1, true));
+        } catch (RemoteException e) {
+            Log.w(TAG, "the tap on " + entry.getKey() + " was not reported", e);
+        }
+    }
+}
