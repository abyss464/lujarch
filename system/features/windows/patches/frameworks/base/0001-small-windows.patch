+
+/**
+ * Lujarch's small windows (target/windows.md): the presentation of Android's app bubbles on a
+ * phone. Bubbles stay Android's (BubbleController, BubbleData, their tasks and transitions); this
+ * view shows the selected bubble of an expanded stack as a free window over the app on screen and
+ * every other bubble as a card in the dock at an edge of the screen, or as an icon in its rail.
+ */
+@SuppressLint("ViewConstructor")
+class LujarchSmallWindowsView(
+    context: Context,
+    private val controller: BubbleController,
+    private val data: BubbleData,
+    private val manager: BubbleExpandedViewManager,
+) : FrameLayout(context), BubbleExpandedViewTransitionAnimator,
+    ViewTreeObserver.OnComputeInternalInsetsListener {
+
+    private val density = resources.displayMetrics.density
+    private val handler = Handler(Looper.myLooper()!!)
+    private val settings = LujarchSmallWindowsSettings(context, handler) { onSettingsChanged() }
+    private val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    private val items = LinkedHashMap<String, LujarchSmallWindowItem>()
+    /** The cards of the dock, the top card first. */
+    private val dock = ArrayList<LujarchSmallWindowItem>()
+    private var open: LujarchSmallWindowItem? = null
+    private val touchMonitor = LujarchSmallWindowsTouchMonitor(context, ::onTouchBelow)
+
+    var dockRight = prefs.getBoolean(KEY_RIGHT, true)
+        private set
+    private var dockTopFraction = prefs.getFloat(KEY_TOP, Float.NaN)
+    private var dockTop = 0f
+    private var folded = false
+    /** While Recents shows, the windows and the cards wait in its Running layer (WIN-11). */
+    private var recentsShown = false
+
+    private val handleX = LujarchSpring()
+    private val handleY = LujarchSpring()
+    private val handleAlpha = LujarchSpring()
+    private val railTop = LujarchSpring()
+    private val railHeight = LujarchSpring()
+    private val railAlpha = LujarchSpring()
+    private val menuAlpha = LujarchSpring()
+    private val ownSprings =
+        arrayOf(handleX, handleY, handleAlpha, railTop, railHeight, railAlpha, menuAlpha)
+    private val clock = LujarchFrameClock(::onFrame)
+
+    private val dismissView = DismissView(context)
+    private var menuFor: LujarchSmallWindowItem? = null
+    private val menuRect = RectF()
+    private var imeTop = Int.MAX_VALUE
+    /** The last touch went to the app below the open window, which then has the focus. */
+    private var belowTouched = false
+
+    // Colors, from the system's palette.
+    val accentColor = context.getColor(com.android.internal.R.color.materialColorPrimary)
+    val onAccentColor = context.getColor(com.android.internal.R.color.materialColorOnPrimary)
+    val windowColor = context.getColor(com.android.internal.R.color.materialColorSurfaceBright)
+    val cardTextColor = context.getColor(com.android.internal.R.color.materialColorOnSurface)
+    private val conversationColor =
+        context.getColor(com.android.internal.R.color.materialColorSurfaceContainerHighest)
+    val conversationTextColor = context.getColor(com.android.internal.R.color.materialColorOnSurface)
+    val conversationSubTextColor =
+        context.getColor(com.android.internal.R.color.materialColorOnSurfaceVariant)
+    private val placeholderColor =
+        context.getColor(com.android.internal.R.color.materialColorSurfaceContainerHigh)
+    private val menuColor =
+        context.getColor(com.android.internal.R.color.materialColorSurfaceContainerHigh)
+    private val menuTextColor = context.getColor(com.android.internal.R.color.materialColorOnSurface)
+    var outlineAlpha = OUTLINE_ALPHA
