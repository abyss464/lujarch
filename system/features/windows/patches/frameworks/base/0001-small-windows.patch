+
+/**
+ * Lujarch's small windows (target/windows.md): the presentation of Android's app bubbles on a
+ * phone. Bubbles stay Android's (BubbleController, BubbleData, their tasks and transitions); this
+ * view shows the selected bubble of an expanded stack as a free window over the app on screen and
+ * every other bubble as a card in the dock at an edge of the screen, or as an icon in its rail.
+ */
+@SuppressLint("ViewConstructor")
+class LujarchSmallWindowsView(
+    context: Context,
+    private val controller: BubbleController,
+    private val data: BubbleData,
+    private val manager: BubbleExpandedViewManager,
+) : FrameLayout(context), BubbleExpandedViewTransitionAnimator,
+    ViewTreeObserver.OnComputeInternalInsetsListener {
+
+    private val density = resources.displayMetrics.density
+    private val handler = Handler(Looper.myLooper()!!)
+    private val settings = LujarchSmallWindowsSettings(context, handler) { onSettingsChanged() }
+    private val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    private val items = LinkedHashMap<String, LujarchSmallWindowItem>()
+    /** The cards of the dock, the top card first. */
+    private val dock = ArrayList<LujarchSmallWindowItem>()
+    private var open: LujarchSmallWindowItem? = null
+    private val touchMonitor = LujarchSmallWindowsTouchMonitor(context, ::onTouchBelow)
+
+    var dockRight = prefs.getBoolean(KEY_RIGHT, true)
+        private set
+    private var dockTopFraction = prefs.getFloat(KEY_TOP, Float.NaN)
+    private var dockTop = 0f
+    private var folded = false
+    /** While Recents shows, the windows and the cards wait in its Running layer (WIN-11). */
+    private var recentsShown = false
+    private var nextFrom: Rect? = null
+    private var systemShown = true
+    private var linuxInFront = false
+    private val recentsSlots = HashMap<String, RectF>()
+
+    private val handleX = LujarchSpring()
+    private val handleY = LujarchSpring()
+    private val handleAlpha = LujarchSpring()
+    private val railX = LujarchSpring()
+    private val railTop = LujarchSpring()
+    private val railHeight = LujarchSpring()
+    private val railAlpha = LujarchSpring()
+    private val menuAlpha = LujarchSpring()
+    private val ownSprings =
+        arrayOf(handleX, handleY, handleAlpha, railX, railTop, railHeight, railAlpha, menuAlpha)
+    private val clock = LujarchFrameClock(::onFrame)
+    /**
+     * From a drag of the dock or the rail until it rests, the cards or icons trail its top one
+     * after another along [trail] (WIN-5, WIN-6).
+     */
+    private var chained = false
+    private val trail = LujarchTrail()
+    private var chainRestAt = 0L
+
+    private val dismissView = DismissView(context)
+    private var menuFor: LujarchSmallWindowItem? = null
+    private val menuRect = RectF()
+    private var imeTop = Int.MAX_VALUE
+    /** The last touch went to the app below the open window, which then has the focus. */
+    private var belowTouched = false
+
+    // Colors, from the system's palette (loadResources).
+    var accentColor = 0
+        private set
+    var onAccentColor = 0
+        private set
+    var windowColor = 0
+        private set
+    var cardTextColor = 0
+        private set
+    private var conversationColor = 0
+    var conversationTextColor = 0
+        private set
+    var conversationSubTextColor = 0
+        private set
+    private var placeholderColor = 0
+    private var menuColor = 0
+    /** The hairline that keeps a card or the menu apart from an app of the same dark surface. */
+    var rimColor = 0
+        private set
+    private var handlePillColor = 0
+    private var railColor = 0
+    private var menuTextColor = 0
+    var outlineAlpha = OUTLINE_ALPHA
+        private set
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val menuPaint = TextPaint(Paint.ANTI_ALIAS_FLAG)
+    private var menuIcons: Array<Drawable?> = emptyArray()
+    private var menuLabels: Array<CharSequence> = emptyArray()
+
+    private val railPath = Path()
+    private val railRadii = FloatArray(8)
+
+    private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop
+    private var gesture: Gesture? = null
+    private var velocity: VelocityTracker? = null
+    private val tmpRect = Rect()
+    private val tmpRectF = RectF()
+
+    init {
+        clipChildren = false
+        clipToPadding = false
+        setWillNotDraw(false)
+        dismissView.setup()
+        dismissView.elevation = dp(DISMISS_Z)
+        addView(dismissView)
+        loadResources()
+    }
+
+    /**
+     * Reads the palette, the menu's words and the text sizes again: the language, the font size,
+     * dark theme and the wallpaper's palette change them while the dock stays.
+     */
+    fun loadResources() {
+        fun color(id: Int) = context.getColor(id)
+        accentColor = color(com.android.internal.R.color.materialColorPrimary)
+        onAccentColor = color(com.android.internal.R.color.materialColorOnPrimary)
+        windowColor = color(com.android.internal.R.color.materialColorSurfaceBright)
+        cardTextColor = color(com.android.internal.R.color.materialColorOnSurface)
+        conversationColor = color(com.android.internal.R.color.materialColorSurfaceContainerHighest)
+        conversationTextColor = color(com.android.internal.R.color.materialColorOnSurface)
+        conversationSubTextColor = color(com.android.internal.R.color.materialColorOnSurfaceVariant)
+        placeholderColor = color(com.android.internal.R.color.materialColorSurfaceContainerHigh)
+        menuColor = color(com.android.internal.R.color.materialColorSurfaceContainerHighest)
+        rimColor = color(com.android.internal.R.color.materialColorOutlineVariant)
+        handlePillColor = color(com.android.internal.R.color.materialColorOnSurfaceVariant)
+        railColor = color(com.android.internal.R.color.materialColorSurfaceContainerHigh)
+        menuTextColor = color(com.android.internal.R.color.materialColorOnSurface)
+        menuPaint.textSize = 14.5f * density * resources.configuration.fontScale
+        menuIcons =
+            arrayOf(
+                context.getDrawable(R.drawable.lujarch_small_window_fullscreen),
+                context.getDrawable(R.drawable.lujarch_small_window_dock),
+                context.getDrawable(R.drawable.lujarch_small_window_close),
+            )
+        menuLabels =
+            arrayOf(
+                context.getText(R.string.lujarch_small_window_fullscreen),
+                context.getText(R.string.lujarch_small_window_dock),
+                context.getText(R.string.lujarch_small_window_close),
+            )
+        for (item in items.values) item.view.loadResources()
+        invalidate()
+    }
+
+    override fun onConfigurationChanged(newConfig: android.content.res.Configuration) {
+        super.onConfigurationChanged(newConfig)
+        loadResources()
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The window's lifecycle
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        viewTreeObserver.addOnComputeInternalInsetsListener(this)
+        settings.register()
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        viewTreeObserver.removeOnComputeInternalInsetsListener(this)
+        settings.unregister()
+        touchMonitor.stop()
+    }
+
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        super.onLayout(changed, l, t, r, b)
+        if (changed) {
+            if (dockTopFraction.isNaN()) dockTopFraction = DOCK_TOP / (height / density)
+            dockTop = clampDockTop(dockTopFraction * height)
+            items.values.forEach {
+                fitWindow(it)
+                if (it.w.value == 0f) growIn(it)
+            }
+            place(animate = true, stagger = true)
+            ownSprings.forEach { it.snap(it.target.toFloat()) }
+            syncTasks()
+        } else {
+            items.values.forEach { placeView(it) }
+        }
+    }
+
+    /** The display's size or density changed. */
+    fun onDisplaySizeChanged() {
+        requestLayout()
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Bubbles, as BubbleController reports them
+
+    /** A bubble was added: its card goes on top of the dock (WIN-4). */
+    fun addBubble(bubble: Bubble) {
+        val existing = items[bubble.key]
+        if (existing != null) {
+            existing.bubble = bubble
+            existing.view.bind()
+            return
+        }
+        val item = LujarchSmallWindowItem(bubble, context, this)
+        item.view.tag = item
+        item.lastUsed = SystemClock.uptimeMillis()
+        item.lastMessage = bubble.flyoutMessage?.message
+        if (item.isConversation && item.lastMessage != null) item.unread = 1
+        initWindow(item)
+        items[bubble.key] = item
+        dock.add(0, item)
+        item.view.elevation = dp(CARD_Z)
+        addView(item.view, LayoutParams(0, 0))
+        item.view.bind()
+        listen(item)
+        if (width > 0) growIn(item)
+        if (item.counts) enforceLimit(item)
+        place(animate = true, stagger = true)
+        syncTasks()
+        reportWindows()
+    }
+
+    /** A new shape grows out of the top of the dock, or out of the card it was in Recents. */
+    private fun growIn(item: LujarchSmallWindowItem) {
+        val from = nextFrom
+        nextFrom = null
+        if (from != null) {
+            item.fromCard = from
+            snapItem(item, Frame(from.left.toFloat(), from.top.toFloat(), from.width().toFloat(),
+                from.height().toFloat(), dp(CARD_RADIUS), 0f, 0f, 0f),
+                scale = fitScale(item, from.width().toFloat(), from.height().toFloat()))
+            return
+        }
+        snapItem(item, slotFrame(0), scale = cardScale(item))
+        item.alpha.snap(0f)
+        item.lift.snap(0.6f)
+    }
+
+    /** The next shape that comes in starts where its Recents card is (WIN-11). */
+    fun growNextFrom(from: Rect) {
+        nextFrom = Rect(from)
+    }
+
+    /**
+     * A bubble went away: its shape fades where it is while the dock closes up; then the bubble's
+     * task view is cleaned up, which ends its task unless it already left the bubble (full screen,
+     * Recents).
+     */
+    fun removeBubble(bubble: Bubble) {
+        val item = items.remove(bubble.key)
+        if (item == null) {
+            post { finishRemoval(bubble) }
+            return
+        }
+        dock.remove(item)
+        if (open === item) {
+            open = null
+            updateTouchMonitor()
+        }
+        if (menuFor === item) hideMenu()
+        item.leaving = true
+        item.alpha.to(0f)
+        item.lift.to(0.8f)
+        if (!LujarchSpring.animated()) item.alpha.snap(0f)
+        place(animate = true, stagger = true)
+        reportWindows()
+    }
+
+    private fun gone(item: LujarchSmallWindowItem) {
+        detachTask(item)
+        removeView(item.view)
+        finishRemoval(item.bubble)
+        if (items.isEmpty()) controller.onAllBubblesAnimatedOut()
+    }
+
+    private fun finishRemoval(bubble: Bubble) {
+        val transition = bubble.currentTransition
+        if (transition != null) transition.continueCollapse() else bubble.cleanupViews()
+    }
+
+    private var reported: List<LujarchSmallWindow> = emptyList()
+
+    /**
+     * Background learns the small windows in the order of the screen: their tasks run off screen
+     * (BG-1), and Recents' Running layer keeps a place for each (WIN-11).
+     */
+    private fun reportWindows() {
+        val windows = (listOfNotNull(open) + dock).map { item ->
+            LujarchSmallWindow().apply {
+                key = item.bubble.key
+                taskId = item.taskId
+                packageName = item.bubble.packageName
+                userId = item.bubble.user.identifier
+                label = item.name?.toString()
+                conversation = item.isConversation
+            }
+        }
+        if (windows == reported) return
+        reported = windows
+        try {
+            LujarchBackground.get()?.setSmallWindows(windows.toTypedArray())
+        } catch (e: RemoteException) {
+            Log.w(TAG, "Background cannot be told the small windows", e)
+        }
+    }
+
+    /** The bubble's task view reports to its shape from the start, attached or not. */
+    private fun listen(item: LujarchSmallWindowItem) {
+        if (item.listener != null) return
+        val btv = item.bubble.bubbleTaskView ?: return
+        item.listener =
+            BubbleTaskViewListener(context, btv, item.view, manager,
+                object : BubbleTaskViewListener.Callback {
+                    override fun onTaskCreated() {
+                        onContentDrawn(item, true)
+                        reportWindows()
+                    }
+
+                    override fun onContentVisibilityChanged(visible: Boolean) =
+                        onContentDrawn(item, visible)
+
+                    override fun onBackPressed() {
+                        if (item === open) controller.collapseStack()
+                    }
+
+                    override fun onTaskInfoChanged(taskInfo: ActivityManager.RunningTaskInfo) {}
+                })
+        item.listener?.setBubble(item.bubble)
+    }
+
+    /** A bubble's notification or icon changed: a new message counts on its card (WIN-13). */
+    fun updateBubble(bubble: Bubble) {
+        val item = items[bubble.key] ?: return
+        item.bubble = bubble
+        val message = bubble.flyoutMessage?.message
+        if (item.isConversation && message != null && message != item.lastMessage) {
+            item.lastMessage = message
+            if (item !== open) item.unread++
+        }
+        item.view.bind()
+    }
+
+    fun setBubbleSuppressed(bubble: Bubble, suppressed: Boolean) {
+        val item = items[bubble.key] ?: return
+        item.view.visibility = if (suppressed) INVISIBLE else VISIBLE
+    }
+
+    /** Expansion or selection changed in BubbleData: the selected bubble's window opens. */
+    fun onStackChanged() {
+        val selected = data.selectedBubble as? Bubble
+        val wanted = if (data.isExpanded && selected != null) items[selected.key] else null
+        if (wanted === open) return
+        val previous = open
+        if (previous != null) {
+            // The window that was open becomes the top card (WIN-4).
+            dock.remove(previous)
+            dock.add(0, previous)
+            previous.view.elevation = dp(CARD_Z)
+        }
+        hideMenu()
+        open = wanted
+        if (wanted != null) {
+            dock.remove(wanted)
+            wanted.lastUsed = SystemClock.uptimeMillis()
+            wanted.unread = 0
+            wanted.view.elevation = dp(WINDOW_Z)
+            if (wanted.isConversation && !wanted.opened) {
+                wanted.opened = true
+                enforceLimit(wanted)
+            }
+        }
+        belowTouched = false
+        updateTouchMonitor()
+        place(animate = true, stagger = true)
+        syncTasks()
+    }
+
+    fun hasItems(): Boolean = items.isNotEmpty()
+
+    /** Whether another small window than [taskView]'s shows its app: the bubbles' root task stays. */
+    fun showsTaskOtherThan(taskView: TaskViewTaskController): Boolean =
+        items.values.any { it.taskView != null && it.taskView?.controller !== taskView }
+
+    // ---------------------------------------------------------------------------------------
+    // The limit (WIN-8)
+
+    private fun enforceLimit(newcomer: LujarchSmallWindowItem) {
+        val counted = items.values.filter { it.counts && !it.leaving }
+        var excess = counted.size - settings.maxWindows
+        if (excess <= 0) return
+        val candidates =
+            counted.filter { it !== newcomer && it !== open }.sortedBy { it.lastUsed }
+        for (item in candidates) {
+            if (excess <= 0) break
+            moveToRecents(item)
+            excess--
+        }
+    }
+
+    /**
+     * Makes the small window an ordinary task behind the app on screen, so that it is a card in
+     * Recents and its app keeps running.
+     */
+    private fun moveToRecents(item: LujarchSmallWindowItem) {
+        val bubble = item.bubble
+        val taskView = bubble.bubbleTaskView?.taskView
+        val task = taskView?.taskInfo
+        if (taskView == null || task == null) {
+            controller.dismissBubble(bubble, Bubbles.DISMISS_AGED)
+            return
+        }
+        Log.i(TAG, "moving ${bubble.key} (task ${task.taskId}) to Recents: over the limit")
+        val wct =
+            if (controller.bubbleHelper.isAppBubbleTask(task)) {
+                BubbleUtils.getExitBubbleTransaction(controller.bubbleHelper, task.token,
+                    taskView.captionInsetsOwner)
+            } else {
+                WindowContainerTransaction().apply {
+                    setWindowingMode(task.token, WindowConfiguration.WINDOWING_MODE_UNDEFINED)
+                    setAlwaysOnTop(task.token, false)
+                    setTaskForceExcludedFromRecents(task.token, false)
+                    setInterceptBackPressedOnTaskRoot(task.token, false)
+                    setDisablePip(task.token, false)
+                    setLaunchNextToBubble(task.token, false)
+                    setDisableLaunchAdjacent(task.token, false)
+                    setBounds(task.token, Rect())
+                }
+            }
+        wct.reorder(task.token, false /* onTop */)
+        taskView.controller.taskOrganizer.applyTransaction(wct)
+        taskView.controller.notifyTaskRemovalStarted(task)
+    }
+
+    private fun onSettingsChanged() {
+        if (!settings.enabled) {
+            // Off (WIN-1): the dock and its rail are gone; the apps stay in Recents.
+            items.values.filter { !it.isConversation }.forEach { moveToRecents(it) }
+            return
+        }
+        items.values.lastOrNull { it.counts }?.let { enforceLimit(it) }
+        updateTouchMonitor()
+        place(animate = true, stagger = true)
+        syncTasks()
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Geometry
+
+    private fun dp(v: Float): Float = v * density
+
+    val headerHeight: Float
+        get() = dp(HEADER)
+
+    private val margin: Float
+        get() = dp(MARGIN)
+
+    private val statusBar: Int
+        get() =
+            rootWindowInsets?.getInsetsIgnoringVisibility(WindowInsets.Type.statusBars())?.top
+                ?: 0
+
+    private val topLimit: Float
+        get() = max(margin, statusBar.toFloat())
+
+    private val bottomLimit: Float
+        get() = min(height - margin, imeTop - margin)
+
+    /**
+     * The scale that fits the app's whole screen into a card or a slot of this size, inside a
+     * margin that shrinks with the shape (WIN-4).
+     */
+    private fun fitScale(item: LujarchSmallWindowItem, w: Float, h: Float): Float {
+        val inset = dp(CARD_INSET) * h / dp(CARD_H)
+        return max(0.01f, min((w - 2 * inset) / max(1, item.layoutW),
+            (h - 2 * inset) / max(1, item.layoutH)))
+    }
+
+    private fun cardScale(item: LujarchSmallWindowItem): Float =
+        fitScale(item, dp(CARD_W), dp(CARD_H))
+
+    private fun initWindow(item: LujarchSmallWindowItem) {
+        val w = if (width > 0) width else resources.displayMetrics.widthPixels
+        val h = if (height > 0) height else resources.displayMetrics.heightPixels
+        item.layoutW = w
+        item.layoutH = h
+        item.taskW = w
+        item.taskH = h
+        item.winScale = dp(WINDOW_W) / w
+        item.winX = dp(WINDOW_X)
+        item.winY = dp(WINDOW_Y)
+        fitWindow(item)
+    }
+
+    /** Keeps the window at least 160 dp wide and 12 dp inside the screen's edges (WIN-2). */
+    private fun fitWindow(item: LujarchSmallWindowItem) {
+        if (width == 0 || height == 0 || item.layoutW == 0) return
+        val maxW = width - 2 * margin
+        val maxH = bottomLimit - topLimit
+        var s = item.winScale
+        s = min(s, maxW / item.layoutW)
+        s = min(s, (maxH - headerHeight) / item.layoutH)
+        s = max(s, dp(MIN_W) / item.layoutW)
+        item.winScale = s
+        val w = item.layoutW * s
+        val h = headerHeight + item.layoutH * s
+        item.winX = item.winX.coerceIn(margin, max(margin, width - margin - w))
+        item.winY = item.winY.coerceIn(topLimit, max(topLimit, bottomLimit - h))
+    }
+
+    private class Frame(
+        val x: Float,
+        val y: Float,
+        val w: Float,
+        val h: Float,
+        val radius: Float,
+        val turn: Float,
+        val window: Float,
+        val icon: Float,
+    )
+
+    /** How much of a card's top the card above it covers in the dock. */
+    fun coveredTop(item: LujarchSmallWindowItem): Float =
+        if (!folded && item !== open && !recentsShown && dock.indexOf(item) > 0) {
+            dp(CARD_H - CARD_STEP)
+        } else {
+            0f
+        }
+
+    private fun dockX(): Float = if (dockRight) width - dp(DOCK_MARGIN + CARD_W) else dp(DOCK_MARGIN)
+
+    private fun railRestX(): Float = if (dockRight) width - dp(RAIL_W) else 0f
+
+    private fun slotFrame(i: Int): Frame =
+        if (folded) {
+            val x =
+                if (dockRight) width - dp(RAIL_W) + dp((RAIL_W - RAIL_ICON) / 2)
+                else dp((RAIL_W - RAIL_ICON) / 2)
+            Frame(x, railTopFor(dockTop) + dp(RAIL_PAD) + i * dp(RAIL_STEP), dp(RAIL_ICON),
+                dp(RAIL_ICON), dp(RAIL_ICON / 2), 0f, 0f, 1f)
+        } else {
+            Frame(dockX(), dockTop + dp(CARD_FROM_HANDLE) + i * dp(CARD_STEP), dp(CARD_W),
+                dp(CARD_H), dp(CARD_RADIUS), if (dockRight) 1f else -1f, 0f, 0f)
+        }
+
+    private fun windowFrame(item: LujarchSmallWindowItem): Frame {
+        val s = item.winScale
+        var y = item.winY
+        val h = headerHeight + item.layoutH * s
+        // Over the input method the window waits above it.
+        if (y + h > bottomLimit) y = max(topLimit, bottomLimit - h)
+        return Frame(item.winX, y, item.layoutW * s, h, dp(WINDOW_RADIUS), 0f, 1f, 0f)
+    }
+
+    private fun railTopFor(top: Float): Float = top + dp(RAIL_FROM_HANDLE)
+
+    private fun clampDockTop(top: Float): Float {
+        val cards = max(1, dock.size)
+        val span = dp(CARD_FROM_HANDLE) + (cards - 1) * dp(CARD_STEP) + dp(CARD_H)
+        return top.coerceIn(topLimit, max(topLimit, height - margin - span))
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Motion
+
+    private fun target(item: LujarchSmallWindowItem, f: Frame, scale: Float) {
+        item.x.to(f.x)
+        item.y.to(f.y)
+        item.w.to(f.w)
+        item.h.to(f.h)
+        item.radius.to(f.radius)
+        item.turn.to(f.turn)
+        item.window.to(f.window)
+        item.icon.to(f.icon)
+        item.scale.to(scale)
+        item.alpha.to(if (item.leaving) 0f else 1f)
+        if (gesture?.holds(item) != true) item.lift.to(if (item.leaving) 0.8f else 1f)
+        item.content.to(if (wantsContent(item) && item.contentDrawn) 1f else 0f)
+    }
+
+    private fun snapItem(item: LujarchSmallWindowItem, f: Frame, scale: Float) {
+        item.x.snap(f.x)
+        item.y.snap(f.y)
+        item.w.snap(f.w)
+        item.h.snap(f.h)
+        item.radius.snap(f.radius)
+        item.turn.snap(f.turn)
+        item.window.snap(f.window)
+        item.icon.snap(f.icon)
+        item.scale.snap(scale)
+    }
+
+    /** Sets every shape's target; [stagger]: the cards follow each other (WIN-9). */
+    private fun place(animate: Boolean, stagger: Boolean = false) {
+        reportWindows()
+        if (width == 0) return
+        val now = SystemClock.uptimeMillis()
+        dockTop = clampDockTop(dockTop)
+        if (recentsShown) {
+            placeInRecents(now)
+            updateCompositionOrder()
+            if (!animate || !LujarchSpring.animated()) {
+                items.values.forEach { item -> item.springs.forEach { it.snap(it.target.toFloat()) } }
+                ownSprings.forEach { it.snap(it.target.toFloat()) }
+            }
+            clock.start()
+            invalidate()
+            return
+        }
+        dock.forEachIndexed { i, item ->
+            if (gesture?.holds(item) == true) return@forEachIndexed
+            val f = slotFrame(i)
+            target(item, f,
+                if (folded) fitScale(item, dp(RAIL_ICON), dp(RAIL_ICON)) else cardScale(item))
+            item.startAt = if (stagger && !chained) now + i * LujarchSpring.STAGGER_MS else now
+            item.view.elevation = dp(CARD_Z) - i * dp(0.5f)
+        }
+        open?.let { item ->
+            if (gesture?.holds(item) != true) {
+                target(item, windowFrame(item), item.winScale)
+            }
+            item.startAt = now
+        }
+        val visibleDock = dock.isNotEmpty() && settings.enabled
+        if (gesture !is DockDrag) {
+            handleX.to(dockX() + dp((CARD_W - HANDLE_W) / 2))
+            handleY.to(dockTop)
+            // Hidden while folded, the handle comes back where the dock unfolds.
+            if (handleAlpha.value <= 0.01f) {
+                handleX.snap(handleX.target.toFloat())
+                handleY.snap(handleY.target.toFloat())
+            }
+        }
+        handleAlpha.to(if (visibleDock && !folded) 1f else 0f)
+        if (gesture !is RailDrag) {
+            railX.to(railRestX())
+            railTop.to(railTopFor(dockTop))
+            if (railAlpha.value <= 0.01f) {
+                railX.snap(railX.target.toFloat())
+                railTop.snap(railTop.target.toFloat())
+            }
+        }
+        railHeight.to(dp(RAIL_PAD * 2) + max(0, dock.size - 1) * dp(RAIL_STEP) + dp(RAIL_ICON))
+        railAlpha.to(if (visibleDock && folded) 1f else 0f)
+        menuAlpha.to(if (menuFor != null) 1f else 0f)
+        updateCompositionOrder()
+        if (!animate || !LujarchSpring.animated()) {
+            items.values.forEach { item -> item.springs.forEach { it.snap(it.target.toFloat()) } }
+            ownSprings.forEach { it.snap(it.target.toFloat()) }
+        }
+        clock.start()
+        invalidate()
+    }
+
+    /**
+     * The open window first, then the cards in their order, side by side in the strip above
+     * Recents' cards where its Running layer shows what runs, each with its live screen.
+     */
+    private fun placeInRecents(now: Long) {
+        val shown = listOfNotNull(open) + dock
+        val h = dp(RECENTS_TILE_H)
+        val w = h * dp(CARD_W) / dp(CARD_H)
+        val gap = dp(RECENTS_GAP)
+        val total = shown.size * w + max(0, shown.size - 1) * gap
+        var x = (width - total) / 2f
+        val y = statusBar + dp(RECENTS_TOP)
+        shown.forEachIndexed { i, item ->
+            val slot = recentsSlots[item.bubble.key]
+            if (slot != null && item.isConversation) {
+                // A conversation waits as the person's picture, as on the rail.
+                val d = min(slot.width(), slot.height())
+                target(item, Frame(slot.centerX() - d / 2, slot.centerY() - d / 2, d, d, d / 2,
+                    0f, 0f, 1f), fitScale(item, d, d))
+            } else if (slot != null) {
+                target(item, Frame(slot.left, slot.top, slot.width(), slot.height(),
+                    dp(CARD_RADIUS) * slot.height() / dp(CARD_H), 0f, 0f, 0f),
+                    fitScale(item, slot.width(), slot.height()))
+            } else {
+                target(item, Frame(x, y, w, h, dp(CARD_RADIUS) * h / dp(CARD_H), 0f, 0f, 0f),
+                    fitScale(item, w, h))
+                x += w + gap
+            }
+            item.startAt = now + i * LujarchSpring.STAGGER_MS
+        }
+        handleAlpha.to(0f)
+        railAlpha.to(0f)
+        menuAlpha.to(0f)
+    }
+
+    /**
+     * Linux came to the front of the home screen or left it (Launcher reports it): the small
+     * windows and the dock are not shown and take no touch while it is in front (LNX-3).
+     */
+    fun setHidden(hidden: Boolean) {
+        linuxInFront = hidden
+        applyShown()
+    }
+
+    /** The system shows or hides the bubbles (the shade, the lock screen). */
+    fun setSystemShown(shown: Boolean) {
+        systemShown = shown
+        applyShown()
+    }
+
+    private fun applyShown() {
+        val shown = systemShown && !linuxInFront
+        if (!shown) hideMenu()
+        visibility = if (shown) VISIBLE else INVISIBLE
+        updateTouchMonitor()
+        requestApplyTouchRegion()
+    }
+
+    /**
+     * Recents opened or closed (Launcher reports it), with the place of each small window in its
+     * Running layer, by the bubble's key: the layer lays them out, the shapes fly into them
+     * (WIN-11).
+     */
+    fun setRecentsShown(shown: Boolean, keys: Array<String>?, slots: Array<Rect>?) {
+        recentsSlots.clear()
+        if (keys != null && slots != null) {
+            for (i in 0 until minOf(keys.size, slots.size)) {
+                recentsSlots[keys[i]] = RectF(slots[i])
+            }
+        }
+        if (shown == recentsShown) {
+            if (shown) place(animate = true)
+            return
+        }
+        recentsShown = shown
+        if (shown) {
+            hideMenu()
+            gesture = null
+        }
+        updateTouchMonitor()
+        place(animate = true, stagger = true)
+        syncTasks()
+    }
+
+    private fun onFrame(ms: Long): Boolean {
+        val now = SystemClock.uptimeMillis()
+        var moving = false
+        for (s in ownSprings) {
+            s.step(ms, if (s === handleAlpha || s === railAlpha || s === menuAlpha) 0.002 else 0.5)
+            if (!s.atRest) moving = true
+        }
+        if (chained && follow(now)) moving = true
+        for (item in items.values.toList() + leavingItems()) {
+            if (now >= item.startAt) {
+                for (s in item.springs) s.step(ms, if (s === item.x || s === item.y ||
+                        s === item.w || s === item.h || s === item.radius) 0.5 else 0.002)
+            }
+            if (item.springs.any { !it.atRest }) moving = true
+            placeView(item)
+        }
+        // Shapes that left are removed once they have faded.
+        for (item in leavingItems()) {
+            if (item.alpha.atRest) gone(item)
+        }
+        if (!moving) syncTasks()
+        invalidate()
+        return moving || gesture != null
+    }
+
+    /** The first card or icon goes with the top; the dock or the rail is moving or flung. */
+    private fun startChain() {
+        chained = true
+        chainRestAt = 0L
+        trail.clear()
+    }
+
+    /**
+     * Places each card of the dock, or each icon of the rail, where the one before it was 35 ms
+     * earlier, so that they trail its top one after another (WIN-5, WIN-6, WIN-9). Returns
+     * whether they still move.
+     */
+    private fun follow(now: Long): Boolean {
+        val leadX: Float
+        val leadY: Float
+        val step: Float
+        if (folded) {
+            leadX = railX.value + dp((RAIL_W - RAIL_ICON) / 2)
+            leadY = railTop.value + dp(RAIL_PAD)
+            step = dp(RAIL_STEP)
+        } else {
+            leadX = handleX.value - dp((CARD_W - HANDLE_W) / 2)
+            leadY = handleY.value + dp(CARD_FROM_HANDLE)
+            step = dp(CARD_STEP)
+        }
+        trail.add(now, leadX, leadY)
+        dock.forEachIndexed { i, item ->
+            trail.at(now - i * LujarchSpring.STAGGER_MS)
+            item.x.snap(trail.x)
+            item.y.snap(trail.y + i * step)
+        }
+        val leadMoving = gesture != null ||
+            !(handleX.atRest && handleY.atRest && railX.atRest && railTop.atRest)
+        if (leadMoving) {
+            chainRestAt = 0L
+            return true
+        }
+        if (chainRestAt == 0L) chainRestAt = now
+        if (now - chainRestAt <= dock.size * LujarchSpring.STAGGER_MS) return true
+        chained = false
+        trail.clear()
+        place(animate = true)
+        syncTasks()
+        return false
+    }
+
+    /** The side a dock or a rail let go at [centreX] moving at [vx] rests at, as bubbles do. */
+    private fun restsRight(centreX: Float, vx: Float): Boolean {
+        val onLeft = centreX < width / 2f
+        val flungLeft = if (onLeft) vx < ESCAPE_VELOCITY else vx < -ESCAPE_VELOCITY
+        return !flungLeft
+    }
+
+    /** Where a fling of [v] carries a value on before friction stops it, as for bubbles. */
+    private fun flungBy(v: Float): Float = v / (FLING_FRICTION * 4.2f)
+
+    private fun leavingItems(): List<LujarchSmallWindowItem> =
+        (0 until childCount).mapNotNull { (getChildAt(it) as? LujarchSmallWindowItemView)?.let {
+            v -> v.tag as? LujarchSmallWindowItem } }.filter { it.leaving }
+
+    private fun placeView(item: LujarchSmallWindowItem) {
+        val v = item.view
+        v.tag = item
+        val l = item.x.value.roundToInt()
+        val t = item.y.value.roundToInt()
+        val r = (item.x.value + item.w.value).roundToInt()
+        val b = (item.y.value + item.h.value).roundToInt()
+        if (v.measuredWidth != r - l || v.measuredHeight != b - t || v.isLayoutRequested) {
+            v.measure(
+                MeasureSpec.makeMeasureSpec(max(1, r - l), MeasureSpec.EXACTLY),
+                MeasureSpec.makeMeasureSpec(max(1, b - t), MeasureSpec.EXACTLY),
+            )
+        }
+        v.layout(l, t, max(l + 1, r), max(t + 1, b))
+        v.apply(headerHeight)
+    }
+
+    /** The order the task views are composited in, as the shapes stack (WIN-4). */
+    private fun updateCompositionOrder() {
+        val order = ArrayList<LujarchSmallWindowItem>()
+        (gesture as? CardDrag)?.item?.let { order.add(it) }
+        open?.let { if (it !in order) order.add(it) }
+        dock.forEach { if (it !in order) order.add(it) }
+        order.forEachIndexed { i, item -> item.taskView?.setCompositionOrder(-1 - i) }
+        (gesture as? CardDrag)?.item?.view?.elevation = dp(DRAG_Z)
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The apps' tasks: visible while their screen shows
+
+    /** Whether the app's live screen shows in the shape (WIN-6, WIN-7). */
+    private fun wantsContent(item: LujarchSmallWindowItem): Boolean {
+        if (item.leaving || !settings.enabled) return false
+        if (item === open || item.toFullScreen) return true
+        if (recentsShown) return !item.isConversation
+        if (gesture?.holds(item) == true && item.taskView != null) return true
+        return !item.isConversation && !folded && settings.livePreviews
+    }
+
+    /**
+     * Attaches the task view of every shape that shows its app's screen and detaches the others
+     * once their screen has faded: a task is visible exactly while its view is attached, so apps
+     * in the rail or behind a card without a preview are in the background (WIN-6).
+     */
+    private fun syncTasks() {
+        var changed = false
+        for (item in items.values) {
+            val want = wantsContent(item)
+            if (want && item.taskView == null) {
+                attachTask(item)
+                changed = true
+            } else if (!want && item.taskView != null && item.content.value <= 0.001f) {
+                detachTask(item)
+                changed = true
+            }
+            val content = if (want && item.contentDrawn) 1f else 0f
+            if (item.content.target.toFloat() != content) {
+                item.content.to(content)
+                changed = true
+            }
+        }
+        updateCompositionOrder()
+        syncInput()
+        // The frame step calls this once everything rests: the clock starts again only for what
+        // this changed, or it would run every frame.
+        if (changed) clock.start()
+    }
+
+    private fun attachTask(item: LujarchSmallWindowItem) {
+        val btv = item.bubble.bubbleTaskView ?: return
+        val tv = btv.taskView
+        (tv.parent as? ViewGroup)?.let { if (it !== item.view) it.removeView(tv) }
+        listen(item)
+        tv.setSurfaceLifecycle(SurfaceView.SURFACE_LIFECYCLE_FOLLOWS_VISIBILITY)
+        tv.setCaptionInsets(null)
+        tv.setEnableSurfaceClipping(true)
+        tv.setZOrderedOnTop(false, true)
+        tv.visibility = VISIBLE
+        tv.alpha = 0f
+        if (tv.parent == null) {
+            item.view.addView(tv, 0, LayoutParams(item.taskW, item.taskH))
+        }
+        item.taskView = tv
+        item.view.onTaskViewChanged()
+        item.view.requestLayout()
+        updateCompositionOrder()
+    }
+
+    private fun detachTask(item: LujarchSmallWindowItem) {
+        val tv = item.taskView ?: return
+        item.taskView = null
+        item.contentDrawn = false
+        item.content.snap(0f)
+        if (tv.parent === item.view) item.view.removeView(tv)
+        item.view.onTaskViewChanged()
+    }
+
+    private fun onContentDrawn(item: LujarchSmallWindowItem, drawn: Boolean) {
+        item.contentDrawn = drawn
+        item.focusable = null
+        item.touchable = null
+        syncInput()
+        item.content.to(if (drawn && wantsContent(item)) 1f else 0f)
+        clock.start()
+    }
+
+    fun cardColor(item: LujarchSmallWindowItem): Int =
+        if (item.isConversation) conversationColor else placeholderColor
+
+    // ---------------------------------------------------------------------------------------
+    // What a person does with the windows, the cards, the dock and the rail
+
+    private fun openItem(item: LujarchSmallWindowItem) {
+        hideMenu()
+        if (item === open) return
+        controller.expandStackAndSelectBubble(item.bubble)
+    }
+
+    /** A tap on a small window's place in Recents' Running layer opens it (WIN-11). */
+    fun openSmallWindow(key: String) {
+        val item = items[key] ?: return
+        openItem(item)
+    }
+
+    private fun moveToDock() {
+        hideMenu()
+        controller.collapseStack()
+    }
+
+    private fun close(item: LujarchSmallWindowItem) {
+        hideMenu()
+        controller.dismissBubble(item.bubble, Bubbles.DISMISS_USER_GESTURE)
+    }
+
+    /**
+     * The app of a small window opens from its icon on the home screen or in the app drawer: the
+     * window, or its card or icon, grows into the full screen (WIN-2).
+     */
+    fun fullScreen(key: String) {
+        val item = items[key]
+        if (item == null) {
+            Log.w(TAG, "$key cannot go full screen: it is not a small window")
+            return
+        }
+        fullScreen(item)
+    }
+
+    /** Full screen (WIN-2): the small window becomes an ordinary app in Recents. */
+    private fun fullScreen(item: LujarchSmallWindowItem) {
+        hideMenu()
+        val tv = item.bubble.bubbleTaskView?.taskView
+        if (tv?.taskInfo == null || tv.controller?.taskToken == null) {
+            Log.w(TAG, "${item.bubble.key} cannot go full screen: its task is not known " +
+                "(view=${tv != null} info=${tv?.taskInfo != null})")
+            return
+        }
+        Log.i(TAG, "${item.bubble.key} (task ${item.taskId}) goes full screen")
+        growToFullScreen(item)
+        tv.moveToFullscreen()
+    }
+
+    /**
+     * The window, card or icon starts growing into the full screen at once and leaves the dock,
+     * which closes up; the app's surface takes over from where it is when the transition starts.
+     */
+    private fun growToFullScreen(item: LujarchSmallWindowItem) {
+        if (open === item) {
+            open = null
+            updateTouchMonitor()
+        }
+        dock.remove(item)
+        item.toFullScreen = true
+        item.view.elevation = dp(DRAG_Z)
+        item.startAt = SystemClock.uptimeMillis()
+        target(item, Frame(0f, -headerHeight, width.toFloat(), height + headerHeight, 0f, 0f, 1f,
+            0f), width.toFloat() / max(1, item.layoutW))
+        place(animate = true, stagger = true)
+        syncTasks()
+    }
+
+    /**
+     * A touch going down while a window is open: on the app below, it moves the window to the
+     * dock (WIN-3), or, with that switch off, gives the app below the focus; on the window, the
+     * window takes the focus back.
+     */
+    private fun onTouchBelow(x: Float, y: Float) {
+        val item = open ?: return
+        if (gesture != null) return
+        tmpRectF.set(item.x.value, item.y.value, item.x.value + item.w.value,
+            item.y.value + item.h.value)
+        tmpRectF.inset(-dp(EDGE_TOUCH), -dp(EDGE_TOUCH))
+        if (tmpRectF.contains(x, y)) {
+            belowTouched = false
+            syncInput()
+            return
+        }
+        if (y < statusBar || y > height - dp(GESTURE_AREA) || y >= imeTop) return
+        if (ownRegionContains(x, y)) return
+        if (settings.dockOnTouch) {
+            moveToDock()
+        } else {
+            belowTouched = true
+            syncInput()
+        }
+    }
+
+    /**
+     * Only the open window's task takes touches on its screen; the cards and Recents' slots show
+     * the app but their touches are the dock's and Recents' own. The open window's task may also
+     * take the focus, but not after a touch on the app below: Back, keys and the input method then
+     * go to the app being used.
+     */
+    private fun syncInput() {
+        for (item in items.values) {
+            val touchable = item === open && !recentsShown
+            val focusable = touchable && !belowTouched
+            if (item.focusable == focusable && item.touchable == touchable) continue
+            val task = item.bubble.bubbleTaskView?.taskView?.taskInfo ?: continue
+            item.focusable = focusable
+            item.touchable = touchable
+            val wct = WindowContainerTransaction()
+            wct.setFocusable(task.token, focusable)
+            wct.setTouchable(task.token, touchable)
+            controller.taskOrganizer.applyTransaction(wct)
+        }
+    }
+
+    private fun updateTouchMonitor() {
+        if (open != null && !recentsShown && visibility == VISIBLE && isAttachedToWindow) {
+            touchMonitor.start(display?.displayId ?: 0)
+        } else {
+            touchMonitor.stop()
+        }
+    }
+
+    private fun showMenu(item: LujarchSmallWindowItem) {
+        menuFor = item
+        val w = dp(MENU_W)
+        val h = dp(MENU_ITEM_H) * 3 + dp(12f)
+        val cx = item.x.value + item.w.value / 2
+        val left = (cx - w / 2).coerceIn(dp(8f), width - dp(8f) - w)
+        var top = item.y.value + headerHeight + dp(6f)
+        if (top + h > height - margin) top = max(topLimit, item.y.value - h - dp(6f))
+        menuRect.set(left, top, left + w, top + h)
+        place(animate = true)
+    }
+
+    private fun hideMenu() {
+        if (menuFor == null) return
+        menuFor = null
+        menuAlpha.to(0f)
+        if (!LujarchSpring.animated()) menuAlpha.snap(0f)
+        clock.start()
+    }
+
+    override fun dispatchDraw(canvas: Canvas) {
+        drawRail(canvas)
+        drawHandle(canvas)
+        super.dispatchDraw(canvas)
+        drawMenu(canvas)
+    }
+
+    private fun drawHandle(canvas: Canvas) {
+        val a = handleAlpha.value
+        if (a <= 0.01f) return
+        drawHandlePill(canvas, handleX.value + dp(HANDLE_W) / 2, handleY.value + dp(HANDLE_H) / 2, a)
+    }
+
+    /** A handle's pill, over the dock or a window: it floats over whatever is below it. */
+    fun drawHandlePill(canvas: Canvas, cx: Float, cy: Float, a: Float) {
+        val pw = dp(30f)
+        val ph = dp(5f)
+        tmpRectF.set(cx - pw / 2, cy - ph / 2, cx + pw / 2, cy + ph / 2)
+        paint.style = Paint.Style.FILL
+        paint.color = withAlpha(handlePillColor, a)
+        paint.setShadowLayer(dp(3f), 0f, dp(1f), Color.argb((90 * a).roundToInt(), 0, 0, 0))
+        canvas.drawRoundRect(tmpRectF, ph / 2, ph / 2, paint)
+        paint.clearShadowLayer()
+    }
+
+    private fun drawRail(canvas: Canvas) {
+        val a = railAlpha.value
+        if (a <= 0.01f) return
+        val bounds = railRect()
+        val r = dp(RAIL_W) / 2
+        // Rounded towards the middle of the screen, flat against the edge it rests at, and
+        // rounded all round while it is moved away from it.
+        val right = bounds.centerX() > width / 2f
+        val gap = if (right) width - bounds.right else bounds.left
+        val e = r * (gap / r).coerceIn(0f, 1f)
+        railRadii.fill(r)
+        val edgeCorners = if (right) intArrayOf(2, 3, 4, 5) else intArrayOf(0, 1, 6, 7)
+        for (i in edgeCorners) railRadii[i] = e
+        railPath.reset()
+        railPath.addRoundRect(bounds, railRadii, Path.Direction.CW)
+        paint.style = Paint.Style.FILL
+        paint.color = withAlpha(railColor, a * 0.94f)
+        paint.setShadowLayer(dp(9f), 0f, dp(3f), Color.argb((71 * a).roundToInt(), 0, 0, 0))
+        canvas.drawPath(railPath, paint)
+        paint.clearShadowLayer()
+    }
+
+    private fun drawMenu(canvas: Canvas) {
+        val a = menuAlpha.value
+        if (a <= 0.01f) return
+        val r = dp(16f)
+        paint.style = Paint.Style.FILL
+        paint.color = withAlpha(menuColor, a)
+        paint.setShadowLayer(dp(12f), 0f, dp(4f), Color.argb((115 * a).roundToInt(), 0, 0, 0))
+        canvas.drawRoundRect(menuRect, r, r, paint)
+        paint.clearShadowLayer()
+        paint.style = Paint.Style.STROKE
+        paint.strokeWidth = dp(1f)
+        paint.color = withAlpha(rimColor, a)
+        canvas.drawRoundRect(menuRect, r, r, paint)
+        paint.style = Paint.Style.FILL
+        menuPaint.color = withAlpha(menuTextColor, a)
+        val rowH = dp(MENU_ITEM_H)
+        for (i in 0..2) {
+            val top = menuRect.top + dp(6f) + i * rowH
+            val icon = menuIcons[i]
+            val size = dp(18f).roundToInt()
+            val il = (menuRect.left + dp(16f)).roundToInt()
+            val it = (top + (rowH - size) / 2).roundToInt()
+            icon?.setBounds(il, it, il + size, it + size)
+            icon?.setTint(withAlpha(conversationSubTextColor, a))
+            icon?.draw(canvas)
+            canvas.drawText(menuLabels[i], 0, menuLabels[i].length,
+                menuRect.left + dp(46f), top + rowH / 2 + menuPaint.textSize * 0.36f, menuPaint)
+        }
+    }
+
+    private fun withAlpha(color: Int, a: Float): Int =
+        Color.argb((Color.alpha(color) * a.coerceIn(0f, 1f)).roundToInt(), Color.red(color),
+            Color.green(color), Color.blue(color))
+
+    // ---------------------------------------------------------------------------------------
+    // Touches
+
+    private abstract inner class Gesture(val downX: Float, val downY: Float) {
+        var moved = false
+
+        open fun holds(item: LujarchSmallWindowItem): Boolean = false
+
+        fun move(ev: MotionEvent) {
+            if (!moved && hypot(ev.rawX - downX, ev.rawY - downY) < touchSlop) return
+            if (!moved) {
+                moved = true
+                hideMenu()
+                onStart()
+            }
+            onMove(ev.rawX - downX, ev.rawY - downY, ev.rawX, ev.rawY)
+        }
+
+        open fun onStart() {}
+
+        abstract fun onMove(dx: Float, dy: Float, x: Float, y: Float)
+
+        abstract fun onUp(vx: Float, vy: Float)
+
+        open fun onTap() {}
+
+        open fun onCancel() = onUp(0f, 0f)
+    }
+
+    /** The handle moves the window anywhere on the screen (WIN-2); a tap opens its menu. */
+    private inner class HeaderDrag(val item: LujarchSmallWindowItem, x: Float, y: Float) :
+        Gesture(x, y) {
+        private val startX = item.winX
+        private val startY = windowFrame(item).y
+
+        override fun holds(item: LujarchSmallWindowItem) = moved && item === this.item
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            val f = windowFrame(item)
+            item.winX = (startX + dx).coerceIn(margin, max(margin, width - margin - f.w))
+            item.winY = (startY + dy).coerceIn(topLimit, max(topLimit, bottomLimit - f.h))
+            item.x.snap(item.winX)
+            item.y.snap(item.winY)
+        }
+
+        override fun onUp(vx: Float, vy: Float) {
+            place(animate = true)
+        }
+
+        override fun onTap() {
+            if (menuFor === item) hideMenu() else showMenu(item)
+        }
+    }
+
+    /**
+     * Any edge changes the window's width or height and any corner both, at the window's scale:
+     * the app lays itself out at the new size once the finger lets go. Past the screen's limit,
+     * letting go shows the app full screen (WIN-2).
+     */
+    private inner class Resize(
+        val item: LujarchSmallWindowItem,
+        val edges: Int,
+        x: Float,
+        y: Float,
+    ) : Gesture(x, y) {
+        private val start = windowFrame(item)
+        private val scale = item.winScale
+        private val startLayoutW = item.layoutW
+        private val startLayoutH = item.layoutH
+        private val startX = item.winX
+        private val startY = item.winY
+        private var over = false
+
+        override fun holds(item: LujarchSmallWindowItem) = moved && item === this.item
+
+        override fun onStart() {
+            outlineAlpha = 1f
+            // The app's screen stays against the edges that do not move.
+            item.anchorRight = edges and EDGE_LEFT != 0
+            item.anchorBottom = edges and EDGE_TOP != 0
+        }
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            val minW = dp(MIN_W)
+            val minH = headerHeight + dp(MIN_H)
+            var left = start.x
+            var top = start.y
+            var right = start.x + start.w
+            var bottom = start.y + start.h
+            var past = false
+            if (edges and EDGE_RIGHT != 0) {
+                val want = right + dx
+                val limit = width - margin
+                past = past || want > limit + dp(OVERSHOOT)
+                right = clamp(want, left + minW, limit + rubber(want - limit))
+            }
+            if (edges and EDGE_LEFT != 0) {
+                val want = left + dx
+                val limit = margin
+                past = past || want < limit - dp(OVERSHOOT)
+                left = -clamp(-want, -(right - minW), -limit + rubber(limit - want))
+            }
+            if (edges and EDGE_BOTTOM != 0) {
+                val want = bottom + dy
+                val limit = bottomLimit
+                past = past || want > limit + dp(OVERSHOOT)
+                bottom = clamp(want, top + minH, limit + rubber(want - limit))
+            }
+            if (edges and EDGE_TOP != 0) {
+                val want = top + dy
+                val limit = topLimit
+                past = past || want < limit - dp(OVERSHOOT)
+                top = -clamp(-want, -(bottom - minH), -limit + rubber(limit - want))
+            }
+            over = past
+            item.winX = left
+            item.winY = top
+            item.layoutW = max(1, ((right - left) / scale).roundToInt())
+            item.layoutH = max(1, ((bottom - top - headerHeight) / scale).roundToInt())
+            snapItem(item, windowFrame(item), scale)
+            outlineAlpha = if (over) 1f else 0.95f
+            item.view.invalidate()
+        }
+
+        /** [v] kept between [lo] and [hi], [lo] winning when they cross. */
+        private fun clamp(v: Float, lo: Float, hi: Float): Float = max(lo, min(v, max(lo, hi)))
+
+        private fun rubber(past: Float): Float = if (past <= 0f) 0f else past * 0.2f
+
+        override fun onUp(vx: Float, vy: Float) {
+            outlineAlpha = OUTLINE_ALPHA
+            item.anchorRight = false
+            item.anchorBottom = false
+            if (over) {
+                // The window goes back to its size as it was, then becomes the app full screen.
+                item.layoutW = startLayoutW
+                item.layoutH = startLayoutH
+                item.winX = startX
+                item.winY = startY
+                place(animate = true)
+                fullScreen(item)
+                return
+            }
+            // Stretched a little past the limit, the window comes back to it at its new size.
+            val f = windowFrame(item)
+            val left = max(f.x, margin)
+            val top = max(f.y, topLimit)
+            val right = min(f.x + f.w, width - margin)
+            val bottom = min(f.y + f.h, bottomLimit)
+            item.winX = left
+            item.winY = top
+            item.layoutW = max(1, ((right - left) / scale).roundToInt())
+            item.layoutH = max(1, ((bottom - top - headerHeight) / scale).roundToInt())
+            fitWindow(item)
+            if (item.layoutW != item.taskW || item.layoutH != item.taskH) {
+                // The app lays itself out at the new size.
+                item.taskW = item.layoutW
+                item.taskH = item.layoutH
+                item.taskView?.layoutParams = LayoutParams(item.taskW, item.taskH)
+                item.view.requestLayout()
+            }
+            place(animate = true)
+        }
+    }
+
+    /**
+     * A card picked up: into the middle of the screen it opens there, onto the close circle it
+     * closes, back on the dock it takes that place in the stack (WIN-4).
+     */
+    private inner class CardDrag(val item: LujarchSmallWindowItem, x: Float, y: Float) :
+        Gesture(x, y) {
+        private val grabX = x - item.x.value
+        private val grabY = y - item.y.value
+        private var overClose = false
+
+        override fun holds(item: LujarchSmallWindowItem) = moved && item === this.item
+
+        override fun onStart() {
+            dismissView.show()
+            item.lift.to(DRAG_LIFT)
+            item.turn.to(0f)
+            updateCompositionOrder()
+        }
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            item.x.snap(x - grabX)
+            item.y.snap(y - grabY)
+            val circle = dismissView.circle
+            val cx = circle.x + dismissView.x + circle.width / 2f
+            val cy = circle.y + dismissView.y + circle.height / 2f
+            val near = hypot(x - cx, y - cy) < dp(CLOSE_RADIUS)
+            if (near != overClose) {
+                overClose = near
+                item.lift.to(if (near) CLOSE_LIFT else DRAG_LIFT)
+                circle.animate().scaleX(if (near) 1.15f else 1f).scaleY(if (near) 1.15f else 1f)
+                    .setDuration(200).start()
+            }
+            clock.start()
+        }
+
+        override fun onUp(vx: Float, vy: Float) {
+            dismissView.hide()
+            val x = item.x.value + grabX
+            val y = item.y.value + grabY
+            val edgeX = if (dockRight) width - dp(EDGE_COLUMN) else dp(EDGE_COLUMN)
+            when {
+                overClose -> close(item)
+                abs(x - edgeX) > dp(INTO_SCREEN) -> {
+                    // Opens where it was let go.
+                    val f = windowFrame(item)
+                    item.winX = x - f.w / 2
+                    item.winY = y - headerHeight
+                    fitWindow(item)
+                    if (folded) folded = false
+                    openItem(item)
+                }
+                else -> {
+                    val slot =
+                        ((y - grabY + dp(CARD_H) / 2 - dockTop - dp(CARD_FROM_HANDLE) -
+                            dp(CARD_H) / 2) / dp(CARD_STEP)).roundToInt()
+                    dock.remove(item)
+                    dock.add(slot.coerceIn(0, dock.size), item)
+                }
+            }
+            gesture = null
+            item.lift.to(1f)
+            place(animate = true, stagger = false)
+        }
+
+        override fun onTap() {
+            if (folded) {
+                folded = false
+                place(animate = true, stagger = true)
+                syncTasks()
+            } else {
+                openItem(item)
+            }
+        }
+    }
+
+    /**
+     * The handle above the top card: the dock follows the finger anywhere, its cards trailing,
+     * and settles against the nearer side edge with the fling, as Android's bubbles do; pushed
+     * past the screen's edge it folds into the rail (WIN-5, WIN-6).
+     */
+    private inner class DockDrag(x: Float, y: Float) : Gesture(x, y) {
+        private val startX = handleX.value
+        private val startY = handleY.value
+
+        override fun onStart() = startChain()
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            handleX.snap(startX + dx)
+            handleY.snap(startY + dy)
+            clock.start()
+        }
+
+        override fun onUp(vx: Float, vy: Float) {
+            val cardX = handleX.value - dp((CARD_W - HANDLE_W) / 2)
+            when {
+                cardX > width - dp(DOCK_MARGIN + CARD_W) + dp(FOLD_PUSH) -> {
+                    folded = true
+                    dockRight = true
+                }
+                cardX < dp(DOCK_MARGIN) - dp(FOLD_PUSH) -> {
+                    folded = true
+                    dockRight = false
+                }
+                else -> dockRight = restsRight(cardX + dp(CARD_W) / 2, vx)
+            }
+            dockTop = clampDockTop(handleY.value + flungBy(vy))
+            saveDock()
+            gesture = null
+            if (folded) {
+                // The cards fly into the rail from where they are.
+                chained = false
+                trail.clear()
+                place(animate = true, stagger = true)
+                syncTasks()
+                return
+            }
+            handleX.to(dockX() + dp((CARD_W - HANDLE_W) / 2), vx)
+            handleY.to(dockTop, vy)
+            place(animate = true)
+            syncTasks()
+        }
+
+        override fun onTap() {}
+    }
+
+    /**
+     * The rail: a tap unfolds the dock; a drag moves it anywhere, its icons trailing, and it
+     * settles against the nearer side edge with the fling (WIN-6).
+     */
+    private inner class RailDrag(x: Float, y: Float) : Gesture(x, y) {
+        private val startX = railX.value
+        private val startTop = railTop.value
+
+        override fun onStart() = startChain()
+
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {
+            railX.snap(startX + dx)
+            railTop.snap(startTop + dy)
+            clock.start()
+        }
+
+        override fun onUp(vx: Float, vy: Float) {
+            dockRight = restsRight(railX.value + dp(RAIL_W) / 2, vx)
+            dockTop = clampDockTop(railTop.value - dp(RAIL_FROM_HANDLE) + flungBy(vy))
+            saveDock()
+            gesture = null
+            railX.to(railRestX(), vx)
+            railTop.to(railTopFor(dockTop), vy)
+            place(animate = true)
+        }
+
+        override fun onTap() {
+            folded = false
+            place(animate = true, stagger = true)
+            syncTasks()
+        }
+    }
+
+    private inner class MenuTap(val index: Int, val item: LujarchSmallWindowItem, x: Float,
+        y: Float) : Gesture(x, y) {
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {}
+
+        override fun onUp(vx: Float, vy: Float) {}
+
+        override fun onTap() {
+            when (index) {
+                0 -> fullScreen(item)
+                1 -> moveToDock()
+                else -> close(item)
+            }
+        }
+    }
+
+    private inner class Outside(x: Float, y: Float) : Gesture(x, y) {
+        override fun onMove(dx: Float, dy: Float, x: Float, y: Float) {}
+
+        override fun onUp(vx: Float, vy: Float) {}
+
+        override fun onTap() = hideMenu()
+    }
+
+    private fun saveDock() {
+        dockTopFraction = dockTop / max(1, height)
+        prefs.edit().putBoolean(KEY_RIGHT, dockRight).putFloat(KEY_TOP, dockTopFraction).apply()
+    }
+
+    private fun hit(x: Float, y: Float): Gesture? {
+        menuFor?.let { item ->
+            if (menuRect.contains(x, y)) {
+                val i = ((y - menuRect.top - dp(6f)) / dp(MENU_ITEM_H)).toInt().coerceIn(0, 2)
+                return MenuTap(i, item, x, y)
+            }
+            return Outside(x, y)
+        }
+        open?.let { item ->
+            val f = windowFrame(item)
+            if (moveRect(f).contains(x, y)) return HeaderDrag(item, x, y)
+            val edges = grabbedEdges(f, x, y)
+            if (edges != 0) return Resize(item, edges, x, y)
+            if (x in f.x..f.x + f.w && y in f.y..f.y + f.h) return null
+        }
+        if (!folded) {
+            for (item in dock) {
+                if (itemRect(item).contains(x, y)) return CardDrag(item, x, y)
+            }
+            if (dock.isNotEmpty() && handleRect().contains(x, y)) return DockDrag(x, y)
+        } else if (dock.isNotEmpty() && railRect().contains(x, y)) {
+            return RailDrag(x, y)
+        }
+        return null
+    }
+
+    /** The handle along the window's top, round its pill: it moves the window (WIN-2). */
+    private fun moveRect(f: Frame): RectF {
+        val w = min(dp(MOVE_W), f.w - 2 * dp(CORNER_TOUCH))
+        val cx = f.x + f.w / 2
+        return RectF(cx - w / 2, f.y, cx + w / 2, f.y + headerHeight + dp(4f))
+    }
+
+    /**
+     * The edges a touch grabs: within 16 dp of an edge on either side, and both edges within
+     * 32 dp of a corner. The window's top edge is where the app's screen starts, under its
+     * handle (WIN-2).
+     */
+    private fun grabbedEdges(f: Frame, x: Float, y: Float): Int {
+        val e = dp(EDGE_TOUCH)
+        val c = dp(CORNER_TOUCH)
+        val left = f.x
+        val right = f.x + f.w
+        val top = f.y + headerHeight
+        val bottom = f.y + f.h
+        if (x < left - e || x > right + e || y < f.y || y > bottom + e) return 0
+        var edges = 0
+        val nearLeft = abs(x - left) <= e
+        val nearRight = abs(x - right) <= e
+        val nearTop = y <= top + e
+        val nearBottom = abs(y - bottom) <= e
+        if (nearLeft || nearRight) {
+            edges = if (nearLeft && (!nearRight || x - left < right - x)) EDGE_LEFT else EDGE_RIGHT
+            if (y < top + c) edges = edges or EDGE_TOP
+            else if (y > bottom - c) edges = edges or EDGE_BOTTOM
+        }
+        if (nearTop || nearBottom) {
+            edges = edges or if (nearTop) EDGE_TOP else EDGE_BOTTOM
+            if (x < left + c) edges = edges or EDGE_LEFT
+            else if (x > right - c) edges = edges or EDGE_RIGHT
+        }
+        return edges
+    }
+
+    private fun itemRect(item: LujarchSmallWindowItem): RectF =
+        RectF(item.x.value, item.y.value, item.x.value + item.w.value, item.y.value + item.h.value)
+
+    private fun handleRect(): RectF {
+        val extra = dp(8f)
+        return RectF(handleX.value, handleY.value - extra, handleX.value + dp(HANDLE_W),
+            handleY.value + dp(HANDLE_H))
+    }
+
+    /** The rail: around its icons while they trail its top. */
+    private fun railRect(): RectF {
+        val rect = RectF(railX.value, railTop.value, railX.value + dp(RAIL_W),
+            railTop.value + railHeight.value)
+        if (chained && folded) {
+            val ix = dp((RAIL_W - RAIL_ICON) / 2)
+            val iy = dp(RAIL_PAD)
+            for (item in dock) {
+                rect.union(item.x.value - ix, item.y.value - iy, item.x.value + item.w.value + ix,
+                    item.y.value + item.h.value + iy)
+            }
+        }
+        return rect
+    }
+
+    private fun ownRegionContains(x: Float, y: Float): Boolean {
+        if (!folded) {
+            if (dock.any { itemRect(it).contains(x, y) }) return true
+            if (dock.isNotEmpty() && handleRect().contains(x, y)) return true
+        } else if (dock.isNotEmpty() && railRect().contains(x, y)) {
+            return true
+        }
+        return menuFor != null && menuRect.contains(x, y)
+    }
+
+    override fun dispatchTouchEvent(ev: MotionEvent): Boolean {
+        when (ev.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                gesture = hit(ev.x, ev.y)
+                if (gesture == null) return super.dispatchTouchEvent(ev)
+                velocity?.recycle()
+                velocity = VelocityTracker.obtain()
+                velocity?.addMovement(ev)
+                // While a finger holds a shape, the whole screen follows it.
+                requestApplyTouchRegion()
+                clock.start()
+                return true
+            }
+            MotionEvent.ACTION_MOVE -> {
+                velocity?.addMovement(ev)
+                gesture?.move(ev) ?: return super.dispatchTouchEvent(ev)
+                return true
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                val g = gesture ?: return super.dispatchTouchEvent(ev)
+                velocity?.addMovement(ev)
+                velocity?.computeCurrentVelocity(1000)
+                val vx = velocity?.xVelocity ?: 0f
+                val vy = velocity?.yVelocity ?: 0f
+                velocity?.recycle()
+                velocity = null
+                if (ev.actionMasked == MotionEvent.ACTION_CANCEL) {
+                    if (g.moved) g.onCancel()
+                } else if (g.moved) {
+                    g.onUp(vx, vy)
+                } else {
+                    g.onTap()
+                }
+                if (gesture === g) gesture = null
+                requestApplyTouchRegion()
+                place(animate = true)
+                return true
+            }
+        }
+        return gesture != null || super.dispatchTouchEvent(ev)
+    }
+
+    /** The touchable region is computed again on the traversal an invalidation brings. */
+    private fun requestApplyTouchRegion() {
+        invalidate()
+    }
+
+    private var excluded: List<Rect> = emptyList()
+
+    /**
+     * A small window's side edges, the dock and the rail are dragged from the screen's edges, where
+     * Back takes a drag inwards: Back leaves them their drags.
+     */
+    private fun excludeFromBack() {
+        val rects = ArrayList<Rect>()
+        if (visibility == VISIBLE && items.isNotEmpty() && !recentsShown) {
+            open?.let { item ->
+                val f = windowFrame(item)
+                val e = dp(EDGE_TOUCH)
+                rects.add(rect(RectF(f.x - e, f.y, f.x + e, f.y + f.h + e)))
+                rects.add(rect(RectF(f.x + f.w - e, f.y, f.x + f.w + e, f.y + f.h + e)))
+            }
+            if (dock.isNotEmpty()) {
+                if (folded) {
+                    rects.add(rect(railRect()))
+                } else {
+                    val bounds = handleRect()
+                    for (item in dock) bounds.union(itemRect(item))
+                    rects.add(rect(bounds))
+                }
+            }
+        }
+        if (rects == excluded) return
+        excluded = rects
+        systemGestureExclusionRects = rects
+    }
+
+    /** The window takes touches on the handle, the corner, the edges, the cards and the rail. */
+    override fun onComputeInternalInsets(info: ViewTreeObserver.InternalInsetsInfo) {
+        excludeFromBack()
+        info.setTouchableInsets(ViewTreeObserver.InternalInsetsInfo.TOUCHABLE_INSETS_REGION)
+        val region = info.touchableRegion
+        region.setEmpty()
+        if (visibility != VISIBLE || items.isEmpty() || recentsShown) return
+        if (gesture != null || menuFor != null) {
+            region.set(0, 0, width, height)
+            return
+        }
+        if (!folded) {
+            for (item in dock) region.op(rect(itemRect(item)), Region.Op.UNION)
+            if (dock.isNotEmpty()) region.op(rect(handleRect()), Region.Op.UNION)
+        } else if (dock.isNotEmpty()) {
+            region.op(rect(railRect()), Region.Op.UNION)
+        }
+        open?.let { item ->
+            val f = windowFrame(item)
+            val left = f.x.roundToInt()
+            val top = f.y.roundToInt()
+            val right = (f.x + f.w).roundToInt()
+            val bottom = (f.y + f.h).roundToInt()
+            val screenTop = (f.y + headerHeight).roundToInt()
+            val e = dp(EDGE_TOUCH).roundToInt()
+            // The app's screen takes its own touches...
+            region.op(left, top, right, bottom, Region.Op.DIFFERENCE)
+            // ...apart from the handle and the edges.
+            region.op(left - e, top, right + e, screenTop + e, Region.Op.UNION)
+            region.op(left - e, top, left + e, bottom + e, Region.Op.UNION)
+            region.op(right - e, top, right + e, bottom + e, Region.Op.UNION)
+            region.op(left - e, bottom - e, right + e, bottom + e, Region.Op.UNION)
+        }
+    }
+
+    private fun rect(r: RectF): Rect {
+        r.roundOut(tmpRect)
+        return Rect(tmpRect)
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The input method
+
+    fun setImeVisible(visible: Boolean, imeHeight: Int) {
+        imeTop = if (visible && imeHeight > 0) height - imeHeight else Int.MAX_VALUE
+        place(animate = true)
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Transitions into a small window (BubbleTransitions)
+
+    override fun isExpanded(): Boolean = open != null
+
+    override fun canExpandView(bubble: BubbleViewProvider): Boolean =
+        (bubble as? Bubble)?.bubbleTaskView != null
+
+    override fun prepareConvertedView(bubble: BubbleViewProvider): BubbleViewProvider? {
+        val b = bubble as? Bubble ?: return null
+        val item = items[b.key] ?: return null
+        val prior = open?.bubble?.takeIf { it !== b }
+        if (open !== item) {
+            open?.let { dock.add(0, it) }
+            dock.remove(item)
+            open = item
+            item.view.elevation = dp(WINDOW_Z)
+            updateTouchMonitor()
+        }
+        attachTask(item)
+        return prior
+    }
+
+    override fun animateConvert(
+        startT: SurfaceControl.Transaction,
+        startBounds: Rect,
+        startScale: Float,
+        snapshot: SurfaceControl?,
+        taskLeash: SurfaceControl?,
+        animFinish: Runnable,
+    ) {
+        startT.apply()
+        val item = open
+        if (item == null) {
+            snapshot?.let { removeSnapshot(it) }
+            animFinish.run()
+            return
+        }
+        val card = item.fromCard
+        item.fromCard = null
+        if (card != null) {
+            // The Recents card grows into the window.
+            snapItem(item, Frame(card.left.toFloat(), card.top.toFloat(), card.width().toFloat(),
+                card.height().toFloat(), dp(CARD_RADIUS), 0f, 0f, 0f),
+                fitScale(item, card.width().toFloat(), card.height().toFloat()))
+        } else {
+            // The app's full screen shrinks into the window: one shape changing place and size.
+            val scale = startBounds.width() * startScale / max(1, item.layoutW)
+            snapItem(item,
+                Frame(startBounds.left.toFloat(), startBounds.top.toFloat() - headerHeight,
+                    startBounds.width() * startScale, startBounds.height() * startScale +
+                    headerHeight, 0f, 0f, 1f, 0f), scale)
+        }
+        item.alpha.snap(1f)
+        item.lift.snap(1f)
+        item.contentDrawn = true
+        item.content.snap(1f)
+        place(animate = true)
+        snapshot?.let { postDelayed({ removeSnapshot(it) }, SNAPSHOT_MS) }
+        whenAtRest(item) { animFinish.run() }
+    }
+
+    override fun animateExpand(previousBubble: BubbleViewProvider?, animFinish: Runnable?) {
+        val item = open
+        if (item == null) {
+            animFinish?.run()
+            return
+        }
+        place(animate = true, stagger = true)
+        syncTasks()
+        if (animFinish != null) whenAtRest(item) { animFinish.run() }
+    }
+
+    override fun removeViewFromTransition(view: View?) {}
+
+    override fun cancelAnimation(): WindowAnimationState? = null
+
+    private fun removeSnapshot(snapshot: SurfaceControl) {
+        if (!snapshot.isValid) return
+        SurfaceControl.Transaction().remove(snapshot).apply()
+    }
+
+    private fun whenAtRest(item: LujarchSmallWindowItem, action: () -> Unit) {
+        val check =
+            object : Runnable {
+                override fun run() {
+                    if (item.springs.all { it.atRest } || !isAttachedToWindow) action()
+                    else postDelayed(this, 16)
+                }
+            }
+        post(check)
+    }
+
+    /**
+     * Full screen (WIN-2): the task leaves the window, and its surface grows from where the
+     * window, its card or its icon shows it to the whole screen along the same spring.
+     */
+    fun animateToFullscreen(
+        bubble: Bubble,
+        change: TransitionInfo.Change,
+        info: TransitionInfo,
+        startT: SurfaceControl.Transaction,
+        onPlucked: Runnable,
+        finish: Runnable,
+    ) {
+        val item = items[bubble.key]
+        val leash = change.leash
+        val root = info.getRoot(0).leash
+        if (item == null || !leash.isValid) {
+            startT.apply()
+            onPlucked.run()
+            finish.run()
+            return
+        }
+        val start = item.view.screenPlace(headerHeight)
+        val end = change.endAbsBounds
+        val offset = info.getRoot(0).offset
+        // The app has drawn itself at the full screen's size by now: that screen starts as wide
+        // as the window shows the app, cut to its height, so no size jumps when it takes over.
+        val shownW = start[4] * start[2]
+        val shownH = start[5] * start[3]
+        val k = shownW / max(1, end.width())
+        val x = LujarchSpring(start[0])
+        val y = LujarchSpring(start[1])
+        val scaleX = LujarchSpring(k)
+        val scaleY = LujarchSpring(k)
+        val cropW = LujarchSpring(end.width().toFloat())
+        val cropH = LujarchSpring(min(end.height().toFloat(), shownH / max(k, 0.01f)))
+        val radius = LujarchSpring(start[6])
+        x.to((end.left - offset.x).toFloat())
+        y.to((end.top - offset.y).toFloat())
+        scaleX.to(1f)
+        scaleY.to(1f)
+        cropW.to(end.width().toFloat())
+        cropH.to(end.height().toFloat())
+        radius.to(0f)
+        startT.reparent(leash, root)
+            .setPosition(leash, x.value, y.value)
+            .setMatrix(leash, scaleX.value, 0f, 0f, scaleY.value)
+            .setWindowCrop(leash, cropW.value.roundToInt(), cropH.value.roundToInt())
+            .setCornerRadius(leash, radius.value / max(min(scaleX.value, scaleY.value), 0.01f))
+            .setAlpha(leash, 1f)
+            .setLayer(leash, Int.MAX_VALUE)
+            .show(leash)
+            .apply()
+        item.view.visibility = INVISIBLE
+        onPlucked.run()
+        val springs = arrayOf(x, y, scaleX, scaleY, cropW, cropH, radius)
+        if (!LujarchSpring.animated()) springs.forEach { it.snap(it.target.toFloat()) }
+        val t = SurfaceControl.Transaction()
+        LujarchFrameClock { ms ->
+            springs.forEach {
+                it.step(ms, if (it === scaleX || it === scaleY) 0.002 else 0.5)
+            }
+            if (!leash.isValid) {
+                finish.run()
+                return@LujarchFrameClock false
+            }
+            val k = max(min(scaleX.value, scaleY.value), 0.01f)
+            t.setPosition(leash, x.value, y.value)
+                .setMatrix(leash, scaleX.value, 0f, 0f, scaleY.value)
+                .setWindowCrop(leash, cropW.value.roundToInt(), cropH.value.roundToInt())
+                .setCornerRadius(leash, radius.value / k)
+                .apply()
+            val moving = springs.any { !it.atRest }
+            if (!moving) {
+                t.setMatrix(leash, 1f, 0f, 0f, 1f).setWindowCrop(leash, end.width(), end.height())
+                    .setCornerRadius(leash, 0f).apply()
+                finish.run()
+            }
+            moving
+        }.start()
+    }
+
+    fun dump(pw: java.io.PrintWriter, prefix: String) {
+        pw.println("${prefix}LujarchSmallWindows:")
+        pw.println("$prefix  open=${open?.bubble?.key} folded=$folded right=$dockRight " +
+            "top=$dockTop limit=${settings.maxWindows} live=${settings.livePreviews} " +
+            "handle=${handleX.value.roundToInt()},${handleY.value.roundToInt()} " +
+            "rail=${railX.value.roundToInt()},${railTop.value.roundToInt()} chained=$chained")
+        for (item in items.values) {
+            pw.println("$prefix  ${item.bubble.key} dock=${dock.indexOf(item)} " +
+                "frame=${item.x.value.roundToInt()},${item.y.value.roundToInt()} " +
+                "${item.w.value.roundToInt()}x${item.h.value.roundToInt()} " +
+                "layout=${item.layoutW}x${item.layoutH} scale=${item.winScale} " +
+                "task=${item.taskView?.taskInfo?.taskId} drawn=${item.contentDrawn} " +
+                "unread=${item.unread} counts=${item.counts}")
+        }
+    }
+
+    companion object {
+        private const val TAG = "lujarch_windows"
+        private const val PREFS = "lujarch_small_windows"
+        private const val KEY_RIGHT = "dock_right"
+        private const val KEY_TOP = "dock_top"
+
+        // dp, from the design of target/windows.md
+        const val CARD_W = 108f
+        const val CARD_H = 150f
+        const val CARD_RADIUS = 20f
+        /** Each card covers the top of the one below by a sixth of its height. */
+        const val CARD_STEP = 125f
+        const val CARD_FROM_HANDLE = 30f
+        const val DOCK_MARGIN = 10f
+        const val DOCK_TOP = 200f
+        const val HANDLE_W = 56f
+        const val HANDLE_H = 26f
+        const val HEADER = 22f
+        const val WINDOW_RADIUS = 22f
+        const val WINDOW_W = 258f
+        const val WINDOW_X = 12f
+        const val WINDOW_Y = 124f
+        const val MIN_W = 160f
+        const val MIN_H = 120f
+        const val MARGIN = 12f
+        /** Past the limit by this much a release shows the app full screen: within MARGIN. */
+        const val OVERSHOOT = 8f
+        const val RAIL_W = 34f
+        const val RAIL_ICON = 22f
+        const val RAIL_STEP = 32f
+        const val RAIL_PAD = 16f
+        const val RAIL_FROM_HANDLE = 20f
+        const val FOLD_PUSH = 40f
+        const val EDGE_COLUMN = 118f
+        const val INTO_SCREEN = 120f
+        const val CLOSE_RADIUS = 60f
+        /** Each edge of a window takes a drag within this much of it, on either side. */
+        const val EDGE_TOUCH = 16f
+        const val CORNER_TOUCH = 32f
+        /** The part of a window's handle round its pill that moves the window. */
+        const val MOVE_W = 96f
+        const val GESTURE_AREA = 24f
+        const val MENU_W = 176f
+        const val MENU_ITEM_H = 48f
+        const val CARD_Z = 8f
+        const val WINDOW_Z = 16f
+        const val DISMISS_Z = 20f
+        const val DRAG_Z = 24f
+        const val DRAG_LIFT = 1.06f
+        const val CLOSE_LIFT = 0.82f
+        const val OUTLINE_ALPHA = 0.85f
+        const val SNAPSHOT_MS = 150L
+        const val RECENTS_TILE_H = 56f
+        const val RECENTS_GAP = 10f
+        const val RECENTS_TOP = 16f
+        /** A card's turn of 16 degrees, as the width a turned card shows. */
+        const val TURN_SCALE = 0.92f
+        /** The margin round an app's screen on its card, and that screen's corners. */
+        const val CARD_INSET = 6f
+        const val CARD_SCREEN_RADIUS = 8f
+
+        // The edges a resize moves.
+        const val EDGE_LEFT = 1
+        const val EDGE_TOP = 2
+        const val EDGE_RIGHT = 4
+        const val EDGE_BOTTOM = 8
+
+        // Android's bubble stack: the release speed in pixels per second that carries it to the
+        // other side, and its fling friction (StackAnimationController).
+        const val ESCAPE_VELOCITY = 750f
+        const val FLING_FRICTION = 1.9f
+    }
+}
