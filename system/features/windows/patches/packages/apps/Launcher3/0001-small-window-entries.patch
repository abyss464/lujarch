index 0000000000000000000000000000000000000000..212f32e4b4b194d65b653cf58a0b459abc5fd131
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/LujarchSmallWindows.kt
@@ -0,0 +1,173 @@
