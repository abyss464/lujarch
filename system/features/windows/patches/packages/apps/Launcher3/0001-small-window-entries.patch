+
+package com.android.quickstep
+
+import android.content.Context
+import android.content.Intent
+import android.graphics.Matrix
+import android.graphics.Rect
+import android.graphics.RectF
+import android.os.Bundle
+import android.os.Handler
+import android.os.IRemoteCallback
+import android.os.Looper
+import android.os.RemoteException
+import android.provider.Settings
+import android.util.Log
+import com.android.internal.app.LujarchBackground
+import com.android.launcher3.LauncherSettings.Favorites.ITEM_TYPE_APPLICATION
+import com.android.launcher3.model.data.ItemInfo
+import com.android.launcher3.uioverrides.QuickstepLauncher
+import com.android.quickstep.lujarch.LujarchRecents
+import com.android.quickstep.views.TaskView
+
+/**
+ * The home screen's and Recents' entries to small windows (target/windows.md): their switches in
+ * Settings > Display > Small windows, and opening a Recents task in a small window.
+ */
+object LujarchSmallWindows {
+    private const val TAG = "lujarch_windows"
+    private const val KEY_HOME = "lujarch_windows_home"
+    private const val KEY_RECENTS = "lujarch_windows_recents"
+    /** The longest Recents waits for the Shell to show the card's picture. */
+    private const val STAND_IN_WAIT_MS = 250L
+
+    private fun on(context: Context, key: String): Boolean {
+        val resolver = context.contentResolver
+        return Settings.Secure.getInt(resolver, Settings.Secure.NOTIFICATION_BUBBLES, 1) != 0 &&
+            Settings.Secure.getInt(resolver, key, 1) != 0
+    }
+
+    /** Small window in an app's menu on the home screen and in the app drawer (WIN-10). */
+    @JvmStatic fun isHomeEntryOn(context: Context): Boolean = on(context, KEY_HOME)
+
+    /** Open in small window in a Recents card's menu, and dropping a card on Running (WIN-11). */
+    @JvmStatic fun isRecentsEntryOn(context: Context): Boolean = on(context, KEY_RECENTS)
+
+    private var recentsShown = false
+    private var slotKeys = emptyArray<String>()
+    private var slots = emptyArray<Rect>()
+
+    private fun reportRecents(context: Context, shown: Boolean) {
+        if (shown == recentsShown) return
+        recentsShown = shown
+        SystemUiProxy.INSTANCE.get(context).setSmallWindowsRecentsShown(shown, slotKeys, slots)
+    }
+
+    /** While Recents shows, the small windows wait in its Running layer (WIN-11). */
+    @JvmStatic
+    fun followRecents(launcher: QuickstepLauncher) {
+        // Linux in front of the home screen: the small windows step aside (LNX-3). The face is
+        // made once the home screen's views are, after this.
+        launcher.rootView.post {
+            val face = launcher.linuxFace ?: return@post
+            val proxy = SystemUiProxy.INSTANCE.get(launcher)
+            face.onFront = { front -> proxy.setSmallWindowsHidden(front) }
+            proxy.setSmallWindowsHidden(face.inFront)
+        }
+        // The Running layer lays out where each small window waits; the Shell flies them there.
+        LujarchRecents.smallWindowSlots = { keys, rects ->
+            if (!keys.contentEquals(slotKeys) || !rects.contentEquals(slots)) {
+                slotKeys = keys
+                slots = rects
+                if (recentsShown) {
+                    SystemUiProxy.INSTANCE.get(launcher)
+                        .setSmallWindowsRecentsShown(true, keys, rects)
+                }
+            }
+        }
+        LujarchRecents.openSmallWindow = { key ->
+            SystemUiProxy.INSTANCE.get(launcher).openSmallWindow(key)
+        }
+        LujarchRecents.openTaskInSmallWindow = { taskView, taskId -> openTask(taskView, taskId) }
+        LujarchRecents.canOpenInSmallWindow = { isRecentsEntryOn(launcher) }
+        // They go part of their way with the swipe to Recents and fly on when it settles.
+        LujarchRecents.recentsSettled = { settled -> reportRecents(launcher, settled) }
+        LujarchRecents.swipeProgress = { progress ->
+            if (!recentsShown) {
+                SystemUiProxy.INSTANCE.get(launcher)
+                    .setSmallWindowsRecentsProgress(progress, slotKeys, slots)
+            }
+        }
+    }
+
+    /**
+     * An app's icon on the home screen or in the app drawer opens the app full screen: when the
+     * app is in a small window, open, in the dock or in the rail, that window grows into the full
+     * screen from where it is (WIN-2). Returns whether it did.
+     */
+    @JvmStatic
+    fun showFullscreen(context: Context, intent: Intent, item: ItemInfo?): Boolean {
+        if (item == null || item.itemType != ITEM_TYPE_APPLICATION) return false
+        val app = intent.component?.packageName ?: intent.`package` ?: return false
+        val user = item.user.identifier
+        val window =
+            try {
+                LujarchBackground.get()?.smallWindows.orEmpty().firstOrNull {
+                    !it.conversation && it.packageName == app && it.userId == user
+                }
+            } catch (e: RemoteException) {
+                Log.w(TAG, "the small windows cannot be read; $app opens as usual", e)
+                null
+            } ?: return false
+        Log.i(TAG, "$app opens full screen from its small window ${window.key}")
+        SystemUiProxy.INSTANCE.get(context).moveSmallWindowToFullscreen(window.key)
+        return true
+    }
+
+    /** The home screen and Recents are no longer on the screen. */
+    @JvmStatic
+    fun onLauncherStopped(launcher: QuickstepLauncher) = reportRecents(launcher, false)
+
+    /**
+     * Opens the task of a Recents card in a small window: the window grows out of the card, and
+     * Recents leaves as a tap outside the cards leaves it, once the card's picture stands in for
+     * the card, so that no frame shows neither.
+     */
+    @JvmStatic
+    fun openTask(taskView: TaskView, taskId: Int) {
+        val recentsView = taskView.recentsView
+        val main = Handler(Looper.getMainLooper())
+        var left = false
+        val leave = Runnable {
+            if (!left) {
+                left = true
+                recentsView?.startHome()
+            }
+        }
+        SystemUiProxy.INSTANCE.get(taskView.context)
+            .showTaskInSmallWindow(taskId, cardOnScreen(taskView), object : IRemoteCallback.Stub() {
+                override fun sendResult(data: Bundle?) {
+                    main.post(leave)
+                }
+            })
+        main.postDelayed(leave, STAND_IN_WAIT_MS)
+    }
+
+    /** The whole card on the screen, also the part of a card at an edge that is off it. */
+    private fun cardOnScreen(taskView: TaskView): Rect? {
+        if (!taskView.isAttachedToWindow || taskView.width <= 0) return null
+        val m = Matrix()
+        taskView.transformMatrixToGlobal(m)
+        val r = RectF(0f, 0f, taskView.width.toFloat(), taskView.height.toFloat())
+        m.mapRect(r)
+        val at = IntArray(2)
+        taskView.rootView.getLocationOnScreen(at)
+        r.offset(at[0].toFloat(), at[1].toFloat())
+        return Rect().also { r.round(it) }
+    }
+}
