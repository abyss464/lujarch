+    /** Open in small window. */
+    TaskShortcutFactory SMALL_WINDOW = new TaskShortcutFactory() {
+        @Override
+        public List<SystemShortcut> getShortcuts(RecentsViewContainer container,
+                TaskContainer taskContainer) {
+            if (!LujarchSmallWindows.isRecentsEntryOn(container.asContext())) {
+                return null;
+            }
+            final Task task = taskContainer.getTask();
+            if ((task.key.baseIntent.getFlags() & FLAG_ACTIVITY_EXCLUDE_FROM_RECENTS) != 0) {
+                return null;
+            }
+            return Collections.singletonList(new SmallWindowSystemShortcut(container,
+                    taskContainer));
+        }
+    };
+
+    class SmallWindowSystemShortcut extends SystemShortcut<RecentsViewContainer> {
+        private final TaskContainer mTaskContainer;
+
+        SmallWindowSystemShortcut(RecentsViewContainer container, TaskContainer taskContainer) {
+            super(R.drawable.ic_bubble_button, R.string.lujarch_open_in_small_window, container,
+                    taskContainer.getItemInfo(), taskContainer.getTaskView());
+            mTaskContainer = taskContainer;
+        }
+
+        @Override
+        public void onClick(View view) {
+            dismissTaskMenuView();
+            LujarchSmallWindows.openTask(mTaskContainer.getTaskView(),
+                    mTaskContainer.getTask().key.id);
+        }
+    }
+
