+    fun setSmallWindowsRecentsShown(shown: Boolean, keys: Array<String>, slots: Array<Rect>) =
+        executeWithErrorLog({ "Failed call setRecentsShown" }) {
+            bubbles?.setRecentsShown(shown, keys, slots)
+        }
+
+    fun setSmallWindowsRecentsProgress(progress: Float, keys: Array<String>, slots: Array<Rect>) =
+        executeWithErrorLog({ "Failed call setRecentsProgress" }) {
+            bubbles?.setRecentsProgress(progress, keys, slots)
+        }
+
+    /** Tells the Shell to open the small window of a bubble, from its place in Recents. */
+    fun openSmallWindow(key: String) =
+        executeWithErrorLog({ "Failed call openSmallWindow" }) {
+            bubbles?.openSmallWindow(key)
+        }
+
+    /** Tells the Shell to show the app of a small window full screen, growing out of it. */
+    fun moveSmallWindowToFullscreen(key: String) =
+        executeWithErrorLog({ "Failed call moveSmallWindowToFullscreen" }) {
+            bubbles?.moveSmallWindowToFullscreen(key)
+        }
+
+    /** Tells the Shell whether Linux is in front, for the small windows to step aside. */
+    fun setSmallWindowsHidden(hidden: Boolean) =
+        executeWithErrorLog({ "Failed call setSmallWindowsHidden" }) {
+            bubbles?.setSmallWindowsHidden(hidden)
+        }
+
+    /**
+     * Tells the Shell to show a running task in a small window, growing out of from; shown is told
+     * once the card's picture stands in for the card.
+     */
+    fun showTaskInSmallWindow(taskId: Int, from: Rect?, shown: IRemoteCallback?) =
+        executeWithErrorLog({ "Failed call showTaskInSmallWindow" }) {
+            bubbles?.showTaskInSmallWindow(taskId, from, shown)
+        }
+
     /** Tells SysUI to show the expanded view. */
     fun showExpandedView() =
         executeWithErrorLog({ "Failed call showExpandedView" }) { bubbles?.showExpandedView() }
