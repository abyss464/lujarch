+    /** Tells the Shell whether Recents shows, for the small windows to wait in it. */
+    fun setSmallWindowsRecentsShown(shown: Boolean) =
+        executeWithErrorLog({ "Failed call setRecentsShown" }) {
+            bubbles?.setRecentsShown(shown)
+        }
+
+    /** Tells the Shell to show a running task in a small window. */
+    fun showTaskInSmallWindow(taskId: Int) =
+        executeWithErrorLog({ "Failed call showTaskInSmallWindow" }) {
+            bubbles?.showTaskInSmallWindow(taskId)
+        }
