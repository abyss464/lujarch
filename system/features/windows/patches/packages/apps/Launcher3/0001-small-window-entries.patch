+
+package com.android.quickstep
+
+import android.content.Context
+import android.provider.Settings
+import android.util.Log
+import com.android.launcher3.LauncherState
+import com.android.launcher3.statemanager.StateManager
+import com.android.launcher3.uioverrides.QuickstepLauncher
+import com.android.quickstep.views.TaskView
+
+/**
+ * The home screen's and Recents' entries to small windows (target/windows.md): their switches in
+ * Settings > Display > Small windows, and opening a Recents task in a small window.
+ */
+object LujarchSmallWindows {
+    private const val TAG = "lujarch_windows"
+    private const val KEY_HOME = "lujarch_windows_home"
+    private const val KEY_RECENTS = "lujarch_windows_recents"
+
+    private fun on(context: Context, key: String): Boolean {
+        val resolver = context.contentResolver
+        return Settings.Secure.getInt(resolver, Settings.Secure.NOTIFICATION_BUBBLES, 1) != 0 &&
+            Settings.Secure.getInt(resolver, key, 1) != 0
+    }
+
+    /** Small window in an app's menu on the home screen and in the app drawer (WIN-10). */
+    @JvmStatic fun isHomeEntryOn(context: Context): Boolean = on(context, KEY_HOME)
+
+    /** Open in small window in a Recents card's menu, and dropping a card on Running (WIN-11). */
+    @JvmStatic fun isRecentsEntryOn(context: Context): Boolean = on(context, KEY_RECENTS)
+
+    private var recentsShown = false
+
+    private fun reportRecents(context: Context, shown: Boolean) {
+        if (shown == recentsShown) return
+        recentsShown = shown
+        SystemUiProxy.INSTANCE.get(context).setSmallWindowsRecentsShown(shown)
+    }
+
+    /** While Recents shows, the small windows wait in its Running layer (WIN-11). */
+    @JvmStatic
+    fun followRecents(launcher: QuickstepLauncher) {
+        launcher.stateManager.addStateListener(
+            object : StateManager.StateListener<LauncherState> {
+                override fun onStateTransitionStart(toState: LauncherState) =
+                    reportRecents(launcher, toState.isRecentsViewVisible)
+
+                override fun onStateTransitionComplete(finalState: LauncherState) =
+                    reportRecents(launcher, finalState.isRecentsViewVisible)
+            }
+        )
+    }
+
+    /** The home screen and Recents are no longer on the screen. */
+    @JvmStatic
+    fun onLauncherStopped(launcher: QuickstepLauncher) = reportRecents(launcher, false)
+
+    /**
+     * Opens the task of a Recents card in a small window: the task comes forward as a tap on its
+     * card brings it, then the Shell turns it into a small window.
+     */
+    @JvmStatic
+    fun openTask(taskView: TaskView, taskId: Int) {
+        val proxy = SystemUiProxy.INSTANCE.get(taskView.context)
+        val launched = taskView.launchWithAnimation()
+        if (launched == null) {
+            Log.w(TAG, "task $taskId did not launch; it opens in a small window as it is")
+            proxy.showTaskInSmallWindow(taskId)
+            return
+        }
+        launched.add { proxy.showTaskInSmallWindow(taskId) }
+    }
+}
