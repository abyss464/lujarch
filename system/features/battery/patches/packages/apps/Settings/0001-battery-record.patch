+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.text.format.DateUtils;
+import android.text.format.Formatter;
+
+import com.android.settings.R;
+
+import java.text.NumberFormat;
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.Locale;
+
+/**
+ * Lujarch battery record (BAT-1): how the record pages write numbers. A number and its
+ * unit stay on one line (no-break space), as in the Chinese typography of docs/design.md.
+ */
+final class RecordFormat {
+
+    private static final String NBSP = " ";
+
+    private RecordFormat() {}
+
+    /** "3,713 mAh"; under 1 mAh "<1 mAh". */
+    static String mah(Context context, double mah) {
+        if (mah < 0.5) {
+            return context.getString(R.string.lujarch_battery_less_than_mah);
+        }
+        return NumberFormat.getIntegerInstance().format(Math.round(mah)) + NBSP + "mAh";
+    }
+
+    /** "1.2 W" from 1 W up, else "94 mW". */
+    static String power(Context context, double watts) {
+        if (watts >= 1) {
+            final NumberFormat f = NumberFormat.getNumberInstance();
+            f.setMaximumFractionDigits(1);
+            f.setMinimumFractionDigits(1);
+            return f.format(watts) + NBSP + "W";
+        }
+        return NumberFormat.getIntegerInstance().format(Math.round(watts * 1000)) + NBSP + "mW";
+    }
+
+    /** "5 hr 58 min"; "0 min" for none, "under 1 min" for less than half a minute. */
+    static String duration(Context context, long ms) {
+        if (ms <= 0) {
+            return context.getString(R.string.lujarch_battery_duration_m, 0);
+        }
+        if (ms < 30_000L) {
+            return context.getString(R.string.lujarch_battery_duration_less_than_minute);
+        }
+        final long minutes = Math.round(ms / 60000.0);
+        final long h = minutes / 60;
+        final long m = minutes % 60;
+        if (h > 0 && m > 0) {
+            return context.getString(R.string.lujarch_battery_duration_hm, h, m);
+        }
+        if (h > 0) {
+            return context.getString(R.string.lujarch_battery_duration_h, h);
+        }
+        return context.getString(R.string.lujarch_battery_duration_m, m);
+    }
+
+    /** Like {@link #duration} but with seconds under a minute. */
+    static String shortDuration(Context context, long ms) {
+        if (ms < 60_000L) {
+            return context.getString(R.string.lujarch_battery_duration_s,
+                    Math.max(1, Math.round(ms / 1000.0)));
+        }
+        return duration(context, ms);
+    }
+
+    /** "3%" of the battery for a share of the capacity; under 1% "<1%". */
+    static String percent(double percent) {
+        if (percent > 0 && percent < 1) {
+            return "<" + NumberFormat.getPercentInstance().format(0.01);
+        }
+        return NumberFormat.getPercentInstance().format(Math.round(percent) / 100.0);
+    }
+
+    static String bytes(Context context, long bytes) {
+        return Formatter.formatFileSize(context, bytes);
+    }
+
+    static String clock(long wallMs) {
+        final ZonedDateTime t = Instant.ofEpochMilli(wallMs).atZone(ZoneId.systemDefault());
+        return String.format(Locale.ROOT, "%02d:%02d", t.getHour(), t.getMinute());
+    }
+
+    /** "16:00 - 17:00" for the hour that starts at {@code hourStart}. */
+    static String hourSpan(long hourStart, long hourEnd) {
+        final ZonedDateTime a = Instant.ofEpochMilli(hourStart).atZone(ZoneId.systemDefault());
+        final ZonedDateTime b = Instant.ofEpochMilli(hourEnd).atZone(ZoneId.systemDefault());
+        return String.format(Locale.ROOT, "%02d:%02d - %02d:%02d", a.getHour(), a.getMinute(),
+                b.getHour(), b.getMinute());
+    }
+
+    /** "Today" or the date of the day that starts at {@code dayStart}. */
+    static String dayTitle(Context context, long dayStart, boolean today) {
+        if (today) {
+            return context.getString(R.string.lujarch_battery_today);
+        }
+        return DateUtils.formatDateTime(context, dayStart,
+                DateUtils.FORMAT_SHOW_DATE | DateUtils.FORMAT_NO_YEAR);
+    }
+
+    /** The short weekday of the day that starts at {@code dayStart}, such as "Mon". */
+    static String weekday(long dayStart) {
+        return Instant.ofEpochMilli(dayStart).atZone(ZoneId.systemDefault()).getDayOfWeek()
+                .getDisplayName(java.time.format.TextStyle.SHORT, Locale.getDefault());
+    }
+}
