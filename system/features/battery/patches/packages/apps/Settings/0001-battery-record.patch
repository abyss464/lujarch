+     See the License for the specific language governing permissions and
+     limitations under the License.
+-->
+
+<!-- Lujarch battery record (BAT-1): the two-tier chart. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
+    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
+    android:orientation="vertical">
+
+    <TextView
+        android:id="@+id/lujarch_chart_summary"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginVertical="16dp"
+        android:textAlignment="viewStart"
+        android:textAppearance="?android:attr/textAppearanceSmall"
+        android:textColor="?android:attr/textColorSecondary" />
+
+    <com.android.settings.lujarch.battery.RecordBarsView
+        android:id="@+id/lujarch_chart_days"
+        android:layout_width="match_parent"
+        android:layout_height="112dp"
+        android:layout_marginBottom="12dp" />
+
+    <com.android.settings.lujarch.battery.RecordBarsView
+        android:id="@+id/lujarch_chart_hours"
+        android:layout_width="match_parent"
+        android:layout_height="164dp"
+        android:layout_marginBottom="8dp" />
+
+    <TextView
+        android:id="@+id/lujarch_chart_legend"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginBottom="12dp"
+        android:textAlignment="viewStart"
+        android:textAppearance="?android:attr/textAppearanceSmall"
+        android:textColor="?android:attr/textColorSecondary" />
+
+</LinearLayout>
