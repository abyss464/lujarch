+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.View;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.settings.R;
+
+/**
+ * Lujarch battery record (BAT-1): the title and battery level of the chosen day or
+ * hour, and its four tiles (use, average power, screen on, screen off).
+ */
+public final class RecordSummaryPreference extends Preference {
+
+    /** What the card shows. */
+    static final class Model {
+        String title;
+        String level;
+        String useValue;
+        String useNote;
+        String powerValue;
+        String powerNote;
+        String onValue;
+        String onNote;
+        String offValue;
+        String offNote;
+    }
+
+    private Model mModel;
+    /** Which row of the card: 0 the title and level, 1 use and power, 2 screen on and off. */
+    private final int mPart;
+
+    public RecordSummaryPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        final String key = getKey();
+        mPart = key == null ? 0 : key.endsWith("tiles1") ? 1 : key.endsWith("tiles2") ? 2 : 0;
+        setLayoutResource(mPart == 0 ? R.layout.lujarch_record_summary
+                : R.layout.lujarch_record_tiles);
+        setSelectable(false);
+    }
+
+    void setModel(Model model) {
+        mModel = model;
+        notifyChanged();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        if (mModel == null) {
+            return;
+        }
+        final Context c = getContext();
+        if (mPart == 0) {
+            final TextView title = holder.itemView.findViewById(R.id.lujarch_summary_title);
+            final TextView level = holder.itemView.findViewById(R.id.lujarch_summary_level);
+            if (title == null || level == null) {
+                return;
+            }
+            title.setText(mModel.title);
+            level.setText(mModel.level);
+            level.setVisibility(mModel.level == null || mModel.level.isEmpty()
+                    ? View.GONE : View.VISIBLE);
+        } else if (mPart == 1) {
+            tile(holder, R.id.lujarch_tile_a, c.getString(R.string.lujarch_battery_tile_use),
+                    mModel.useValue, mModel.useNote);
+            tile(holder, R.id.lujarch_tile_b, c.getString(R.string.lujarch_battery_tile_power),
+                    mModel.powerValue, mModel.powerNote);
+        } else {
+            tile(holder, R.id.lujarch_tile_a, c.getString(
+                    R.string.lujarch_battery_tile_screen_on), mModel.onValue, mModel.onNote);
+            tile(holder, R.id.lujarch_tile_b, c.getString(
+                    R.string.lujarch_battery_tile_screen_off), mModel.offValue, mModel.offNote);
+        }
+    }
+
+    private static void tile(PreferenceViewHolder holder, int id, String label, String value,
+            String note) {
+        final View tile = holder.itemView.findViewById(id);
+        if (tile == null) {
+            return;
+        }
+        ((TextView) tile.findViewById(R.id.lujarch_tile_label)).setText(label);
+        ((TextView) tile.findViewById(R.id.lujarch_tile_value)).setText(value);
+        final TextView n = (TextView) tile.findViewById(R.id.lujarch_tile_note);
+        n.setText(note);
+        n.setVisibility(note == null || note.isEmpty() ? View.GONE : View.VISIBLE);
+    }
+}
