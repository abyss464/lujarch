+
+    /** The parts that are not null, joined with a middle dot. */
+    static String join(String... parts) {
+        final StringBuilder sb = new StringBuilder();
+        for (String p : parts) {
+            if (p == null || p.isEmpty()) {
+                continue;
+            }
+            if (sb.length() > 0) {
+                sb.append(" · ");
+            }
+            sb.append(p);
+        }
+        return sb.length() == 0 ? null : sb.toString();
+    }
+
+    private Drawable dot(int color) {
+        final GradientDrawable d = new GradientDrawable();
+        d.setShape(GradientDrawable.RECTANGLE);
+        d.setCornerRadius(3 * mContext.getResources().getDisplayMetrics().density);
+        d.setColor(color);
+        final int size = Math.round(12 * mContext.getResources().getDisplayMetrics().density);
+        d.setSize(size, size);
+        return d;
+    }
+
+    // ----- showing ------------------------------------------------------------------------------
+
+    private void bind(Model m) {
+        if (mChartPref == null) {
+            return;
+        }
+        mChartPref.setModel(m.chart);
+        for (RecordSummaryPreference p : mSummaryPrefs) {
+            p.setModel(m.summary);
+        }
+        mSummaryGroup.setVisible(m.data);
+        mBreakdown.setVisible(m.data);
+        if (!m.data) {
+            return;
+        }
+        mBreakdown.setTitle(m.breakdownTitle);
+        mSpinner.setDialogTitle(m.breakdownTitle);
+        for (int i = mBreakdown.getPreferenceCount() - 1; i >= 0; i--) {
+            final Preference p = mBreakdown.getPreference(i);
+            if (p != mSpinner && p != mFooter) {
+                mBreakdown.removePreference(p);
+            }
+        }
+        int order = ROW_ORDER_OFFSET;
+        for (Row row : m.rows) {
+            final Preference p;
+            if (row.header) {
+                final PreferenceCategory c = new PreferenceCategory(mContext);
+                c.setTitle(row.title);
+                p = c;
+            } else {
+                final PowerGaugePreference g = new PowerGaugePreference(mContext);
+                g.setTitle(row.title);
+                g.setSingleLineTitle(true);
+                g.setIcon(row.icon);
+                g.setSummary(row.summary);
+                g.setPercentage(row.widget == null ? "" : row.widget);
+                g.setSelectable(row.app);
+                if (row.app) {
+                    g.setOnPreferenceClickListener(pref -> {
+                        openApp(row);
+                        return true;
+                    });
+                }
+                p = g;
+            }
+            p.setKey(row.key);
+            p.setOrder(order++);
+            mBreakdown.addPreference(p);
+        }
+    }
+
+    private void openApp(Row row) {
+        final Bundle args = new Bundle();
+        if (row.app && row.pkg != null) {
+            args.putString(AdvancedPowerUsageDetail.EXTRA_PACKAGE_NAME, row.pkg);
+        } else {
+            args.putString(AdvancedPowerUsageDetail.EXTRA_LABEL, row.label);
+            args.putInt(AdvancedPowerUsageDetail.EXTRA_ICON_ID, R.drawable.ic_power_system);
+            args.putString(AdvancedPowerUsageDetail.EXTRA_PACKAGE_NAME, null);
+        }
+        args.putInt(AdvancedPowerUsageDetail.EXTRA_UID, row.uid);
+        args.putBoolean(AdvancedPowerUsageDetail.EXTRA_SHOW_TIME_INFO, false);
+        args.putInt(LujarchBatteryRecord.EXTRA_DAY, mSelDay);
+        args.putInt(LujarchBatteryRecord.EXTRA_HOUR, mSelHour);
+        new SubSettingLauncher(mContext)
+                .setDestination(AdvancedPowerUsageDetail.class.getName())
+                .setTitleRes(R.string.battery_details_title)
+                .setArguments(args)
+                .setSourceMetricsCategory(mFragment.getMetricsCategory())
+                .setUserHandle(new UserHandle(UserHandle.getUserId(row.uid)))
+                .launch();
+    }
+
+    // ----- the menu -----------------------------------------------------------------------------
+
+    /** The menu of the page: record, full history, clear. */
+    public void onCreateOptionsMenu(Menu menu, MenuInflater inflater) {
+        inflater.inflate(R.menu.lujarch_battery_record, menu);
+    }
+
+    public void onPrepareOptionsMenu(Menu menu) {
+        final MenuItem record = menu.findItem(R.id.lujarch_menu_record);
+        if (record != null) {
+            record.setChecked(RecordSettings.isRecording(mContext));
+        }
+        final MenuItem full = menu.findItem(R.id.lujarch_menu_full_history);
+        if (full != null) {
+            full.setChecked(RecordSettings.isFullHistory(mContext));
+        }
+    }
+
+    public boolean onOptionsItemSelected(MenuItem item) {
+        final int id = item.getItemId();
+        if (id == R.id.lujarch_menu_record) {
+            final boolean on = !RecordSettings.isRecording(mContext);
+            RecordSettings.setRecording(mContext, on);
+            refresh(on);
+            return true;
+        }
+        if (id == R.id.lujarch_menu_full_history) {
+            RecordSettings.setFullHistory(mContext, !RecordSettings.isFullHistory(mContext));
+            return true;
+        }
+        if (id == R.id.lujarch_menu_clear) {
+            new AlertDialog.Builder(mFragment.getActivity())
+                    .setTitle(R.string.lujarch_battery_clear_title)
+                    .setMessage(R.string.lujarch_battery_clear_message)
+                    .setPositiveButton(R.string.lujarch_battery_clear_confirm, (d, w) -> {
+                        mExecutor.execute(() -> {
+                            RecordDb.get(mContext).clear(System.currentTimeMillis());
+                            RecordNames.clearCache();
+                            post(load());
+                        });
+                    })
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .show();
+            return true;
+        }
+        return false;
+    }
+}
