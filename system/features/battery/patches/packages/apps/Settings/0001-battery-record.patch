+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.util.AttributeSet;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.settings.R;
+
+/** Lujarch battery record (BAT-1): the share of each power component, as one bar. */
+public final class RecordSegmentsPreference extends Preference {
+
+    private float[] mWeights = new float[0];
+    private int[] mColors = new int[0];
+
+    public RecordSegmentsPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.lujarch_record_segments);
+        setSelectable(false);
+    }
+
+    void setSegments(float[] weights, int[] colors) {
+        mWeights = weights;
+        mColors = colors;
+        notifyChanged();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        final RecordSegmentsView bar = holder.itemView.findViewById(R.id.lujarch_segments);
+        if (bar != null) {
+            bar.setSegments(mWeights, mColors);
+        }
+    }
+}
