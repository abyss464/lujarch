+package com.android.settings.lujarch.battery;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.view.Menu;
+import android.view.MenuInflater;
+import android.view.MenuItem;
+import android.view.View;
+
+import androidx.preference.Preference;
+import androidx.preference.ListPreference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.InstrumentedPreferenceFragment;
+import com.android.settings.core.SubSettingLauncher;
+import com.android.settings.fuelgauge.AdvancedPowerUsageDetail;
+import com.android.settings.fuelgauge.batteryusage.PowerGaugePreference;
+import com.android.settings.Utils;
+import com.android.settingslib.core.AbstractPreferenceController;
+import com.android.settingslib.core.lifecycle.Lifecycle;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnDestroy;
+import com.android.settingslib.core.lifecycle.events.OnResume;
+import com.android.settingslib.widget.FooterPreference;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Lujarch battery record (BAT-1): Settings > Battery > Battery usage. The chart of the
+ * last 7 days and the hours of the chosen day, the card of the chosen day or hour, and the
+ * breakdown of its battery usage by app, by system hardware or by wakeup.
+ *
+ * <p>The page reads the record ({@link RecordStore}); opening it also folds the history since
+ * the last fold ({@link RecordFold}) so that the hour being lived is there.
+ */
+public final class RecordPageController extends AbstractPreferenceController
+        implements LifecycleObserver, OnResume, OnDestroy {
+
+    private static final String KEY_CHART = "lujarch_chart";
+    private static final String KEY_SUMMARY = "lujarch_summary";
+    private static final String KEY_BREAKDOWN = "lujarch_breakdown";
+    private static final String KEY_SPINNER = "lujarch_spinner";
+    private static final String KEY_FOOTER = "lujarch_footer";
+    private static final int ROW_ORDER_OFFSET = 100;
+    private static final int MAX_APP_ROWS = 60;
+    private static final int MAX_REASON_ROWS = 12;
+
+    private static final int VIEW_APPS = 0;
+    private static final int VIEW_SYSTEM = 1;
+    private static final int VIEW_WAKES = 2;
+
+    /** Colors of the hardware rows of the system view, by RecordStore.SYS_*. */
+    private static final int[] SYSTEM_COLORS = {
+            0xFFC8C1ED, 0xFFA79FD6, 0xFF7FA7C9, 0xFF6E6A80, 0xFF5F86A8, 0xFF9FB58A, 0xFF8C84B8,
+            0xFF6F8FB0, 0xFF4A4756};
+
+    private final InstrumentedPreferenceFragment mFragment;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+
+    private RecordChartPreference mChartPref;
+    private final List<RecordSummaryPreference> mSummaryPrefs = new ArrayList<>();
+    private PreferenceCategory mSummaryGroup;
+    private PreferenceCategory mBreakdown;
+    private ListPreference mSpinner;
+    private FooterPreference mFooter;
+
+    // The selection: the day (0 is the oldest of the 7, 6 today), the hour or -1, the view.
+    private volatile int mSelDay = RecordStore.DAYS - 1;
+    private volatile int mSelHour = -1;
+    private volatile int mView = VIEW_APPS;
+    private boolean mDestroyed;
+
+    /** One line of the breakdown. */
+    private static final class Row {
+        String key;
+        String title;
+        String summary;
+        String widget;
+        Drawable icon;
+        boolean header;
+        boolean app;
+        int uid;
+        String pkg;
+        String label;
+    }
+
+    /** Everything the page shows, built on a background thread. */
+    private static final class Model {
+        RecordChartPreference.Model chart;
+        RecordSummaryPreference.Model summary;
+        boolean data;
+        String breakdownTitle;
+        List<Row> rows = new ArrayList<>();
+    }
+
+    public RecordPageController(Context context, Lifecycle lifecycle,
+            InstrumentedPreferenceFragment fragment) {
+        super(context);
+        mFragment = fragment;
+        if (lifecycle != null) {
+            lifecycle.addObserver(this);
+        }
+    }
+
+    @Override
+    public boolean isAvailable() {
+        return true;
+    }
+
+    @Override
+    public String getPreferenceKey() {
+        return KEY_BREAKDOWN;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mChartPref = screen.findPreference(KEY_CHART);
+        mSummaryGroup = screen.findPreference("lujarch_summary_group");
+        for (String k : new String[] {KEY_SUMMARY, KEY_SUMMARY + "_tiles1",
+                KEY_SUMMARY + "_tiles2"}) {
+            mSummaryPrefs.add(screen.findPreference(k));
+        }
+        mBreakdown = screen.findPreference(KEY_BREAKDOWN);
+        mSpinner = screen.findPreference(KEY_SPINNER);
+        mFooter = screen.findPreference(KEY_FOOTER);
+        mBreakdown.setOrderingAsAdded(false);
+        mFooter.setTitle(mContext.getString(R.string.lujarch_battery_footer));
+        final CharSequence[] views = {
+                mContext.getString(R.string.battery_usage_spinner_view_by_apps),
+                mContext.getString(R.string.battery_usage_spinner_view_by_systems),
+                mContext.getString(R.string.lujarch_battery_view_by_wakeups)};
+        mSpinner.setEntries(views);
+        mSpinner.setEntryValues(new CharSequence[] {"0", "1", "2"});
+        mSpinner.setDialogTitle(mBreakdown.getTitle());
+        mSpinner.setValue(String.valueOf(mView));
+        mSpinner.setTitle(views[mView]);
+        mSpinner.setOnPreferenceChangeListener((pref, value) -> {
+            final int v = Integer.parseInt((String) value);
+            mSpinner.setTitle(views[v]);
+            if (mView != v) {
+                mView = v;
+                refresh(false);
+            }
+            return true;
+        });
+    }
+
+    @Override
+    public void onResume() {
+        refresh(true);
+    }
+
+    @Override
+    public void onDestroy() {
+        mDestroyed = true;
+        mHandler.removeCallbacksAndMessages(null);
+        mExecutor.shutdownNow();
+    }
+
+    // ----- loading ----------------------------------------------------------------------------
+
+    /** Reads the record for the current selection (and, with {@code fold}, folds first). */
+    private void refresh(boolean fold) {
+        try {
+            mExecutor.execute(() -> {
+                post(load());
+                if (fold && RecordSettings.isRecording(mContext) && RecordFold.run(mContext)) {
+                    post(load());
+                }
+            });
+        } catch (RuntimeException e) {
+            // The page is gone and its executor is shut down.
+        }
+    }
+
+    private void post(Model model) {
+        mHandler.post(() -> {
+            if (!mDestroyed) {
+                bind(model);
+            }
+        });
+    }
+
+    private Model load() {
+        final int day = mSelDay;
+        final int hour = mSelHour;
+        final int view = mView;
+        final RecordStore store = new RecordStore(mContext);
+        final List<RecordStore.Day> days = store.days();
+        final Model m = new Model();
+        m.chart = new RecordChartPreference.Model();
+        m.summary = new RecordSummaryPreference.Model();
+        for (RecordStore.Day d : days) {
+            m.data |= d.data;
+        }
+        if (!m.data) {
+            m.chart.summary = mContext.getString(RecordSettings.isRecording(mContext)
+                    ? R.string.lujarch_battery_empty : R.string.lujarch_battery_recording_off);
+            return m;
+        }
+        m.chart.summary = mContext.getString(RecordSettings.isRecording(mContext)
+                ? R.string.lujarch_battery_chart_hint : R.string.lujarch_battery_chart_hint_off);
+
+        final int accent = Utils.getColorAttrDefaultColor(mContext, android.R.attr.colorAccent);
+        final int muted = (Utils.getColorAttrDefaultColor(mContext,
+                android.R.attr.textColorSecondary) & 0x00FFFFFF) | 0x66000000;
+        final int onBand = 0xFF3E9E6E;
+
+        // The upper tier: what each day used on battery.
+        final RecordBarsView.Data dd = new RecordBarsView.Data(RecordStore.DAYS);
+        double maxDay = 1;
+        for (RecordStore.Day d : days) {
+            maxDay = Math.max(maxDay, d.mah);
+        }
+        dd.max = (float) maxDay;
+        dd.labelEachBar = true;
+        dd.selected = day;
+        for (int i = 0; i < days.size(); i++) {
+            final RecordStore.Day d = days.get(i);
+            final boolean today = i == RecordStore.DAYS - 1;
+            dd.present[i] = d.data;
+            dd.top[i] = (float) d.mah;
+            dd.topColor[i] = i == day ? accent : muted;
+            dd.label[i] = today ? mContext.getString(R.string.lujarch_battery_today)
+                    : RecordFormat.weekday(d.start);
+            dd.description[i] = RecordFormat.dayTitle(mContext, d.start, today) + ", "
+                    + RecordFormat.mah(mContext, d.mah);
+        }
+        m.chart.days = dd;
+
+        // The lower tier: the average power of each hour of the chosen day.
+        final List<RecordStore.Hour> hours = store.hours(day);
+        final RecordBarsView.Data hd = new RecordBarsView.Data(hours.size());
+        double maxW = 0;
+        for (RecordStore.Hour h : hours) {
+            if (h.data && !h.charging()) {
+                maxW = Math.max(maxW, h.watts());
+            }
+        }
+        final double axis = niceWatts(maxW);
+        hd.max = (float) axis;
+        hd.maxLabel = RecordFormat.power(mContext, axis);
+        hd.selected = hour;
+        hd.level = new float[hours.size() + 1];
+        java.util.Arrays.fill(hd.level, Float.NaN);
+        for (int i = 0; i < hours.size(); i++) {
+            final RecordStore.Hour h = hours.get(i);
+            final long end = h.tail ? h.start + h.span : RecordDb.nextHour(h.start);
+            hd.present[i] = h.data;
+            hd.band[i] = h.charging();
+            hd.top[i] = (float) h.watts();
+            hd.topColor[i] = h.mostlyScreenOn() ? accent : muted;
+            hd.description[i] = RecordFormat.hourSpan(h.start, end)
+                    + (h.charging() ? ", " + mContext.getString(R.string.lujarch_battery_charging)
+                            : ", " + RecordFormat.power(mContext, h.watts()));
+            if (h.data) {
+                if (i == 0 || Float.isNaN(hd.level[i])) {
+                    hd.level[i] = h.lv0 >= 0 ? (float) h.lv0 : Float.NaN;
+                }
+                hd.level[i + 1] = h.lv1 >= 0 ? (float) h.lv1 : Float.NaN;
+            }
+        }
+        m.chart.hours = hd;
+        m.chart.legendColors = new int[] {accent, muted, onBand, 0};
+        m.chart.legendTexts = new String[] {
+                mContext.getString(R.string.lujarch_battery_legend_screen_on),
+                mContext.getString(R.string.lujarch_battery_legend_screen_off),
+                mContext.getString(R.string.lujarch_battery_charging),
+                mContext.getString(R.string.lujarch_battery_legend_level)};
+        m.chart.dayListener = i -> {
+            if (mSelDay != i) {
+                mSelDay = i;
+                mSelHour = -1;
+                refresh(false);
+            }
+        };
+        m.chart.hourListener = i -> {
+            mSelHour = mSelHour == i ? -1 : i;
+            refresh(false);
+        };
+
+        // The card of the selection.
+        final long[] range = store.range(day, hour);
+        final RecordStore.Summary s = store.summary(range[0], range[1]);
+        final boolean today = day == RecordStore.DAYS - 1;
+        String title;
+        boolean charging = false;
+        if (hour < 0) {
+            title = RecordFormat.dayTitle(mContext, range[0], today);
+        } else {
+            final RecordStore.Hour h = hours.get(Math.min(hour, hours.size() - 1));
+            title = RecordFormat.hourSpan(range[0],
+                    h.tail && h.span > 0 ? h.start + h.span : range[1]);
+            charging = h.charging();
+        }
+        m.summary.title = title;
+        m.summary.level = levelText(s, charging);
+        final double capacity = store.capacityMah();
+        if (!s.data || s.allCharging || charging) {
+            m.summary.useValue = "—";
+            m.summary.powerValue = "—";
+            m.summary.onValue = "—";
+            m.summary.offValue = "—";
+        } else {
+            m.summary.useValue = RecordFormat.mah(mContext, s.mah);
+            m.summary.useNote = capacity > 0 ? mContext.getString(
+                    R.string.lujarch_battery_share_of_battery,
+                    RecordFormat.percent(s.mah / capacity * 100)) : null;
+            m.summary.powerValue = RecordFormat.power(mContext, s.watts());
+            m.summary.onValue = RecordFormat.duration(mContext, s.onMs);
+            m.summary.onNote = s.onMs >= 30_000L ? mContext.getString(
+                    R.string.lujarch_battery_avg_power_note,
+                    RecordFormat.power(mContext, s.wattsOn())) : null;
+            m.summary.offValue = RecordFormat.duration(mContext, s.offMs);
+            m.summary.offNote = s.offMs >= 30_000L ? mContext.getString(
+                    R.string.lujarch_battery_avg_power_note,
+                    RecordFormat.power(mContext, s.wattsOff())) : null;
+        }
+
+        // The breakdown.
+        m.breakdownTitle = mContext.getString(R.string.lujarch_battery_breakdown_title, title);
+        if (s.data && !s.allCharging && !charging) {
+            switch (view) {
+                case VIEW_SYSTEM:
+                    systemRows(m, store, s, range);
+                    break;
+                case VIEW_WAKES:
+                    wakeRows(m, store, s, range);
+                    break;
+                default:
+                    appRows(m, store, s, range);
+                    break;
+            }
+        }
+        return m;
+    }
+
+    private static double niceWatts(double max) {
+        final double[] steps = {0.5, 1, 2, 3, 4, 6, 8, 12};
+        for (double s : steps) {
+            if (max * 1.05 <= s) {
+                return s;
+            }
+        }
+        return Math.ceil(max);
+    }
+
+    private String levelText(RecordStore.Summary s, boolean charging) {
+        String level = null;
+        if (s.data && s.lvStart >= 0 && s.lvEnd >= 0) {
+            level = mContext.getString(R.string.lujarch_battery_level_range,
+                    RecordFormat.percent(s.lvStart), RecordFormat.percent(s.lvEnd));
+        }
+        if (charging || (s.data && s.allCharging)) {
+            final String c = mContext.getString(R.string.lujarch_battery_charging);
+            return level == null ? c : c + " · " + level;
+        }
+        return level;
+    }
+
+    private void appRows(Model m, RecordStore store, RecordStore.Summary s, long[] range) {
+        final List<RecordStore.AppRow> apps = store.apps(range[0], range[1]);
+        double total = s.mah;
+        if (total <= 0) {
+            for (RecordStore.AppRow a : apps) {
+                total += a.mah;
+            }
+        }
+        for (RecordStore.AppRow a : apps) {
+            if (m.rows.size() >= MAX_APP_ROWS) {
+                break;
+            }
+            final RecordNames.Who who = RecordNames.of(mContext, a.uid, a.pkg);
+            final Row r = new Row();
+            r.key = "app_" + a.uid;
+            r.title = who.name;
+            r.summary = mContext.getString(R.string.lujarch_battery_usage_summary,
+                    RecordFormat.mah(mContext, a.mah));
+            r.widget = RecordFormat.percent(a.mah / total * 100);
+            r.icon = who.icon;
+            r.app = who.app;
+            r.uid = a.uid;
+            r.pkg = who.pkg;
+            r.label = who.name;
+            m.rows.add(r);
+        }
+    }
+
+    private void systemRows(Model m, RecordStore store, RecordStore.Summary s, long[] range) {
+        final double[] mah = store.system(range[0], range[1]);
+        final String[] names = {
+                mContext.getString(R.string.lujarch_battery_sys_screen),
+                mContext.getString(R.string.lujarch_battery_sys_cpu),
+                mContext.getString(R.string.lujarch_battery_sys_mobile),
+                mContext.getString(R.string.lujarch_battery_sys_standby),
+                mContext.getString(R.string.lujarch_battery_sys_wlan),
+                mContext.getString(R.string.lujarch_battery_sys_gps),
+                mContext.getString(R.string.lujarch_battery_sys_audio),
+                mContext.getString(R.string.lujarch_battery_sys_bluetooth),
+                mContext.getString(R.string.lujarch_battery_sys_other)};
+        final String[] detail = new String[RecordStore.SYS_COUNT];
+        detail[RecordStore.SYS_SCREEN] = s.onMs >= 30_000L ? mContext.getString(
+                R.string.lujarch_battery_sys_screen_detail,
+                RecordFormat.duration(mContext, s.onMs)) : null;
+        detail[RecordStore.SYS_CPU] = s.cpuMs >= 30_000L ? join(
+                mContext.getString(R.string.lujarch_battery_sys_cpu_detail,
+                        RecordFormat.duration(mContext, s.cpuMs)),
+                s.cpuOffMs >= 30_000L ? mContext.getString(
+                        R.string.lujarch_battery_sys_cpu_off_detail,
+                        RecordFormat.duration(mContext, s.cpuOffMs)) : null) : null;
+        detail[RecordStore.SYS_MOBILE] = join(
+                s.radioMs >= 30_000L ? mContext.getString(
+                        R.string.lujarch_battery_sys_active_detail,
+                        RecordFormat.duration(mContext, s.radioMs)) : null,
+                s.weakMs >= 30_000L ? mContext.getString(
+                        R.string.lujarch_battery_sys_weak_detail,
+                        RecordFormat.duration(mContext, s.weakMs)) : null);
+        detail[RecordStore.SYS_STANDBY] = s.offMs >= 30_000L ? mContext.getString(
+                R.string.lujarch_battery_sys_standby_detail,
+                RecordFormat.duration(mContext, s.offMs)) : null;
+        detail[RecordStore.SYS_WLAN] = s.wifiMs >= 30_000L ? mContext.getString(
+                R.string.lujarch_battery_sys_active_detail,
+                RecordFormat.duration(mContext, s.wifiMs)) : null;
+        detail[RecordStore.SYS_GPS] = s.gpsMs >= 30_000L ? mContext.getString(
+                R.string.lujarch_battery_sys_gps_detail,
+                RecordFormat.duration(mContext, s.gpsMs)) : null;
+        detail[RecordStore.SYS_AUDIO] = s.audioMs >= 30_000L ? mContext.getString(
+                R.string.lujarch_battery_sys_audio_detail,
+                RecordFormat.duration(mContext, s.audioMs)) : null;
+        detail[RecordStore.SYS_BLUETOOTH] = s.btMs >= 30_000L ? mContext.getString(
+                R.string.lujarch_battery_sys_bluetooth_detail,
+                RecordFormat.duration(mContext, s.btMs)) : null;
+        detail[RecordStore.SYS_OTHER] = mContext.getString(R.string.lujarch_battery_sys_other_detail);
+        double total = 0;
+        for (double v : mah) {
+            total += v;
+        }
+        if (total <= 0) {
+            return;
+        }
+        final Integer[] order = new Integer[RecordStore.SYS_COUNT];
+        for (int i = 0; i < order.length; i++) {
