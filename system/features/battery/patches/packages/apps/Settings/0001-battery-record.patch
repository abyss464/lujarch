+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.util.Log;
+
+/**
+ * The two switches of Battery usage's menu: Record battery usage (BAT-1, Settings.Global
+ * lujarch_battery_record; off stops the hourly fold and the fold the page runs) and Full battery
+ * history (BAT-2, Settings.Global lujarch_battery_full_history, applied by BatteryStatsService).
+ */
+final class RecordSettings {
+
+    private static final String TAG = "LujarchBatteryRecord";
+    private static final String RECORD_SETTING = "lujarch_battery_record";
+    private static final String FULL_HISTORY_SETTING = "lujarch_battery_full_history";
+
+    private RecordSettings() {}
+
+    static boolean isRecording(Context context) {
+        return Settings.Global.getInt(context.getContentResolver(), RECORD_SETTING, 1) != 0;
+    }
+
+    static void setRecording(Context context, boolean on) {
+        put(context, RECORD_SETTING, on);
+    }
+
+    static boolean isFullHistory(Context context) {
+        return Settings.Global.getInt(context.getContentResolver(), FULL_HISTORY_SETTING, 1) != 0;
+    }
+
+    static void setFullHistory(Context context, boolean on) {
+        put(context, FULL_HISTORY_SETTING, on);
+    }
+
+    private static void put(Context context, String setting, boolean on) {
+        try {
+            Settings.Global.putInt(context.getContentResolver(), setting, on ? 1 : 0);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "cannot write " + setting, e);
+        }
+    }
+}
diff --git a/src/com/android/settings/lujarch/battery/RecordStore.java b/src/com/android/settings/lujarch/battery/RecordStore.java
new file mode 100644
index 0000000000000000000000000000000000000000..12dd279502644a2349c53e8c216cf77dd38cb765
--- /dev/null
+++ b/src/com/android/settings/lujarch/battery/RecordStore.java
@@ -0,0 +1,703 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.os.BatteryConsumer;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Lujarch battery record (BAT-1): the questions the record pages ask of the record.
+ * Every method reads the database on the calling thread, so the pages call them from a
+ * background thread.
+ *
+ * <p>A selection is a day (0 = the oldest of the 7 days kept, 6 = today) and optionally one
+ * hour of it; {@link #range} turns it into a time range.
+ */
+final class RecordStore {
+
+    static final int DAYS = RecordDb.KEEP_DAYS;
+
+    private final Context mContext;
+    private final SQLiteDatabase mDb;
+    private final long mToday;
+
+    RecordStore(Context context) {
+        mContext = context.getApplicationContext();
+        mDb = RecordDb.get(mContext).getReadableDatabase();
+        mToday = RecordDb.dayStart(System.currentTimeMillis()).toInstant().toEpochMilli();
+    }
+
+    // ----- selections -----------------------------------------------------------------------
+
+    /** Start of a day, local midnight. */
+    long dayStart(int day) {
+        return RecordDb.dayStart(mToday).minusDays(DAYS - 1 - day).toInstant().toEpochMilli();
+    }
+
+    long dayEnd(int day) {
+        return RecordDb.dayStart(mToday).minusDays(DAYS - 1 - day).plusDays(1).toInstant()
+                .toEpochMilli();
+    }
+
+    /** {from, to} of a day, or of one hour of it. */
+    long[] range(int day, int hour) {
+        if (hour < 0) {
+            return new long[] {dayStart(day), dayEnd(day)};
+        }
+        final ZonedDateTime start = RecordDb.dayStart(mToday).minusDays(DAYS - 1 - day)
+                .plusHours(hour);
+        return new long[] {start.toInstant().toEpochMilli(),
+                start.plusHours(1).toInstant().toEpochMilli()};
+    }
+
+    // ----- hours and days -------------------------------------------------------------------
+
+    static final class Hour {
+        long start;
+        boolean data;
+        long span;
+        long plugMs;
+        long onMs;
+        long offMs;
+        double mah;
+        double mwh;
+        double lv0 = -1;
+        double lv1 = -1;
+        boolean tail;
+
+        /** A charging hour: the charger was connected for most of it. */
+        boolean charging() {
+            return data && plugMs * 2 > span;
+        }
+
+        /** Average power while on battery, in W. */
+        double watts() {
+            final long ms = onMs + offMs;
+            return ms > 0 ? mwh / 1000.0 / (ms / 3_600_000.0) : 0;
+        }
+
+        boolean mostlyScreenOn() {
+            return onMs > offMs;
+        }
+    }
+
+    /** The 24 hours of a day (the hours not recorded have {@code data == false}). */
+    List<Hour> hours(int day) {
+        final long from = dayStart(day);
+        final long to = dayEnd(day);
+        final List<Hour> out = new ArrayList<>();
+        final Map<Long, Hour> byStart = new HashMap<>();
+        try (Cursor c = mDb.rawQuery("SELECT h, span, plug_ms, on_ms, off_ms, mah, mwh, lv0, lv1,"
+                + " tail FROM hour WHERE h >= ? AND h < ?", args(from, to))) {
+            while (c.moveToNext()) {
+                final Hour h = new Hour();
+                h.start = c.getLong(0);
+                h.data = true;
+                h.span = c.getLong(1);
+                h.plugMs = c.getLong(2);
+                h.onMs = c.getLong(3);
+                h.offMs = c.getLong(4);
+                h.mah = c.getDouble(5);
+                h.mwh = c.getDouble(6);
+                h.lv0 = c.getDouble(7);
+                h.lv1 = c.getDouble(8);
+                h.tail = c.getInt(9) != 0;
+                byStart.put(h.start, h);
+            }
+        }
+        ZonedDateTime t = RecordDb.dayStart(from);
+        for (int i = 0; i < 24; i++) {
+            final long s = t.toInstant().toEpochMilli();
+            Hour h = byStart.get(s);
+            if (h == null) {
+                h = new Hour();
+                h.start = s;
+            }
+            out.add(h);
+            t = t.plusHours(1);
+            if (t.toInstant().toEpochMilli() >= to) {
+                break;
+            }
+        }
+        return out;
+    }
+
+    static final class Day {
+        long start;
+        boolean data;
+        double mah;
+    }
+
+    /** The 7 days: what was used on battery on each. */
+    List<Day> days() {
+        final List<Day> out = new ArrayList<>();
+        for (int d = 0; d < DAYS; d++) {
+            final Day day = new Day();
+            day.start = dayStart(d);
+            try (Cursor c = mDb.rawQuery("SELECT COUNT(*), SUM(mah) FROM hour WHERE h >= ? AND"
+                    + " h < ?", args(day.start, dayEnd(d)))) {
+                if (c.moveToFirst()) {
+                    day.data = c.getInt(0) > 0;
+                    day.mah = c.getDouble(1);
+                }
+            }
+            out.add(day);
+        }
+        return out;
+    }
+
+    // ----- a selection ----------------------------------------------------------------------
+
+    static final class Summary {
+        boolean data;
+        double mah;
+        double mwh;
+        double mwhOn;
+        double mwhOff;
+        long onMs;
+        long offMs;
+        long plugMs;
+        double lvStart = -1;
+        double lvEnd = -1;
+        double wakes;
+        long awakeMs;
+        long cpuMs;
+        long cpuOffMs;
+        long radioMs;
+        long weakMs;
+        long wifiMs;
+        long gpsMs;
+        long audioMs;
+        long btMs;
+        boolean allCharging;
+
+        /** Average power while on battery, in W. */
+        double watts() {
+            final long ms = onMs + offMs;
+            return ms > 0 ? mwh / 1000.0 / (ms / 3_600_000.0) : 0;
+        }
+
+        double wattsOn() {
+            return onMs > 0 ? mwhOn / 1000.0 / (onMs / 3_600_000.0) : 0;
+        }
+
+        double wattsOff() {
+            return offMs > 0 ? mwhOff / 1000.0 / (offMs / 3_600_000.0) : 0;
+        }
+    }
+
+    Summary summary(long from, long to) {
+        final Summary s = new Summary();
+        try (Cursor c = mDb.rawQuery("SELECT COUNT(*), SUM(mah), SUM(mwh), SUM(mwh_on),"
+                + " SUM(mwh_off), SUM(on_ms), SUM(off_ms), SUM(plug_ms), SUM(wakes),"
+                + " SUM(awake_ms), SUM(cpu_ms), SUM(cpu_off_ms), SUM(radio_ms), SUM(weak_ms),"
+                + " SUM(wifi_ms), SUM(gps_ms), SUM(audio_ms), SUM(bt_ms) FROM hour"
+                + " WHERE h >= ? AND h < ?", args(from, to))) {
+            if (c.moveToFirst() && c.getInt(0) > 0) {
+                s.data = true;
+                s.mah = c.getDouble(1);
+                s.mwh = c.getDouble(2);
+                s.mwhOn = c.getDouble(3);
+                s.mwhOff = c.getDouble(4);
+                s.onMs = c.getLong(5);
+                s.offMs = c.getLong(6);
+                s.plugMs = c.getLong(7);
+                s.wakes = c.getDouble(8);
+                s.awakeMs = c.getLong(9);
+                s.cpuMs = c.getLong(10);
+                s.cpuOffMs = c.getLong(11);
+                s.radioMs = c.getLong(12);
+                s.weakMs = c.getLong(13);
+                s.wifiMs = c.getLong(14);
+                s.gpsMs = c.getLong(15);
+                s.audioMs = c.getLong(16);
+                s.btMs = c.getLong(17);
+            }
+        }
+        if (!s.data) {
+            return s;
+        }
+        s.allCharging = s.onMs + s.offMs == 0;
+        try (Cursor c = mDb.rawQuery("SELECT lv0 FROM hour WHERE h >= ? AND h < ? AND lv0 >= 0"
+                + " ORDER BY h ASC LIMIT 1", args(from, to))) {
+            if (c.moveToFirst()) {
+                s.lvStart = c.getDouble(0);
+            }
+        }
+        try (Cursor c = mDb.rawQuery("SELECT lv1 FROM hour WHERE h >= ? AND h < ? AND lv1 >= 0"
+                + " ORDER BY h DESC LIMIT 1", args(from, to))) {
+            if (c.moveToFirst()) {
+                s.lvEnd = c.getDouble(0);
+            }
+        }
+        return s;
+    }
+
+    /** The battery's capacity in mAh as the gauge reports it; 0 when unknown. */
+    double capacityMah() {
+        return RecordDb.get(mContext).metaDouble("cap_mah", 0);
+    }
+
+    // ----- by app ---------------------------------------------------------------------------
+
+    static final class AppRow {
+        int uid;
+        String pkg;
+        double mah;
+        long fgMs;
+        long bgMs;
+    }
+
+    List<AppRow> apps(long from, long to) {
+        final Map<Integer, AppRow> rows = new HashMap<>();
+        try (Cursor c = mDb.rawQuery("SELECT uid, SUM(mah) FROM uid_comp WHERE h >= ? AND h < ?"
+                + " GROUP BY uid", args(from, to))) {
+            while (c.moveToNext()) {
+                final AppRow r = new AppRow();
+                r.uid = c.getInt(0);
+                r.mah = c.getDouble(1);
+                rows.put(r.uid, r);
+            }
+        }
+        try (Cursor c = mDb.rawQuery("SELECT uid, SUM(fg_ms), SUM(fgs_ms + bg_ms) FROM uid_hour"
+                + " WHERE h >= ? AND h < ? GROUP BY uid", args(from, to))) {
+            while (c.moveToNext()) {
+                final AppRow r = rows.get(c.getInt(0));
+                if (r != null) {
+                    r.fgMs = c.getLong(1);
+                    r.bgMs = c.getLong(2);
+                }
+            }
+        }
+        final Map<Integer, String> names = uidNames();
+        final List<AppRow> out = new ArrayList<>();
+        for (AppRow r : rows.values()) {
+            if (r.mah < 0.5) {
+                continue;
+            }
+            r.pkg = names.get(r.uid);
+            out.add(r);
+        }
+        Collections.sort(out, (a, b) -> Double.compare(b.mah, a.mah));
+        return out;
+    }
+
+    Map<Integer, String> uidNames() {
+        final Map<Integer, String> names = new HashMap<>();
+        try (Cursor c = mDb.rawQuery("SELECT uid, pkg FROM uid_name", null)) {
+            while (c.moveToNext()) {
+                names.put(c.getInt(0), c.getString(1));
+            }
+        }
+        return names;
+    }
+
+    String uidPackage(int uid) {
+        try (Cursor c = mDb.rawQuery("SELECT pkg FROM uid_name WHERE uid = ?",
+                new String[] {Integer.toString(uid)})) {
+            return c.moveToFirst() ? c.getString(0) : null;
+        }
+    }
+
+    // ----- by system ------------------------------------------------------------------------
+
+    /** The hardware rows of the system view. */
+    static final int SYS_SCREEN = 0;
+    static final int SYS_CPU = 1;
+    static final int SYS_MOBILE = 2;
+    static final int SYS_STANDBY = 3;
+    static final int SYS_WLAN = 4;
+    static final int SYS_GPS = 5;
+    static final int SYS_AUDIO = 6;
+    static final int SYS_BLUETOOTH = 7;
+    static final int SYS_OTHER = 8;
+    static final int SYS_COUNT = 9;
+
+    /** Which row a device power component belongs to. */
+    private static int systemRow(int comp) {
+        switch (comp) {
+            case BatteryConsumer.POWER_COMPONENT_SCREEN:
+            case BatteryConsumer.POWER_COMPONENT_AMBIENT_DISPLAY:
+                return SYS_SCREEN;
+            case BatteryConsumer.POWER_COMPONENT_CPU:
+            case BatteryConsumer.POWER_COMPONENT_WAKELOCK:
+            case BatteryConsumer.POWER_COMPONENT_SYSTEM_SERVICES:
+            case RecordDb.COMP_REMAINDER_ON:
+                return SYS_CPU;
+            case BatteryConsumer.POWER_COMPONENT_MOBILE_RADIO:
+            case BatteryConsumer.POWER_COMPONENT_PHONE:
+                return SYS_MOBILE;
+            case BatteryConsumer.POWER_COMPONENT_IDLE:
+            case RecordDb.COMP_STANDBY:
+                return SYS_STANDBY;
+            case BatteryConsumer.POWER_COMPONENT_WIFI:
+                return SYS_WLAN;
+            case BatteryConsumer.POWER_COMPONENT_GNSS:
+                return SYS_GPS;
+            case BatteryConsumer.POWER_COMPONENT_AUDIO:
+                return SYS_AUDIO;
+            case BatteryConsumer.POWER_COMPONENT_BLUETOOTH:
+                return SYS_BLUETOOTH;
+            default:
+                return SYS_OTHER;
+        }
+    }
+
+    /** mAh per system row over a range, indexed by SYS_*. */
+    double[] system(long from, long to) {
+        final double[] mah = new double[SYS_COUNT];
+        try (Cursor c = mDb.rawQuery("SELECT comp, SUM(mah) FROM dev WHERE h >= ? AND h < ?"
+                + " GROUP BY comp", args(from, to))) {
+            while (c.moveToNext()) {
+                mah[systemRow(c.getInt(0))] += c.getDouble(1);
+            }
+        }
+        return mah;
+    }
+
+    // ----- wakeups --------------------------------------------------------------------------
+
+    static final class Reason {
+        String raw;
+        int category;
+        int count;
+    }
+
+    List<Reason> reasons(long from, long to) {
+        final List<Reason> out = new ArrayList<>();
+        try (Cursor c = mDb.rawQuery("SELECT name, cat, SUM(cnt) FROM wr WHERE h >= ? AND h < ?"
+                + " GROUP BY name ORDER BY SUM(cnt) DESC", args(from, to))) {
+            while (c.moveToNext()) {
+                final Reason r = new Reason();
+                r.raw = c.getString(0);
+                r.category = c.getInt(1);
+                r.count = c.getInt(2);
+                out.add(r);
+            }
+        }
+        return out;
+    }
+
+    static final class WakeApp {
+        int uid;
+        String pkg;
+        int alarms;
+        int network;
+        long wakelockMs;
+        int wakelocks;
+
+        int score() {
+            return alarms + network + wakelocks;
+        }
+    }
+
+    /** Per app: alarm wakeups, network wakeups and wake lock time (screen off). */
+    List<WakeApp> wakeApps(long from, long to) {
+        final Map<Integer, WakeApp> rows = new HashMap<>();
+        try (Cursor c = mDb.rawQuery("SELECT uid, SUM(cnt) FROM al WHERE h >= ? AND h < ? AND"
+                + " scr = 0 GROUP BY uid", args(from, to))) {
+            while (c.moveToNext()) {
+                wakeApp(rows, c.getInt(0)).alarms = c.getInt(1);
+            }
+        }
+        try (Cursor c = mDb.rawQuery("SELECT uid, SUM(cnt) FROM nw WHERE h >= ? AND h < ?"
+                + " GROUP BY uid", args(from, to))) {
+            while (c.moveToNext()) {
+                wakeApp(rows, c.getInt(0)).network = c.getInt(1);
+            }
+        }
+        try (Cursor c = mDb.rawQuery("SELECT uid, SUM(cnt), SUM(ms) FROM wl WHERE h >= ? AND"
+                + " h < ? AND scr = 0 GROUP BY uid", args(from, to))) {
+            while (c.moveToNext()) {
+                final WakeApp w = wakeApp(rows, c.getInt(0));
+                w.wakelocks = c.getInt(1);
+                w.wakelockMs = c.getLong(2);
+            }
+        }
+        final Map<Integer, String> names = uidNames();
+        final List<WakeApp> out = new ArrayList<>(rows.values());
+        for (WakeApp w : out) {
+            w.pkg = names.get(w.uid);
+        }
+        Collections.sort(out, (a, b) -> Integer.compare(b.score(), a.score()));
+        return out;
+    }
+
+    private static WakeApp wakeApp(Map<Integer, WakeApp> rows, int uid) {
+        WakeApp w = rows.get(uid);
+        if (w == null) {
+            w = new WakeApp();
+            w.uid = uid;
+            rows.put(uid, w);
+        }
+        return w;
+    }
+
+    // ----- one app --------------------------------------------------------------------------
+
+    /** mAh of an app per hour of a day: {foreground, background}. */
+    double[][] appHours(int uid, int day) {
+        final double[][] out = new double[24][2];
+        final long from = dayStart(day);
+        final long to = dayEnd(day);
+        try (Cursor c = mDb.rawQuery("SELECT h, CASE WHEN st IN (0, 1) THEN 0 ELSE 1 END,"
+                + " SUM(mah) FROM uid_comp WHERE uid = ? AND h >= ? AND h < ?"
+                + " GROUP BY h, 2", args(uid, from, to))) {
+            while (c.moveToNext()) {
+                final int hour = hourOfDay(c.getLong(0));
+                if (hour >= 0 && hour < 24) {
+                    out[hour][c.getInt(1)] += c.getDouble(2);
+                }
+            }
+        }
+        return out;
+    }
+
+    /** mAh of an app per day of the 7. */
+    double[] appDays(int uid) {
+        final double[] out = new double[DAYS];
+        for (int d = 0; d < DAYS; d++) {
+            try (Cursor c = mDb.rawQuery("SELECT SUM(mah) FROM uid_comp WHERE uid = ? AND h >= ?"
+                    + " AND h < ?", args(uid, dayStart(d), dayEnd(d)))) {
+                if (c.moveToFirst()) {
+                    out[d] = c.getDouble(0);
+                }
+            }
+        }
+        return out;
+    }
+
+    private static int hourOfDay(long hourStart) {
+        return Instant.ofEpochMilli(hourStart).atZone(ZoneId.systemDefault()).getHour();
+    }
+
+    static final class Component {
+        int comp;
+        double mah;
+        /** mAh by process state: 0 none/foreground, 1 foreground, 2 background, 3 foreground
+         * service, 4 cached. */
+        final double[] byState = new double[BatteryConsumer.PROCESS_STATE_COUNT];
+    }
+
+    List<Component> components(int uid, long from, long to) {
+        final Map<Integer, Component> rows = new HashMap<>();
+        try (Cursor c = mDb.rawQuery("SELECT comp, st, SUM(mah) FROM uid_comp WHERE uid = ? AND"
+                + " h >= ? AND h < ? GROUP BY comp, st", args(uid, from, to))) {
+            while (c.moveToNext()) {
+                Component r = rows.get(c.getInt(0));
+                if (r == null) {
+                    r = new Component();
+                    r.comp = c.getInt(0);
+                    rows.put(r.comp, r);
+                }
+                r.byState[c.getInt(1)] += c.getDouble(2);
+                r.mah += c.getDouble(2);
+            }
+        }
+        final List<Component> out = new ArrayList<>();
+        for (Component r : rows.values()) {
+            if (r.mah >= 0.5) {
+                out.add(r);
+            }
+        }
+        Collections.sort(out, (a, b) -> Double.compare(b.mah, a.mah));
+        return out;
+    }
+
+    /** Time and mAh of an app per process state: rows 1 foreground, 3 service, 2 background,
+     * 4 cached. */
+    static final class State {
+        long ms;
+        double mah;
+    }
+
+    State[] states(int uid, long from, long to) {
+        final State[] out = new State[BatteryConsumer.PROCESS_STATE_COUNT];
+        for (int i = 0; i < out.length; i++) {
+            out[i] = new State();
+        }
+        try (Cursor c = mDb.rawQuery("SELECT SUM(fg_ms), SUM(fgs_ms), SUM(bg_ms), SUM(cache_ms)"
+                + " FROM uid_hour WHERE uid = ? AND h >= ? AND h < ?", args(uid, from, to))) {
+            if (c.moveToFirst()) {
+                out[BatteryConsumer.PROCESS_STATE_FOREGROUND].ms = c.getLong(0);
+                out[BatteryConsumer.PROCESS_STATE_FOREGROUND_SERVICE].ms = c.getLong(1);
+                out[BatteryConsumer.PROCESS_STATE_BACKGROUND].ms = c.getLong(2);
+                out[BatteryConsumer.PROCESS_STATE_CACHED].ms = c.getLong(3);
+            }
+        }
+        try (Cursor c = mDb.rawQuery("SELECT st, SUM(mah) FROM uid_comp WHERE uid = ? AND h >= ?"
+                + " AND h < ? GROUP BY st", args(uid, from, to))) {
+            while (c.moveToNext()) {
+                // Power with no process state (the screen) is the foreground's.
+                final int st = c.getInt(0) == 0 ? BatteryConsumer.PROCESS_STATE_FOREGROUND
+                        : c.getInt(0);
+                out[st].mah += c.getDouble(1);
+            }
+        }
+        return out;
+    }
+
+    static final class Named {
+        String name;
+        int count;
+        long ms;
+    }
+
+    /** Wake locks of an app while the screen was off, by tag. */
+    List<Named> wakelocks(int uid, long from, long to) {
+        return named("SELECT name, SUM(cnt), SUM(ms) FROM wl WHERE uid = ? AND h >= ? AND h < ?"
+                + " AND scr = 0 GROUP BY name ORDER BY SUM(ms) DESC", uid, from, to);
+    }
+
+    /** Alarm wakeups of an app while the screen was off, by tag. */
+    List<Named> alarms(int uid, long from, long to) {
+        return named("SELECT name, SUM(cnt), 0 FROM al WHERE uid = ? AND h >= ? AND h < ?"
+                + " AND scr = 0 GROUP BY name ORDER BY SUM(cnt) DESC", uid, from, to);
+    }
+
+    /** Background jobs of an app, by name. */
+    List<Named> jobs(int uid, long from, long to) {
+        return named("SELECT name, COUNT(*), SUM(e - t) FROM ev WHERE kind = "
+                + RecordDb.EV_JOB + " AND uid = ? AND e >= ? AND t < ? GROUP BY name"
+                + " ORDER BY COUNT(*) DESC", uid, from, to);
+    }
+
+    private List<Named> named(String sql, int uid, long from, long to) {
+        final List<Named> out = new ArrayList<>();
+        try (Cursor c = mDb.rawQuery(sql, args(uid, from, to))) {
+            while (c.moveToNext()) {
+                final Named n = new Named();
+                n.name = c.getString(0);
+                n.count = c.getInt(1);
+                n.ms = c.getLong(2);
+                out.add(n);
+            }
+        }
+        return out;
+    }
+
+    int networkWakes(int uid, long from, long to) {
+        try (Cursor c = mDb.rawQuery("SELECT SUM(cnt) FROM nw WHERE uid = ? AND h >= ? AND h < ?",
+                args(uid, from, to))) {
+            return c.moveToFirst() ? c.getInt(0) : 0;
+        }
+    }
+
+    /** Background traffic {rx, tx} and mobile radio active ms of the background states. */
+    long[] backgroundTraffic(int uid, long from, long to) {
+        final long[] out = new long[3];
+        try (Cursor c = mDb.rawQuery("SELECT SUM(rx_bg), SUM(tx_bg) FROM uid_hour WHERE uid = ?"
+                + " AND h >= ? AND h < ?", args(uid, from, to))) {
+            if (c.moveToFirst()) {
+                out[0] = c.getLong(0);
+                out[1] = c.getLong(1);
+            }
+        }
+        try (Cursor c = mDb.rawQuery("SELECT SUM(ms) FROM uid_comp WHERE uid = ? AND h >= ? AND"
+                + " h < ? AND comp = " + BatteryConsumer.POWER_COMPONENT_MOBILE_RADIO
+                + " AND st IN (2, 3, 4)", args(uid, from, to))) {
+            if (c.moveToFirst()) {
+                out[2] = c.getLong(0);
+            }
+        }
+        return out;
+    }
+
+    static final class Event {
+        int kind;
+        long t;
+        long e;
+        String name;
+        int count;
+        double watts = -1;
+        double mah = -1;
+    }
+
+    /** Every event of an app that overlaps the range, in time order. */
+    List<Event> timeline(int uid, long from, long to) {
+        final List<Event> out = new ArrayList<>();
+        try (Cursor c = mDb.rawQuery("SELECT kind, t, e, name, cnt, w FROM ev WHERE uid = ? AND"
+                + " e >= ? AND t < ? ORDER BY t ASC", args(uid, from, to))) {
+            while (c.moveToNext()) {
+                final Event ev = new Event();
+                ev.kind = c.getInt(0);
+                ev.t = c.getLong(1);
+                ev.e = c.getLong(2);
+                ev.name = c.getString(3);
+                ev.count = c.getInt(4);
+                ev.watts = c.isNull(5) ? -1 : c.getDouble(5);
+                out.add(ev);
+            }
+        }
+        for (Event ev : out) {
+            if (ev.kind == RecordDb.EV_FOREGROUND) {
+                ev.mah = sessionMah(uid, ev, false);
+            } else if (ev.kind == RecordDb.EV_FG_SERVICE) {
+                ev.mah = sessionMah(uid, ev, true);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * The app's power in a session: its power of the matching process state in each hour the
+     * session overlaps, in proportion to the part of that hour's time in the state the
+     * session covers.
+     */
+    private double sessionMah(int uid, Event ev, boolean service) {
+        double total = 0;
+        long h = RecordDb.hourStart(ev.t);
+        while (h < ev.e) {
+            final long next = RecordDb.nextHour(h);
+            final long overlap = Math.min(ev.e, next) - Math.max(ev.t, h);
+            try (Cursor c = mDb.rawQuery("SELECT " + (service ? "fgs_ms" : "fg_ms")
+                    + " FROM uid_hour WHERE uid = ? AND h = ?", args(uid, h))) {
+                final long stateMs = c.moveToFirst() ? c.getLong(0) : 0;
+                if (stateMs > 0) {
+                    try (Cursor m = mDb.rawQuery("SELECT SUM(mah) FROM uid_comp WHERE uid = ? AND"
+                            + " h = ? AND st IN " + (service ? "(3)" : "(0, 1)"), args(uid, h))) {
+                        if (m.moveToFirst()) {
+                            total += m.getDouble(0) * Math.min(1.0, (double) overlap / stateMs);
+                        }
+                    }
+                }
+            }
+            h = next;
+        }
+        return total;
+    }
+
+    // ----- helpers --------------------------------------------------------------------------
+
+    private static String[] args(long... values) {
+        final String[] out = new String[values.length];
+        for (int i = 0; i < values.length; i++) {
+            out[i] = Long.toString(values[i]);
+        }
+        return out;
+    }
+}
