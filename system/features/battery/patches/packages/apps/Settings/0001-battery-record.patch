+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.graphics.drawable.Drawable;
+import android.os.Process;
+import android.util.ArrayMap;
+
+import com.android.settings.fuelgauge.batteryusage.BatteryEntry;
+
+import java.util.Map;
+
+/**
+ * Lujarch battery record (BAT-1): the name and icon of a uid in the record's lists.
+ * App names come from the package manager as in Settings' battery list; an app that is gone
+ * keeps the package name the record stored.
+ */
+final class RecordNames {
+
+    static final class Who {
+        String name;
+        String pkg;
+        Drawable icon;
+        /** An app of a user (not a system service): its page can open the app info. */
+        boolean app;
+    }
+
+    private static final Map<String, Who> sCache = new ArrayMap<>();
+
+    private RecordNames() {}
+
+    static synchronized void clearCache() {
+        sCache.clear();
+    }
+
+    static synchronized Who of(Context context, int uid, String storedPackage) {
+        final String key = uid + "/" + storedPackage;
+        Who who = sCache.get(key);
+        if (who != null) {
+            return who;
+        }
+        who = new Who();
+        who.app = Process.isApplicationUid(uid);
+        BatteryEntry.NameAndIcon nai = null;
+        if (uid != 0 && uid != Process.INVALID_UID) {
+            nai = BatteryEntry.loadNameAndIcon(context, uid, null, storedPackage,
+                    storedPackage, null);
+        }
+        if (nai == null || nai.mName == null) {
+            nai = BatteryEntry.getNameAndIconFromUid(context, storedPackage, uid);
+        }
+        who.name = nai.mName != null ? nai.mName : "UID " + uid;
+        who.pkg = nai.mPackageName != null ? nai.mPackageName : storedPackage;
+        who.icon = nai.mIcon;
+        sCache.put(key, who);
+        return who;
+    }
+}
