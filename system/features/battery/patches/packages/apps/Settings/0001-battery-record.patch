+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.view.View;
+
+/** Lujarch battery record (BAT-1): a row of colored segments, one per component. */
+public final class RecordSegmentsView extends View {
+
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private float[] mWeights = new float[0];
+    private int[] mColors = new int[0];
+
+    public RecordSegmentsView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    void setSegments(float[] weights, int[] colors) {
+        mWeights = weights;
+        mColors = colors;
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        float total = 0;
+        for (float w : mWeights) {
+            total += w;
+        }
+        if (total <= 0) {
+            return;
+        }
+        final float gap = 2 * getResources().getDisplayMetrics().density;
+        final float usable = getWidth() - gap * (mWeights.length - 1);
+        float x = 0;
+        for (int i = 0; i < mWeights.length; i++) {
+            final float w = usable * mWeights[i] / total;
+            mRect.set(x, 0, x + Math.max(w, 1), getHeight());
+            mPaint.setColor(mColors[i]);
+            canvas.drawRoundRect(mRect, gap * 1.5f, gap * 1.5f, mPaint);
+            x += w + gap;
+        }
+    }
+}
