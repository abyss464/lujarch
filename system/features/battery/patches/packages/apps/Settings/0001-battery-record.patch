+
+    private void wakeRows(Model m, RecordStore store, RecordStore.Summary s, long[] range) {
+        final Row total = new Row();
+        total.key = "wake_total";
+        total.title = mContext.getResources().getQuantityString(R.plurals.lujarch_battery_wake_total, (int) ((long) s.wakes), (long) s.wakes);
+        total.summary = mContext.getString(R.string.lujarch_battery_wake_awake,
+                RecordFormat.duration(mContext, s.awakeMs));
+        m.rows.add(total);
+
+        final List<RecordStore.Reason> reasons = store.reasons(range[0], range[1]);
+        if (!reasons.isEmpty()) {
+            final Row h = new Row();
+            h.key = "wake_hdr_reasons";
+            h.header = true;
+            h.title = mContext.getString(R.string.lujarch_battery_wake_reasons);
+            m.rows.add(h);
+            int n = 0;
+            for (RecordStore.Reason reason : reasons) {
+                if (n++ >= MAX_REASON_ROWS) {
+                    break;
+                }
+                final Row r = new Row();
+                r.key = "wake_r_" + n;
+                r.title = reasonName(reason.category);
+                r.summary = reason.raw;
+                r.widget = mContext.getResources().getQuantityString(R.plurals.lujarch_battery_times, (int) (reason.count), reason.count);
+                m.rows.add(r);
+            }
+        }
+        final List<RecordStore.WakeApp> apps = store.wakeApps(range[0], range[1]);
+        if (!apps.isEmpty()) {
+            final Row h = new Row();
+            h.key = "wake_hdr_apps";
+            h.header = true;
+            h.title = mContext.getString(R.string.lujarch_battery_wake_by_app);
+            m.rows.add(h);
+            int n = 0;
+            for (RecordStore.WakeApp a : apps) {
+                if (n++ >= MAX_APP_ROWS) {
+                    break;
+                }
+                final RecordNames.Who who = RecordNames.of(mContext, a.uid, a.pkg);
+                final Row r = new Row();
+                r.key = "wake_app_" + a.uid;
+                r.title = who.name;
+                r.summary = join(
+                        a.alarms > 0 ? mContext.getResources().getQuantityString(R.plurals.lujarch_battery_wake_alarms, (int) (a.alarms), a.alarms) : null,
+                        a.network > 0 ? mContext.getResources().getQuantityString(R.plurals.lujarch_battery_wake_network, (int) (a.network), a.network) : null,
+                        a.wakelockMs >= 30_000L ? mContext.getString(
+                                R.string.lujarch_battery_wake_wakelock,
+                                RecordFormat.duration(mContext, a.wakelockMs)) : null);
+                r.widget = mContext.getResources().getQuantityString(R.plurals.lujarch_battery_times, (int) (a.alarms + a.network + a.wakelocks), a.alarms + a.network + a.wakelocks);
+                r.icon = who.icon;
+                r.app = who.app;
+                r.uid = a.uid;
+                r.pkg = who.pkg;
+                r.label = who.name;
+                m.rows.add(r);
+            }
+        }
+    }
+
+    private String reasonName(int category) {
+        switch (category) {
+            case RecordFold.REASON_ALARM:
+                return mContext.getString(R.string.lujarch_battery_reason_alarm);
+            case RecordFold.REASON_MODEM:
+                return mContext.getString(R.string.lujarch_battery_sys_mobile);
+            case RecordFold.REASON_WLAN:
+                return mContext.getString(R.string.lujarch_battery_sys_wlan);
+            case RecordFold.REASON_SENSORS:
+                return mContext.getString(R.string.lujarch_battery_reason_sensors);
+            case RecordFold.REASON_BLUETOOTH:
+                return mContext.getString(R.string.lujarch_battery_sys_bluetooth);
+            case RecordFold.REASON_POWER_KEY:
+                return mContext.getString(R.string.lujarch_battery_reason_power_key);
+            case RecordFold.REASON_FINGERPRINT:
+                return mContext.getString(R.string.lujarch_battery_reason_fingerprint);
+            case RecordFold.REASON_USB:
+                return mContext.getString(R.string.lujarch_battery_reason_usb);
+            default:
+                return mContext.getString(R.string.lujarch_battery_sys_other);
