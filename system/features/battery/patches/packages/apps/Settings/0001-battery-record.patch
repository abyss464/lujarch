+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.text.SpannableStringBuilder;
+import android.text.Spanned;
+import android.text.style.ForegroundColorSpan;
+import android.util.AttributeSet;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.settings.R;
+
+/**
+ * Lujarch battery record (BAT-1): the two-tier chart of the record pages, the upper
+ * tier the 7 days and the lower tier the 24 hours of the chosen day.
+ */
+public final class RecordChartPreference extends Preference {
+
+    /** What the chart shows. */
+    static final class Model {
+        String summary;
+        RecordBarsView.Data days;
+        RecordBarsView.Data hours;
+        RecordBarsView.Listener dayListener;
+        RecordBarsView.Listener hourListener;
+        /** Legend entries: {color, text}; a color of 0 is the dashed level line. */
+        int[] legendColors = new int[0];
+        String[] legendTexts = new String[0];
+    }
+
+    private Model mModel;
+
+    public RecordChartPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.lujarch_record_chart);
+        setSelectable(false);
+    }
+
+    void setModel(Model model) {
+        mModel = model;
+        notifyChanged();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        if (mModel == null) {
+            return;
+        }
+        ((TextView) holder.findViewById(R.id.lujarch_chart_summary)).setText(mModel.summary);
+        final RecordBarsView days = (RecordBarsView) holder.findViewById(R.id.lujarch_chart_days);
+        final RecordBarsView hours =
+                (RecordBarsView) holder.findViewById(R.id.lujarch_chart_hours);
+        days.setListener(mModel.dayListener);
+        hours.setListener(mModel.hourListener);
+        days.setData(mModel.days);
+        hours.setData(mModel.hours);
+        final boolean any = mModel.days != null;
+        days.setVisibility(any ? android.view.View.VISIBLE : android.view.View.GONE);
+        hours.setVisibility(any ? android.view.View.VISIBLE : android.view.View.GONE);
+        final TextView legend = (TextView) holder.findViewById(R.id.lujarch_chart_legend);
+        final SpannableStringBuilder sb = new SpannableStringBuilder();
+        for (int i = 0; i < mModel.legendTexts.length; i++) {
+            if (i > 0) {
+                sb.append("    ");
+            }
+            final int start = sb.length();
+            sb.append(mModel.legendColors[i] == 0 ? "┄" : "■");
+            if (mModel.legendColors[i] != 0) {
+                sb.setSpan(new ForegroundColorSpan(mModel.legendColors[i]), start, sb.length(),
+                        Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            }
+            sb.append(' ').append(mModel.legendTexts[i]);
+        }
+        legend.setText(sb);
+        legend.setVisibility(mModel.legendTexts.length > 0 && any
+                ? android.view.View.VISIBLE : android.view.View.GONE);
+    }
+}
diff --git a/src/com/android/settings/lujarch/battery/RecordDb.java b/src/com/android/settings/lujarch/battery/RecordDb.java
new file mode 100644
index 0000000000000000000000000000000000000000..b10870f9dd6ee57f563a8604e00bb472ea770d9b
--- /dev/null
+++ b/src/com/android/settings/lujarch/battery/RecordDb.java
@@ -0,0 +1,187 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.database.sqlite.SQLiteOpenHelper;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.time.temporal.ChronoUnit;
+
+/**
+ * Lujarch battery record (BAT-1): the condensed record of the last 7 days, one row set
+ * per clock hour. Its own database next to the battery usage database of Settings
+ * (battery-usage-db), so Settings' schema and migrations are untouched.
+ *
+ * <p>Every table holds whole hours; the hour being lived is rewritten by each fold (the "tail"
+ * flag marks what the next fold replaces).
+ */
+final class RecordDb extends SQLiteOpenHelper {
+
+    private static final String NAME = "lujarch-battery-record.db";
+    private static final int VERSION = 1;
+
+    /** Days of detail kept: today and the 6 days before it. */
+    static final int KEEP_DAYS = 7;
+
+    /** Timeline event kinds (table ev). */
+    static final int EV_FOREGROUND = 1;
+    static final int EV_FG_SERVICE = 2;
+    static final int EV_JOB = 3;
+    static final int EV_LONG_WAKELOCK = 4;
+    static final int EV_NET_WAKE = 5;
+
+    /** Device component of the energy no model accounts for while the screen was off. */
+    static final int COMP_STANDBY = 100;
+    /** Device component of the energy no model accounts for while the screen was on. */
+    static final int COMP_REMAINDER_ON = 101;
+
+    private static RecordDb sInstance;
+
+    static synchronized RecordDb get(Context context) {
+        if (sInstance == null) {
+            sInstance = new RecordDb(context.getApplicationContext());
+        }
+        return sInstance;
+    }
+
+    private RecordDb(Context context) {
+        super(context, NAME, null, VERSION);
+    }
+
+    @Override
+    public void onCreate(SQLiteDatabase db) {
+        db.execSQL("CREATE TABLE hour (h INTEGER PRIMARY KEY, span INTEGER NOT NULL,"
+                + " plug_ms INTEGER, on_ms INTEGER, off_ms INTEGER,"
+                + " mah REAL, mah_on REAL, mah_off REAL, mah_chg REAL,"
+                + " mwh REAL, mwh_on REAL, mwh_off REAL, lv0 REAL, lv1 REAL,"
+                + " wakes INTEGER, awake_ms INTEGER, cpu_ms INTEGER, cpu_off_ms INTEGER,"
+                + " radio_ms INTEGER, weak_ms INTEGER, wifi_ms INTEGER, gps_ms INTEGER,"
+                + " audio_ms INTEGER, bt_ms INTEGER, tail INTEGER NOT NULL DEFAULT 0)");
+        db.execSQL("CREATE TABLE dev (h INTEGER, comp INTEGER, mah REAL,"
+                + " PRIMARY KEY (h, comp)) WITHOUT ROWID");
+        db.execSQL("CREATE TABLE uid_name (uid INTEGER PRIMARY KEY, pkg TEXT)");
+        db.execSQL("CREATE TABLE uid_hour (h INTEGER, uid INTEGER, fg_ms INTEGER, fgs_ms INTEGER,"
+                + " bg_ms INTEGER, cache_ms INTEGER, rx_fg INTEGER, tx_fg INTEGER,"
+                + " rx_bg INTEGER, tx_bg INTEGER, PRIMARY KEY (h, uid)) WITHOUT ROWID");
+        db.execSQL("CREATE TABLE uid_comp (h INTEGER, uid INTEGER, comp INTEGER, st INTEGER,"
+                + " mah REAL, ms INTEGER, PRIMARY KEY (h, uid, comp, st)) WITHOUT ROWID");
+        db.execSQL("CREATE TABLE wl (h INTEGER, uid INTEGER, name TEXT, scr INTEGER, cnt INTEGER,"
+                + " ms INTEGER, PRIMARY KEY (h, uid, name, scr)) WITHOUT ROWID");
+        db.execSQL("CREATE TABLE al (h INTEGER, uid INTEGER, name TEXT, scr INTEGER, cnt INTEGER,"
+                + " PRIMARY KEY (h, uid, name, scr)) WITHOUT ROWID");
+        db.execSQL("CREATE TABLE wr (h INTEGER, name TEXT, cat INTEGER, cnt INTEGER,"
+                + " PRIMARY KEY (h, name)) WITHOUT ROWID");
+        db.execSQL("CREATE TABLE nw (h INTEGER, uid INTEGER, cnt INTEGER,"
+                + " PRIMARY KEY (h, uid)) WITHOUT ROWID");
+        db.execSQL("CREATE TABLE ev (id INTEGER PRIMARY KEY AUTOINCREMENT, t INTEGER, e INTEGER,"
+                + " kind INTEGER, uid INTEGER, name TEXT, cnt INTEGER, w REAL,"
+                + " tail INTEGER NOT NULL DEFAULT 0)");
+        db.execSQL("CREATE INDEX ev_uid ON ev (uid, t)");
+        db.execSQL("CREATE INDEX ev_end ON ev (e)");
+        db.execSQL("CREATE TABLE open_ev (k TEXT PRIMARY KEY, kind INTEGER, uid INTEGER,"
+                + " name TEXT, t INTEGER, a REAL, b REAL)");
+        db.execSQL("CREATE TABLE meta (k TEXT PRIMARY KEY, v TEXT)");
+    }
+
+    @Override
+    public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
+        // Version 1 is the first schema.
+    }
+
+    long metaLong(String key, long fallback) {
+        try (Cursor c = getReadableDatabase().rawQuery(
+                "SELECT v FROM meta WHERE k = ?", new String[] {key})) {
+            return c.moveToFirst() ? Long.parseLong(c.getString(0)) : fallback;
+        } catch (RuntimeException e) {
+            return fallback;
+        }
+    }
+
+    double metaDouble(String key, double fallback) {
+        try (Cursor c = getReadableDatabase().rawQuery(
+                "SELECT v FROM meta WHERE k = ?", new String[] {key})) {
+            return c.moveToFirst() ? Double.parseDouble(c.getString(0)) : fallback;
+        } catch (RuntimeException e) {
+            return fallback;
+        }
+    }
+
+    static void putMeta(SQLiteDatabase db, String key, String value) {
+        db.execSQL("INSERT OR REPLACE INTO meta (k, v) VALUES (?, ?)", new Object[] {key, value});
+    }
+
+    /** Deletes every row of the record and starts it afresh at the hour of {@code now}. */
+    void clear(long now) {
+        final SQLiteDatabase db = getWritableDatabase();
+        db.beginTransaction();
+        try {
+            for (String t : new String[] {"hour", "dev", "uid_name", "uid_hour", "uid_comp",
+                    "wl", "al", "wr", "nw", "ev", "open_ev"}) {
+                db.execSQL("DELETE FROM " + t);
+            }
+            putMeta(db, "floor", Long.toString(hourStart(now)));
+            putMeta(db, "fold_end", "0");
+            db.setTransactionSuccessful();
+        } finally {
+            db.endTransaction();
+        }
+    }
+
+    /** Deletes the rows older than the 7 days kept. */
+    void prune(long now) {
+        final long cut = oldestKept(now);
+        final SQLiteDatabase db = getWritableDatabase();
+        db.beginTransaction();
+        try {
+            for (String t : new String[] {"hour", "dev", "uid_hour", "uid_comp", "wl", "al", "wr",
+                    "nw"}) {
+                db.execSQL("DELETE FROM " + t + " WHERE h < ?", new Object[] {cut});
+            }
+            db.execSQL("DELETE FROM ev WHERE e < ?", new Object[] {cut});
+            db.execSQL("DELETE FROM uid_name WHERE uid NOT IN (SELECT uid FROM uid_hour)");
+            db.setTransactionSuccessful();
+        } finally {
+            db.endTransaction();
+        }
+    }
+
+    /** Start of the oldest day kept: local midnight, {@link #KEEP_DAYS} - 1 days before today. */
+    static long oldestKept(long now) {
+        return dayStart(now).minusDays(KEEP_DAYS - 1).toInstant().toEpochMilli();
+    }
+
+    static ZonedDateTime dayStart(long wallMs) {
+        return Instant.ofEpochMilli(wallMs).atZone(ZoneId.systemDefault())
+                .truncatedTo(ChronoUnit.DAYS);
+    }
+
+    /** Start of the local clock hour that holds {@code wallMs}. */
+    static long hourStart(long wallMs) {
+        return Instant.ofEpochMilli(wallMs).atZone(ZoneId.systemDefault())
+                .truncatedTo(ChronoUnit.HOURS).toInstant().toEpochMilli();
+    }
+
+    /** Start of the local clock hour after the one that holds {@code wallMs}. */
+    static long nextHour(long wallMs) {
+        return Instant.ofEpochMilli(wallMs).atZone(ZoneId.systemDefault())
+                .truncatedTo(ChronoUnit.HOURS).plusHours(1).toInstant().toEpochMilli();
+    }
+}
diff --git a/src/com/android/settings/lujarch/battery/RecordFold.java b/src/com/android/settings/lujarch/battery/RecordFold.java
new file mode 100644
index 0000000000000000000000000000000000000000..be4b43152e4392b9337161050644524ffe8dea2e
--- /dev/null
+++ b/src/com/android/settings/lujarch/battery/RecordFold.java
@@ -0,0 +1,1065 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.lujarch.battery;
+
+import android.app.usage.NetworkStats;
+import android.app.usage.NetworkStatsManager;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.database.sqlite.SQLiteDatabase;
+import android.net.NetworkTemplate;
+import android.os.BatteryConsumer;
+import android.os.BatteryStats.HistoryItem;
+import android.os.BatteryStats.HistoryTag;
+import android.os.BatteryStatsManager;
+import android.os.BatteryUsageStats;
+import android.os.BatteryUsageStatsQuery;
+import android.os.SystemClock;
+import android.os.UidBatteryConsumer;
+import android.os.UserManager;
+import android.util.Log;
+
+import com.android.internal.os.BatteryStatsHistoryIterator;
+import com.android.internal.os.MonotonicClock;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Lujarch battery record (BAT-1): folds the battery history and the power estimates of
+ * the hours since the last fold into the record ({@link RecordDb}).
+ *
+ * <p>It runs inside Settings' own hourly job ({@code BatteryUsageDataLoader}) and when the
+ * record page opens: nothing here schedules, samples or holds anything. The inputs are
+ * already kept by the system:
+ * <ul>
+ *   <li>the BatteryStats history (state, level, charge counter, voltage and events per change),
+ *       read once from the last fold on: per-hour discharge is the charge-counter difference
+ *       while unplugged, power is that energy over the time;
+ *   <li>per-hour {@link BatteryUsageStats} (power components of the device and of each uid, by
+ *       process state), asked for the hour's monotonic time range, scaled so that they never
+ *       exceed the measured discharge; what they do not explain is the device's idle draw;
+ *   <li>NetworkStats (bytes per uid and foreground state).
+ * </ul>
+ *
+ * <p>Complete hours are stored once ({@code fold_end} moves past them). The hour being lived is
+ * recomputed from its start by every fold, stored with the tail flag, and replaced by the next.
+ */
+final class RecordFold {
+
+    private static final String TAG = "LujarchBatteryRecord";
+
+    private static final Object LOCK = new Object();
+    private static final long HOUR_MS = 3_600_000L;
+    /** A tail shorter than this is not stored. */
+    private static final long TAIL_MIN_MS = 30_000L;
+    /** The history kept past the last fold, in case a fragment boundary falls early. */
+    private static final long HISTORY_SLACK_MS = 30 * 60_000L;
+    /** Usage queries per binder call (the reply of one call is limited to 1 MB). */
+    private static final int QUERY_CHUNK = 4;
+    /** Power below this is not stored (mAh). */
+    private static final double MIN_MAH = 0.0005;
+
+    // Open-event kinds (table open_ev); the timeline kinds of RecordDb are the same numbers.
+    private static final int OPEN_TOP = 100;
+    private static final int OPEN_WAKELOCK = 101;
+    private static final int OPEN_WAKE_PERIOD = 102;
+
+    /** Kernel wakeup reason categories (table wr). */
+    static final int REASON_OTHER = 0;
+    static final int REASON_ALARM = 1;
+    static final int REASON_MODEM = 2;
+    static final int REASON_WLAN = 3;
+    static final int REASON_SENSORS = 4;
+    static final int REASON_BLUETOOTH = 5;
+    static final int REASON_POWER_KEY = 6;
+    static final int REASON_FINGERPRINT = 7;
+    static final int REASON_USB = 8;
+
+    private RecordFold() {}
+
+    /**
+     * Folds the history since the last fold into the record. Returns whether the record
+     * changed. Does nothing while recording is off or the user's storage is locked.
+     */
+    static boolean run(Context context) {
+        if (!RecordSettings.isRecording(context)) {
+            return false;
+        }
+        final UserManager um = context.getSystemService(UserManager.class);
+        if (um != null && !um.isUserUnlocked()) {
+            return false;
+        }
+        synchronized (LOCK) {
+            final long start = SystemClock.elapsedRealtime();
+            try {
+                final boolean changed = new Pass(context.getApplicationContext()).fold();
+                Log.i(TAG, "fold " + (changed ? "done" : "nothing to do") + " in "
+                        + (SystemClock.elapsedRealtime() - start) + " ms");
+                return changed;
+            } catch (RuntimeException e) {
+                Log.e(TAG, "fold failed", e);
+                return false;
+            }
+        }
+    }
+
+    /** The category of a kernel wakeup reason. */
+    static int reasonCategory(String raw) {
+        final String s = raw.toLowerCase(Locale.ROOT);
+        if (s.contains("alarmtimer") || s.contains("rtc") || s.contains("timerfd")) {
+            return REASON_ALARM;
+        }
+        if (s.contains("modem") || s.contains("ipa") || s.contains("rmnet")
+                || s.contains("qrtr") || s.contains("mhi")) {
+            return REASON_MODEM;
+        }
+        if (s.contains("wlan") || s.contains("cnss") || s.contains("wifi")
+                || s.contains("qcom_rx_wakelock") || s.contains("wcnss")) {
+            return REASON_WLAN;
+        }
+        if (s.contains("adsp") || s.contains("ssc") || s.contains("slpi")
+                || s.contains("cdsp")) {
+            return REASON_SENSORS;
+        }
+        if (s.contains("bluetooth") || s.contains("hci")) {
+            return REASON_BLUETOOTH;
+        }
+        if (s.contains("pwrkey") || s.contains("power_key")) {
+            return REASON_POWER_KEY;
+        }
+        if (s.contains("goodix") || s.contains("fingerprint") || s.matches(".*\\bgf\\b.*")) {
+            return REASON_FINGERPRINT;
+        }
+        if (s.contains("usb") || s.contains("charger") || s.contains("typec")) {
+            return REASON_USB;
+        }
+        return REASON_OTHER;
+    }
+
+    // ---------------------------------------------------------------------------------------
+
+    /** What one clock hour accumulates while the history is read. */
+    private static final class Acc {
+        final long h;
+        boolean tail;
+        long monoLo;
+        long monoHi;
+        long span;
+        long plugMs;
+        long onMs;
+        long offMs;
+        double uah;
+        double uahOn;
+        double uahOff;
+        double uahChg;
+        double mwh;
+        double mwhOn;
+        double mwhOff;
+        double lv0 = -1;
+        double lv1 = -1;
+        int wakes;
+        long awakeMs;
+        long cpuMs;
+        long cpuOffMs;
+        long radioMs;
+        long weakMs;
+        long wifiMs;
+        long gpsMs;
+        long audioMs;
+        long btMs;
+        /** raw reason -> {category, count} */
+        final Map<String, int[]> reasons = new HashMap<>();
+        /** uid -> {count, first, last} */
+        final Map<Integer, long[]> netWakes = new HashMap<>();
+        /** "uid\u0001scr\u0001name" -> {count, ms}: every wake lock hold (full history) */
+        final Map<String, long[]> wlFull = new HashMap<>();
+        /** the same from the tag that starts each wake period (without the full history) */
+        final Map<String, long[]> wlPeriod = new HashMap<>();
+        /** "uid\u0001scr\u0001name" -> {count} */
+        final Map<String, long[]> alarms = new HashMap<>();
+
+        // From the usage stats.
+        boolean hasUsage;
+        final double[] devMah = new double[BatteryConsumer.POWER_COMPONENT_COUNT];
+        final Map<Integer, UidAcc> uids = new HashMap<>();
+        double scale = 1;
+
+        Acc(long h) {
+            this.h = h;
+        }
+    }
+
+    private static final class UidAcc {
+        final long[] stateMs = new long[BatteryConsumer.PROCESS_STATE_COUNT];
+        /** {comp, state, mah, ms} */
+        final List<double[]> comps = new ArrayList<>();
+        long rxFg;
+        long txFg;
+        long rxBg;
+        long txBg;
+    }
+
+    private static final class Ev {
+        int kind;
+        long t;
+        long e;
+        int uid;
+        String name;
+        int cnt = 1;
+        double w = -1;
+    }
+
+    private static final class Open {
+        int kind;
+        int uid;
+        String name;
+        long t;
+        double a;
+        double b;
+
+        Open(int kind, int uid, String name, long t, double a, double b) {
+            this.kind = kind;
+            this.uid = uid;
+            this.name = name;
+            this.t = t;
+            this.a = a;
+            this.b = b;
+        }
+
+        String key() {
+            return key(kind, uid, name);
+        }
+
+        static String key(int kind, int uid, String name) {
+            return kind + "\u0001" + uid + "\u0001" + name;
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+
+    private static final class Pass {
+        private final Context mContext;
+        private final RecordDb mDb;
+        private final PackageManager mPm;
+
+        private long mNow;
+        private long mWinStart;
+        private long mCompleteEnd;
+        private long mWinEnd;
+
+        private final Map<Long, Acc> mAccs = new HashMap<>();
+        private final List<Long> mHours = new ArrayList<>();
+        private final List<Ev> mEvents = new ArrayList<>();
+        private Map<String, Open> mOpen = new HashMap<>();
+        private Map<String, Open> mOpenAtCompleteEnd;
+        private double mCumMwh;
+        private double mCumMs;
+        private double mCumMwhAtCompleteEnd = Double.NaN;
+        private double mCumMsAtCompleteEnd;
+
+        // The history cursor.
+        private boolean mHaveOffset;
+        private long mWallOffset;
+        private boolean mHavePrev;
+        private long mPrevT;
+        private int mPrevLevel;
+        private int mPrevUah;
+        private int mPrevVolt;
+        private int mPrevStates;
+        private int mPrevStates2;
+        private boolean mSnapshotDone;
+        // Foreground session tracking: the top app and whether a screen-on session runs.
+        private Open mTop;
+        private Open mSession;
+        private Open mPeriod;
+
+        Pass(Context context) {
+            mContext = context;
+            mDb = RecordDb.get(context);
+            mPm = context.getPackageManager();
+        }
+
+        boolean fold() {
+            mNow = System.currentTimeMillis();
+            final long lastEnd = mDb.metaLong("fold_end", 0);
+            final long floor = mDb.metaLong("floor", 0);
+            mCompleteEnd = RecordDb.hourStart(mNow);
+            final long start = RecordDb.hourStart(
+                    Math.max(Math.max(lastEnd, floor), RecordDb.oldestKept(mNow)));
+            final boolean hasTail = mNow - mCompleteEnd >= TAIL_MIN_MS;
+            mWinEnd = hasTail ? mNow : mCompleteEnd;
+            if (start >= mWinEnd) {
+                mDb.prune(mNow);
+                return false;
+            }
+            mWinStart = start;
+            mCumMwh = mDb.metaDouble("cum_mwh", 0);
+            mCumMs = mDb.metaDouble("cum_ms", 0);
+            if (mCompleteEnd <= mWinStart) {
+                // Nothing completes in this fold: the totals stay as they are.
+                mCumMwhAtCompleteEnd = mCumMwh;
+                mCumMsAtCompleteEnd = mCumMs;
+            }
+            loadOpen();
+
+            final BatteryStatsManager bsm = mContext.getSystemService(BatteryStatsManager.class);
+            final long wanted = mNow - mWinStart + HISTORY_SLACK_MS;
+            try (BatteryUsageStats stats = bsm.getBatteryUsageStats(
+                    new BatteryUsageStatsQuery.Builder()
+                            .includeBatteryHistory()
+                            .setPreferredHistoryDurationMs(wanted)
+                            .build())) {
+                readHistory(stats);
+            } catch (java.io.IOException e) {
+                Log.w(TAG, "closing the history stats", e);
+            }
+            if (!mSnapshotDone) {
+                snapshot();
+            }
+            mHours.sort(null);
+            for (Long h : mHours) {
+                final Acc a = mAccs.get(h);
+                a.tail = a.h >= mCompleteEnd;
+                finishHour(a);
+            }
+            readUsage(bsm);
+            readNetwork();
+            persist();
+            return true;
+        }
+
+        // ----- state loaded from the record -------------------------------------------------
+
+        private void loadOpen() {
+            try (android.database.Cursor c = mDb.getReadableDatabase().rawQuery(
+                    "SELECT kind, uid, name, t, a, b FROM open_ev", null)) {
+                while (c.moveToNext()) {
+                    final Open o = new Open(c.getInt(0), c.getInt(1), c.getString(2),
+                            c.getLong(3), c.getDouble(4), c.getDouble(5));
+                    mOpen.put(o.key(), o);
+                    if (o.kind == OPEN_TOP) {
+                        mTop = o;
+                    } else if (o.kind == RecordDb.EV_FOREGROUND) {
+                        mSession = o;
+                    } else if (o.kind == OPEN_WAKE_PERIOD) {
+                        mPeriod = o;
+                    }
+                }
+            }
+        }
+
+        /** What the next fold starts from: the open events and totals at the complete end. */
+        private void snapshot() {
+            mSnapshotDone = true;
+            mOpenAtCompleteEnd = new HashMap<>(mOpen);
+        }
+
+        // ----- the history ------------------------------------------------------------------
+
+        private void readHistory(BatteryUsageStats stats) {
+            try (BatteryStatsHistoryIterator it = stats.iterateBatteryStatsHistory()) {
+                HistoryItem rec;
+                while ((rec = it.next()) != null) {
+                    final long t = rec.time;
+                    final byte cmd = rec.cmd;
+                    final boolean isReference =
+                            (cmd == HistoryItem.CMD_CURRENT_TIME || cmd == HistoryItem.CMD_RESET)
+                                    && rec.currentTime != 0;
+                    if (!mHaveOffset && !isReference) {
+                        continue;
+                    }
+                    if (mHavePrev) {
+                        // Up to this item the previous item's state held.
+                        segment(mPrevT, t, rec.batteryLevel, rec.batteryChargeUah,
+                                rec.batteryVoltage);
+                    }
+                    if (isReference) {
+                        mWallOffset = rec.currentTime - t;
+                        mHaveOffset = true;
+                    }
+                    final long wall = t + mWallOffset;
+                    if (!mSnapshotDone && wall >= mCompleteEnd) {
+                        snapshot();
+                    }
+                    if (wall >= mWinEnd) {
+                        mHavePrev = false;
+                        break;
+                    }
+                    if (cmd == HistoryItem.CMD_SHUTDOWN) {
+                        if (wall >= mWinStart) {
+                            closeAll(wall);
+                        }
+                        mHavePrev = false;
+                        continue;
+                    }
+                    if (wall >= mWinStart) {
+                        handleItem(rec, wall);
+                    }
+                    mHavePrev = true;
+                    mPrevT = t;
+                    if (rec.batteryLevel > 0) {
+                        mPrevLevel = rec.batteryLevel;
+                    }
+                    mPrevUah = rec.batteryChargeUah;
+                    if (rec.batteryVoltage > 0) {
+                        mPrevVolt = rec.batteryVoltage;
+                    }
+                    mPrevStates = rec.states;
+                    mPrevStates2 = rec.states2;
+                }
+            }
+            if (mHavePrev && mHaveOffset) {
+                // The last state holds up to the end of the window.
+                segment(mPrevT, mWinEnd - mWallOffset, mPrevLevel, mPrevUah, mPrevVolt);
+            }
+        }
+
+        private Acc acc(long wall) {
+            final long h = RecordDb.hourStart(wall);
+            Acc a = mAccs.get(h);
+            if (a == null) {
+                a = new Acc(h);
+                a.monoLo = h - mWallOffset;
+                a.monoHi = RecordDb.nextHour(h) - mWallOffset;
+                mAccs.put(h, a);
+                mHours.add(h);
+            }
+            return a;
+        }
+
+        /**
+         * The state of the previous item held from {@code mPrevT} to {@code tEnd}; the charge
+         * counter moved from the previous item's value to {@code uahEnd} over it.
+         */
+        private void segment(long a, long tEnd, int levelEnd, int uahEnd, int voltEnd) {
+            final long full = tEnd - a;
+            if (full <= 0) {
+                return;
+            }
+            final long wa = a + mWallOffset;
+            final long wb = tEnd + mWallOffset;
+            long from = Math.max(wa, mWinStart);
+            final long to = Math.min(wb, mWinEnd);
+            if (to <= from) {
+                return;
+            }
+            final boolean plugged = (mPrevStates & HistoryItem.STATE_BATTERY_PLUGGED_FLAG) != 0;
+            final boolean screenOn = (mPrevStates & HistoryItem.STATE_SCREEN_ON_FLAG) != 0;
+            final double dq = (mPrevUah > 0 && uahEnd > 0) ? (mPrevUah - uahEnd) : 0;
+            final double volt = (mPrevVolt > 0 && voltEnd > 0) ? (mPrevVolt + voltEnd) / 2.0
+                    : Math.max(mPrevVolt, voltEnd);
+            while (from < to) {
+                final long he = RecordDb.nextHour(from);
+                final long seg = Math.min(to, he) - from;
+                final Acc acc = acc(from);
+                final double frac = (double) seg / (wb - wa);
+                acc.span += seg;
+                if (acc.lv0 < 0 && mPrevLevel > 0) {
+                    acc.lv0 = mPrevLevel;
+                }
+                if (mPrevLevel > 0) {
+                    acc.lv1 = (wb <= he && levelEnd > 0) ? levelEnd : mPrevLevel;
+                }
+                if (plugged) {
+                    acc.plugMs += seg;
+                    if (dq < 0) {
+                        acc.uahChg += -dq * frac;
+                    }
+                } else {
+                    if (screenOn) {
+                        acc.onMs += seg;
+                    } else {
+                        acc.offMs += seg;
+                    }
+                    final double part = dq * frac;
+                    final double mwh = part * volt / 1_000_000.0;
+                    acc.uah += part;
+                    acc.mwh += mwh;
+                    if (screenOn) {
+                        acc.uahOn += part;
+                        acc.mwhOn += mwh;
+                    } else {
+                        acc.uahOff += part;
+                        acc.mwhOff += mwh;
+                    }
+                    mCumMwh += mwh;
+                    mCumMs += seg;
+                    if ((mPrevStates & HistoryItem.STATE_CPU_RUNNING_FLAG) != 0) {
+                        acc.cpuMs += seg;
+                        if (!screenOn) {
+                            acc.cpuOffMs += seg;
+                        }
+                    }
+                    if ((mPrevStates & HistoryItem.STATE_MOBILE_RADIO_ACTIVE_FLAG) != 0) {
+                        acc.radioMs += seg;
+                    }
+                    final int phoneState = (mPrevStates & HistoryItem.STATE_PHONE_STATE_MASK)
+                            >> HistoryItem.STATE_PHONE_STATE_SHIFT;
+                    final int strength = (mPrevStates
+                            & HistoryItem.STATE_PHONE_SIGNAL_STRENGTH_MASK)
+                            >> HistoryItem.STATE_PHONE_SIGNAL_STRENGTH_SHIFT;
+                    // Phone state 3 is "power off" (airplane mode): not a weak signal.
+                    if (phoneState != 3 && strength <= 1) {
+                        acc.weakMs += seg;
+                    }
+                    if ((mPrevStates & HistoryItem.STATE_WIFI_RADIO_ACTIVE_FLAG) != 0) {
+                        acc.wifiMs += seg;
+                    }
+                    if ((mPrevStates & HistoryItem.STATE_GPS_ON_FLAG) != 0) {
+                        acc.gpsMs += seg;
+                    }
+                    if ((mPrevStates & HistoryItem.STATE_AUDIO_ON_FLAG) != 0) {
+                        acc.audioMs += seg;
+                    }
+                    if ((mPrevStates2 & HistoryItem.STATE2_BLUETOOTH_ON_FLAG) != 0) {
+                        acc.btMs += seg;
+                    }
+                    if (!screenOn && (mPrevStates & HistoryItem.STATE_WAKE_LOCK_FLAG) != 0) {
+                        acc.awakeMs += seg;
+                    }
+                }
+                from += seg;
+                if (from == mCompleteEnd && Double.isNaN(mCumMwhAtCompleteEnd)) {
+                    mCumMwhAtCompleteEnd = mCumMwh;
+                    mCumMsAtCompleteEnd = mCumMs;
+                }
+            }
+        }
+
+        // ----- events -----------------------------------------------------------------------
+
+        private void handleItem(HistoryItem rec, long wall) {
+            final boolean plugged = (rec.states & HistoryItem.STATE_BATTERY_PLUGGED_FLAG) != 0;
+            final boolean screenOn = (rec.states & HistoryItem.STATE_SCREEN_ON_FLAG) != 0;
+            final Acc acc = acc(wall);
+
+            final HistoryTag reason = rec.wakeReasonTag;
+            if (reason != null && reason.string != null && !plugged && !screenOn) {
+                acc.wakes++;
+                final String raw = reason.string.length() > 120
+                        ? reason.string.substring(0, 120) : reason.string;
+                int[] r = acc.reasons.get(raw);
+                if (r == null) {
+                    r = new int[] {reasonCategory(raw), 0};
+                    acc.reasons.put(raw, r);
+                }
+                r[1]++;
+            }
+
+            final int code = rec.eventCode;
+            if (code != HistoryItem.EVENT_NONE && rec.eventTag != null
+                    && rec.eventTag.string != null) {
+                final int type = code & HistoryItem.EVENT_TYPE_MASK;
+                final boolean start = (code & HistoryItem.EVENT_FLAG_START) != 0;
+                final boolean finish = (code & HistoryItem.EVENT_FLAG_FINISH) != 0;
+                final int uid = rec.eventTag.uid;
+                final String name = rec.eventTag.string;
+                switch (type) {
+                    case HistoryItem.EVENT_JOB:
+                        pair(RecordDb.EV_JOB, start, finish, uid, name, wall);
+                        break;
+                    case HistoryItem.EVENT_FOREGROUND:
+                        pair(RecordDb.EV_FG_SERVICE, start, finish, uid, name, wall);
+                        break;
+                    case HistoryItem.EVENT_LONG_WAKE_LOCK:
+                        pair(RecordDb.EV_LONG_WAKELOCK, start, finish, uid, name, wall);
+                        break;
+                    case HistoryItem.EVENT_TOP:
+                        if (start) {
+                            mTop = new Open(OPEN_TOP, uid, name, wall, 0, 0);
+                            mOpen.put(mTop.key(), mTop);
+                        } else if (finish && mTop != null) {
+                            mOpen.remove(mTop.key());
+                            mTop = null;
+                        }
+                        break;
+                    case HistoryItem.EVENT_WAKE_LOCK:
+                        if (start) {
+                            final Open o = new Open(OPEN_WAKELOCK, uid, name, wall,
+                                    screenOn ? 1 : 0, 0);
+                            mOpen.put(o.key(), o);
+                        } else if (finish) {
+                            final Open o = mOpen.remove(Open.key(OPEN_WAKELOCK, uid, name));
+                            if (o != null) {
+                                addWake(acc.wlFull, o.uid, (int) o.a, o.name, wall - o.t);
+                            }
+                        }
+                        break;
+                    case HistoryItem.EVENT_ALARM:
+                        if (start) {
+                            addWake(acc.alarms, uid, screenOn ? 1 : 0, name, 0);
+                        }
+                        break;
+                    case HistoryItem.EVENT_WAKEUP_AP: {
+                        long[] n = acc.netWakes.get(uid);
+                        if (n == null) {
+                            n = new long[] {0, wall, wall};
+                            acc.netWakes.put(uid, n);
+                        }
+                        n[0]++;
+                        n[2] = wall;
+                        break;
+                    }
+                    default:
+                        break;
+                }
+            }
+
+            // A wake period: the CPU is held awake by wake locks; the tag names the lock that
+            // started it.
+            final boolean awake = (rec.states & HistoryItem.STATE_WAKE_LOCK_FLAG) != 0;
+            final HistoryTag wakeTag = rec.wakelockTag;
+            if (awake && mPeriod == null && wakeTag != null && wakeTag.string != null) {
+                mPeriod = new Open(OPEN_WAKE_PERIOD, wakeTag.uid, wakeTag.string, wall,
+                        screenOn ? 1 : 0, 0);
+                mOpen.put(mPeriod.key(), mPeriod);
+            } else if (!awake && mPeriod != null) {
+                mOpen.remove(mPeriod.key());
+                addWake(acc.wlPeriod, mPeriod.uid, (int) mPeriod.a, mPeriod.name,
+                        wall - mPeriod.t);
+                mPeriod = null;
+            }
+
+            updateSession(wall, screenOn);
+        }
+
+        private void addWake(Map<String, long[]> map, int uid, int scr, String name, long ms) {
+            final String key = uid + "\u0001" + scr + "\u0001" + name;
+            long[] v = map.get(key);
+            if (v == null) {
+                v = new long[2];
+                map.put(key, v);
+            }
+            v[0]++;
+            v[1] += ms;
+        }
+
+        private void pair(int kind, boolean start, boolean finish, int uid, String name,
+                long wall) {
+            if (start) {
+                final Open o = new Open(kind, uid, name, wall, 0, 0);
+                mOpen.put(o.key(), o);
+            } else if (finish) {
+                final Open o = mOpen.remove(Open.key(kind, uid, name));
+                if (o != null) {
+                    final Ev ev = new Ev();
+                    ev.kind = kind;
+                    ev.t = o.t;
+                    ev.e = wall;
+                    ev.uid = uid;
+                    ev.name = name;
+                    mEvents.add(ev);
+                }
+            }
+        }
+
+        /** A foreground session: the top app while the screen is on. */
+        private void updateSession(long wall, boolean screenOn) {
+            final boolean want = mTop != null && screenOn;
+            if (want && mSession == null) {
+                mSession = new Open(RecordDb.EV_FOREGROUND, mTop.uid, mTop.name, wall, mCumMwh,
+                        mCumMs);
+                mOpen.put(mSession.key(), mSession);
+            } else if (mSession != null
+                    && (!want || mTop.uid != mSession.uid || !mTop.name.equals(mSession.name))) {
+                closeSession(wall);
+                if (want) {
+                    mSession = new Open(RecordDb.EV_FOREGROUND, mTop.uid, mTop.name, wall,
+                            mCumMwh, mCumMs);
+                    mOpen.put(mSession.key(), mSession);
+                }
+            }
+        }
+
+        private void closeSession(long wall) {
+            if (mSession == null) {
+                return;
+            }
+            mOpen.remove(mSession.key());
+            if (wall - mSession.t >= 1000) {
+                final Ev ev = new Ev();
+                ev.kind = RecordDb.EV_FOREGROUND;
+                ev.t = mSession.t;
+                ev.e = wall;
+                ev.uid = mSession.uid;
+                ev.name = mSession.name;
+                final double ms = mCumMs - mSession.b;
+                if (ms >= 60_000) {
+                    // Whole-device average power over the unplugged part of the session.
+                    final double w = (mCumMwh - mSession.a) / 1000.0 / (ms / HOUR_MS);
+                    if (w >= 0 && w <= 30) {
+                        ev.w = w;
+                    }
+                }
+                mEvents.add(ev);
+            }
+            mSession = null;
+        }
+
+        /** The device shut down: everything open ends at the shutdown. */
+        private void closeAll(long wall) {
+            closeSession(wall);
+            for (Open o : new ArrayList<>(mOpen.values())) {
+                if (o.kind == RecordDb.EV_JOB || o.kind == RecordDb.EV_FG_SERVICE
+                        || o.kind == RecordDb.EV_LONG_WAKELOCK) {
+                    final Ev ev = new Ev();
+                    ev.kind = o.kind;
+                    ev.t = o.t;
+                    ev.e = wall;
+                    ev.uid = o.uid;
+                    ev.name = o.name;
+                    mEvents.add(ev);
+                }
+            }
+            mOpen.clear();
+            mTop = null;
+            mPeriod = null;
+        }
+
+        // ----- per hour ---------------------------------------------------------------------
+
+        /** Clamps the hour's numbers and turns the network wakeups into timeline events. */
+        private void finishHour(Acc a) {
+            a.uah = Math.max(0, a.uah);
+            a.uahOn = Math.max(0, a.uahOn);
+            a.uahOff = Math.max(0, a.uahOff);
+            a.mwh = Math.max(0, a.mwh);
+            a.mwhOn = Math.max(0, a.mwhOn);
+            a.mwhOff = Math.max(0, a.mwhOff);
+            for (Map.Entry<Integer, long[]> n : a.netWakes.entrySet()) {
+                final Ev ev = new Ev();
+                ev.kind = RecordDb.EV_NET_WAKE;
+                ev.t = n.getValue()[1];
+                ev.e = n.getValue()[2];
+                ev.uid = n.getKey();
+                ev.name = "";
+                ev.cnt = (int) n.getValue()[0];
+                mEvents.add(ev);
+            }
+        }
+
+        // ----- usage stats ------------------------------------------------------------------
+
+        private void readUsage(BatteryStatsManager bsm) {
+            final List<Acc> todo = new ArrayList<>();
+            for (Long h : mHours) {
+                final Acc a = mAccs.get(h);
+                if (a.onMs + a.offMs > 0) {
+                    todo.add(a);
+                }
+            }
+            for (int i = 0; i < todo.size(); i += QUERY_CHUNK) {
+                final List<Acc> chunk = todo.subList(i, Math.min(todo.size(), i + QUERY_CHUNK));
+                final List<BatteryUsageStatsQuery> queries = new ArrayList<>();
+                for (Acc a : chunk) {
+                    queries.add(new BatteryUsageStatsQuery.Builder()
+                            .monotonicTimeRange(a.monoLo,
+                                    a.tail ? MonotonicClock.UNDEFINED : a.monoHi)
+                            .includeProcessStateData()
+                            .build());
+                }
+                final List<BatteryUsageStats> results;
+                try {
+                    results = bsm.getBatteryUsageStats(queries);
+                } catch (RuntimeException e) {
+                    Log.w(TAG, "usage stats of " + chunk.size() + " hours failed", e);
+                    continue;
+                }
+                for (int j = 0; j < results.size() && j < chunk.size(); j++) {
+                    try (BatteryUsageStats s = results.get(j)) {
+                        parseUsage(chunk.get(j), s);
+                    } catch (java.io.IOException | RuntimeException e) {
+                        Log.w(TAG, "usage stats of an hour unreadable", e);
+                    }
+                }
+            }
+        }
+
+        private void parseUsage(Acc a, BatteryUsageStats s) {
+            final double cap = s.getBatteryCapacity();
+            if (cap > 1000) {
+                mCapacityMah = cap;
+            }
+            final BatteryConsumer dev = s.getAggregateBatteryConsumer(
+                    BatteryUsageStats.AGGREGATE_BATTERY_CONSUMER_SCOPE_DEVICE);
+            double devSum = 0;
+            for (int comp = 0; comp <= BatteryConsumer.POWER_COMPONENT_IDLE; comp++) {
+                final double p = dev.getConsumedPower(comp);
+                a.devMah[comp] = p;
+                devSum += p;
+            }
+            for (UidBatteryConsumer u : s.getUidBatteryConsumers()) {
+                final UidAcc ua = new UidAcc();
+                boolean any = false;
+                for (int st = 1; st < BatteryConsumer.PROCESS_STATE_COUNT; st++) {
+                    ua.stateMs[st] = u.getTimeInProcessStateMs(st);
+                    any |= ua.stateMs[st] > 0;
+                }
+                for (int comp = 0; comp <= BatteryConsumer.POWER_COMPONENT_IDLE; comp++) {
+                    final BatteryConsumer.Key[] keys = u.getKeys(comp);
+                    boolean states = false;
+                    for (BatteryConsumer.Key k : keys) {
+                        if (k.processState != BatteryConsumer.PROCESS_STATE_UNSPECIFIED) {
+                            states = true;
+                        }
+                    }
+                    for (BatteryConsumer.Key k : keys) {
+                        final boolean total =
+                                k.processState == BatteryConsumer.PROCESS_STATE_UNSPECIFIED;
+                        if (total == states) {
+                            continue;
+                        }
+                        final double p = u.getConsumedPower(k);
+                        final long ms = u.getUsageDurationMillis(k);
+                        if (p <= MIN_MAH && ms <= 0) {
+                            continue;
+                        }
+                        ua.comps.add(new double[] {comp, k.processState, p, ms});
+                        any = true;
+                    }
+                }
+                if (any) {
+                    a.uids.put(u.getUid(), ua);
+                    final String pkg = u.getPackageWithHighestDrain();
+                    if (pkg != null) {
+                        mPackages.put(u.getUid(), pkg);
+                    }
+                }
+            }
+            // Scale so that the model never exceeds what the gauge measured; what it does
+            // not explain is the device's idle draw.
+            final double measured = a.uah / 1000.0;
+            if (devSum > measured && devSum > 0) {
+                a.scale = measured / devSum;
+            } else {
+                a.scale = 1;
+            }
+            a.hasUsage = true;
+        }
+
+        private double mCapacityMah;
+        private final Map<Integer, String> mPackages = new HashMap<>();
+
+        // ----- network ----------------------------------------------------------------------
+
+        private void readNetwork() {
+            final NetworkStatsManager nsm = mContext.getSystemService(NetworkStatsManager.class);
+            if (nsm == null) {
+                return;
+            }
+            final NetworkTemplate wifi =
+                    new NetworkTemplate.Builder(NetworkTemplate.MATCH_WIFI).build();
+            final NetworkTemplate mobile =
+                    new NetworkTemplate.Builder(NetworkTemplate.MATCH_MOBILE).build();
+            for (Long h : mHours) {
+                final Acc a = mAccs.get(h);
+                if (!a.hasUsage) {
+                    continue;
+                }
+                final long to = a.tail ? mNow : RecordDb.nextHour(a.h);
+                for (NetworkTemplate template : new NetworkTemplate[] {wifi, mobile}) {
+                    try (NetworkStats ns = nsm.querySummary(template, a.h, to)) {
+                        final NetworkStats.Bucket b = new NetworkStats.Bucket();
+                        while (ns.hasNextBucket()) {
+                            ns.getNextBucket(b);
+                            final long bytes = b.getRxBytes() + b.getTxBytes();
+                            if (bytes <= 0) {
+                                continue;
+                            }
+                            final UidAcc ua = a.uids.get(b.getUid());
+                            if (ua == null) {
+                                continue;
+                            }
+                            if (b.getState() == NetworkStats.Bucket.STATE_FOREGROUND) {
+                                ua.rxFg += b.getRxBytes();
+                                ua.txFg += b.getTxBytes();
+                            } else {
+                                ua.rxBg += b.getRxBytes();
+                                ua.txBg += b.getTxBytes();
+                            }
+                        }
+                    } catch (RuntimeException e) {
+                        Log.w(TAG, "network stats unreadable", e);
+                        return;
+                    }
+                }
+            }
+        }
+
+        // ----- storage ----------------------------------------------------------------------
+
+        private void persist() {
+            final SQLiteDatabase db = mDb.getWritableDatabase();
+            db.beginTransaction();
+            try {
+                db.execSQL("DELETE FROM ev WHERE e >= ?", new Object[] {mWinStart});
+                for (Long h : mHours) {
+                    final Acc a = mAccs.get(h);
+                    for (String t : new String[] {"hour", "dev", "uid_hour", "uid_comp", "wl",
+                            "al", "wr", "nw"}) {
+                        db.execSQL("DELETE FROM " + t + " WHERE h = ?", new Object[] {a.h});
+                    }
+                    writeHour(db, a);
+                }
+                for (Ev e : mEvents) {
+                    db.execSQL("INSERT INTO ev (t, e, kind, uid, name, cnt, w, tail)"
+                            + " VALUES (?, ?, ?, ?, ?, ?, ?, ?)", new Object[] {e.t, e.e, e.kind,
+                            e.uid, e.name, e.cnt, e.w, e.e >= mCompleteEnd ? 1 : 0});
+                }
+                for (Map.Entry<Integer, String> p : packagesOfUids().entrySet()) {
+                    db.execSQL("INSERT OR REPLACE INTO uid_name (uid, pkg) VALUES (?, ?)",
+                            new Object[] {p.getKey(), p.getValue()});
+                }
+                if (mCapacityMah > 0) {
+                    RecordDb.putMeta(db, "cap_mah", Double.toString(mCapacityMah));
+                }
+                // The open events and totals at the complete end are what the next fold
+                // starts from.
+                db.execSQL("DELETE FROM open_ev");
+                for (Open o : mOpenAtCompleteEnd.values()) {
+                    db.execSQL("INSERT INTO open_ev (k, kind, uid, name, t, a, b)"
+                            + " VALUES (?, ?, ?, ?, ?, ?, ?)", new Object[] {o.key(), o.kind,
+                            o.uid, o.name, o.t, o.a, o.b});
+                }
+                if (mCompleteEnd > mWinStart) {
+                    RecordDb.putMeta(db, "fold_end", Long.toString(mCompleteEnd));
+                }
+                RecordDb.putMeta(db, "cum_mwh", Double.toString(
+                        Double.isNaN(mCumMwhAtCompleteEnd) ? mCumMwh : mCumMwhAtCompleteEnd));
+                RecordDb.putMeta(db, "cum_ms", Double.toString(
+                        Double.isNaN(mCumMwhAtCompleteEnd) ? mCumMs : mCumMsAtCompleteEnd));
+                db.setTransactionSuccessful();
+            } finally {
+                db.endTransaction();
+            }
+            mDb.prune(mNow);
+        }
+
+        /** The package of every uid this fold saw (the first one of a shared uid). */
+        private Map<Integer, String> packagesOfUids() {
+            final Map<Integer, String> out = new HashMap<>(mPackages);
+            final java.util.Set<Integer> uids = new java.util.HashSet<>();
+            for (Acc a : mAccs.values()) {
+                uids.addAll(a.uids.keySet());
+                for (String k : a.wlFull.keySet()) {
+                    uids.add(Integer.parseInt(k.split("\u0001", 3)[0]));
+                }
+                for (String k : a.wlPeriod.keySet()) {
+                    uids.add(Integer.parseInt(k.split("\u0001", 3)[0]));
+                }
+                for (String k : a.alarms.keySet()) {
+                    uids.add(Integer.parseInt(k.split("\u0001", 3)[0]));
+                }
+                uids.addAll(a.netWakes.keySet());
+            }
+            for (Ev e : mEvents) {
+                uids.add(e.uid);
+            }
+            for (int uid : uids) {
+                final String[] pkgs = mPm.getPackagesForUid(uid);
+                if (pkgs != null && pkgs.length > 0) {
+                    out.put(uid, pkgs[0]);
+                }
+            }
+            return out;
+        }
+
+        private void writeHour(SQLiteDatabase db, Acc a) {
+            db.execSQL("INSERT INTO hour (h, span, plug_ms, on_ms, off_ms, mah, mah_on, mah_off,"
+                    + " mah_chg, mwh, mwh_on, mwh_off, lv0, lv1, wakes, awake_ms, cpu_ms,"
+                    + " cpu_off_ms, radio_ms, weak_ms, wifi_ms, gps_ms, audio_ms, bt_ms, tail)"
+                    + " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,"
+                    + " ?, ?, ?)",
+                    new Object[] {a.h, a.span, a.plugMs, a.onMs, a.offMs, a.uah / 1000.0,
+                            a.uahOn / 1000.0, a.uahOff / 1000.0, a.uahChg / 1000.0, a.mwh,
+                            a.mwhOn, a.mwhOff, a.lv0, a.lv1, a.wakes, a.awakeMs, a.cpuMs,
+                            a.cpuOffMs, a.radioMs, a.weakMs, a.wifiMs, a.gpsMs, a.audioMs,
+                            a.btMs, a.tail ? 1 : 0});
+            for (Map.Entry<String, int[]> r : a.reasons.entrySet()) {
+                db.execSQL("INSERT INTO wr (h, name, cat, cnt) VALUES (?, ?, ?, ?)",
+                        new Object[] {a.h, r.getKey(), r.getValue()[0], r.getValue()[1]});
+            }
+            for (Map.Entry<Integer, long[]> n : a.netWakes.entrySet()) {
+                db.execSQL("INSERT INTO nw (h, uid, cnt) VALUES (?, ?, ?)",
+                        new Object[] {a.h, n.getKey(), n.getValue()[0]});
+            }
+            final Map<String, long[]> wl = a.wlFull.isEmpty() ? a.wlPeriod : a.wlFull;
+            for (Map.Entry<String, long[]> w : wl.entrySet()) {
+                final String[] k = w.getKey().split("\u0001", 3);
+                db.execSQL("INSERT OR REPLACE INTO wl (h, uid, name, scr, cnt, ms)"
+                        + " VALUES (?, ?, ?, ?, ?, ?)", new Object[] {a.h,
+                        Integer.parseInt(k[0]), k[2], Integer.parseInt(k[1]), w.getValue()[0],
+                        w.getValue()[1]});
+            }
+            for (Map.Entry<String, long[]> w : a.alarms.entrySet()) {
+                final String[] k = w.getKey().split("\u0001", 3);
+                db.execSQL("INSERT OR REPLACE INTO al (h, uid, name, scr, cnt)"
+                        + " VALUES (?, ?, ?, ?, ?)", new Object[] {a.h, Integer.parseInt(k[0]),
+                        k[2], Integer.parseInt(k[1]), w.getValue()[0]});
+            }
+            if (!a.hasUsage) {
+                return;
+            }
+            double explained = 0;
+            for (int comp = 0; comp <= BatteryConsumer.POWER_COMPONENT_IDLE; comp++) {
+                final double mah = a.devMah[comp] * a.scale;
+                explained += mah;
+                if (mah > MIN_MAH) {
+                    db.execSQL("INSERT INTO dev (h, comp, mah) VALUES (?, ?, ?)",
+                            new Object[] {a.h, comp, mah});
+                }
+            }
+            // What the models do not explain is split by the measured energy of the hour's
+            // screen-on and screen-off time: the idle platform draw is the screen-off part.
+            final double remainder = a.uah / 1000.0 - explained;
+            if (remainder > MIN_MAH && a.uah > 0) {
+                final double on = remainder * (a.uahOn / a.uah);
+                if (on > MIN_MAH) {
+                    db.execSQL("INSERT INTO dev (h, comp, mah) VALUES (?, ?, ?)",
+                            new Object[] {a.h, RecordDb.COMP_REMAINDER_ON, on});
+                }
+                if (remainder - on > MIN_MAH) {
+                    db.execSQL("INSERT INTO dev (h, comp, mah) VALUES (?, ?, ?)",
+                            new Object[] {a.h, RecordDb.COMP_STANDBY, remainder - on});
+                }
+            }
+            for (Map.Entry<Integer, UidAcc> e : a.uids.entrySet()) {
+                final UidAcc ua = e.getValue();
+                db.execSQL("INSERT INTO uid_hour (h, uid, fg_ms, fgs_ms, bg_ms, cache_ms, rx_fg,"
+                        + " tx_fg, rx_bg, tx_bg) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                        new Object[] {a.h, e.getKey(),
+                                ua.stateMs[BatteryConsumer.PROCESS_STATE_FOREGROUND],
+                                ua.stateMs[BatteryConsumer.PROCESS_STATE_FOREGROUND_SERVICE],
+                                ua.stateMs[BatteryConsumer.PROCESS_STATE_BACKGROUND],
+                                ua.stateMs[BatteryConsumer.PROCESS_STATE_CACHED],
+                                ua.rxFg, ua.txFg, ua.rxBg, ua.txBg});
+                for (double[] c : ua.comps) {
+                    final double mah = c[2] * a.scale;
+                    if (mah <= MIN_MAH && c[3] <= 0) {
+                        continue;
+                    }
+                    db.execSQL("INSERT OR REPLACE INTO uid_comp (h, uid, comp, st, mah, ms)"
+                            + " VALUES (?, ?, ?, ?, ?, ?)", new Object[] {a.h, e.getKey(),
+                            (int) c[0], (int) c[1], mah, (long) c[3]});
+                }
+            }
+        }
+    }
+}
