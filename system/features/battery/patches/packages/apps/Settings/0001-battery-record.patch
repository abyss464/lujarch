+     distributed under the License is distributed on an "AS IS" BASIS,
+     WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+     See the License for the specific language governing permissions and
+     limitations under the License.
+-->
+
+<!-- Lujarch battery record (BAT-1): the share of each power component, as one bar. -->
+<!-- The bar is a child of a plain root: the preference adapter's holder does not find a root
+     by its own id. -->
+<FrameLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content">
+
+    <com.android.settings.lujarch.battery.RecordSegmentsView
+        android:id="@+id/lujarch_segments"
+        android:layout_width="match_parent"
+        android:layout_height="44dp"
+        android:layout_marginHorizontal="?android:attr/listPreferredItemPaddingStart"
+        android:layout_marginVertical="8dp" />
+
+</FrameLayout>
