+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.DashPathEffect;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.view.View;
+import android.widget.FrameLayout;
+
+import com.android.settings.Utils;
+
+/**
+ * Lujarch battery record (BAT-1): one row of bars of the record charts: the 7 days (a
+ * bar is what a day used) and the 24 hours of a day (a bar is the hour's average power; a
+ * charging hour is a band; a dashed line is the battery level). Each bar is a view of its own,
+ * so touch and accessibility need nothing more.
+ */
+public final class RecordBarsView extends FrameLayout {
+
+    /** Listener of taps on a bar. */
+    interface Listener {
+        void onBar(int index);
+    }
+
+    /** What the view draws. Heights are values over {@link #max}; the bottom value is stacked. */
+    static final class Data {
+        int n;
+        float[] top;
+        float[] bottom;
+        int[] topColor;
+        int[] bottomColor;
+        boolean[] band;
+        boolean[] present;
+        String[] label;
+        String[] description;
+        float max = 1;
+        String maxLabel = "";
+        /** Level in percent at the n + 1 bar edges; NaN where unknown; null for none. */
+        float[] level;
+        /** The labels are the weekday of each bar (true) or 00 06 12 18 24 (false). */
+        boolean labelEachBar;
+        int selected = -1;
+
+        Data(int n) {
+            this.n = n;
+            top = new float[n];
+            bottom = new float[n];
+            topColor = new int[n];
+            bottomColor = new int[n];
+            band = new boolean[n];
+            present = new boolean[n];
+            label = new String[n];
+            description = new String[n];
+        }
+    }
+
+    private final float mDp;
+    private final Paint mText = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mLine = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mRing = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final Path mPath = new Path();
+    private final float mAxisWidth;
+    private final float mLabelHeight;
+    private final float mTopPad;
+    private final float mGap;
+
+    private Data mData;
+    private Listener mListener;
+    private final int mTextColor;
+    private final int mLineColor;
+    private final int mBandColor;
+    private final int mBandStroke;
+
+    public RecordBarsView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mDp = context.getResources().getDisplayMetrics().density;
+        mAxisWidth = 40 * mDp;
+        mLabelHeight = 20 * mDp;
+        mTopPad = 6 * mDp;
+        mGap = 2 * mDp;
+        mTextColor = Utils.getColorAttrDefaultColor(context, android.R.attr.textColorSecondary);
+        final int primary = Utils.getColorAttrDefaultColor(context, android.R.attr.textColorPrimary);
+        mLineColor = (primary & 0x00FFFFFF) | 0x99000000;
+        mBandColor = 0x553E9E6E;
+        mBandStroke = 0xAA3E9E6E;
+        mText.setColor(mTextColor);
+        mText.setTextSize(11 * mDp);
+        mLine.setStyle(Paint.Style.STROKE);
+        mLine.setStrokeWidth(1.5f * mDp);
+        mLine.setColor(mLineColor);
+        mLine.setPathEffect(new DashPathEffect(new float[] {3 * mDp, 3 * mDp}, 0));
+        mRing.setStyle(Paint.Style.STROKE);
+        mRing.setStrokeWidth(1.5f * mDp);
+        mRing.setColor(primary);
+        setWillNotDraw(false);
+    }
+
+    void setListener(Listener listener) {
+        mListener = listener;
+    }
+
+    void setData(Data data) {
+        final int old = mData == null ? -1 : mData.n;
+        mData = data;
+        if (data == null || old != data.n) {
+            removeAllViews();
+            if (data != null) {
+                for (int i = 0; i < data.n; i++) {
+                    final Bar bar = new Bar(getContext(), i);
+                    addView(bar, new LayoutParams(1, 1));
+                }
+            }
+        }
+        if (data != null) {
+            for (int i = 0; i < data.n; i++) {
+                final View bar = getChildAt(i);
+                bar.setContentDescription(data.description[i]);
+                bar.setClickable(data.present[i]);
+                bar.setSelected(i == data.selected);
+                bar.invalidate();
+            }
+        }
+        requestLayout();
+        invalidate();
+    }
+
+    private float plotWidth() {
+        return getWidth() - mAxisWidth;
+    }
+
+    @Override
+    protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+        if (mData == null) {
+            return;
+        }
+        final int n = mData.n;
+        final float bw = (plotWidth() - mGap * (n - 1)) / n;
+        for (int i = 0; i < n; i++) {
+            final int x = Math.round(i * (bw + mGap));
+            getChildAt(i).layout(x, 0, Math.round(x + bw), bottom - top);
+        }
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        super.onMeasure(widthMeasureSpec, heightMeasureSpec);
+        final int w = getMeasuredWidth();
+        final int h = getMeasuredHeight();
+        if (mData != null) {
+            final float bw = (w - mAxisWidth - mGap * (mData.n - 1)) / mData.n;
+            for (int i = 0; i < mData.n; i++) {
+                getChildAt(i).measure(MeasureSpec.makeMeasureSpec(Math.max(1, Math.round(bw)),
+                        MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(h, MeasureSpec.EXACTLY));
+            }
+        }
+    }
+
+    private float plotHeight() {
+        return getHeight() - mLabelHeight - mTopPad;
+    }
+
+    @Override
+    protected void dispatchDraw(Canvas canvas) {
+        super.dispatchDraw(canvas);
+        if (mData == null) {
+            return;
+        }
+        final int n = mData.n;
+        final float plotW = plotWidth();
+        final float bw = (plotW - mGap * (n - 1)) / n;
+        final float baseY = mTopPad + plotHeight();
+        if (mData.level != null) {
+            mPath.reset();
+            boolean open = false;
+            for (int i = 0; i <= n; i++) {
+                final float lv = mData.level[i];
+                if (Float.isNaN(lv)) {
+                    open = false;
+                    continue;
+                }
+                final float x = Math.min(plotW, i * (bw + mGap) - (i > 0 ? mGap / 2 : 0));
+                final float y = baseY - plotHeight() * Math.max(0, Math.min(100, lv)) / 100f;
+                if (open) {
+                    mPath.lineTo(x, y);
+                } else {
+                    mPath.moveTo(x, y);
+                    open = true;
+                }
+            }
+            canvas.drawPath(mPath, mLine);
+        }
+        if (!mData.maxLabel.isEmpty()) {
+            mText.setTextAlign(Paint.Align.RIGHT);
+            canvas.drawText(mData.maxLabel, getWidth(), mTopPad + 8 * mDp, mText);
+            canvas.drawText("0", getWidth(), baseY, mText);
+        }
+        final float labelY = baseY + mLabelHeight - 6 * mDp;
+        if (mData.labelEachBar) {
+            mText.setTextAlign(Paint.Align.CENTER);
+            for (int i = 0; i < n; i++) {
+                if (mData.label[i] != null) {
+                    canvas.drawText(mData.label[i], i * (bw + mGap) + bw / 2, labelY, mText);
+                }
+            }
+        } else {
+            final String[] ticks = {"00", "06", "12", "18", "24"};
+            for (int i = 0; i < ticks.length; i++) {
+                final float x = plotW * i / (ticks.length - 1);
+                mText.setTextAlign(i == 0 ? Paint.Align.LEFT
+                        : i == ticks.length - 1 ? Paint.Align.RIGHT : Paint.Align.CENTER);
+                canvas.drawText(ticks[i], x, labelY, mText);
+            }
+        }
+    }
+
+    /** One bar. */
+    private final class Bar extends View {
+        private final int mIndex;
+
+        Bar(Context context, int index) {
+            super(context);
+            mIndex = index;
+            setOnClickListener(v -> {
+                if (mListener != null) {
+                    mListener.onBar(mIndex);
+                }
+            });
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final Data d = mData;
+            if (d == null || mIndex >= d.n || !d.present[mIndex]) {
+                return;
+            }
+            final float w = getWidth();
+            final float plotH = plotHeight();
+            final float baseY = mTopPad + plotH;
+            final float radius = 3 * mDp;
+            float topEdge = baseY;
+            if (d.band[mIndex]) {
+                mRect.set(0, mTopPad, w, baseY);
+                mFill.setStyle(Paint.Style.FILL);
+                mFill.setColor(mBandColor);
+                canvas.drawRoundRect(mRect, radius, radius, mFill);
+                mFill.setStyle(Paint.Style.STROKE);
+                mFill.setStrokeWidth(mDp);
+                mFill.setColor(mBandStroke);
+                canvas.drawRoundRect(mRect, radius, radius, mFill);
+                mFill.setStyle(Paint.Style.FILL);
+                topEdge = mTopPad;
+            } else {
+                final float hBottom = d.bottom[mIndex] <= 0 ? 0
+                        : Math.max(2 * mDp, d.bottom[mIndex] / d.max * plotH);
+                final float hTop = d.top[mIndex] <= 0 ? 0
+                        : Math.max(2 * mDp, d.top[mIndex] / d.max * plotH);
+                mFill.setStyle(Paint.Style.FILL);
+                if (hBottom > 0) {
+                    mRect.set(0, baseY - hBottom, w, baseY);
+                    mFill.setColor(d.bottomColor[mIndex]);
+                    canvas.drawRoundRect(mRect, radius, radius, mFill);
+                    topEdge = baseY - hBottom;
+                }
+                if (hTop > 0) {
+                    mRect.set(0, baseY - hBottom - hTop, w, baseY - hBottom + (hBottom > 0 ? radius : 0));
+                    mFill.setColor(d.topColor[mIndex]);
+                    canvas.drawRoundRect(mRect, radius, radius, mFill);
+                    topEdge = baseY - hBottom - hTop;
+                }
+            }
+            if (mIndex == d.selected) {
+                mRect.set(-mDp, topEdge - 2 * mDp, w + mDp, baseY + 2 * mDp);
+                canvas.drawRoundRect(mRect, radius, radius, mRing);
+            }
+        }
+    }
+}
