+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.os.BatteryConsumer;
+import android.os.Handler;
+import android.os.Looper;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.Utils;
+import com.android.settings.fuelgauge.batteryusage.PowerGaugePreference;
+import com.android.settingslib.core.AbstractPreferenceController;
+import com.android.settingslib.core.lifecycle.Lifecycle;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnDestroy;
+import com.android.settingslib.core.lifecycle.events.OnResume;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Lujarch battery record (BAT-1): App battery usage. The chart of one app for the
+ * 7 days and the hours of the chosen day, what its power was made of, how long it ran in each
+ * process state, what it did while the screen was off, and every event of it in time order;
+ * the day or hour chosen on the page it was opened from is chosen here too.
+ */
+public final class RecordAppPageController extends AbstractPreferenceController
+        implements LifecycleObserver, OnResume, OnDestroy {
+
+    private static final String KEY_HEADER = "header_view";
+    private static final String KEY_CHART = "lujarch_app_chart";
+    private static final String KEY_COMPONENTS = "lujarch_app_components";
+    private static final String KEY_SEGMENTS = "lujarch_app_segments";
+    private static final String KEY_STATES = "lujarch_app_states";
+    private static final String KEY_OFF = "lujarch_app_off";
+    private static final String KEY_TIMELINE = "lujarch_app_timeline";
+    private static final int MAX_TIMELINE_ROWS = 300;
+    private static final int MAX_TAGS = 4;
+
+    /** Colors of the power components, in the order of the rows. */
+    private static final int[] PALETTE = {
+            0xFFC8C1ED, 0xFFA79FD6, 0xFF7FA7C9, 0xFF5F86A8, 0xFF8C84B8, 0xFF6E6A80, 0xFF9FB58A,
+            0xFF6F8FB0, 0xFF4A4756};
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+    private final int mUid;
+    private final String mPackage;
+
+    private Preference mHeader;
+    private RecordChartPreference mChartPref;
+    private PreferenceCategory mComponents;
+    private RecordSegmentsPreference mSegments;
+    private PreferenceCategory mStates;
+    private PreferenceCategory mOff;
+    private PreferenceCategory mTimeline;
+
+    private volatile int mSelDay;
+    private volatile int mSelHour;
+    private boolean mDestroyed;
+
+    /** One line of a section. */
+    private static final class Row {
+        String title;
+        String summary;
+        String widget;
+        /** The color square of a power component (its share in the bar), or 0. */
+        int color;
+    }
+
+    /** Everything the page shows, built on a background thread. */
+    private static final class Model {
+        RecordChartPreference.Model chart;
+        String header;
+        List<Row> components = new ArrayList<>();
+        float[] segmentWeights = new float[0];
+        int[] segmentColors = new int[0];
+        List<Row> states = new ArrayList<>();
+        List<Row> off = new ArrayList<>();
+        String timelineTitle;
+        List<Row> timeline = new ArrayList<>();
+    }
+
+    public RecordAppPageController(Context context, Lifecycle lifecycle, int uid,
+            String packageName, int day, int hour) {
+        super(context);
+        mUid = uid;
+        mPackage = packageName;
+        mSelDay = day >= 0 && day < RecordStore.DAYS ? day : RecordStore.DAYS - 1;
+        mSelHour = hour;
+        if (lifecycle != null) {
+            lifecycle.addObserver(this);
+        }
+    }
+
+    @Override
+    public boolean isAvailable() {
+        return true;
+    }
+
+    @Override
+    public String getPreferenceKey() {
+        return KEY_HEADER;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mHeader = screen.findPreference(KEY_HEADER);
+        mChartPref = screen.findPreference(KEY_CHART);
+        mComponents = screen.findPreference(KEY_COMPONENTS);
+        mSegments = screen.findPreference(KEY_SEGMENTS);
+        mStates = screen.findPreference(KEY_STATES);
+        mOff = screen.findPreference(KEY_OFF);
+        mTimeline = screen.findPreference(KEY_TIMELINE);
+        mComponents.setOrderingAsAdded(false);
+        mStates.setOrderingAsAdded(false);
+        mOff.setOrderingAsAdded(false);
+        mTimeline.setOrderingAsAdded(false);
+    }
+
+    @Override
+    public void onResume() {
+        refresh();
+    }
+
+    @Override
+    public void onDestroy() {
+        mDestroyed = true;
+        mHandler.removeCallbacksAndMessages(null);
+        mExecutor.shutdownNow();
+    }
+
+    private void refresh() {
+        try {
+            mExecutor.execute(() -> {
+                final Model m = load();
+                mHandler.post(() -> {
+                    if (!mDestroyed) {
+                        bind(m);
+                    }
+                });
+            });
+        } catch (RuntimeException e) {
+            // The page is gone and its executor is shut down.
+        }
+    }
+
+    // ----- loading ----------------------------------------------------------------------------
+
+    private Model load() {
+        final int day = mSelDay;
+        final int hour = mSelHour;
+        final RecordStore store = new RecordStore(mContext);
+        final Model m = new Model();
+        m.chart = new RecordChartPreference.Model();
+        m.chart.summary = mContext.getString(R.string.lujarch_battery_app_chart_hint);
+
+        final int accent = Utils.getColorAttrDefaultColor(mContext, android.R.attr.colorAccent);
+        final int muted = (Utils.getColorAttrDefaultColor(mContext,
+                android.R.attr.textColorSecondary) & 0x00FFFFFF) | 0x66000000;
+
+        // The upper tier: what the app used on each day.
+        final double[] dayMah = store.appDays(mUid);
+        final List<RecordStore.Day> days = store.days();
+        final RecordBarsView.Data dd = new RecordBarsView.Data(RecordStore.DAYS);
+        double maxDay = 1;
+        for (double v : dayMah) {
+            maxDay = Math.max(maxDay, v);
+        }
+        dd.max = (float) maxDay;
+        dd.labelEachBar = true;
+        dd.selected = day;
+        for (int i = 0; i < RecordStore.DAYS; i++) {
+            final boolean today = i == RecordStore.DAYS - 1;
+            dd.present[i] = days.get(i).data;
+            dd.top[i] = (float) dayMah[i];
+            dd.topColor[i] = i == day ? accent : muted;
+            dd.label[i] = today ? mContext.getString(R.string.lujarch_battery_today)
+                    : RecordFormat.weekday(days.get(i).start);
+            dd.description[i] = RecordFormat.dayTitle(mContext, days.get(i).start, today) + ", "
+                    + RecordFormat.mah(mContext, dayMah[i]);
+        }
+        m.chart.days = dd;
+
+        // The lower tier: the app's use in each hour of the day, foreground over background.
+        final double[][] hourMah = store.appHours(mUid, day);
+        final List<RecordStore.Hour> hours = store.hours(day);
+        final RecordBarsView.Data hd = new RecordBarsView.Data(hours.size());
+        double maxHour = 0;
+        for (int i = 0; i < hours.size(); i++) {
+            maxHour = Math.max(maxHour, hourMah[i][0] + hourMah[i][1]);
+        }
+        final double axis = niceMah(maxHour);
+        hd.max = (float) axis;
+        hd.maxLabel = RecordFormat.mah(mContext, axis);
+        hd.selected = hour;
+        for (int i = 0; i < hours.size(); i++) {
+            final RecordStore.Hour h = hours.get(i);
+            hd.present[i] = h.data;
+            hd.top[i] = (float) hourMah[i][0];
+            hd.bottom[i] = (float) hourMah[i][1];
+            hd.topColor[i] = accent;
+            hd.bottomColor[i] = muted;
+            final long end = h.tail ? h.start + h.span : RecordDb.nextHour(h.start);
+            hd.description[i] = RecordFormat.hourSpan(h.start, end) + ", "
+                    + RecordFormat.mah(mContext, hourMah[i][0] + hourMah[i][1]);
+        }
+        m.chart.hours = hd;
+        m.chart.legendColors = new int[] {accent, muted};
+        m.chart.legendTexts = new String[] {
+                mContext.getString(R.string.lujarch_battery_legend_foreground),
+                mContext.getString(R.string.lujarch_battery_legend_background)};
+        m.chart.dayListener = i -> {
+            if (mSelDay != i) {
+                mSelDay = i;
+                mSelHour = -1;
+                refresh();
+            }
+        };
+        m.chart.hourListener = i -> {
+            mSelHour = mSelHour == i ? -1 : i;
+            refresh();
+        };
+
+        final long[] range = store.range(day, hour);
+        final String title;
+        if (hour < 0) {
+            title = RecordFormat.dayTitle(mContext, range[0], day == RecordStore.DAYS - 1);
+        } else {
+            final RecordStore.Hour h = hours.get(Math.min(hour, hours.size() - 1));
+            title = RecordFormat.hourSpan(range[0],
+                    h.tail && h.span > 0 ? h.start + h.span : range[1]);
+        }
+
+        // The power components, each split by process state.
+        final List<RecordStore.Component> comps = store.components(mUid, range[0], range[1]);
+        double appMah = 0;
+        final List<Float> weights = new ArrayList<>();
+        final List<Integer> colors = new ArrayList<>();
+        for (RecordStore.Component c : comps) {
+            appMah += c.mah;
+        }
+        int ci = 0;
+        for (RecordStore.Component c : comps) {
+            final Row r = new Row();
+            r.title = componentName(c.comp);
+            r.summary = RecordPageController.join(
+                    state(R.string.lujarch_battery_state_fg, c.byState[0] + c.byState[
+                            BatteryConsumer.PROCESS_STATE_FOREGROUND]),
+                    state(R.string.lujarch_battery_state_fgs, c.byState[
+                            BatteryConsumer.PROCESS_STATE_FOREGROUND_SERVICE]),
+                    state(R.string.lujarch_battery_state_bg, c.byState[
+                            BatteryConsumer.PROCESS_STATE_BACKGROUND] + c.byState[
+                            BatteryConsumer.PROCESS_STATE_CACHED]));
+            r.widget = RecordFormat.mah(mContext, c.mah);
+            r.color = PALETTE[ci++ % PALETTE.length];
+            m.components.add(r);
+            weights.add((float) c.mah);
+            colors.add(r.color);
+        }
+        m.segmentWeights = new float[weights.size()];
+        m.segmentColors = new int[weights.size()];
+        for (int i = 0; i < weights.size(); i++) {
+            m.segmentWeights[i] = weights.get(i);
+            m.segmentColors[i] = colors.get(i);
+        }
+
+        // The header: what the app used in the selection and its share of the day.
+        final StringBuilder header = new StringBuilder(title);
+        header.append(" · ").append(mContext.getString(
+                R.string.lujarch_battery_usage_summary, RecordFormat.mah(mContext, appMah)));
+        if (hour < 0) {
+            final long[] whole = store.range(day, -1);
+            final double dayTotal = store.summary(whole[0], whole[1]).mah;
+            if (dayTotal > 0) {
+                header.append(" · ").append(mContext.getString(
+                        R.string.lujarch_battery_share_of_day,
+                        RecordFormat.percent(appMah / dayTotal * 100)));
+            }
+        }
+        m.header = header.toString();
+
+        // How long and how much in each process state.
+        final RecordStore.State[] states = store.states(mUid, range[0], range[1]);
+        final int[] stateOrder = {BatteryConsumer.PROCESS_STATE_FOREGROUND,
+                BatteryConsumer.PROCESS_STATE_FOREGROUND_SERVICE,
+                BatteryConsumer.PROCESS_STATE_BACKGROUND, BatteryConsumer.PROCESS_STATE_CACHED};
+        final int[] stateNames = {R.string.lujarch_battery_state_fg,
+                R.string.lujarch_battery_state_fgs, R.string.lujarch_battery_state_bg,
+                R.string.lujarch_battery_state_cached};
+        for (int i = 0; i < stateOrder.length; i++) {
+            final RecordStore.State s = states[stateOrder[i]];
+            if (s.ms <= 0 && s.mah < 0.5) {
+                continue;
+            }
+            final Row r = new Row();
+            r.title = mContext.getString(stateNames[i]);
+            r.summary = RecordFormat.duration(mContext, s.ms);
+            r.widget = RecordFormat.mah(mContext, s.mah);
+            m.states.add(r);
+        }
+
+        // What it did while the screen was off.
+        offRows(m, store, range);
+
+        // Every event of the app in the selection, in time order.
+        m.timelineTitle = mContext.getString(R.string.lujarch_battery_timeline_title, title);
+        int n = 0;
+        for (RecordStore.Event e : store.timeline(mUid, range[0], range[1])) {
+            if (n++ >= MAX_TIMELINE_ROWS) {
+                break;
+            }
+            m.timeline.add(eventRow(e));
+        }
+        return m;
+    }
+
+    private String state(int nameRes, double mah) {
+        if (mah < 0.5) {
+            return null;
+        }
+        return mContext.getString(nameRes) + " " + RecordFormat.mah(mContext, mah);
+    }
+
+    private void offRows(Model m, RecordStore store, long[] range) {
+        final List<RecordStore.Named> locks = store.wakelocks(mUid, range[0], range[1]);
+        if (!locks.isEmpty()) {
+            int count = 0;
+            long ms = 0;
+            final List<String> tags = new ArrayList<>();
+            for (RecordStore.Named l : locks) {
+                count += l.count;
+                ms += l.ms;
+                if (tags.size() < MAX_TAGS) {
+                    tags.add(l.name + " " + RecordFormat.duration(mContext, l.ms));
+                }
+            }
+            final Row r = new Row();
+            r.title = mContext.getString(R.string.lujarch_battery_off_wakelocks);
+            r.summary = String.join(mContext.getString(R.string.lujarch_battery_list_separator),
+                    tags);
+            r.widget = RecordPageController.join(
+                    mContext.getResources().getQuantityString(R.plurals.lujarch_battery_times, (int) (count), count),
+                    RecordFormat.duration(mContext, ms));
+            m.off.add(r);
+        }
+        final List<RecordStore.Named> alarms = store.alarms(mUid, range[0], range[1]);
+        if (!alarms.isEmpty()) {
+            int count = 0;
+            final List<String> tags = new ArrayList<>();
+            for (RecordStore.Named a : alarms) {
+                count += a.count;
+                if (tags.size() < MAX_TAGS) {
+                    tags.add(a.name + " " + mContext.getResources().getQuantityString(R.plurals.lujarch_battery_times, (int) (a.count), a.count));
+                }
+            }
+            final Row r = new Row();
+            r.title = mContext.getString(R.string.lujarch_battery_off_alarms);
+            r.summary = String.join(mContext.getString(R.string.lujarch_battery_list_separator),
+                    tags);
+            r.widget = mContext.getResources().getQuantityString(R.plurals.lujarch_battery_times, (int) (count), count);
+            m.off.add(r);
+        }
+        final List<RecordStore.Named> jobs = store.jobs(mUid, range[0], range[1]);
+        if (!jobs.isEmpty()) {
+            int count = 0;
+            long ms = 0;
+            final List<String> tags = new ArrayList<>();
+            for (RecordStore.Named j : jobs) {
+                count += j.count;
+                ms += j.ms;
+                if (tags.size() < MAX_TAGS) {
+                    tags.add(simpleName(j.name) + " " + mContext.getResources().getQuantityString(R.plurals.lujarch_battery_times, (int) (j.count), j.count));
+                }
+            }
+            final Row r = new Row();
+            r.title = mContext.getString(R.string.lujarch_battery_off_jobs);
+            r.summary = String.join(mContext.getString(R.string.lujarch_battery_list_separator),
+                    tags);
+            r.widget = RecordPageController.join(
+                    mContext.getResources().getQuantityString(R.plurals.lujarch_battery_times, (int) (count), count),
+                    RecordFormat.duration(mContext, ms));
+            m.off.add(r);
+        }
+        final int net = store.networkWakes(mUid, range[0], range[1]);
+        if (net > 0) {
+            final Row r = new Row();
+            r.title = mContext.getString(R.string.lujarch_battery_off_network_wakes);
+            r.summary = mContext.getString(R.string.lujarch_battery_off_network_wakes_detail);
+            r.widget = mContext.getResources().getQuantityString(R.plurals.lujarch_battery_times, (int) (net), net);
+            m.off.add(r);
+        }
+        final long[] traffic = store.backgroundTraffic(mUid, range[0], range[1]);
+        if (traffic[0] + traffic[1] > 0) {
+            final Row r = new Row();
+            r.title = mContext.getString(R.string.lujarch_battery_off_traffic);
+            r.summary = RecordPageController.join(
+                    mContext.getString(R.string.lujarch_battery_off_traffic_rx,
+                            RecordFormat.bytes(mContext, traffic[0])),
+                    mContext.getString(R.string.lujarch_battery_off_traffic_tx,
+                            RecordFormat.bytes(mContext, traffic[1])),
+                    traffic[2] >= 30_000L ? mContext.getString(
+                            R.string.lujarch_battery_off_traffic_radio,
+                            RecordFormat.duration(mContext, traffic[2])) : null);
+            m.off.add(r);
+        }
+    }
+
+    private Row eventRow(RecordStore.Event e) {
+        final Row r = new Row();
+        final long ms = Math.max(0, e.e - e.t);
+        switch (e.kind) {
+            case RecordDb.EV_FOREGROUND:
+                r.title = mContext.getString(R.string.lujarch_battery_event_foreground,
+                        RecordFormat.hourSpan(e.t, e.e));
+                r.summary = RecordPageController.join(RecordFormat.duration(mContext, ms),
+                        e.watts >= 0 ? mContext.getString(
+                                R.string.lujarch_battery_event_device_power,
+                                RecordFormat.power(mContext, e.watts)) : null);
+                r.widget = e.mah >= 0.5 ? RecordFormat.mah(mContext, e.mah) : null;
+                break;
+            case RecordDb.EV_FG_SERVICE:
+                r.title = mContext.getString(R.string.lujarch_battery_event_service,
+                        RecordFormat.hourSpan(e.t, e.e));
+                r.summary = RecordFormat.duration(mContext, ms);
+                r.widget = e.mah >= 0.5 ? RecordFormat.mah(mContext, e.mah) : null;
+                break;
+            case RecordDb.EV_JOB:
+                r.title = mContext.getString(R.string.lujarch_battery_off_jobs);
+                r.summary = RecordPageController.join(RecordFormat.clock(e.t),
+                        simpleName(e.name), RecordFormat.shortDuration(mContext, ms));
+                break;
+            case RecordDb.EV_LONG_WAKELOCK:
+                r.title = mContext.getString(R.string.lujarch_battery_event_wakelock);
+                r.summary = RecordPageController.join(RecordFormat.clock(e.t), e.name,
+                        RecordFormat.duration(mContext, ms));
+                break;
+            default:
+                r.title = mContext.getResources().getQuantityString(R.plurals.lujarch_battery_event_network_wakes, (int) (e.count), e.count);
+                r.summary = RecordPageController.join(RecordFormat.hourSpan(e.t, e.e),
+                        mContext.getString(R.string.lujarch_battery_off_network_wakes_detail));
+                break;
+        }
+        return r;
+    }
+
+    /** The name of a job: WorkManager's "#name#@..." gives name, else the class name. */
+    private static String simpleName(String name) {
+        if (name.startsWith("#")) {
+            final int end = name.indexOf('#', 1);
+            if (end > 1) {
+                return name.substring(1, end);
+            }
+        }
+        final int slash = name.lastIndexOf('/');
+        String s = slash >= 0 ? name.substring(slash + 1) : name;
+        final int dot = s.lastIndexOf('.');
+        if (dot >= 0 && dot < s.length() - 1) {
+            s = s.substring(dot + 1);
+        }
+        return s;
+    }
+
+    private static double niceMah(double max) {
+        final double[] steps = {10, 20, 50, 100, 200, 500, 1000, 2000};
+        for (double s : steps) {
+            if (max * 1.05 <= s) {
+                return s;
+            }
+        }
+        return Math.ceil(max);
+    }
+
+    private String componentName(int comp) {
+        final int res;
+        switch (comp) {
+            case BatteryConsumer.POWER_COMPONENT_SCREEN:
+                res = R.string.lujarch_battery_sys_screen;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_CPU:
+                res = R.string.lujarch_battery_sys_cpu;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_BLUETOOTH:
+                res = R.string.lujarch_battery_sys_bluetooth;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_CAMERA:
+                res = R.string.lujarch_battery_comp_camera;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_AUDIO:
+                res = R.string.lujarch_battery_sys_audio;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_VIDEO:
+                res = R.string.lujarch_battery_comp_video;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_FLASHLIGHT:
+                res = R.string.lujarch_battery_comp_flashlight;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_MOBILE_RADIO:
+                res = R.string.lujarch_battery_sys_mobile;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_SENSORS:
+                res = R.string.lujarch_battery_comp_sensors;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_GNSS:
+                res = R.string.lujarch_battery_sys_gps;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_WIFI:
+                res = R.string.lujarch_battery_sys_wlan;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_WAKELOCK:
+                res = R.string.lujarch_battery_off_wakelocks;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_PHONE:
+                res = R.string.lujarch_battery_comp_phone;
+                break;
+            case BatteryConsumer.POWER_COMPONENT_AMBIENT_DISPLAY:
+                res = R.string.lujarch_battery_comp_ambient;
+                break;
+            default:
+                res = R.string.lujarch_battery_sys_other;
+                break;
+        }
+        return mContext.getString(res);
+    }
+
+    // ----- showing ------------------------------------------------------------------------------
+
+    private void bind(Model m) {
+        if (mChartPref == null) {
+            return;
+        }
+        mHeader.setSummary(m.header);
+        mChartPref.setModel(m.chart);
+        mSegments.setSegments(m.segmentWeights, m.segmentColors);
+        mComponents.setVisible(!m.components.isEmpty());
+        fill(mComponents, m.components, 1);
+        mStates.setVisible(!m.states.isEmpty());
+        fill(mStates, m.states, 0);
+        mOff.setVisible(!m.off.isEmpty());
+        fill(mOff, m.off, 0);
+        mTimeline.setTitle(m.timelineTitle);
+        mTimeline.setVisible(!m.timeline.isEmpty());
+        fill(mTimeline, m.timeline, 0);
+    }
+
+    /** Replaces the rows of a section; {@code keep} first children stay. */
+    private void fill(PreferenceCategory category, List<Row> rows, int keep) {
+        for (int i = category.getPreferenceCount() - 1; i >= keep; i--) {
+            category.removePreference(category.getPreference(i));
+        }
+        int order = keep;
+        for (Row row : rows) {
+            final PowerGaugePreference p = new PowerGaugePreference(mContext);
+            p.setTitle(row.title);
+            p.setSummary(row.summary);
+            p.setPercentage(row.widget == null ? "" : row.widget);
+            if (row.color != 0) {
+                final android.graphics.drawable.GradientDrawable d =
+                        new android.graphics.drawable.GradientDrawable();
+                final int size = Math.round(12 * mContext.getResources().getDisplayMetrics().density);
+                d.setColor(row.color);
+                d.setCornerRadius(size / 4f);
+                d.setSize(size, size);
+                p.setIcon(d);
+            }
+            p.setSelectable(false);
+            p.setKey(category.getKey() + "_" + order);
+            p.setOrder(order++);
+            category.addPreference(p);
+        }
+    }
+}
