+     distributed under the License is distributed on an "AS IS" BASIS,
+     WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+     See the License for the specific language governing permissions and
+     limitations under the License.
+-->
+
+<!-- Lujarch battery record (BAT-1): two tiles of a selection, a row of its card. The gap between
+     them is the page's own color, as the gaps between the card's rows. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:baselineAligned="false"
+    android:orientation="horizontal">
+
+    <include
+        android:id="@+id/lujarch_tile_a"
+        layout="@layout/lujarch_record_tile" />
+
+    <View
+        android:layout_width="2dp"
+        android:layout_height="match_parent"
+        android:background="?android:attr/colorBackground" />
+
+    <include
+        android:id="@+id/lujarch_tile_b"
+        layout="@layout/lujarch_record_tile" />
+
+</LinearLayout>
