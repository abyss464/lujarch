+package com.android.settings.lujarch.battery;
+
+import android.content.Context;
+import android.os.Bundle;
+
+import com.android.settings.core.InstrumentedPreferenceFragment;
+import com.android.settingslib.core.lifecycle.Lifecycle;
+
+/**
+ * Lujarch battery record (BAT-1): Battery usage
+ * is a record of the last 7 days, built from the battery history and the power estimates the
+ * system already keeps. This is what the Settings classes it hooks into call.
+ *
+ * <p>Nothing here schedules, samples or holds anything: the record is folded by Settings'
+ * hourly job ({@code BatteryUsageDataLoader}) and when its page opens.
+ */
+public final class LujarchBatteryRecord {
+
+    /** Extras of App battery usage: the day (0 oldest .. 6 today) and hour (-1 none) chosen. */
+    public static final String EXTRA_DAY = "lujarch_record_day";
+    public static final String EXTRA_HOUR = "lujarch_record_hour";
+
+    private LujarchBatteryRecord() {}
+
+    /** Folds the history since the last fold into the record (a worker thread). */
+    public static void fold(Context context) {
+        RecordFold.run(context);
+    }
+
+    /** The controller of the Battery usage page. */
+    public static RecordPageController newPageController(Context context, Lifecycle lifecycle,
+            InstrumentedPreferenceFragment fragment) {
+        return new RecordPageController(context, lifecycle, fragment);
+    }
+
+    /** The controller of the App battery usage page, from the page's arguments. */
+    public static RecordAppPageController newAppPageController(Context context,
+            Lifecycle lifecycle, Bundle args, int uid, String packageName) {
+        return new RecordAppPageController(context, lifecycle, uid, packageName,
+                args.getInt(EXTRA_DAY, RecordStore.DAYS - 1), args.getInt(EXTRA_HOUR, -1));
+    }
+}
diff --git a/src/com/android/settings/lujarch/battery/RecordAppPageController.java b/src/com/android/settings/lujarch/battery/RecordAppPageController.java
new file mode 100644
