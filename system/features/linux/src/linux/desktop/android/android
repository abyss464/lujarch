class Interface:
    def __init__(self, name, methods=None, properties=None, signals=None):
        self.name = name
        self.methods = methods or {}
        self.properties = properties or {}
        self.signals = signals or {}  # name -> (sig, arg names)

    def xml(self):
        def args(sig, names, direction):
            out = []
            for i, t in enumerate(split_signature(sig)):
                name = ' name="%s"' % names[i] if i < len(names) else ""
                d = ' direction="%s"' % direction if direction else ""
                out.append('      <arg type="%s"%s%s/>' % (t, name, d))
            return out

        lines = ['  <interface name="%s">' % self.name]
        for name, m in self.methods.items():
            lines.append('    <method name="%s">' % name)
            lines += args(m.in_sig, m.in_names, "in") + args(m.out_sig, m.out_names, "out")
            lines.append("    </method>")
        for name, (sig, names) in self.signals.items():
            lines.append('    <signal name="%s">' % name)
            lines += args(sig, names, "")
            lines.append("    </signal>")
        for name, p in self.properties.items():
            lines.append('    <property name="%s" type="%s" access="%s"/>' % (name, p.sig, "readwrite" if p.set else "read"))
        lines.append("  </interface>")
        return "\n".join(lines)


