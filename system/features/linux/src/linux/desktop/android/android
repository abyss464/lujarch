# ------------------------------------------------------------------ lujarch_linux's FIFOs

def fifo_line(path, line):
    """One line into a FIFO lujarch_linux reads; an error's text when it cannot be written (the part is
    not lent, or lujarch_linux does not read it)."""
    try:
        fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as e:
        return e.strerror or str(e)
    try:
        os.write(fd, (line + "\n").encode("utf-8", "replace"))
    except OSError as e:
        return e.strerror or str(e)
    finally:
        os.close(fd)
    return None


class Latest:
    """fn(value) for the latest value put, in a thread of its own: a slow fn never holds the loop, and a value
    not yet taken is replaced by a newer one."""

    def __init__(self, fn, name):
        self.fn = fn
        self.cv = threading.Condition()
        self.pending = False
        self.value = None
        threading.Thread(target=self.run, daemon=True, name=name).start()

    def put(self, value):
        with self.cv:
            self.value = value
            self.pending = True
            self.cv.notify()

    def run(self):
        while True:
            with self.cv:
                while not self.pending:
                    self.cv.wait()
                value, self.pending = self.value, False
            try:
                self.fn(value)
            except Exception:
                log("an error in a worker (kept going):\n" + traceback.format_exc())


class Setter:
    """One of Android's switches set from the loop, the latest value at most every `pace` seconds."""

    def __init__(self, key, pace=0.0):
        self.key = key
        self.pace = pace
        self.failing = False
        self.latest = Latest(self.send, "set-" + key)

    def put(self, value):
        self.latest.put(value)

    def send(self, value):
        error = fifo_line(SET_FIFO, "%s %s" % (self.key, value))
        if error is None:
            self.failing = False
        elif not self.failing:
            self.failing = True
            log("%s not set (%s): Android's quick settings are not lent" % (self.key, error))
        if self.pace:
            time.sleep(self.pace)


class Vibrator:
    """Vibration requests in order, from a thread of their own; one that waited longer than STALE_S is
    dropped (a key's tick after the moment is wrong, not late)."""

    STALE_S = 0.5

    def __init__(self):
        self.cv = threading.Condition()
        self.queue = collections.deque(maxlen=16)
        self.failing = False
        threading.Thread(target=self.run, daemon=True, name="vibrate").start()

    def put(self, value):
        with self.cv:
            self.queue.append((time.monotonic(), value))
            self.cv.notify()

    def run(self):
        while True:
            with self.cv:
                while not self.queue:
                    self.cv.wait()
                queued, value = self.queue.popleft()
            if time.monotonic() - queued > self.STALE_S:
                continue
            error = fifo_line(VIBRATE_FIFO, value)
            if error is None:
                self.failing = False
            elif not self.failing:
                # One line per streak: a keyboard sends a request per key.
                self.failing = True
                log("vibration not played (%s): vibration is not lent" % error)


# ------------------------------------------------------------------ D-Bus

BASIC = {"y": ("B", 1), "b": ("I", 4), "n": ("h", 2), "q": ("H", 2), "i": ("i", 4), "u": ("I", 4),
         "x": ("q", 8), "t": ("Q", 8), "d": ("d", 8), "h": ("I", 4)}
ALIGN = {"s": 4, "o": 4, "g": 1, "v": 1, "a": 4, "(": 8, "{": 8}
ALIGN.update({c: size for c, (_, size) in BASIC.items()})


class Variant:
    """A D-Bus variant: a value with its own signature."""
    __slots__ = ("sig", "value")

    def __init__(self, sig, value):
        self.sig = sig
        self.value = value

    def __repr__(self):
        return "Variant(%r, %r)" % (self.sig, self.value)


def type_end(sig, i):
    """The index after the complete type that starts at sig[i]."""
    if i >= len(sig):
        raise ValueError("the signature %r ends early" % sig)
    c = sig[i]
    if c == "a":
        return type_end(sig, i + 1)
    if c in "({":
        close = ")" if c == "(" else "}"
        i += 1
        while i < len(sig) and sig[i] != close:
            i = type_end(sig, i)
        if i >= len(sig):
            raise ValueError("unclosed %r in the signature %r" % (c, sig))
        return i + 1
    if c in ALIGN:
        return i + 1
    raise ValueError("unknown type %r in the signature %r" % (c, sig))


def split_signature(sig):
    """The complete types of a signature, in order."""
    types = []
    i = 0
    while i < len(sig):
        j = type_end(sig, i)
        types.append(sig[i:j])
        i = j
    return types


class Marshal:
    """D-Bus values into a little-endian body: basic types, strings, object paths, signatures, arrays,
    dicts (a dict or (key, value) pairs), structs (tuples) and variants (Variant)."""

    @staticmethod
    def pad(buf, n):
        while len(buf) % n:
            buf.append(0)

    @classmethod
    def u32(cls, buf, v):
        cls.pad(buf, 4)
        buf += struct.pack("<I", v)

    @classmethod
    def i32(cls, buf, v):
        cls.pad(buf, 4)
        buf += struct.pack("<i", v)

    @classmethod
    def string(cls, buf, s):
        b = s.encode("utf-8", "replace")
        cls.u32(buf, len(b))
        buf += b + b"\0"

    @staticmethod
    def signature(buf, s):
        b = s.encode()
        buf.append(len(b))
        buf += b + b"\0"

    @classmethod
    def value(cls, buf, sig, v):
        c = sig[0]
        if c in BASIC:
            fmt, size = BASIC[c]
            cls.pad(buf, size)
            if c == "b":
                v = 1 if v else 0
            elif c == "d":
                v = float(v)
            buf += struct.pack("<" + fmt, v)
        elif c in "so":
            cls.string(buf, v)
        elif c == "g":
            cls.signature(buf, v)
        elif c == "v":
            if not isinstance(v, Variant):
                raise ValueError("a variant needs a Variant")
            cls.signature(buf, v.sig)
            cls.value(buf, v.sig, v.value)
        elif c == "a":
            cls.pad(buf, 4)
            at = len(buf)
            buf += b"\0\0\0\0"
            element = sig[1:]
            cls.pad(buf, ALIGN[element[0]])
            start = len(buf)
            if element[0] == "{":
                key_sig, value_sig = split_signature(element[1:-1])
                for k, x in (v.items() if isinstance(v, dict) else v):
                    cls.pad(buf, 8)
                    cls.value(buf, key_sig, k)
                    cls.value(buf, value_sig, x)
            else:
                for x in v:
                    cls.value(buf, element, x)
            struct.pack_into("<I", buf, at, len(buf) - start)
        elif c == "(":
            cls.pad(buf, 8)
            fields = split_signature(sig[1:-1])
            if len(fields) != len(v):
                raise ValueError("a struct (%s) needs %d fields" % (sig, len(fields)))
            for t, x in zip(fields, v):
                cls.value(buf, t, x)
        else:
            raise ValueError("cannot marshal %r" % sig)

    @classmethod
    def body(cls, sig, args):
        types = split_signature(sig)
        if len(types) != len(args):
            raise ValueError("the signature %r takes %d values, not %d" % (sig, len(types), len(args)))
        buf = bytearray()
        for t, x in zip(types, args):
            cls.value(buf, t, x)
        return bytes(buf)


class Unmarshal:
    def __init__(self, data, order):
        self.data = data
        self.pos = 0
        self.order = order  # "<" or ">"

    def align(self, n):
        self.pos += (-self.pos) % n

    def take(self, fmt, n):
        self.align(n)
        (v,) = struct.unpack_from(self.order + fmt, self.data, self.pos)
        self.pos += n
        return v

    def string(self):
        n = self.take("I", 4)
        if self.pos + n + 1 > len(self.data):
            raise ValueError("a string runs past the message")
        s = self.data[self.pos:self.pos + n].decode("utf-8", "replace")
        self.pos += n + 1
        return s

    def signature(self):
        if self.pos >= len(self.data):
            raise ValueError("a signature runs past the message")
        n = self.data[self.pos]
        if self.pos + n + 2 > len(self.data):
            raise ValueError("a signature runs past the message")
        s = self.data[self.pos + 1:self.pos + 1 + n].decode()
        self.pos += n + 2
        return s

    def value(self, sig):
        c = sig[0]
        if c in BASIC:
            fmt, size = BASIC[c]
            v = self.take(fmt, size)
            return bool(v) if c == "b" else v
        if c in "so":
            return self.string()
        if c == "g":
            return self.signature()
        if c == "v":
            inner = self.signature()
            if len(split_signature(inner)) != 1:
                raise ValueError("a variant holds one complete type, not %r" % inner)
            return Variant(inner, self.value(inner))
        if c == "a":
            n = self.take("I", 4)
            element = sig[1:]
            self.align(ALIGN[element[0]])
            end = self.pos + n
            if end > len(self.data):
                raise ValueError("an array runs past the message")
            if element[0] == "{":
                key_sig, value_sig = split_signature(element[1:-1])
                out = {}
                while self.pos < end:
                    self.align(8)
                    k = self.value(key_sig)
                    out[k] = self.value(value_sig)
                return out
            items = []
            while self.pos < end:
                items.append(self.value(element))
            return items
        if c == "(":
            self.align(8)
            return tuple(self.value(t) for t in split_signature(sig[1:-1]))
        raise ValueError("cannot read %r" % sig)

    def body(self, sig):
        return [self.value(t) for t in split_signature(sig)]


METHOD_CALL, METHOD_RETURN, ERROR, SIGNAL = 1, 2, 3, 4
NO_REPLY_EXPECTED = 1
F_PATH, F_INTERFACE, F_MEMBER, F_ERROR_NAME, F_REPLY_SERIAL, F_DESTINATION, F_SENDER, F_SIGNATURE = 1, 2, 3, 4, 5, 6, 7, 8
FIELD_TYPES = {F_PATH: "o", F_INTERFACE: "s", F_MEMBER: "s", F_ERROR_NAME: "s", F_REPLY_SERIAL: "u",
               F_DESTINATION: "s", F_SENDER: "s", F_SIGNATURE: "g"}


class Message:
    def __init__(self, mtype, serial, fields, body_sig="", body=b"", flags=0):
        self.type = mtype
        self.serial = serial
        self.fields = fields
        self.body_sig = body_sig
        self.body = body
        self.flags = flags
        self.order = "<"

    def args(self):
        """The body's values."""
        return Unmarshal(self.body, self.order).body(self.body_sig) if self.body_sig else []

    def encode(self):
        f = bytearray()
        for code, value in self.fields.items():
            Marshal.pad(f, 8)
            f.append(code)
            sig = FIELD_TYPES[code]
            Marshal.signature(f, sig)
            Marshal.value(f, sig, value)
        head = bytearray(b"l")
        head += bytes([self.type, self.flags, 1])
        head += struct.pack("<II", len(self.body), self.serial)
        head += struct.pack("<I", len(f)) + f
        Marshal.pad(head, 8)
        return bytes(head) + self.body

    @staticmethod
    def decode(data):
        """(message, bytes used) from the start of `data`, or None while it is incomplete."""
        if len(data) < 16:
            return None
        order = "<" if data[0:1] == b"l" else ">"
        body_len, serial, fields_len = struct.unpack(order + "III", data[4:16])
        head_len = 16 + fields_len
        head_len += (-head_len) % 8
        total = head_len + body_len
        if len(data) < total:
            return None
        u = Unmarshal(data[:16 + fields_len], order)
        u.pos = 16
        fields = {}
        while u.pos < 16 + fields_len:
            u.align(8)
            code = u.take("B", 1)
            sig = u.signature()
            fields[code] = u.value(sig)
        m = Message(data[1], serial, fields, fields.get(F_SIGNATURE, ""), data[head_len:total], data[2])
        m.order = order
        return m, total


def parse_address(address):
    """The first usable unix address of a D-Bus address string, as a socket address."""
    for entry in address.split(";"):
        if not entry.startswith("unix:"):
            continue
        kv = {}
        for part in entry[5:].split(","):
            if "=" in part:
                k, v = part.split("=", 1)
                kv[k] = urllib.parse.unquote(v)
        if "path" in kv:
            return kv["path"]
        if "abstract" in kv:
            return "\0" + kv["abstract"]
        if kv.get("runtime") == "yes":
            return os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "bus")
    raise ValueError("no unix address in " + address)


class Bus:
    """A connection to a D-Bus daemon: authenticated and named (Hello), blocking until setup is done."""

    def __init__(self, address):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(5)
        self.serial = 0
        self.buf = b""
        try:
            self.sock.connect(parse_address(address))
            self.sock.sendall(b"\0AUTH EXTERNAL " + str(os.getuid()).encode().hex().encode() + b"\r\n")
            reply = self.read_auth_line()
            if not reply.startswith(b"OK"):
                raise OSError("D-Bus authentication refused: %r" % reply)
            self.sock.sendall(b"BEGIN\r\n")
            self.unique = self.call_wait(DBUS_NAME, DBUS_PATH, DBUS_IFACE, "Hello")
        except BaseException:
            self.close()
            raise

    def read_auth_line(self):
        while b"\r\n" not in self.buf:
            b = self.sock.recv(4096)
            if not b:
                raise OSError("the bus closed during authentication")
            self.buf += b
        line, self.buf = self.buf.split(b"\r\n", 1)
        return line

    def next_serial(self):
        self.serial += 1
        return self.serial

    def send(self, message):
        self.sock.sendall(message.encode())

    def call(self, destination, path, interface, member, sig="", args=(), flags=0):
        serial = self.next_serial()
        fields = {F_PATH: path, F_DESTINATION: destination, F_INTERFACE: interface, F_MEMBER: member}
        if sig:
            fields[F_SIGNATURE] = sig
        self.send(Message(METHOD_CALL, serial, fields, sig, Marshal.body(sig, args) if sig else b"", flags))
        return serial

    def read_message(self):
        """The next message, waiting for it (setup only: the socket has a timeout)."""
        while True:
            got = Message.decode(self.buf)
            if got:
                m, used = got
                self.buf = self.buf[used:]
                return m
            b = self.sock.recv(65536)
            if not b:
                raise OSError("the bus closed the connection")
            self.buf += b

    def call_wait(self, destination, path, interface, member, sig="", args=()):
        """The first value of the reply (or None), after a call during setup."""
        serial = self.call(destination, path, interface, member, sig, args)
        while True:
            m = self.read_message()
            if m.type in (METHOD_RETURN, ERROR) and m.fields.get(F_REPLY_SERIAL) == serial:
                values = m.args()
                if m.type == ERROR:
                    raise OSError("%s: %s" % (m.fields.get(F_ERROR_NAME), values[0] if values else ""))
                return values[0] if values else None

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass



