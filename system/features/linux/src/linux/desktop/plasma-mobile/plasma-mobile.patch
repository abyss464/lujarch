diff -ruN a/shell/contents/views/Panel.qml b/shell/contents/views/Panel.qml
--- a/shell/contents/views/Panel.qml
+++ b/shell/contents/views/Panel.qml
@@ -33,6 +33,78 @@
         }
     }
 
+    // Lujarch: in landscape the status bar stands on the screen's left end and the navigation panel on its
+    // right end (Constants.navigationPanelOnSide), as Android's bars stay on the phone's ends; in portrait
+    // the status bar is back on top. The task panel offsets itself by the top panel's height in landscape,
+    // which with the status bar on the side is a gap, so that offset is taken back. Applied after a delay,
+    // as the task panel does, since a location change right after a rotation can crash the shell
+    // (plasma-mobile issue 321).
+    readonly property bool lujarchStatusBar: containment?.plasmoid?.pluginName === "org.kde.plasma.mobile.panel"
+    readonly property bool lujarchTaskPanel: containment?.plasmoid?.pluginName === "org.kde.plasma.mobile.taskpanel"
+    readonly property bool lujarchLandscape: panel.screenGeometry.width > panel.screenGeometry.height
+    onLujarchLandscapeChanged: lujarchPlaceTimer.restart()
+    onLujarchStatusBarChanged: lujarchPlaceTimer.restart()
+    onLujarchTaskPanelChanged: lujarchPlaceTimer.restart()
+
+    Timer {
+        id: lujarchPlaceTimer
+        interval: 150
+        onTriggered: {
+            if (root.lujarchStatusBar) {
+                const edge = root.lujarchLandscape ? PlasmaCore.Types.LeftEdge : PlasmaCore.Types.TopEdge;
+                if (panel.location !== edge) {
+                    panel.location = edge;
+                }
+                // Plasma 6.8 fills the edge by itself; earlier ones are asked to.
+                if (typeof panel.maximize === "function") {
+                    panel.maximize();
+                }
+            } else if (root.lujarchTaskPanel && root.lujarchLandscape && panel.offset !== 0) {
+                panel.offset = 0;
+            }
+        }
+    }
+
+    // After the panel moves or changes size (a rotation), its touch area is the one set for its old
+    // place: touches on it fell through to the home screen until the containment set it again. The
+    // containment sets it once the panel has settled.
+    Timer {
+        id: lujarchTouchAreaTimer
+        interval: 300
+        onTriggered: {
+            if ((root.lujarchStatusBar || root.lujarchTaskPanel) && typeof containment.updateTouchArea === "function") {
+                containment.updateTouchArea();
+            }
+        }
+    }
+
+    Connections {
+        target: panel
+        function onWidthChanged() {
+            lujarchTouchAreaTimer.restart();
+        }
+        function onHeightChanged() {
+            lujarchTouchAreaTimer.restart();
+        }
+        function onXChanged() {
+            lujarchTouchAreaTimer.restart();
+        }
+        function onYChanged() {
+            lujarchTouchAreaTimer.restart();
+        }
+        function onOffsetChanged() {
+            if (root.lujarchTaskPanel && root.lujarchLandscape && panel.offset !== 0) {
+                lujarchPlaceTimer.restart();
+            }
+        }
+        function onLocationChanged() {
+            if (root.lujarchStatusBar) {
+                lujarchPlaceTimer.restart();
+            }
+            lujarchTouchAreaTimer.restart();
+        }
+    }
+
