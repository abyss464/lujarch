<!-- The Terminal app turns Bluetooth on and off and lists the connected devices for Linux's
     desktop while Android's quick settings are lent (LNX-7). Nearby devices in App info still
     takes it back. -->
<exceptions>
    <exception package="org.lujarch.linux.terminal">
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
    </exception>
</exceptions>
