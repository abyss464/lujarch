<!--
    The Terminal app: the service of the parts of the phone Linux is lent (LNX-7), bound by the
    home screen's Linux face (LNX-3) while it is on screen, and the Mode Linux. Platform-signed:
    it reaches lujarch_linux and owns the Mode Linux's rule.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lujarch.linux.terminal">

    <!-- The Mode Linux (an automatic Do Not Disturb rule of this app). -->
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATIONS" />
    <!-- Android's permission dialog for a lent part opens from the parts' service. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <!-- Linux's vibration, while it is lent. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The status line's network: the default network's interface. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Quick Settings tile Remote access switches When it runs. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- The names of the apps whose notifications Linux is lent. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Android's quick settings for Linux's desktop: its switches and readings, read and
         switched as Android's own tiles do (Switches.kt, AndroidWatch.kt). BLUETOOTH_CONNECT is
         granted by the image (default-permissions-org.lujarch.linux.terminal.xml). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED" />
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.CONTROL_DISPLAY_BRIGHTNESS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- The microphone, the cameras and the location for Linux: Android's own dialog asks the
         first time Linux reads one. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LujarchTerminal">

        <!-- The parts of the phone Linux is lent, served while the home screen shows Linux (its
             other face) and binds this; only the home screen holds the status bar permission. -->
        <service
            android:name=".LinuxPartsService"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR" />

        <!-- Android's permission dialog for a lent part, over the home screen. -->
        <activity
            android:name=".PermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The Mode Linux's page in Settings > Modes opens Linux's own page in Settings, the
             tile's long press the page of Remote access. -->
        <activity
            android:name=".ModesActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name=".RemoteAccessTile"
            android:exported="true"
            android:icon="@drawable/ic_remote"
            android:label="@string/remote_access"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Android's notifications for Linux, while they are lent (Lujarch Settings grants the
             access with the switch). -->
        <service
            android:name=".NotificationsListener"
            android:exported="true"
            android:label="@string/notifications_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
