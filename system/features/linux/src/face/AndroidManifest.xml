<?xml version="1.0" encoding="utf-8"?>
<!-- Linux mode as the home screen's other face (LNX-3), merged into the home screen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lujarch.linux.face">

    <!-- Confirming authorizations in Linux with the fingerprint or the screen lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- NFC card reading for Linux, while Linux is in front. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- The status line's network: the default network's interface. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- The Terminal app's service of the lent parts. -->
    <queries>
        <package android:name="org.lujarch.linux.terminal" />
    </queries>
</manifest>
