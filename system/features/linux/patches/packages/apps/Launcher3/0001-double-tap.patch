+
+package com.android.quickstep.util
+
+import android.animation.ValueAnimator
+import android.app.WindowConfiguration.ACTIVITY_TYPE_HOME
+import android.graphics.Rect
+import android.os.IBinder
+import android.os.RemoteException
+import android.util.Log
+import android.view.SurfaceControl
+import android.view.SurfaceControl.Transaction
+import android.view.animation.LinearInterpolator
+import android.view.animation.PathInterpolator
+import android.window.IRemoteTransitionFinishedCallback
+import android.window.RemoteTransitionStub
+import android.window.TransitionInfo
+import com.android.launcher3.anim.AnimatorListeners.forEndCallback
+import com.android.launcher3.util.Executors
+import com.android.wm.shell.shared.TransitionUtil
+
+/**
+ * Lujarch (Linux mode, docs/linux.md): the opening task grows out of the point ([x], [y]) on
+ * screen with the platform's clip reveal (TransitionAnimation#createClipRevealAnimationLocked):
+ * the visible rect widens quickly and grows tall over the whole motion while the window settles
+ * up from a little below, fading in from half opacity. Android 16 applies a launch's clip reveal
+ * option only inside a task, never to a task opening, so the launcher plays it itself.
+ */
+class ClipRevealRemoteTransition(
+    private val x: Int,
+    private val y: Int,
+    private val density: Float,
+) : RemoteTransitionStub() {
+
+    override fun startAnimation(
+        transition: IBinder,
+        info: TransitionInfo,
+        startT: Transaction,
+        finishCB: IRemoteTransitionFinishedCallback,
+    ) {
+        var leash: SurfaceControl? = null
+        val frame = Rect()
+        for (chg in info.changes) {
+            startT.show(chg.leash)
+            val taskInfo = chg.taskInfo ?: continue
+            if (
+                leash == null &&
+                    TransitionUtil.isOpeningMode(chg.mode) &&
+                    taskInfo.activityType != ACTIVITY_TYPE_HOME &&
+                    chg.parent == null
+            ) {
+                leash = chg.leash
+                frame.set(chg.endAbsBounds)
+            }
+        }
+        val target = leash
+        if (target == null || frame.isEmpty) {
+            Log.w(TAG, "Nothing opens in $info: no reveal")
+            startT.apply()
+            finish(finishCB)
+            return
+        }
+
+        // Where the reveal starts, as the platform's: at the point, the window 8 dp plus a
+        // seventh of the point's height lower, so it rises into place.
+        val startX = (x - frame.left).coerceIn(0, frame.width()).toFloat()
+        val startY = (y - frame.top).coerceIn(0, frame.height()).toFloat()
+        val translationY = 8f * density + frame.height() / 7f * (startY / frame.height())
+        apply(startT, target, frame, startX, startY, translationY, 0f)
+        startT.apply()
+
+        val anim = ValueAnimator.ofFloat(0f, 1f)
+        anim.duration = DURATION_MS
+        anim.interpolator = LinearInterpolator()
+        anim.addUpdateListener {
+            val t = Transaction()
+            apply(t, target, frame, startX, startY, translationY, it.animatedFraction)
+            t.apply()
+        }
+        anim.addListener(forEndCallback(Runnable { finish(finishCB) }))
+        Executors.MAIN_EXECUTOR.execute { anim.start() }
+    }
+
+    /** One frame [p] (0 to 1, linear time) of the reveal. */
+    private fun apply(
+        t: Transaction,
+        leash: SurfaceControl,
+        frame: Rect,
+        startX: Float,
+        startY: Float,
+        translationY: Float,
+        p: Float,
+    ) {
+        val w = frame.width().toFloat()
+        val h = frame.height().toFloat()
+        // Width first (in 40 % of the time), height over all of it.
+        val ph = CLIP_HORIZONTAL.getInterpolation((p * 2.5f).coerceAtMost(1f))
+        val pv = TOUCH_RESPONSE.getInterpolation(p)
+        val dy = translationY * (1f - LINEAR_OUT_SLOW_IN.getInterpolation(p))
+        // The visible rect is anchored to the screen; the content moves under it.
+        val left = startX * (1f - ph)
+        val right = startX + (w - startX) * ph
+        val top = startY * (1f - pv)
+        val bottom = startY + (h - startY) * pv
+        t.setPosition(leash, frame.left.toFloat(), frame.top + dy)
+        t.setWindowCrop(
+            leash,
+            Rect(
+                left.toInt(),
+                (top - dy).toInt(),
+                kotlin.math.ceil(right).toInt(),
+                kotlin.math.ceil(bottom - dy).toInt(),
+            ),
+        )
+        val pa = (p * 4f).coerceAtMost(1f)
+        t.setAlpha(leash, 0.5f + 0.5f * LINEAR_OUT_SLOW_IN.getInterpolation(pa))
+    }
+
+    private fun finish(finishCB: IRemoteTransitionFinishedCallback) {
+        try {
+            finishCB.onTransitionFinished(null, Transaction())
+        } catch (e: RemoteException) {
+            Log.w(TAG, "Could not finish the reveal", e)
+        }
+    }
+
+    companion object {
+        private const val TAG = "ClipRevealRemote"
+
+        /** The platform's clip reveal duration (DEFAULT_APP_TRANSITION_DURATION). */
+        private const val DURATION_MS = 336L
+        private val CLIP_HORIZONTAL = PathInterpolator(0f, 0f, 0.4f, 1f)
+        private val TOUCH_RESPONSE = PathInterpolator(0.3f, 0f, 0.1f, 1f)
+        private val LINEAR_OUT_SLOW_IN = PathInterpolator(0f, 0f, 0.2f, 1f)
+    }
+}
