diff --git a/quickstep/src/com/android/quickstep/inputconsumers/LinuxModeInputConsumer.kt b/quickstep/src/com/android/quickstep/inputconsumers/LinuxModeInputConsumer.kt
new file mode 100644
index 0000000000000000000000000000000000000000..3645131ffd55a002db0861f9b5cd72d2007fd5f5
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/inputconsumers/LinuxModeInputConsumer.kt
@@ -0,0 +1,137 @@
+/*
+ * Lujarch (LNX-3): the bottom swipe while Linux mode (the terminal and the desktop of
+ * org.lujarch.linux.terminal, one task) is the running task.
+ *
+ * One swipe goes to the home screen. Overview is never entered from Linux mode: a swipe that ended
+ * in overview would show the Linux task as a card in recents. The terminal almost always has the
+ * keyboard up, whose window lies under the swipe-up region, so the swipe is taken from it once it
+ * is past the slop.
+ */
+package com.android.quickstep.inputconsumers
+
+import android.content.ComponentName
+import android.content.Context
+import android.graphics.PointF
+import android.util.Log
+import android.view.MotionEvent
+import android.view.VelocityTracker
+import android.view.ViewConfiguration
+import com.android.launcher3.R
+import com.android.launcher3.util.VelocityUtils.PX_PER_MS
+import com.android.quickstep.GestureState
+import com.android.quickstep.InputConsumer
+import com.android.quickstep.OverviewComponentObserver.startHomeIntentSafely
+import com.android.quickstep.RotationTouchHelper
+import com.android.quickstep.TopTaskTracker.CachedTaskInfo
+import com.android.systemui.shared.system.InputMonitorCompat
+import kotlin.math.abs
+
+class LinuxModeInputConsumer(
+    private val context: Context,
+    private val gestureState: GestureState,
+    private val inputMonitor: InputMonitorCompat,
+    private val rotationTouchHelper: RotationTouchHelper,
+) : InputConsumer {
+    private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop.toFloat()
+    // The speed Quickstep's own swipe tracker calls a fling, in px/ms.
+    private val flingSpeed = context.resources.getDimension(R.dimen.quickstep_fling_threshold_speed)
+    private val touchDown = PointF()
+    private var velocityTracker: VelocityTracker? = VelocityTracker.obtain()
+    private var tracking = false
+    private var pilfered = false
+
+    override fun getType() = InputConsumer.TYPE_LINUX_MODE
+
+    override fun getDisplayId() = gestureState.displayId
+
+    // Once the motion passed the slop it is this consumer's swipe: parents (one-handed mode, the
+    // accessibility menu, the assistant) must not take it over.
+    override fun allowInterceptByParent() = !pilfered
+
+    override fun onMotionEvent(ev: MotionEvent) {
+        val tracker = velocityTracker ?: return
+        tracker.addMovement(ev)
+        when (ev.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                touchDown.set(ev.x, ev.y)
+                tracking = rotationTouchHelper.isInSwipeUpTouchRegion(ev)
+            }
+            MotionEvent.ACTION_POINTER_DOWN -> {
+                // A second finger outside the swipe-up region before the swipe is decided cancels it.
+                if (
+                    tracking &&
+                        !pilfered &&
+                        !rotationTouchHelper.isInSwipeUpTouchRegion(ev, ev.actionIndex)
+                ) {
+                    tracking = false
+                }
+            }
+            MotionEvent.ACTION_MOVE -> {
+                if (tracking && !pilfered && isUpward(ev.x, ev.y)) {
+                    pilfered = true
+                    // The keyboard (its window is under the swipe-up region) or the app gets a
+                    // cancel; without this the swipe would end on the keyboard.
+                    inputMonitor.pilferPointers()
+                }
+            }
+            MotionEvent.ACTION_UP -> {
+                val counted = tracking && pilfered && swipeCounts(tracker, ev)
+                release()
+                if (counted) onSwipeUp()
+            }
+            MotionEvent.ACTION_CANCEL -> release()
+        }
+    }
+
+    // Past the touch slop, up more than sideways.
+    private fun isUpward(x: Float, y: Float): Boolean {
+        val up = touchDown.y - y
+        return up >= touchSlop && up > abs(x - touchDown.x)
+    }
+
+    // A swipe counts when it flung upward, or, below fling speed, when it ended far enough up
+    // (Quickstep's TriggerSwipeUpTouchTracker takes the touch slop as "far enough").
+    private fun swipeCounts(tracker: VelocityTracker, ev: MotionEvent): Boolean {
+        tracker.computeCurrentVelocity(PX_PER_MS)
+        val vx = tracker.xVelocity
+        val vy = tracker.yVelocity
+        return if (abs(vy) >= flingSpeed && abs(vy) >= abs(vx)) vy < 0 else isUpward(ev.x, ev.y)
+    }
+
+    private fun onSwipeUp() {
+        Log.d(TAG, "swipe up: home")
+        startHomeIntentSafely(context, gestureState.homeIntent, null, TAG)
+    }
+
+    private fun release() {
+        velocityTracker?.recycle()
+        velocityTracker = null
+    }
+
+    override fun onConsumerAboutToBeSwitched() = release()
+
+    companion object {
+        private const val TAG = "LujarchLinuxMode"
+
+        @Volatile private var linuxMode: Set<ComponentName>? = null
+
+        /** Whether the running task's top or base activity is Linux mode. */
+        @JvmStatic
+        fun isLinuxModeTask(context: Context, task: CachedTaskInfo?): Boolean {
+            val set = linuxMode
+                ?: load(context, R.array.lujarch_linux_mode_activities).also { linuxMode = it }
+            return runs(task, set)
+        }
+
+        private fun runs(task: CachedTaskInfo?, set: Set<ComponentName>): Boolean {
+            val info = task?.legacyBaseTask ?: return false
+            return set.contains(info.topActivity) || set.contains(info.baseActivity)
+        }
+
+        private fun load(context: Context, array: Int): Set<ComponentName> =
+            context.resources
+                .getStringArray(array)
+                .mapNotNull { ComponentName.unflattenFromString(it) }
+                .toSet()
+    }
+}
