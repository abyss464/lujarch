+package com.android.launcher3.uioverrides.touchcontrollers;
+
+import android.view.MotionEvent;
+
+import com.android.launcher3.Launcher;
+import com.android.launcher3.util.TouchController;
+
+import org.lujarch.linux.face.LinuxFace;
+
+/**
+ * Lujarch (LNX-3): while the home screen shows Linux, its bottom gesture is Linux's. Put before
+ * every other controller, it takes the whole gesture so none of Android's (all apps, overview,
+ * quick switch, home) starts, and hands it to the face, whose own swipe goes from the desktop to
+ * the terminal and from the terminal to Android's home.
+ */
+public class LinuxFaceTouchController implements TouchController {
+    private final Launcher mLauncher;
+    private boolean mTaking;
+
+    public LinuxFaceTouchController(Launcher launcher) {
+        mLauncher = launcher;
+    }
+
+    @Override
+    public boolean onControllerInterceptTouchEvent(MotionEvent ev) {
+        LinuxFace face = mLauncher.getLinuxFace();
+        if (ev.getActionMasked() == MotionEvent.ACTION_DOWN) {
+            mTaking = face != null && face.getShown();
+        }
+        if (mTaking) face.onGestureMotion(ev);
+        return mTaking;
+    }
+
+    @Override
+    public boolean onControllerTouchEvent(MotionEvent ev) {
+        if (!mTaking) return false;
+        LinuxFace face = mLauncher.getLinuxFace();
+        if (face != null) face.onGestureMotion(ev);
+        int action = ev.getActionMasked();
+        if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) mTaking = false;
+        return true;
+    }
+}
