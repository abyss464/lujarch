    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["src/frp/NOTICE"],
}

// frp's client, built outside the tree (feature.toml, components).
cc_prebuilt_binary {
    name: "lujarch_linux_frpc",
    licenses: ["lujarch_linux_frp_license"],
    compile_multilib: "64",
    arch: {
        arm64: {
            srcs: ["prebuilt/arm64/lujarch_linux_frpc"],
        },
        x86_64: {
            srcs: ["prebuilt/x86_64/lujarch_linux_frpc"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
    system_ext_specific: true,
}

// The Linux development environment's pages in Lujarch Settings: System > Linux development
// environment and its search entries, the Quick Settings tile Remote access.
android_library {
    name: "LujarchLinuxSettings",
    srcs: ["src/settings/**/*.kt"],
    manifest: "src/settings/AndroidManifest.xml",
    resource_dirs: ["src/settings/res"],
    platform_apis: true,
    static_libs: [
        "LujarchSettingsPages",
        "lujarch_linux_aidl-java",
    ],
    libs: ["LujarchSettingsContribution"],
}

license {
    name: "lujarch_linux_termux_license",
    license_kinds: ["SPDX-license-identifier-GPL-3.0"],
    license_text: [
        "src/termux/NOTICE",
        "src/termux/LICENSE.md",
    ],
}

// Termux's terminal emulator and terminal view, the Terminal app's terminal (src/termux/NOTICE).
android_library {
    name: "LujarchLinuxTermuxEmulator",
    licenses: ["lujarch_linux_termux_license"],
    srcs: ["src/termux/emulator/java/**/*.java"],
    manifest: "src/termux/emulator/AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "36",
    errorprone: {
        enabled: false,
    },
}

android_library {
    name: "LujarchLinuxTermuxView",
    licenses: ["lujarch_linux_termux_license"],
    srcs: ["src/termux/view/java/**/*.java"],
    manifest: "src/termux/view/AndroidManifest.xml",
    resource_dirs: ["src/termux/view/res"],
    sdk_version: "current",
    min_sdk_version: "36",
    static_libs: [
        "androidx.annotation_annotation",
        "LujarchLinuxTermuxEmulator",
    ],
    errorprone: {
        enabled: false,
    },
}

// The desktop's presenter in the home screen's Linux face (src/face/jni): the display protocol's
// app side, the AHardwareBuffer pool, SurfaceControl transactions paced by Choreographer. NDK only,
// so the APK's copy loads in the app's own linker namespace; AHardwareBuffer_getNativeHandle is
// looked up at run time.
cc_library_shared {
    name: "liblujarch_linux_display_jni",
    srcs: ["src/face/jni/display_jni.cpp"],
    local_include_dirs: ["src/linux/desktop/protocol"],
    header_libs: ["jni_headers"],
    sdk_version: "current",
    stl: "c++_static",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-zero-length-array",
    ],
    shared_libs: [
        "libandroid",
        "libdl",
        "liblog",
        "libnativewindow",
    ],
    system_ext_specific: true,
}

// The cameras' frames for Linux in the Terminal app (src/terminal/jni), YUV to NV12; NDK only.
cc_library_shared {
    name: "liblujarch_linux_camera_jni",
    srcs: ["src/terminal/jni/camera_jni.cpp"],
    header_libs: ["jni_headers"],
    sdk_version: "current",
    stl: "c++_static",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-zero-length-array",
    ],
    shared_libs: [
        "libandroid",
        "libdl",
        "liblog",
        "libnativewindow",
    ],
    system_ext_specific: true,
}

// The Terminal app: the parts of the phone Linux is lent that need an app, and the Mode Linux;
// Linux's screens are the home screen's (LujarchLinuxFace).
// lujarch_linux's client, shared by the home screen's Linux face and the Terminal app.
android_library {
    name: "LujarchLinuxClient",
    srcs: ["src/client/org/**/*.kt"],
    manifest: "src/client/AndroidManifest.xml",
    platform_apis: true,
    static_libs: [
        "kotlinx_coroutines_android",
        "lujarch_linux_aidl-java",
    ],
}

// Linux mode as the home screen's other face (LNX-3): the terminal and the desktop, linked into
// the home screen (Launcher3QuickStep) with the display's JNI.
android_library {
    name: "LujarchLinuxFace",
    srcs: ["src/face/org/**/*.kt"],
    resource_dirs: ["src/face/res"],
    manifest: "src/face/AndroidManifest.xml",
    platform_apis: true,
    static_libs: [
        "LujarchLinuxClient",
        "LujarchLinuxTermuxView",
        "androidx.core_core",
        "kotlinx_coroutines_android",
    ],
}

filegroup {
    name: "lujarch_linux_face_proguard",
    srcs: ["src/face/proguard.flags"],
}

android_app {
    name: "LujarchLinuxTerminal",
    srcs: ["src/terminal/org/**/*.kt"],
    resource_dirs: ["src/terminal/res"],
    manifest: "src/terminal/AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    jni_libs: ["liblujarch_linux_camera_jni"],
    use_embedded_native_libs: true,
    static_libs: [
        "LujarchLinuxClient",
        "androidx.core_core",
        "kotlinx_coroutines_android",
        "lujarch_linux_aidl-java",
    ],
    optimize: {
        proguard_flags_files: ["src/terminal/proguard.flags"],
    },
    required: ["default-permissions-org.lujarch.linux.terminal.xml"],
}

// The runtime permission the Terminal app starts with.
prebuilt_etc {
    name: "default-permissions-org.lujarch.linux.terminal.xml",
    src: "src/terminal/etc/default-permissions-org.lujarch.linux.terminal.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}
