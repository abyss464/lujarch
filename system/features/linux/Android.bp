// The interface of lujarch_linux, for Lujarch Settings and the Terminal app.
aidl_interface {
    name: "lujarch_linux_aidl",
    srcs: ["src/daemon/aidl/org/lujarch/linux/*.aidl"],
    local_include_dir: "src/daemon/aidl",
    unstable: true,
    system_ext_specific: true,
    backend: {
        java: {
            platform_apis: true,
        },
        ndk: {
            enabled: true,
            // The package's last part is GNU C++'s predefined macro linux.
            cflags: ["-Ulinux"],
        },
        cpp: {
            enabled: false,
        },
    },
}

// The Linux development environment's daemon.
cc_binary {
    name: "lujarch_linux",
    srcs: ["src/daemon/*.cpp"],
    static_libs: [
        "android.hardware.health-V4-ndk",
        "android.hardware.ir-V1-ndk",
        "liblujarch_daemon",
        "lujarch_linux_aidl-ndk",
        "lujarch_root_aidl-ndk",
    ],
    shared_libs: [
        "libandroid",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libjsoncpp",
        "liblog",
        "libpower",
        "libz",
    ],
    required: [
        "lujarch_linux_desktop",
        "lujarch_linux_enter",
        "lujarch_linux_fingerprint",
        "lujarch_linux_frpc",
        "lujarch_linux_setup",
    ],
    init_rc: ["src/daemon/lujarch_linux.rc"],
    local_include_dirs: ["src/linux/desktop/protocol"],
    cflags: ["-Wall", "-Werror"],
    cpp_std: "c++20",
    system_ext_specific: true,
}

// The way into the installed system: its execution enters the system's domain.
cc_binary {
    name: "lujarch_linux_enter",
    srcs: ["src/enter/enter.cpp"],
    cflags: ["-Wall", "-Werror"],
    cpp_std: "c++20",
    system_ext_specific: true,
}

// Lujarch's files for Linux, at /usr/lib/lujarch in the system: the initial setup, the
// fingerprint helper of PAM, and the desktop's recipe.
prebuilt_etc {
    name: "lujarch_linux_setup",
    src: "src/linux/setup",
    filename: "setup",
    sub_dir: "lujarch/linux",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "lujarch_linux_fingerprint",
    src: "src/linux/fingerprint",
    filename: "fingerprint",
    sub_dir: "lujarch/linux",
    system_ext_specific: true,
}

license {
    name: "lujarch_linux_desktop_license",
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD-3-Clause",
        "SPDX-license-identifier-GPL-2.0-or-later",
        "SPDX-license-identifier-GPL-3.0",
        "SPDX-license-identifier-MIT",
    ],
    license_text: ["src/linux/desktop/NOTICE"],
}

// The desktop's recipe (LNX-6, LNX-7), which Linux builds and installs, at /usr/lib/lujarch/desktop
// in Linux: its install script, the display protocol, KWin's Lujarch backend, Mesa's patches, Plasma
// Mobile's landscape layout, the desktop's session, the shell's quick settings and keyboard, the
// daemons of the parts of the phone Linux is lent, Lujarch's strings for Linux, and the glue of
// Proton's Wine; downloads holds the pins of lock.toml it builds from, staged by the tools. One
// module for each directory of src/linux/desktop.
phony {
    name: "lujarch_linux_desktop",
    required: [
        "lujarch_linux_desktop_recipe",
        "lujarch_linux_desktop_android",
        "lujarch_linux_desktop_kwin",
        "lujarch_linux_desktop_kwin_lujarch",
        "lujarch_linux_desktop_mesa",
        "lujarch_linux_desktop_mesa_patches",
        "lujarch_linux_desktop_plasma_mobile",
        "lujarch_linux_desktop_protocol",
        "lujarch_linux_desktop_res",
        "lujarch_linux_desktop_res_values",
        "lujarch_linux_desktop_res_values_ja",
        "lujarch_linux_desktop_res_values_zh_rcn",
        "lujarch_linux_desktop_session",
        "lujarch_linux_desktop_shell_qml_qtquick_virtualkeyboard_styles_lujarch",
        "lujarch_linux_desktop_shell_qml_qtquick_virtualkeyboard_styles_lujarch_images",
        "lujarch_linux_desktop_shell_qml_org_kde_bluezqt",
        "lujarch_linux_desktop_shell_qml_org_kde_plasma_networkmanagement",
        "lujarch_linux_desktop_shell_qml_org_kde_plasma_networkmanagement_cellular",
        "lujarch_linux_desktop_shell_qml_org_lujarch_android",
        "lujarch_linux_desktop_shell_qml_org_lujarch_keyboard",
        "lujarch_linux_desktop_shell_quicksettings",
        "lujarch_linux_desktop_shell_share_plasma_mobile_device_presets",
        "lujarch_linux_desktop_shell_share_plasma_keyboard_layouts_en_us",
        "lujarch_linux_desktop_shell_share_plasma_keyboard_layouts_fallback",
        "lujarch_linux_desktop_shell_share_plasma_keyboard_layouts_zh_cn",
        "lujarch_linux_desktop_wine",
        "lujarch_linux_desktop_wine_media",
        "lujarch_linux_desktop_wine_share_applications",
        "lujarch_linux_desktop_wine_share_kio_servicemenus",
    ],
}

