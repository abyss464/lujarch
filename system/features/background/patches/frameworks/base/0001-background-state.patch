+        /** One line of the record. */
+        String event(Event e, int userId) {
+            final String text;
+            switch (e.kind) {
+                case LujarchBackground.EVENT_LEFT:
+                    text = c.getString(R.string.lujarch_background_ev_left);
+                    break;
+                case LujarchBackground.EVENT_OPENED:
+                    text = c.getString(e.cause == C_OPENED_AS_WAS
+                            ? R.string.lujarch_background_ev_opened_as_was
+                            : e.cause == C_OPENED_AGAIN ? R.string.lujarch_background_ev_opened_again
+                            : R.string.lujarch_background_ev_opened);
+                    break;
+                case LujarchBackground.EVENT_PAUSED:
+                    text = e.cause == C_PAUSED_CHOSEN && e.detail != null
+                            ? c.getString(R.string.lujarch_background_ev_paused_chosen, e.detail)
+                            : c.getString(R.string.lujarch_background_ev_paused);
+                    break;
+                case LujarchBackground.EVENT_WOKEN: {
+                    final String how = wake(e.cause, e.detail, e.whoPackage, userId);
+                    text = e.durationMs > 0 && e.count == 1
+                            ? c.getString(R.string.lujarch_background_ev_woken_for, how,
+                                    duration(e.durationMs))
+                            : c.getString(R.string.lujarch_background_ev_woken, how);
+                    break;
+                }
+                case LujarchBackground.EVENT_ENDED: {
+                    // The main process speaks for the app; another process is named.
+                    final String why = endReason(e.cause, e.whoPackage, userId);
+                    text = e.detail != null && e.detail.startsWith(":")
+                            ? c.getString(R.string.lujarch_background_ev_ended_process, e.detail,
+                                    why)
+                            : c.getString(R.string.lujarch_background_ev_ended, why);
+                    break;
+                }
+                case LujarchBackground.EVENT_STOPPED:
+                    text = c.getString(R.string.lujarch_background_ev_stopped);
+                    break;
+                case LujarchBackground.EVENT_STARTED:
+                    text = c.getString(R.string.lujarch_background_ev_started,
+                            start(e.cause, e.detail, e.whoPackage, userId));
+                    break;
+                default:
+                    text = "";
+                    break;
+            }
+            return e.count > 1 ? c.getResources().getQuantityString(
+                    R.plurals.lujarch_background_ev_times, e.count, text, e.count) : text;
+        }
+
+        /** Why it ended or was woken, in a few words, to group the lines by. */
+        @Nullable
+        String reason(Event e, int userId) {
+            switch (e.kind) {
+                case LujarchBackground.EVENT_ENDED:
+                    return endReason(e.cause, e.whoPackage, userId);
+                case LujarchBackground.EVENT_WOKEN:
+                    return wake(e.cause, e.detail, e.whoPackage, userId);
