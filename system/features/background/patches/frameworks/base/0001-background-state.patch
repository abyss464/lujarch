+    // ---------------------------------------------------------------------------------------
+    // Holds: what keeps a process running (Unrestricted, Messages only, a small window) and in
+    // memory (Keep); read by OomAdjuster, ProcessList and the freezer.
+
+    /** The hold of a process as it starts; called with ActivityManager's lock held. */
+    int holdFor(ProcessRecord app) {
+        if (!mReady || app.info == null) {
+            return 0;
+        }
+        return holdOf(app.uid, app.info.packageName, app.getPid(), app.userId);
+    }
+
+    private int holdOf(int uid, String packageName, int pid, int userId) {
+        int hold = 0;
+        final String key = uid + ":" + packageName;
+        final String app = LujarchBackgroundRecord.key(userId, packageName);
+        synchronized (mLock) {
+            if (mKept.contains(key)) {
+                hold |= LUJARCH_HOLD_KEPT;
+            }
+            if (mMessagesPids.contains(pid)) {
+                hold |= LUJARCH_HOLD_MESSAGES;
+            }
+            if (mSmallWindows.containsKey(app)) {
+                hold |= LUJARCH_HOLD_SMALL_WINDOW;
+            }
+        }
+        if (UserHandle.getAppId(uid) >= Process.FIRST_APPLICATION_UID
+                && Arrays.binarySearch(mAm.mDeviceIdleAllowlist, UserHandle.getAppId(uid)) >= 0) {
+            hold |= LUJARCH_HOLD_UNRESTRICTED;
+        }
+        return hold;
+    }
+
+    /**
+     * Sets the hold of every process (of one package, or all), and has ActivityManager apply the
+     * processes whose hold changed. Called on this thread.
+     */
+    private void updateHolds(@Nullable String packageName) {
+        if (!mReady) {
+            return;
+        }
+        synchronized (mAm) {
+            synchronized (mAm.mProcLock) {
+                boolean changed = false;
+                for (ProcessRecord app : mAm.mProcessList.getLruProcessesLOSP()) {
+                    if (app.info == null || app.getPid() <= 0
+                            || packageName != null && !packageName.equals(app.info.packageName)) {
+                        continue;
+                    }
+                    final int hold = holdOf(app.uid, app.info.packageName, app.getPid(),
+                            app.userId);
+                    if (hold != app.getLujarchHold()) {
+                        final boolean keptChanged =
+                                ((hold ^ app.getLujarchHold()) & LUJARCH_HOLD_KEPT) != 0;
+                        app.setLujarchHold(hold);
+                        if (keptChanged) {
+                            // lmkd learns the kept state now, not with the next change of adj.
+                            ProcessList.setOomAdj(app.getPid(), app.uid, app.getLmkdAdj());
+                        }
+                        mAm.mProcessStateController.enqueueUpdateTarget(app);
+                        changed = true;
+                    }
+                }
+                if (changed) {
+                    mAm.mProcessStateController.runPendingUpdate(
+                            ActivityManagerInternal.OOM_ADJ_REASON_ALLOWLIST);
+                }
+            }
+        }
+    }
+
+    /** The allowlist of Unrestricted changed; called with ActivityManager's lock held. */
+    void onAllowlistChanged() {
+        if (mReady) {
+            mHandler.post(() -> {
+                readSystemAllowlist();
+                updateHolds(null);
+                changed();
+            });
+        }
+    }
+
+    /**
+     * Finds the process of each Messages only app off screen that holds an established
+     * connection, and holds it running; the app's other processes pause as usual.
+     */
+    private void scanMessages() {
+        final ArrayList<Proc> candidates = new ArrayList<>();
+        final ArraySet<Integer> uids = new ArraySet<>();
+        for (Proc p : snapshot(UserHandle.USER_ALL, null)) {
+            if (p.system || p.top || p.visible) {
+                continue;
+            }
+            synchronized (mLock) {
+                if (!mMessages.contains(p.uid + ":" + p.packageName)) {
+                    continue;
+                }
+            }
+            candidates.add(p);
+            uids.add(p.uid);
+        }
+        final ArraySet<Integer> holders = new ArraySet<>();
+        if (!candidates.isEmpty()) {
+            final SparseArray<ArraySet<String>> sockets = mProc.connections(uids);
+            for (Proc p : candidates) {
+                final ArraySet<String> s = sockets.get(p.uid);
+                synchronized (mLock) {
+                    // A process held already keeps its hold while it is paused by nothing.
+                    if (s != null && mProc.holds(p.pid, s)) {
+                        holders.add(p.pid);
+                    }
+                }
+            }
+        }
+        final boolean changed;
+        synchronized (mLock) {
+            changed = !holders.equals(mMessagesPids);
+            mMessagesPids.clear();
+            mMessagesPids.addAll(holders);
+        }
+        if (changed) {
+            Slog.i(TAG, "processes kept for messages: " + holders);
+            updateHolds(null);
+        }
+    }
+
+    private void periodic() {
+        try {
+            scanMessages();
+            markCpu();
+            changed();
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "the periodic update failed", e);
+        }
+        mHandler.postDelayed(this::periodic, MESSAGES_SCAN_MS);
+    }
+
+    /** Notes each process's CPU time once an hour, for its CPU time of the last 24 hours. */
+    private void markCpu() {
+        final long hour = System.currentTimeMillis() / 3_600_000L;
+        for (Proc p : snapshot(UserHandle.USER_ALL, null)) {
+            synchronized (mLock) {
+                long[] marks = mCpuMarks.get(p.pid);
+                if (marks == null) {
+                    marks = new long[25 * 2];
+                    Arrays.fill(marks, -1);
+                    mCpuMarks.put(p.pid, marks);
+                }
+                final int slot = (int) (hour % 25) * 2;
+                if (marks[slot] != hour) {
+                    marks[slot] = hour;
+                    marks[slot + 1] = LujarchBackgroundProc.cpuMs(p.pid);
+                }
+            }
+        }
+    }
+
+    /** CPU time in the last 24 hours: since the oldest hourly mark, or since the process started. */
+    private long cpu24h(int pid, long total, long startedMillis) {
+        if (total < 0) {
+            return 0;
+        }
+        if (System.currentTimeMillis() - startedMillis < DAY_MS) {
+            return total;
+        }
+        final long dayAgo = System.currentTimeMillis() / 3_600_000L - 24;
+        synchronized (mLock) {
+            final long[] marks = mCpuMarks.get(pid);
+            long best = -1;
+            long bestHour = Long.MAX_VALUE;
+            if (marks != null) {
+                for (int i = 0; i < marks.length; i += 2) {
+                    if (marks[i] >= dayAgo && marks[i] < bestHour && marks[i + 1] >= 0) {
+                        bestHour = marks[i];
+                        best = marks[i + 1];
+                    }
+                }
+            }
+            return best >= 0 ? Math.max(0, total - best) : total;
+        }
+    }
