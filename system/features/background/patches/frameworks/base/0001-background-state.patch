+import com.android.internal.app.LujarchBackgroundReason;
+import com.android.internal.app.LujarchBackgroundThread;
+
+/**
+ * One process of an app: its depth, why it is there, what it uses.
+ * @hide
+ */
+parcelable LujarchBackgroundProcess {
+    int pid;
+    int uid;
+    @nullable String name;
+    @nullable String packageName;
+    /** LujarchBackground.DEPTH_*. */
+    int depth;
+    /** The depth's reason in words, with who caused it. */
+    int who;
+    @nullable String whoName;
+    @nullable String reason;
+    boolean frozen;
+    /** Kept running as the app's connection for messages (Messages only). */
+    boolean messages;
+    long memoryBytes;
+    long swapBytes;
+    /** CPU time in the last 24 hours. */
+    long cpuMs;
+    /** Times woken in the last 24 hours. */
+    int wakeups;
+    /** When the process started, as System.currentTimeMillis(). */
+    long startedMillis;
+    /** The system's priority in words, with its own names in brackets. */
+    @nullable String priority;
+    /** Filled for one process only (getProcess). */
+    @nullable LujarchBackgroundReason[] reasons;
+    @nullable LujarchBackgroundThread[] threads;
+}
