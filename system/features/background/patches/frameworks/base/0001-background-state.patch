+    /** The words of a suggestion. */
+    LujarchBackgroundSuggestion suggestion(Suggestion s, String pkg, int userId) {
+        final Words w = new Words();
+        final LujarchBackgroundSuggestion out = new LujarchBackgroundSuggestion();
+        out.kind = s.kind;
+        out.count = s.count;
+        out.fromMillis = s.from;
+        out.toMillis = s.to;
+        final String label = label(pkg, userId);
+        if (s.kind == LujarchBackground.SUGGEST_LOOP) {
+            out.title = mContext.getString(R.string.lujarch_background_s_loop_title, label);
+            out.text = mContext.getResources().getQuantityString(
+                    R.plurals.lujarch_background_s_loop_text, s.count, w.when(s.from),
+                    w.when(s.to), s.count);
+        } else {
+            out.title = mContext.getString(R.string.lujarch_background_s_left_title, label);
+            out.text = mContext.getString(R.string.lujarch_background_s_left_text,
+                    w.when(s.from), s.chosenName, w.duration(Math.max(1, s.gapMs)), label);
+        }
+        return out;
+    }
