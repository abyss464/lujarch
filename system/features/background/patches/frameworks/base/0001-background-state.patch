+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.am;
+
+import android.annotation.Nullable;
+import android.util.ArrayMap;
+import android.util.AtomicFile;
+import android.util.Slog;
+
+import com.android.internal.app.LujarchBackground;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * What happened to each app in the last 7 days (BG-6): every pause, wake, end, stop and start in
+ * the background, with who did it and why. Kept in memory and written to
+ * /data/lujarch/background/events, one tab-separated line per event.
+ */
+final class LujarchBackgroundRecord {
+    private static final String TAG = LujarchBackgroundService.TAG;
+    static final long KEEP_MS = 7L * 24 * 60 * 60 * 1000;
+    private static final int MAX_PER_APP = 2000;
+    /** Repeats of one event within this long count on its line instead of adding one. */
+    private static final long MERGE_MS = 10 * 60 * 1000;
+
+    /** One event; its texts are made when it is read, in the language of that moment. */
+    static final class Event {
+        long time;
+        int kind;
+        int who;
+        /** The other app, for WHO_OTHER. */
+        @Nullable String whoPackage;
+        /** LujarchBackgroundService.C_*. */
+        int cause;
+        /** A process name, an action: words the cause's text names. */
+        @Nullable String detail;
+        int count = 1;
+        /** For a wake: how long it ran before it was paused again; 0 while unknown. */
+        long durationMs;
+
+        Event(long time, int kind, int who, @Nullable String whoPackage, int cause,
+                @Nullable String detail) {
+            this.time = time;
+            this.kind = kind;
+            this.who = who;
+            this.whoPackage = whoPackage;
+            this.cause = cause;
+            this.detail = detail;
+        }
+
+        boolean sameAs(Event o) {
+            return kind == o.kind && who == o.who && cause == o.cause
+                    && eq(whoPackage, o.whoPackage) && eq(detail, o.detail);
+        }
+    }
+
+    private final AtomicFile mFile;
+    /** "userId:package" to its events, oldest first. */
+    private final ArrayMap<String, ArrayList<Event>> mByApp = new ArrayMap<>();
+    private boolean mDirty;
+
+    LujarchBackgroundRecord(File dir) {
+        mFile = new AtomicFile(new File(dir, "events"));
+    }
+
+    static String key(int userId, String packageName) {
+        return userId + ":" + packageName;
+    }
+
+    /** Adds an event; a repeat of the app's last event within a short time counts on it. */
+    synchronized Event add(int userId, String packageName, Event e) {
+        final String key = key(userId, packageName);
+        ArrayList<Event> list = mByApp.get(key);
+        if (list == null) {
+            list = new ArrayList<>();
+            mByApp.put(key, list);
+        }
+        final Event last = list.isEmpty() ? null : list.get(list.size() - 1);
+        mDirty = true;
+        if (last != null && last.sameAs(e) && e.time - last.time < MERGE_MS
+                && e.kind != LujarchBackground.EVENT_OPENED
+                && e.kind != LujarchBackground.EVENT_LEFT) {
+            last.count++;
+            last.time = e.time;
+            last.durationMs += e.durationMs;
+            return last;
+        }
+        list.add(e);
+        if (list.size() > MAX_PER_APP) {
+            list.subList(0, list.size() - MAX_PER_APP).clear();
+        }
+        return e;
+    }
+
+    /** The app's events since a time, newest first. */
+    synchronized List<Event> since(int userId, String packageName, long since) {
+        final ArrayList<Event> out = new ArrayList<>();
+        final ArrayList<Event> list = mByApp.get(key(userId, packageName));
+        if (list != null) {
+            for (int i = list.size() - 1; i >= 0 && list.get(i).time >= since; i--) {
+                out.add(copy(list.get(i)));
+            }
+        }
+        return out;
+    }
+
+    /** The app's latest event of one of the kinds, or null. */
+    @Nullable
+    synchronized Event latest(int userId, String packageName, int... kinds) {
+        final ArrayList<Event> list = mByApp.get(key(userId, packageName));
+        if (list == null) {
+            return null;
+        }
+        for (int i = list.size() - 1; i >= 0; i--) {
+            for (int k : kinds) {
+                if (list.get(i).kind == k) {
+                    return copy(list.get(i));
+                }
+            }
+        }
+        return null;
+    }
+
+    /** Sets how long the app's latest wake lasted, once it is paused again. */
+    synchronized void endWake(int userId, String packageName, long now) {
+        final ArrayList<Event> list = mByApp.get(key(userId, packageName));
+        if (list == null || list.isEmpty()) {
+            return;
+        }
+        final Event last = list.get(list.size() - 1);
+        if (last.kind == LujarchBackground.EVENT_WOKEN && last.count == 1
+                && last.durationMs == 0) {
+            last.durationMs = Math.max(1, now - last.time);
+            mDirty = true;
+        }
+    }
+
+    /** The apps with events, as "userId:package". */
+    synchronized List<String> apps() {
+        return new ArrayList<>(mByApp.keySet());
+    }
+
+    /** Drops the events of an app that was removed. */
+    synchronized void remove(int userId, String packageName) {
+        if (mByApp.remove(key(userId, packageName)) != null) {
+            mDirty = true;
+        }
+    }
+
+    synchronized void load() {
+        mByApp.clear();
+        if (!mFile.exists()) {
+            return;
+        }
+        final long oldest = System.currentTimeMillis() - KEEP_MS;
+        int bad = 0;
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(
+                new FileInputStream(mFile.getBaseFile()), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                final String[] f = line.split("\t", -1);
+                if (f.length != 10) {
+                    bad++;
+                    continue;
+                }
+                try {
+                    final Event e = new Event(Long.parseLong(f[0]), Integer.parseInt(f[3]),
+                            Integer.parseInt(f[4]), f[5].isEmpty() ? null : f[5],
+                            Integer.parseInt(f[6]), f[7].isEmpty() ? null : f[7]);
+                    e.count = Integer.parseInt(f[8]);
+                    e.durationMs = Long.parseLong(f[9]);
+                    if (e.time < oldest) {
+                        continue;
+                    }
+                    final String key = key(Integer.parseInt(f[1]), f[2]);
+                    ArrayList<Event> list = mByApp.get(key);
+                    if (list == null) {
+                        list = new ArrayList<>();
+                        mByApp.put(key, list);
+                    }
+                    list.add(e);
+                } catch (NumberFormatException e) {
+                    bad++;
+                }
+            }
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot read " + mFile.getBaseFile(), e);
+        }
+        if (bad > 0) {
+            Slog.w(TAG, mFile.getBaseFile() + ": " + bad + " malformed lines dropped");
+        }
+    }
+
+    /** Writes the record when it changed, without the events older than 7 days. */
+    void save() {
+        final StringBuilder out = new StringBuilder();
+        synchronized (this) {
+            if (!mDirty) {
+                return;
+            }
+            mDirty = false;
+            final long oldest = System.currentTimeMillis() - KEEP_MS;
+            for (int i = mByApp.size() - 1; i >= 0; i--) {
+                final ArrayList<Event> list = mByApp.valueAt(i);
+                while (!list.isEmpty() && list.get(0).time < oldest) {
+                    list.remove(0);
+                }
+                if (list.isEmpty()) {
+                    mByApp.removeAt(i);
+                    continue;
+                }
+                final String[] app = mByApp.keyAt(i).split(":", 2);
+                for (Event e : list) {
+                    out.append(e.time).append('\t').append(app[0]).append('\t').append(app[1])
+                            .append('\t').append(e.kind).append('\t').append(e.who).append('\t')
+                            .append(clean(e.whoPackage)).append('\t').append(e.cause)
+                            .append('\t').append(clean(e.detail)).append('\t').append(e.count)
+                            .append('\t').append(e.durationMs).append('\n');
+                }
+            }
+        }
+        FileOutputStream stream = null;
+        try {
+            stream = mFile.startWrite();
+            final Writer w = new OutputStreamWriter(stream, StandardCharsets.UTF_8);
+            w.write(out.toString());
+            w.flush();
+            mFile.finishWrite(stream);
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot write " + mFile.getBaseFile(), e);
+            if (stream != null) {
+                mFile.failWrite(stream);
+            }
+            synchronized (this) {
+                mDirty = true;
+            }
+        }
+    }
+
+    private static String clean(@Nullable String s) {
+        return s == null ? "" : s.replace('\t', ' ').replace('\n', ' ');
+    }
+
+    private static Event copy(Event e) {
+        final Event c = new Event(e.time, e.kind, e.who, e.whoPackage, e.cause, e.detail);
+        c.count = e.count;
+        c.durationMs = e.durationMs;
+        return c;
+    }
+
+    private static boolean eq(@Nullable String a, @Nullable String b) {
+        return a == null ? b == null : a.equals(b);
+    }
+}
diff --git a/services/core/java/com/android/server/am/LujarchBackgroundRuns.java b/services/core/java/com/android/server/am/LujarchBackgroundRuns.java
