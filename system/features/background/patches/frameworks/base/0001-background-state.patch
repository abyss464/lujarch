+        String duration(long ms) {
+            final long s = Math.max(1, ms / 1000);
+            if (s < 60) {
+                return c.getString(R.string.lujarch_background_seconds, s);
+            }
+            if (s < 3600) {
+                return c.getString(R.string.lujarch_background_minutes, s / 60);
+            }
+            return c.getString(R.string.lujarch_background_hours_minutes, s / 3600,
+                    (s % 3600) / 60);
