+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.am;
+
+import android.os.Debug;
+import android.os.SystemClock;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.util.ArraySet;
+import android.util.Slog;
+import android.util.SparseArray;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * What the kernel tells about processes for Lujarch's Background: memory, swap, CPU time, threads
+ * and the network connections a process holds. Reads /proc only; no lock of the system is held
+ * while it reads.
+ */
+final class LujarchBackgroundProc {
+    private static final String TAG = LujarchBackgroundService.TAG;
+    /** A process's memory is read again after this long; a paused one only when it changed. */
+    private static final long MEMORY_TTL_MS = 30_000;
+    private static final long TICK_MS = 1000L / Math.max(1, Os.sysconf(OsConstants._SC_CLK_TCK));
+
+    /** One process's memory, as last read. */
+    private static final class Memory {
+        long pssKb;
+        long swapKb;
+        long readAt;
+        boolean frozen;
+    }
+
+    private final SparseArray<Memory> mMemory = new SparseArray<>();
+    /** pid of each failure already logged, so a process logs once. */
+    private final ArraySet<String> mLogged = new ArraySet<>();
+
+    /** MemTotal and MemAvailable, in kB; zeros when /proc/meminfo cannot be read. */
+    long[] memInfo() {
+        final long[] out = new long[2];
+        try (BufferedReader r = new BufferedReader(new FileReader("/proc/meminfo"))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                if (line.startsWith("MemTotal:")) {
+                    out[0] = kb(line);
+                } else if (line.startsWith("MemAvailable:")) {
+                    out[1] = kb(line);
+                }
+            }
+        } catch (IOException e) {
+            logOnce("meminfo", "cannot read /proc/meminfo", e);
+        }
+        return out;
+    }
+
+    /**
+     * The process's proportional memory and swap, in kB. A paused process's memory does not
+     * change, so it is read again only when it was not paused at the last read.
+     */
+    synchronized long[] memory(int pid, boolean frozen) {
+        final long now = SystemClock.uptimeMillis();
+        Memory m = mMemory.get(pid);
+        if (m != null && (frozen && m.frozen || now - m.readAt < MEMORY_TTL_MS)) {
+            return new long[] {m.pssKb, m.swapKb};
+        }
+        if (m == null) {
+            m = new Memory();
+            mMemory.put(pid, m);
+        }
+        m.pssKb = Debug.getPss(pid, null, null);
+        m.swapKb = statusKb(pid, "VmSwap:");
+        m.readAt = now;
+        m.frozen = frozen;
+        return new long[] {m.pssKb, m.swapKb};
+    }
+
+    /** Forgets the processes that no longer run. */
+    synchronized void retain(ArraySet<Integer> pids) {
+        for (int i = mMemory.size() - 1; i >= 0; i--) {
+            if (!pids.contains(mMemory.keyAt(i))) {
+                mMemory.removeAt(i);
+            }
+        }
+    }
+
+    /** A value of /proc/pid/status in kB, or 0. */
+    static long statusKb(int pid, String key) {
+        try (BufferedReader r = new BufferedReader(new FileReader("/proc/" + pid + "/status"))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                if (line.startsWith(key)) {
+                    return kb(line);
+                }
+            }
+        } catch (IOException e) {
+            // The process ended.
+        }
+        return 0;
+    }
+
+    /** CPU time the process used since it started (user and system), or -1. */
+    static long cpuMs(int pid) {
+        final String stat = read("/proc/" + pid + "/stat");
+        return stat != null ? cpuOfStat(stat) : -1;
+    }
+
+    /** One thread: tid, name, state letter and CPU time. */
+    static final class Thread {
+        final int tid;
+        final String name;
+        final char state;
+        final long cpuMs;
+
+        Thread(int tid, String name, char state, long cpuMs) {
+            this.tid = tid;
+            this.name = name;
+            this.state = state;
+            this.cpuMs = cpuMs;
+        }
+    }
+
+    /** The process's threads, by CPU time, most first. */
+    static List<Thread> threads(int pid) {
+        final ArrayList<Thread> out = new ArrayList<>();
+        final File[] tasks = new File("/proc/" + pid + "/task").listFiles();
+        if (tasks == null) {
+            return out;
+        }
+        for (File task : tasks) {
+            final String stat = read(task.getPath() + "/stat");
+            if (stat == null) {
+                continue;
+            }
+            final int open = stat.indexOf('(');
+            final int close = stat.lastIndexOf(')');
+            if (open < 0 || close < open || close + 2 >= stat.length()) {
+                continue;
+            }
+            try {
+                out.add(new Thread(Integer.parseInt(task.getName()),
+                        stat.substring(open + 1, close), stat.charAt(close + 2), cpuOfStat(stat)));
+            } catch (NumberFormatException e) {
+                // Not a thread directory.
+            }
+        }
+        out.sort((a, b) -> Long.compare(b.cpuMs, a.cpuMs));
+        return out;
+    }
+
+    private static long cpuOfStat(String stat) {
+        final int close = stat.lastIndexOf(')');
+        if (close < 0) {
+            return -1;
+        }
+        // After the name: state (field 3) ... utime is field 14, stime field 15.
+        final String[] f = stat.substring(close + 2).split(" ");
+        if (f.length < 13) {
+            return -1;
+        }
+        try {
+            return (Long.parseLong(f[11]) + Long.parseLong(f[12])) * TICK_MS;
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+
+    /**
+     * The socket inodes of every established TCP connection the uids hold, by uid, from
+     * /proc/net/tcp and /proc/net/tcp6.
+     */
+    SparseArray<ArraySet<String>> connections(ArraySet<Integer> uids) {
+        final SparseArray<ArraySet<String>> out = new SparseArray<>();
+        for (String file : new String[] {"/proc/net/tcp", "/proc/net/tcp6"}) {
+            final List<String> lines;
+            try {
+                lines = Files.readAllLines(Paths.get(file), StandardCharsets.US_ASCII);
+            } catch (IOException e) {
+                logOnce(file, "cannot read " + file, e);
+                continue;
+            }
+            for (int i = 1; i < lines.size(); i++) {
+                final String[] f = lines.get(i).trim().split("\\s+");
+                // sl local remote st tx:rx tr:when retrnsmt uid timeout inode
+                if (f.length < 10 || !"01".equals(f[3])) {
+                    continue;
+                }
+                try {
+                    final int uid = Integer.parseInt(f[7]);
+                    if (!uids.contains(uid) || "0".equals(f[9])) {
+                        continue;
+                    }
+                    ArraySet<String> set = out.get(uid);
+                    if (set == null) {
+                        set = new ArraySet<>();
+                        out.put(uid, set);
+                    }
+                    set.add("socket:[" + f[9] + "]");
+                } catch (NumberFormatException e) {
+                    // A malformed line.
+                }
+            }
+        }
+        return out;
+    }
+
+    /** Whether the process holds one of the sockets. */
+    boolean holds(int pid, ArraySet<String> sockets) {
+        final String[] fds = new File("/proc/" + pid + "/fd").list();
+        if (fds == null) {
+            logOnce("fd" + pid, "cannot list the files of pid " + pid, null);
+            return false;
+        }
+        for (String fd : fds) {
+            try {
+                if (sockets.contains(Os.readlink("/proc/" + pid + "/fd/" + fd))) {
+                    return true;
+                }
+            } catch (ErrnoException e) {
+                // The file was closed meanwhile.
+            }
+        }
+        return false;
+    }
+
+    private static long kb(String line) {
+        final String[] f = line.trim().split("\\s+");
+        try {
+            return f.length > 1 ? Long.parseLong(f[1]) : 0;
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    private static String read(String path) {
+        try {
+            return new String(Files.readAllBytes(Paths.get(path)), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    private void logOnce(String key, String what, Exception e) {
+        synchronized (mLogged) {
+            if (!mLogged.add(key)) {
+                return;
+            }
+        }
+        Slog.w(TAG, what + (e != null ? ": " + e.getMessage() : ""));
+    }
+}
