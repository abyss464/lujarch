+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.internal.app;
+
+import com.android.internal.app.LujarchBackgroundProcess;
+
+/**
+ * Where one app is: its run state, who put it there and why, what it uses, and its choices.
+ * @hide
+ */
+parcelable LujarchBackgroundApp {
+    @nullable String packageName;
+    int uid;
+    @nullable String label;
+    /** LujarchBackground.RUN_*. */
+    int state;
+    /** LujarchBackground.WHO_*. */
+    int who;
+    /** Who, in words: User, System, App, or the other app's name. */
+    @nullable String whoName;
+    /** Why it is in its state, in words. */
+    @nullable String reason;
+    /** One word for Recents' Running layer: Navigating, Playing, Small window, ... */
+    @nullable String word;
+    /** When it reached this state, as System.currentTimeMillis(); 0 when not known. */
+    long sinceMillis;
+    long memoryBytes;
+    long swapBytes;
+    /** The system's own app or process. */
+    boolean system;
+    /** Keep is on. */
+    boolean kept;
+    /** LujarchBackground.USAGE_*. */
+    int usage;
+    /** Background usage cannot be changed for this app. */
+    boolean usageFixed;
+    /** Runs a foreground service of its own (End stops it). */
+    boolean ownService;
+    /** Shown in a small window (Close closes it). */
+    boolean smallWindow;
+    /** The task of its small window or its card in Recents; -1 without one. */
+    int taskId;
+    /** Has a card in Recents. */
+    boolean hasTask;
+    /** Running only on its way to Paused (the freezer waits a moment), or not needed. */
+    boolean settling;
+    /** Its place in the order of reclaiming among the paused apps, from 1; 0 when not paused. */
+    int reclaimOrder;
+    /** A broken choice waits for the owner (BG-3). */
+    boolean suggestion;
+    int processCount;
+    /** Processes that are not paused. */
+    int runningCount;
+    /** Battery used off screen in the last 24 hours, in mAh and in percent of the battery. */
+    double batteryMah;
+    double batteryPercent;
+    /** Times woken in the last 24 hours. */
+    int wakeups;
+    /** Time running off screen in the last 24 hours. */
+    long backgroundMs;
+    /** Filled for one app only (getApp). */
+    @nullable LujarchBackgroundProcess[] processes;
+    /**
+     * Filled for one app only: the short names (":push", the package for the main process) of
+     * every process the app declares or runs, the ones the owner chose to keep running, and the
+     * running ones that hold a network connection.
+     */
+    @nullable String[] processNames;
+    @nullable String[] chosen;
+    @nullable String[] connected;
+}
diff --git a/core/java/com/android/internal/app/LujarchBackgroundEvent.aidl b/core/java/com/android/internal/app/LujarchBackgroundEvent.aidl
