+    /** Reads the apps in small windows and the cards in Recents. Called on this thread. */
+    private void updateTasks() {
+        final ArrayMap<String, Integer> small = new ArrayMap<>();
+        final ArrayMap<String, Integer> recents = new ArrayMap<>();
+        final ArraySet<Integer> smallTasks;
+        synchronized (mLock) {
+            smallTasks = new ArraySet<>(mSmallWindowTasks);
+        }
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            for (ActivityManager.RunningTaskInfo t : mAm.mActivityTaskManager.getTasks(
+                    100, false, false, android.view.Display.INVALID_DISPLAY)) {
+                final String pkg = taskPackage(t);
+                if (pkg != null && smallTasks.contains(t.taskId)) {
+                    small.put(LujarchBackgroundRecord.key(t.userId, pkg), t.taskId);
+                }
+            }
+            for (int userId : mAm.mUserController.getStartedUserArray()) {
+                for (ActivityManager.RecentTaskInfo t : mAm.mActivityTaskManager.getRecentTasks(
+                        100, ActivityManager.RECENT_IGNORE_UNAVAILABLE, userId).getList()) {
+                    final String pkg = taskPackage(t);
+                    if (pkg != null) {
+                        recents.putIfAbsent(LujarchBackgroundRecord.key(t.userId, pkg), t.taskId);
+                    }
+                }
+            }
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "cannot read the tasks", e);
+            return;
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+        synchronized (mLock) {
+            mSmallWindows.clear();
+            mSmallWindows.putAll(small);
+            mRecents.clear();
+            mRecents.putAll(recents);
+        }
+    }
