+        String when(long time) {
+            final long now = System.currentTimeMillis();
+            if (now - time < DAY_MS && sameDay(time, now)) {
+                return DateFormat.getTimeFormat(c).format(new Date(time));
+            }
+            return DateFormat.format(DateFormat.getBestDateTimePattern(Locale.getDefault(),
+                    "MMMd jmm"), time).toString();
