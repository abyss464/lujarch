+    // ---------------------------------------------------------------------------------------
+    // Hooks from ActivityManager
+
+    /** A process was frozen (CachedAppOptimizer). */
+    void onFrozen(ProcessRecord app) {
+        if (mReady && app.info != null) {
+            final String pkg = app.info.packageName;
+            final int userId = app.userId;
+            mHandler.post(() -> evaluate(userId, pkg, null));
+        }
+    }
+
+    /** A process was unfrozen for a reason of CachedAppOptimizer.UNFREEZE_REASON_*. */
+    void onUnfrozen(ProcessRecord app, int reason) {
+        if (!mReady || app.info == null) {
+            return;
+        }
+        final String pkg = app.info.packageName;
+        final int userId = app.userId;
+        final int pid = app.getPid();
+        final long now = System.currentTimeMillis();
+        synchronized (mLock) {
+            ArrayList<Long> wakes = mWakes.get(pid);
+            if (wakes == null) {
+                wakes = new ArrayList<>();
+                mWakes.put(pid, wakes);
+            }
+            wakes.add(now);
+            while (!wakes.isEmpty() && now - wakes.get(0) > DAY_MS) {
+                wakes.remove(0);
+            }
+            mPausedByYou.remove(pid);
+        }
+        mHandler.post(() -> evaluate(userId, pkg, new Wake(pid, reason)));
+    }
+
+    /** A process died; its end is recorded once its exit reason is final. */
+    void onProcessDied(ProcessRecord app) {
+        if (!mReady || app.info == null || app.getPid() <= 0) {
+            return;
+        }
+        final Death d = new Death();
+        d.pid = app.getPid();
+        d.uid = app.uid;
+        d.userId = app.userId;
+        d.packageName = app.info.packageName;
+        d.name = app.processName;
+        d.messages = (app.getLujarchHold() & LUJARCH_HOLD_MESSAGES) != 0;
+        d.time = System.currentTimeMillis();
+        mHandler.postDelayed(() -> onDeath(d), EXIT_SETTLE_MS);
+    }
+
+    /**
+     * Someone asked ActivityManager to stop or kill a package; called on a binder thread, maybe
+     * with ActivityManager's lock held. Who it was is found on this service's thread.
+     */
+    void noteCaller(String packageName, int userId, int callingUid, int action) {
+        if (!mReady || packageName == null) {
+            return;
+        }
+        final long at = SystemClock.elapsedRealtime();
+        final long time = System.currentTimeMillis();
+        mHandler.post(() -> {
+            final String[] who = whoForCaller(callingUid);
+            final int w = Integer.parseInt(who[0]);
+            synchronized (mLock) {
+                mCallers.put(LujarchBackgroundRecord.key(userId, packageName),
+                        new Caller(w, who[1], action, at));
+            }
+            if (action == ACTION_FORCE_STOP) {
+                record(userId, packageName, new Event(time, LujarchBackground.EVENT_STOPPED, w,
+                        who[1], C_STOP, null));
+                evaluate(userId, packageName, null);
+            }
+        });
+    }
+
+    /** [who, package] of a caller: the owner through the system's own pages and Recents, or the app. */
+    private String[] whoForCaller(int callingUid) {
+        if (UserHandle.getAppId(callingUid) < Process.FIRST_APPLICATION_UID) {
+            return new String[] {String.valueOf(LujarchBackground.WHO_YOU), null};
+        }
+        final String[] pkgs = mContext.getPackageManager().getPackagesForUid(callingUid);
+        final String pkg = pkgs != null && pkgs.length > 0 ? pkgs[0] : null;
+        if (pkg == null || isOwnersSurface(pkg, UserHandle.getUserId(callingUid))) {
+            return new String[] {String.valueOf(LujarchBackground.WHO_YOU), null};
+        }
+        return new String[] {String.valueOf(LujarchBackground.WHO_OTHER), pkg};
+    }
+
+    /** The home app, the shade and Settings act on the owner's touch. */
+    private boolean isOwnersSurface(String pkg, int userId) {
+        if (pkg.equals("com.android.systemui") || pkg.equals("com.android.settings")
+                || pkg.equals(LujarchBackground.SETTINGS_PACKAGE)) {
+            return true;
+        }
+        final android.content.ComponentName home =
+                mContext.getPackageManager().getHomeActivities(new ArrayList<>());
+        return home != null && pkg.equals(home.getPackageName());
+    }
+
+    /**
+     * ActivityManager started a process: one started for something other than an activity is a
+     * start in the background, noted with why and who asked (BG-6). Called with ActivityManager's
+     * lock held.
+     */
+    void noteStart(ApplicationInfo info, String processName, HostingRecord h) {
+        if (!mReady || info == null || h == null) {
+            return;
+        }
+        final String type = h.getType();
+        final int kind;
+        if (HostingRecord.HOSTING_TYPE_BROADCAST.equals(type)) {
+            kind = START_BROADCAST;
+        } else if (HostingRecord.HOSTING_TYPE_STARTED_SERVICE.equals(type)
+                || HostingRecord.HOSTING_TYPE_BOUND_SERVICE.equals(type)) {
+            kind = START_SERVICE;
+        } else if (HostingRecord.HOSTING_TYPE_CONTENT_PROVIDER.equals(type)) {
+            kind = START_PROVIDER;
+        } else {
+            return;
+        }
+        final int userId = UserHandle.getUserId(info.uid);
+        final String pkg = info.packageName;
+        final String trigger = h.getTriggerType();
+        final String action = h.getAction();
+        final int callerUid = h.getCallerUid();
+        int cause;
+        int who = LujarchBackground.WHO_SYSTEM;
+        String whoPackage = null;
+        if (Intent.ACTION_BOOT_COMPLETED.equals(action)
+                || Intent.ACTION_LOCKED_BOOT_COMPLETED.equals(action)) {
+            cause = C_START_BOOT;
+        } else if (HostingRecord.TRIGGER_TYPE_ALARM.equals(trigger)) {
+            cause = C_START_ALARM;
+            who = LujarchBackground.WHO_APP;
+        } else if (HostingRecord.TRIGGER_TYPE_PUSH_MESSAGE.equals(trigger)
+                || HostingRecord.TRIGGER_TYPE_PUSH_MESSAGE_OVER_QUOTA.equals(trigger)) {
+            cause = C_START_PUSH;
+        } else {
+            cause = kind == START_SERVICE ? C_START_SERVICE
+                    : kind == START_PROVIDER ? C_START_PROVIDER : C_START_BROADCAST;
+            if (callerUid >= 0
+                    && UserHandle.getAppId(callerUid) >= Process.FIRST_APPLICATION_UID) {
+                if (UserHandle.getAppId(callerUid) == UserHandle.getAppId(info.uid)) {
+                    who = LujarchBackground.WHO_APP;
+                } else {
+                    who = LujarchBackground.WHO_OTHER;
+                }
+            }
+        }
+        final Event e = new Event(System.currentTimeMillis(), LujarchBackground.EVENT_STARTED,
+                who, whoPackage, cause, kind == START_BROADCAST && action != null
+                        ? shortAction(action) : null);
+        mHandler.post(() -> {
+            if (e.who == LujarchBackground.WHO_OTHER) {
+                // The other app, found off ActivityManager's lock.
+                final String[] pkgs = mContext.getPackageManager().getPackagesForUid(callerUid);
+                e.whoPackage = pkgs != null && pkgs.length > 0 ? pkgs[0] : null;
+                if (e.whoPackage == null) {
+                    e.who = LujarchBackground.WHO_SYSTEM;
+                }
+            }
+            final Track t = track(userId, pkg);
+            if (!t.onScreen) {
+                record(userId, pkg, e);
+            }
+        });
+    }
+
+    private static String shortAction(String action) {
+        final int dot = action.lastIndexOf('.');
+        return dot >= 0 && dot + 1 < action.length() ? action.substring(dot + 1) : action;
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The record: an app's depth changes become its lines.
+
+    private static final class Wake {
+        final int pid;
+        final int reason;
+
+        Wake(int pid, int reason) {
+            this.pid = pid;
+            this.reason = reason;
+        }
+    }
+
+    private static final class Death {
+        int pid;
+        int uid;
+        int userId;
+        String packageName;
+        String name;
+        boolean messages;
+        long time;
+    }
+
+    private void evaluateUid(int uid) {
+        final String[] pkgs = mContext.getPackageManager().getPackagesForUid(uid);
+        if (pkgs != null) {
+            for (String p : pkgs) {
+                evaluate(UserHandle.getUserId(uid), p, null);
+            }
+        }
+        changed();
+    }
+
+    private Track track(int userId, String pkg) {
+        final String key = LujarchBackgroundRecord.key(userId, pkg);
+        synchronized (mLock) {
+            Track t = mTracks.get(key);
+            if (t == null) {
+                t = new Track();
+                mTracks.put(key, t);
+            }
+            return t;
+        }
+    }
+
+    /** Compares the app's depth with its last and records the change. Called on this thread. */
+    private void evaluate(int userId, String pkg, @Nullable Wake wake) {
+        if (pkg == null) {
+            return;
+        }
+        final List<Proc> procs = snapshot(userId, pkg);
+        final Track t = track(userId, pkg);
+        final AppState now = appState(procs);
+        final long time = System.currentTimeMillis();
+        final int before = t.depth;
+        if (now.depth != before) {
+            if (now.depth == LujarchBackground.DEPTH_ON_SCREEN) {
+                final int cause = before == LujarchBackground.DEPTH_PAUSED
+                        || before == LujarchBackground.DEPTH_MESSAGES ? C_OPENED_AS_WAS
+                        : before == LujarchBackground.DEPTH_RECLAIMED
+                        || before == LujarchBackground.DEPTH_STOPPED || before < 0
+                        ? C_OPENED_AGAIN : C_OPENED;
+                record(userId, pkg, new Event(time, LujarchBackground.EVENT_OPENED,
+                        LujarchBackground.WHO_YOU, null, cause, null));
+            } else if (before == LujarchBackground.DEPTH_ON_SCREEN) {
+                record(userId, pkg, new Event(time, LujarchBackground.EVENT_LEFT,
+                        LujarchBackground.WHO_YOU, null, C_LEFT, null));
+                if (usageOf(procs.isEmpty() ? -1 : procs.get(0).uid, pkg)
+                        == LujarchBackground.USAGE_MESSAGES) {
+                    // Find its connection before the freezer pauses it.
+                    mHandler.postDelayed(this::scanMessages, 2_000);
+                }
+            }
+            if ((now.depth == LujarchBackground.DEPTH_PAUSED
+                    || now.depth == LujarchBackground.DEPTH_MESSAGES)
+                    && before >= LujarchBackground.DEPTH_ON_SCREEN
+                    && before <= LujarchBackground.DEPTH_RUNNING) {
+                mRecord.endWake(userId, pkg, time);
+                final Event e = new Event(time, LujarchBackground.EVENT_PAUSED,
+                        now.pausedByYou ? LujarchBackground.WHO_YOU : LujarchBackground.WHO_SYSTEM,
+                        null, now.depth == LujarchBackground.DEPTH_MESSAGES ? C_PAUSED_KEPT
+                        : now.pausedByYou ? C_PAUSED_BY_YOU : C_PAUSED, now.holderName);
+                if (!wasJustWoken(userId, pkg, time)) {
+                    record(userId, pkg, e);
+                }
+            } else if (now.depth == LujarchBackground.DEPTH_RUNNING
+                    && (before == LujarchBackground.DEPTH_PAUSED
+                    || before == LujarchBackground.DEPTH_MESSAGES)) {
+                record(userId, pkg, wakeEvent(procs, wake, time));
+            }
+            t.depth = now.depth;
+            t.since = time;
+        }
+        t.onScreen = now.depth == LujarchBackground.DEPTH_ON_SCREEN;
+    }
+
+    /** A wake that pauses again within seconds counts on its own line, with its length. */
+    private boolean wasJustWoken(int userId, String pkg, long now) {
+        final Event last = mRecord.latest(userId, pkg, LujarchBackground.EVENT_WOKEN,
+                LujarchBackground.EVENT_PAUSED, LujarchBackground.EVENT_LEFT,
+                LujarchBackground.EVENT_OPENED);
+        return last != null && last.kind == LujarchBackground.EVENT_WOKEN
+                && now - last.time < 60_000;
+    }
+
+    private Event wakeEvent(List<Proc> procs, @Nullable Wake wake, long time) {
+        Proc woken = null;
+        for (Proc p : procs) {
+            if (wake != null && p.pid == wake.pid || woken == null && !p.frozen) {
+                woken = p;
+            }
+        }
+        int who = LujarchBackground.WHO_SYSTEM;
+        String whoPackage = null;
+        int cause = C_WOKEN_SYSTEM;
+        String detail = null;
+        if (woken != null) {
+            if (woken.sourcePackage != null && woken.sourceUid >= 0) {
+                if (UserHandle.getAppId(woken.sourceUid) == UserHandle.getAppId(woken.uid)) {
+                    who = LujarchBackground.WHO_APP;
+                    cause = C_WOKEN_OWN;
+                    detail = processShortName(woken.sourceName, woken.packageName);
+                } else if (UserHandle.getAppId(woken.sourceUid) >= Process.FIRST_APPLICATION_UID) {
+                    who = LujarchBackground.WHO_OTHER;
+                    whoPackage = woken.sourcePackage;
+                    cause = C_WOKEN_BY;
+                }
+            }
+            if (cause == C_WOKEN_SYSTEM) {
+                if (woken.tempAllowed) {
+                    cause = C_WOKEN_PUSH;
+                } else if (woken.receiving) {
+                    cause = C_WOKEN_BROADCAST;
+                } else if (woken.executing || woken.startedService) {
+                    cause = C_WOKEN_SERVICE;
+                    who = LujarchBackground.WHO_APP;
+                }
+            }
+        }
+        if (wake != null && cause == C_WOKEN_SYSTEM) {
+            switch (wake.reason) {
+                case CachedAppOptimizer.UNFREEZE_REASON_START_RECEIVER:
+                case CachedAppOptimizer.UNFREEZE_REASON_FINISH_RECEIVER:
+                    cause = C_WOKEN_BROADCAST;
+                    break;
+                case CachedAppOptimizer.UNFREEZE_REASON_BIND_SERVICE:
+                case CachedAppOptimizer.UNFREEZE_REASON_START_SERVICE:
+                case CachedAppOptimizer.UNFREEZE_REASON_EXECUTING_SERVICE:
+                    cause = C_WOKEN_SERVICE;
+                    break;
+                case CachedAppOptimizer.UNFREEZE_REASON_GET_PROVIDER:
+                    cause = C_WOKEN_PROVIDER;
+                    break;
+                case CachedAppOptimizer.UNFREEZE_REASON_BINDER_TXNS:
+                    cause = C_WOKEN_CALL;
+                    break;
+                case CachedAppOptimizer.UNFREEZE_REASON_ALLOWLIST:
+                    cause = C_WOKEN_PUSH;
+                    break;
+                default:
+                    break;
+            }
+        }
+        return new Event(time, LujarchBackground.EVENT_WOKEN, who, whoPackage, cause, detail);
+    }
+
+    private void onDeath(Death d) {
+        final ArrayList<ApplicationExitInfo> infos = new ArrayList<>();
+        try {
+            mAm.mProcessList.mAppExitInfoTracker.getExitInfo(d.packageName, d.uid, d.pid, 1,
+                    infos);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "no exit info for " + d.name + " (" + d.pid + ")", e);
+        }
+        final ApplicationExitInfo info = infos.isEmpty() ? null : infos.get(0);
+        final String key = LujarchBackgroundRecord.key(d.userId, d.packageName);
+        final Caller caller;
+        synchronized (mLock) {
+            final Caller c = mCallers.get(key);
+            caller = c != null && SystemClock.elapsedRealtime() - c.at < 10_000 ? c : null;
+            mMessagesPids.remove(d.pid);
+            mPausedByYou.remove(d.pid);
+            mWakes.remove(d.pid);
+            mCpuMarks.remove(d.pid);
+        }
+        final int[] whoCause = endCause(info, caller, d.uid, d.packageName);
+        final List<Proc> left = snapshot(d.userId, d.packageName);
+        final Track t = track(d.userId, d.packageName);
+        if (whoCause[1] == C_STOP) {
+            // The stop has its line already.
+            t.depth = left.isEmpty() ? LujarchBackground.DEPTH_STOPPED : t.depth;
+            changed();
+            return;
+        }
+        final Event e = new Event(d.time, LujarchBackground.EVENT_ENDED, whoCause[0],
+                caller != null && caller.who == LujarchBackground.WHO_OTHER ? caller.whoPackage
+                        : null, whoCause[1],
+                left.isEmpty() ? null : processShortName(d.name, d.packageName));
+        record(d.userId, d.packageName, e);
+        if (left.isEmpty()) {
+            t.depth = LujarchBackground.DEPTH_RECLAIMED;
+            t.since = d.time;
+            t.onScreen = false;
+        }
+        // Only the owner's own choices are alerted; an update ends an app on the owner's behalf.
+        if (whoCause[0] == LujarchBackground.WHO_SYSTEM && whoCause[1] != C_END_UPDATE
+                && mNotices != null) {
+            final int usage = usageOf(d.uid, d.packageName);
+            final boolean kept = isKept(d.uid, d.packageName);
+            final boolean ownersUnrestricted = usage == LujarchBackground.USAGE_UNRESTRICTED
+                    && !isSystemAllowlisted(d.packageName);
+            if (kept || ownersUnrestricted
+                    || usage == LujarchBackground.USAGE_MESSAGES && d.messages) {
+                mNotices.alertEnded(d.uid, d.packageName, kept ? -1 : usage, whoCause[1], d.time,
+                        d.messages);
+            }
+        }
+        changed();
+    }
+
+    /** [who, cause] of an end, from its exit reason and who asked for it. */
+    private int[] endCause(@Nullable ApplicationExitInfo info, @Nullable Caller caller, int uid,
+            String pkg) {
+        final int you = LujarchBackground.WHO_YOU;
+        final int system = LujarchBackground.WHO_SYSTEM;
+        final int app = LujarchBackground.WHO_APP;
+        if (info == null) {
+            return new int[] {system, C_END_SYSTEM};
+        }
+        final int callerWho = caller != null ? caller.who : you;
+        switch (info.getReason()) {
+            case ApplicationExitInfo.REASON_LOW_MEMORY:
+                return new int[] {system, C_END_LOW_MEMORY};
+            case ApplicationExitInfo.REASON_EXIT_SELF:
+                return new int[] {app, C_END_SELF};
+            case ApplicationExitInfo.REASON_CRASH:
+            case ApplicationExitInfo.REASON_CRASH_NATIVE:
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE:
+                return new int[] {app, C_END_CRASH};
+            case ApplicationExitInfo.REASON_ANR:
+                return new int[] {app, C_END_ANR};
+            case ApplicationExitInfo.REASON_FREEZER:
+                return new int[] {system, C_END_FREEZER};
+            case ApplicationExitInfo.REASON_PERMISSION_CHANGE:
+                return new int[] {you, C_END_PERMISSION};
+            case ApplicationExitInfo.REASON_PACKAGE_UPDATED:
+            case ApplicationExitInfo.REASON_PACKAGE_STATE_CHANGE:
+                return new int[] {system, C_END_UPDATE};
+            case ApplicationExitInfo.REASON_USER_REQUESTED:
+                switch (info.getSubReason()) {
+                    case ApplicationExitInfo.SUBREASON_FORCE_STOP:
+                        return new int[] {callerWho, C_STOP};
+                    case ApplicationExitInfo.SUBREASON_REMOVE_TASK:
+                        return new int[] {you, C_END_CARD};
+                    case ApplicationExitInfo.SUBREASON_KILL_BACKGROUND:
+                    case ApplicationExitInfo.SUBREASON_STOP_APP:
+                    case ApplicationExitInfo.SUBREASON_KILL_PID:
+                        return new int[] {callerWho,
+                                callerWho == LujarchBackground.WHO_OTHER ? C_END_BY : C_END_YOU};
+                    default:
+                        return new int[] {callerWho, C_END_YOU};
+                }
+            case ApplicationExitInfo.REASON_OTHER:
+                switch (info.getSubReason()) {
+                    case ApplicationExitInfo.SUBREASON_TOO_MANY_CACHED:
+                    case ApplicationExitInfo.SUBREASON_LARGE_CACHED:
+                    case ApplicationExitInfo.SUBREASON_MEMORY_PRESSURE:
+                    case ApplicationExitInfo.SUBREASON_OOM_KILL:
+                        return new int[] {system, C_END_TOO_MANY};
+                    case ApplicationExitInfo.SUBREASON_TOO_MANY_EMPTY:
+                    case ApplicationExitInfo.SUBREASON_TRIM_EMPTY:
+                    case ApplicationExitInfo.SUBREASON_ISOLATED_NOT_NEEDED:
+                        return new int[] {system, C_END_UNUSED};
+                    case ApplicationExitInfo.SUBREASON_CACHED_IDLE_FORCED_APP_STANDBY:
+                        return new int[] {you, C_END_RESTRICTED};
+                    case ApplicationExitInfo.SUBREASON_REMOVE_TASK:
+                        return new int[] {you, C_END_CARD};
+                    default:
+                        return new int[] {system, C_END_SYSTEM};
+                }
+            case ApplicationExitInfo.REASON_SIGNALED:
+                return caller != null ? new int[] {callerWho,
+                        callerWho == LujarchBackground.WHO_OTHER ? C_END_BY : C_END_YOU}
+                        : new int[] {system, C_END_SYSTEM};
+            default:
+                return new int[] {system, C_END_SYSTEM};
+        }
+    }
+
+    private void record(int userId, String pkg, Event e) {
+        mRecord.add(userId, pkg, e);
+        scheduleSave();
+    }
+
+    private void scheduleSave() {
+        if (!mHandler.hasCallbacks(mSave)) {
+            mHandler.postDelayed(mSave, SAVE_DELAY_MS);
+        }
+    }
+
+    private final Runnable mSave = this::saveRecord;
+
+    private void saveRecord() {
+        mRecord.save();
+    }
+
+    /** Something an app's state depends on changed: the notification and the alerts follow. */
+    private void changed() {
+        if (mNotices != null) {
+            mNotices.update();
+        }
+    }
