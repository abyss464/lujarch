+    // ---------------------------------------------------------------------------------------
+    // Words: every text the surfaces show, in the system's language
+
+    final class Words {
+        private final Context c = mContext;
+
+        String who(int who, @Nullable String pkg, int userId) {
+            switch (who) {
+                case LujarchBackground.WHO_USER:
+                    return c.getString(R.string.lujarch_background_who_user);
+                case LujarchBackground.WHO_APP:
+                    return c.getString(R.string.lujarch_background_who_app);
+                case LujarchBackground.WHO_OTHER:
+                    return pkg != null ? label(pkg, userId)
+                            : c.getString(R.string.lujarch_background_who_app);
+                default:
+                    return c.getString(R.string.lujarch_background_who_system);
+            }
+        }
+
+        /** The reason of an app whose chosen processes run while its others are paused. */
+        String chosen(String names, int paused) {
+            return c.getResources().getQuantityString(R.plurals.lujarch_background_r_chosen,
+                    paused, names, paused);
+        }
+
+        /** The live reason of a cause, or an end's reason. */
+        String text(int cause, @Nullable String detail, @Nullable String pkg, int userId) {
+            switch (cause) {
+                case C_ON_SCREEN:
+                    return c.getString(R.string.lujarch_background_r_on_screen);
+                case C_SMALL_WINDOW:
+                    return c.getString(R.string.lujarch_background_r_small_window);
+                case C_FGS:
+                    return c.getString(R.string.lujarch_background_r_fgs,
+                            fgsWord(detail != null ? Integer.parseInt(detail) : 0));
+                case C_UNRESTRICTED:
+                    return c.getString(R.string.lujarch_background_r_unrestricted);
+                case C_USED_BY:
+                    return c.getString(R.string.lujarch_background_r_used_by,
+                            label(pkg != null ? pkg : "android", userId));
+                case C_USED_BY_OWN:
+                    return c.getString(R.string.lujarch_background_r_used_by_own, detail);
+                case C_BROADCAST:
+                    return c.getString(R.string.lujarch_background_r_broadcast);
+                case C_SERVICE:
+                    return c.getString(R.string.lujarch_background_r_service);
+                case C_PUSH:
+                    return c.getString(R.string.lujarch_background_r_push);
+                case C_SYSTEM:
+                    return c.getString(R.string.lujarch_background_r_system);
+                case C_HOME:
+                    return c.getString(R.string.lujarch_background_r_home);
+                case C_PAUSING:
+                    return c.getString(R.string.lujarch_background_r_pausing);
+                case C_NOT_NEEDED:
+                    return c.getString(R.string.lujarch_background_r_not_needed);
+                case C_PAUSED:
+                    return c.getString(R.string.lujarch_background_r_paused);
+                case C_KEPT:
+                    return c.getString(R.string.lujarch_background_r_kept);
+                case C_STARTING:
+                    return c.getString(R.string.lujarch_background_r_starting);
+                case C_END_BOOT:
+                    return c.getString(R.string.lujarch_background_r_not_started);
+                case C_CHOSEN:
+                    return c.getString(R.string.lujarch_background_r_chosen_process);
+                default:
+                    return c.getString(R.string.lujarch_background_r_running);
+            }
+        }
+
+        /** Why an app or process ended, as a phrase. */
+        String endReason(int cause, @Nullable String pkg, int userId) {
+            switch (cause) {
+                case C_END_LOW_MEMORY:
+                    return c.getString(R.string.lujarch_background_end_low_memory);
+                case C_END_TOO_MANY:
