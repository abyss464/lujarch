+package com.android.internal.app;
+
+import com.android.internal.app.LujarchBackgroundApp;
+import com.android.internal.app.LujarchSmallWindow;
+import com.android.internal.app.LujarchBackgroundEvent;
+import com.android.internal.app.LujarchBackgroundMemory;
+import com.android.internal.app.LujarchBackgroundProcess;
+
+/**
+ * Where every app is in the background, why and who put it there (Lujarch's Background): the one
+ * source the Settings pages, the Background notification and Recents read. Callers hold
+ * android.permission.LUJARCH_BACKGROUND.
+ * @hide
+ */
+interface ILujarchBackground {
+    LujarchBackgroundMemory getMemory();
+
+    /** Every app of the user with a process, a card in Recents or a recent end; withSystem adds the system's processes. */
+    LujarchBackgroundApp[] getApps(int userId, boolean withSystem);
+
+    /** One app with its processes; null when the package is not installed. */
+    @nullable LujarchBackgroundApp getApp(String packageName, int userId);
+
+    /** One process with its reasons and threads; null when it does not run. */
+    @nullable LujarchBackgroundProcess getProcess(int pid);
+
+    /** What happened to the app since sinceMillis, newest first, at most max lines. */
+    LujarchBackgroundEvent[] getEvents(String packageName, int userId, long sinceMillis, int max);
+
+    /** Background usage: LujarchBackground.USAGE_*. */
+    void setBackgroundUsage(String packageName, int userId, int usage);
+
+    void setKept(String packageName, int userId, boolean kept);
+
+    void setFolded(String packageName, int userId, boolean folded);
+
+    /** Stops what the app runs of its own (its foreground services). */
+    void endForegroundServices(String packageName, int userId);
+
+    void closeSmallWindow(int taskId);
+
+    /** The small windows, from the Shell that shows them, in the order of the screen. */
+    oneway void setSmallWindows(in LujarchSmallWindow[] windows);
+
+    /** The small windows as the Shell last told them. */
+    LujarchSmallWindow[] getSmallWindows();
+
+    void endBackgroundProcesses(String packageName, int userId);
+
+    /** Pauses one process once; it then follows its app's choices again. */
+    void pauseProcess(int pid);
+
+    void endProcess(int pid);
+}
diff --git a/core/java/com/android/internal/app/LujarchBackground.java b/core/java/com/android/internal/app/LujarchBackground.java
new file mode 100644
index 0000000000000000000000000000000000000000..2654aea244d31f9662e34bdf9d9d5efcfcaa7636
--- /dev/null
+++ b/core/java/com/android/internal/app/LujarchBackground.java
@@ -0,0 +1,243 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.internal.app;
+
+import android.annotation.ColorInt;
+import android.annotation.Nullable;
+import android.content.Context;
+import android.os.IBinder;
+import android.os.ServiceManager;
+
+import com.android.internal.R;
+
+/**
+ * Lujarch's Background for the surfaces that show it (Settings, the shade, Recents): the depths,
+ * who put an app there, its choices, and the one color of each depth.
+ *
+ * @hide
+ */
+public final class LujarchBackground {
+    /** The system service, {@link ILujarchBackground}. */
+    public static final String SERVICE = "lujarch_background";
+    /** Held by the callers of {@link ILujarchBackground}. */
+    public static final String PERMISSION = "android.permission.LUJARCH_BACKGROUND";
+
+    /** The app is on screen. */
+    public static final int DEPTH_ON_SCREEN = 0;
+    /** It still works: playback, navigation, a download, a small window, or Unrestricted. */
+    public static final int DEPTH_RUNNING = 1;
+    /** Only its process that holds the connection to its messages runs. */
+    public static final int DEPTH_MESSAGES = 2;
+    /** Frozen in memory, using no CPU, back as it was. */
+    public static final int DEPTH_PAUSED = 3;
+    /** Its processes have ended; it starts again when opened. */
+    public static final int DEPTH_RECLAIMED = 4;
+    /** Force stopped: nothing wakes it until it is opened. */
+    public static final int DEPTH_STOPPED = 5;
+    public static final int DEPTH_COUNT = 6;
+
+    public static final int WHO_YOU = 1;
+    public static final int WHO_SYSTEM = 2;
+    /** The app itself. */
+    public static final int WHO_APP = 3;
+    /** Another app, named by whoName. */
+    public static final int WHO_OTHER = 4;
+
+    /** Background usage. */
+    public static final int USAGE_UNRESTRICTED = 0;
+    public static final int USAGE_MESSAGES = 1;
+    public static final int USAGE_OPTIMIZED = 2;
+    public static final int USAGE_RESTRICTED = 3;
+
+    /** What happened to an app. */
+    public static final int EVENT_LEFT = 1;
+    public static final int EVENT_OPENED = 2;
+    public static final int EVENT_PAUSED = 3;
+    public static final int EVENT_WOKEN = 4;
+    public static final int EVENT_ENDED = 5;
+    public static final int EVENT_STOPPED = 6;
+    public static final int EVENT_STARTED = 7;
+
+    /** Settings > System > Background. */
+    public static final String ACTION_BACKGROUND = "org.lujarch.background.action.BACKGROUND";
+    /** Settings > Apps > (app) > Background, for Intent.EXTRA_PACKAGE_NAME and Intent.EXTRA_USER. */
+    public static final String ACTION_APP = "org.lujarch.background.action.APP";
+    /** With {@link #ACTION_APP}: the row to show, such as {@link #KEY_WHAT_HAPPENED}. */
+    public static final String EXTRA_HIGHLIGHT = ":settings:fragment_args_key";
+    public static final String KEY_WHAT_HAPPENED = "what_happened";
+    /** The package of the pages. */
+    public static final String SETTINGS_PACKAGE = "org.lujarch.settings";
+
+    /** Settings.Secure: Recents shows its Running layer (BG-11). */
+    public static final String SETTING_RECENTS_RUNNING = "lujarch_background_recents_running";
+    /** Settings.Secure: Recents shows the memory (BG-12). */
+    public static final String SETTING_RECENTS_MEMORY = "lujarch_background_recents_memory";
+
+    private LujarchBackground() {
+    }
+
+    /** The service, or null while the system does not offer it. */
+    @Nullable
+    public static ILujarchBackground get() {
+        final IBinder binder = ServiceManager.getService(SERVICE);
+        return binder != null ? ILujarchBackground.Stub.asInterface(binder) : null;
+    }
+
+    /**
+     * The color of a depth, the same wherever the depth is shown: tones of the system's accent,
+     * nearer to the page's own color for an app farther from the screen, and still apart from it
+     * in both the light and the dark theme. A small window is on screen.
+     */
+    @ColorInt
+    public static int depthColor(Context context, int depth, boolean smallWindow) {
+        final int d = smallWindow ? DEPTH_ON_SCREEN : Math.max(0, Math.min(DEPTH_STOPPED, depth));
+        return context.getColor(accentTone((isNight(context) ? DARK_TONES : LIGHT_TONES)[d]));
+    }
+
+    /** The outline of a depth's mark: only Stopped has one, dashed. */
+    @ColorInt
+    public static int depthOutline(Context context, int depth) {
+        return context.getColor(depth == DEPTH_STOPPED
+                ? accentTone(isNight(context) ? 400 : 500) : android.R.color.transparent);
+    }
+
+    /** The text on a depth's color. */
+    @ColorInt
+    public static int onDepthColor(Context context, int depth) {
+        final int tone = (isNight(context) ? DARK_TONES : LIGHT_TONES)[
+                Math.max(0, Math.min(DEPTH_STOPPED, depth))];
+        return context.getColor(tone >= 500 ? android.R.color.system_accent1_10
+                : android.R.color.system_accent1_900);
+    }
+
+    /** Tones from On screen to Stopped. */
+    private static final int[] LIGHT_TONES = {800, 700, 600, 400, 300, 200};
+    private static final int[] DARK_TONES = {100, 200, 300, 500, 600, 700};
+
+    private static boolean isNight(Context context) {
+        return (context.getResources().getConfiguration().uiMode
+                & android.content.res.Configuration.UI_MODE_NIGHT_MASK)
+                == android.content.res.Configuration.UI_MODE_NIGHT_YES;
+    }
+
+    private static int accentTone(int tone) {
+        switch (tone) {
+            case 100: return android.R.color.system_accent1_100;
+            case 200: return android.R.color.system_accent1_200;
+            case 300: return android.R.color.system_accent1_300;
+            case 400: return android.R.color.system_accent1_400;
+            case 500: return android.R.color.system_accent1_500;
+            case 600: return android.R.color.system_accent1_600;
+            case 700: return android.R.color.system_accent1_700;
+            default: return android.R.color.system_accent1_800;
+        }
+    }
+
+    /** The color of who caused it: You filled, System outlined, an app dashed. */
+    @ColorInt
+    public static int whoColor(Context context, int who) {
+        switch (who) {
+            case WHO_YOU:
+                return context.getColor(android.R.color.system_accent1_500);
+            case WHO_SYSTEM:
+                return context.getColor(android.R.color.system_accent3_500);
+            default:
+                return context.getColor(android.R.color.system_accent2_500);
+        }
+    }
+
+    /** The four parts of the memory in use (BG-2, BG-12). */
+    public static final int MEMORY_SYSTEM = 0;
+    public static final int MEMORY_APPS = 1;
+    public static final int MEMORY_KEPT = 2;
+    public static final int MEMORY_FREE = 3;
+
+    /** The color of a part of the memory, the same on the Background page and in Recents. */
+    @ColorInt
+    public static int memoryColor(Context context, int part) {
+        final boolean night = isNight(context);
+        switch (part) {
+            case MEMORY_SYSTEM:
+                return context.getColor(android.R.color.system_neutral2_500);
+            case MEMORY_APPS:
+                return depthColor(context, DEPTH_RUNNING, false);
+            case MEMORY_KEPT:
+                return depthColor(context, DEPTH_PAUSED, false);
+            default:
+                return context.getColor(night ? android.R.color.system_neutral2_800
+                        : android.R.color.system_neutral2_100);
+        }
+    }
+
+    /** The name of a part of the memory. */
+    public static String memoryName(Context context, int part) {
+        switch (part) {
+            case MEMORY_SYSTEM:
+                return context.getString(R.string.lujarch_background_who_system);
+            case MEMORY_APPS:
+                return context.getString(R.string.lujarch_background_memory_apps);
+            case MEMORY_KEPT:
+                return context.getString(R.string.lujarch_background_kept);
+            default:
+                return context.getString(R.string.lujarch_background_memory_free);
+        }
+    }
+
+    /** The name of who caused it: You, System, App; another app by its own name. */
+    public static String whoName(Context context, int who) {
+        switch (who) {
+            case WHO_YOU:
+                return context.getString(R.string.lujarch_background_who_you);
+            case WHO_SYSTEM:
+                return context.getString(R.string.lujarch_background_who_system);
+            default:
+                return context.getString(R.string.lujarch_background_who_app);
+        }
+    }
+
+    /** The name of a depth. */
+    public static String depthName(Context context, int depth) {
+        switch (depth) {
+            case DEPTH_ON_SCREEN:
+                return context.getString(R.string.lujarch_background_depth_on_screen);
+            case DEPTH_RUNNING:
+                return context.getString(R.string.lujarch_background_depth_running);
+            case DEPTH_MESSAGES:
+                return context.getString(R.string.lujarch_background_depth_messages);
+            case DEPTH_PAUSED:
+                return context.getString(R.string.lujarch_background_depth_paused);
+            case DEPTH_RECLAIMED:
+                return context.getString(R.string.lujarch_background_depth_reclaimed);
+            default:
+                return context.getString(R.string.lujarch_background_depth_stopped);
+        }
+    }
+
+    /** The name of a Background usage choice. */
+    public static String usageName(Context context, int usage) {
+        switch (usage) {
+            case USAGE_UNRESTRICTED:
+                return context.getString(R.string.lujarch_background_usage_unrestricted);
+            case USAGE_MESSAGES:
+                return context.getString(R.string.lujarch_background_depth_messages);
+            case USAGE_RESTRICTED:
+                return context.getString(R.string.lujarch_background_usage_restricted);
+            default:
+                return context.getString(R.string.lujarch_background_usage_optimized);
+        }
+    }
+}
