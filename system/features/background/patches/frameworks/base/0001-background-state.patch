+    /** Reads the apps in small windows and the cards in Recents. Called on this thread. */
+    private void updateTasks() {
+        final ArrayMap<String, Integer> small = new ArrayMap<>();
+        final ArrayMap<String, Integer> recents = new ArrayMap<>();
+        final ArraySet<Integer> smallTasks;
+        synchronized (mLock) {
+            smallTasks = new ArraySet<>(mSmallWindowTasks);
+        }
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            for (ActivityManager.RunningTaskInfo t : mAm.mActivityTaskManager.getTasks(
+                    100, false, false, android.view.Display.INVALID_DISPLAY)) {
+                final String pkg = taskPackage(t);
+                if (pkg != null && smallTasks.contains(t.taskId)) {
+                    small.put(LujarchBackgroundRecord.key(t.userId, pkg), t.taskId);
+                }
+            }
+            for (int userId : mAm.mUserController.getStartedUserArray()) {
+                for (ActivityManager.RecentTaskInfo t : mAm.mActivityTaskManager.getRecentTasks(
+                        100, ActivityManager.RECENT_IGNORE_UNAVAILABLE, userId).getList()) {
+                    final String pkg = taskPackage(t);
+                    if (pkg != null) {
+                        recents.putIfAbsent(LujarchBackgroundRecord.key(t.userId, pkg), t.taskId);
+                    }
+                }
+            }
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "cannot read the tasks", e);
+            return;
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+        final ArraySet<String> gone = new ArraySet<>();
+        synchronized (mLock) {
+            for (String k : mRecents.keySet()) {
+                if (!recents.containsKey(k)) {
+                    gone.add(k);
+                }
+            }
+            mSmallWindows.clear();
+            mSmallWindows.putAll(small);
+            mRecents.clear();
+            mRecents.putAll(recents);
+        }
+        // A reclaimed app whose card was closed is no longer waiting to be opened again.
+        for (String k : gone) {
+            final String[] app = k.split(":", 2);
+            final ArrayList<String> running = new ArrayList<>();
+            for (Proc p : snapshot(Integer.parseInt(app[0]), app[1])) {
+                running.add(processShortName(p.name, p.packageName));
+            }
+            mRuns.noteGone(k, running, LujarchBackground.RUN_NONE, System.currentTimeMillis());
+        }
+    }
+
+    @Nullable
+    private static String taskPackage(android.app.TaskInfo t) {
+        if (t.baseIntent != null && t.baseIntent.getComponent() != null) {
+            return t.baseIntent.getComponent().getPackageName();
+        }
+        return t.baseActivity != null ? t.baseActivity.getPackageName() : null;
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Holds: what keeps a process running (Unrestricted, a process the owner chose, a small
+    // window) and in memory (Keep); read by OomAdjuster, ProcessList and the freezer.
+
+    /** The hold of a process as it starts; called with ActivityManager's lock held. */
+    int holdFor(ProcessRecord app) {
+        if (!mReady || app.info == null) {
+            return 0;
+        }
+        return holdOf(app.uid, app.info.packageName, app.processName, app.userId);
+    }
+
+    private int holdOf(int uid, String packageName, String processName, int userId) {
+        int hold = 0;
+        final String key = uid + ":" + packageName;
+        final String app = LujarchBackgroundRecord.key(userId, packageName);
+        synchronized (mLock) {
+            if (mKept.contains(key)) {
+                hold |= LUJARCH_HOLD_KEPT;
+            }
+            final ArraySet<String> chosen = mChosen.get(key);
+            if (mChosenOn.contains(key) && chosen != null
+                    && chosen.contains(processShortName(processName, packageName))) {
+                hold |= LUJARCH_HOLD_CHOSEN;
+            }
+            if (mSmallWindows.containsKey(app)) {
+                hold |= LUJARCH_HOLD_SMALL_WINDOW;
+            }
+        }
+        if (UserHandle.getAppId(uid) >= Process.FIRST_APPLICATION_UID
+                && Arrays.binarySearch(mAm.mDeviceIdleAllowlist, UserHandle.getAppId(uid)) >= 0) {
+            hold |= LUJARCH_HOLD_UNRESTRICTED;
+        }
+        return hold;
+    }
+
+    /**
+     * Sets the hold of every process (of one package, or all), and has ActivityManager apply the
+     * processes whose hold changed. Called on this thread.
+     */
+    private void updateHolds(@Nullable String packageName) {
+        if (!mReady) {
+            return;
+        }
+        synchronized (mAm) {
+            synchronized (mAm.mProcLock) {
+                boolean changed = false;
+                for (ProcessRecord app : mAm.mProcessList.getLruProcessesLOSP()) {
+                    if (app.info == null || app.getPid() <= 0
+                            || packageName != null && !packageName.equals(app.info.packageName)) {
+                        continue;
+                    }
+                    final int hold = holdOf(app.uid, app.info.packageName, app.processName,
+                            app.userId);
+                    if (hold != app.getLujarchHold()) {
+                        final boolean lastChanged = ((hold ^ app.getLujarchHold())
+                                & LUJARCH_HOLD_RECLAIMED_LAST) != 0;
+                        app.setLujarchHold(hold);
+                        if (lastChanged) {
+                            // lmkd learns that it is reclaimed last now, not with the next
+                            // change of adj.
+                            ProcessList.setOomAdj(app.getPid(), app.uid, app.getLmkdAdj());
+                        }
+                        mAm.mProcessStateController.enqueueUpdateTarget(app);
+                        changed = true;
+                    }
+                }
+                if (changed) {
+                    mAm.mProcessStateController.runPendingUpdate(
+                            ActivityManagerInternal.OOM_ADJ_REASON_ALLOWLIST);
+                }
+            }
+        }
+    }
+
+    /** The allowlist of Unrestricted changed; called with ActivityManager's lock held. */
+    void onAllowlistChanged() {
+        if (mReady) {
+            mHandler.post(() -> {
+                readSystemAllowlist();
+                updateHolds(null);
+                changed();
+            });
+        }
+    }
+
+    private void periodic() {
+        try {
+            markCpu();
+            changed();
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "the periodic update failed", e);
+        }
+        mHandler.postDelayed(this::periodic, PERIODIC_MS);
+    }
+
+    /** Notes each process's CPU time once an hour, for its CPU time of the last 24 hours. */
+    private void markCpu() {
+        final long hour = System.currentTimeMillis() / 3_600_000L;
+        final ArrayList<Integer> pids = new ArrayList<>();
+        for (Proc p : snapshot(UserHandle.USER_ALL, null)) {
+            pids.add(p.pid);
+        }
+        for (LujarchBackgroundProc.Service service : LujarchBackgroundProc.services()) {
+            pids.add(service.pid);
+        }
+        for (int pid : pids) {
+            synchronized (mLock) {
+                long[] marks = mCpuMarks.get(pid);
+                if (marks == null) {
+                    marks = new long[25 * 2];
+                    Arrays.fill(marks, -1);
+                    mCpuMarks.put(pid, marks);
+                }
+                final int slot = (int) (hour % 25) * 2;
+                if (marks[slot] != hour) {
+                    marks[slot] = hour;
+                    marks[slot + 1] = LujarchBackgroundProc.cpuMs(pid);
+                }
+            }
+        }
+        synchronized (mLock) {
+            for (int i = mCpuMarks.size() - 1; i >= 0; i--) {
+                if (!pids.contains(mCpuMarks.keyAt(i))) {
+                    mCpuMarks.removeAt(i);
+                }
+            }
+        }
+    }
+
+    /**
+     * CPU time today: since the first hourly mark after local midnight, or since the process
+     * started when it started today.
+     */
+    private long cpuToday(int pid, long total, long startedMillis) {
+        if (total < 0) {
+            return 0;
+        }
+        final long midnight = LujarchBackgroundRuns.dayStart(System.currentTimeMillis());
+        if (startedMillis >= midnight) {
+            return total;
+        }
+        final long firstHour = midnight / 3_600_000L;
+        synchronized (mLock) {
+            final long[] marks = mCpuMarks.get(pid);
+            long best = -1;
+            long bestHour = Long.MAX_VALUE;
+            if (marks != null) {
+                for (int i = 0; i < marks.length; i += 2) {
+                    if (marks[i] >= firstHour && marks[i] < bestHour && marks[i + 1] >= 0) {
+                        bestHour = marks[i];
+                        best = marks[i + 1];
+                    }
+                }
+            }
+            return best >= 0 ? Math.max(0, total - best) : total;
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Hooks from ActivityManager
+
+    /** A process was frozen (CachedAppOptimizer). */
+    void onFrozen(ProcessRecord app) {
+        if (mReady && app.info != null) {
+            final String pkg = app.info.packageName;
+            final int userId = app.userId;
+            mHandler.post(() -> evaluate(userId, pkg, null));
+        }
+    }
+
+    /** A process was unfrozen for a reason of CachedAppOptimizer.UNFREEZE_REASON_*. */
+    void onUnfrozen(ProcessRecord app, int reason) {
+        if (!mReady || app.info == null) {
+            return;
+        }
+        final String pkg = app.info.packageName;
+        final int userId = app.userId;
+        final int pid = app.getPid();
+        final long now = System.currentTimeMillis();
+        synchronized (mLock) {
+            ArrayList<Long> wakes = mWakes.get(pid);
+            if (wakes == null) {
+                wakes = new ArrayList<>();
+                mWakes.put(pid, wakes);
+            }
+            wakes.add(now);
+            while (!wakes.isEmpty() && now - wakes.get(0) > DAY_MS) {
+                wakes.remove(0);
+            }
+        }
+        mHandler.post(() -> evaluate(userId, pkg, new Wake(pid, reason)));
+    }
+
+    /** A process died; its end is recorded once its exit reason is final. */
+    void onProcessDied(ProcessRecord app) {
+        if (!mReady || app.info == null || app.getPid() <= 0) {
+            return;
+        }
+        final Death d = new Death();
+        d.pid = app.getPid();
+        d.uid = app.uid;
+        d.userId = app.userId;
+        d.packageName = app.info.packageName;
+        d.name = app.processName;
+        d.chosen = (app.getLujarchHold() & LUJARCH_HOLD_CHOSEN) != 0;
+        d.time = System.currentTimeMillis();
+        mHandler.postDelayed(() -> onDeath(d), EXIT_SETTLE_MS);
+    }
+
+    /**
+     * Someone asked ActivityManager to stop or kill a package; called on a binder thread, maybe
+     * with ActivityManager's lock held. Who it was is found on this service's thread.
+     */
+    void noteCaller(String packageName, int userId, int callingUid, int action) {
+        if (!mReady || packageName == null) {
+            return;
+        }
+        final long at = SystemClock.elapsedRealtime();
+        final long time = System.currentTimeMillis();
+        mHandler.post(() -> {
+            final String[] who = whoForCaller(callingUid);
+            final int w = Integer.parseInt(who[0]);
+            synchronized (mLock) {
+                mCallers.put(LujarchBackgroundRecord.key(userId, packageName),
+                        new Caller(w, who[1], action, at));
+            }
+            if (action == ACTION_FORCE_STOP) {
+                record(userId, packageName, new Event(time, LujarchBackground.EVENT_STOPPED, w,
+                        who[1], C_STOP, null));
+                mRuns.noteGone(LujarchBackgroundRecord.key(userId, packageName),
+                        new ArrayList<>(), LujarchBackground.RUN_STOPPED, time);
+                evaluate(userId, packageName, null);
+            }
+        });
+    }
+
+    /** [who, package] of a caller: the owner through the system's own pages and Recents, or the app. */
+    private String[] whoForCaller(int callingUid) {
+        if (UserHandle.getAppId(callingUid) < Process.FIRST_APPLICATION_UID) {
+            return new String[] {String.valueOf(LujarchBackground.WHO_USER), null};
+        }
+        final String[] pkgs = mContext.getPackageManager().getPackagesForUid(callingUid);
+        final String pkg = pkgs != null && pkgs.length > 0 ? pkgs[0] : null;
+        if (pkg == null || isOwnersSurface(pkg, UserHandle.getUserId(callingUid))) {
+            return new String[] {String.valueOf(LujarchBackground.WHO_USER), null};
+        }
+        return new String[] {String.valueOf(LujarchBackground.WHO_OTHER), pkg};
+    }
+
+    /** The home app, the shade and Settings act on the owner's touch. */
+    private boolean isOwnersSurface(String pkg, int userId) {
+        if (pkg.equals("com.android.systemui") || pkg.equals("com.android.settings")
+                || pkg.equals(LujarchBackground.SETTINGS_PACKAGE)) {
+            return true;
+        }
+        final android.content.ComponentName home =
+                mContext.getPackageManager().getHomeActivities(new ArrayList<>());
+        return home != null && pkg.equals(home.getPackageName());
+    }
+
+    /**
+     * ActivityManager started a process: one started for something other than an activity is a
+     * start in the background, noted with why and who asked (BG-1). Called with ActivityManager's
+     * lock held.
+     */
+    void noteStart(ApplicationInfo info, String processName, HostingRecord h) {
+        if (!mReady || info == null || h == null) {
+            return;
+        }
+        final String type = h.getType();
+        final int kind;
+        if (HostingRecord.HOSTING_TYPE_BROADCAST.equals(type)) {
+            kind = START_BROADCAST;
+        } else if (HostingRecord.HOSTING_TYPE_STARTED_SERVICE.equals(type)
+                || HostingRecord.HOSTING_TYPE_BOUND_SERVICE.equals(type)) {
+            kind = START_SERVICE;
+        } else if (HostingRecord.HOSTING_TYPE_CONTENT_PROVIDER.equals(type)) {
+            kind = START_PROVIDER;
+        } else {
+            return;
+        }
+        final int userId = UserHandle.getUserId(info.uid);
+        final String pkg = info.packageName;
+        final String trigger = h.getTriggerType();
+        final String action = h.getAction();
+        final int callerUid = h.getCallerUid();
+        int cause;
+        int who = LujarchBackground.WHO_SYSTEM;
+        String whoPackage = null;
+        if (Intent.ACTION_BOOT_COMPLETED.equals(action)
+                || Intent.ACTION_LOCKED_BOOT_COMPLETED.equals(action)) {
+            cause = C_START_BOOT;
+        } else if (HostingRecord.TRIGGER_TYPE_ALARM.equals(trigger)) {
+            cause = C_START_ALARM;
+            who = LujarchBackground.WHO_APP;
+        } else if (HostingRecord.TRIGGER_TYPE_PUSH_MESSAGE.equals(trigger)
+                || HostingRecord.TRIGGER_TYPE_PUSH_MESSAGE_OVER_QUOTA.equals(trigger)) {
+            cause = C_START_PUSH;
+        } else {
+            cause = kind == START_SERVICE ? C_START_SERVICE
+                    : kind == START_PROVIDER ? C_START_PROVIDER : C_START_BROADCAST;
+            if (callerUid >= 0
+                    && UserHandle.getAppId(callerUid) >= Process.FIRST_APPLICATION_UID) {
+                if (UserHandle.getAppId(callerUid) == UserHandle.getAppId(info.uid)) {
+                    who = LujarchBackground.WHO_APP;
+                } else {
+                    who = LujarchBackground.WHO_OTHER;
+                }
+            }
+        }
+        final Event e = new Event(System.currentTimeMillis(), LujarchBackground.EVENT_STARTED,
+                who, whoPackage, cause, kind == START_BROADCAST && action != null
+                        ? shortAction(action) : null);
+        mHandler.post(() -> {
+            if (e.who == LujarchBackground.WHO_OTHER) {
+                // The other app, found off ActivityManager's lock.
+                final String[] pkgs = mContext.getPackageManager().getPackagesForUid(callerUid);
+                e.whoPackage = pkgs != null && pkgs.length > 0 ? pkgs[0] : null;
+                if (e.whoPackage == null) {
+                    e.who = LujarchBackground.WHO_SYSTEM;
+                }
+            }
+            final Track t = track(userId, pkg);
+            if (!t.onScreen) {
+                record(userId, pkg, e);
+            }
+        });
+    }
+
+    private static String shortAction(String action) {
+        final int dot = action.lastIndexOf('.');
+        return dot >= 0 && dot + 1 < action.length() ? action.substring(dot + 1) : action;
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The record: an app's changes of run state become its lines.
+
+    private static final class Wake {
+        final int pid;
+        final int reason;
+
+        Wake(int pid, int reason) {
+            this.pid = pid;
+            this.reason = reason;
+        }
+    }
+
+    private static final class Death {
+        int pid;
+        int uid;
+        int userId;
+        String packageName;
+        String name;
+        boolean chosen;
+        long time;
+    }
+
+    private void evaluateUid(int uid) {
+        final String[] pkgs = mContext.getPackageManager().getPackagesForUid(uid);
+        if (pkgs != null) {
+            for (String p : pkgs) {
+                evaluate(UserHandle.getUserId(uid), p, null);
+            }
+        }
+        changed();
+    }
+
+    private Track track(int userId, String pkg) {
+        final String key = LujarchBackgroundRecord.key(userId, pkg);
+        synchronized (mLock) {
+            Track t = mTracks.get(key);
+            if (t == null) {
+                t = new Track();
+                mTracks.put(key, t);
+            }
+            return t;
+        }
+    }
+
+    /**
+     * Compares the app's state with its last, records the change and notes each process's line.
+     * Called on this thread.
+     */
+    private void evaluate(int userId, String pkg, @Nullable Wake wake) {
+        if (pkg == null) {
+            return;
+        }
+        final List<Proc> procs = snapshot(userId, pkg);
+        final Track t = track(userId, pkg);
+        final AppState now = appState(procs);
+        final long time = System.currentTimeMillis();
+        noteRuns(userId, pkg, procs, time);
+        final int before = t.state;
+        final int track = now.chosenOnly ? TRACK_CHOSEN : now.state;
+        if (track != before) {
+            if (onScreen(now.state) && !onScreen(before)) {
+                final int cause = before == LujarchBackground.RUN_PAUSED
+                        || before == TRACK_CHOSEN ? C_OPENED_AS_WAS
+                        : before == LujarchBackground.RUN_RECLAIMED
+                        || before == LujarchBackground.RUN_STOPPED || before < 0
+                        ? C_OPENED_AGAIN : C_OPENED;
+                record(userId, pkg, new Event(time, LujarchBackground.EVENT_OPENED,
+                        LujarchBackground.WHO_USER, null, cause, null));
+            } else if (onScreen(before) && !onScreen(now.state)) {
+                record(userId, pkg, new Event(time, LujarchBackground.EVENT_LEFT,
+                        LujarchBackground.WHO_USER, null, C_LEFT, null));
+            }
+            if ((now.state == LujarchBackground.RUN_PAUSED || track == TRACK_CHOSEN)
+                    && before >= LujarchBackground.RUN_FOREGROUND
+                    && before <= LujarchBackground.RUN_BACKGROUND) {
+                mRecord.endWake(userId, pkg, time);
+                final Event e = new Event(time, LujarchBackground.EVENT_PAUSED,
+                        LujarchBackground.WHO_SYSTEM, null,
+                        track == TRACK_CHOSEN ? C_PAUSED_CHOSEN : C_PAUSED, now.chosenNames);
+                if (!wasJustWoken(userId, pkg, time)) {
+                    record(userId, pkg, e);
+                }
+            } else if (track == LujarchBackground.RUN_BACKGROUND
+                    && (before == LujarchBackground.RUN_PAUSED || before == TRACK_CHOSEN)) {
+                record(userId, pkg, wakeEvent(procs, wake, time));
+            }
+            t.state = track;
+            t.since = time;
+        }
+        t.onScreen = onScreen(now.state);
+    }
+
+    /** Each process's state from now on, in its line (BG-1). */
+    private void noteRuns(int userId, String pkg, List<Proc> procs, long time) {
+        final String app = LujarchBackgroundRecord.key(userId, pkg);
+        final ArrayList<String> running = new ArrayList<>();
+        for (Proc p : procs) {
+            if (p.system) {
+                continue;
+            }
+            final String name = processShortName(p.name, p.packageName);
+            running.add(name);
+            mRuns.note(app, name, (byte) procState(p).state, time);
+        }
+        if (procs.isEmpty()) {
+            return;
+        }
+        // A process of the app that is gone and not reclaimed by a death we heard of.
+        mRuns.noteGone(app, running, LujarchBackground.RUN_RECLAIMED, time);
+    }
+
+    /** A wake that pauses again within seconds counts on its own line, with its length. */
+    private boolean wasJustWoken(int userId, String pkg, long now) {
+        final Event last = mRecord.latest(userId, pkg, LujarchBackground.EVENT_WOKEN,
+                LujarchBackground.EVENT_PAUSED, LujarchBackground.EVENT_LEFT,
+                LujarchBackground.EVENT_OPENED);
+        return last != null && last.kind == LujarchBackground.EVENT_WOKEN
+                && now - last.time < 60_000;
+    }
+
+    private Event wakeEvent(List<Proc> procs, @Nullable Wake wake, long time) {
+        Proc woken = null;
+        for (Proc p : procs) {
+            if (wake != null && p.pid == wake.pid || woken == null && !p.frozen) {
+                woken = p;
+            }
+        }
+        int who = LujarchBackground.WHO_SYSTEM;
+        String whoPackage = null;
+        int cause = C_WOKEN_SYSTEM;
+        String detail = null;
+        if (woken != null) {
+            if (woken.sourcePackage != null && woken.sourceUid >= 0) {
+                if (UserHandle.getAppId(woken.sourceUid) == UserHandle.getAppId(woken.uid)) {
+                    who = LujarchBackground.WHO_APP;
+                    cause = C_WOKEN_OWN;
+                    detail = processShortName(woken.sourceName, woken.packageName);
+                } else if (UserHandle.getAppId(woken.sourceUid) >= Process.FIRST_APPLICATION_UID) {
+                    who = LujarchBackground.WHO_OTHER;
+                    whoPackage = woken.sourcePackage;
+                    cause = C_WOKEN_BY;
+                }
+            }
+            if (cause == C_WOKEN_SYSTEM) {
+                if (woken.tempAllowed) {
+                    cause = C_WOKEN_PUSH;
+                } else if (woken.receiving) {
+                    cause = C_WOKEN_BROADCAST;
+                } else if (woken.executing || woken.startedService) {
+                    cause = C_WOKEN_SERVICE;
+                    who = LujarchBackground.WHO_APP;
+                }
+            }
+        }
+        if (wake != null && cause == C_WOKEN_SYSTEM) {
+            switch (wake.reason) {
+                case CachedAppOptimizer.UNFREEZE_REASON_START_RECEIVER:
+                case CachedAppOptimizer.UNFREEZE_REASON_FINISH_RECEIVER:
+                    cause = C_WOKEN_BROADCAST;
+                    break;
+                case CachedAppOptimizer.UNFREEZE_REASON_BIND_SERVICE:
+                case CachedAppOptimizer.UNFREEZE_REASON_START_SERVICE:
+                case CachedAppOptimizer.UNFREEZE_REASON_EXECUTING_SERVICE:
+                    cause = C_WOKEN_SERVICE;
+                    break;
+                case CachedAppOptimizer.UNFREEZE_REASON_GET_PROVIDER:
+                    cause = C_WOKEN_PROVIDER;
+                    break;
+                case CachedAppOptimizer.UNFREEZE_REASON_BINDER_TXNS:
+                    cause = C_WOKEN_CALL;
+                    break;
+                case CachedAppOptimizer.UNFREEZE_REASON_ALLOWLIST:
+                    cause = C_WOKEN_PUSH;
+                    break;
+                default:
+                    break;
+            }
+        }
+        return new Event(time, LujarchBackground.EVENT_WOKEN, who, whoPackage, cause, detail);
+    }
+
+    private void onDeath(Death d) {
+        final ArrayList<ApplicationExitInfo> infos = new ArrayList<>();
+        try {
+            mAm.mProcessList.mAppExitInfoTracker.getExitInfo(d.packageName, d.uid, d.pid, 1,
+                    infos);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "no exit info for " + d.name + " (" + d.pid + ")", e);
+        }
+        final ApplicationExitInfo info = infos.isEmpty() ? null : infos.get(0);
+        final String key = LujarchBackgroundRecord.key(d.userId, d.packageName);
+        final Caller caller;
+        synchronized (mLock) {
+            final Caller c = mCallers.get(key);
+            caller = c != null && SystemClock.elapsedRealtime() - c.at < 10_000 ? c : null;
+            mWakes.remove(d.pid);
+            mCpuMarks.remove(d.pid);
+        }
+        final int[] whoCause = endCause(info, caller, d.uid, d.packageName);
+        final List<Proc> left = snapshot(d.userId, d.packageName);
+        final Track t = track(d.userId, d.packageName);
+        final String name = processShortName(d.name, d.packageName);
+        final ArrayList<String> running = new ArrayList<>();
+        for (Proc p : left) {
+            running.add(processShortName(p.name, p.packageName));
+        }
+        final boolean card;
+        synchronized (mLock) {
+            card = mRecents.containsKey(key);
+        }
+        mRuns.noteGone(key, running, whoCause[1] == C_STOP ? LujarchBackground.RUN_STOPPED
+                : card ? LujarchBackground.RUN_RECLAIMED : LujarchBackground.RUN_NONE, d.time);
+        noteForSuggestion(d, name, whoCause);
+        if (whoCause[1] == C_STOP) {
+            // The stop has its line already.
+            t.state = left.isEmpty() ? LujarchBackground.RUN_STOPPED : t.state;
+            changed();
+            return;
+        }
+        final Event e = new Event(d.time, LujarchBackground.EVENT_ENDED, whoCause[0],
+                caller != null && caller.who == LujarchBackground.WHO_OTHER ? caller.whoPackage
+                        : null, whoCause[1], name);
+        record(d.userId, d.packageName, e);
+        if (left.isEmpty()) {
+            t.state = LujarchBackground.RUN_RECLAIMED;
+            t.since = d.time;
+            t.onScreen = false;
+        }
+        changed();
+    }
+
+    /**
+     * A choice broke (BG-3): the main process of an app at Chosen processes was ended while
+     * paused LOOP_COUNT times within LOOP_MS, or a chosen process ended right after the main
+     * one without the system ending it. Suggested once a day for each cause.
+     */
+    private void noteForSuggestion(Death d, String name, int[] whoCause) {
+        if (usageOf(d.uid, d.packageName) != LujarchBackground.USAGE_CHOSEN) {
+            return;
+        }
+        final String key = d.uid + ":" + d.packageName;
+        final boolean main = !name.startsWith(":");
+        final ArraySet<String> chosen = chosenOf(d.uid, d.packageName);
+        Suggestion found = null;
+        synchronized (mLock) {
+            if (main) {
+                mMainEnded.put(key, d.time);
+                if (whoCause[1] == C_END_FREEZER && !chosen.contains(name)) {
+                    ArrayList<Long> loops = mLoops.get(key);
+                    if (loops == null) {
+                        loops = new ArrayList<>();
+                        mLoops.put(key, loops);
+                    }
+                    loops.add(d.time);
+                    while (!loops.isEmpty() && d.time - loops.get(0) > LOOP_MS) {
+                        loops.remove(0);
+                    }
+                    if (loops.size() >= LOOP_COUNT) {
+                        found = new Suggestion();
+                        found.kind = LujarchBackground.SUGGEST_LOOP;
+                        found.count = loops.size();
+                        found.from = loops.get(0);
+                        found.to = d.time;
+                        found.mainName = name;
+                    }
+                }
+            } else if (d.chosen && whoCause[0] != LujarchBackground.WHO_SYSTEM) {
+                final Long mainEnded = mMainEnded.get(key);
+                if (mainEnded != null && d.time - mainEnded <= LEFT_WITH_MAIN_MS
+                        && !chosen.contains(d.packageName)) {
+                    found = new Suggestion();
+                    found.kind = LujarchBackground.SUGGEST_LEFT_WITH_MAIN;
+                    found.count = 1;
+                    found.from = mainEnded;
+                    found.to = d.time;
+                    found.mainName = d.packageName;
+                    found.chosenName = name;
+                    found.gapMs = d.time - mainEnded;
+                }
+            }
+            if (found == null) {
+                return;
+            }
+            final String once = key + ":" + found.kind;
+            final long today = LujarchBackgroundRuns.dayStart(d.time);
+            final Long last = mSuggestedDay.get(once);
+            final Suggestion waiting = mSuggestions.get(key);
+            if (last != null && last == today) {
+                // Already suggested today: the waiting one only learns the new count.
+                if (waiting != null && waiting.kind == found.kind) {
+                    waiting.count = Math.max(waiting.count, found.count);
+                    waiting.to = found.to;
+                }
+                return;
+            }
+            mSuggestedDay.put(once, today);
+            mSuggestions.put(key, found);
+            if (found.kind == LujarchBackground.SUGGEST_LOOP) {
+                mLoops.remove(key);
+            }
+        }
+        Slog.i(TAG, "suggestion for " + d.packageName + ": kind " + found.kind + ", "
+                + found.count + " times");
+        if (mNotices != null) {
+            mNotices.alertSuggestion(d.uid, d.packageName, suggestion(found, d.packageName,
+                    d.userId));
+        }
+    }
