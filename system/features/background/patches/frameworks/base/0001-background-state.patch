+    private void record(int userId, String pkg, Event e) {
+        mRecord.add(userId, pkg, e);
+        scheduleSave();
+    }
+
+    private void scheduleSave() {
+        if (!mHandler.hasCallbacks(mSave)) {
+            mHandler.postDelayed(mSave, SAVE_DELAY_MS);
+        }
+    }
+
+    private final Runnable mSave = this::saveRecord;
+
+    private void saveRecord() {
+        mRecord.save();
+        mRuns.save();
+    }
+
+    /** Something an app's state depends on changed: the listeners of the Running list follow. */
+    private void changed() {
+        if (!mHandler.hasCallbacks(mTellRunning)) {
+            mHandler.postDelayed(mTellRunning, RUNNING_DELAY_MS);
+        }
+    }
+
+    private final Runnable mTellRunning = this::tellRunning;
+
+    /** Tells the listeners what Recents' Running layer shows, when that changed. */
+    private void tellRunning() {
+        if (!mReady) {
+            return;
+        }
+        final ArraySet<String> keys = runningKeys();
+        final boolean unseen;
+        synchronized (mLock) {
+            boolean news = false;
+            for (String k : keys) {
+                if (!mRunningSeen.contains(k)) {
+                    news = true;
+                    break;
+                }
+            }
+            // What stopped running is no longer seen: it is new when it starts again.
+            mRunningSeen.retainAll(keys);
+            unseen = news;
+            if (keys.size() == mRunningCount && unseen == mRunningUnseen) {
+                return;
+            }
+            mRunningCount = keys.size();
+            mRunningUnseen = unseen;
+        }
+        final int n = mListeners.beginBroadcast();
+        try {
+            for (int i = 0; i < n; i++) {
+                try {
+                    mListeners.getBroadcastItem(i).onRunningChanged(keys.size(), unseen);
+                } catch (RemoteException e) {
+                    // The callback list drops a listener that died.
+                }
+            }
+        } finally {
+            mListeners.finishBroadcast();
+        }
+    }
+
+    /**
+     * What Recents' Running layer shows, as "userId:package", from the processes alone: what an
+     * app runs itself, a small window, Unrestricted and chosen processes running off screen.
+     */
+    private ArraySet<String> runningKeys() {
+        final ArrayMap<String, ArrayList<Proc>> byApp = new ArrayMap<>();
+        for (Proc p : snapshot(UserHandle.USER_ALL, null)) {
+            if (!p.system && !p.home) {
+                byApp.computeIfAbsent(LujarchBackgroundRecord.key(p.userId, p.packageName),
+                        k -> new ArrayList<>()).add(p);
+            }
+        }
+        final ArraySet<String> out = new ArraySet<>();
+        for (int i = 0; i < byApp.size(); i++) {
+            if (runKind(appState(byApp.valueAt(i))) >= 0) {
+                out.add(byApp.keyAt(i));
+            }
+        }
+        synchronized (mLock) {
+            out.addAll(mSmallWindows.keySet());
+        }
+        return out;
+    }
+
+    /**
+     * Where an app goes in Recents' Running layer: 0 for what it runs itself, 1 for a small
+     * window, 2 for Unrestricted, 3 for chosen processes; -1 when it does not run off screen.
+     */
+    private static int runKind(AppState s) {
+        if (s.lead == null || s.state != LujarchBackground.RUN_BACKGROUND
+                && s.state != LujarchBackground.RUN_SMALL_WINDOW) {
+            return -1;
+        }
+        switch (s.lead.cause) {
+            case C_FGS:
+                return 0;
+            case C_SMALL_WINDOW:
+                return 1;
+            case C_UNRESTRICTED:
+                return 2;
+            case C_CHOSEN:
+                return 3;
+            default:
+                return s.ownService ? 0 : -1;
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // State: the run state of every app and process
+
+    /** The processes of one app (or all, with a null package), copied under ActivityManager's locks. */
+    ArrayList<Proc> snapshot(int userId, @Nullable String packageName) {
+        final ArrayList<Proc> out = new ArrayList<>();
+        synchronized (mAm) {
+            synchronized (mAm.mProcLock) {
+                for (ProcessRecord app : mAm.mProcessList.getLruProcessesLOSP()) {
+                    if (app.info == null || app.getPid() <= 0 || app.isKilled()
+                            || app.isKilledByAm()) {
+                        continue;
+                    }
+                    if (userId != UserHandle.USER_ALL && app.userId != userId
+                            || packageName != null && !packageName.equals(app.info.packageName)) {
+                        continue;
+                    }
+                    out.add(copy(app));
+                }
+            }
+        }
+        return out;
+    }
+
+    private Proc copy(ProcessRecord app) {
+        final Proc p = new Proc();
+        p.pid = app.getPid();
+        p.uid = app.uid;
+        p.userId = app.userId;
+        p.name = app.processName;
+        p.packageName = app.info.packageName;
+        p.frozen = app.mOptRecord.isFrozen();
+        p.pendingFreeze = app.mOptRecord.isPendingFreeze();
+        p.persistent = app.isPersistent();
+        p.system = p.persistent || UserHandle.getAppId(app.info.uid) < Process.FIRST_APPLICATION_UID;
+        p.home = app.getWindowProcessController().isHomeProcess();
+        p.procState = app.getProcState();
+        // Persistent processes rank above the top app without being on screen.
+        p.top = p.procState == PROCESS_STATE_TOP || p.procState == PROCESS_STATE_TOP_SLEEPING;
+        p.visible = app.getHasVisibleActivities();
+        p.fgs = app.mServices.hasForegroundServices();
+        p.fgsTypes = app.mServices.getForegroundServiceTypes();
+        p.receiving = app.mReceivers.isReceivingBroadcast();
+        p.executing = app.mServices.hasExecutingServices();
+        p.startedService = app.getHasStartedServices();
+        p.tempAllowed = app.getUidRecord() != null && app.getUidRecord().isCurAllowListed();
+        p.cpuTime = (app.getCurCapability() & PROCESS_CAPABILITY_CPU_TIME) != 0;
+        p.adj = app.getCurAdj();
+        p.adjType = app.getAdjType();
+        p.hold = app.getLujarchHold();
+        p.starting = app.isPendingFinishAttach() || app.getThread() == null;
+        p.startElapsed = app.getStartElapsedTime();
+        final Object source = app.getAdjSource();
+        if (source instanceof ProcessRecord) {
+            final ProcessRecord s = (ProcessRecord) source;
+            if (s.info != null && s != app) {
+                p.sourcePackage = s.info.packageName;
+                p.sourceUid = s.uid;
+                p.sourceName = s.processName;
+            }
+        }
+        return p;
+    }
+
+    /** One process's run state, who and why. */
+    static final class ProcState {
+        int state;
+        int who;
+        String whoPackage;
+        int cause;
+        String detail;
+    }
+
+    ProcState procState(Proc p) {
+        final ProcState s = new ProcState();
+        s.who = LujarchBackground.WHO_SYSTEM;
+        if (p.home) {
+            s.state = LujarchBackground.RUN_BACKGROUND;
+            s.cause = C_HOME;
+            return s;
+        }
+        if ((p.hold & LUJARCH_HOLD_SMALL_WINDOW) != 0 && !p.frozen) {
+            s.state = LujarchBackground.RUN_SMALL_WINDOW;
+            s.who = LujarchBackground.WHO_USER;
+            s.cause = C_SMALL_WINDOW;
+            return s;
+        }
+        if (p.top || p.visible) {
+            s.state = LujarchBackground.RUN_FOREGROUND;
+            s.who = LujarchBackground.WHO_USER;
+            s.cause = C_ON_SCREEN;
+            return s;
+        }
+        if (p.frozen) {
+            s.state = LujarchBackground.RUN_PAUSED;
+            if ((p.hold & LUJARCH_HOLD_KEPT) != 0) {
+                s.who = LujarchBackground.WHO_USER;
+                s.cause = C_KEPT;
+            } else {
+                s.cause = C_PAUSED;
+            }
+            return s;
+        }
+        s.state = LujarchBackground.RUN_BACKGROUND;
+        if ((p.hold & LUJARCH_HOLD_CHOSEN) != 0) {
+            s.who = LujarchBackground.WHO_USER;
+            s.cause = C_CHOSEN;
+        } else if (p.fgs) {
+            s.who = LujarchBackground.WHO_APP;
+            s.cause = C_FGS;
+            s.detail = String.valueOf(p.fgsTypes);
+        } else if (p.system) {
+            s.cause = C_SYSTEM;
+        } else if (p.starting) {
+            s.cause = C_STARTING;
+        } else if (p.tempAllowed) {
+            s.cause = C_PUSH;
+        } else if (p.receiving) {
+            s.cause = C_BROADCAST;
+        } else if (p.sourcePackage != null && p.sourceUid >= 0 && p.cpuTime) {
+            if (UserHandle.getAppId(p.sourceUid) == UserHandle.getAppId(p.uid)) {
+                s.who = LujarchBackground.WHO_APP;
+                s.cause = C_USED_BY_OWN;
+                s.detail = processShortName(p.sourceName, p.packageName);
+            } else if (UserHandle.getAppId(p.sourceUid) >= Process.FIRST_APPLICATION_UID) {
+                s.who = LujarchBackground.WHO_OTHER;
+                s.whoPackage = p.sourcePackage;
+                s.cause = C_USED_BY;
+            } else {
+                s.cause = C_USED_BY;
+                s.whoPackage = "android";
+            }
+        } else if ((p.hold & LUJARCH_HOLD_UNRESTRICTED) != 0) {
+            s.who = isSystemAllowlisted(p.packageName) ? LujarchBackground.WHO_SYSTEM
+                    : LujarchBackground.WHO_USER;
+            s.cause = C_UNRESTRICTED;
+        } else if (p.executing) {
+            s.who = LujarchBackground.WHO_APP;
+            s.cause = C_SERVICE;
+        } else if (p.pendingFreeze) {
+            s.cause = C_PAUSING;
+        } else if (!p.cpuTime) {
+            s.cause = C_NOT_NEEDED;
+        } else {
+            s.who = LujarchBackground.WHO_APP;
+            s.cause = C_RUNNING;
+        }
+        return s;
+    }
+
+    /** An app's state from its processes. */
+    final class AppState {
+        int state = LujarchBackground.RUN_RECLAIMED;
+        ProcState lead;
+        Proc leadProc;
+        int running;
+        /** Chosen processes running, by short name, joined with the list separator. */
+        int chosenRunning;
+        String chosenNames;
+        /** Only chosen processes run off screen; the rest is paused. */
+        boolean chosenOnly;
+        boolean ownService;
+    }
+
+    AppState appState(List<Proc> procs) {
+        final AppState a = new AppState();
+        boolean othersRun = false;
+        final ArrayList<String> chosen = new ArrayList<>();
+        for (Proc p : procs) {
+            final ProcState s = procState(p);
+            if (!p.frozen) {
+                a.running++;
+            }
+            if (s.cause == C_CHOSEN) {
+                a.chosenRunning++;
+                chosen.add(processShortName(p.name, p.packageName));
+            } else if (!p.frozen) {
+                othersRun = true;
+            }
+            if (p.fgs) {
+                a.ownService = true;
+            }
+            if (a.lead == null || s.state < a.state
+                    || s.state == a.state && priority(s.cause) > priority(a.lead.cause)) {
+                a.state = s.state;
+                a.lead = s;
+                a.leadProc = p;
+            }
+        }
+        a.chosenOnly = a.chosenRunning > 0 && !othersRun && procs.size() > a.chosenRunning;
+        if (!chosen.isEmpty()) {
+            a.chosenNames = String.join(
+                    mContext.getString(R.string.lujarch_background_list_separator), chosen);
+        }
+        return a;
+    }
+
+    /** Which reason speaks for an app when its processes are in one state. */
+    private static int priority(int cause) {
+        switch (cause) {
+            case C_SMALL_WINDOW:
+                return 9;
+            case C_FGS:
+                return 8;
+            case C_CHOSEN:
+                return 7;
+            case C_UNRESTRICTED:
+                return 6;
+            case C_KEPT:
+                return 5;
+            case C_USED_BY:
+                return 4;
+            default:
+                return 0;
+        }
+    }
+
+    /** ":push" for "com.app:push"; the full name for the main process and other packages'. */
+    static String processShortName(@Nullable String name, String packageName) {
+        if (name == null) {
+            return packageName;
+        }
+        return name.startsWith(packageName + ":") ? name.substring(packageName.length()) : name;
+    }
+
+    /** Every app of the user with a process, a card in Recents or a recent end. */
+    private ArrayList<LujarchBackgroundApp> apps(int userId, boolean withSystem, boolean detail,
+            @Nullable String only) {
+        final ArrayList<Proc> procs = snapshot(userId, only);
+        final ArrayMap<String, ArrayList<Proc>> byApp = new ArrayMap<>();
+        final ArraySet<Integer> pids = new ArraySet<>();
+        for (Proc p : procs) {
+            pids.add(p.pid);
+            byApp.computeIfAbsent(p.packageName, k -> new ArrayList<>()).add(p);
+        }
+        if (only == null) {
+            mProc.retain(pids);
+        }
+        final ArrayMap<String, Integer> recents;
+        final ArrayMap<String, Integer> small;
+        synchronized (mLock) {
+            recents = new ArrayMap<>(mRecents);
+            small = new ArrayMap<>(mSmallWindows);
+        }
+        final ArraySet<String> packages = new ArraySet<>(byApp.keySet());
+        final String prefix = userId + ":";
+        if (only == null) {
+            for (String k : recents.keySet()) {
+                if (k.startsWith(prefix)) {
+                    packages.add(k.substring(prefix.length()));
+                }
+            }
+            final long since = System.currentTimeMillis() - RECENT_END_MS;
+            for (String k : mRecord.apps()) {
+                if (!k.startsWith(prefix)) {
+                    continue;
+                }
+                final String pkg = k.substring(prefix.length());
+                final Event last = mRecord.latest(userId, pkg, LujarchBackground.EVENT_ENDED,
+                        LujarchBackground.EVENT_STOPPED);
+                if (last != null && last.time >= since) {
+                    packages.add(pkg);
+                }
+            }
+        } else {
+            packages.add(only);
+        }
+        final PackageManager pm = mContext.getPackageManager();
+        final ArrayMap<Integer, Integer> order = reclaimOrder(procs);
+        final ArrayList<LujarchBackgroundApp> out = new ArrayList<>();
+        for (String pkg : packages) {
+            final ApplicationInfo info;
+            try {
+                info = pm.getApplicationInfoAsUser(pkg, PackageManager.MATCH_UNINSTALLED_PACKAGES,
+                        userId);
+            } catch (PackageManager.NameNotFoundException e) {
+                continue;
+            }
+            final ArrayList<Proc> own = byApp.getOrDefault(pkg, new ArrayList<>());
+            final boolean system = (info.flags & ApplicationInfo.FLAG_PERSISTENT) != 0
+                    || UserHandle.getAppId(info.uid) < Process.FIRST_APPLICATION_UID
+                    || own.stream().anyMatch(p -> p.system)
+                    || isSystemsOwn(info, userId);
+            if (system && !withSystem && only == null) {
+                continue;
+            }
+            final String key = LujarchBackgroundRecord.key(userId, pkg);
+            final LujarchBackgroundApp app = describe(info, own, recents.get(key), small.get(key),
+                    detail);
+            if (app != null) {
+                app.system = system;
+                for (Proc p : own) {
+                    final Integer place = order.get(p.pid);
+                    if (place != null && (app.reclaimOrder == 0 || place < app.reclaimOrder)) {
+                        app.reclaimOrder = place;
+                    }
+                }
+                if (app.processes != null) {
+                    for (LujarchBackgroundProcess p : app.processes) {
+                        final Integer place = order.get(p.pid);
+                        p.reclaimOrder = place != null ? place : 0;
+                    }
+                }
+                out.add(app);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * The order the paused app processes are reclaimed in when memory runs low, from 1: lmkd
+     * ends the highest score first and, among equal scores, the largest.
+     */
+    private ArrayMap<Integer, Integer> reclaimOrder(List<Proc> procs) {
+        final ArrayList<Proc> paused = new ArrayList<>();
+        for (Proc p : procs) {
+            if (!p.system && p.frozen && p.adj >= CACHED_APP_MIN_ADJ
+                    && (p.hold & LUJARCH_HOLD_KEPT) == 0) {
+                paused.add(p);
+            }
+        }
+        final ArrayMap<Integer, Long> size = new ArrayMap<>();
+        for (Proc p : paused) {
+            size.put(p.pid, mProc.memory(p.pid, true)[0]);
+        }
+        paused.sort((a, b) -> a.adj != b.adj ? Integer.compare(b.adj, a.adj)
+                : Long.compare(size.get(b.pid), size.get(a.pid)));
+        final ArrayMap<Integer, Integer> out = new ArrayMap<>();
+        for (int i = 0; i < paused.size(); i++) {
+            out.put(paused.get(i).pid, i + 1);
+        }
+        return out;
+    }
+
+    @Nullable
+    private LujarchBackgroundApp describe(ApplicationInfo info, List<Proc> procs,
+            @Nullable Integer recentTask, @Nullable Integer smallTask, boolean detail) {
+        final LujarchBackgroundApp a = new LujarchBackgroundApp();
+        final int userId = UserHandle.getUserId(info.uid);
+        a.packageName = info.packageName;
+        a.uid = info.uid;
+        a.label = label(info.packageName, userId);
+        a.kept = isKept(info.uid, info.packageName);
+        a.usage = usageOf(info.uid, info.packageName);
+        a.usageFixed = isSystemAllowlisted(info.packageName);
+        synchronized (mLock) {
+            a.suggestion = mSuggestions.containsKey(info.uid + ":" + info.packageName);
+        }
+        a.hasTask = recentTask != null;
+        a.smallWindow = smallTask != null;
+        a.taskId = smallTask != null ? smallTask : recentTask != null ? recentTask : -1;
+        a.processCount = procs.size();
+        final Track t = track(userId, info.packageName);
+        final Words w = new Words();
+        if (procs.isEmpty()) {
+            final boolean stopped = (info.flags & ApplicationInfo.FLAG_STOPPED) != 0;
+            final Event last = mRecord.latest(userId, info.packageName,
+                    LujarchBackground.EVENT_ENDED, LujarchBackground.EVENT_STOPPED);
+            if (stopped && last != null && last.kind == LujarchBackground.EVENT_STOPPED) {
+                a.state = LujarchBackground.RUN_STOPPED;
+            } else if (stopped && last == null && recentTask == null) {
+                return null;
+            } else {
+                a.state = LujarchBackground.RUN_RECLAIMED;
+            }
+            if (last != null) {
+                a.who = last.who;
+                a.whoName = w.who(last.who, last.whoPackage, userId);
+                a.reason = w.since(w.endReason(last.cause, last.whoPackage, userId), last.time);
+                a.sinceMillis = last.time;
+            } else {
+                a.who = LujarchBackground.WHO_SYSTEM;
+                a.whoName = w.who(a.who, null, userId);
+                a.reason = w.text(C_END_BOOT, null, null, userId);
+            }
+        } else {
+            final AppState s = appState(procs);
+            a.state = s.state;
+            a.who = s.lead.who;
+            a.whoName = w.who(s.lead.who, s.lead.whoPackage, userId);
+            a.reason = s.chosenOnly
+                    ? w.chosen(s.chosenNames, procs.size() - s.chosenRunning)
+                    : w.text(s.lead.cause, s.lead.detail, s.lead.whoPackage, userId);
+            if (s.state == LujarchBackground.RUN_PAUSED && a.kept) {
+                a.who = LujarchBackground.WHO_USER;
+                a.whoName = w.who(a.who, null, userId);
+                a.reason = w.text(C_KEPT, null, null, userId);
+            }
+            a.ownService = s.ownService;
+            a.settling = s.state == LujarchBackground.RUN_BACKGROUND
+                    && (s.lead.cause == C_PAUSING || s.lead.cause == C_NOT_NEEDED
+                    || s.lead.cause == C_STARTING);
+            a.runningCount = s.running;
+            a.sinceMillis = t.state == (s.chosenOnly ? TRACK_CHOSEN : s.state) ? t.since : 0;
+            long mem = 0;
+            long swap = 0;
+            for (Proc p : procs) {
+                final long[] m = mProc.memory(p.pid, p.frozen);
+                mem += m[0] * 1024;
+                swap += m[1] * 1024;
+            }
+            a.memoryBytes = mem;
+            a.swapBytes = swap;
+        }
+        a.word = w.word(a, procs, procs.isEmpty() ? null : appState(procs));
+        final long dayAgo = System.currentTimeMillis() - DAY_MS;
+        final List<Event> day = mRecord.since(userId, info.packageName, dayAgo);
+        a.wakeups = 0;
+        for (Event e : day) {
+            if (e.kind == LujarchBackground.EVENT_WOKEN) {
+                a.wakeups += e.count;
+            }
+        }
+        a.backgroundMs = backgroundTime(day, a, dayAgo);
+        if (mUsage != null) {
+            final double[] battery = mUsage.offScreen(info.uid);
+            a.batteryMah = battery[0];
+            a.batteryPercent = battery[1];
+        }
+        if (detail) {
+            final ArraySet<Integer> uids = new ArraySet<>();
+            for (Proc p : procs) {
+                uids.add(p.uid);
+            }
+            final SparseArray<ArraySet<String>> sockets = procs.isEmpty() ? new SparseArray<>()
+                    : mProc.connections(uids);
+            final ArrayList<LujarchBackgroundProcess> list = new ArrayList<>();
+            final ArraySet<String> connected = new ArraySet<>();
+            for (Proc p : procs) {
+                final LujarchBackgroundProcess out = process(p, false);
+                final ArraySet<String> own = sockets.get(p.uid);
+                out.connected = own != null && mProc.holds(p.pid, own);
+                if (out.connected) {
+                    connected.add(processShortName(p.name, p.packageName));
+                }
+                list.add(out);
+            }
+            a.processes = list.toArray(new LujarchBackgroundProcess[0]);
+            final ArraySet<String> names = declaredProcesses(info);
+            for (Proc p : procs) {
+                names.add(processShortName(p.name, p.packageName));
+            }
+            final ArrayList<String> sorted = new ArrayList<>(names);
+            sorted.sort((x, y) -> {
+                final boolean xm = !x.startsWith(":");
+                final boolean ym = !y.startsWith(":");
+                return xm != ym ? (xm ? -1 : 1) : x.compareTo(y);
+            });
+            a.processNames = sorted.toArray(new String[0]);
+            a.chosen = chosenOf(info.uid, info.packageName).toArray(new String[0]);
+            a.connected = connected.toArray(new String[0]);
+        }
+        return a;
+    }
+
+    /** The short names of the processes the app declares for itself and its components. */
+    private ArraySet<String> declaredProcesses(ApplicationInfo info) {
+        final ArraySet<String> out = new ArraySet<>();
+        out.add(info.packageName);
+        try {
+            final PackageInfo pi = mContext.getPackageManager().getPackageInfoAsUser(
+                    info.packageName, PackageManager.GET_ACTIVITIES | PackageManager.GET_SERVICES
+                            | PackageManager.GET_RECEIVERS | PackageManager.GET_PROVIDERS
+                            | PackageManager.MATCH_DISABLED_COMPONENTS,
+                    UserHandle.getUserId(info.uid));
+            for (ComponentInfo[] list : new ComponentInfo[][] {pi.activities, pi.services,
+                    pi.receivers, pi.providers}) {
+                if (list == null) {
+                    continue;
+                }
+                for (ComponentInfo c : list) {
+                    if (c.processName != null) {
+                        out.add(processShortName(c.processName, info.packageName));
+                    }
+                }
+            }
+        } catch (PackageManager.NameNotFoundException e) {
+            Slog.w(TAG, info.packageName + " has no package info", e);
+        }
+        return out;
+    }
+
+    /** Time running off screen in the last 24 hours, from the record's lines (oldest first). */
+    private static long backgroundTime(List<Event> newestFirst, LujarchBackgroundApp now,
+            long dayAgo) {
+        long total = 0;
+        long runningSince = -1;
+        for (int i = newestFirst.size() - 1; i >= 0; i--) {
+            final Event e = newestFirst.get(i);
+            switch (e.kind) {
+                case LujarchBackground.EVENT_LEFT:
+                case LujarchBackground.EVENT_STARTED:
+                    if (runningSince < 0) {
+                        runningSince = e.time;
+                    }
+                    break;
+                case LujarchBackground.EVENT_WOKEN:
+                    if (e.durationMs > 0 || e.count > 1) {
+                        total += e.durationMs;
+                    } else if (runningSince < 0) {
+                        runningSince = e.time;
+                    }
+                    break;
+                case LujarchBackground.EVENT_PAUSED:
+                case LujarchBackground.EVENT_ENDED:
+                case LujarchBackground.EVENT_STOPPED:
+                case LujarchBackground.EVENT_OPENED:
+                    if (runningSince >= 0) {
+                        total += e.time - Math.max(runningSince, dayAgo);
+                        runningSince = -1;
+                    }
+                    break;
+                default:
+                    break;
+            }
+        }
+        if (runningSince >= 0 && now.state == LujarchBackground.RUN_BACKGROUND) {
+            total += System.currentTimeMillis() - Math.max(runningSince, dayAgo);
+        }
+        return Math.max(0, total);
+    }
+
+    private LujarchBackgroundProcess process(Proc p, boolean detail) {
+        final LujarchBackgroundProcess out = new LujarchBackgroundProcess();
+        final Words w = new Words();
+        final ProcState s = procState(p);
+        out.pid = p.pid;
+        out.uid = p.uid;
+        out.name = p.name;
+        out.packageName = p.packageName;
+        out.state = s.state;
+        out.who = s.who;
+        out.whoName = w.who(s.who, s.whoPackage, p.userId);
+        out.reason = w.text(s.cause, s.detail, s.whoPackage, p.userId);
+        out.frozen = p.frozen;
+        out.chosen = (p.hold & LUJARCH_HOLD_CHOSEN) != 0;
+        final long[] m = mProc.memory(p.pid, p.frozen);
+        out.memoryBytes = m[0] * 1024;
+        out.swapBytes = m[1] * 1024;
+        out.startedMillis = System.currentTimeMillis()
+                - (SystemClock.elapsedRealtime() - p.startElapsed);
+        out.cpuMs = cpuToday(p.pid, LujarchBackgroundProc.cpuMs(p.pid), out.startedMillis);
+        synchronized (mLock) {
+            final ArrayList<Long> wakes = mWakes.get(p.pid);
+            out.wakeups = wakes != null ? wakes.size() : 0;
+        }
+        out.priority = w.priority(p);
+        if (detail) {
+            out.rssBytes = LujarchBackgroundProc.statusKb(p.pid, "VmRSS:") * 1024;
+            final ArrayList<LujarchBackgroundReason> reasons = new ArrayList<>();
+            reasons.add(reason(s.who, out.whoName, out.reason));
+            if ((p.hold & LUJARCH_HOLD_KEPT) != 0 && s.cause != C_KEPT) {
+                reasons.add(reason(LujarchBackground.WHO_USER,
+                        w.who(LujarchBackground.WHO_USER, null, p.userId),
+                        w.text(C_KEPT, null, null, p.userId)));
+            }
+            if ((p.hold & LUJARCH_HOLD_UNRESTRICTED) != 0 && s.cause != C_UNRESTRICTED) {
+                final int who = isSystemAllowlisted(p.packageName) ? LujarchBackground.WHO_SYSTEM
+                        : LujarchBackground.WHO_USER;
+                reasons.add(reason(who, w.who(who, null, p.userId),
+                        w.text(C_UNRESTRICTED, null, null, p.userId)));
+            }
+            if (p.sourcePackage != null && s.cause != C_USED_BY && s.cause != C_USED_BY_OWN) {
+                final boolean own = UserHandle.getAppId(p.sourceUid) == UserHandle.getAppId(p.uid);
+                final int who = own ? LujarchBackground.WHO_APP
+                        : UserHandle.getAppId(p.sourceUid) >= Process.FIRST_APPLICATION_UID
+                        ? LujarchBackground.WHO_OTHER : LujarchBackground.WHO_SYSTEM;
+                reasons.add(reason(who, w.who(who, own ? null : p.sourcePackage, p.userId),
+                        own ? w.text(C_USED_BY_OWN, processShortName(p.sourceName,
+                                p.packageName), null, p.userId)
+                                : w.text(C_USED_BY, null, p.sourcePackage, p.userId)));
+            }
+            final Event start = mRecord.latest(p.userId, p.packageName,
+                    LujarchBackground.EVENT_STARTED, LujarchBackground.EVENT_OPENED);
+            if (start != null && start.kind == LujarchBackground.EVENT_STARTED
+                    && start.time >= out.startedMillis - 5_000) {
+                reasons.add(reason(start.who, w.who(start.who, start.whoPackage, p.userId),
+                        w.event(start, p.userId)));
+            }
+            out.reasons = reasons.toArray(new LujarchBackgroundReason[0]);
+            final ArrayList<LujarchBackgroundThread> threads = new ArrayList<>();
+            for (LujarchBackgroundProc.Thread t : LujarchBackgroundProc.threads(p.pid)) {
+                final LujarchBackgroundThread th = new LujarchBackgroundThread();
+                th.tid = t.tid;
+                th.name = t.name;
+                th.state = w.threadState(t.state);
+                th.cpuMs = t.cpuMs;
+                threads.add(th);
+            }
+            out.threads = threads.toArray(new LujarchBackgroundThread[0]);
+        }
+        return out;
+    }
+
+    private static LujarchBackgroundReason reason(int who, String whoName, String text) {
+        final LujarchBackgroundReason r = new LujarchBackgroundReason();
+        r.who = who;
+        r.whoName = whoName;
+        r.text = text;
+        return r;
+    }
+
+    LujarchBackgroundMemory memory() {
+        final long[] info = mProc.memInfo();
+        final LujarchBackgroundMemory m = new LujarchBackgroundMemory();
+        m.totalBytes = info[0] * 1024;
+        m.freeBytes = info[1] * 1024;
+        for (Proc p : snapshot(UserHandle.USER_ALL, null)) {
+            if (p.system) {
+                continue;
+            }
+            final long bytes = mProc.memory(p.pid, p.frozen)[0] * 1024;
+            if ((p.hold & LUJARCH_HOLD_KEPT) != 0) {
+                m.keptBytes += bytes;
+            } else {
+                m.appsBytes += bytes;
+            }
+        }
+        m.systemBytes = Math.max(0, m.totalBytes - m.freeBytes - m.appsBytes - m.keptBytes);
+        final com.android.internal.util.MemInfoReader swap =
+                new com.android.internal.util.MemInfoReader();
+        swap.readMemInfo();
+        m.swapBytes = Math.max(0, swap.getSwapTotalSizeKb() - swap.getSwapFreeSizeKb()) * 1024;
+        m.swapStoredBytes = swap.getZramTotalSizeKb() * 1024;
+        return m;
+    }
+
+    String label(String pkg, int userId) {
+        final PackageManager pm = mContext.getPackageManager();
+        try {
+            return pm.getApplicationInfoAsUser(pkg, PackageManager.MATCH_UNINSTALLED_PACKAGES,
+                    userId).loadLabel(pm).toString();
+        } catch (PackageManager.NameNotFoundException e) {
+            return pkg;
+        }
+    }
+
+    /** What runs off screen, in the order of Recents' Running layer (BG-8). */
+    List<LujarchBackgroundApp> running(int userId) {
+        final ArrayList<LujarchBackgroundApp> out = new ArrayList<>();
+        final ArrayMap<String, Integer> kinds = new ArrayMap<>();
+        final ArrayMap<String, ArrayList<Proc>> byApp = new ArrayMap<>();
+        for (Proc p : snapshot(userId, null)) {
+            if (!p.system && !p.home) {
+                byApp.computeIfAbsent(p.packageName, k -> new ArrayList<>()).add(p);
+            }
+        }
+        for (int i = 0; i < byApp.size(); i++) {
+            final int kind = runKind(appState(byApp.valueAt(i)));
+            if (kind >= 0) {
+                kinds.put(byApp.keyAt(i), kind);
+            }
+        }
+        for (LujarchBackgroundApp a : apps(userId, false, false, null)) {
+            final Integer kind = a.smallWindow ? Integer.valueOf(1) : kinds.get(a.packageName);
+            if (kind != null) {
+                out.add(a);
+                kinds.put(a.packageName, kind);
+            }
+        }
+        out.sort((x, y) -> {
+            final int kx = kinds.get(x.packageName);
+            final int ky = kinds.get(y.packageName);
+            return kx != ky ? Integer.compare(kx, ky) : Long.compare(y.sinceMillis, x.sinceMillis);
+        });
+        return out;
+    }
