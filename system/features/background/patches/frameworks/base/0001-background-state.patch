+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public LujarchBackgroundApp[] getApps(int userId, boolean withSystem) {
+        enforce();
+        ready();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            return apps(userId, withSystem, false, null).toArray(new LujarchBackgroundApp[0]);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public LujarchBackgroundApp getApp(String packageName, int userId) {
+        enforce();
+        ready();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final ArrayList<LujarchBackgroundApp> list = apps(userId, true, true, packageName);
+            if (!list.isEmpty()) {
+                return list.get(0);
+            }
+            return describeIdle(packageName, userId);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    /** An app with no process and nothing in the record: not running. */
+    @Nullable
+    private LujarchBackgroundApp describeIdle(String packageName, int userId) {
+        final ApplicationInfo info;
+        try {
+            info = mContext.getPackageManager().getApplicationInfoAsUser(packageName, 0, userId);
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+        final LujarchBackgroundApp a = describe(info, new ArrayList<>(), null, null, true);
+        if (a != null) {
+            return a;
+        }
+        final LujarchBackgroundApp idle = new LujarchBackgroundApp();
+        idle.packageName = packageName;
+        idle.uid = info.uid;
+        idle.label = label(packageName, userId);
+        idle.depth = (info.flags & ApplicationInfo.FLAG_STOPPED) != 0
+                ? LujarchBackground.DEPTH_STOPPED : LujarchBackground.DEPTH_RECLAIMED;
+        idle.who = LujarchBackground.WHO_SYSTEM;
+        final Words w = new Words();
+        idle.whoName = w.who(idle.who, null, userId);
+        idle.reason = mContext.getString(R.string.lujarch_background_r_not_started);
+        idle.word = LujarchBackground.depthName(mContext, idle.depth);
+        idle.kept = isKept(info.uid, packageName);
+        idle.usage = usageOf(info.uid, packageName);
+        idle.usageFixed = isSystemAllowlisted(packageName);
+        idle.folded = isFolded(info.uid, packageName);
+        idle.taskId = -1;
+        idle.processes = new LujarchBackgroundProcess[0];
+        return idle;
+    }
+
+    @Override
+    public LujarchBackgroundProcess getProcess(int pid) {
+        enforce();
+        ready();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            for (Proc p : snapshot(UserHandle.USER_ALL, null)) {
+                if (p.pid == pid) {
+                    return process(p, true);
+                }
+            }
+            return null;
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public LujarchBackgroundEvent[] getEvents(String packageName, int userId, long sinceMillis,
+            int max) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final Words w = new Words();
+            final ArrayList<LujarchBackgroundEvent> out = new ArrayList<>();
+            for (Event e : mRecord.since(userId, packageName, sinceMillis)) {
+                if (out.size() >= max) {
+                    break;
+                }
+                final LujarchBackgroundEvent ev = new LujarchBackgroundEvent();
+                ev.timeMillis = e.time;
+                ev.kind = e.kind;
+                ev.who = e.who;
+                ev.whoName = w.who(e.who, e.whoPackage, userId);
+                ev.text = w.event(e, userId);
+                ev.count = e.count;
+                out.add(ev);
+            }
+            return out.toArray(new LujarchBackgroundEvent[0]);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    private int uidOf(String packageName, int userId) {
+        try {
+            return mContext.getPackageManager().getPackageUidAsUser(packageName, userId);
+        } catch (PackageManager.NameNotFoundException e) {
+            throw new IllegalArgumentException(packageName + " is not installed for user "
+                    + userId);
+        }
+    }
+
+    @Override
+    public void setBackgroundUsage(String packageName, int userId, int usage) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            applyUsage(packageName, uidOf(packageName, userId), usage);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    /**
+     * Background usage as Android's Settings sets it (the power allowlist for Unrestricted, the
+     * run-in-background op for Restricted), and Messages only as Optimized with its op.
+     */
+    void applyUsage(String packageName, int uid, int usage) {
+        if (usage < LujarchBackground.USAGE_UNRESTRICTED
+                || usage > LujarchBackground.USAGE_RESTRICTED) {
+            throw new IllegalArgumentException("no Background usage " + usage);
+        }
+        if (usage != LujarchBackground.USAGE_UNRESTRICTED && isSystemAllowlisted(packageName)) {
+            throw new IllegalArgumentException(packageName + " stays Unrestricted");
+        }
+        final int runAny = usage == LujarchBackground.USAGE_RESTRICTED
+                ? AppOpsManager.MODE_IGNORED : AppOpsManager.MODE_ALLOWED;
+        final boolean restrictedBefore = mAppOps.unsafeCheckOpRawNoThrow(
+                AppOpsManager.OP_RUN_ANY_IN_BACKGROUND, uid, packageName)
+                == AppOpsManager.MODE_IGNORED;
+        try {
+            if (usage == LujarchBackground.USAGE_UNRESTRICTED) {
+                mDeviceIdle.addPowerSaveWhitelistApp(packageName);
+            } else {
+                mDeviceIdle.removePowerSaveWhitelistApp(packageName);
+            }
+        } catch (RemoteException e) {
+            throw new IllegalStateException("the allowlist cannot be changed", e);
+        }
+        try {
+            final ApplicationInfo info = mContext.getPackageManager()
+                    .getApplicationInfoAsUser(packageName, 0, UserHandle.getUserId(uid));
+            if (info.targetSdkVersion < Build.VERSION_CODES.O) {
+                mAppOps.setMode(AppOpsManager.OP_RUN_IN_BACKGROUND, uid, packageName, runAny);
+            }
+        } catch (PackageManager.NameNotFoundException e) {
+            throw new IllegalArgumentException(packageName + " is not installed");
+        }
+        if (restrictedBefore != (runAny == AppOpsManager.MODE_IGNORED)) {
+            mAm.noteAppRestrictionEnabled(packageName, uid,
+                    ActivityManager.RESTRICTION_LEVEL_BACKGROUND_RESTRICTED,
+                    runAny == AppOpsManager.MODE_IGNORED, ActivityManager.RESTRICTION_REASON_USER,
+                    "lujarch background", ActivityManager.RESTRICTION_SOURCE_USER, 0L);
+        }
+        mAppOps.setMode(AppOpsManager.OP_RUN_ANY_IN_BACKGROUND, uid, packageName, runAny);
+        mAppOps.setMode(AppOpsManager.OP_LUJARCH_MESSAGES_ONLY, uid, packageName,
+                usage == LujarchBackground.USAGE_MESSAGES ? AppOpsManager.MODE_ALLOWED
+                        : AppOpsManager.MODE_IGNORED);
+        Slog.i(TAG, packageName + " (" + uid + "): Background usage " + usage);
+    }
+
+    @Override
+    public void setKept(String packageName, int userId, boolean kept) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            applyKept(packageName, uidOf(packageName, userId), kept);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    void applyKept(String packageName, int uid, boolean kept) {
+        mAppOps.setMode(AppOpsManager.OP_LUJARCH_KEEP, uid, packageName,
+                kept ? AppOpsManager.MODE_ALLOWED : AppOpsManager.MODE_IGNORED);
+        Slog.i(TAG, packageName + " (" + uid + "): Keep " + (kept ? "on" : "off"));
+    }
+
+    @Override
+    public void setFolded(String packageName, int userId, boolean folded) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            mAppOps.setMode(AppOpsManager.OP_LUJARCH_FOLD, uidOf(packageName, userId),
+                    packageName, folded ? AppOpsManager.MODE_ALLOWED : AppOpsManager.MODE_IGNORED);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public void endForegroundServices(String packageName, int userId) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
