+package com.android.server.am;
+
+import android.annotation.Nullable;
+import android.app.ActivityManager;
+import android.app.Notification;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.BatteryConsumer;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.UserHandle;
+import android.service.notification.StatusBarNotification;
+import android.text.TextUtils;
+import android.text.format.Formatter;
+import android.util.ArrayMap;
+import android.util.Slog;
+import android.view.View;
+import android.widget.RemoteViews;
+
+import com.android.internal.R;
+import com.android.internal.app.LujarchBackground;
+import com.android.internal.app.LujarchBackgroundApp;
+import com.android.internal.messages.nano.SystemMessageProto.SystemMessage;
+import com.android.internal.notification.SystemNotificationChannels;
+
+import java.text.NumberFormat;
+import java.util.ArrayList;
+import java.util.Calendar;
+import java.util.List;
+
+/**
+ * The Background notification (BG-8) with the running notifications folded into it (BG-9), and
+ * the two Background alerts (BG-10), all posted by the system under Android System.
+ */
+final class LujarchBackgroundNotices {
+    private static final String TAG = LujarchBackgroundService.TAG;
+
+    static final String ACTION_END = "org.lujarch.background.action.END";
+    static final String ACTION_CLOSE = "org.lujarch.background.action.CLOSE";
+    static final String ACTION_KEEP = "org.lujarch.background.action.KEEP";
+    static final String ACTION_RESTRICT = "org.lujarch.background.action.RESTRICT";
+    static final String ACTION_ALLOW = "org.lujarch.background.action.ALLOW";
+    /** Handled by the shade: the menu of a folded line (Fold into Background). */
+    static final String ACTION_FOLD_MENU = "org.lujarch.background.action.FOLD_MENU";
+    static final String SYSTEMUI = "com.android.systemui";
+    private static final String EXTRA_UID = "uid";
+    private static final String EXTRA_TASK = "task";
+    private static final String EXTRA_COMPONENT = "component";
+
+    /** Rows the notification shows; the rest are counted. */
+    /** Rows that fit the height the shade gives an expanded custom notification. */
+    private static final int MAX_ROWS = 4;
+    private static final long UPDATE_DELAY_MS = 1_000;
+    /** At most one ended alert per app in this time. */
+    private static final long ENDED_INTERVAL_MS = 60 * 60_000L;
+    /** Alerts from this hour to the next morning's wait silently for the lock screen. */
+    private static final int NIGHT_FROM = 22;
+    private static final int NIGHT_TO = 7;
+
+    private final Context mContext;
+    private final LujarchBackgroundService mService;
+    private final Handler mHandler;
+    private final NotificationManager mNm;
+    private final ArrayMap<String, Long> mEndedAlerts = new ArrayMap<>();
+    private String mLastPosted;
+
+    LujarchBackgroundNotices(Context context, LujarchBackgroundService service, Handler handler) {
+        mContext = context;
+        mService = service;
+        mHandler = handler;
+        mNm = context.getSystemService(NotificationManager.class);
+    }
+
+    void start() {
+        final IntentFilter filter = new IntentFilter();
+        filter.addAction(ACTION_END);
+        filter.addAction(ACTION_CLOSE);
+        filter.addAction(ACTION_KEEP);
+        filter.addAction(ACTION_RESTRICT);
+        filter.addAction(ACTION_ALLOW);
+        mContext.registerReceiverForAllUsers(mReceiver, filter, null, mHandler,
+                Context.RECEIVER_NOT_EXPORTED);
+        update();
+    }
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            final String pkg = intent.getStringExtra(Intent.EXTRA_PACKAGE_NAME);
+            final int uid = intent.getIntExtra(EXTRA_UID, -1);
+            try {
+                switch (intent.getAction()) {
+                    case ACTION_END:
+                        mService.endOwnWork(pkg, UserHandle.getUserId(uid));
+                        break;
+                    case ACTION_CLOSE:
+                        mService.closeTask(intent.getIntExtra(EXTRA_TASK, -1));
+                        break;
+                    case ACTION_KEEP:
+                        mService.applyKept(pkg, uid, true);
+                        cancelAlert(pkg, uid);
+                        break;
+                    case ACTION_RESTRICT:
+                        mService.applyUsage(pkg, uid, LujarchBackground.USAGE_RESTRICTED);
+                        cancelAlert(pkg, uid);
+                        break;
+                    case ACTION_ALLOW:
+                        mService.usage().allow(uid, pkg, intent.getIntExtra(EXTRA_COMPONENT, 0));
+                        cancelAlert(pkg, uid);
+                        break;
+                    default:
+                        break;
+                }
+            } catch (RuntimeException e) {
+                Slog.e(TAG, intent.getAction() + " for " + pkg + " failed", e);
+            }
+            update();
+        }
+    };
+
+    /** The state changed: the notification follows, a moment later. */
+    void update() {
+        mHandler.removeCallbacks(mBuild);
+        mHandler.postDelayed(mBuild, UPDATE_DELAY_MS);
+    }
+
+    private final Runnable mBuild = () -> {
+        try {
+            build();
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "the Background notification failed", e);
+        }
+    };
+
+    // ---------------------------------------------------------------------------------------
+    // Background (BG-8, BG-9)
+
+    private void build() {
+        final int userId = ActivityManager.getCurrentUser();
+        final UserHandle user = UserHandle.of(userId);
+        final List<LujarchBackgroundApp> apps = mService.runningOffScreen(userId);
+        final List<StatusBarNotification> folded = foldedNotifications(userId);
+        if (apps.isEmpty() && folded.isEmpty()) {
+            if (mLastPosted != null) {
+                mNm.cancelAsUser(null, SystemMessage.NOTE_LUJARCH_BACKGROUND, user);
+                mLastPosted = null;
+            }
+            return;
+        }
+        final LujarchBackgroundService.Words w = mService.words();
+        final long free = mService.memory().freeBytes;
+        final String freeText = mContext.getString(R.string.lujarch_background_free,
+                Formatter.formatShortFileSize(mContext, free));
+        final String title = mContext.getResources().getQuantityString(
+                R.plurals.lujarch_background_n_title, apps.size(), apps.size());
+        final ArrayList<String> names = new ArrayList<>();
+        for (LujarchBackgroundApp a : apps) {
+            names.add(a.label);
+        }
+        final String summary = TextUtils.join(
+                mContext.getString(R.string.lujarch_background_list_separator), names);
+
+        final RemoteViews big = new RemoteViews(mContext.getPackageName(),
+                R.layout.lujarch_background_notification);
+        big.setTextViewText(R.id.lujarch_background_title, title);
+        big.removeAllViews(R.id.lujarch_background_rows);
+        final StringBuilder signature = new StringBuilder(title).append(freeText);
+        int shown = 0;
+        for (LujarchBackgroundApp a : apps) {
+            if (shown >= MAX_ROWS) {
+                break;
+            }
+            big.addView(R.id.lujarch_background_rows, appRow(a, user));
+            signature.append(a.packageName).append(a.depth).append(a.reason).append(a.whoName);
+            shown++;
+        }
+        final ArrayList<String> foldedNames = new ArrayList<>();
+        for (StatusBarNotification sbn : folded) {
+            if (shown < MAX_ROWS) {
+                big.addView(R.id.lujarch_background_rows, foldedRow(sbn, user));
+                shown++;
+            }
+            foldedNames.add(mService.label(sbn.getPackageName(), userId));
+            signature.append(sbn.getKey()).append(text(sbn, Notification.EXTRA_TITLE))
+                    .append(text(sbn, Notification.EXTRA_TEXT));
+        }
+        final int hidden = apps.size() + folded.size() - shown;
+        if (hidden > 0) {
+            big.setViewVisibility(R.id.lujarch_background_more, View.VISIBLE);
+            big.setTextViewText(R.id.lujarch_background_more, mContext.getResources()
+                    .getQuantityString(R.plurals.lujarch_background_n_more, hidden, hidden));
+        } else {
+            big.setViewVisibility(R.id.lujarch_background_more, View.GONE);
+        }
+        if (!foldedNames.isEmpty()) {
+            big.setViewVisibility(R.id.lujarch_background_folded, View.VISIBLE);
+            big.setTextViewText(R.id.lujarch_background_folded, mContext.getString(
+                    R.string.lujarch_background_n_folded, TextUtils.join(
+                            mContext.getString(R.string.lujarch_background_list_separator),
+                            foldedNames)));
+        } else {
+            big.setViewVisibility(R.id.lujarch_background_folded, View.GONE);
+        }
+        final RemoteViews small = new RemoteViews(mContext.getPackageName(),
+                R.layout.lujarch_background_notification_small);
+        small.setTextViewText(R.id.lujarch_background_title, title);
+        small.setTextViewText(R.id.lujarch_background_summary, summary);
+
+        final PendingIntent page = activity(new Intent(LujarchBackground.ACTION_BACKGROUND),
+                user, 0);
+        final Notification n = new Notification.Builder(mContext,
+                SystemNotificationChannels.LUJARCH_BACKGROUND)
+                .setSmallIcon(R.drawable.stat_sys_lujarch_background)
+                .setContentTitle(title)
+                .setContentText(summary)
+                .setSubText(freeText)
+                .setShowWhen(false)
+                .setWhen(0)
+                .setOngoing(true)
+                .setOnlyAlertOnce(true)
+                .setSilent(true)
+                .setLocalOnly(true)
+                .setVisibility(Notification.VISIBILITY_SECRET)
+                .setCategory(Notification.CATEGORY_STATUS)
+                .setColor(mContext.getColor(R.color.system_notification_accent_color))
+                .setStyle(new Notification.DecoratedCustomViewStyle())
+                .setCustomContentView(small)
+                .setCustomBigContentView(big)
+                .setContentIntent(page)
+                .addAction(new Notification.Action.Builder(null,
+                        mContext.getString(R.string.lujarch_background_n_open), page).build())
+                .build();
+        final String posted = signature.toString();
+        if (posted.equals(mLastPosted)) {
+            return;
+        }
+        mLastPosted = posted;
+        mNm.notifyAsUser(null, SystemMessage.NOTE_LUJARCH_BACKGROUND, n, user);
+    }
+
+    private RemoteViews appRow(LujarchBackgroundApp a, UserHandle user) {
+        final RemoteViews row = new RemoteViews(mContext.getPackageName(),
+                R.layout.lujarch_background_row);
+        row.setInt(R.id.lujarch_background_dot, "setColorFilter",
+                LujarchBackground.depthColor(mContext, a.depth, a.smallWindow));
+        row.setTextViewText(R.id.lujarch_background_name, a.label);
+        who(row, a.who, a.whoName);
+        row.setTextViewText(R.id.lujarch_background_reason, a.reason);
+        row.setViewVisibility(R.id.lujarch_background_menu, View.GONE);
+        if (a.smallWindow && a.taskId >= 0) {
+            action(row, R.string.lujarch_background_n_close, broadcast(new Intent(ACTION_CLOSE)
+                    .putExtra(EXTRA_TASK, a.taskId), a.taskId));
+        } else if (a.ownService && a.depth == LujarchBackground.DEPTH_RUNNING) {
+            action(row, R.string.lujarch_background_n_end, broadcast(new Intent(ACTION_END)
+                    .putExtra(Intent.EXTRA_PACKAGE_NAME, a.packageName)
+                    .putExtra(EXTRA_UID, a.uid), a.uid));
+        } else {
+            row.setViewVisibility(R.id.lujarch_background_action, View.GONE);
+        }
+        row.setOnClickPendingIntent(R.id.lujarch_background_row, appPage(a.packageName, a.uid,
+                user, null));
+        return row;
+    }
+
+    /** A running notification folded into Background: its title and text, End and its menu. */
+    private RemoteViews foldedRow(StatusBarNotification sbn, UserHandle user) {
+        final RemoteViews row = new RemoteViews(mContext.getPackageName(),
+                R.layout.lujarch_background_row);
+        final int uid = sbn.getUid();
+        final String label = mService.label(sbn.getPackageName(), sbn.getUserId());
+        final String title = text(sbn, Notification.EXTRA_TITLE);
+        row.setInt(R.id.lujarch_background_dot, "setColorFilter",
+                LujarchBackground.depthColor(mContext, LujarchBackground.DEPTH_RUNNING, false));
+        row.setTextViewText(R.id.lujarch_background_name, TextUtils.isEmpty(title) ? label
+                : mContext.getString(R.string.lujarch_background_n_folded_line, label, title));
+        who(row, LujarchBackground.WHO_APP, mContext.getString(
+                R.string.lujarch_background_who_app));
+        row.setTextViewText(R.id.lujarch_background_reason, text(sbn, Notification.EXTRA_TEXT));
+        action(row, R.string.lujarch_background_n_end, broadcast(new Intent(ACTION_END)
+                .putExtra(Intent.EXTRA_PACKAGE_NAME, sbn.getPackageName())
+                .putExtra(EXTRA_UID, uid), uid));
+        row.setViewVisibility(R.id.lujarch_background_menu, View.VISIBLE);
+        row.setOnClickPendingIntent(R.id.lujarch_background_menu, PendingIntent.getBroadcastAsUser(
+                mContext, uid, new Intent(ACTION_FOLD_MENU).setPackage(SYSTEMUI)
+                        .putExtra(Intent.EXTRA_PACKAGE_NAME, sbn.getPackageName())
+                        .putExtra(EXTRA_UID, uid),
+                PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT, user));
+        final PendingIntent open = sbn.getNotification().contentIntent;
+        row.setOnClickPendingIntent(R.id.lujarch_background_row, open != null ? open
+                : appPage(sbn.getPackageName(), uid, user, null));
+        return row;
+    }
+
+    /** Who caused it, as a word in its color: a notification keeps to text. */
+    private void who(RemoteViews row, int who, String name) {
+        row.setTextViewText(R.id.lujarch_background_who, name);
+        row.setTextColor(R.id.lujarch_background_who, LujarchBackground.whoColor(mContext, who));
+    }
+
+    private void action(RemoteViews row, int label, PendingIntent pi) {
+        row.setViewVisibility(R.id.lujarch_background_action, View.VISIBLE);
+        row.setTextViewText(R.id.lujarch_background_action, mContext.getString(label));
+        // The accent of the shade's theme, as the notification's own actions have it.
+        row.setColorStateListAttr(R.id.lujarch_background_action, "setTextColor",
+                android.R.attr.colorAccent);
+        row.setOnClickPendingIntent(R.id.lujarch_background_action, pi);
+    }
+
+    /** The running notifications of the apps folded into Background. */
+    private List<StatusBarNotification> foldedNotifications(int userId) {
+        final ArrayList<StatusBarNotification> out = new ArrayList<>();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            for (StatusBarNotification sbn : NotificationManager.getService()
+                    .getActiveNotificationsWithAttribution(mContext.getOpPackageName(), null)) {
+                if (sbn.getUserId() == userId && isFoldable(sbn)
+                        && mService.isFolded(sbn.getUid(), sbn.getPackageName())) {
+                    out.add(sbn);
+                }
+            }
+        } catch (Exception e) {
+            Slog.e(TAG, "the notifications cannot be read", e);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+        return out;
+    }
+
+    /** An ongoing notification of a foreground service: the kind BG-9 folds. */
+    static boolean isFoldable(StatusBarNotification sbn) {
+        final Notification n = sbn.getNotification();
+        return (n.flags & Notification.FLAG_FOREGROUND_SERVICE) != 0
+                && (n.flags & Notification.FLAG_ONGOING_EVENT) != 0;
+    }
+
+    private static String text(StatusBarNotification sbn, String key) {
+        final CharSequence t = sbn.getNotification().extras.getCharSequence(key);
+        return t != null ? t.toString() : "";
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Background alerts (BG-10)
+
+    /**
+     * The system ended an app the owner chose to keep running: when, who and what was lost,
+     * with Keep (for Messages only) and What happened.
+     */
+    void alertEnded(int uid, String pkg, int usage, int cause, long time, boolean messages) {
+        final String key = uid + ":" + pkg;
+        final long now = System.currentTimeMillis();
+        final Long last = mEndedAlerts.get(key);
+        if (last != null && now - last < ENDED_INTERVAL_MS) {
+            return;
+        }
+        mEndedAlerts.put(key, now);
+        final UserHandle user = UserHandle.getUserHandleForUid(uid);
+        final LujarchBackgroundService.Words w = mService.words();
+        final String label = mService.label(pkg, user.getIdentifier());
+        final String choice = usage < 0 ? mContext.getString(R.string.lujarch_background_keep)
+                : LujarchBackground.usageName(mContext, usage);
+        final String title = mContext.getString(messages
+                ? R.string.lujarch_background_a_ended_messages_title
+                : R.string.lujarch_background_a_ended_title, label);
+        final String lost = mContext.getString(usage == LujarchBackground.USAGE_MESSAGES
+                ? R.string.lujarch_background_a_lost_messages : usage < 0
+                ? R.string.lujarch_background_a_lost_kept
+                : R.string.lujarch_background_a_lost_running);
+        final String text = mContext.getString(R.string.lujarch_background_a_ended_text, choice,
+                w.when(time), w.endReason(cause, null, user.getIdentifier()), lost);
+        final Notification.Builder b = alert(title, text, pkg, uid, user);
+        if (usage == LujarchBackground.USAGE_MESSAGES) {
+            b.addAction(new Notification.Action.Builder(null,
+                    mContext.getString(R.string.lujarch_background_a_keep, label),
+                    broadcast(new Intent(ACTION_KEEP).putExtra(Intent.EXTRA_PACKAGE_NAME, pkg)
+                            .putExtra(EXTRA_UID, uid), uid)).build());
+        }
+        b.addAction(new Notification.Action.Builder(null,
+                mContext.getString(R.string.lujarch_background_a_what_happened),
+                appPage(pkg, uid, user, LujarchBackground.KEY_WHAT_HAPPENED)).build());
+        post(b, pkg, user);
+        Slog.i(TAG, "alert: " + pkg + " (" + uid + ") was ended, cause " + cause);
+    }
+
+    /**
+     * An app off screen uses much more battery than its peers: how much and why, with
+     * Restricted and It can do this.
+     */
+    void alertBattery(int uid, String pkg, double mah, double percent, int component, int usage) {
+        mHandler.post(() -> {
+            final UserHandle user = UserHandle.getUserHandleForUid(uid);
+            final String label = mService.label(pkg, user.getIdentifier());
+            final NumberFormat pct = NumberFormat.getPercentInstance();
+            pct.setMaximumFractionDigits(percent < 10 ? 1 : 0);
+            final String title = mContext.getString(R.string.lujarch_background_a_battery_title,
+                    label, pct.format(percent / 100));
+            final LujarchBackgroundApp app = mService.getAppForAlert(pkg, user.getIdentifier());
+            final int wakeups = app != null ? app.wakeups : 0;
+            final String text = mContext.getResources().getQuantityString(
+                    R.plurals.lujarch_background_a_battery_text, wakeups, wakeups,
+                    componentWord(component), LujarchBackground.usageName(mContext, usage));
+            final Notification.Builder b = alert(title, text, pkg, uid, user);
+            b.addAction(new Notification.Action.Builder(null,
+                    LujarchBackground.usageName(mContext, LujarchBackground.USAGE_RESTRICTED),
+                    broadcast(new Intent(ACTION_RESTRICT).putExtra(Intent.EXTRA_PACKAGE_NAME, pkg)
+                            .putExtra(EXTRA_UID, uid), uid)).build());
+            b.addAction(new Notification.Action.Builder(null,
+                    mContext.getString(R.string.lujarch_background_a_allow),
+                    broadcast(new Intent(ACTION_ALLOW).putExtra(Intent.EXTRA_PACKAGE_NAME, pkg)
+                            .putExtra(EXTRA_UID, uid).putExtra(EXTRA_COMPONENT, component),
+                            uid ^ component)).build());
+            post(b, pkg, user);
+        });
+    }
+
+    private String componentWord(int component) {
+        switch (component) {
+            case BatteryConsumer.POWER_COMPONENT_WAKELOCK:
+                return mContext.getString(R.string.lujarch_background_use_wakelock);
+            case BatteryConsumer.POWER_COMPONENT_GNSS:
+                return mContext.getString(R.string.lujarch_background_use_location);
+            case BatteryConsumer.POWER_COMPONENT_MOBILE_RADIO:
+                return mContext.getString(R.string.lujarch_background_use_mobile);
+            case BatteryConsumer.POWER_COMPONENT_WIFI:
+                return mContext.getString(R.string.lujarch_background_use_wifi);
+            case BatteryConsumer.POWER_COMPONENT_BLUETOOTH:
+                return mContext.getString(R.string.lujarch_background_use_bluetooth);
+            case BatteryConsumer.POWER_COMPONENT_SENSORS:
+                return mContext.getString(R.string.lujarch_background_use_sensors);
+            case BatteryConsumer.POWER_COMPONENT_AUDIO:
+            case BatteryConsumer.POWER_COMPONENT_VIDEO:
+                return mContext.getString(R.string.lujarch_background_use_media);
+            case BatteryConsumer.POWER_COMPONENT_CAMERA:
+                return mContext.getString(R.string.lujarch_background_use_camera);
+            default:
+                return mContext.getString(R.string.lujarch_background_use_cpu);
+        }
+    }
+
+    private Notification.Builder alert(String title, String text, String pkg, int uid,
+            UserHandle user) {
+        final Notification.Builder b = new Notification.Builder(mContext,
+                SystemNotificationChannels.LUJARCH_BACKGROUND_ALERTS)
+                .setSmallIcon(R.drawable.stat_sys_lujarch_background)
+                .setContentTitle(title)
+                .setContentText(text)
+                .setStyle(new Notification.BigTextStyle().bigText(text))
+                .setAutoCancel(true)
+                .setLocalOnly(true)
+                .setCategory(Notification.CATEGORY_STATUS)
+                .setColor(mContext.getColor(R.color.system_notification_accent_color))
+                .setContentIntent(appPage(pkg, uid, user, LujarchBackground.KEY_WHAT_HAPPENED));
+        if (isNight()) {
+            // At night it waits on the lock screen without a sound.
+            b.setSilent(true);
+        }
+        return b;
+    }
+
+    private static boolean isNight() {
+        final int hour = Calendar.getInstance().get(Calendar.HOUR_OF_DAY);
+        return hour >= NIGHT_FROM || hour < NIGHT_TO;
+    }
+
+    private void post(Notification.Builder b, String pkg, UserHandle user) {
+        mNm.notifyAsUser(pkg, SystemMessage.NOTE_LUJARCH_BACKGROUND_ALERT, b.build(), user);
+    }
+
+    private void cancelAlert(String pkg, int uid) {
+        mNm.cancelAsUser(pkg, SystemMessage.NOTE_LUJARCH_BACKGROUND_ALERT,
+                UserHandle.getUserHandleForUid(uid));
+    }
+
+    // ---------------------------------------------------------------------------------------
+
+    private PendingIntent appPage(String pkg, int uid, UserHandle user, @Nullable String key) {
+        final Intent intent = new Intent(LujarchBackground.ACTION_APP)
+                .putExtra(Intent.EXTRA_PACKAGE_NAME, pkg)
+                .putExtra(Intent.EXTRA_USER, user);
+        if (key != null) {
+            intent.putExtra(LujarchBackground.EXTRA_HIGHLIGHT, key);
+        }
+        return activity(intent, user, (pkg + key).hashCode());
+    }
+
+    private PendingIntent activity(Intent intent, UserHandle user, int code) {
+        intent.setPackage(LujarchBackground.SETTINGS_PACKAGE)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        return PendingIntent.getActivityAsUser(mContext, code, intent,
+                PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT, null, user);
+    }
+
+    private PendingIntent broadcast(Intent intent, int code) {
+        intent.setPackage(mContext.getPackageName());
+        return PendingIntent.getBroadcastAsUser(mContext, code ^ intent.getAction().hashCode(),
+                intent, PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT,
+                UserHandle.SYSTEM);
+    }
+}
