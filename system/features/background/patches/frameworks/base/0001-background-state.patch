+ * limitations under the License.
+ */
+
+package com.android.server.am;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.BatteryConsumer;
+import android.os.BatteryUsageStats;
+import android.os.BatteryUsageStatsQuery;
+import android.os.Binder;
+import android.os.Process;
+import android.os.UidBatteryConsumer;
+import android.os.UserHandle;
+import android.util.AtomicFile;
+import android.util.Slog;
+import android.util.SparseArray;
+
+import com.android.internal.app.LujarchBackground;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * The battery each app used off screen in the last 24 hours, from Android's own accumulated
+ * battery usage, noted once an hour; and the alert for an app that uses much more than its peers
+ * (BG-12). Nothing is restricted here: the alert only proposes.
+ */
+final class LujarchBackgroundUsage {
+    private static final String TAG = LujarchBackgroundService.TAG;
+    private static final long HOUR_MS = 60 * 60_000L;
+    private static final long DAY_MS = 24 * HOUR_MS;
+    /** An app is alerted about when it used this many times its peers' median... */
+    private static final double PEER_FACTOR = 4;
+    /** ...and at least this share of the battery off screen in 24 hours. */
+    private static final double MIN_PERCENT = 2;
+    /** The same app is alerted about at most once in this time. */
+    private static final long ALERT_INTERVAL_MS = DAY_MS;
+
+    /** The power components an alert names as why. */
+    static final int[] COMPONENTS = {
+            BatteryConsumer.POWER_COMPONENT_CPU,
+            BatteryConsumer.POWER_COMPONENT_WAKELOCK,
+            BatteryConsumer.POWER_COMPONENT_GNSS,
+            BatteryConsumer.POWER_COMPONENT_MOBILE_RADIO,
+            BatteryConsumer.POWER_COMPONENT_WIFI,
+            BatteryConsumer.POWER_COMPONENT_BLUETOOTH,
+            BatteryConsumer.POWER_COMPONENT_SENSORS,
+            BatteryConsumer.POWER_COMPONENT_AUDIO,
+            BatteryConsumer.POWER_COMPONENT_VIDEO,
+            BatteryConsumer.POWER_COMPONENT_CAMERA,
+    };
+    private static final int[] OFF_SCREEN_STATES = {
+            BatteryConsumer.PROCESS_STATE_BACKGROUND,
+            BatteryConsumer.PROCESS_STATE_FOREGROUND_SERVICE,
+            BatteryConsumer.PROCESS_STATE_CACHED,
+    };
+
+    private final Context mContext;
+    private final LujarchBackgroundService mService;
+    private final ActivityManagerService mAm;
+    private final AtomicFile mFile;
+    /** Hourly notes: hour start to each uid's off-screen use, total then per component, mAh. */
+    private final TreeMap<Long, SparseArray<double[]>> mNotes = new TreeMap<>();
+    private final SparseArray<Long> mAlerted = new SparseArray<>();
+    private double mCapacity;
+
+    LujarchBackgroundUsage(Context context, LujarchBackgroundService service,
+            ActivityManagerService am) {
+        mContext = context;
+        mService = service;
+        mAm = am;
+        mFile = new AtomicFile(new File(LujarchBackgroundService.DIR, "battery"));
+    }
+
+    void start() {
+        load();
+        mService.mHandler.post(this::hourly);
+        // An alert is most useful when the owner picks the phone up.
+        mContext.registerReceiver(new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                mService.mHandler.post(() -> {
+                    note();
+                    evaluate();
+                });
+            }
+        }, new IntentFilter(Intent.ACTION_SCREEN_ON), null, mService.mHandler);
+    }
+
+    private void hourly() {
+        try {
+            note();
+            evaluate();
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "the hourly battery note failed", e);
+        }
+        final long now = System.currentTimeMillis();
+        mService.mHandler.postDelayed(this::hourly, HOUR_MS - now % HOUR_MS + 1_000);
+    }
+
+    /** Notes each uid's accumulated off-screen use for this hour. */
+    private void note() {
+        final BatteryUsageStatsQuery query = new BatteryUsageStatsQuery.Builder()
+                .accumulated()
+                .setMaxStatsAgeMs(10 * 60_000L)
+                .build();
+        final SparseArray<double[]> now = new SparseArray<>();
+        final long ident = Binder.clearCallingIdentity();
+        try (BatteryUsageStats stats =
+                mAm.mBatteryStatsService.getBatteryUsageStats(List.of(query)).get(0)) {
+            mCapacity = stats.getBatteryCapacity();
+            for (UidBatteryConsumer u : stats.getUidBatteryConsumers()) {
+                final double[] v = new double[1 + COMPONENTS.length];
+                for (int state : OFF_SCREEN_STATES) {
+                    v[0] += u.getConsumedPower(new BatteryConsumer.Dimensions(
+                            BatteryConsumer.POWER_COMPONENT_ANY, state));
+                    for (int i = 0; i < COMPONENTS.length; i++) {
+                        v[1 + i] += u.getConsumedPower(
+                                new BatteryConsumer.Dimensions(COMPONENTS[i], state));
+                    }
+                }
+                now.put(u.getUid(), v);
+            }
+        } catch (IOException | RuntimeException e) {
+            Slog.e(TAG, "the battery usage cannot be read", e);
+            return;
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+        final long hour = System.currentTimeMillis() / HOUR_MS * HOUR_MS;
+        synchronized (this) {
+            mNotes.put(hour, now);
+            while (!mNotes.isEmpty() && mNotes.firstKey() < hour - DAY_MS - 2 * HOUR_MS) {
+                mNotes.pollFirstEntry();
+            }
+        }
+        save();
+    }
+
+    /** The uid's use off screen in the last 24 hours: mAh, percent, then per component in mAh. */
+    synchronized double[] offScreenDetail(int uid) {
+        final double[] out = new double[2 + COMPONENTS.length];
+        if (mNotes.isEmpty()) {
+            return out;
+        }
+        final double[] last = mNotes.lastEntry().getValue().get(uid);
+        if (last == null) {
+            return out;
+        }
+        final Map.Entry<Long, SparseArray<double[]>> from =
+                mNotes.floorEntry(mNotes.lastKey() - DAY_MS) != null
+                        ? mNotes.floorEntry(mNotes.lastKey() - DAY_MS) : mNotes.firstEntry();
+        final double[] first = from.getValue().get(uid);
+        for (int i = 0; i < last.length; i++) {
+            final double base = first != null && first[i] <= last[i] ? first[i] : 0;
+            out[i == 0 ? 0 : i + 1] = Math.max(0, last[i] - base);
+        }
+        out[1] = mCapacity > 0 ? out[0] * 100 / mCapacity : 0;
+        return out;
+    }
+
+    double[] offScreen(int uid) {
+        final double[] d = offScreenDetail(uid);
+        return new double[] {d[0], d[1]};
+    }
+
+    /** Alerts about the app off screen that uses much more battery than its peers. */
+    private void evaluate() {
+        final ArrayList<Double> peers = new ArrayList<>();
+        final SparseArray<double[]> uses = new SparseArray<>();
+        synchronized (this) {
+            if (mNotes.isEmpty()) {
+                return;
+            }
+            final SparseArray<double[]> last = mNotes.lastEntry().getValue();
+            for (int i = 0; i < last.size(); i++) {
+                final int uid = last.keyAt(i);
+                if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+                    continue;
+                }
+                final double[] d = offScreenDetail(uid);
+                if (d[0] > 0) {
+                    uses.put(uid, d);
+                    peers.add(d[0]);
+                }
+            }
+        }
+        if (peers.size() < 2) {
+            return;
+        }
+        Collections.sort(peers);
+        final double median = peers.get(peers.size() / 2);
+        final long now = System.currentTimeMillis();
+        for (int i = 0; i < uses.size(); i++) {
+            final int uid = uses.keyAt(i);
+            final double[] d = uses.valueAt(i);
+            if (d[1] < MIN_PERCENT || d[0] < median * PEER_FACTOR) {
+                continue;
+            }
+            int component = 0;
+            for (int c = 1; c < COMPONENTS.length; c++) {
+                if (d[2 + c] > d[2 + component]) {
+                    component = c;
+                }
+            }
+            final String[] pkgs = mContext.getPackageManager().getPackagesForUid(uid);
+            if (pkgs == null || pkgs.length == 0) {
+                continue;
+            }
+            final String pkg = pkgs[0];
+            final int usage = mService.usageOf(uid, pkg);
+            if (usage == LujarchBackground.USAGE_RESTRICTED) {
+                continue;
+            }
+            synchronized (this) {
+                final Long last = mAlerted.get(uid);
+                if (last != null && now - last < ALERT_INTERVAL_MS) {
+                    continue;
+                }
+                mAlerted.put(uid, now);
+            }
+            Slog.i(TAG, pkg + " used " + d[0] + " mAh off screen in 24 h (peers' median "
+                    + median + ")");
+            mService.notices().alertBattery(uid, pkg, d[0], d[1], COMPONENTS[component], usage);
+        }
+    }
+
+    private void load() {
+        synchronized (this) {
+            mNotes.clear();
+            for (String line : lines(mFile)) {
+                final String[] f = line.split("\t");
+                if (f.length != 3 + COMPONENTS.length) {
+                    continue;
+                }
+                try {
+                    final long hour = Long.parseLong(f[0]);
+                    final double[] v = new double[1 + COMPONENTS.length];
+                    for (int i = 0; i < v.length; i++) {
+                        v[i] = Double.parseDouble(f[2 + i]);
+                    }
+                    mNotes.computeIfAbsent(hour, h -> new SparseArray<>())
+                            .put(Integer.parseInt(f[1]), v);
+                } catch (NumberFormatException e) {
+                    Slog.w(TAG, mFile.getBaseFile() + ": a malformed line");
+                }
+            }
+        }
+    }
+
+    private void save() {
+        final StringBuilder notes = new StringBuilder();
+        synchronized (this) {
+            for (Map.Entry<Long, SparseArray<double[]>> e : mNotes.entrySet()) {
+                for (int i = 0; i < e.getValue().size(); i++) {
+                    notes.append(e.getKey()).append('\t').append(e.getValue().keyAt(i));
+                    for (double v : e.getValue().valueAt(i)) {
+                        notes.append('\t').append(v);
+                    }
+                    notes.append('\n');
+                }
+            }
+        }
+        write(mFile, notes.toString());
+    }
+
+    private static List<String> lines(AtomicFile file) {
+        final ArrayList<String> out = new ArrayList<>();
+        if (!file.exists()) {
+            return out;
+        }
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(
+                new FileInputStream(file.getBaseFile()), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                if (!line.isEmpty()) {
+                    out.add(line);
+                }
+            }
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot read " + file.getBaseFile(), e);
+        }
+        return out;
+    }
+
+    private static void write(AtomicFile file, String text) {
+        FileOutputStream out = null;
+        try {
+            out = file.startWrite();
+            out.write(text.getBytes(StandardCharsets.UTF_8));
+            file.finishWrite(out);
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot write " + file.getBaseFile(), e);
+            if (out != null) {
+                file.failWrite(out);
+            }
+        }
+    }
+}
