+    /** [who, cause] of an end, from its exit reason and who asked for it. */
+    private int[] endCause(@Nullable ApplicationExitInfo info, @Nullable Caller caller, int uid,
+            String pkg) {
+        final int user = LujarchBackground.WHO_USER;
+        final int system = LujarchBackground.WHO_SYSTEM;
+        final int app = LujarchBackground.WHO_APP;
+        if (info == null) {
+            return new int[] {system, C_END_SYSTEM};
+        }
+        final int callerWho = caller != null ? caller.who : user;
+        switch (info.getReason()) {
+            case ApplicationExitInfo.REASON_LOW_MEMORY:
+                return new int[] {system, C_END_LOW_MEMORY};
+            case ApplicationExitInfo.REASON_EXIT_SELF:
+                return new int[] {app, C_END_SELF};
+            case ApplicationExitInfo.REASON_CRASH:
+            case ApplicationExitInfo.REASON_CRASH_NATIVE:
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE:
+                return new int[] {app, C_END_CRASH};
+            case ApplicationExitInfo.REASON_ANR:
+                return new int[] {app, C_END_ANR};
+            case ApplicationExitInfo.REASON_FREEZER:
+                return new int[] {system, C_END_FREEZER};
+            case ApplicationExitInfo.REASON_PERMISSION_CHANGE:
+                return new int[] {user, C_END_PERMISSION};
+            case ApplicationExitInfo.REASON_PACKAGE_UPDATED:
+            case ApplicationExitInfo.REASON_PACKAGE_STATE_CHANGE:
+                return new int[] {system, C_END_UPDATE};
+            case ApplicationExitInfo.REASON_USER_REQUESTED:
+                switch (info.getSubReason()) {
+                    case ApplicationExitInfo.SUBREASON_FORCE_STOP:
+                        return new int[] {callerWho, C_STOP};
+                    case ApplicationExitInfo.SUBREASON_REMOVE_TASK:
+                        return new int[] {user, C_END_CARD};
+                    case ApplicationExitInfo.SUBREASON_KILL_BACKGROUND:
+                    case ApplicationExitInfo.SUBREASON_STOP_APP:
+                    case ApplicationExitInfo.SUBREASON_KILL_PID:
+                        return new int[] {callerWho,
+                                callerWho == LujarchBackground.WHO_OTHER ? C_END_BY : C_END_YOU};
+                    default:
+                        return new int[] {callerWho, C_END_YOU};
+                }
+            case ApplicationExitInfo.REASON_OTHER:
+                switch (info.getSubReason()) {
+                    case ApplicationExitInfo.SUBREASON_TOO_MANY_CACHED:
+                    case ApplicationExitInfo.SUBREASON_LARGE_CACHED:
+                    case ApplicationExitInfo.SUBREASON_MEMORY_PRESSURE:
+                    case ApplicationExitInfo.SUBREASON_OOM_KILL:
+                        return new int[] {system, C_END_TOO_MANY};
+                    case ApplicationExitInfo.SUBREASON_TOO_MANY_EMPTY:
+                    case ApplicationExitInfo.SUBREASON_TRIM_EMPTY:
+                    case ApplicationExitInfo.SUBREASON_ISOLATED_NOT_NEEDED:
+                        return new int[] {system, C_END_UNUSED};
+                    case ApplicationExitInfo.SUBREASON_CACHED_IDLE_FORCED_APP_STANDBY:
+                        return new int[] {user, C_END_RESTRICTED};
+                    case ApplicationExitInfo.SUBREASON_REMOVE_TASK:
+                        return new int[] {user, C_END_CARD};
+                    default:
+                        return new int[] {system, C_END_SYSTEM};
+                }
+            case ApplicationExitInfo.REASON_SIGNALED:
+                return caller != null ? new int[] {callerWho,
+                        callerWho == LujarchBackground.WHO_OTHER ? C_END_BY : C_END_YOU}
+                        : new int[] {system, C_END_SYSTEM};
+            default:
+                return new int[] {system, C_END_SYSTEM};
+        }
+    }
