index 0000000000000000000000000000000000000000..74b0c341c171879ac23d633c3eb3ecb9a8403286
--- /dev/null
+++ b/services/core/java/com/android/server/am/LujarchBackgroundRuns.java
@@ -0,0 +1,319 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.am;
+
+import android.annotation.Nullable;
+import android.util.ArrayMap;
+import android.util.AtomicFile;
+import android.util.Slog;
+
+import com.android.internal.app.LujarchBackground;
+import com.android.internal.app.LujarchBackgroundRun;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Each app process's run state minute by minute for the last 7 days (BG-1): one line per process
+ * and day, each minute holding the state nearest to the screen the process was in during it.
+ * Written to /data/lujarch/background/runs, one line per process and day, run-length encoded.
+ */
+final class LujarchBackgroundRuns {
+    private static final String TAG = LujarchBackgroundService.TAG;
+    private static final int DAYS = 7;
+    private static final long MINUTE_MS = 60_000;
+
+    /** One process of an app: its state now and since when, and its days. */
+    private static final class Line {
+        byte state = LujarchBackground.RUN_NONE;
+        long since;
+        /** Local midnight to the day's minutes. */
+        final TreeMap<Long, byte[]> days = new TreeMap<>();
+    }
+
+    private final AtomicFile mFile;
+    /** "userId:package" to its processes by short name. */
+    private final ArrayMap<String, ArrayMap<String, Line>> mByApp = new ArrayMap<>();
+    private boolean mDirty;
+
+    LujarchBackgroundRuns(File dir) {
+        mFile = new AtomicFile(new File(dir, "runs"));
+    }
+
+    /** The process is in this state from now on. */
+    synchronized void note(String app, String process, byte state, long now) {
+        final Line line = line(app, process);
+        if (line.state == state) {
+            mark(line, state, now);
+            return;
+        }
+        fill(line, now);
+        line.state = state;
+        line.since = now;
+        mark(line, state, now);
+        mDirty = true;
+    }
+
+    /** Every process of the app that is not running any more is in this state from now on. */
+    synchronized void noteGone(String app, List<String> running, byte state, long now) {
+        final ArrayMap<String, Line> lines = mByApp.get(app);
+        if (lines == null) {
+            return;
+        }
+        for (int i = 0; i < lines.size(); i++) {
+            final Line line = lines.valueAt(i);
+            if (!running.contains(lines.keyAt(i)) && line.state != state
+                    && line.state != LujarchBackground.RUN_NONE) {
+                fill(line, now);
+                line.state = state;
+                line.since = now;
+                mDirty = true;
+            }
+        }
+    }
+
+    /** The lines of the app's processes through the day starting at local midnight dayStart. */
+    synchronized LujarchBackgroundRun[] day(String app, long dayStart, long now) {
+        final ArrayList<LujarchBackgroundRun> out = new ArrayList<>();
+        final ArrayMap<String, Line> lines = mByApp.get(app);
+        if (lines != null) {
+            for (int i = 0; i < lines.size(); i++) {
+                final Line line = lines.valueAt(i);
+                fill(line, now);
+                final byte[] minutes = line.days.get(dayStart);
+                if (minutes == null || isEmpty(minutes)) {
+                    continue;
+                }
+                final LujarchBackgroundRun run = new LujarchBackgroundRun();
+                run.name = lines.keyAt(i);
+                run.minutes = minutes.clone();
+                out.add(run);
+            }
+        }
+        // The main process first, the others by name.
+        out.sort((a, b) -> {
+            final boolean am = !a.name.startsWith(":");
+            final boolean bm = !b.name.startsWith(":");
+            return am != bm ? (am ? -1 : 1) : a.name.compareTo(b.name);
+        });
+        return out.toArray(new LujarchBackgroundRun[0]);
+    }
+
+    synchronized void remove(String app) {
+        if (mByApp.remove(app) != null) {
+            mDirty = true;
+        }
+    }
+
+    private Line line(String app, String process) {
+        ArrayMap<String, Line> lines = mByApp.get(app);
+        if (lines == null) {
+            lines = new ArrayMap<>();
+            mByApp.put(app, lines);
+        }
+        Line line = lines.get(process);
+        if (line == null) {
+            line = new Line();
+            lines.put(process, line);
+        }
+        return line;
+    }
+
+    /** Writes the line's state into every minute from its start up to now. */
+    private void fill(Line line, long now) {
+        if (line.state == LujarchBackground.RUN_NONE || line.since <= 0) {
+            line.since = now;
+            return;
+        }
+        final long from = Math.max(line.since, now - DAYS * 24 * 60 * MINUTE_MS);
+        for (long t = from / MINUTE_MS * MINUTE_MS; t <= now; t += MINUTE_MS) {
+            mark(line, line.state, Math.max(t, from));
+        }
+        line.since = now;
+        mDirty = true;
+    }
+
+    /** The minute of the time holds the state unless one nearer to the screen is there. */
+    private void mark(Line line, byte state, long time) {
+        if (state == LujarchBackground.RUN_NONE) {
+            return;
+        }
+        final long day = dayStart(time);
+        byte[] minutes = line.days.get(day);
+        if (minutes == null) {
+            minutes = new byte[LujarchBackground.RUN_MINUTES];
+            line.days.put(day, minutes);
+            while (line.days.size() > DAYS) {
+                line.days.pollFirstEntry();
+            }
+        }
+        final int m = (int) Math.min(LujarchBackground.RUN_MINUTES - 1,
+                Math.max(0, (time - day) / MINUTE_MS));
+        if (minutes[m] == LujarchBackground.RUN_NONE || state < minutes[m]) {
+            minutes[m] = state;
+        }
+    }
+
+    /** Local midnight of the day the time is in. */
+    static long dayStart(long time) {
+        final ZoneId zone = ZoneId.systemDefault();
+        return LocalDate.ofInstant(Instant.ofEpochMilli(time), zone).atStartOfDay(zone)
+                .toInstant().toEpochMilli();
+    }
+
+    private static boolean isEmpty(byte[] minutes) {
+        for (byte b : minutes) {
+            if (b != LujarchBackground.RUN_NONE) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    synchronized void load() {
+        mByApp.clear();
+        if (!mFile.exists()) {
+            return;
+        }
+        final long oldest = dayStart(System.currentTimeMillis()) - (DAYS - 1) * 24 * 60 * MINUTE_MS;
+        int bad = 0;
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(
+                new FileInputStream(mFile.getBaseFile()), StandardCharsets.UTF_8))) {
+            String text;
+            while ((text = r.readLine()) != null) {
+                // app, process, day, state now, since, the day's minutes as state*count runs
+                final String[] f = text.split("\t", -1);
+                if (f.length != 6) {
+                    bad++;
+                    continue;
+                }
+                try {
+                    final long day = Long.parseLong(f[2]);
+                    final Line line = line(f[0], f[1]);
+                    line.state = Byte.parseByte(f[3]);
+                    line.since = Long.parseLong(f[4]);
+                    if (day >= oldest) {
+                        line.days.put(day, decode(f[5]));
+                    }
+                } catch (IllegalArgumentException e) {
+                    bad++;
+                }
+            }
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot read " + mFile.getBaseFile(), e);
+        }
+        if (bad > 0) {
+            Slog.w(TAG, mFile.getBaseFile() + ": " + bad + " malformed lines dropped");
+        }
+    }
+
+    void save() {
+        final StringBuilder out = new StringBuilder();
+        synchronized (this) {
+            if (!mDirty) {
+                return;
+            }
+            mDirty = false;
+            final long now = System.currentTimeMillis();
+            for (int i = mByApp.size() - 1; i >= 0; i--) {
+                final ArrayMap<String, Line> lines = mByApp.valueAt(i);
+                for (int j = lines.size() - 1; j >= 0; j--) {
+                    final Line line = lines.valueAt(j);
+                    fill(line, now);
+                    if (line.days.isEmpty()) {
+                        lines.removeAt(j);
+                        continue;
+                    }
+                    for (Map.Entry<Long, byte[]> d : line.days.entrySet()) {
+                        out.append(mByApp.keyAt(i)).append('\t').append(lines.keyAt(j))
+                                .append('\t').append(d.getKey()).append('\t').append(line.state)
+                                .append('\t').append(line.since).append('\t')
+                                .append(encode(d.getValue())).append('\n');
+                    }
+                }
+                if (lines.isEmpty()) {
+                    mByApp.removeAt(i);
+                }
+            }
+        }
+        FileOutputStream stream = null;
+        try {
+            stream = mFile.startWrite();
+            final Writer w = new OutputStreamWriter(stream, StandardCharsets.UTF_8);
+            w.write(out.toString());
+            w.flush();
+            mFile.finishWrite(stream);
+        } catch (IOException e) {
+            Slog.e(TAG, "cannot write " + mFile.getBaseFile(), e);
+            if (stream != null) {
+                mFile.failWrite(stream);
+            }
+            synchronized (this) {
+                mDirty = true;
+            }
+        }
+    }
+
+    /** "3*120,4*600,0*720": each state with the number of minutes in a row. */
+    private static String encode(byte[] minutes) {
+        final StringBuilder b = new StringBuilder();
+        int i = 0;
+        while (i < minutes.length) {
+            int j = i;
+            while (j < minutes.length && minutes[j] == minutes[i]) {
+                j++;
+            }
+            if (b.length() > 0) {
+                b.append(',');
+            }
+            b.append(minutes[i]).append('*').append(j - i);
+            i = j;
+        }
+        return b.toString();
+    }
+
+    private static byte[] decode(@Nullable String text) {
+        final byte[] minutes = new byte[LujarchBackground.RUN_MINUTES];
+        if (text == null || text.isEmpty()) {
+            return minutes;
+        }
+        int at = 0;
+        for (String run : text.split(",")) {
+            final int star = run.indexOf('*');
+            final byte state = Byte.parseByte(run.substring(0, star));
+            final int count = Integer.parseInt(run.substring(star + 1));
+            for (int k = 0; k < count && at < minutes.length; k++) {
+                minutes[at++] = state;
+            }
+        }
+        return minutes;
+    }
+}
