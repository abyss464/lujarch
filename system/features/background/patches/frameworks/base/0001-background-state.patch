+package com.android.internal.app;
+
+import com.android.internal.app.LujarchBackgroundProcess;
+
+/**
+ * Where one app is: its depth, who put it there and why, what it uses, and its choices.
+ * @hide
+ */
+parcelable LujarchBackgroundApp {
+    @nullable String packageName;
+    int uid;
+    @nullable String label;
+    /** LujarchBackground.DEPTH_*. */
+    int depth;
+    /** LujarchBackground.WHO_*. */
+    int who;
+    /** Who, in words: You, System, App, or the other app's name. */
+    @nullable String whoName;
+    /** Why it is at its depth, in words. */
+    @nullable String reason;
+    /** One word for Recents' Running layer: Navigating, Playing, Small window, ... */
+    @nullable String word;
+    /** When it reached this depth, as System.currentTimeMillis(); 0 when not known. */
+    long sinceMillis;
+    long memoryBytes;
+    long swapBytes;
+    /** The system's own app or process. */
+    boolean system;
+    /** Keep is on. */
+    boolean kept;
+    /** LujarchBackground.USAGE_*. */
+    int usage;
+    /** Background usage cannot be changed for this app. */
+    boolean usageFixed;
+    /** Runs a foreground service of its own (End stops it). */
+    boolean ownService;
+    /** Shown in a small window (Close closes it). */
+    boolean smallWindow;
+    /** The task of its small window or its card in Recents; -1 without one. */
+    int taskId;
+    /** Has a card in Recents. */
+    boolean hasTask;
+    /** Running only on its way to Paused (the freezer waits a moment), or not needed. */
+    boolean settling;
+    /** Its running notification folds into Background. */
+    boolean folded;
+    int processCount;
+    /** Processes that are not paused. */
+    int runningCount;
+    /** Battery used off screen in the last 24 hours, in mAh and in percent of the battery. */
+    double batteryMah;
+    double batteryPercent;
+    /** Times woken in the last 24 hours. */
+    int wakeups;
+    /** Time running off screen in the last 24 hours. */
+    long backgroundMs;
+    /** Filled for one app only (getApp). */
+    @nullable LujarchBackgroundProcess[] processes;
+}
