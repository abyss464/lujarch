+        /** "Perceptible (lujarch-chosen, oom_adj 200, FGS)": the system's priority. */
+        String priority(Proc p) {
+            final int res;
+            final int adj = p.adj;
+            if (adj < FOREGROUND_APP_ADJ) {
+                res = R.string.lujarch_background_p_system;
+            } else if (adj < VISIBLE_APP_ADJ) {
+                res = R.string.lujarch_background_p_foreground;
+            } else if (adj < PERCEPTIBLE_APP_ADJ) {
+                res = R.string.lujarch_background_p_visible;
+            } else if (adj < BACKUP_APP_ADJ) {
+                res = R.string.lujarch_background_p_perceptible;
+            } else if (adj < HEAVY_WEIGHT_APP_ADJ) {
+                res = R.string.lujarch_background_p_backup;
+            } else if (adj < SERVICE_ADJ) {
+                res = R.string.lujarch_background_p_heavy;
+            } else if (adj < HOME_APP_ADJ) {
+                res = R.string.lujarch_background_p_service;
+            } else if (adj < PREVIOUS_APP_ADJ) {
+                res = R.string.lujarch_background_p_home;
+            } else if (adj < SERVICE_B_ADJ) {
+                res = R.string.lujarch_background_p_previous;
+            } else if (adj < CACHED_APP_MIN_ADJ) {
+                res = R.string.lujarch_background_p_service;
+            } else {
+                res = R.string.lujarch_background_p_cached;
+            }
+            final String raw = (p.adjType != null ? p.adjType + ", " : "") + "oom_adj " + adj
+                    + ", " + ProcessList.makeProcStateString(p.procState).trim();
+            return c.getString(R.string.lujarch_background_priority, c.getString(res), raw);
+        }
