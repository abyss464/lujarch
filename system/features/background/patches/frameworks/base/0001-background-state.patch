+        /** "Perceptible (lujarch-messages, oom_adj 200, FGS)": the system's priority. */
+        String priority(Proc p) {
+            final int res;
+            final int adj = p.adj;
+            if (adj < FOREGROUND_APP_ADJ) {
+                res = R.string.lujarch_background_p_system;
+            } else if (adj < VISIBLE_APP_ADJ) {
+                res = R.string.lujarch_background_p_foreground;
+            } else if (adj < PERCEPTIBLE_APP_ADJ) {
+                res = R.string.lujarch_background_p_visible;
+            } else if (adj < BACKUP_APP_ADJ) {
+                res = R.string.lujarch_background_p_perceptible;
+            } else if (adj < HEAVY_WEIGHT_APP_ADJ) {
+                res = R.string.lujarch_background_p_backup;
+            } else if (adj < SERVICE_ADJ) {
+                res = R.string.lujarch_background_p_heavy;
+            } else if (adj < HOME_APP_ADJ) {
+                res = R.string.lujarch_background_p_service;
+            } else if (adj < PREVIOUS_APP_ADJ) {
+                res = R.string.lujarch_background_p_home;
+            } else if (adj < SERVICE_B_ADJ) {
+                res = R.string.lujarch_background_p_previous;
+            } else if (adj < CACHED_APP_MIN_ADJ) {
+                res = R.string.lujarch_background_p_service;
+            } else {
+                res = R.string.lujarch_background_p_cached;
+            }
+            final String raw = (p.adjType != null ? p.adjType + ", " : "") + "oom_adj " + adj
+                    + ", " + ProcessList.makeProcStateString(p.procState).trim();
+            return c.getString(R.string.lujarch_background_priority, c.getString(res), raw);
+        }
+
+        String threadState(char state) {
+            switch (state) {
+                case 'R':
+                    return c.getString(R.string.lujarch_background_thread_running);
+                case 'D':
+                    return c.getString(R.string.lujarch_background_thread_waiting);
+                case 'T':
+                case 't':
+                    return c.getString(R.string.lujarch_background_thread_stopped);
+                default:
+                    return c.getString(R.string.lujarch_background_thread_sleeping);
+            }
+        }
+
+        private String capitalize(String s) {
+            if (s.isEmpty() || !Character.isLowerCase(s.charAt(0))) {
+                return s;
+            }
+            return Character.toUpperCase(s.charAt(0)) + s.substring(1);
+        }
+    }
+
+    Words words() {
+        return new Words();
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // The API (ILujarchBackground)
+
+    private void enforce() {
+        mContext.enforceCallingOrSelfPermission(LujarchBackground.PERMISSION, TAG);
+    }
+
+    private void ready() {
+        if (!mReady) {
+            throw new IllegalStateException("Background is starting");
+        }
+    }
+
+    @Override
+    public LujarchBackgroundMemory getMemory() {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
