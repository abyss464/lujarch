+        /** The one word of Recents' Running layer for an app. */
+        String word(LujarchBackgroundApp a, List<Proc> procs, @Nullable AppState s) {
+            if (a.smallWindow) {
+                return LujarchBackground.stateName(c, LujarchBackground.RUN_SMALL_WINDOW);
+            }
+            if (s != null && s.lead != null && s.lead.cause == C_CHOSEN) {
+                return c.getString(R.string.lujarch_background_usage_chosen);
+            }
+            int types = 0;
+            for (Proc p : procs) {
+                types |= p.fgs ? p.fgsTypes : 0;
+            }
+            if (a.ownService) {
+                return fgsWord(types);
+            }
+            if (a.usage == LujarchBackground.USAGE_UNRESTRICTED
+                    && a.state == LujarchBackground.RUN_BACKGROUND) {
+                return LujarchBackground.usageName(c, LujarchBackground.USAGE_UNRESTRICTED);
+            }
+            if (a.kept && a.state == LujarchBackground.RUN_PAUSED) {
+                return c.getString(R.string.lujarch_background_kept);
+            }
+            return LujarchBackground.stateName(c, a.state);
+        }
