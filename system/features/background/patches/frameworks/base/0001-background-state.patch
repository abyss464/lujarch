diff --git a/core/java/com/android/internal/app/LujarchBackground.java b/core/java/com/android/internal/app/LujarchBackground.java
new file mode 100644
index 0000000000000000000000000000000000000000..4ef85af9bd94fe5ee6f05a2420c0c279a0ed61ad
--- /dev/null
+++ b/core/java/com/android/internal/app/LujarchBackground.java
@@ -0,0 +1,270 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.internal.app;
+
+import android.annotation.ColorInt;
+import android.annotation.Nullable;
+import android.content.Context;
+import android.os.IBinder;
+import android.os.ServiceManager;
+
+import com.android.internal.R;
+
+/**
+ * Lujarch's Background for the surfaces that show it (Settings, the shade, Recents): the run
+ * states, who put an app there, its choices, and the one color of each state.
+ *
+ * @hide
+ */
+public final class LujarchBackground {
+    /** The system service, {@link ILujarchBackground}. */
+    public static final String SERVICE = "lujarch_background";
+    /** Held by the callers of {@link ILujarchBackground}. */
+    public static final String PERMISSION = "android.permission.LUJARCH_BACKGROUND";
+
+    public static final int WHO_USER = 1;
+    public static final int WHO_SYSTEM = 2;
+    /** The app itself. */
+    public static final int WHO_APP = 3;
+    /** Another app, named by whoName. */
+    public static final int WHO_OTHER = 4;
+
+    /** Allow background usage (BG-2). */
+    public static final int USAGE_UNRESTRICTED = 0;
+    /** Chosen processes: the processes the owner ticked keep running; the rest as Optimized. */
+    public static final int USAGE_CHOSEN = 1;
+    public static final int USAGE_OPTIMIZED = 2;
+    public static final int USAGE_RESTRICTED = 3;
+
+    /** What happened to an app. */
+    public static final int EVENT_LEFT = 1;
+    public static final int EVENT_OPENED = 2;
+    public static final int EVENT_PAUSED = 3;
+    public static final int EVENT_WOKEN = 4;
+    public static final int EVENT_ENDED = 5;
+    public static final int EVENT_STOPPED = 6;
+    public static final int EVENT_STARTED = 7;
+
+    /**
+     * A run state (BG-1), of an app, of a process, and of a minute of a process's line
+     * ({@link LujarchBackgroundRun}), where it is the nearest to the screen the process was in.
+     * A smaller value is nearer to the screen.
+     */
+    public static final byte RUN_NONE = 0;
+    public static final byte RUN_FOREGROUND = 1;
+    public static final byte RUN_SMALL_WINDOW = 2;
+    /**
+     * Running in background: playback, navigation, a download, Unrestricted, or a process the
+     * owner chose.
+     */
+    public static final byte RUN_BACKGROUND = 3;
+    /** Paused: frozen in memory, using no CPU, back as it was. */
+    public static final byte RUN_PAUSED = 4;
+    /** Reclaimed: its processes have ended; it starts again when opened. */
+    public static final byte RUN_RECLAIMED = 5;
+    /** Stopped: force stopped; it does not run again until it is opened. */
+    public static final byte RUN_STOPPED = 6;
+    /** Minutes in a process's line for one day. */
+    public static final int RUN_MINUTES = 24 * 60;
+
+    /**
+     * A broken choice (BG-3): a chosen process keeps calling the paused main process, which the
+     * system then ends.
+     */
+    public static final int SUGGEST_LOOP = 1;
+    /** A chosen process ended right after the main process, without the system ending it. */
+    public static final int SUGGEST_LEFT_WITH_MAIN = 2;
+
+    /** Settings > System > Memory (BG-5). */
+    public static final String ACTION_MEMORY = "org.lujarch.background.action.MEMORY";
+    /**
+     * Settings > Apps > (app) > Memory (BG-6), for Intent.EXTRA_PACKAGE_NAME and
+     * Intent.EXTRA_USER.
+     */
+    public static final String ACTION_APP_MEMORY = "org.lujarch.background.action.APP_MEMORY";
+    /**
+     * With Settings.ACTION_VIEW_ADVANCED_POWER_USAGE_DETAIL: open the app's Allow background
+     * usage page (BG-2) instead of its App battery usage.
+     */
+    public static final String EXTRA_ALLOW_BACKGROUND_USAGE =
+            "org.lujarch.background.extra.ALLOW_BACKGROUND_USAGE";
+    /** The package of the memory pages. */
+    public static final String SETTINGS_PACKAGE = "org.lujarch.settings";
+
+    /** Settings.Secure: Recents shows its Running layer (BG-8). */
+    public static final String SETTING_RECENTS_RUNNING = "lujarch_background_recents_running";
+    /** Settings.Secure: Recents shows the memory (BG-11). */
+    public static final String SETTING_RECENTS_MEMORY = "lujarch_background_recents_memory";
+    /** Settings.Secure: Recents shows each app's state and folds into two rows (BG-10). */
+    public static final String SETTING_RECENTS_STATE = "lujarch_background_recents_state";
+
+    private LujarchBackground() {
+    }
+
+    /** The service, or null while the system does not offer it. */
+    @Nullable
+    public static ILujarchBackground get() {
+        final IBinder binder = ServiceManager.getService(SERVICE);
+        return binder != null ? ILujarchBackground.Stub.asInterface(binder) : null;
+    }
+
+    /**
+     * The color of a run state, the same wherever the state is shown: tones of the system's
+     * accent, nearer to the page's own color for a state farther from the screen, and still apart
+     * from it in both the light and the dark theme.
+     */
+    @ColorInt
+    public static int stateColor(Context context, int state) {
+        return context.getColor(accentTone(tone(context, state)));
+    }
+
+    /** The outline of a state's mark: only Stopped has one, dashed. */
+    @ColorInt
+    public static int stateOutline(Context context, int state) {
+        return context.getColor(state == RUN_STOPPED
+                ? accentTone(isNight(context) ? 400 : 500) : android.R.color.transparent);
+    }
+
+    /** The text on a state's color. */
+    @ColorInt
+    public static int onStateColor(Context context, int state) {
+        return context.getColor(tone(context, state) >= 500 ? android.R.color.system_accent1_10
+                : android.R.color.system_accent1_900);
+    }
+
+    private static int tone(Context context, int state) {
+        final int i = Math.max(RUN_FOREGROUND, Math.min(RUN_STOPPED, state)) - RUN_FOREGROUND;
+        return (isNight(context) ? DARK_TONES : LIGHT_TONES)[i];
+    }
+
+    /** Tones from Foreground to Stopped. */
+    private static final int[] LIGHT_TONES = {800, 700, 600, 400, 300, 200};
+    private static final int[] DARK_TONES = {100, 200, 300, 500, 600, 700};
+
+    private static boolean isNight(Context context) {
+        return (context.getResources().getConfiguration().uiMode
+                & android.content.res.Configuration.UI_MODE_NIGHT_MASK)
+                == android.content.res.Configuration.UI_MODE_NIGHT_YES;
+    }
+
+    private static int accentTone(int tone) {
+        switch (tone) {
+            case 100: return android.R.color.system_accent1_100;
+            case 200: return android.R.color.system_accent1_200;
+            case 300: return android.R.color.system_accent1_300;
+            case 400: return android.R.color.system_accent1_400;
+            case 500: return android.R.color.system_accent1_500;
+            case 600: return android.R.color.system_accent1_600;
+            case 700: return android.R.color.system_accent1_700;
+            default: return android.R.color.system_accent1_800;
+        }
+    }
+
+    /** The color of who caused it: User filled, System outlined, an app dashed. */
+    @ColorInt
+    public static int whoColor(Context context, int who) {
+        switch (who) {
+            case WHO_USER:
+                return context.getColor(android.R.color.system_accent1_500);
+            case WHO_SYSTEM:
+                return context.getColor(android.R.color.system_accent3_500);
+            default:
+                return context.getColor(android.R.color.system_accent2_500);
+        }
+    }
+
+    /** The four parts of the memory in use (BG-5, BG-11). */
+    public static final int MEMORY_SYSTEM = 0;
+    public static final int MEMORY_APPS = 1;
+    public static final int MEMORY_KEPT = 2;
+    public static final int MEMORY_FREE = 3;
+
+    /** The color of a part of the memory, the same on the memory page and in Recents. */
+    @ColorInt
+    public static int memoryColor(Context context, int part) {
+        final boolean night = isNight(context);
+        switch (part) {
+            case MEMORY_SYSTEM:
+                return context.getColor(android.R.color.system_neutral2_500);
+            case MEMORY_APPS:
+                return stateColor(context, RUN_BACKGROUND);
+            case MEMORY_KEPT:
+                return stateColor(context, RUN_PAUSED);
+            default:
+                return context.getColor(night ? android.R.color.system_neutral2_800
+                        : android.R.color.system_neutral2_100);
+        }
+    }
+
+    /** The name of a part of the memory. */
+    public static String memoryName(Context context, int part) {
+        switch (part) {
+            case MEMORY_SYSTEM:
+                return context.getString(R.string.lujarch_background_who_system);
+            case MEMORY_APPS:
+                return context.getString(R.string.lujarch_background_memory_apps);
+            case MEMORY_KEPT:
+                return context.getString(R.string.lujarch_background_kept);
+            default:
+                return context.getString(R.string.lujarch_background_memory_free);
+        }
+    }
+
+    /** The name of who caused it: User, System, App; another app by its own name. */
+    public static String whoName(Context context, int who) {
+        switch (who) {
+            case WHO_USER:
+                return context.getString(R.string.lujarch_background_who_user);
+            case WHO_SYSTEM:
+                return context.getString(R.string.lujarch_background_who_system);
+            default:
+                return context.getString(R.string.lujarch_background_who_app);
+        }
+    }
+
+    /** The name of a run state. */
+    public static String stateName(Context context, int state) {
+        switch (state) {
+            case RUN_FOREGROUND:
+                return context.getString(R.string.lujarch_background_state_foreground);
+            case RUN_SMALL_WINDOW:
+                return context.getString(R.string.lujarch_background_state_small_window);
+            case RUN_BACKGROUND:
+                return context.getString(R.string.lujarch_background_state_background);
+            case RUN_PAUSED:
+                return context.getString(R.string.lujarch_background_state_paused);
+            case RUN_RECLAIMED:
+                return context.getString(R.string.lujarch_background_state_reclaimed);
+            default:
+                return context.getString(R.string.lujarch_background_state_stopped);
+        }
+    }
+
+    /** The name of a Background usage choice. */
+    public static String usageName(Context context, int usage) {
+        switch (usage) {
+            case USAGE_UNRESTRICTED:
+                return context.getString(R.string.lujarch_background_usage_unrestricted);
+            case USAGE_CHOSEN:
+                return context.getString(R.string.lujarch_background_usage_chosen);
+            case USAGE_RESTRICTED:
+                return context.getString(R.string.lujarch_background_usage_restricted);
+            default:
+                return context.getString(R.string.lujarch_background_usage_optimized);
+        }
+    }
+}
