+        mAppOps.startWatchingMode(AppOpsManager.OP_LUJARCH_KEEP, null, choices);
+        mAppOps.startWatchingMode(AppOpsManager.OP_LUJARCH_CHOSEN_PROCESSES, null, choices);
+        mAppOps.startWatchingMode(AppOpsManager.OP_RUN_ANY_IN_BACKGROUND, null, choices);
+        try {
+            mAm.registerUidObserver(mUidObserver, ActivityManager.UID_OBSERVER_PROCSTATE
+                    | ActivityManager.UID_OBSERVER_GONE, PROCESS_STATE_TOP_SLEEPING, "android");
+            mAm.mActivityTaskManager.registerTaskStackListener(mTaskListener);
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "cannot watch the apps' states", e);
+        }
+        mAm.mInternal.addForegroundServiceStateListener(
+                new ActivityManagerInternal.ForegroundServiceStateListener() {
+                    @Override
+                    public void onForegroundServiceStateChanged(String packageName, int uid,
+                            int pid, boolean started) {
+                        mHandler.post(() -> evaluate(UserHandle.getUserId(uid), packageName,
+                                null));
+                    }
+
+                    @Override
+                    public void onForegroundServiceNotificationUpdated(String packageName,
+                            int uid, int foregroundId, boolean canceling) {
+                        mHandler.post(() -> changed());
+                    }
+                });
+        final IntentFilter removed = new IntentFilter(Intent.ACTION_PACKAGE_FULLY_REMOVED);
+        removed.addDataScheme("package");
+        mContext.registerReceiverForAllUsers(new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                final String pkg = intent.getData() != null
+                        ? intent.getData().getSchemeSpecificPart() : null;
+                final int uid = intent.getIntExtra(Intent.EXTRA_UID, -1);
+                if (pkg != null && uid >= 0) {
+                    mRecord.remove(UserHandle.getUserId(uid), pkg);
+                    mRuns.remove(LujarchBackgroundRecord.key(UserHandle.getUserId(uid), pkg));
+                    synchronized (mLock) {
+                        mChosen.remove(uid + ":" + pkg);
+                        mSuggestions.remove(uid + ":" + pkg);
+                    }
+                    saveChosen();
+                    scheduleSave();
