+package com.android.internal.app;
+
+import com.android.internal.app.ILujarchBackgroundListener;
+import com.android.internal.app.LujarchBackgroundApp;
+import com.android.internal.app.LujarchSmallWindow;
+import com.android.internal.app.LujarchBackgroundEvent;
+import com.android.internal.app.LujarchBackgroundMemory;
+import com.android.internal.app.LujarchBackgroundProcess;
+import com.android.internal.app.LujarchBackgroundRun;
+import com.android.internal.app.LujarchBackgroundSuggestion;
+
+/**
+ * Where every app is in the background, why and who put it there (Lujarch's Background): the one
+ * source Settings, the shade and Recents read. Callers hold android.permission.LUJARCH_BACKGROUND.
+ * @hide
+ */
+interface ILujarchBackground {
+    LujarchBackgroundMemory getMemory();
+
+    /** Every app of the user with a process, a card in Recents or a recent end; withSystem adds the system's processes. */
+    LujarchBackgroundApp[] getApps(int userId, boolean withSystem);
+
+    /** One app with its processes; null when the package is not installed. */
+    @nullable LujarchBackgroundApp getApp(String packageName, int userId);
+
+    /** Lujarch's system services that run, each as its process (BG-5). */
+    LujarchBackgroundProcess[] getServices();
+    /** One process with its reasons and threads; null when it does not run. */
+    @nullable LujarchBackgroundProcess getProcess(int pid);
+
+    /** What happened to the app since sinceMillis, newest first, at most max lines. */
+    LujarchBackgroundEvent[] getEvents(String packageName, int userId, long sinceMillis, int max);
+
+    /** Allow background usage: LujarchBackground.USAGE_*. */
+    void setBackgroundUsage(String packageName, int userId, int usage);
+
+    /**
+     * Chosen processes, by their short names: those keep running after the app leaves the
+     * screen. Sets the app's background usage to Chosen processes.
+     */
+    void setChosenProcesses(String packageName, int userId, in String[] names);
+
+    void setKept(String packageName, int userId, boolean kept);
+
+    /** The app's processes through the day that starts at local midnight dayStartMillis. */
+    LujarchBackgroundRun[] getRunState(String packageName, int userId, long dayStartMillis);
+
+    /** The broken choice that waits for the owner, or null (BG-3). */
+    @nullable LujarchBackgroundSuggestion getSuggestion(String packageName, int userId);
+
+    /** Add the main process (accept), or let the suggestion go; either removes its alert. */
+    void answerSuggestion(String packageName, int userId, boolean accept);
+
+    /**
+     * What runs off screen, in the order of Recents' Running layer: what the apps run
+     * themselves, small windows, Unrestricted, Chosen processes (BG-8).
+     */
+    LujarchBackgroundApp[] getRunning(int userId);
+
+    void addRunningListener(ILujarchBackgroundListener listener);
+
+    void removeRunningListener(ILujarchBackgroundListener listener);
+
+    /** Recents showed its Running layer: nothing started since is unseen. */
+    void markRunningSeen();
+
+    /** End running: stops what the app runs of its own (its foreground services). */
+    void endForegroundServices(String packageName, int userId);
+
+    void closeSmallWindow(int taskId);
+
+    /** The small windows, from the Shell that shows them, in the order of the screen. */
+    oneway void setSmallWindows(in LujarchSmallWindow[] windows);
+
+    /** The small windows as the Shell last told them. */
+    LujarchSmallWindow[] getSmallWindows();
+
+    /** End this process, once; it then follows its app's choices again. */
+    void endProcess(int pid);
+}
