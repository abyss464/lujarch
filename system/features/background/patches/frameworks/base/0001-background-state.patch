+        private boolean sameDay(long a, long b) {
+            final java.util.Calendar x = java.util.Calendar.getInstance();
+            x.setTimeInMillis(a);
+            final java.util.Calendar y = java.util.Calendar.getInstance();
+            y.setTimeInMillis(b);
+            return x.get(java.util.Calendar.DAY_OF_YEAR) == y.get(java.util.Calendar.DAY_OF_YEAR)
+                    && x.get(java.util.Calendar.YEAR) == y.get(java.util.Calendar.YEAR);
+        }
