+    // ---------------------------------------------------------------------------------------
+    // The API (ILujarchBackground)
+
+    private void enforce() {
+        mContext.enforceCallingOrSelfPermission(LujarchBackground.PERMISSION, TAG);
+    }
+
+    private void ready() {
+        if (!mReady) {
+            throw new IllegalStateException("Background is starting");
+        }
+    }
+
+    @Override
+    public LujarchBackgroundMemory getMemory() {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            return memory();
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public LujarchBackgroundApp[] getApps(int userId, boolean withSystem) {
+        enforce();
+        ready();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            return apps(userId, withSystem, false, null).toArray(new LujarchBackgroundApp[0]);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public LujarchBackgroundApp getApp(String packageName, int userId) {
+        enforce();
+        ready();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final ArrayList<LujarchBackgroundApp> list = apps(userId, true, true, packageName);
+            if (!list.isEmpty()) {
+                return list.get(0);
+            }
+            return describeIdle(packageName, userId);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    /** An app with no process and nothing in the record: not running. */
+    @Nullable
+    private LujarchBackgroundApp describeIdle(String packageName, int userId) {
+        final ApplicationInfo info;
+        try {
+            info = mContext.getPackageManager().getApplicationInfoAsUser(packageName, 0, userId);
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+        final LujarchBackgroundApp a = describe(info, new ArrayList<>(), null, null, true);
+        if (a != null) {
+            return a;
+        }
+        final LujarchBackgroundApp idle = new LujarchBackgroundApp();
+        idle.packageName = packageName;
+        idle.uid = info.uid;
+        idle.label = label(packageName, userId);
+        idle.state = (info.flags & ApplicationInfo.FLAG_STOPPED) != 0
+                ? LujarchBackground.RUN_STOPPED : LujarchBackground.RUN_RECLAIMED;
+        idle.who = LujarchBackground.WHO_SYSTEM;
+        final Words w = new Words();
+        idle.whoName = w.who(idle.who, null, userId);
+        idle.reason = mContext.getString(R.string.lujarch_background_r_not_started);
+        idle.word = LujarchBackground.stateName(mContext, idle.state);
+        idle.kept = isKept(info.uid, packageName);
+        idle.usage = usageOf(info.uid, packageName);
+        idle.usageFixed = isSystemAllowlisted(packageName);
+        idle.taskId = -1;
+        idle.processes = new LujarchBackgroundProcess[0];
+        final ArrayList<String> names = new ArrayList<>(declaredProcesses(info));
+        names.sort((x, y) -> {
+            final boolean xm = !x.startsWith(":");
+            final boolean ym = !y.startsWith(":");
+            return xm != ym ? (xm ? -1 : 1) : x.compareTo(y);
+        });
+        idle.processNames = names.toArray(new String[0]);
+        idle.chosen = chosenOf(info.uid, packageName).toArray(new String[0]);
+        idle.connected = new String[0];
+        return idle;
+    }
+
+    @Override
+    public LujarchBackgroundProcess getProcess(int pid) {
+        enforce();
+        ready();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final ArrayList<Proc> all = snapshot(UserHandle.USER_ALL, null);
+            for (Proc p : all) {
+                if (p.pid == pid) {
+                    final LujarchBackgroundProcess out = process(p, true);
+                    final Integer place = reclaimOrder(all).get(pid);
+                    out.reclaimOrder = place != null ? place : 0;
+                    return out;
+                }
+            }
+            final LujarchBackgroundProc.Service service = LujarchBackgroundProc.service(pid);
+            return service != null ? service(service, true) : null;
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public LujarchBackgroundProcess[] getServices() {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final ArrayList<LujarchBackgroundProcess> out = new ArrayList<>();
+            for (LujarchBackgroundProc.Service service : LujarchBackgroundProc.services()) {
+                out.add(service(service, false));
+            }
+            return out.toArray(new LujarchBackgroundProcess[0]);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    /** One of Lujarch's system services as a process: it runs as part of the system. */
+    private LujarchBackgroundProcess service(LujarchBackgroundProc.Service service,
+            boolean detail) {
+        final LujarchBackgroundProcess out = new LujarchBackgroundProcess();
+        final Words w = new Words();
+        final int userId = UserHandle.getUserId(service.uid);
+        out.pid = service.pid;
+        out.uid = service.uid;
+        out.name = service.name;
+        out.state = LujarchBackground.RUN_BACKGROUND;
+        out.who = LujarchBackground.WHO_SYSTEM;
+        out.whoName = w.who(out.who, null, userId);
+        out.reason = mContext.getString(R.string.lujarch_background_r_lujarch_service);
+        final long[] m = mProc.memory(service.pid, false);
+        out.memoryBytes = m[0] * 1024;
+        out.swapBytes = m[1] * 1024;
+        final long started = LujarchBackgroundProc.startedElapsed(service.pid);
+        out.startedMillis = started >= 0
+                ? System.currentTimeMillis() - (SystemClock.elapsedRealtime() - started) : 0;
+        out.cpuMs = cpuToday(service.pid, LujarchBackgroundProc.cpuMs(service.pid),
+                out.startedMillis);
+        if (detail) {
+            out.rssBytes = LujarchBackgroundProc.statusKb(service.pid, "VmRSS:") * 1024;
+            out.reasons = new LujarchBackgroundReason[] {reason(out.who, out.whoName, out.reason)};
+            final ArrayList<LujarchBackgroundThread> threads = new ArrayList<>();
+            for (LujarchBackgroundProc.Thread t : LujarchBackgroundProc.threads(service.pid)) {
+                final LujarchBackgroundThread th = new LujarchBackgroundThread();
+                th.tid = t.tid;
+                th.name = t.name;
+                th.state = w.threadState(t.state);
+                th.cpuMs = t.cpuMs;
+                threads.add(th);
+            }
+            out.threads = threads.toArray(new LujarchBackgroundThread[0]);
+        }
+        return out;
+    }
+
+    @Override
+    public LujarchBackgroundEvent[] getEvents(String packageName, int userId, long sinceMillis,
+            int max) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final Words w = new Words();
+            final ArrayList<LujarchBackgroundEvent> out = new ArrayList<>();
+            for (Event e : mRecord.since(userId, packageName, sinceMillis)) {
+                if (out.size() >= max) {
+                    break;
+                }
+                final LujarchBackgroundEvent ev = new LujarchBackgroundEvent();
+                ev.timeMillis = e.time;
+                ev.kind = e.kind;
+                ev.who = e.who;
+                ev.whoName = w.who(e.who, e.whoPackage, userId);
+                ev.text = w.event(e, userId);
+                ev.count = e.count;
+                ev.process = e.kind == LujarchBackground.EVENT_ENDED ? e.detail : null;
+                ev.reason = w.reason(e, userId);
+                out.add(ev);
+            }
+            return out.toArray(new LujarchBackgroundEvent[0]);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    private int uidOf(String packageName, int userId) {
+        try {
+            return mContext.getPackageManager().getPackageUidAsUser(packageName, userId);
+        } catch (PackageManager.NameNotFoundException e) {
+            throw new IllegalArgumentException(packageName + " is not installed for user "
+                    + userId);
+        }
+    }
+
+    @Override
+    public void setBackgroundUsage(String packageName, int userId, int usage) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            applyUsage(packageName, uidOf(packageName, userId), usage);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    /**
+     * Allow background usage as Android's Settings sets it (the power allowlist for
+     * Unrestricted, the run-in-background op for Restricted), and Chosen processes as Optimized
+     * with its op.
+     */
+    void applyUsage(String packageName, int uid, int usage) {
+        if (usage < LujarchBackground.USAGE_UNRESTRICTED
+                || usage > LujarchBackground.USAGE_RESTRICTED) {
+            throw new IllegalArgumentException("no Background usage " + usage);
+        }
+        if (usage != LujarchBackground.USAGE_UNRESTRICTED && isSystemAllowlisted(packageName)) {
+            throw new IllegalArgumentException(packageName + " stays Unrestricted");
+        }
+        final int runAny = usage == LujarchBackground.USAGE_RESTRICTED
+                ? AppOpsManager.MODE_IGNORED : AppOpsManager.MODE_ALLOWED;
+        final boolean restrictedBefore = mAppOps.unsafeCheckOpRawNoThrow(
+                AppOpsManager.OP_RUN_ANY_IN_BACKGROUND, uid, packageName)
+                == AppOpsManager.MODE_IGNORED;
+        try {
+            if (usage == LujarchBackground.USAGE_UNRESTRICTED) {
+                mDeviceIdle.addPowerSaveWhitelistApp(packageName);
+            } else {
+                mDeviceIdle.removePowerSaveWhitelistApp(packageName);
+            }
+        } catch (RemoteException e) {
+            throw new IllegalStateException("the allowlist cannot be changed", e);
+        }
+        try {
+            final ApplicationInfo info = mContext.getPackageManager()
+                    .getApplicationInfoAsUser(packageName, 0, UserHandle.getUserId(uid));
+            if (info.targetSdkVersion < Build.VERSION_CODES.O) {
+                mAppOps.setMode(AppOpsManager.OP_RUN_IN_BACKGROUND, uid, packageName, runAny);
+            }
+        } catch (PackageManager.NameNotFoundException e) {
+            throw new IllegalArgumentException(packageName + " is not installed");
+        }
+        if (restrictedBefore != (runAny == AppOpsManager.MODE_IGNORED)) {
+            mAm.noteAppRestrictionEnabled(packageName, uid,
+                    ActivityManager.RESTRICTION_LEVEL_BACKGROUND_RESTRICTED,
+                    runAny == AppOpsManager.MODE_IGNORED, ActivityManager.RESTRICTION_REASON_USER,
+                    "lujarch background", ActivityManager.RESTRICTION_SOURCE_USER, 0L);
+        }
+        mAppOps.setMode(AppOpsManager.OP_RUN_ANY_IN_BACKGROUND, uid, packageName, runAny);
+        mAppOps.setMode(AppOpsManager.OP_LUJARCH_CHOSEN_PROCESSES, uid, packageName,
+                usage == LujarchBackground.USAGE_CHOSEN ? AppOpsManager.MODE_ALLOWED
+                        : AppOpsManager.MODE_IGNORED);
+        Slog.i(TAG, packageName + " (" + uid + "): Allow background usage " + usage);
+    }
+
+    @Override
+    public void setChosenProcesses(String packageName, int userId, String[] names) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final int uid = uidOf(packageName, userId);
+            applyChosen(packageName, uid, names != null ? Arrays.asList(names) : List.of());
+            applyUsage(packageName, uid, LujarchBackground.USAGE_CHOSEN);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    /** The processes the owner chose for the app, by short name. */
+    void applyChosen(String packageName, int uid, List<String> names) {
+        synchronized (mLock) {
+            mChosen.put(uid + ":" + packageName, new ArraySet<>(names));
+        }
+        saveChosen();
+        Slog.i(TAG, packageName + " (" + uid + "): chosen processes " + names);
+        mHandler.post(() -> {
+            updateHolds(packageName);
+            evaluate(UserHandle.getUserId(uid), packageName, null);
+            changed();
+        });
+    }
+
+    @Override
+    public LujarchBackgroundRun[] getRunState(String packageName, int userId,
+            long dayStartMillis) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            return mRuns.day(LujarchBackgroundRecord.key(userId, packageName),
+                    LujarchBackgroundRuns.dayStart(dayStartMillis), System.currentTimeMillis());
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public LujarchBackgroundSuggestion getSuggestion(String packageName, int userId) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            final Suggestion waiting;
+            synchronized (mLock) {
+                waiting = mSuggestions.get(uidOf(packageName, userId) + ":" + packageName);
+            }
+            return waiting != null ? suggestion(waiting, packageName, userId) : null;
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public void answerSuggestion(String packageName, int userId, boolean accept) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            answer(packageName, uidOf(packageName, userId), accept);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    /** Add the main process to the chosen ones, or let the suggestion go; its alert goes too. */
+    void answer(String packageName, int uid, boolean accept) {
+        final Suggestion waiting;
+        synchronized (mLock) {
+            waiting = mSuggestions.remove(uid + ":" + packageName);
+        }
+        if (mNotices != null) {
+            mNotices.cancelSuggestion(packageName, uid);
+        }
+        if (waiting == null || !accept) {
+            return;
+        }
+        final ArraySet<String> names = chosenOf(uid, packageName);
+        names.add(waiting.mainName != null ? waiting.mainName : packageName);
+        applyChosen(packageName, uid, new ArrayList<>(names));
+        changed();
+    }
+
+    @Override
+    public LujarchBackgroundApp[] getRunning(int userId) {
+        enforce();
+        ready();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            return running(userId).toArray(new LujarchBackgroundApp[0]);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public void addRunningListener(ILujarchBackgroundListener listener) {
+        enforce();
+        mListeners.register(listener);
+        mHandler.post(() -> {
+            synchronized (mLock) {
+                mRunningCount = -1;
+            }
+            tellRunning();
+        });
+    }
+
+    @Override
+    public void removeRunningListener(ILujarchBackgroundListener listener) {
+        enforce();
+        mListeners.unregister(listener);
+    }
+
+    @Override
+    public void markRunningSeen() {
+        enforce();
+        mHandler.post(() -> {
+            final ArraySet<String> keys = runningKeys();
+            synchronized (mLock) {
+                mRunningSeen.clear();
+                mRunningSeen.addAll(keys);
+            }
+            tellRunning();
+        });
+    }
+
+    @Override
+    public void setKept(String packageName, int userId, boolean kept) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            applyKept(packageName, uidOf(packageName, userId), kept);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    void applyKept(String packageName, int uid, boolean kept) {
+        mAppOps.setMode(AppOpsManager.OP_LUJARCH_KEEP, uid, packageName,
+                kept ? AppOpsManager.MODE_ALLOWED : AppOpsManager.MODE_IGNORED);
+        Slog.i(TAG, packageName + " (" + uid + "): Keep " + (kept ? "on" : "off"));
+    }
+
+    @Override
+    public void endForegroundServices(String packageName, int userId) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            endOwnWork(packageName, userId);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    /** End: stops what the app runs of its own, as the shade's list of active apps did. */
+    void endOwnWork(String packageName, int userId) {
+        noteCaller(packageName, userId, Process.SYSTEM_UID, ACTION_STOP_APP);
+        mAm.stopAppForUserInternal(packageName, userId);
+    }
+
+    @Override
+    public void closeSmallWindow(int taskId) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            closeTask(taskId);
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    @Override
+    public void setSmallWindows(LujarchSmallWindow[] windows) {
+        enforce();
+        synchronized (mLock) {
+            mShellWindows = windows != null ? windows.clone() : new LujarchSmallWindow[0];
+            mSmallWindowTasks.clear();
+            for (LujarchSmallWindow w : mShellWindows) {
+                if (w.taskId >= 0) {
+                    mSmallWindowTasks.add(w.taskId);
+                }
+            }
+        }
+        mHandler.post(() -> {
+            updateTasks();
+            updateHolds(null);
+            changed();
+        });
+    }
+
+    @Override
+    public LujarchSmallWindow[] getSmallWindows() {
+        enforce();
+        synchronized (mLock) {
+            return mShellWindows.clone();
+        }
+    }
+
+    void closeTask(int taskId) {
+        if (!mAm.mActivityTaskManager.removeTask(taskId)) {
+            throw new IllegalArgumentException("no task " + taskId);
+        }
+    }
+
+    @Override
+    public void endProcess(int pid) {
+        enforce();
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            synchronized (mAm) {
+                final ProcessRecord app;
+                synchronized (mAm.mPidsSelfLocked) {
+                    app = mAm.mPidsSelfLocked.get(pid);
+                }
+                if (app == null || app.info == null) {
+                    throw new IllegalArgumentException("no process " + pid);
+                }
+                if (app.isPersistent()) {
+                    throw new IllegalArgumentException(app.processName + " is part of the system");
+                }
+                noteCaller(app.info.packageName, app.userId, Process.SYSTEM_UID,
+                        ACTION_END_PROCESS);
+                app.killLocked("ended by the owner", ApplicationExitInfo.REASON_USER_REQUESTED,
+                        ApplicationExitInfo.SUBREASON_KILL_PID, true);
+            }
+            Slog.i(TAG, "pid " + pid + " ended by the owner");
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
+
+    // For the notices and the battery alerts.
+
+    LujarchBackgroundNotices notices() {
+        return mNotices;
+    }
+
+    LujarchBackgroundUsage usage() {
+        return mUsage;
+    }
+
+    /** One app's state, for an alert; null when it is not installed. */
+    @Nullable
+    LujarchBackgroundApp getAppForAlert(String packageName, int userId) {
+        final ArrayList<LujarchBackgroundApp> list = apps(userId, true, false, packageName);
+        return list.isEmpty() ? null : list.get(0);
+    }
+}
diff --git a/services/core/java/com/android/server/am/LujarchBackgroundUsage.java b/services/core/java/com/android/server/am/LujarchBackgroundUsage.java
new file mode 100644
index 0000000000000000000000000000000000000000..94a294ca9f6b6b911f8908d836d3fc2781b79884
--- /dev/null
+++ b/services/core/java/com/android/server/am/LujarchBackgroundUsage.java
@@ -0,0 +1,325 @@
+/*
