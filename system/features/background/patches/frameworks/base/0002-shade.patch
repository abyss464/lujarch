+package com.android.systemui.lujarch.background
+
+import android.content.Context
+import android.database.ContentObserver
+import android.os.RemoteException
+import android.provider.Settings
+import android.util.Log
+import com.android.internal.app.ILujarchBackground
+import com.android.internal.app.ILujarchBackgroundListener
+import com.android.internal.app.LujarchBackground
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.channels.awaitClose
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.callbackFlow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.flowOn
+import kotlinx.coroutines.launch
+
+/** What Recents' Running layer shows, for the shade's footer (BG-9). */
+data class LujarchRunningModel(val count: Int, val unseen: Boolean)
+
+/**
+ * The shade's Running · N (BG-9): the count of what Recents' Running layer shows and whether
+ * something started running since Recents last showed it, as Background tells it.
+ */
+object LujarchRunning {
+    private const val TAG = "lujarch_background"
+    private const val RETRY_MS = 5_000L
+
+    /** Whether Recents shows its Running layer; while it does not, the footer is Android's. */
+    fun isLayerOn(context: Context): Boolean =
+        Settings.Secure.getInt(
+            context.contentResolver,
+            LujarchBackground.SETTING_RECENTS_RUNNING,
+            1,
+        ) != 0
+
+    /** The Running layer's count, or null while that layer is off or Background is away. */
+    fun flow(context: Context, bgDispatcher: CoroutineDispatcher): Flow<LujarchRunningModel?> =
+        callbackFlow<LujarchRunningModel?> {
+                var service: ILujarchBackground? = null
+                val listener =
+                    object : ILujarchBackgroundListener.Stub() {
+                        override fun onRunningChanged(count: Int, unseen: Boolean) {
+                            trySend(if (isLayerOn(context)) LujarchRunningModel(count, unseen) else null)
+                        }
+                    }
+
+                fun unregister() {
+                    try {
+                        service?.removeRunningListener(listener)
+                    } catch (e: RemoteException) {
+                        Log.w(TAG, "the shade cannot stop listening to Background", e)
+                    }
+                    service = null
+                }
+
+                suspend fun register() {
+                    while (service == null) {
+                        val s = LujarchBackground.get()
+                        if (s != null) {
+                            try {
+                                s.addRunningListener(listener)
+                                service = s
+                                return
+                            } catch (e: RemoteException) {
+                                Log.w(TAG, "the shade cannot listen to Background", e)
+                            } catch (e: SecurityException) {
+                                Log.e(TAG, "the shade may not listen to Background", e)
+                                return
+                            }
+                        }
+                        delay(RETRY_MS)
+                    }
+                }
+
+                val observer =
+                    object : ContentObserver(null) {
+                        override fun onChange(selfChange: Boolean) {
+                            if (isLayerOn(context)) {
+                                launch { register() }
+                            } else {
+                                unregister()
+                                trySend(null)
+                            }
+                        }
+                    }
+                context.contentResolver.registerContentObserver(
+                    Settings.Secure.getUriFor(LujarchBackground.SETTING_RECENTS_RUNNING),
+                    false,
+                    observer,
+                )
+                if (isLayerOn(context)) {
+                    register()
+                } else {
+                    trySend(null)
+                }
+                awaitClose {
+                    context.contentResolver.unregisterContentObserver(observer)
+                    unregister()
+                }
+            }
+            .distinctUntilChanged()
+            .flowOn(bgDispatcher)
+}
