+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.lujarch.background
+
+import android.app.AppOpsManager
+import android.app.Notification
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.AsyncTask
+import android.os.UserHandle
+import android.service.notification.StatusBarNotification
+import android.util.Log
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Switch
+import android.widget.TextView
+import com.android.internal.app.LujarchBackground
+import com.android.systemui.res.R
+import com.android.systemui.statusbar.phone.SystemUIDialog
+
+/**
+ * Fold into Background (BG-9): an app's ongoing notification of a foreground service shows as a
+ * line inside the Background notification instead of on its own, by the owner's choice per app.
+ * The choice is in the notification's long-press menu, and in the same menu on its line.
+ */
+object LujarchFold {
+    private const val TAG = "lujarch_background"
+
+    /** An ongoing notification of a foreground service: what folds. */
+    fun isFoldable(sbn: StatusBarNotification): Boolean {
+        val n = sbn.notification
+        return sbn.packageName != "android" &&
+            n.flags and Notification.FLAG_FOREGROUND_SERVICE != 0 &&
+            n.flags and Notification.FLAG_ONGOING_EVENT != 0
+    }
+
+    fun isFolded(context: Context, uid: Int, packageName: String): Boolean =
+        context.getSystemService(AppOpsManager::class.java)!!
+            .unsafeCheckOpRawNoThrow(AppOpsManager.OPSTR_LUJARCH_FOLD, uid, packageName) ==
+            AppOpsManager.MODE_ALLOWED
+
+    /** Sets the choice through Background, off the main thread; failures are logged. */
+    fun setFolded(packageName: String, uid: Int, folded: Boolean) {
+        AsyncTask.THREAD_POOL_EXECUTOR.execute {
+            try {
+                val service = LujarchBackground.get()
+                if (service == null) {
+                    Log.e(TAG, "Fold into Background for $packageName: Background is not available")
+                } else {
+                    service.setFolded(packageName, UserHandle.getUserId(uid), folded)
+                }
+            } catch (e: Exception) {
+                Log.e(TAG, "Fold into Background for $packageName failed", e)
+            }
+        }
+    }
+
+    /** Adds the Fold into Background row to a notification's long-press menu, for what folds. */
+    fun bindGuts(info: ViewGroup, sbn: StatusBarNotification) {
+        val controls = info.findViewById<ViewGroup>(R.id.inline_controls) ?: return
+        var row = controls.findViewById<View>(R.id.lujarch_background_fold)
+        if (!isFoldable(sbn)) {
+            row?.visibility = View.GONE
+            return
+        }
+        if (row == null) {
+            row = LayoutInflater.from(info.context)
+                .inflate(R.layout.lujarch_background_fold_row, controls, false)
+            controls.addView(row, controls.indexOfChild(controls.findViewById(R.id.bottom_buttons)))
+        }
+        bindRow(row!!, sbn.packageName, sbn.uid)
+    }
+
+    private fun bindRow(row: View, packageName: String, uid: Int) {
+        row.visibility = View.VISIBLE
+        val toggle = row.findViewById<Switch>(R.id.lujarch_background_fold_switch)
+        toggle.setOnCheckedChangeListener(null)
+        toggle.isChecked = isFolded(row.context, uid, packageName)
+        toggle.setOnCheckedChangeListener { _, on -> setFolded(packageName, uid, on) }
+        row.setOnClickListener { toggle.toggle() }
+    }
+
+    /** The menu of a folded line in the Background notification: the same choice. */
+    fun showMenu(context: Context, packageName: String, uid: Int) {
+        val label = try {
+            val pm = context.packageManager
+            pm.getApplicationInfoAsUser(packageName, 0, UserHandle.getUserId(uid)).loadLabel(pm)
+        } catch (e: PackageManager.NameNotFoundException) {
+            Log.w(TAG, "$packageName is not installed", e)
+            return
+        }
+        val dialog = SystemUIDialog(context)
+        val row = LayoutInflater.from(dialog.context).inflate(R.layout.lujarch_background_fold_row, null)
+        bindRow(row, packageName, uid)
+        row.findViewById<TextView>(R.id.lujarch_background_fold_title).text =
+            context.getString(R.string.lujarch_background_fold)
+        dialog.setTitle(label)
+        dialog.setView(row)
+        dialog.setPositiveButton(R.string.inline_done_button, null)
+        dialog.setShowForAllUsers(true)
+        dialog.show()
+    }
+}
