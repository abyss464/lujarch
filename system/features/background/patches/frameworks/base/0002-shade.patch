+
+package com.android.systemui.lujarch.background
+
+import android.app.AppOpsManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.Handler
+import android.util.ArraySet
+import android.util.Log
+import com.android.internal.app.LujarchBackground
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.statusbar.notification.collection.NotifPipeline
+import com.android.systemui.statusbar.notification.collection.NotificationEntry
+import com.android.systemui.statusbar.notification.collection.coordinator.Coordinator
+import com.android.systemui.statusbar.notification.collection.coordinator.dagger.CoordinatorScope
+import com.android.systemui.statusbar.notification.collection.listbuilder.pluggable.NotifFilter
+import javax.inject.Inject
+
+/**
+ * Fold into Background (BG-9): the running notifications of the apps folded into Background are
+ * not shown on their own; the Background notification shows them as lines, and the menu of a
+ * line comes here.
+ */
+@CoordinatorScope
+class LujarchFoldCoordinator
+@Inject
+constructor(
+    private val context: Context,
+    @Main private val mainHandler: Handler,
+) : Coordinator {
+    private val folded = ArraySet<String>()
+    private val appOps = context.getSystemService(AppOpsManager::class.java)!!
+
+    private val filter =
+        object : NotifFilter("LujarchFoldFilter") {
+            override fun shouldFilterOut(entry: NotificationEntry, now: Long): Boolean {
+                val sbn = entry.sbn
+                return LujarchFold.isFoldable(sbn) &&
+                    synchronized(folded) { folded.contains("${sbn.uid}:${sbn.packageName}") }
+            }
+        }
+
+    override fun attach(pipeline: NotifPipeline) {
+        pipeline.addPreGroupFilter(filter)
+        try {
+            watch()
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "Fold into Background is not watched", e)
+        }
+    }
+
+    private fun watch() {
+        read()
+        appOps.startWatchingMode(AppOpsManager.OPSTR_LUJARCH_FOLD, null) { _, _ ->
+            mainHandler.post {
+                read()
+                filter.invalidateList("lujarch fold changed")
+            }
+        }
+        context.registerReceiverForAllUsers(
+            object : BroadcastReceiver() {
+                override fun onReceive(c: Context, intent: Intent) {
+                    val pkg = intent.getStringExtra(Intent.EXTRA_PACKAGE_NAME) ?: return
+                    LujarchFold.showMenu(context, pkg, intent.getIntExtra("uid", -1))
+                }
+            },
+            IntentFilter(ACTION_FOLD_MENU),
+            LujarchBackground.PERMISSION,
+            mainHandler,
+            Context.RECEIVER_EXPORTED,
+        )
+    }
+
+    private fun read() {
+        val now = ArraySet<String>()
+        try {
+            appOps.getPackagesForOps(intArrayOf(AppOpsManager.OP_LUJARCH_FOLD))?.forEach { p ->
+                if (p.ops.any { it.mode == AppOpsManager.MODE_ALLOWED }) {
+                    now.add("${p.uid}:${p.packageName}")
+                }
+            }
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "the apps folded into Background cannot be read", e)
+        }
+        synchronized(folded) {
+            folded.clear()
+            folded.addAll(now)
+        }
+    }
+
+    private companion object {
+        const val TAG = "lujarch_background"
+        const val ACTION_FOLD_MENU = "org.lujarch.background.action.FOLD_MENU"
+    }
+}
