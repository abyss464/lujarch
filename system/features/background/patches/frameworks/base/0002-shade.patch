+            R.plurals.lujarch_background_running,
+            running.count,
+            running.count,
+        )
+    return FooterActionsForegroundServicesButtonViewModel(
+        foregroundServicesCount = running.count,
+        text = text,
+        displayText = securityModel == null && textFeedbackModel == TextFeedbackModel.NoFeedback,
+        hasNewChanges = running.unseen,
+        onClick = { _, expandable -> onClick(expandable) },
+    )
