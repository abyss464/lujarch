+
+/**
+ * The Running layer above the cards in Recents (BG-8): everything that runs off screen, each a
+ * tile with the app's icon and one word for why, under the layer's name, in one row that scrolls
+ * sideways. A tap opens the app; touching and holding shows its menu. A small window's tile is the
+ * place its shape flies into (WIN-11): the layer tells where the places are on each frame it draws,
+ * so the shapes follow it.
+ *
+ * When Recents settles the tiles come out of the status bar, each a little out of it, along to
+ * above its own place and down into it, the one going furthest first; when Recents closes they go
+ * back up. A card lifted toward the layer parts it: the tiles fold into their icons and slide to
+ * both sides of the card on a spring of their own, and the card waits at the layer's edge until
+ * the way is clear.
+ */
+class RunningLayerView(context: Context, private val recents: LujarchRecents) :
+    FrameLayout(context), Insettable {
+    private val density = resources.displayMetrics.density
+    private val title = TextView(context)
+    private val scroller = HorizontalScrollView(context)
+    private val row = LinearLayout(context)
+    private val dropSlot = FrameLayout(context)
+    private val tiles = ArrayList<Tile>()
+    private val slotRect = Rect()
+    private var slotsPublished = false
+    private var insetTop = 0
+    private val location = IntArray(2)
+    private val publish = ViewTreeObserver.OnPreDrawListener {
+        publishSlots()
+        true
+    }
+    var hasEntries = false
+        private set
+    /** The tiles moved into or out of the status bar. */
+    var onArrival: (() -> Unit)? = null
+
+    // Arrival: 0 in the status bar, 1 in place.
+    private var arrival = 0f
+    private var arriving = true
+    private var arrivalAnim: ValueAnimator? = null
+    /** Clear all sends the small windows' tiles through the status bar too. */
+    private var allViaBar = false
+    /** The small windows' tiles show once their windows have landed on them. */
+    private var windowsShown = 0f
+    private var windowsAnim: ValueAnimator? = null
+
+    // Parting around a lifted card: the spring's place, speed and target, the gap it parts around.
+    private var yieldA = 0f
+    private var yieldV = 0f
+    private var yieldT = 0f
+    private var yieldDrive = false
+    private var yieldBack = false
+    private var back = 0f
+    private var backAnim: ValueAnimator? = null
+    private var gapL = 0f
+    private var gapR = 0f
+    private var yieldFrom: Array<FloatArray> = emptyArray()
+    private var held: Held? = null
+    private val ticker = TimeAnimator().apply {
+        setTimeListener { _, _, delta -> onTick(min(delta, 32L)) }
+    }
+
+    init {
+        clipChildren = false
+        clipToPadding = false
+        title.setText(R.string.lujarch_background_running)
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+        title.setTextColor(context.getColor(android.R.color.system_accent1_200))
+        title.typeface = android.graphics.Typeface.create("sans-serif-medium", android.graphics.Typeface.NORMAL)
+        title.alpha = 0f
+        addView(title, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT).apply {
+            marginStart = dp(SIDE)
+        })
+        scroller.isHorizontalScrollBarEnabled = false
+        scroller.overScrollMode = OVER_SCROLL_NEVER
+        scroller.clipToPadding = false
+        scroller.clipChildren = false
+        scroller.setPadding(dp(SIDE), 0, dp(SIDE), 0)
+        scroller.setOnScrollChangeListener { _, _, _, _, _ -> applyMotion() }
+        row.orientation = LinearLayout.HORIZONTAL
+        row.clipChildren = false
+        row.clipToPadding = false
+        dropSlot.background = GradientDrawable().apply {
+            cornerRadius = dp(TILE_RADIUS).toFloat()
+            setStroke(dp(2), context.getColor(android.R.color.system_accent1_200), dp(6).toFloat(), dp(4).toFloat())
+        }
+        dropSlot.addView(TextView(context).apply {
+            setText(R.string.lujarch_background_drop)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 10f)
+            setTextColor(context.getColor(android.R.color.system_accent1_100))
+            gravity = Gravity.CENTER
+            val p = dp(4)
+            setPadding(p, p, p, p)
+        }, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+        dropSlot.visibility = GONE
+        row.addView(dropSlot, LinearLayout.LayoutParams(dp(TILE_W), dp(TILE_H)))
+        scroller.addView(row, ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, dp(TILE_H)))
+        addView(scroller, LayoutParams(LayoutParams.MATCH_PARENT, dp(TILE_H)))
+        applyInsets()
+    }
+
+    override fun setInsets(insets: Rect) {
+        insetTop = insets.top
+        applyInsets()
+    }
+
+    private fun applyInsets() {
+        (title.layoutParams as LayoutParams).topMargin = insetTop + dp(LABEL_TOP)
+        (scroller.layoutParams as LayoutParams).topMargin = insetTop + dp(ROW_TOP)
+        requestLayout()
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        viewTreeObserver.addOnPreDrawListener(publish)
+    }
+
+    override fun onDetachedFromWindow() {
+        viewTreeObserver.removeOnPreDrawListener(publish)
+        ticker.cancel()
+        super.onDetachedFromWindow()
+    }
+
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        super.onLayout(changed, l, t, r, b)
+        applyMotion()
+    }
+
+    /**
+     * What runs off screen, in the order of BG-8: what the apps run themselves, the small
+     * windows, then Unrestricted and Chosen.
+     */
+    fun bind(list: List<LujarchBackgroundApp>, windows: List<LujarchSmallWindow>) {
+        for (t in tiles) row.removeView(t)
+        tiles.clear()
+        val own = list.filter { it.ownService }
+        val chosen = list.filter { !it.ownService }.sortedBy {
+            when (it.usage) {
+                LujarchBackground.USAGE_UNRESTRICTED -> 0
+                LujarchBackground.USAGE_CHOSEN -> 1
+                else -> 2
+            }
+        }
+        own.forEach { tiles.add(appTile(it)) }
+        windows.forEach { tiles.add(windowTile(it)) }
+        chosen.forEach { tiles.add(appTile(it)) }
+        var bar = 0
+        for (t in tiles) if (t.window == null) t.bar = bar++
+        for (t in tiles) if (t.window != null) t.bar = bar++
+        tiles.forEachIndexed { i, t ->
+            row.addView(t, i, LinearLayout.LayoutParams(dp(TILE_W), dp(TILE_H)).apply {
+                marginEnd = dp(GAP)
+            })
+        }
+        hasEntries = tiles.isNotEmpty()
+        yieldFrom = emptyArray()
+        applyMotion()
+    }
+
+    /** Where each small window waits on the screen, by its bubble key (WIN-11). */
+    private fun publishSlots() {
+        val shown = tiles.filter { it.window != null }
+        if (shown.isEmpty() && !slotsPublished) return
+        slotsPublished = shown.isNotEmpty()
+        val keys = ArrayList<String>()
+        val rects = ArrayList<Rect>()
+        for (t in shown) {
+            if (!t.getGlobalVisibleRect(slotRect)) continue
+            keys.add(t.window!!.key)
+            rects.add(Rect(slotRect))
+        }
+        recents.onSmallWindowSlots(keys.toTypedArray(), rects.toTypedArray())
+    }
+
+    /** While a card is held: the layer offers its place for it, last in the row. */
+    fun showDropSlot(show: Boolean) {
+        dropSlot.visibility = if (show) VISIBLE else GONE
+        if (show) {
+            visibility = VISIBLE
+            post { scroller.fullScroll(FOCUS_RIGHT) }
+        } else if (!hasEntries) {
+            visibility = INVISIBLE
+        }
+    }
+
+    fun setDropTarget(over: Boolean) {
+        dropSlot.alpha = if (over) 1f else 0.6f
+        dropSlot.scaleX = if (over) 1.06f else 1f
+        dropSlot.scaleY = dropSlot.scaleX
+    }
+
+    // -----------------------------------------------------------------------------------------
+    // Arriving and leaving.
+
+    /** Recents settled: the tiles come out of the status bar, after [delay]. */
+    fun arrive(delay: Long) {
+        allViaBar = false
+        runTo(1f, delay, null)
+        windowsAnim?.cancel()
+        windowsAnim = ValueAnimator.ofFloat(windowsShown, 1f).apply {
+            duration = WINDOW_SHOW_MS
+            startDelay = WINDOW_LAND_MS
+            addUpdateListener { windowsShown = it.animatedValue as Float; applyMotion() }
+            start()
+        }
+    }
+
+    /** Recents closes: the tiles go back up into the status bar. */
+    fun leave() {
+        windowsAnim?.cancel()
+        windowsShown = 0f
+        stopParting()
+        runTo(0f, 0, null)
+    }
+
+    /** Clear all: every tile goes up first and comes down again once the cards are gone. */
+    fun clearAll(doneIn: Long) {
+        stopParting()
+        allViaBar = true
+        runTo(0f, 0) {
+            postDelayed({ if (arrival == 0f && allViaBar) arrive(0) }, doneIn)
+        }
+    }
+
+    /** Recents is gone: everything rests in the status bar. */
+    fun reset() {
+        arrivalAnim?.cancel()
+        windowsAnim?.cancel()
+        backAnim?.cancel()
+        ticker.cancel()
+        held?.cancel()
+        held = null
+        arrival = 0f
+        windowsShown = 0f
+        yieldA = 0f
+        yieldV = 0f
+        yieldDrive = false
+        yieldBack = false
+        allViaBar = false
+        applyMotion()
+    }
+
+    val isMoving: Boolean
+        get() = arrivalAnim?.isRunning == true || arrival > 0f
+
+    private fun runTo(to: Float, delay: Long, done: (() -> Unit)?) {
+        arrivalAnim?.cancel()
+        val from = arrival
+        if (from == to) {
+            done?.invoke()
+            return
+        }
+        arriving = to > from
+        val anim = ValueAnimator.ofFloat(from, to)
+        anim.duration = (span() * abs(to - from)).toLong()
+        anim.startDelay = delay
+        anim.interpolator = null
+        anim.addUpdateListener {
+            arrival = it.animatedValue as Float
+            applyMotion()
+            onArrival?.invoke()
+        }
+        if (done != null) {
+            anim.addListener(object : android.animation.AnimatorListenerAdapter() {
+                private var canceled = false
+                override fun onAnimationCancel(animation: android.animation.Animator) {
+                    canceled = true
+                }
+
+                override fun onAnimationEnd(animation: android.animation.Animator) {
+                    if (!canceled) done()
+                }
+            })
+        }
+        arrivalAnim = anim
+        anim.start()
+    }
+
+    private fun viaBar(t: Tile) = t.window == null || allViaBar
+
+    private fun barCount() = tiles.count { viaBar(it) }
+
+    private fun each() = if (arriving) ARRIVE_EACH_MS else LEAVE_EACH_MS
+
+    private fun gap() = if (arriving) ARRIVE_GAP_MS else LEAVE_GAP_MS
+
+    private fun span(): Float = each() + gap() * max(0, barCount() - 1).toFloat()
+
+    /**
+     * One tile's own progress. Arriving, the tile going furthest sets off first, so none passes
+     * one still in the status bar; leaving, the last goes first.
+     */
+    private fun progress(t: Tile): Float {
+        val n = barCount()
+        val k = if (arriving) n - 1 - t.bar else t.bar
+        return ((arrival * span() - gap() * k) / each()).coerceIn(0f, 1f)
+    }
+
+    // -----------------------------------------------------------------------------------------
+    // Parting around a lifted card.
+
+    /** Running's lowest edge with a margin, on the screen: a card above it would touch the tiles. */
+    private fun edge(): Float {
+        getLocationOnScreen(location)
+        return location[1] + scroller.top + dp(TILE_H) + dp(EDGE_MARGIN).toFloat()
+    }
+
+    private val parts: Boolean
+        get() = visibility == VISIBLE && hasEntries && arrival > 0.99f
+
+    /**
+     * A card is lifted: [top] is its top on the screen where it rests, [left] and [right] its
+     * sides. [apply] moves it; the layer calls it on each frame while it holds the card back.
+     */
+    fun hold(top: Float, left: Float, right: Float, apply: (Float) -> Unit): Held {
+        held?.cancel()
+        backAnim?.cancel()
+        yieldBack = false
+        getLocationOnScreen(location)
+        gapL = left - location[0]
+        gapR = right - location[0]
+        return Held(top, apply).also { held = it }
+    }
+
+    /** A card the layer parts around. */
+    inner class Held(private val top: Float, private val apply: (Float) -> Unit) {
+        private var want = 0f
+        private var lastWant = 0f
+        private var lastAt = 0L
+        private var vy = 0f
+        private var fly: Fly? = null
+        private var done = false
+
+        /** The finger wants the card [ty] from its place; returns where it may be. */
+        fun lift(ty: Float): Float {
+            if (done) return ty
+            val now = android.os.SystemClock.uptimeMillis()
+            if (lastAt != 0L && now > lastAt) vy = 0.6f * vy + 0.4f * (ty - lastWant) * 1000f / (now - lastAt)
+            lastAt = now
+            lastWant = ty
+            want = ty
+            if (!parts) return ty
+            // From 80 dp below the edge, judged a tenth of a second ahead by the finger's speed.
+            val ahead = top + want + min(0f, vy) * 0.1f - edge()
+            yieldT = ((dp(NEAR) - ahead) / dp(NEAR)).coerceIn(0f, 1f) * (-want / dp(10)).coerceIn(0f, 1f)
+            yieldDrive = true
+            yieldBack = false
+            if (!ticker.isStarted) ticker.start()
+            return limit(top, want)
+        }
+
+        /**
+         * The finger let go. A card on its way out flies on at the fling's speed, slowed near the
+         * edge until the way is clear, and [settle] then takes it on; a card going back settles
+         * at once and the tiles close behind it.
+         */
+        fun release(dismissing: Boolean, velocity: Float, direction: Float, settle: () -> Unit) {
+            if (done) return settle()
+            if (!dismissing || !parts) {
+                finish()
+                settle()
+                returnLayer(if (dismissing) LEAVE_RETURN_MS else BACK_RETURN_MS)
+                return
+            }
+            yieldT = 1f
+            yieldDrive = true
+            if (yieldA >= OPEN) {
+                finish()
+                settle()
+                returnLayer(LEAVE_RETURN_MS)
+                return
+            }
+            val speed = abs(velocity).coerceIn(dp(1200).toFloat(), dp(2400).toFloat())
+            fly = Fly(speed * direction, settle)
+            if (!ticker.isStarted) ticker.start()
+        }
+
+        internal fun step(ms: Long) {
+            val f = fly
+            if (f != null) {
+                val open = ((yieldA - 0.78f) / 0.2f).coerceIn(0f, 1f)
+                val near = top + want - edge() < dp(100)
+                val v = if (near) f.v * lerp(0.25f, 1f, open) else f.v
+                want += v * ms / 1000f
+                apply(limit(top, want))
+                if (yieldA >= OPEN) {
+                    finish()
+                    f.settle()
+                    returnLayer(LEAVE_RETURN_MS)
+                }
+            } else if (!done) {
+                apply(limit(top, want))
+            }
+        }
+
+        private fun finish() {
+            done = true
+            fly = null
+            if (held === this) held = null
+        }
+
+        internal fun cancel() {
+            val f = fly
+            finish()
+            f?.settle?.invoke()
+        }
+    }
+
+    private class Fly(val v: Float, val settle: () -> Unit)
+
+    /** Before the way is clear a card presses in by a few dp at most, never as far as the tiles. */
+    private fun limit(top: Float, ty: Float): Float {
+        val e = edge()
+        val pen = e - (top + ty)
+        if (pen <= 0f) return ty
+        val open = ((yieldA - 0.78f) / 0.2f).coerceIn(0f, 1f)
+        return e - lerp(dp(6) * (1f - exp(-pen / dp(20))), pen, open) - top
+    }
+
+    /** The card is gone or back: the tiles slide back from the gap outward and open again. */
+    private fun returnLayer(delay: Long) {
+        yieldDrive = false
+        yieldV = 0f
+        val a0 = yieldA
+        if (a0 <= 0f) return
+        backAnim?.cancel()
+        backAnim = ValueAnimator.ofFloat(0f, 1f).apply {
+            duration = RETURN_MS
+            startDelay = delay
+            interpolator = null
+            addUpdateListener {
+                val p = it.animatedValue as Float
+                if (!yieldBack) {
+                    yieldFrom = Array(tiles.size) { i -> stepAside(i, parted()) }
+                    yieldBack = true
+                }
+                back = p
+                yieldA = lerp(a0, 0f, p)
+                applyMotion()
+            }
+            addListener(object : android.animation.AnimatorListenerAdapter() {
+                override fun onAnimationEnd(animation: android.animation.Animator) {
+                    yieldBack = false
+                    yieldA = 0f
+                    applyMotion()
+                }
+            })
+            start()
+        }
+    }
+
+    private fun stopParting() {
+        held?.cancel()
+        held = null
+        backAnim?.cancel()
+        yieldDrive = false
+        yieldBack = false
+        yieldA = 0f
+        yieldV = 0f
+    }
+
+    private fun onTick(ms: Long) {
+        // The parting spring: critically damped, about half a second from start to rest.
+        var moving = false
+        if (yieldDrive) {
+            var left = ms / 1000f
+            while (left > 0f) {
+                val dt = min(left, 0.008f)
+                val a = -YIELD_W * YIELD_W * (yieldA - yieldT) - 2 * YIELD_W * yieldV
+                yieldV += a * dt
+                yieldA = (yieldA + yieldV * dt).coerceIn(0f, 1f)
+                left -= dt
+            }
+            moving = abs(yieldA - yieldT) > 0.002f || abs(yieldV) > 0.02f
+        }
+        held?.step(ms)
+        applyMotion()
+        if (!moving && held == null) ticker.end()
+    }
+
+    /** Where each icon goes when the layer parts around the card, and how near each tile is. */
+    private fun parted(): Parted {
+        val n = tiles.size
+        val homes = FloatArray(n) { homeX(tiles[it]) }
+        val cx = (gapL + gapR) / 2
+        val step = dp(PARTED_STEP).toFloat()
+        val fits = { w: Float -> max(0, floor((w + dp(6)) / step).toInt()) }
+        val kL = fits(gapL - dp(18))
+        val kR = fits(width - dp(8) - gapR - dp(10))
+        var m = homes.count { it < cx }
+        m = min(min(max(m, n - kR), kL), n)
+        val half = dp(ICON) / 2f
+        val at = FloatArray(n) { i ->
+            if (i < m) gapL - dp(10) - half - (m - 1 - i) * step
+            else gapR + dp(10) + half + (i - m) * step
+        }
+        val rank = IntArray(n)
+        homes.indices.sortedBy { abs(homes[it] - cx) }.forEachIndexed { k, i -> rank[i] = k }
+        return Parted(at, rank)
+    }
+
+    private class Parted(val at: FloatArray, val rank: IntArray)
+
+    /** How far a tile has stepped aside and folded into its icon, the nearest first. */
+    private fun stepAside(i: Int, g: Parted): FloatArray {
+        val y = ((yieldA - 0.08f * min(g.rank[i], 3)) / 0.76f).coerceIn(0f, 1f)
+        return floatArrayOf(smooth(y), (y / 0.6f).coerceIn(0f, 1f))
+    }
+
+    // -----------------------------------------------------------------------------------------
+    // Drawing each tile where its motion has it.
+
+    private fun homeX(t: Tile): Float =
+        scroller.left + row.left - scroller.scrollX + t.left + dp(TILE_W) / 2f
+
+    private fun applyMotion() {
+        if (tiles.isEmpty()) {
+            title.alpha = 0f
+            return
+        }
+        val homeCy = scroller.top + dp(ICON_CY).toFloat()
+        val barCy = insetTop / 2f
+        val outCy = insetTop - dp(2).toFloat()
+        val rtl = layoutDirection == LAYOUT_DIRECTION_RTL
+        val parting = yieldA > 0f || yieldBack
+        val g = if (parting) parted() else null
+        var minP = 1f
+        tiles.forEachIndexed { i, t ->
+            val homeCx = homeX(t)
+            val p: Float
+            var cx: Float
+            var cy: Float
+            var s: Float
+            var open: Float
+            var label: Float
+            var squash = 0f
+            var shown = 1f
+            if (!viaBar(t)) {
+                p = 1f
+                shown = windowsShown
+                cx = homeCx
+                cy = homeCy
+                s = dp(ICON).toFloat()
+                open = 1f
+                label = 1f
+            } else {
+                p = progress(t)
+                minP = min(minP, p)
+                val bx = dp(BAR_X) + dp(BAR_STEP) * t.bar.toFloat()
+                val barCx = if (rtl) width - bx else bx
+                val u = if (arriving) (p / 0.6f).coerceIn(0f, 1f) else (p / 0.5f).coerceIn(0f, 1f)
+                val outP = smooth((u / 0.3f).coerceIn(0f, 1f))
+                val along = smooth(((u - 0.2f) / 0.45f).coerceIn(0f, 1f))
+                val down = smooth(((u - 0.5f) / 0.5f).coerceIn(0f, 1f))
+                cx = lerp(barCx, homeCx, along)
+                cy = lerp(barCy, outCy, outP) + (homeCy - outCy) * down
+                s = lerp(dp(BAR_ICON).toFloat(), dp(18).toFloat(), outP) + (dp(ICON) - dp(18)) * down
+                if (arriving) {
+                    val land = ((p - 0.6f) / 0.4f).coerceIn(0f, 1f)
+                    squash = if (p > 0.6f) sin(PI.toFloat() * (land / 0.45f).coerceIn(0f, 1f)) else 0f
+                    open = openOut(((p - 0.55f) / 0.45f).coerceIn(0f, 1f))
+                    label = ((p - 0.75f) / 0.25f).coerceIn(0f, 1f)
+                } else {
+                    open = STANDARD.getInterpolation(((p - 0.45f) / 0.55f).coerceIn(0f, 1f))
+                    label = ((p - 0.7f) / 0.3f).coerceIn(0f, 1f)
+                }
+            }
+            if (g != null) {
+                val f: Float
+                val fold: Float
+                if (yieldBack && i < yieldFrom.size) {
+                    // The tile nearest the gap comes back first, so no icon crosses one on its way.
+                    val u = ((back - 0.1f * min(g.rank[i], 3)) / 0.7f).coerceIn(0f, 1f)
+                    f = yieldFrom[i][0] * (1f - springOut(u))
+                    fold = yieldFrom[i][1] * (1f - springOut(((u - 0.25f) / 0.75f).coerceIn(0f, 1f)))
+                } else {
+                    val a = stepAside(i, g)
+                    f = a[0]
+                    fold = a[1]
+                }
+                cx = lerp(cx, g.at[i], f)
+                open *= 1f - fold
+                label *= (1f - fold * 2f).coerceIn(0f, 1f)
+            }
+            t.set(cx - homeCx, cy - homeCy, s, open, label, squash, shown,
+                if (p > 0f) min(1f, p * 12f) else 0f)
+        }
+        // The layer's name shows once the tiles have passed it.
+        title.alpha = ((minP - 0.4f) / 0.3f).coerceIn(0f, 1f)
+    }
+
+    // -----------------------------------------------------------------------------------------
+    // Tiles.
+
+    private fun appTile(app: LujarchBackgroundApp): Tile = Tile(context, icon(app.packageName, app.uid),
+        app.word.orEmpty(), app.ownService, null).apply {
+        contentDescription = context.getString(R.string.lujarch_background_tile, app.label, app.word)
+        setOnClickListener { recents.open(app) }
+        setOnLongClickListener { v ->
+            menu(v, app)
+            true
+        }
+    }
+
+    private fun windowTile(window: LujarchSmallWindow): Tile {
+        val word = context.getString(R.string.lujarch_background_small_window)
+        return Tile(context, icon(window.packageName, UserHandle.getUid(window.userId, 0)), word, false,
+            window).apply {
+            contentDescription = context.getString(R.string.lujarch_background_tile, window.label, word)
+            setOnClickListener { recents.open(window) }
+            setOnLongClickListener { v ->
+                recents.appOf(window)?.let { menu(v, it) }
+                true
+            }
+        }
+    }
+
+    private fun menu(anchor: View, app: LujarchBackgroundApp) {
+        val popup = PopupMenu(context, anchor)
+        // What the app started itself has End running; a run the owner chose leads to its home.
+        if (app.ownService) popup.menu.add(0, END, 0, R.string.lujarch_background_end)
+        else popup.menu.add(0, BACKGROUND, 0, R.string.lujarch_background_usage)
+        popup.menu.add(0, APP_INFO, 1, R.string.app_info_drop_target_label)
+        popup.setOnMenuItemClickListener {
+            when (it.itemId) {
+                END -> recents.end(app)
+                APP_INFO -> recents.openAppInfo(app.packageName, app.uid)
+                else -> recents.openBackgroundUsage(app.packageName, app.uid)
+            }
+            true
+        }
+        popup.show()
+    }
+
+    private fun icon(packageName: String?, uid: Int): Drawable = try {
+        val pm = context.packageManager
+        val info = pm.getApplicationInfoAsUser(packageName ?: "", 0, UserHandle.getUserId(uid))
+        pm.getUserBadgedIcon(info.loadIcon(pm), UserHandle.getUserHandleForUid(uid))
+    } catch (e: Exception) {
+        context.packageManager.defaultActivityIcon
+    }
+
+    /**
+     * One tile, drawn where its motion has it: from an icon in the status bar to the tile in its
+     * place. Its touches stay in its place.
+     */
+    private inner class Tile(
+        context: Context,
+        private val icon: Drawable,
+        word: String,
+        private val own: Boolean,
+        val window: LujarchSmallWindow?,
+    ) : View(context) {
+        var bar = 0
+        private var dx = 0f
+        private var dy = 0f
+        private var s = dp(ICON).toFloat()
+        private var open = 1f
+        private var label = 1f
+        private var squash = 0f
+        private var shown = 1f
+        private var iconAlpha = 1f
+        private val body = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = context.getColor(android.R.color.system_neutral1_800)
+        }
+        private val light = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = context.getColor(android.R.color.system_neutral1_50)
+        }
+        private val text = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = context.getColor(android.R.color.system_neutral1_100)
+            textSize = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, 10.5f, resources.displayMetrics)
+            textAlign = Paint.Align.CENTER
+        }
+        private val word: String = TextUtils.ellipsize(word, text, dp(TILE_W - 6).toFloat(),
+            TextUtils.TruncateAt.END).toString()
+        private val r = RectF()
+
+        fun set(dx: Float, dy: Float, s: Float, open: Float, label: Float, squash: Float,
+                shown: Float, iconAlpha: Float) {
+            this.dx = dx
+            this.dy = dy
+            this.s = s
+            this.open = open
+            this.label = label
+            this.squash = squash
+            this.shown = shown
+            this.iconAlpha = iconAlpha
+            invalidate()
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            if (shown <= 0f) return
+            val cx = dp(TILE_W) / 2f + dx
+            val cy = dp(ICON_CY) + dy
+            val o = open.coerceIn(0f, 1.2f)
+            val bodyAlpha = (open * 4f).coerceIn(0f, 1f) * shown * (if (iconAlpha > 0f) 1f else 0f)
+            if (bodyAlpha > 0f) {
+                val w = lerp(s, dp(TILE_W).toFloat(), o)
+                val h = lerp(s, dp(TILE_H).toFloat(), o)
+                val left = lerp(cx - s / 2, cx - dp(TILE_W) / 2f, o)
+                val top = lerp(cy - s / 2, 0f, o)
+                val radius = lerp(s / 2, dp(TILE_RADIUS).toFloat(), o.coerceIn(0f, 1f))
+                r.set(left, top, left + w, top + h)
+                // What the app runs itself has a lit top edge.
+                if (own && open > 0.6f) {
+                    light.alpha = (255 * bodyAlpha).toInt()
+                    canvas.drawRoundRect(r, radius, radius, light)
+                    r.top += 1.5f * density
+                }
+                body.alpha = (255 * bodyAlpha).toInt()
+                canvas.drawRoundRect(r, radius, radius, body)
+            }
+            val a = iconAlpha * shown
+            if (a > 0f) {
+                canvas.save()
+                canvas.scale(1f + 0.08f * squash, 1f - 0.1f * squash, cx, cy + s / 2)
+                icon.setBounds((cx - s / 2).toInt(), (cy - s / 2).toInt(), (cx + s / 2).toInt(), (cy + s / 2).toInt())
+                icon.alpha = (255 * a).toInt()
+                icon.draw(canvas)
+                canvas.restore()
+            }
+            val l = label * shown
+            if (l > 0f) {
+                text.alpha = (255 * l).toInt()
+                val top = dp(LABEL_Y) + dp(4) * (1f - label)
+                canvas.drawText(word, cx, top - text.ascent(), text)
+            }
+        }
+    }
+
+    private fun dp(v: Int) = (v * density).toInt()
+
+    companion object {
+        private const val END = 1
+        private const val BACKGROUND = 2
+        private const val APP_INFO = 3
+
+        private const val SIDE = 16
+        /** The layer's name below the status bar, the tiles below it. */
+        private const val LABEL_TOP = 6
+        private const val ROW_TOP = 28
+        private const val TILE_W = 64
+        private const val TILE_H = 88
+        private const val GAP = 8
+        private const val TILE_RADIUS = 18
+        private const val ICON = 34
+        private const val ICON_CY = 33
+        private const val LABEL_Y = 58
+        /** Between the tiles and the cards: the edge a lifted card waits at, then the cards. */
+        private const val EDGE_MARGIN = 6
+        private const val CARDS_GAP = 10
+        /** Where the status bar's icons are: the first, the step between them, their size. */
+        private const val BAR_X = 76
+        private const val BAR_STEP = 18
+        private const val BAR_ICON = 14
+        /** The parting starts this far below the edge; parted icons are this far apart. */
+        private const val NEAR = 80
+        private const val PARTED_STEP = 40
+
+        private const val ARRIVE_EACH_MS = 600f
+        private const val ARRIVE_GAP_MS = 80f
+        private const val LEAVE_EACH_MS = 230f
+        private const val LEAVE_GAP_MS = 40f
+        private const val WINDOW_LAND_MS = 450L
+        private const val WINDOW_SHOW_MS = 150L
+        private const val RETURN_MS = 560L
+        private const val BACK_RETURN_MS = 150L
+        private const val LEAVE_RETURN_MS = 300L
+        private const val YIELD_W = 9f
+        private const val OPEN = 0.97f
+        private val STANDARD = PathInterpolator(0.2f, 0f, 0f, 1f)
+
+        /** The space the layer takes above a phone's cards, below the status bar, in pixels. */
+        @JvmStatic
+        fun spaceAbove(context: Context): Int =
+            ((ROW_TOP + TILE_H + EDGE_MARGIN + CARDS_GAP) * context.resources.displayMetrics.density).toInt()
+
+        private fun lerp(a: Float, b: Float, t: Float) = a + (b - a) * t
+
+        private fun smooth(p: Float) = p * p * (3 - 2 * p)
+
+        /** A soft spring for a tile opening out of its icon: it barely overshoots. */
+        private fun openOut(p: Float) = if (p >= 1f) 1f else 1f - exp(-6f * p) * cos(6f * p)
+
+        private fun springOut(p: Float) = if (p >= 1f) 1f else 1f - exp(-5.5f * p) * cos(8.5f * p)
+    }
+}
