--- /dev/null
+++ b/quickstep/src/com/android/quickstep/lujarch/LujarchRecents.kt
@@ -0,0 +1,336 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.quickstep.lujarch
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.Intent
+import android.graphics.Rect
+import android.os.Handler
+import android.os.Looper
+import android.os.UserHandle
+import android.provider.Settings
+import android.util.Log
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.Toast
+import com.android.internal.app.LujarchBackground
+import com.android.internal.app.LujarchBackgroundApp
+import com.android.internal.app.LujarchBackgroundMemory
+import com.android.internal.app.LujarchSmallWindow
+import com.android.launcher3.R
+import com.android.launcher3.dragndrop.DragLayer
+import com.android.launcher3.util.Executors.MAIN_EXECUTOR
+import com.android.launcher3.util.Executors.UI_HELPER_EXECUTOR
+import com.android.launcher3.views.BaseDragLayer
+import com.android.quickstep.views.RecentsView
+import com.android.quickstep.views.TaskView
+import com.android.systemui.shared.system.ActivityManagerWrapper
+
+/**
+ * Lujarch's Background in Recents: the Running layer above the cards (BG-11), the memory below
+ * them (BG-12), the mark of a kept app's card, which cannot be swiped away and which Clear all
+ * skips (BG-5), the reclaimed card's look, and a card dropped on the Running layer opening in a
+ * small window (WIN-11). Everything comes from Background's one API.
+ */
+class LujarchRecents(
+    private val recentsView: RecentsView<*, *>,
+    private val dragLayer: DragLayer,
+    spaceBelowActions: () -> Int,
+) {
+    private val context: Context = recentsView.context
+    private val handler = Handler(Looper.getMainLooper())
+    val runningLayer = RunningLayerView(context, this)
+    val memoryRow = MemoryRowView(context, this, spaceBelowActions)
+    /** The apps by "userId:package". */
+    private var apps: Map<String, LujarchBackgroundApp> = emptyMap()
+    /** The small windows, from the Shell through Background, in the order of the screen. */
+    private var windows: List<LujarchSmallWindow> = emptyList()
+    private var memory: LujarchBackgroundMemory? = null
+    private var overview = false
+    private var alpha = 0f
+    private var showRunning = true
+    private var showMemory = true
+    private var picked: Pickup? = null
+
+    init {
+        // The drag layer's own layout params: it turns others into them and drops their gravity.
+        dragLayer.addView(runningLayer, BaseDragLayer.LayoutParams(
+            FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT).apply {
+            gravity = Gravity.TOP
+        })
+        dragLayer.addView(memoryRow, BaseDragLayer.LayoutParams(
+            FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT).apply {
+            gravity = Gravity.BOTTOM
+        })
+        runningLayer.visibility = View.INVISIBLE
+        memoryRow.visibility = View.INVISIBLE
+    }
+
+    /** Recents opens or closes. */
+    fun onOverviewEnabled(enabled: Boolean) {
+        overview = enabled
+        if (enabled) refresh()
+        updateVisibility()
+    }
+
+    fun onContentAlpha(value: Float) {
+        alpha = value
+        updateVisibility()
+    }
+
+    private fun updateVisibility() {
+        val shown = overview && alpha > 0f
+        runningLayer.alpha = alpha
+        memoryRow.alpha = alpha
+        runningLayer.visibility = if (shown && showRunning && runningLayer.hasEntries) View.VISIBLE else View.INVISIBLE
+        memoryRow.visibility = if (shown && showMemory && memory != null) View.VISIBLE else View.INVISIBLE
+    }
+
+    /** Reads where every app is now, off the main thread, and shows it. */
+    fun refresh() {
+        val resolver = context.contentResolver
+        showRunning = Settings.Secure.getInt(resolver, LujarchBackground.SETTING_RECENTS_RUNNING, 1) != 0
+        showMemory = Settings.Secure.getInt(resolver, LujarchBackground.SETTING_RECENTS_MEMORY, 1) != 0
+        val user = UserHandle.myUserId()
+        UI_HELPER_EXECUTOR.execute {
+            try {
+                val service = LujarchBackground.get()
+                if (service == null) {
+                    Log.w(TAG, "Recents: Background is not available")
+                    return@execute
+                }
+                val list = service.getApps(user, false)
+                val shown = service.smallWindows.orEmpty().filter { it.userId == user }
+                val mem = service.memory
+                MAIN_EXECUTOR.execute { show(list, shown, mem) }
+            } catch (e: Exception) {
+                Log.e(TAG, "Recents: the background cannot be read", e)
+            }
+        }
+    }
+
+    private fun show(
+        list: Array<LujarchBackgroundApp>,
+        shown: List<LujarchSmallWindow>,
+        mem: LujarchBackgroundMemory,
+    ) {
+        val byKey = HashMap<String, LujarchBackgroundApp>()
+        list.forEach { byKey["${UserHandle.getUserId(it.uid)}:${it.packageName}"] = it }
+        apps = byKey
+        windows = shown
+        memory = mem
+        val home = context.packageName
+        // An app in a small window is there as its window; the others as what they run.
+        runningLayer.bind(list.filter {
+            it.packageName != home && !it.settling && !it.smallWindow &&
+                (it.depth == LujarchBackground.DEPTH_RUNNING || it.depth == LujarchBackground.DEPTH_MESSAGES)
+        }.sortedBy { it.depth }, shown)
+        memoryRow.bind(mem)
+        markTaskViews()
+        updateVisibility()
+    }
+
+    /** The kept mark and the reclaimed look on each card. */
+    fun markTaskViews() {
+        try {
+            for (tv in recentsView.taskViews) {
+                val app = appOf(tv)
+                TaskMarks.mark(tv, kept = app?.kept == true,
+                    reclaimed = app?.depth == LujarchBackground.DEPTH_RECLAIMED)
+                installPickup(tv)
+            }
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "Recents: the cards are not marked", e)
+        }
+    }
+
+    private fun appOf(tv: TaskView): LujarchBackgroundApp? {
+        val task = tv.taskContainers.firstOrNull()?.task ?: return null
+        return apps["${task.key.userId}:${task.key.packageName}"]
+    }
+
+    /** A kept app's card stays (BG-5). */
+    fun isKept(tv: TaskView): Boolean = appOf(tv)?.kept == true
+
+    /** Says why a kept card sprang back. */
+    fun onKeptCardHeld() {
+        Toast.makeText(context, R.string.lujarch_background_kept_toast, Toast.LENGTH_SHORT).show()
+    }
+
+    /**
+     * Clear all with kept cards: every other card is dismissed and the kept ones stay. Returns
+     * false when nothing is kept, and Clear all goes on as Android's.
+     */
+    fun clearAllButKept(): Boolean {
+        val views = recentsView.taskViews.toList()
+        if (views.none { isKept(it) }) return false
+        views.filter { !isKept(it) }.forEachIndexed { i, tv ->
+            handler.postDelayed({ recentsView.dismissTaskView(tv, true) }, i * CLEAR_STEP_MS)
+        }
+        return true
+    }
+
+    /** Opens the Background page of an app, or Settings > System > Background. */
+    fun openBackground(packageName: String?, uid: Int) {
+        val intent = if (packageName == null) Intent(LujarchBackground.ACTION_BACKGROUND)
+        else Intent(LujarchBackground.ACTION_APP)
+            .putExtra(Intent.EXTRA_PACKAGE_NAME, packageName)
+            .putExtra(Intent.EXTRA_USER, UserHandle.getUserHandleForUid(uid))
+        intent.setPackage(LujarchBackground.SETTINGS_PACKAGE)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+        try {
+            context.startActivityAsUser(intent, UserHandle.getUserHandleForUid(maxOf(uid, 0)))
+        } catch (e: Exception) {
+            Log.e(TAG, "Recents: the Background page cannot be opened", e)
+        }
+    }
+
+    /** End: stops what the app runs of its own. */
+    fun end(app: LujarchBackgroundApp) {
+        UI_HELPER_EXECUTOR.execute {
+            try {
+                LujarchBackground.get()?.endForegroundServices(app.packageName, UserHandle.getUserId(app.uid))
+            } catch (e: Exception) {
+                Log.e(TAG, "Recents: End for ${app.packageName} failed", e)
+            }
+            MAIN_EXECUTOR.execute { handler.postDelayed({ refresh() }, 800) }
+        }
+    }
+
+    /**
+     * A tap on a small window's place opens it, and Recents leaves as a tap outside the cards
+     * leaves it: the window grows out of its place over the home screen.
+     */
+    fun open(window: LujarchSmallWindow) {
+        openSmallWindow?.invoke(window.key)
+        recentsView.startHome()
+    }
+
+    /** The app of a small window, when it runs. */
+    fun appOf(window: LujarchSmallWindow): LujarchBackgroundApp? =
+        apps["${window.userId}:${window.packageName}"]
+
+    /** A tap on the Running layer opens the app: its card's task, or the app itself. */
+    fun open(app: LujarchBackgroundApp) {
+        val user = UserHandle.getUserHandleForUid(app.uid)
+        if (app.hasTask && app.taskId >= 0 &&
+            ActivityManagerWrapper.getInstance().startActivityFromRecents(app.taskId, null)) {
+            return
+        }
+        launchIntent(app)?.let {
+            try {
+                context.startActivityAsUser(it.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK), user)
+            } catch (e: Exception) {
+                Log.e(TAG, "Recents: ${app.packageName} cannot be opened", e)
+            }
+        }
+    }
+
+    private fun launchIntent(app: LujarchBackgroundApp): Intent? =
+        context.packageManager.getLaunchIntentForPackage(app.packageName)
+            ?: run {
+                Log.w(TAG, "Recents: ${app.packageName} has no launcher activity")
+                null
+            }
+
+    // -------------------------------------------------------------------------------------
+    // A card dropped on the Running layer opens in a small window (WIN-11).
+
+    private class Pickup(val view: TaskView, val x: Float, val y: Float, val tx: Float, val ty: Float)
+
+    @SuppressLint("ClickableViewAccessibility")
+    private fun installPickup(tv: TaskView) {
+        if (tv.getTag(R.id.lujarch_background_pickup) != null) return
+        tv.setTag(R.id.lujarch_background_pickup, true)
+        var downX = 0f
+        var downY = 0f
+        tv.setOnTouchListener { v, ev ->
+            val p = picked
+            when (ev.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downX = ev.rawX
+                    downY = ev.rawY
+                    false
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    if (p == null || p.view != v) return@setOnTouchListener false
+                    v.translationX = p.tx + ev.rawX - p.x
+                    v.translationY = p.ty + ev.rawY - p.y
+                    runningLayer.setDropTarget(isOverLayer(ev))
+                    true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    if (p == null || p.view != v) return@setOnTouchListener false
+                    val drop = ev.actionMasked == MotionEvent.ACTION_UP && isOverLayer(ev)
+                    picked = null
+                    runningLayer.setDropTarget(false)
+                    v.animate().translationX(p.tx).translationY(p.ty).scaleX(1f).scaleY(1f).setDuration(220).start()
+                    if (drop) openInSmallWindow(tv)
+                    true
+                }
+                else -> false
+            }
+        }
+        tv.setOnLongClickListener { v ->
+            picked = Pickup(tv, downX, downY, v.translationX, v.translationY)
+            v.parent?.requestDisallowInterceptTouchEvent(true)
+            v.animate().scaleX(0.92f).scaleY(0.92f).setDuration(150).start()
+            runningLayer.showDropSlot(true)
+            true
+        }
+    }
+
+    private fun isOverLayer(ev: MotionEvent): Boolean {
+        val r = Rect()
+        runningLayer.getGlobalVisibleRect(r)
+        // The layer's strip and the space just under it take the drop.
+        r.bottom += (24 * context.resources.displayMetrics.density).toInt()
+        return r.contains(ev.rawX.toInt(), ev.rawY.toInt())
+    }
+
+    private fun openInSmallWindow(tv: TaskView) {
+        runningLayer.showDropSlot(false)
+        val task = tv.taskContainers.firstOrNull()?.task ?: return
+        openTaskInSmallWindow?.invoke(tv, task.key.id)
+        Log.i(TAG, "Recents: task ${task.key.id} opens in a small window")
+    }
+
+    /** The Running layer laid out its small windows' places, by bubble key (WIN-11). */
+    fun onSmallWindowSlots(keys: Array<String>, slots: Array<Rect>) {
+        smallWindowSlots?.invoke(keys, slots)
+    }
+
+    companion object {
+        private const val TAG = "lujarch_background"
+        private const val CLEAR_STEP_MS = 90L
+
+        /** Where the small windows wait in the Running layer: the small windows follow it. */
+        @JvmStatic
+        var smallWindowSlots: ((Array<String>, Array<Rect>) -> Unit)? = null
+
+        /** Opens a small window by its bubble key. */
+        @JvmStatic
+        var openSmallWindow: ((String) -> Unit)? = null
+
+        /** Opens a card's task in a small window, growing out of the card. */
+        @JvmStatic
+        var openTaskInSmallWindow: ((TaskView, Int) -> Unit)? = null
+    }
+}
