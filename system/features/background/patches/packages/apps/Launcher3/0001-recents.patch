+ * limitations under the License.
+ */
+
+package com.android.launcher3.lujarch;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.Preference;
+import androidx.preference.TwoStatePreference;
+
+/**
+ * Home settings > Recents: Show running (BG-8), Show app state (BG-10) and Show memory (BG-11),
+ * kept in Settings.Secure, where Recents reads them.
+ */
+public final class RecentsSettings {
+    public static final String KEY_RUNNING = "pref_lujarch_recents_running";
+    public static final String KEY_STATE = "pref_lujarch_recents_state";
+    public static final String KEY_MEMORY = "pref_lujarch_recents_memory";
+    public static final String SETTING_RUNNING = "lujarch_background_recents_running";
+    public static final String SETTING_STATE = "lujarch_background_recents_state";
+    public static final String SETTING_MEMORY = "lujarch_background_recents_memory";
+
+    private RecentsSettings() {
+    }
+
+    /** Binds the preference when it is one of Recents' switches; false otherwise. */
+    public static boolean bind(Context context, Preference preference) {
+        final String setting;
+        if (KEY_RUNNING.equals(preference.getKey())) {
+            setting = SETTING_RUNNING;
+        } else if (KEY_STATE.equals(preference.getKey())) {
+            setting = SETTING_STATE;
+        } else if (KEY_MEMORY.equals(preference.getKey())) {
+            setting = SETTING_MEMORY;
+        } else {
+            return false;
+        }
+        final TwoStatePreference toggle = (TwoStatePreference) preference;
+        toggle.setChecked(Settings.Secure.getInt(context.getContentResolver(), setting, 1) != 0);
+        toggle.setOnPreferenceChangeListener((pref, value) -> Settings.Secure.putInt(
+                context.getContentResolver(), setting, (Boolean) value ? 1 : 0));
+        return true;
+    }
+}
