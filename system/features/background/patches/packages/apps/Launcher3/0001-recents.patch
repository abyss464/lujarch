+
+package com.android.quickstep.lujarch
+
+import android.app.AppOpsManager
+import android.os.UserHandle
+import android.util.Log
+import android.view.View
+import com.android.internal.app.LujarchBackground
+import com.android.launcher3.R
+import com.android.launcher3.popup.SystemShortcut
+import com.android.launcher3.util.Executors.MAIN_EXECUTOR
+import com.android.launcher3.util.Executors.UI_HELPER_EXECUTOR
+import com.android.quickstep.views.RecentsViewContainer
+import com.android.quickstep.views.TaskContainer
+
+/** Keep and Remove keep in a card's menu, Keep's home (BG-4). */
+object LujarchKeep {
+    private const val TAG = "lujarch_background"
+
+    /** The card's Keep or Remove keep; none for a task without an app the owner can keep. */
+    @JvmStatic
+    fun shortcuts(container: RecentsViewContainer, taskContainer: TaskContainer): List<SystemShortcut<*>>? {
+        val key = taskContainer.task.key
+        val context = container.asContext()
+        val uid = try {
+            context.packageManager.getApplicationInfoAsUser(key.packageName, 0, key.userId).uid
+        } catch (e: Exception) {
+            Log.w(TAG, "Recents: no app for ${key.packageName}", e)
+            return null
+        }
+        if (UserHandle.getAppId(uid) < android.os.Process.FIRST_APPLICATION_UID) return null
+        val kept = context.getSystemService(AppOpsManager::class.java)!!.unsafeCheckOpRawNoThrow(
+            AppOpsManager.OP_LUJARCH_KEEP, uid, key.packageName) == AppOpsManager.MODE_ALLOWED
+        return listOf(Shortcut(container, taskContainer, key.packageName, key.userId, kept))
+    }
+
+    private class Shortcut(
+        container: RecentsViewContainer,
+        taskContainer: TaskContainer,
+        private val packageName: String,
+        private val userId: Int,
+        private val kept: Boolean,
+    ) : SystemShortcut<RecentsViewContainer>(
+        R.drawable.lujarch_ic_keep,
+        if (kept) R.string.lujarch_background_remove_keep else R.string.lujarch_background_keep,
+        container, taskContainer.itemInfo, taskContainer.taskView,
+    ) {
+        override fun onClick(view: View) {
+            dismissTaskMenuView()
+            UI_HELPER_EXECUTOR.execute {
+                try {
+                    LujarchBackground.get()?.setKept(packageName, userId, !kept)
+                        ?: Log.e(TAG, "Recents: the Background service is not running")
+                } catch (e: Exception) {
+                    Log.e(TAG, "Recents: Keep for $packageName failed", e)
+                }
+                MAIN_EXECUTOR.execute { refresh?.invoke() }
+            }
+        }
+    }
+
+    /** Reads the apps again, so that the card shows its mark. */
+    @JvmStatic
+    var refresh: (() -> Unit)? = null
+}
