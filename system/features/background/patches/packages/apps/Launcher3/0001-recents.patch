+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.quickstep.lujarch
+
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.DashPathEffect
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.drawable.Drawable
+import com.android.internal.app.LujarchBackground
+import com.android.launcher3.R
+import com.android.quickstep.views.TaskView
+
+/**
+ * The marks of Background on a card in Recents (BG-10): the app's memory while it is in memory, a
+ * short mark at the top corner of a kept app's card (BG-4), and a reclaimed app's card dimmed with
+ * a dashed outline and Opens again. Drawn over the card, which keeps its place, size and order.
+ */
+object TaskMarks {
+    /** The marks fade out as a card opens. */
+    var alpha = 1f
+
+    fun mark(tv: TaskView, kept: Boolean, reclaimed: Boolean, memory: String?) {
+        val old = tv.getTag(R.id.lujarch_background_mark) as? Mark
+        if (!kept && !reclaimed && memory == null) {
+            if (old != null) {
+                tv.overlay.remove(old)
+                tv.setTag(R.id.lujarch_background_mark, null)
+            }
+            return
+        }
+        val m = old ?: Mark(tv).also {
+            tv.overlay.add(it)
+            tv.setTag(R.id.lujarch_background_mark, it)
+        }
+        m.kept = kept
+        m.reclaimed = reclaimed
+        m.memory = memory
+        m.setBounds(0, 0, tv.width, tv.height)
+        m.invalidateSelf()
+    }
+
+    private class Mark(private val tv: TaskView) : Drawable() {
+        var kept = false
+        var reclaimed = false
+        var memory: String? = null
+        private val context = tv.context
+        private val density = context.resources.displayMetrics.density
+        private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val dashed = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = 1.5f * density
+            pathEffect = DashPathEffect(floatArrayOf(6 * density, 4 * density), 0f)
+        }
+        private val text = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.CENTER
+            textSize = 11f * context.resources.displayMetrics.scaledDensity
+        }
+        private val pill = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = context.getColor(android.R.color.system_neutral1_800)
+        }
+        private val pillText = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = context.getColor(android.R.color.system_neutral1_100)
+        }
+        private val card = Rect()
+        private val r = RectF()
+
+        override fun draw(canvas: Canvas) {
+            // The card's picture, inside the task view.
+            val snapshot = tv.taskContainers.firstOrNull()?.taskContentView ?: return
+            card.set(snapshot.left, snapshot.top, snapshot.right, snapshot.bottom)
+            if (card.isEmpty || alpha <= 0f) return
+            if (alpha < 1f) canvas.saveLayerAlpha(null, (255 * alpha).toInt())
+            drawMarks(canvas)
+            if (alpha < 1f) canvas.restore()
+        }
+
+        private fun drawMarks(canvas: Canvas) {
+            val radius = 14 * density
+            if (reclaimed) {
+                fill.color = 0x8C000000.toInt()
+                r.set(card)
+                canvas.drawRoundRect(r, radius, radius, fill)
+                dashed.color = LujarchBackground.stateColor(context, LujarchBackground.RUN_PAUSED.toInt())
+                r.inset(dashed.strokeWidth / 2, dashed.strokeWidth / 2)
+                canvas.drawRoundRect(r, radius, radius, dashed)
+                text.color = context.getColor(android.R.color.system_accent1_100)
+                canvas.drawText(context.getString(R.string.lujarch_background_opens_again),
+                    card.exactCenterX(), card.bottom - 14 * density, text)
+            }
+            if (kept) {
+                fill.color = context.getColor(android.R.color.system_accent1_200)
+                val w = 4 * density
+                r.set(card.right - w, card.top + radius, card.right.toFloat(), card.top + radius + 40 * density)
+                canvas.drawRoundRect(r, w / 2, w / 2, fill)
+            }
+            val m = memory ?: return
+            // The current card has it at its top corner, a folded card at its bottom corner.
+            val big = tv.isLargeTile
+            pillText.textSize = (if (big) 11f else 10f) * context.resources.displayMetrics.scaledDensity
+            val h = (if (big) 22 else 20) * density
+            val pad = (if (big) 8 else 7) * density
+            val inset = (if (big) 8 else 6) * density
+            val w = pillText.measureText(m) + pad * 2
+            if (big) {
+                r.set(card.right - inset - w, card.top + inset + 3 * density, card.right - inset,
+                    card.top + inset + 3 * density + h)
+            } else {
+                r.set(card.left + inset, card.bottom - inset - h, card.left + inset + w, card.bottom - inset)
+            }
+            pill.alpha = 240
+            canvas.drawRoundRect(r, h / 2, h / 2, pill)
+            val fm = pillText.fontMetrics
+            canvas.drawText(m, r.left + pad, r.centerY() - (fm.ascent + fm.descent) / 2, pillText)
+        }
+
+        override fun setAlpha(alpha: Int) {}
+
+        override fun setColorFilter(colorFilter: ColorFilter?) {}
+
+        @Deprecated("Deprecated in Java")
+        override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+    }
+}
