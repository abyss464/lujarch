+
+/**
+ * The memory below the cards in Recents (BG-12): the same four parts as Settings > System >
+ * Background, with Background, which opens that page. It sits under the actions, just above the
+ * navigation.
+ */
+class MemoryRowView(
+    context: Context,
+    private val recents: LujarchRecents,
+    private val spaceBelowActions: () -> Int,
+) :
+    LinearLayout(context), Insettable {
+    private val free = TextView(context)
+    private val bar = Bar(context)
+
+    init {
+        orientation = VERTICAL
+        val side = dp(16)
+        setPadding(side, 0, side, dp(4))
+        val top = LinearLayout(context).apply {
+            orientation = HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+        }
+        free.fontFeatureSettings = "tnum"
+        free.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+        free.setTextColor(context.getColor(android.R.color.system_neutral1_100))
+        top.addView(free, LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f))
+        top.addView(TextView(context).apply {
+            text = context.getString(R.string.lujarch_background_open, context.getString(R.string.lujarch_background_title))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 13.5f)
+            setTextColor(context.getColor(android.R.color.system_accent1_200))
+            val p = dp(10)
+            setPadding(p, dp(6), p, dp(6))
+            isClickable = true
+            setOnClickListener { recents.openBackground(null, -1) }
+        })
+        addView(top)
+        addView(bar, LayoutParams(LayoutParams.MATCH_PARENT, dp(8)).apply { topMargin = dp(4) })
+    }
+
+    override fun setInsets(insets: Rect) {
+        (layoutParams as? ViewGroup.MarginLayoutParams)?.let {
+            it.bottomMargin = spaceBelowActions() + dp(8)
+            layoutParams = it
+        }
+    }
+
+    fun bind(m: LujarchBackgroundMemory) {
+        free.text = context.getString(R.string.lujarch_background_free_of,
+            Formatter.formatShortFileSize(context, m.freeBytes),
+            Formatter.formatShortFileSize(context, m.totalBytes))
+        bar.memory = m
+        bar.invalidate()
+    }
+
+    private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()
+
+    private class Bar(context: Context) : View(context) {
+        var memory: LujarchBackgroundMemory? = null
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val rect = RectF()
+
+        override fun onDraw(canvas: Canvas) {
+            val m = memory ?: return
+            val parts = longArrayOf(m.systemBytes, m.appsBytes, m.keptBytes, m.freeBytes)
+            val total = parts.sum().coerceAtLeast(1)
+            val gap = 2 * resources.displayMetrics.density
+            var x = 0f
+            for (i in parts.indices) {
+                val w = width.toFloat() * parts[i] / total
+                if (w <= 0f) continue
+                paint.color = LujarchBackground.memoryColor(context, i)
+                rect.set(x, 0f, (x + w - gap).coerceAtLeast(x + 1f), height.toFloat())
+                canvas.drawRoundRect(rect, height / 2f, height / 2f, paint)
+                x += w
+            }
+        }
+    }
+}
diff --git a/quickstep/src/com/android/quickstep/lujarch/RunningLayerView.kt b/quickstep/src/com/android/quickstep/lujarch/RunningLayerView.kt
new file mode 100644
index 0000000000000000000000000000000000000000..1d9d161e9ee26086152619b834331584628c2207
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/lujarch/RunningLayerView.kt
@@ -0,0 +1,259 @@
+/*
