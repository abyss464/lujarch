+package com.android.quickstep.lujarch
+
+import android.animation.ValueAnimator
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.Intent
+import android.graphics.Rect
+import android.net.Uri
+import android.os.Handler
+import android.os.Looper
+import android.os.UserHandle
+import android.provider.Settings
+import android.text.format.Formatter
+import android.util.Log
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.Toast
+import com.android.internal.app.LujarchBackground
+import com.android.internal.app.LujarchBackgroundApp
+import com.android.internal.app.LujarchBackgroundMemory
+import com.android.internal.app.LujarchSmallWindow
+import com.android.launcher3.R
+import com.android.launcher3.dragndrop.DragLayer
+import com.android.launcher3.util.Executors.MAIN_EXECUTOR
+import com.android.launcher3.util.Executors.UI_HELPER_EXECUTOR
+import com.android.launcher3.views.BaseDragLayer
+import com.android.quickstep.views.RecentsView
+import com.android.quickstep.views.TaskView
+import com.android.systemui.shared.system.ActivityManagerWrapper
+
+/**
+ * Lujarch's Background in Recents: the Running layer above the cards (BG-8), the two rows and each
+ * card's state (BG-10), the memory below them (BG-11), a kept app's card, which cannot be swiped
+ * away and which Clear all skips (BG-4), and a card dropped on the Running layer opening in a small
+ * window (WIN-11). Everything comes from Background's one API.
+ */
+class LujarchRecents(
+    private val recentsView: RecentsView<*, *>,
+    private val dragLayer: DragLayer,
+    spaceBelowActions: () -> Int,
+) {
+    private val context: Context = recentsView.context
+    private val handler = Handler(Looper.getMainLooper())
+    val runningLayer = RunningLayerView(context, this)
+    val memoryRow = MemoryRowView(context, this, spaceBelowActions)
+    /** The apps by "userId:package". */
+    private var apps: Map<String, LujarchBackgroundApp> = emptyMap()
+    /** The small windows, from the Shell through Background, in the order of the screen. */
+    private var windows: List<LujarchSmallWindow> = emptyList()
+    private var memory: LujarchBackgroundMemory? = null
+    private var overview = false
+    /** Recents has settled, or is on its way to: the Running layer is down from the status bar. */
+    private var settled = false
+    private var alpha = 0f
+    private var memoryShown = 0f
+    private var memoryAnim: ValueAnimator? = null
+    private var marksAnim: ValueAnimator? = null
+    private var showRunning = true
+    private var showMemory = true
+    private var picked: Pickup? = null
+
+    init {
+        LujarchKeep.refresh = { refresh() }
+        readLayout()
+        // The drag layer's own layout params: it turns others into them and drops their gravity.
+        dragLayer.addView(runningLayer, BaseDragLayer.LayoutParams(
+            FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT).apply {
+            gravity = Gravity.TOP
+        })
+        dragLayer.addView(memoryRow, BaseDragLayer.LayoutParams(
+            FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT).apply {
+            gravity = Gravity.BOTTOM
+        })
+        runningLayer.visibility = View.INVISIBLE
+        memoryRow.visibility = View.INVISIBLE
+        runningLayer.onArrival = { updateVisibility() }
+        if (runningSpace != 0) recentsView.lujarchRelayout()
+    }
+
+    /** Recents opens or closes. */
+    fun onOverviewEnabled(enabled: Boolean) {
+        overview = enabled
+        if (enabled) refresh()
+        updateVisibility()
+    }
+
+    /**
+     * The launcher moves to a state. A swipe up from an app starts the move to Recents at once;
+     * Recents settles only when the swipe ends ([onSwipeEnd]).
+     */
+    fun onStateTransitionStart(settles: Boolean) {
+        if (!swiping) settle(settles)
+    }
+
+    fun onStateTransitionComplete(settles: Boolean) {
+        swiping = false
+        settle(settles)
+    }
+
+    /**
+     * Recents settling brings the Running layer down from the status bar and fades the memory in
+     * after the fold (BG-8, BG-10), and the small windows fly into their tiles (WIN-11); leaving
+     * sends them back.
+     */
+    private fun settle(settles: Boolean) {
+        if (settles == settled) return
+        settled = settles
+        recentsSettled?.invoke(settles)
+        if (settles) {
+            refresh()
+            runningLayer.arrive(ARRIVE_DELAY_MS)
+            fadeMemory(1f, MEMORY_IN_MS, MEMORY_IN_DELAY_MS)
+            fadeMarks(1f, 0L)
+        } else {
+            runningLayer.leave()
+            fadeMemory(0f, FADE_OUT_MS, 0L)
+        }
+        updateVisibility()
+    }
+
+    /** A card opens: the memory and the cards' marks fade out and the layer goes up. */
+    fun onCardLaunch() {
+        if (!settled) return
+        settled = false
+        recentsSettled?.invoke(false)
+        runningLayer.leave()
+        fadeMemory(0f, FADE_OUT_MS, 0L)
+        fadeMarks(0f, FADE_OUT_MS)
+    }
+
+    /** Clear all: the Running layer goes up first and comes down once the cards are gone. */
+    fun onClearAll() {
+        if (!settled) return
+        val n = recentsView.taskViews.count { !isKept(it) }
+        runningLayer.clearAll(n * CLEAR_STEP_MS + CLEAR_SETTLE_MS)
+    }
+
+    /**
+     * A card is lifted to be swiped away: the Running layer parts around it and holds it back
+     * until the way is clear (BG-8). [apply] moves the card; null when nothing is in its way.
+     */
+    fun hold(tv: TaskView, apply: (Float) -> Unit): RunningLayerView.Held? {
+        if (runningLayer.visibility != View.VISIBLE ||
+            context.resources.configuration.orientation ==
+                android.content.res.Configuration.ORIENTATION_LANDSCAPE) {
+            return null
+        }
+        val r = Rect()
+        tv.getThumbnailBounds(r, relativeToDragLayer = true)
+        val ty = tv.secondaryDismissTranslationProperty.get(tv)
+        val at = IntArray(2)
+        dragLayer.getLocationOnScreen(at)
+        return runningLayer.hold(r.top - ty + at[1], (r.left + at[0]).toFloat(),
+            (r.right + at[0]).toFloat(), apply)
+    }
+
+    fun onContentAlpha(value: Float) {
+        alpha = value
+        updateVisibility()
+    }
+
+    private fun fadeMemory(to: Float, ms: Long, delay: Long) {
+        memoryAnim?.cancel()
+        memoryAnim = ValueAnimator.ofFloat(memoryShown, to).apply {
+            duration = ms
+            startDelay = delay
+            addUpdateListener {
+                memoryShown = it.animatedValue as Float
+                updateVisibility()
+            }
+            start()
+        }
+    }
+
+    private fun fadeMarks(to: Float, ms: Long) {
+        marksAnim?.cancel()
+        if (ms == 0L) {
+            TaskMarks.alpha = to
+            invalidateMarks()
+            return
+        }
+        marksAnim = ValueAnimator.ofFloat(TaskMarks.alpha, to).apply {
+            duration = ms
+            addUpdateListener {
+                TaskMarks.alpha = it.animatedValue as Float
+                invalidateMarks()
+            }
+            start()
+        }
+    }
+
+    private fun invalidateMarks() {
+        try {
+            recentsView.taskViews.forEach { it.invalidate() }
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "Recents: the cards' marks are not redrawn", e)
+        }
+    }
+
+    private fun updateVisibility() {
+        val shown = overview && alpha > 0f
+        memoryRow.alpha = alpha * memoryShown
+        // The Running layer moves by itself, into the status bar and out of it.
+        runningLayer.visibility = if (showRunning && runningLayer.hasEntries &&
+            (overview || runningLayer.isMoving)) View.VISIBLE else View.INVISIBLE
+        if (!overview && !runningLayer.isMoving) runningLayer.reset()
+        memoryRow.visibility = if (shown && showMemory && memory != null && memoryShown > 0f)
+            View.VISIBLE else View.INVISIBLE
+    }
+
+    /** Reads where every app is now, off the main thread, and shows it. */
+    fun refresh() {
+        val resolver = context.contentResolver
+        showMemory = Settings.Secure.getInt(resolver, LujarchBackground.SETTING_RECENTS_MEMORY, 1) != 0
+        if (readLayout()) recentsView.lujarchRelayout()
+        val user = UserHandle.myUserId()
+        UI_HELPER_EXECUTOR.execute {
+            try {
+                val service = LujarchBackground.get()
+                if (service == null) {
+                    Log.w(TAG, "Recents: Background is not available")
+                    return@execute
+                }
+                val list = service.getApps(user, false)
+                val shown = service.smallWindows.orEmpty().filter { it.userId == user }
+                val mem = service.memory
+                MAIN_EXECUTOR.execute { show(list, shown, mem) }
+            } catch (e: Exception) {
+                Log.e(TAG, "Recents: the background cannot be read", e)
+            }
+        }
+    }
+
+    private fun show(
+        list: Array<LujarchBackgroundApp>,
+        shown: List<LujarchSmallWindow>,
+        mem: LujarchBackgroundMemory,
+    ) {
+        val byKey = HashMap<String, LujarchBackgroundApp>()
+        list.forEach { byKey["${UserHandle.getUserId(it.uid)}:${it.packageName}"] = it }
+        apps = byKey
+        windows = shown
+        memory = mem
+        val home = context.packageName
+        // An app in a small window is there as its window; the others as what they run.
+        runningLayer.bind(list.filter {
+            it.packageName != home && !it.settling && !it.smallWindow &&
+                it.state == LujarchBackground.RUN_BACKGROUND.toInt()
+        }, shown)
+        memoryRow.bind(mem)
+        markTaskViews()
+        updateVisibility()
+    }
+
+    /** The kept mark and the reclaimed look on each card. */
+    fun markTaskViews() {
+        try {
+            for (tv in recentsView.taskViews) {
+                val app = appOf(tv)
+                if (rowsOn) {
+                    val reclaimed = app?.state == LujarchBackground.RUN_RECLAIMED.toInt()
+                    val inMemory = app != null && !reclaimed && app.memoryBytes > 0
+                    TaskMarks.mark(tv, kept = app?.kept == true, reclaimed = reclaimed,
+                        memory = if (inMemory) Formatter.formatShortFileSize(context, app!!.memoryBytes) else null)
+                } else {
+                    TaskMarks.mark(tv, kept = false, reclaimed = false, memory = null)
+                }
+                installPickup(tv)
+            }
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "Recents: the cards are not marked", e)
+        }
+    }
+
+    private fun appOf(tv: TaskView): LujarchBackgroundApp? {
+        val task = tv.taskContainers.firstOrNull()?.task ?: return null
+        return apps["${task.key.userId}:${task.key.packageName}"]
+    }
+
+    /** A kept app's card stays (BG-5). */
+    fun isKept(tv: TaskView): Boolean = appOf(tv)?.kept == true
+
+    /** Says why a kept card sprang back. */
+    fun onKeptCardHeld() {
+        Toast.makeText(context, R.string.lujarch_background_kept_toast, Toast.LENGTH_SHORT).show()
+    }
+
+    /**
+     * Clear all with kept cards: every other card is dismissed and the kept ones stay. Returns
+     * false when nothing is kept, and Clear all goes on as Android's.
+     */
+    fun clearAllButKept(): Boolean {
+        val views = recentsView.taskViews.toList()
+        if (views.none { isKept(it) }) return false
+        views.filter { !isKept(it) }.forEachIndexed { i, tv ->
+            handler.postDelayed({ recentsView.dismissTaskView(tv, true) }, i * CLEAR_STEP_MS)
+        }
+        return true
+    }
+
+    /** Settings > System > Memory (BG-11). */
+    fun openMemory() {
+        start(Intent(LujarchBackground.ACTION_MEMORY).setPackage(LujarchBackground.SETTINGS_PACKAGE), 0)
+    }
+
+    /** The app's Allow background usage, its home (BG-8). */
+    fun openBackgroundUsage(packageName: String, uid: Int) {
+        start(Intent(Settings.ACTION_VIEW_ADVANCED_POWER_USAGE_DETAIL)
+            .setData(Uri.fromParts("package", packageName, null))
+            .putExtra(LujarchBackground.EXTRA_ALLOW_BACKGROUND_USAGE, true), uid)
+    }
+
+    fun openAppInfo(packageName: String, uid: Int) {
+        start(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS)
+            .setData(Uri.fromParts("package", packageName, null)), uid)
+    }
+
+    private fun start(intent: Intent, uid: Int) {
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+        try {
+            context.startActivityAsUser(intent, UserHandle.getUserHandleForUid(maxOf(uid, 0)))
+        } catch (e: Exception) {
+            Log.e(TAG, "Recents: ${intent.action} cannot be opened", e)
+        }
+    }
+
+    /** End: stops what the app runs of its own. */
+    fun end(app: LujarchBackgroundApp) {
+        UI_HELPER_EXECUTOR.execute {
+            try {
+                LujarchBackground.get()?.endForegroundServices(app.packageName, UserHandle.getUserId(app.uid))
+            } catch (e: Exception) {
+                Log.e(TAG, "Recents: End for ${app.packageName} failed", e)
+            }
+            MAIN_EXECUTOR.execute { handler.postDelayed({ refresh() }, 800) }
+        }
+    }
+
+    /**
+     * A tap on a small window's place opens it, and Recents leaves as a tap outside the cards
+     * leaves it: the window grows out of its place over the home screen.
+     */
+    fun open(window: LujarchSmallWindow) {
+        openSmallWindow?.invoke(window.key)
+        recentsView.startHome()
+    }
+
+    /** The app of a small window, when it runs. */
+    fun appOf(window: LujarchSmallWindow): LujarchBackgroundApp? =
+        apps["${window.userId}:${window.packageName}"]
+
+    /** A tap on the Running layer opens the app: its card's task, or the app itself. */
+    fun open(app: LujarchBackgroundApp) {
+        val user = UserHandle.getUserHandleForUid(app.uid)
+        if (app.hasTask && app.taskId >= 0 &&
+            ActivityManagerWrapper.getInstance().startActivityFromRecents(app.taskId, null)) {
+            return
+        }
+        launchIntent(app)?.let {
+            try {
+                context.startActivityAsUser(it.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK), user)
+            } catch (e: Exception) {
+                Log.e(TAG, "Recents: ${app.packageName} cannot be opened", e)
+            }
+        }
+    }
+
+    private fun launchIntent(app: LujarchBackgroundApp): Intent? =
+        context.packageManager.getLaunchIntentForPackage(app.packageName)
+            ?: run {
+                Log.w(TAG, "Recents: ${app.packageName} has no launcher activity")
+                null
+            }
+
+    // -------------------------------------------------------------------------------------
+    // A card dropped on the Running layer opens in a small window (WIN-11).
+
+    private class Pickup(val view: TaskView, val x: Float, val y: Float, val tx: Float, val ty: Float)
+
+    @SuppressLint("ClickableViewAccessibility")
+    private fun installPickup(tv: TaskView) {
+        if (tv.getTag(R.id.lujarch_background_pickup) != null) return
+        tv.setTag(R.id.lujarch_background_pickup, true)
+        var downX = 0f
+        var downY = 0f
+        tv.setOnTouchListener { v, ev ->
+            val p = picked
+            when (ev.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downX = ev.rawX
+                    downY = ev.rawY
+                    false
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    if (p == null || p.view != v) return@setOnTouchListener false
+                    v.translationX = p.tx + ev.rawX - p.x
+                    v.translationY = p.ty + ev.rawY - p.y
+                    runningLayer.setDropTarget(isOverLayer(ev))
+                    true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    if (p == null || p.view != v) return@setOnTouchListener false
+                    val drop = ev.actionMasked == MotionEvent.ACTION_UP && isOverLayer(ev)
+                    picked = null
+                    runningLayer.setDropTarget(false)
+                    v.animate().translationX(p.tx).translationY(p.ty).scaleX(1f).scaleY(1f).setDuration(220).start()
+                    if (drop) openInSmallWindow(tv)
+                    true
+                }
+                else -> false
+            }
+        }
+        tv.setOnLongClickListener { v ->
+            if (openTaskInSmallWindow == null || canOpenInSmallWindow?.invoke() != true) {
+                return@setOnLongClickListener false
+            }
+            picked = Pickup(tv, downX, downY, v.translationX, v.translationY)
+            v.parent?.requestDisallowInterceptTouchEvent(true)
+            v.animate().scaleX(0.92f).scaleY(0.92f).setDuration(150).start()
+            runningLayer.showDropSlot(true)
+            true
+        }
+    }
+
+    private fun isOverLayer(ev: MotionEvent): Boolean {
+        val r = Rect()
+        runningLayer.getGlobalVisibleRect(r)
+        // The layer's strip and the space just under it take the drop.
+        r.bottom += (24 * context.resources.displayMetrics.density).toInt()
+        return r.contains(ev.rawX.toInt(), ev.rawY.toInt())
+    }
+
+    private fun openInSmallWindow(tv: TaskView) {
+        runningLayer.showDropSlot(false)
+        val task = tv.taskContainers.firstOrNull()?.task ?: return
+        openTaskInSmallWindow?.invoke(tv, task.key.id)
+        Log.i(TAG, "Recents: task ${task.key.id} opens in a small window")
+    }
+
+    /** The Running layer laid out its small windows' places, by bubble key (WIN-11). */
+    fun onSmallWindowSlots(keys: Array<String>, slots: Array<Rect>) {
+        smallWindowSlots?.invoke(keys, slots)
+    }
+
+    /**
+     * The switches that change where the cards are: the two rows (BG-10) and the Running layer's
+     * place above them (BG-8). Returns whether either changed.
+     */
+    private fun readLayout(): Boolean {
+        val resolver = context.contentResolver
+        showRunning = Settings.Secure.getInt(resolver, LujarchBackground.SETTING_RECENTS_RUNNING, 1) != 0
+        val rows = Settings.Secure.getInt(resolver, LujarchBackground.SETTING_RECENTS_STATE, 1) != 0
+        val space = if (showRunning) RunningLayerView.spaceAbove(context) else 0
+        val changed = rows != rowsOn || space != runningSpace
+        rowsOn = rows
+        runningSpace = space
+        return changed
+    }
+
+    companion object {
+        private const val TAG = "lujarch_background"
+
+        @Volatile
+        private var rowsOn = true
+
+        @Volatile
+        private var runningSpace = 0
+
+        /** A phone's Recents folds into two rows when it settles (BG-10). */
+        @JvmStatic
+        fun foldsIntoRows(dp: com.android.launcher3.DeviceProfile): Boolean =
+            rowsOn && !dp.deviceProperties.isLargeScreen
+
+        /** The height the Running layer takes above a phone's cards, in pixels (BG-8). */
+        @JvmStatic
+        fun spaceAboveCards(dp: com.android.launcher3.DeviceProfile): Int =
+            if (dp.deviceProperties.isLargeScreen) 0 else runningSpace
+
+        private const val CLEAR_STEP_MS = 90L
+        private const val CLEAR_SETTLE_MS = 400L
+        /** The tiles wait for the fold to settle; the memory fades in after it. */
+        private const val ARRIVE_DELAY_MS = 200L
+        private const val MEMORY_IN_MS = 250L
+        private const val MEMORY_IN_DELAY_MS = 100L
+        private const val FADE_OUT_MS = 100L
+
+        /** A swipe up from an app is moving the launcher to Recents. */
+        private var swiping = false
+
+        @JvmStatic
+        fun onSwipeStart() {
+            swiping = true
+        }
+
+        /** The swipe's progress towards Recents while the finger moves, 0 to 1. */
+        @JvmStatic
+        fun onSwipe(progress: Float) {
+            if (swiping) swipeProgress?.invoke(progress.coerceIn(0f, 1f))
+        }
+
+        /** The swipe ends: towards Recents it settles, else what moved with it goes back. */
+        @JvmStatic
+        fun onSwipeEnd(recents: LujarchRecents?, toRecents: Boolean) {
+            if (!swiping) return
+            swiping = false
+            if (!toRecents) swipeProgress?.invoke(0f)
+            recents?.settle(toRecents)
+        }
+
+        /** Recents settled or left: the small windows fly into their tiles or back. */
+        @JvmStatic
+        var recentsSettled: ((Boolean) -> Unit)? = null
+
+        /** The swipe's progress: the small windows go part of their way with it. */
+        @JvmStatic
+        var swipeProgress: ((Float) -> Unit)? = null
+
+        /** Where the small windows wait in the Running layer: the small windows follow it. */
+        @JvmStatic
+        var smallWindowSlots: ((Array<String>, Array<Rect>) -> Unit)? = null
+
+        /** Opens a small window by its bubble key. */
+        @JvmStatic
+        var openSmallWindow: ((String) -> Unit)? = null
+
+        /** Opens a card's task in a small window, growing out of the card. */
+        @JvmStatic
+        var openTaskInSmallWindow: ((TaskView, Int) -> Unit)? = null
+
+        /** Whether a card dropped on the Running layer opens in a small window now (WIN-11). */
+        @JvmStatic
+        var canOpenInSmallWindow: (() -> Boolean)? = null
+    }
+}
