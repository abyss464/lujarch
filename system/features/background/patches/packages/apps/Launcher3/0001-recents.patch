+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.quickstep.lujarch
+
+import android.content.Context
+import android.graphics.Rect
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.LayerDrawable
+import android.os.UserHandle
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.view.ViewTreeObserver
+import android.widget.FrameLayout
+import android.widget.HorizontalScrollView
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.PopupMenu
+import android.widget.TextView
+import com.android.internal.app.LujarchBackground
+import com.android.internal.app.LujarchBackgroundApp
+import com.android.internal.app.LujarchSmallWindow
+import com.android.launcher3.Insettable
+import com.android.launcher3.R
+
+/**
+ * The Running layer above the cards in Recents (BG-11): every app running off screen, with its
+ * depth's color and one word, in one row that fits between the status bar and the cards. A tap
+ * opens the app; touching and holding shows End for what the app started itself, and Background.
+ * The small windows come first, in the order of the screen, each a place that its shape flies
+ * into: a window with its live screen, a conversation as the person's picture (WIN-11); the layer
+ * tells where the places are on each frame it draws, so the shapes follow it as Recents moves it.
+ */
+class RunningLayerView(context: Context, private val recents: LujarchRecents) :
+    LinearLayout(context), Insettable {
+    private val title = TextView(context)
+    private val scroller = HorizontalScrollView(context)
+    private val row = LinearLayout(context)
+    private val smallWindows = LinearLayout(context)
+    private val apps = LinearLayout(context)
+    private val dropSlot = FrameLayout(context)
+    private val slotRect = Rect()
+    private var slotsPublished = false
+    private val publish = ViewTreeObserver.OnPreDrawListener {
+        publishSlots()
+        true
+    }
+    var hasEntries = false
+        private set
+
+    init {
+        orientation = HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        val side = dp(16)
+        setPadding(side, 0, side, 0)
+        clipToPadding = false
+        title.setText(R.string.lujarch_background_running)
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+        title.setTextColor(context.getColor(android.R.color.system_accent1_200))
+        title.paint.isFakeBoldText = true
+        addView(title, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT).apply {
+            marginEnd = dp(12)
+        })
+        scroller.isHorizontalScrollBarEnabled = false
+        scroller.clipToPadding = false
+        row.orientation = HORIZONTAL
+        row.gravity = Gravity.CENTER_VERTICAL
+        smallWindows.orientation = HORIZONTAL
+        apps.orientation = HORIZONTAL
+        row.addView(smallWindows)
+        row.addView(apps)
+        dropSlot.background = GradientDrawable().apply {
+            cornerRadius = dp(TILE_RADIUS).toFloat()
+            setStroke(dp(2), context.getColor(android.R.color.system_accent1_200), dp(6).toFloat(), dp(4).toFloat())
+        }
+        dropSlot.addView(TextView(context).apply {
+            setText(R.string.lujarch_background_drop)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 10f)
+            setTextColor(context.getColor(android.R.color.system_accent1_100))
+            gravity = Gravity.CENTER
+            val p = dp(4)
+            setPadding(p, p, p, p)
+        }, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))
+        dropSlot.visibility = GONE
+        row.addView(dropSlot, LayoutParams(dp(TILE_W), dp(ROW_H)))
+        scroller.addView(row)
+        addView(scroller, LayoutParams(0, dp(ROW_H), 1f))
+    }
+
+    override fun setInsets(insets: Rect) {
+        (layoutParams as? ViewGroup.MarginLayoutParams)?.let {
+            it.topMargin = insets.top + dp(8)
+            layoutParams = it
+        }
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        viewTreeObserver.addOnPreDrawListener(publish)
+    }
+
+    override fun onDetachedFromWindow() {
+        viewTreeObserver.removeOnPreDrawListener(publish)
+        super.onDetachedFromWindow()
+    }
+
+    fun bind(list: List<LujarchBackgroundApp>, windows: List<LujarchSmallWindow>) {
+        smallWindows.removeAllViews()
+        apps.removeAllViews()
+        for (window in windows) {
+            smallWindows.addView(slot(window), LayoutParams(dp(SLOT_W), dp(ROW_H)).apply {
+                marginEnd = dp(GAP)
+            })
+        }
+        for (app in list) {
+            apps.addView(tile(app), LayoutParams(dp(TILE_W), dp(ROW_H)).apply {
+                marginEnd = dp(GAP)
+            })
+        }
+        hasEntries = windows.isNotEmpty() || list.isNotEmpty()
+    }
+
+    /** Where each small window waits on the screen, by its bubble key (WIN-11). */
+    private fun publishSlots() {
+        if (smallWindows.childCount == 0 && !slotsPublished) return
+        slotsPublished = smallWindows.childCount > 0
+        val keys = ArrayList<String>()
+        val rects = ArrayList<Rect>()
+        for (i in 0 until smallWindows.childCount) {
+            val v = smallWindows.getChildAt(i)
+            val key = v.tag as? String ?: continue
+            if (!v.getGlobalVisibleRect(slotRect)) continue
+            keys.add(key)
+            rects.add(Rect(slotRect))
+        }
+        recents.onSmallWindowSlots(keys.toTypedArray(), rects.toTypedArray())
+    }
+
+    /** While a card is held: the layer offers its place for it, last in the row. */
+    fun showDropSlot(show: Boolean) {
+        dropSlot.visibility = if (show) VISIBLE else GONE
+        if (show) {
+            visibility = VISIBLE
+            alpha = 1f
+            post { scroller.fullScroll(FOCUS_RIGHT) }
+        } else if (!hasEntries) {
+            visibility = INVISIBLE
+        }
+    }
+
+    fun setDropTarget(over: Boolean) {
+        dropSlot.alpha = if (over) 1f else 0.6f
+        dropSlot.scaleX = if (over) 1.06f else 1f
+        dropSlot.scaleY = dropSlot.scaleX
+    }
+
+    /** A small window's place: its shape is the window itself, flown in by the Shell. */
+    private fun slot(window: LujarchSmallWindow): View = View(context).apply {
+        tag = window.key
+        contentDescription = window.label
+        setOnClickListener { recents.open(window) }
+        setOnLongClickListener { v ->
+            recents.appOf(window)?.let { menu(v, it) }
+            true
+        }
+    }
+
+    private fun tile(app: LujarchBackgroundApp): View {
+        val color = LujarchBackground.depthColor(context, app.depth, app.smallWindow)
+        return LinearLayout(context).apply {
+            orientation = VERTICAL
+            gravity = Gravity.CENTER
+            background = LayerDrawable(arrayOf(
+                GradientDrawable().apply {
+                    cornerRadius = dp(TILE_RADIUS).toFloat()
+                    setColor(context.getColor(android.R.color.system_neutral1_800))
+                },
+                GradientDrawable().apply {
+                    setColor(color)
+                    val r = dp(TILE_RADIUS).toFloat()
+                    cornerRadii = floatArrayOf(r, r, r, r, 0f, 0f, 0f, 0f)
+                },
+            )).apply {
+                setLayerHeight(1, dp(3))
+                setLayerGravity(1, Gravity.TOP)
+            }
+            clipToOutline = true
+            addView(ImageView(context).apply {
+                setImageDrawable(icon(app))
+                importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+            }, LayoutParams(dp(24), dp(24)).apply { topMargin = dp(3) })
+            addView(TextView(context).apply {
+                text = app.word
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 10f)
+                setTextColor(context.getColor(android.R.color.system_neutral1_100))
+                isSingleLine = true
+                ellipsize = android.text.TextUtils.TruncateAt.END
+                setPadding(dp(4), dp(3), dp(4), 0)
+            })
+            contentDescription = context.getString(R.string.lujarch_background_tile, app.label, app.word)
+            setOnClickListener { recents.open(app) }
+            setOnLongClickListener { v ->
+                menu(v, app)
+                true
+            }
+        }
+    }
+
+    private fun menu(anchor: View, app: LujarchBackgroundApp) {
+        val popup = PopupMenu(context, anchor)
+        if (app.ownService) popup.menu.add(0, END, 0, R.string.lujarch_background_end)
+        popup.menu.add(0, BACKGROUND, 1, R.string.lujarch_background_title)
+        popup.setOnMenuItemClickListener {
+            when (it.itemId) {
+                END -> recents.end(app)
+                else -> recents.openBackground(app.packageName, app.uid)
+            }
+            true
+        }
+        popup.show()
+    }
+
+    private fun icon(app: LujarchBackgroundApp) = try {
+        val pm = context.packageManager
+        val info = pm.getApplicationInfoAsUser(app.packageName, 0, UserHandle.getUserId(app.uid))
+        pm.getUserBadgedIcon(info.loadIcon(pm), UserHandle.getUserHandleForUid(app.uid))
+    } catch (e: Exception) {
+        context.packageManager.defaultActivityIcon
+    }
+
+    private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()
+
+    private companion object {
+        const val END = 1
+        const val BACKGROUND = 2
+        /** The row fits the space between the status bar and the cards. */
+        const val ROW_H = 56
+        const val TILE_W = 64
+        /** A slot has the shape of a dock card (108 x 150 dp). */
+        const val SLOT_W = 40
+        const val GAP = 8
+        const val TILE_RADIUS = 14
+    }
+}
