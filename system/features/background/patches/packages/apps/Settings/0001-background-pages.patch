index 0000000000000000000000000000000000000000..e01a6b16a2f5db83f31bdf1d0a88b60c0b06d2cc
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/LujarchBackgroundUsageController.java
@@ -0,0 +1,326 @@
+/*
