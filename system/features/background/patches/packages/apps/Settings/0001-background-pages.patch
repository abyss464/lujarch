+
+package com.android.settings.fuelgauge;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.text.format.DateFormat;
+import android.util.TypedValue;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.internal.app.LujarchBackground;
+import com.android.internal.app.LujarchBackgroundEvent;
+import com.android.internal.app.LujarchBackgroundRun;
+import com.android.settings.R;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+
+/**
+ * Lujarch's Background (BG-1): the app's run state as one line per process through the chosen
+ * day or hour, each minute in its state's color, with a mark at each reclaim; touching a line
+ * opens what happened there, who did it and why.
+ */
+public class LujarchRunStatePreference extends Preference {
+    private static final long MINUTE_MS = 60_000;
+
+    private LujarchBackgroundRun[] mRuns = new LujarchBackgroundRun[0];
+    private LujarchBackgroundEvent[] mEvents = new LujarchBackgroundEvent[0];
+    private long mDayStart;
+    private int mFrom;
+    private int mTo = LujarchBackground.RUN_MINUTES;
+    private String mPackageName = "";
+
+    public LujarchRunStatePreference(Context context) {
+        super(context);
+        setLayoutResource(R.layout.lujarch_run_state);
+        setSelectable(false);
+        setPersistent(false);
+    }
+
+    /** The lines of the minutes from..to of the day that starts at dayStart. */
+    public void setLines(String packageName, LujarchBackgroundRun[] runs,
+            LujarchBackgroundEvent[] events, long dayStart, int from, int to) {
+        mPackageName = packageName;
+        mRuns = runs;
+        mEvents = events;
+        mDayStart = dayStart;
+        mFrom = from;
+        mTo = Math.max(from + 1, to);
+        notifyChanged();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        final FrameLayout frame = (FrameLayout) holder.findViewById(R.id.lujarch_run_state);
+        frame.removeAllViews();
+        frame.addView(new Lines(getContext()), new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+
+    private float dp(float v) {
+        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                getContext().getResources().getDisplayMetrics());
+    }
+
+    private String name(LujarchBackgroundRun run) {
+        return run.name.equals(mPackageName)
+                ? getContext().getString(R.string.lujarch_background_main_process) : run.name;
+    }
+
+    private String time(int minute) {
+        return DateFormat.getTimeFormat(getContext()).format(
+                new Date(mDayStart + minute * MINUTE_MS));
+    }
+
+    /** What happened on a line near a minute, newest first. */
+    private void showAt(LujarchBackgroundRun run, int minute) {
+        final int near = Math.max(5, (mTo - mFrom) / 48);
+        final List<String> lines = new ArrayList<>();
+        final String state = run.minutes.length > minute && run.minutes[minute] != 0
+                ? LujarchBackground.stateName(getContext(), run.minutes[minute]) : null;
+        if (state != null) {
+            lines.add(time(minute) + "  " + state);
+        }
+        for (LujarchBackgroundEvent e : mEvents) {
+            final int m = (int) ((e.timeMillis - mDayStart) / MINUTE_MS);
+            if (Math.abs(m - minute) > near) {
+                continue;
+            }
+            if (e.process != null && !e.process.equals(run.name)
+                    && !(run.name.equals(mPackageName) && e.process.equals(mPackageName))) {
+                continue;
+            }
+            lines.add(time(m) + "  " + (e.whoName != null ? e.whoName + " · " : "") + e.text);
+        }
+        new AlertDialog.Builder(getContext())
+                .setTitle(name(run))
+                .setMessage(String.join("\n", lines))
+                .setPositiveButton(android.R.string.ok, null)
+                .show();
+    }
+
+    /** The lines, each under its process's name, over the axis of the time. */
+    private final class Lines extends View {
+        private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint mText = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF mRect = new RectF();
+        private final float mLabel = dp(18);
+        private final float mBar = dp(10);
+        private final float mGap = dp(10);
+        private final float mAxis = dp(18);
+
+        Lines(Context context) {
+            super(context);
+            mText.setTextSize(dp(12));
+            final android.content.res.TypedArray a = context.obtainStyledAttributes(
+                    new int[] {android.R.attr.textColorSecondary});
+            mText.setColor(a.getColor(0, 0xFF888888));
+            a.recycle();
+        }
+
+        @Override
+        protected void onMeasure(int widthSpec, int heightSpec) {
+            final int h = (int) (mRuns.length * (mLabel + mBar + mGap) + mAxis);
+            setMeasuredDimension(MeasureSpec.getSize(widthSpec), h);
+        }
+
+        private float x(int minute) {
+            return (minute - mFrom) * (float) getWidth() / (mTo - mFrom);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            float y = 0;
+            final float r = mBar / 2;
+            for (LujarchBackgroundRun run : mRuns) {
+                canvas.drawText(name(run), 0, y + mLabel - dp(5), mText);
+                final float top = y + mLabel;
+                int i = mFrom;
+                while (i < mTo) {
+                    final byte state = i < run.minutes.length ? run.minutes[i] : 0;
+                    int j = i;
+                    while (j < mTo && (j < run.minutes.length ? run.minutes[j] : 0) == state) {
+                        j++;
+                    }
+                    if (state != 0) {
+                        mFill.setColor(LujarchBackground.stateColor(getContext(), state));
+                        mRect.set(x(i), top, Math.max(x(i) + 1, x(j)), top + mBar);
+                        canvas.drawRoundRect(mRect, r, r, mFill);
+                    }
+                    i = j;
+                }
+                // A mark at each reclaim of this process.
+                mFill.setColor(0xFFFFFFFF);
+                for (LujarchBackgroundEvent e : mEvents) {
+                    if (e.kind != LujarchBackground.EVENT_ENDED) {
+                        continue;
+                    }
+                    final boolean mine = e.process == null ? run.name.equals(mPackageName)
+                            : e.process.equals(run.name);
+                    final int m = (int) ((e.timeMillis - mDayStart) / MINUTE_MS);
+                    if (mine && m >= mFrom && m < mTo) {
+                        canvas.drawRect(x(m) - dp(1), top - dp(2), x(m) + dp(1),
+                                top + mBar + dp(2), mFill);
+                    }
+                }
+                y += mLabel + mBar + mGap;
+            }
+            // The axis: the start, the quarters and the end of the span.
+            final int span = mTo - mFrom;
+            for (int q = 0; q <= 4; q++) {
+                final int minute = mFrom + span * q / 4;
+                final String label = span >= 23 * 60
+                        ? String.format(java.util.Locale.ROOT, "%02d", minute / 60)
+                        : time(minute);
+                final float w = mText.measureText(label);
+                final float lx = Math.max(0, Math.min(getWidth() - w, x(minute) - w / 2));
+                canvas.drawText(label, lx, y + mAxis - dp(4), mText);
+            }
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent event) {
+            if (event.getAction() == MotionEvent.ACTION_DOWN) {
+                return true;
+            }
+            if (event.getAction() != MotionEvent.ACTION_UP || mRuns.length == 0) {
+                return super.onTouchEvent(event);
+            }
+            final int line = (int) (event.getY() / (mLabel + mBar + mGap));
+            if (line < 0 || line >= mRuns.length) {
+                return true;
+            }
+            final int minute = mFrom + (int) (event.getX() / getWidth() * (mTo - mFrom));
+            showAt(mRuns[line], Math.max(mFrom, Math.min(mTo - 1, minute)));
+            return true;
+        }
+    }
+}
