+
+package com.android.settings.fuelgauge;
+
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.os.UserHandle;
+import android.text.TextUtils;
+import android.util.Log;
+
+import androidx.preference.Preference;
+
+import com.android.internal.app.LujarchBackground;
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * App battery usage > Background: the app's battery figures stay here, its choices of how it runs
+ * off screen are on its Background page, which this row opens (BG-3).
+ */
+public class LujarchBackgroundLinkController extends BasePreferenceController {
+    private static final String TAG = "lujarch_background";
+    static final String KEY = "lujarch_background";
+
+    private final String mPackageName;
+
+    public LujarchBackgroundLinkController(Context context, String packageName) {
+        super(context, KEY);
+        mPackageName = packageName;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mPackageName != null ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!TextUtils.equals(preference.getKey(), KEY)) {
+            return false;
+        }
+        final Intent intent = new Intent(LujarchBackground.ACTION_APP)
+                .setPackage(LujarchBackground.SETTINGS_PACKAGE)
+                .putExtra(Intent.EXTRA_PACKAGE_NAME, mPackageName)
+                .putExtra(Intent.EXTRA_USER, UserHandle.of(UserHandle.myUserId()));
+        try {
+            mContext.startActivity(intent);
+        } catch (ActivityNotFoundException e) {
+            Log.e(TAG, "no Background page for " + mPackageName, e);
+        }
+        return true;
+    }
+}
