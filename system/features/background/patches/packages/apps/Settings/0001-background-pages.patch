+
+package com.android.settings.fuelgauge;
+
+import android.app.AppOpsManager;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.net.NetworkPolicyManager;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.format.Formatter;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+import androidx.preference.CheckBoxPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceScreen;
+
+import com.android.internal.app.ILujarchBackground;
+import com.android.internal.app.LujarchBackground;
+import com.android.internal.app.LujarchBackgroundApp;
+import com.android.internal.app.LujarchBackgroundProcess;
+import com.android.internal.app.LujarchBackgroundSuggestion;
+import com.android.settings.R;
+import com.android.settings.applications.AppInfoBase;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.datausage.AppDataUsage;
+import com.android.settingslib.widget.BannerMessagePreference;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Lujarch's Background (BG-2, BG-3) on Allow background usage: with Chosen processes, the app's
+ * processes to tick, each with its memory and whether it holds a network connection, the ones
+ * holding one suggested, and a broken choice's suggestion; below, After it leaves the screen: the
+ * app's Autostart, Alarms & reminders, Long background tasks, Background data and Keep, each
+ * leading to its own home.
+ */
+public class LujarchBackgroundUsageController extends BasePreferenceController {
+    private static final String TAG = "lujarch_background";
+    static final String KEY = "lujarch_chosen_processes";
+    private static final String KEY_AFTER = "lujarch_after_leaving";
+    private static final String AUTOSTART_GROUP = "lujarch:autostart";
+
+    private final String mPackageName;
+    private final int mUid;
+    private final Fragment mFragment;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+    @Nullable private PreferenceCategory mProcesses;
+    @Nullable private PreferenceCategory mAfter;
+    private int mMode = BatteryOptimizeUtils.MODE_UNKNOWN;
+
+    /** What the page shows, read off the main thread. */
+    private static final class Model {
+        @Nullable LujarchBackgroundApp app;
+        @Nullable LujarchBackgroundSuggestion suggestion;
+        int autostart;
+        int alarms;
+        int longJobs;
+        boolean backgroundData;
+        boolean kept;
+    }
+
+    public LujarchBackgroundUsageController(Context context, Fragment fragment, String packageName,
+            int uid) {
+        super(context, KEY);
+        mFragment = fragment;
+        mPackageName = packageName;
+        mUid = uid;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mPackageName != null ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(@NonNull PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mProcesses = screen.findPreference(KEY);
+        mAfter = screen.findPreference(KEY_AFTER);
+    }
+
+    @Override
+    public void updateState(@NonNull Preference preference) {
+        refresh(new BatteryOptimizeUtils(mContext, mUid, mPackageName).getAppOptimizationMode());
+    }
+
+    /** The level changed on the page: the processes show only for Chosen processes. */
+    void refresh(int mode) {
+        mMode = mode;
+        try {
+            mExecutor.execute(() -> {
+                final Model m = load();
+                mHandler.post(() -> bind(m));
+            });
+        } catch (RuntimeException e) {
+            Log.e(TAG, "the page is gone", e);
+        }
+    }
+
+    private Model load() {
+        final Model m = new Model();
+        final int userId = UserHandle.getUserId(mUid);
+        final ILujarchBackground service = LujarchBackground.get();
+        if (service == null) {
+            Log.e(TAG, "the Background service is not running");
+        } else {
+            try {
+                m.app = service.getApp(mPackageName, userId);
+                m.suggestion = service.getSuggestion(mPackageName, userId);
+            } catch (RemoteException | RuntimeException e) {
+                Log.e(TAG, "cannot read " + mPackageName, e);
+            }
+        }
+        final AppOpsManager ops = mContext.getSystemService(AppOpsManager.class);
+        m.autostart = ops.unsafeCheckOpRawNoThrow(AppOpsManager.OP_LUJARCH_AUTOSTART, mUid,
+                mPackageName);
+        m.alarms = ops.unsafeCheckOpRawNoThrow(AppOpsManager.OP_SCHEDULE_EXACT_ALARM, mUid,
+                mPackageName);
+        m.longJobs = ops.unsafeCheckOpRawNoThrow(AppOpsManager.OP_RUN_USER_INITIATED_JOBS, mUid,
+                mPackageName);
+        m.kept = ops.unsafeCheckOpRawNoThrow(AppOpsManager.OP_LUJARCH_KEEP, mUid, mPackageName)
+                == AppOpsManager.MODE_ALLOWED;
+        m.backgroundData = (NetworkPolicyManager.from(mContext).getUidPolicy(mUid)
+                & NetworkPolicyManager.POLICY_REJECT_METERED_BACKGROUND) == 0;
+        return m;
+    }
+
+    private void bind(Model m) {
+        if (mProcesses == null || mAfter == null) {
+            return;
+        }
+        bindProcesses(m);
+        bindAfter(m);
+    }
+
+    private void bindProcesses(Model m) {
+        mProcesses.removeAll();
+        final boolean chosen = mMode == BatteryOptimizeUtils.MODE_CHOSEN;
+        mProcesses.setVisible(chosen || m.suggestion != null);
+        if (m.suggestion != null) {
+            final BannerMessagePreference banner = new BannerMessagePreference(mContext);
+            banner.setKey("lujarch_suggestion");
+            banner.setTitle(m.suggestion.title);
+            banner.setSummary(m.suggestion.text);
+            banner.setPositiveButtonText(R.string.lujarch_background_add_main);
+            banner.setPositiveButtonOnClickListener(v -> answer(true));
+            banner.setNegativeButtonText(R.string.lujarch_background_not_now);
+            banner.setNegativeButtonOnClickListener(v -> answer(false));
+            banner.setOrder(0);
+            mProcesses.addPreference(banner);
+        }
+        if (!chosen || m.app == null || m.app.processNames == null) {
+            return;
+        }
+        final List<String> ticked = m.app.chosen != null
+                ? new ArrayList<>(Arrays.asList(m.app.chosen)) : new ArrayList<>();
+        final List<String> connected = m.app.connected != null
+                ? Arrays.asList(m.app.connected) : List.of();
+        int order = 1;
+        for (String name : m.app.processNames) {
+            final CheckBoxPreference row = new CheckBoxPreference(mContext);
+            row.setKey("lujarch_process_" + name);
+            row.setOrder(order++);
+            row.setPersistent(false);
+            row.setTitle(name.equals(mPackageName)
+                    ? mContext.getString(R.string.lujarch_background_main_process) : name);
+            final List<String> parts = new ArrayList<>();
+            final long bytes = memoryOf(m.app, name);
+            parts.add(bytes > 0 ? Formatter.formatShortFileSize(mContext, bytes)
+                    : mContext.getString(R.string.lujarch_background_not_running));
+            if (connected.contains(name)) {
+                parts.add(mContext.getString(R.string.lujarch_background_connected));
+                if (!ticked.contains(name)) {
+                    parts.add(mContext.getString(R.string.lujarch_background_suggested));
+                }
+            }
+            row.setSummary(String.join(" · ", parts));
+            row.setChecked(ticked.contains(name));
+            row.setOnPreferenceChangeListener((p, value) -> {
+                if ((Boolean) value) {
+                    ticked.add(name);
+                } else {
+                    ticked.remove(name);
+                }
+                choose(ticked.toArray(new String[0]));
+                return true;
+            });
+            mProcesses.addPreference(row);
+        }
+    }
+
+    /** A process's memory by its short name: the package for the main process. */
+    private long memoryOf(LujarchBackgroundApp app, String name) {
+        long bytes = 0;
+        if (app.processes != null) {
+            for (LujarchBackgroundProcess p : app.processes) {
+                final String shortName = p.name == null || p.name.equals(mPackageName)
+                        ? mPackageName
+                        : p.name.startsWith(mPackageName + ":")
+                                ? p.name.substring(mPackageName.length()) : p.name;
+                if (shortName.equals(name)) {
+                    bytes += p.memoryBytes;
+                }
+            }
+        }
+        return bytes;
+    }
+
+    private void bindAfter(Model m) {
+        mAfter.removeAll();
+        final int userId = UserHandle.getUserId(mUid);
+        add(R.string.lujarch_background_autostart,
+                mContext.getString(m.autostart == AppOpsManager.MODE_ALLOWED
+                        ? R.string.lujarch_background_allow
+                        : m.autostart == AppOpsManager.MODE_DEFAULT
+                                ? R.string.lujarch_background_ask
+                                : R.string.lujarch_background_dont_allow),
+                () -> start(new Intent(Intent.ACTION_MANAGE_APP_PERMISSION)
+                        .putExtra(Intent.EXTRA_PACKAGE_NAME, mPackageName)
+                        .putExtra(Intent.EXTRA_PERMISSION_GROUP_NAME, AUTOSTART_GROUP)
+                        .putExtra(Intent.EXTRA_USER, UserHandle.of(userId))));
+        add(com.android.settingslib.R.string.alarms_and_reminders_title, allowed(m.alarms == AppOpsManager.MODE_ALLOWED),
+                () -> start(new Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM,
+                        Uri.fromParts("package", mPackageName, null))));
+        add(R.string.long_background_tasks_label,
+                allowed(m.longJobs == AppOpsManager.MODE_ALLOWED),
+                () -> start(new Intent(Settings.ACTION_MANAGE_APP_LONG_RUNNING_JOBS,
+                        Uri.fromParts("package", mPackageName, null))));
+        add(R.string.data_usage_app_restrict_background, allowed(m.backgroundData),
+                () -> AppInfoBase.startAppInfoFragment(AppDataUsage.class,
+                        mContext.getString(R.string.data_usage_app_restrict_background), mPackageName,
+                        mUid, mFragment, /* request= */ 0, getMetricsCategory()));
+        final Preference keep = add(R.string.lujarch_background_keep,
+                mContext.getString(m.kept ? R.string.lujarch_background_kept_on
+                        : R.string.lujarch_background_kept_off), null);
+        keep.setSelectable(false);
+    }
+
+    private String allowed(boolean allowed) {
+        return mContext.getString(allowed ? R.string.app_permission_summary_allowed
+                : R.string.app_permission_summary_not_allowed);
+    }
+
+    private Preference add(int title, String summary, @Nullable Runnable open) {
+        final Preference row = new Preference(mContext);
+        row.setKey("lujarch_after_" + title);
+        row.setTitle(title);
+        row.setSummary(summary);
+        row.setOrder(mAfter.getPreferenceCount());
+        if (open != null) {
+            row.setOnPreferenceClickListener(p -> {
+                open.run();
+                return true;
+            });
+        }
+        mAfter.addPreference(row);
+        return row;
+    }
+
+    private void start(Intent intent) {
+        try {
+            mContext.startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+        } catch (ActivityNotFoundException e) {
+            Log.e(TAG, "cannot open " + intent.getAction(), e);
+        }
+    }
+
+    private void choose(String[] names) {
+        mExecutor.execute(() -> {
+            final ILujarchBackground service = LujarchBackground.get();
+            try {
+                if (service == null) {
+                    throw new IllegalStateException("the Background service is not running");
+                }
+                service.setChosenProcesses(mPackageName, UserHandle.getUserId(mUid), names);
+            } catch (RemoteException | RuntimeException e) {
+                Log.e(TAG, "cannot choose the processes of " + mPackageName, e);
+            }
+        });
+    }
+
+    private void answer(boolean accept) {
+        mExecutor.execute(() -> {
+            final ILujarchBackground service = LujarchBackground.get();
+            try {
+                if (service == null) {
+                    throw new IllegalStateException("the Background service is not running");
+                }
+                service.answerSuggestion(mPackageName, UserHandle.getUserId(mUid), accept);
+            } catch (RemoteException | RuntimeException e) {
