index 0000000000000000000000000000000000000000..5a98f8c42d83d236a260b4ebf4f14011e0d8276f
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/LujarchRunStatePreference.java
@@ -0,0 +1,224 @@
