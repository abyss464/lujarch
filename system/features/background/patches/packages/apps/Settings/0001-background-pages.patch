+
+    /**
+     * Lujarch's Background (BG-1): the run state of the app's processes in the selection, from
+     * the system's lines: the time in each state with the processes that were in it, the
+     * reclaims by reason, and the times it was woken, which lead to its Autostart.
+     */
+    private void runStateRows(Model m, long[] range) {
+        final ILujarchBackground service = LujarchBackground.get();
+        if (service == null || mPackage == null) {
+            Log.e(TAG, "the Background service is not running");
+            return;
+        }
+        final int userId = UserHandle.getUserId(mUid);
+        final long dayStart = java.time.Instant.ofEpochMilli(range[0])
+                .atZone(java.time.ZoneId.systemDefault()).toLocalDate()
+                .atStartOfDay(java.time.ZoneId.systemDefault()).toInstant().toEpochMilli();
+        final LujarchBackgroundRun[] runs;
+        final LujarchBackgroundEvent[] events;
+        try {
+            runs = service.getRunState(mPackage, userId, dayStart);
+            events = service.getEvents(mPackage, userId, range[0], MAX_EVENTS);
+        } catch (RemoteException | RuntimeException e) {
+            Log.e(TAG, "cannot read the run state of " + mPackage, e);
+            return;
+        }
+        final int from = (int) Math.max(0, (range[0] - dayStart) / 60_000);
+        final int to = (int) Math.min(LujarchBackground.RUN_MINUTES, (range[1] - dayStart) / 60_000);
+        m.runs = runs;
+        m.runEvents = events;
+        m.runDay = dayStart;
+        m.runFrom = from;
+        m.runTo = to;
+        final String separator = mContext.getString(R.string.lujarch_battery_list_separator);
+        for (int state = LujarchBackground.RUN_FOREGROUND; state <= LujarchBackground.RUN_STOPPED;
+                state++) {
+            final int[] minutes = new int[1];
+            final List<String> who = new ArrayList<>();
+            for (LujarchBackgroundRun run : runs) {
+                int n = 0;
+                for (int i = from; i < to && i < run.minutes.length; i++) {
+                    if (run.minutes[i] == state) {
+                        n++;
+                    }
+                }
+                if (n > 0) {
+                    who.add(run.name.equals(mPackage)
+                            ? mContext.getString(R.string.lujarch_background_main_process)
+                            : run.name);
+                }
+                minutes[0] = Math.max(minutes[0], n);
+            }
+            if (minutes[0] == 0 || state == LujarchBackground.RUN_RECLAIMED
+                    || state == LujarchBackground.RUN_STOPPED) {
+                continue;
+            }
+            final Row r = new Row();
+            r.title = LujarchBackground.stateName(mContext, state);
+            r.color = LujarchBackground.stateColor(mContext, state);
+            r.summary = runs.length > 1
+                    ? RecordPageController.join(String.join(separator, who),
+                            RecordFormat.duration(mContext, minutes[0] * 60_000L))
+                    : RecordFormat.duration(mContext, minutes[0] * 60_000L);
+            m.states.add(r);
+        }
+        final Map<String, Integer> ended = new LinkedHashMap<>();
+        final Map<String, Integer> woken = new LinkedHashMap<>();
+        int endedCount = 0;
+        int wokenCount = 0;
+        for (LujarchBackgroundEvent e : events) {
+            if (e.timeMillis >= range[1]) {
+                continue;
+            }
+            final int count = Math.max(1, e.count);
+            final String reason = e.reason != null ? e.reason : "";
+            if (e.kind == LujarchBackground.EVENT_ENDED) {
+                ended.merge(reason, count, Integer::sum);
+                endedCount += count;
+            } else if (e.kind == LujarchBackground.EVENT_WOKEN
+                    || e.kind == LujarchBackground.EVENT_STARTED) {
+                woken.merge(reason, count, Integer::sum);
+                wokenCount += count;
+            }
+        }
+        if (endedCount > 0) {
+            final Row r = new Row();
+            r.title = mContext.getResources().getQuantityString(
+                    R.plurals.lujarch_background_reclaimed, endedCount, endedCount);
+            r.summary = counts(ended, separator);
+            m.states.add(r);
+        }
+        if (wokenCount > 0) {
+            final Row r = new Row();
+            r.title = mContext.getResources().getQuantityString(
+                    R.plurals.lujarch_background_woken, wokenCount, wokenCount);
+            r.summary = counts(woken, separator);
+            r.intent = new Intent(Intent.ACTION_MANAGE_APP_PERMISSION)
+                    .putExtra(Intent.EXTRA_PACKAGE_NAME, mPackage)
+                    .putExtra(Intent.EXTRA_PERMISSION_GROUP_NAME, "lujarch:autostart")
+                    .putExtra(Intent.EXTRA_USER, UserHandle.of(userId));
+            m.states.add(r);
