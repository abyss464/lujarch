<?xml version="1.0" encoding="utf-8"?>
<!--
    The privileged permissions Background adds to the apps that show it: Recents (BG-8, BG-10,
    BG-11), its pages in Settings and Lujarch Settings (BG-1 to BG-7) and the shade's footer in
    SystemUI (BG-9). A missing entry stops system_server at boot.
-->
<permissions>
    <privapp-permissions package="com.android.launcher3">
        <permission name="android.permission.LUJARCH_BACKGROUND" />
    </privapp-permissions>
    <privapp-permissions package="com.android.settings">
        <permission name="android.permission.LUJARCH_BACKGROUND" />
    </privapp-permissions>
    <privapp-permissions package="org.lujarch.settings">
        <permission name="android.permission.FORCE_STOP_PACKAGES" />
        <permission name="android.permission.LUJARCH_BACKGROUND" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
    </privapp-permissions>
    <privapp-permissions package="com.android.systemui">
        <permission name="android.permission.LUJARCH_BACKGROUND" />
    </privapp-permissions>
</permissions>
