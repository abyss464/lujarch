<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lujarch.background.settings">

    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.LUJARCH_BACKGROUND" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application>
        <meta-data
            android:name="org.lujarch.settings.contribution.background"
            android:value="org.lujarch.background.settings.MemoryContribution" />
        <!-- Settings > System > Memory, and an app's memory page. Opened from Recents it is a
             task of its own, never on top of another page of Lujarch Settings. -->
        <activity
            android:name="org.lujarch.background.settings.MemoryActivity"
            android:exported="true"
            android:taskAffinity="org.lujarch.settings.memory"
            android:label="@string/memory_title"
            android:theme="@style/Theme.LujarchSettings">
            <intent-filter>
                <action android:name="org.lujarch.background.action.MEMORY" />
                <action android:name="org.lujarch.background.action.APP_MEMORY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="lujarch_memory" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="system_management_category" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/memory_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/memory_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_memory" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="10" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>
    </application>
</manifest>
