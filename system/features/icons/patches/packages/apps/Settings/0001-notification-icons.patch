+package com.android.settings.notification;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Lujarch (ICON-2): Fit notification icons, monochrome icons of the Android Notification Icon
+ * Project for apps whose notification icons break the design; SystemUI's NotificationIconFix
+ * reads the setting for each notification it receives. On by default.
+ */
+public class LujarchNotificationIconFixController extends TogglePreferenceController {
+    static final String SETTING = "lujarch_icons_notifications";
+
+    public LujarchNotificationIconFixController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return new java.io.File("/system_ext/etc/lujarch/icons/anip-bundle.zip").exists()
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Global.getInt(mContext.getContentResolver(), SETTING, 1) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Global.putInt(mContext.getContentResolver(), SETTING, isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_notifications;
+    }
+}
