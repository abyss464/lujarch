+    private val isFitIconsEnabled: SharedFlow<Boolean> =
+        callbackFlow {
+                val resolver = applicationContext.contentResolver
+                fun read() = Settings.Global.getInt(resolver, LujarchIcons.SETTING_FIT, 1) != 0
+                val observer =
+                    object : ContentObserver(null) {
+                        override fun onChange(selfChange: Boolean) {
+                            trySend(read())
+                        }
+                    }
+                resolver.registerContentObserver(
+                    Settings.Global.getUriFor(LujarchIcons.SETTING_FIT),
+                    false,
+                    observer,
+                )
+                trySend(read())
+                awaitClose { resolver.unregisterContentObserver(observer) }
+            }
+            .flowOn(Dispatchers.IO)
+            .shareIn(scope = viewModelScope, started = SharingStarted.Lazily, replay = 1)
+    private val overridingIsFitIconsEnabled = MutableStateFlow<Boolean?>(null)
+    val previewingIsFitIconsEnabled: Flow<Boolean> =
+        combine(overridingIsFitIconsEnabled, isFitIconsEnabled) { overriding, current ->
+            overriding ?: current
+        }
+    val toggleFitIcons: Flow<() -> Unit> =
+        previewingIsFitIconsEnabled.map { { overridingIsFitIconsEnabled.value = !it } }
+
+    private suspend fun applyFitIcons(enabled: Boolean) {
+        val written =
+            withContext(Dispatchers.IO) {
+                try {
+                    Settings.Global.putInt(
+                        applicationContext.contentResolver,
+                        LujarchIcons.SETTING_FIT,
+                        if (enabled) 1 else 0,
+                    )
+                } catch (e: RuntimeException) {
+                    Log.e(TAG, "Fit app icons not written", e)
+                    false
+                }
+            }
+        Log.i(TAG, "Fit app icons ${if (enabled) "on" else "off"}: written $written")
+    }
