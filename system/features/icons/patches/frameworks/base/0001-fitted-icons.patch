+/**
+ * Lujarch fitted icons (ICON-1): an app whose icon is a legacy single layer gets an adaptive icon
+ * drawn by IconFitter, redrawn (a logo) or fitted (an illustration, or the owner's choice). The
+ * owner's choices: the switch Settings.Global lujarch_icons_fit (Wallpaper & style, next to
+ * themed icons) and a mode per app (original, fitted, redrawn), kept in state.xml.
+ *
+ * Results are cached by package version, icon resource, mode and algorithm version, in memory
+ * and as PNGs under /data/system/lujarch_icons/cache; a change of mode or switch drops the
+ * entries it touches and tells the launcher (ACTION_ICONS_CHANGED).
+ */
+public final class LujarchIconService extends SystemService {
+    private static final String TAG = "lujarch_icons";
+    /** Bumped with every change of IconFitter's output, so old cache entries are not used. */
+    private static final int ALGO_VERSION = 2;
+    /** The analysis density: icons are rendered at 4x (xxxhdpi) before they are fitted. */
+    private static final int RENDER_DENSITY = DisplayMetrics.DENSITY_XXXHIGH;
+    /** The canvas of the layers: 108 dp at about the phone's 2.625x. */
+    private static final int CANVAS = 288;
