+    private final LruCache<String, Object> mResults = new LruCache<>(64);
+    private static final Object NONE = new Object();
+    private Handler mHandler;
+
+    public LujarchIconService(Context context) {
+        super(context);
+    }
+
+    @Override
+    public void onStart() {
+        mCacheDir.mkdirs();
+        readState();
