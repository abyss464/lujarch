+    // ---------------------------------------------------------------- composition
+
+    private static int[] extendedBackground(Analysis a, int size) {
+        int[] out = new int[size * size];
+        float[] c = new float[3];
+        for (int y = 0; y < size; y++) {
+            for (int x = 0; x < size; x++) {
+                // the visible circle maps onto the tile; the canvas around it continues it
+                float u = canvasToTile(x, size, a.x0, a.x1);
+                float v = canvasToTile(y, size, a.y0, a.y1);
+                model(a.coef, u / N, v / N, c);
+                out[y * size + x] = argb(255, c[0], c[1], c[2]);
+            }
+        }
+        return out;
+    }
+
+    private static float canvasToTile(int p, int size, int t0, int t1) {
+        float circle = CIRCLE_OF_CANVAS * size;
+        float off = (size - circle) / 2f;
+        return t0 + (p + 0.5f - off) / circle * (t1 - t0);
+    }
+
+    private static int[] fitForeground(int[] px, Analysis a, int size) {
+        int[] box = bbox(a.fitMask, N);
+        int[] out = new int[size * size];
+        float target = GLYPH_OF_CIRCLE * CIRCLE_OF_CANVAS * size;
+        float s = target / Math.max(box[2] - box[0] + 1, box[3] - box[1] + 1);
+        int w = Math.round((box[2] - box[0] + 1) * s), h = Math.round((box[3] - box[1] + 1) * s);
+        int ox = (size - w) / 2, oy = (size - h) / 2;
+        double[][] in = s < 1 ? integralPremultiplied(px, a.fitMask) : null;
+        for (int y = 0; y < h; y++) {
+            for (int x = 0; x < w; x++) {
+                float fx0 = box[0] + x / s, fy0 = box[1] + y / s;
+                out[(oy + y) * size + ox + x] = s < 1
+                        ? areaColor(in, fx0, fy0, fx0 + 1 / s, fy0 + 1 / s)
+                        : sampleMasked(px, a.fitMask, fx0 + 0.5f / s - 0.5f, fy0 + 0.5f / s - 0.5f);
+            }
+        }
+        return out;
+    }
+
+    private static int[] flatPlate(Analysis a, int size) {
+        float[] plate = plateColor(a);
+        int[] out = new int[size * size];
+        Arrays.fill(out, argb(255, plate[0], plate[1], plate[2]));
+        return out;
+    }
+
+    /**
+     * A white tile's plate is the logo's brand colour: of its main colours (a fifth of it or
+     * more), the most saturated; the largest share is no guide when two colours are close.
+     */
+    private static float[] plateColor(Analysis a) {
+        if (!a.whiteTile) return a.bgMean;
+        float[] best = a.centers[0];
+        for (int i = 1; i < a.centers.length; i++) {
+            if (a.share[i] >= 0.2f && sat(a.centers[i]) > sat(best) + 0.1f) best = a.centers[i];
+        }
+        return best;
+    }
+
+    /**
+     * How many colour families the elements use (a cluster of 6 % or more): the greys, black
+     * and white are one family (counted from 15 %), and chromatic colours less than 30 degrees
+     * of hue apart are one.
+     */
+    private static int hueFamilies(Kmeans k) {
+        boolean achromatic = false;
+        List<Float> hues = new ArrayList<>();
+        for (int i = 0; i < k.centers.length; i++) {
+            if (k.share[i] < 0.06f) continue;
+            float[] c = k.centers[i];
+            float mx = Math.max(c[0], Math.max(c[1], c[2])) / 255f;
+            if (sat(c) < 0.18f || mx < 0.2f) {
+                // black, white or grey as a colour of the logo, not the grey fringe of its
+                // anti-aliased edges
+                achromatic |= k.share[i] >= 0.15f;
+                continue;
+            }
+            hues.add(hue(c));
+        }
+        hues.sort(null);
+        int fam = 0;
+        for (int i = 0; i < hues.size(); i++) {
+            if (i == 0 || hues.get(i) - hues.get(i - 1) >= 30f) fam++;
+        }
+        // the hue circle closes: red near 0 and near 360 is one family
+        if (hues.size() > 1 && hues.get(0) + 360f - hues.get(hues.size() - 1) < 30f && fam > 1) {
+            fam--;
+        }
+        return fam + (achromatic ? 1 : 0);
+    }
+
+    private static float hue(float[] c) {
+        float r = c[0] / 255f, g = c[1] / 255f, b = c[2] / 255f;
+        float mx = Math.max(r, Math.max(g, b)), mn = Math.min(r, Math.min(g, b)), d = mx - mn;
+        if (d == 0) return 0;
+        float h;
+        if (mx == r) h = ((g - b) / d) % 6f;
+        else if (mx == g) h = (b - r) / d + 2f;
+        else h = (r - g) / d + 4f;
+        h *= 60f;
+        return h < 0 ? h + 360f : h;
+    }
+
+    private static int[] redrawForeground(Analysis a, int size) {
+        float[] plate = plateColor(a);
+        float[] glyph;
+        float[] accent = null;
+        if (a.whiteTile) {
+            glyph = new float[] {255, 255, 255};
+        } else {
+            glyph = (lum(plate) < 0.62f || sat(plate) > 0.45f)
+                    ? new float[] {255, 255, 255} : a.centers[0];
+            if (a.share.length > 1 && a.share[1] > 0.18f
+                    && Math.sqrt(sq(a.centers[1][0] - a.centers[0][0])
+                    + sq(a.centers[1][1] - a.centers[0][1])
+                    + sq(a.centers[1][2] - a.centers[0][2])) > 60) {
+                accent = a.centers[1];
+            }
+        }
+        int[] box = bbox(a.shape, N);
+        float[] alpha = smoothMask(a.shape, box, size);
+        int[] out = new int[size * size];
+        for (int i = 0; i < out.length; i++) {
+            out[i] = argb(Math.round(alpha[i] * 255), glyph[0], glyph[1], glyph[2]);
+        }
+        if (accent != null) {
+            boolean[] am = new boolean[N * N];
+            for (int i = 0; i < am.length; i++) am[i] = a.shape[i] && a.cls[i] == 1;
+            float[] aa = smoothMask(am, box, size);
+            for (int i = 0; i < out.length; i++) {
+                if (aa[i] > 0) out[i] = over(out[i], argb(Math.round(aa[i] * 255),
+                        accent[0], accent[1], accent[2]));
+            }
+        }
+        return out;
+    }
+
+    private static int[] monochrome(Analysis a, int size) {
+        int[] box = bbox(a.shape, N);
+        float[] alpha = smoothMask(a.shape, box, size);
+        int[] out = new int[size * size];
+        for (int i = 0; i < out.length; i++) out[i] = argb(Math.round(alpha[i] * 255), 255, 255, 255);
+        return out;
+    }
+
+    /**
+     * The shape in box, scaled into the safe zone with smooth anti-aliased edges: bilinear
+     * coverage, a small blur, then a soft threshold. This is what smooths the traced outline in
+     * the prototype (potrace there; potrace is GPL, so not here).
+     */
+    private static float[] smoothMask(boolean[] m, int[] box, int size) {
+        float target = GLYPH_OF_CIRCLE * CIRCLE_OF_CANVAS * size;
+        float s = target / Math.max(box[2] - box[0] + 1, box[3] - box[1] + 1);
+        int w = Math.round((box[2] - box[0] + 1) * s), h = Math.round((box[3] - box[1] + 1) * s);
+        int ox = (size - w) / 2, oy = (size - h) / 2;
+        float[] cov = new float[size * size];
+        double[] in = integral(m);
+        for (int y = 0; y < h; y++) {
+            for (int x = 0; x < w; x++) {
+                // the share of the source footprint the shape covers (downscaling without
+                // aliasing); bilinear where the footprint is under a pixel
+                float fx0 = box[0] + x / s, fy0 = box[1] + y / s;
+                cov[(oy + y) * size + ox + x] = s < 1
+                        ? area(in, fx0, fy0, fx0 + 1 / s, fy0 + 1 / s)
+                        : bilinear(m, fx0 + 0.5f / s - 0.5f, fy0 + 0.5f / s - 0.5f);
+            }
+        }
+        float sigma = Math.max(0.6f, 1.2f * s);
+        float[] blurred = blur(cov, size, sigma);
+        float[] out = new float[size * size];
+        for (int i = 0; i < out.length; i++) {
+            float t = (blurred[i] - 0.5f) / 0.12f + 0.5f; // a ~1.5 px soft edge
+            out[i] = t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t);
+        }
+        return out;
+    }
+
+    // ---------------------------------------------------------------- image helpers
+
+    private static float[][] rgbOf(int[] px, boolean[] m, int max) {
+        int c = count(m);
+        int step = Math.max(1, c / max);
+        List<float[]> l = new ArrayList<>();
+        int k = 0;
+        for (int i = 0; i < m.length; i++) {
+            if (m[i] && (k++ % step == 0)) {
+                l.add(new float[] {(px[i] >> 16) & 255, (px[i] >> 8) & 255, px[i] & 255});
+            }
+        }
+        return l.toArray(new float[0][]);
+    }
+
+    private static float edgeDensity(int[] px, boolean[] m, int n) {
+        int edges = 0, total = 0;
+        for (int y = 1; y < n - 1; y++) {
+            for (int x = 1; x < n - 1; x++) {
+                int i = y * n + x;
+                if (!m[i]) continue;
+                total++;
+                float gx = gray(px[i + 1]) - gray(px[i - 1]);
+                float gy = gray(px[i + n]) - gray(px[i - n]);
+                if (Math.sqrt(gx * gx + gy * gy) > 60) edges++;
+            }
+        }
+        return total == 0 ? 0 : edges / (float) total;
+    }
+
+    private static float gray(int c) {
+        return 0.299f * ((c >> 16) & 255) + 0.587f * ((c >> 8) & 255) + 0.114f * (c & 255);
+    }
+
+    private static List<int[]> components(boolean[] m, int n, int[] lbl) {
+        List<int[]> stats = new ArrayList<>();
+        int[] stack = new int[n * n];
+        for (int s = 0; s < n * n; s++) {
+            if (!m[s] || lbl[s] != 0) continue;
+            int id = stats.size() + 1;
+            int[] st = {0, n, n, -1, -1};
+            int sp = 0;
+            stack[sp++] = s;
+            lbl[s] = id;
+            while (sp > 0) {
+                int i = stack[--sp];
+                int x = i % n, y = i / n;
+                st[0]++;
+                st[1] = Math.min(st[1], x); st[2] = Math.min(st[2], y);
+                st[3] = Math.max(st[3], x); st[4] = Math.max(st[4], y);
+                for (int dy = -1; dy <= 1; dy++) {
+                    for (int dx = -1; dx <= 1; dx++) {
+                        int xx = x + dx, yy = y + dy;
+                        if (xx < 0 || yy < 0 || xx >= n || yy >= n) continue;
+                        int j = yy * n + xx;
+                        if (m[j] && lbl[j] == 0) {
+                            lbl[j] = id;
+                            stack[sp++] = j;
+                        }
+                    }
+                }
+            }
+            stats.add(st);
+        }
+        return stats;
+    }
+
+    private static boolean[] erode(boolean[] m, int n, int r) {
+        return morph(m, n, r, true);
+    }
+
+    private static boolean[] dilate(boolean[] m, int n, int r) {
+        return morph(m, n, r, false);
+    }
+
+    /** Square structuring element of side 2r+1, separable. */
+    private static boolean[] morph(boolean[] m, int n, int r, boolean erode) {
+        boolean[] t = new boolean[n * n], o = new boolean[n * n];
+        for (int y = 0; y < n; y++) {
+            for (int x = 0; x < n; x++) {
+                boolean v = erode;
+                for (int k = -r; k <= r && v == erode; k++) {
+                    int xx = x + k;
+                    boolean s = xx >= 0 && xx < n && m[y * n + xx];
+                    if (erode ? !s : s) v = !erode;
+                }
+                t[y * n + x] = v;
+            }
+        }
+        for (int y = 0; y < n; y++) {
+            for (int x = 0; x < n; x++) {
+                boolean v = erode;
+                for (int k = -r; k <= r && v == erode; k++) {
+                    int yy = y + k;
+                    boolean s = yy >= 0 && yy < n && t[yy * n + x];
+                    if (erode ? !s : s) v = !erode;
+                }
+                o[y * n + x] = v;
+            }
+        }
+        return o;
+    }
+
+    private static boolean[] open(boolean[] m, int n, int r) {
+        return dilate(erode(m, n, r), n, r);
+    }
+
+    private static boolean[] close(boolean[] m, int n, int r) {
+        return erode(dilate(m, n, r), n, r);
+    }
+
+    /** The convex hull of the largest component, filled. */
+    private static boolean[] convexHullOfLargest(boolean[] m, int n) {
+        int[] lbl = new int[n * n];
+        List<int[]> st = components(m, n, lbl);
+        int best = 0;
+        for (int i = 1; i < st.size(); i++) if (st.get(i)[0] > st.get(best)[0]) best = i;
+        List<int[]> pts = new ArrayList<>();
+        for (int i = 0; i < n * n; i++) {
+            if (lbl[i] == best + 1) pts.add(new int[] {i % n, i / n});
+        }
+        List<int[]> hull = hull(pts);
+        boolean[] out = new boolean[n * n];
+        int[] b = st.isEmpty() ? new int[] {0, 0, 0, -1, -1} : st.get(best);
+        for (int y = b[2]; y <= b[4]; y++) {
+            for (int x = b[1]; x <= b[3]; x++) {
+                if (inside(hull, x, y)) out[y * n + x] = true;
+            }
+        }
+        return out;
+    }
+
+    private static List<int[]> hull(List<int[]> p) {
+        p.sort((a, b) -> a[0] != b[0] ? a[0] - b[0] : a[1] - b[1]);
+        int k = 0;
+        int[][] h = new int[2 * p.size() + 1][];
+        for (int[] q : p) {
+            while (k >= 2 && cross(h[k - 2], h[k - 1], q) <= 0) k--;
+            h[k++] = q;
+        }
+        for (int i = p.size() - 2, t = k + 1; i >= 0; i--) {
+            int[] q = p.get(i);
+            while (k >= t && cross(h[k - 2], h[k - 1], q) <= 0) k--;
+            h[k++] = q;
+        }
+        List<int[]> out = new ArrayList<>();
+        for (int i = 0; i < Math.max(0, k - 1); i++) out.add(h[i]);
+        return out;
+    }
+
+    private static long cross(int[] o, int[] a, int[] b) {
+        return (long) (a[0] - o[0]) * (b[1] - o[1]) - (long) (a[1] - o[1]) * (b[0] - o[0]);
+    }
+
+    private static boolean inside(List<int[]> hull, int x, int y) {
+        if (hull.size() < 3) return false;
+        for (int i = 0; i < hull.size(); i++) {
+            int[] a = hull.get(i), b = hull.get((i + 1) % hull.size());
+            if (cross(a, b, new int[] {x, y}) < 0) return false;
+        }
+        return true;
+    }
+
+    private static int[] bbox(boolean[] m, int n) {
+        int x0 = n, y0 = n, x1 = -1, y1 = -1;
+        for (int i = 0; i < m.length; i++) {
+            if (!m[i]) continue;
+            int x = i % n, y = i / n;
+            x0 = Math.min(x0, x); y0 = Math.min(y0, y);
+            x1 = Math.max(x1, x); y1 = Math.max(y1, y);
+        }
+        return new int[] {x0, y0, x1, y1};
+    }
+
+    private static int count(boolean[] m) {
+        int c = 0;
+        for (boolean b : m) if (b) c++;
+        return c;
+    }
+
+    /** Summed-area table of a mask, (N+1)^2. */
+    private static double[] integral(boolean[] m) {
+        int w = N + 1;
+        double[] t = new double[w * w];
+        for (int y = 0; y < N; y++) {
+            double row = 0;
+            for (int x = 0; x < N; x++) {
+                row += m[y * N + x] ? 1 : 0;
+                t[(y + 1) * w + x + 1] = t[y * w + x + 1] + row;
+            }
+        }
+        return t;
+    }
+
+    /** Summed-area tables of premultiplied alpha, red, green, blue under a mask. */
+    private static double[][] integralPremultiplied(int[] px, boolean[] m) {
+        int w = N + 1;
+        double[][] t = new double[4][w * w];
+        double[] row = new double[4];
+        for (int y = 0; y < N; y++) {
+            Arrays.fill(row, 0);
+            for (int x = 0; x < N; x++) {
+                int i = y * N + x, c = px[i];
+                double al = m[i] ? (c >>> 24) / 255.0 : 0;
+                row[0] += al;
+                row[1] += al * ((c >> 16) & 255);
+                row[2] += al * ((c >> 8) & 255);
+                row[3] += al * (c & 255);
+                for (int k = 0; k < 4; k++) t[k][(y + 1) * w + x + 1] = t[k][y * w + x + 1] + row[k];
+            }
+        }
+        return t;
+    }
+
+    /** The mean of a summed-area table over [x0,x1) x [y0,y1), whole pixels, clamped. */
+    private static double mean(double[] t, float x0, float y0, float x1, float y1) {
+        int w = N + 1;
+        int a = clampN(Math.round(x0)), b = clampN(Math.round(y0));
+        int c = Math.max(a + 1, clampN(Math.round(x1))), d = Math.max(b + 1, clampN(Math.round(y1)));
+        c = Math.min(N, c); d = Math.min(N, d);
+        if (c <= a || d <= b) return 0;
+        double sum = t[d * w + c] - t[b * w + c] - t[d * w + a] + t[b * w + a];
+        return sum / ((c - a) * (double) (d - b));
+    }
+
+    private static int clampN(int v) {
+        return Math.max(0, Math.min(N, v));
+    }
+
+    private static float area(double[] t, float x0, float y0, float x1, float y1) {
+        return (float) mean(t, x0, y0, x1, y1);
+    }
+
+    private static int areaColor(double[][] t, float x0, float y0, float x1, float y1) {
+        double al = mean(t[0], x0, y0, x1, y1);
+        if (al <= 1e-4) return 0;
+        return argb((int) Math.round(al * 255), (float) (mean(t[1], x0, y0, x1, y1) / al),
+                (float) (mean(t[2], x0, y0, x1, y1) / al), (float) (mean(t[3], x0, y0, x1, y1) / al));
+    }
+
+    private static float bilinear(boolean[] m, float x, float y) {
+        int x0 = (int) Math.floor(x), y0 = (int) Math.floor(y);
+        float fx = x - x0, fy = y - y0;
+        return (1 - fx) * (1 - fy) * at(m, x0, y0) + fx * (1 - fy) * at(m, x0 + 1, y0)
+                + (1 - fx) * fy * at(m, x0, y0 + 1) + fx * fy * at(m, x0 + 1, y0 + 1);
+    }
+
+    private static float at(boolean[] m, int x, int y) {
+        return x < 0 || y < 0 || x >= N || y >= N || !m[y * N + x] ? 0 : 1;
+    }
+
+    /** Bilinear sample of the original pixels, alpha cut by the mask (premultiplied mix). */
+    private static int sampleMasked(int[] px, boolean[] m, float x, float y) {
+        int x0 = (int) Math.floor(x), y0 = (int) Math.floor(y);
+        float fx = x - x0, fy = y - y0;
+        float[] acc = new float[4];
+        float[] wts = {(1 - fx) * (1 - fy), fx * (1 - fy), (1 - fx) * fy, fx * fy};
+        int[][] pos = {{x0, y0}, {x0 + 1, y0}, {x0, y0 + 1}, {x0 + 1, y0 + 1}};
+        for (int k = 0; k < 4; k++) {
+            int xx = pos[k][0], yy = pos[k][1];
+            if (xx < 0 || yy < 0 || xx >= N || yy >= N || !m[yy * N + xx]) continue;
+            int c = px[yy * N + xx];
+            float al = ((c >>> 24) / 255f) * wts[k];
+            acc[0] += al;
+            acc[1] += al * ((c >> 16) & 255);
+            acc[2] += al * ((c >> 8) & 255);
+            acc[3] += al * (c & 255);
+        }
+        if (acc[0] <= 0) return 0;
+        return argb(Math.round(acc[0] * 255), acc[1] / acc[0], acc[2] / acc[0], acc[3] / acc[0]);
+    }
+
+    private static float[] blur(float[] src, int n, float sigma) {
+        int r = (int) Math.ceil(sigma * 2.5f);
+        float[] k = new float[2 * r + 1];
+        float sum = 0;
+        for (int i = -r; i <= r; i++) {
+            k[i + r] = (float) Math.exp(-i * i / (2 * sigma * sigma));
+            sum += k[i + r];
+        }
+        for (int i = 0; i < k.length; i++) k[i] /= sum;
+        float[] t = new float[n * n], o = new float[n * n];
+        for (int y = 0; y < n; y++) {
+            for (int x = 0; x < n; x++) {
+                float v = 0;
+                for (int i = -r; i <= r; i++) {
+                    int xx = Math.min(n - 1, Math.max(0, x + i));
+                    v += k[i + r] * src[y * n + xx];
+                }
+                t[y * n + x] = v;
+            }
+        }
+        for (int y = 0; y < n; y++) {
+            for (int x = 0; x < n; x++) {
+                float v = 0;
+                for (int i = -r; i <= r; i++) {
+                    int yy = Math.min(n - 1, Math.max(0, y + i));
+                    v += k[i + r] * t[yy * n + x];
+                }
+                o[y * n + x] = v;
+            }
+        }
+        return o;
+    }
+
+    // ---------------------------------------------------------------- colour
+
+    private static double[] basis(double x, double y) {
+        return new double[] {1, x, y, x * x, y * y, x * y};
+    }
+
+    private static void model(double[][] coef, float x, float y, float[] out) {
+        double[] b = basis(x, y);
+        for (int c = 0; c < 3; c++) {
+            double v = 0;
+            for (int t = 0; t < coef[c].length; t++) v += coef[c][t] * b[t];
+            out[c] = (float) Math.max(0, Math.min(255, v));
+        }
+    }
+
+    /** Least squares per channel over the first {@code terms} basis terms (normal equations). */
+    private static double[][] lstsq(double[][] X, double[][] C, boolean[] keep, int terms) {
+        double[][] out = new double[3][];
+        for (int c = 0; c < 3; c++) {
+            double[][] A = new double[terms][terms + 1];
+            for (int k = 0; k < X.length; k++) {
+                if (!keep[k]) continue;
+                for (int i = 0; i < terms; i++) {
+                    for (int j = 0; j < terms; j++) A[i][j] += X[k][i] * X[k][j];
+                    A[i][terms] += X[k][i] * C[k][c];
+                }
+            }
+            for (int i = 0; i < terms; i++) A[i][i] += 1e-6; // keeps a flat tile solvable
+            out[c] = solve(A, terms);
+        }
+        return out;
+    }
+
+    private static double[] solve(double[][] A, int n) {
+        for (int p = 0; p < n; p++) {
+            int max = p;
+            for (int i = p + 1; i < n; i++) if (Math.abs(A[i][p]) > Math.abs(A[max][p])) max = i;
+            double[] t = A[p]; A[p] = A[max]; A[max] = t;
+            for (int i = p + 1; i < n; i++) {
+                double f = A[i][p] / A[p][p];
+                for (int j = p; j <= n; j++) A[i][j] -= f * A[p][j];
+            }
+        }
+        double[] x = new double[n];
+        for (int i = n - 1; i >= 0; i--) {
+            double s = A[i][n];
+            for (int j = i + 1; j < n; j++) s -= A[i][j] * x[j];
+            x[i] = s / A[i][i];
+        }
+        return x;
+    }
+
+    private static void toLab(int c, float[] out, int o) {
+        float[] rgb = {(c >> 16) & 255, (c >> 8) & 255, c & 255};
+        float[] lab = new float[3];
+        toLab(rgb, lab);
+        out[o] = lab[0]; out[o + 1] = lab[1]; out[o + 2] = lab[2];
+    }
+
+    /** sRGB (0-255) to CIE Lab (D65), on OpenCV's 8-bit scale (L*2.55, a+128, b+128). */
+    private static void toLab(float[] rgb, float[] out) {
+        double r = lin(rgb[0] / 255.0), g = lin(rgb[1] / 255.0), b = lin(rgb[2] / 255.0);
+        double x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047;
+        double y = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+        double z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883;
+        double fx = f(x), fy = f(y), fz = f(z);
+        out[0] = (float) ((116 * fy - 16) * 2.55);
+        out[1] = (float) (500 * (fx - fy) + 128);
+        out[2] = (float) (200 * (fy - fz) + 128);
+    }
+
+    private static double lin(double c) {
+        return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+    }
+
+    private static double f(double t) {
+        return t > 0.008856 ? Math.cbrt(t) : 7.787 * t + 16 / 116.0;
+    }
+
+    private static float dist(float[] lab, int o, float[] ref) {
+        return (float) Math.sqrt(sq(lab[o] - ref[0]) + sq(lab[o + 1] - ref[1])
+                + sq(lab[o + 2] - ref[2]));
+    }
+
+    private static float lum(float[] c) {
+        return (0.2126f * c[0] + 0.7152f * c[1] + 0.0722f * c[2]) / 255f;
+    }
+
+    private static float sat(float[] c) {
+        float mx = Math.max(c[0], Math.max(c[1], c[2])), mn = Math.min(c[0], Math.min(c[1], c[2]));
+        return mx == 0 ? 0 : (mx - mn) / mx;
+    }
+
+    private static int argb(int a, float r, float g, float b) {
+        return (Math.max(0, Math.min(255, a)) << 24) | (clamp(r) << 16) | (clamp(g) << 8) | clamp(b);
+    }
+
+    private static int clamp(float v) {
+        return Math.max(0, Math.min(255, Math.round(v)));
+    }
+
+    private static int over(int dst, int src) {
+        float sa = (src >>> 24) / 255f, da = (dst >>> 24) / 255f;
+        float oa = sa + da * (1 - sa);
+        if (oa <= 0) return 0;
+        float[] o = new float[3];
+        for (int c = 0; c < 3; c++) {
+            int sh = 16 - 8 * c;
+            o[c] = (((src >> sh) & 255) * sa + ((dst >> sh) & 255) * da * (1 - sa)) / oa;
+        }
+        return argb(Math.round(oa * 255), o[0], o[1], o[2]);
+    }
+
+    private static double sq(double v) {
+        return v * v;
+    }
+
+    private static float pct(float[] v, float p) {
+        float[] s = v.clone();
+        Arrays.sort(s);
+        return s[Math.min(s.length - 1, Math.max(0, (int) (p / 100f * (s.length - 1))))];
+    }
+
+    private static float percentile(List<Float> v, float p) {
+        float[] a = new float[v.size()];
+        for (int i = 0; i < a.length; i++) a[i] = v.get(i);
+        return a.length == 0 ? 0 : pct(a, p);
+    }
+
+    // ---------------------------------------------------------------- k-means
+
+    static final class Kmeans {
+        float[][] centers;
+        float[] share;
+        int[] label;
+
+        int nearest(int c) {
+            float[] p = {(c >> 16) & 255, (c >> 8) & 255, c & 255};
+            int best = 0;
+            double bd = Double.MAX_VALUE;
+            for (int k = 0; k < centers.length; k++) {
+                double dd = sq(p[0] - centers[k][0]) + sq(p[1] - centers[k][1])
+                        + sq(p[2] - centers[k][2]);
+                if (dd < bd) { bd = dd; best = k; }
+            }
+            return best;
+        }
+    }
+
+    /** k-means++ with a fixed seed (the same icon always gives the same result), by share. */
+    static Kmeans kmeans(float[][] pts, int k, int iters) {
+        Random rnd = new Random(1);
+        int n = pts.length, dim = pts[0].length;
+        float[][] c = new float[k][];
+        c[0] = pts[rnd.nextInt(n)].clone();
+        double[] d2 = new double[n];
+        for (int j = 1; j < k; j++) {
+            double sum = 0;
+            for (int i = 0; i < n; i++) {
+                double best = Double.MAX_VALUE;
+                for (int q = 0; q < j; q++) best = Math.min(best, d(pts[i], c[q]));
+                d2[i] = best;
+                sum += best;
+            }
+            double t = rnd.nextDouble() * sum;
+            int pick = n - 1;
+            for (int i = 0; i < n; i++) {
+                t -= d2[i];
+                if (t <= 0) { pick = i; break; }
+            }
+            c[j] = pts[pick].clone();
+        }
+        int[] lab = new int[n];
+        for (int it = 0; it < iters; it++) {
+            for (int i = 0; i < n; i++) {
+                int best = 0;
+                double bd = Double.MAX_VALUE;
+                for (int q = 0; q < k; q++) {
+                    double dd = d(pts[i], c[q]);
+                    if (dd < bd) { bd = dd; best = q; }
+                }
+                lab[i] = best;
+            }
+            double[][] sums = new double[k][dim];
+            int[] cnt = new int[k];
+            for (int i = 0; i < n; i++) {
+                cnt[lab[i]]++;
+                for (int t = 0; t < dim; t++) sums[lab[i]][t] += pts[i][t];
+            }
+            for (int q = 0; q < k; q++) {
+                if (cnt[q] == 0) continue;
+                for (int t = 0; t < dim; t++) c[q][t] = (float) (sums[q][t] / cnt[q]);
+            }
+        }
+        int[] cnt = new int[k];
+        for (int i = 0; i < n; i++) cnt[lab[i]]++;
+        Integer[] order = new Integer[k];
+        for (int q = 0; q < k; q++) order[q] = q;
+        Arrays.sort(order, (p, q) -> cnt[q] - cnt[p]);
+        int[] rank = new int[k];
+        Kmeans out = new Kmeans();
+        out.centers = new float[k][];
+        out.share = new float[k];
+        for (int q = 0; q < k; q++) {
+            out.centers[q] = c[order[q]];
+            out.share[q] = cnt[order[q]] / (float) n;
+            rank[order[q]] = q;
+        }
+        out.label = new int[n];
+        for (int i = 0; i < n; i++) out.label[i] = rank[lab[i]];
+        return out;
+    }
+
+    private static double d(float[] a, float[] b) {
+        double s = 0;
+        for (int i = 0; i < a.length; i++) s += sq(a[i] - b[i]);
+        return s;
+    }
+}
