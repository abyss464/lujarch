+    // ------------------------------------------------------------------ the work
+
+    private int effectiveMode(String pkg) {
+        synchronized (mLock) {
+            if (!mEnabled) return LujarchIcons.MODE_ORIGINAL;
+            Integer m = mModes.get(pkg);
+            return m == null ? LujarchIcons.MODE_DEFAULT : m;
+        }
+    }
+
+    /** The cache key; '@' cannot occur in a package name. DEFAULT draws as REDRAW. */
+    private String key(ApplicationInfo ai, int iconRes, int mode) {
+        if (mode == LujarchIcons.MODE_DEFAULT) mode = LujarchIcons.MODE_REDRAW;
+        return ai.packageName + "@" + ai.longVersionCode + "@" + ai.sourceDir.hashCode() + "@"
+                + iconRes + "@" + mode + "@" + ALGO_VERSION;
+    }
+
+    /** The token for the icon as set now; 0 to keep the original. */
+    long token(String pkg, int iconRes, int userId) {
+        int mode = effectiveMode(pkg);
+        if (mode == LujarchIcons.MODE_ORIGINAL) return 0;
+        ApplicationInfo ai = appInfo(pkg, userId);
+        if (ai == null) return 0;
+        Object r = result(ai, iconRes, mode, userId);
+        if (r == NONE) return 0;
+        long t = key(ai, iconRes, mode).hashCode();
+        synchronized (mLock) {
