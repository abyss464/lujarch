diff --git a/services/core/java/com/android/server/lujarch/icons/IconFitter.java b/services/core/java/com/android/server/lujarch/icons/IconFitter.java
new file mode 100644
index 0000000000000000000000000000000000000000..3f3e8754b45a45558543e01d951bd026a0ba22f8
--- /dev/null
+++ b/services/core/java/com/android/server/lujarch/icons/IconFitter.java
@@ -0,0 +1,1081 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.lujarch.icons;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Random;
+
+/**
+ * Turns a legacy (single-layer) app icon into the layers of an adaptive icon (ICON-1). Plain
+ * Java on ARGB arrays.
+ *
+ * The analysis: the tile's background as a fitted colour gradient; the foreground as what
+ * differs from it; campaign decorations (a banner across the bottom, badges at the side)
+ * dropped; the main elements as connected components, specks, edge shading and captions
+ * dropped; the palette by k-means; an illustration told from a logo by its colours and detail.
+ *
+ * Two results:
+ * <ul>
+ * <li>FIT: the background to full bleed (its gradient kept), the original foreground pixels
+ * scaled into the safe zone;
+ * <li>REDRAW: a flat plate in the background colour and the main elements as a flat shape,
+ * white on a dark or saturated plate, else in the dominant colour, with a second colour kept as
+ * an accent. An illustration is not redrawn: it gets FIT.
+ * </ul>
+ * Both come with a monochrome layer (the main elements' shape) for themed icons, except for an
+ * illustration.
+ */
+public final class IconFitter {
+    /** The analysis size: the icon is rendered square at this size before it is passed in. */
+    public static final int N = 512;
+
+    public static final int KIND_LOGO = 1;
+    public static final int KIND_ILLUSTRATION = 2;
+
+    /** The layers of an adaptive icon, each size x size ARGB, the 108 dp canvas. */
+    public static final class Layers {
+        public final int size;
+        public final int kind;
+        public final int[] background;
+        public final int[] foreground;
+        /** Null for an illustration: the launcher then derives one as for any icon. */
+        public final int[] monochrome;
+        /** What was found, for logs and tests: "banner", "badge", "caption". */
+        public final List<String> notes;
+
+        Layers(int size, int kind, int[] background, int[] foreground, int[] monochrome,
+                List<String> notes) {
+            this.size = size;
+            this.kind = kind;
+            this.background = background;
+            this.foreground = foreground;
+            this.monochrome = monochrome;
+            this.notes = notes;
+        }
+    }
+
+    // In the 108 dp canvas the visible circle is 72 dp; the elements' larger side is this share
+    // of the circle (as in the prototype the owner approved, 2026-10-01).
+    private static final float GLYPH_OF_CIRCLE = 0.58f;
+    private static final float CIRCLE_OF_CANVAS = 72f / 108f;
+
+    private IconFitter() {}
+
+    /**
+     * Fits an icon. {@code argb} is N x N, the legacy icon rendered square with alpha.
+     * Returns null when the icon has no usable shape (empty, or nothing but background).
+     */
+    public static Layers fit(int[] argb, boolean redraw, int size) {
+        Analysis a = analyse(argb);
+        if (a == null) return null;
+        boolean asRedraw = redraw && a.kind == KIND_LOGO;
+        int[] bg = asRedraw ? flatPlate(a, size) : extendedBackground(a, size);
+        int[] fg = asRedraw ? redrawForeground(a, size) : fitForeground(argb, a, size);
+        int[] mono = a.kind == KIND_LOGO ? monochrome(a, size) : null;
+        return new Layers(size, a.kind, bg, fg, mono, a.notes);
+    }
+
+    // ---------------------------------------------------------------- analysis
+
+    static final class Analysis {
+        int x0, y0, x1, y1;          // the tile
+        double[][] coef;              // background model, 6 terms per channel (RGB)
+        boolean[] fitMask;            // what FIT keeps (all of the logo but edge shading)
+        boolean[] shape;              // the main elements without captions (REDRAW, mono)
+        int[] cls;                    // palette class per pixel of shape: 0 main, 1 accent
+        float[][] centers;            // palette, RGB, by share
+        float[] share;
+        float[] bgMean;
+        int kind;
+        boolean whiteTile;
+        List<String> notes = new ArrayList<>();
+    }
+
+    static Analysis analyse(int[] px) {
+        final int n = N;
+        boolean[] a = new boolean[n * n];
+        int x0 = n, y0 = n, x1 = -1, y1 = -1;
+        for (int y = 0; y < n; y++) {
+            for (int x = 0; x < n; x++) {
+                if ((px[y * n + x] >>> 24) > 128) {
+                    a[y * n + x] = true;
+                    if (x < x0) x0 = x;
+                    if (x > x1) x1 = x;
+                    if (y < y0) y0 = y;
+                    if (y > y1) y1 = y;
+                }
+            }
+        }
+        if (x1 < 0) return null;
+        Analysis r = new Analysis();
+        r.x0 = x0; r.y0 = y0; r.x1 = x1; r.y1 = y1;
+        int w = x1 - x0, h = y1 - y0;
+        if (w < 16 || h < 16) return null;
+
+        float[] lab = new float[n * n * 3];
+        for (int i = 0; i < n * n; i++) toLab(px[i], lab, i * 3);
+
+        // ring 5-9 % inside the tile's edge
+        int[] d = new int[n * n];
+        List<Integer> ring = new ArrayList<>();
+        for (int y = 0; y < n; y++) {
+            for (int x = 0; x < n; x++) {
+                int dd = Math.min(Math.min(x - x0, x1 - x), Math.min(y - y0, y1 - y));
+                d[y * n + x] = dd;
+                if (a[y * n + x] && dd > 0.05 * w && dd < 0.09 * w) ring.add(y * n + x);
+            }
+        }
+        r.coef = fitBackground(px, lab, ring);
+        float[] bgRgb = new float[3];
+        float[] bgLab = new float[3];
+        boolean[] fg = new boolean[n * n];
+        for (int y = 0; y < n; y++) {
+            for (int x = 0; x < n; x++) {
+                int i = y * n + x;
+                if (!a[i]) continue;
+                model(r.coef, x / (float) n, y / (float) n, bgRgb);
+                toLab(bgRgb, bgLab);
+                fg[i] = dist(lab, i * 3, bgLab) > 22;
+            }
+        }
+        model(r.coef, 0.5f, 0.5f, bgRgb);
+        r.bgMean = bgRgb.clone();
+
+        dropOverlays(px, lab, fg, r, d);
+        fg = open(fg, n, 1);
+        fg = close(fg, n, 2);
+
+        // components
+        int[] lbl = new int[n * n];
+        List<int[]> stats = components(fg, n, lbl); // {area, minx, miny, maxx, maxy}
+        if (stats.isEmpty()) return null;
+        int total = 0, big = 0;
+        for (int[] s : stats) {
+            total += s[0];
+            big = Math.max(big, s[0]);
+        }
+        Integer[] order = new Integer[stats.size()];
+        for (int i = 0; i < order.length; i++) order[i] = i;
+        Arrays.sort(order, (p, q) -> stats.get(q)[0] - stats.get(p)[0]);
+        boolean[] touchesEdge = new boolean[stats.size()];
+        for (int i = 0; i < n * n; i++) {
+            if (lbl[i] > 0 && d[i] < 0.035 * w) touchesEdge[lbl[i] - 1] = true;
+        }
+        boolean[] keepC = new boolean[stats.size()];
+        boolean[] fitC = new boolean[stats.size()];
+        List<Integer> kept = new ArrayList<>();
+        for (int i : order) {
+            int area = stats.get(i)[0];
+            boolean shading = touchesEdge[i] && area < 0.25 * total;
+            // beside a removed decoration, a crumb of it is not a stroke of the logo
+            if (!shading && (area >= 0.015 * big || r.notes.isEmpty())) fitC[i] = true;
+            if (area < 0.06 * big || shading) continue;
+            keepC[i] = true;
+            kept.add(i);
+        }
+        // captions: three or more similar-height components in one row, apart from the main
+        // element and small beside it (a wordmark as large as the symbol stays)
+        boolean[] captionC = new boolean[stats.size()];
+        if (kept.size() >= 4) {
+            int[] m = stats.get(kept.get(0));
+            int mh = m[4] - m[2] + 1;
+            for (int i : kept.subList(1, kept.size())) {
+                int[] s = stats.get(i);
+                int hi = s[4] - s[2] + 1;
+                float cy = (s[2] + s[4]) / 2f;
+                int band = 0;
+                for (int j : kept.subList(1, kept.size())) {
+                    int[] t = stats.get(j);
+                    int hj = t[4] - t[2] + 1;
+                    float cyj = (t[2] + t[4]) / 2f;
+                    float ratio = hj / (float) Math.max(hi, 1);
+                    if (Math.abs(cyj - cy) < 0.5f * hi && ratio > 0.6f && ratio < 1.6f) band++;
+                }
+                if (band >= 3 && (cy > m[4] || cy < m[2]) && hi < 0.3f * mh) captionC[i] = true;
+            }
+        }
+        r.fitMask = new boolean[n * n];
+        r.shape = new boolean[n * n];
+        boolean anyCaption = false;
+        for (int i = 0; i < n * n; i++) {
+            int c = lbl[i] - 1;
+            if (c < 0) continue;
+            r.fitMask[i] = fitC[c];
+            r.shape[i] = keepC[c] && !captionC[c];
+            anyCaption |= captionC[c];
+        }
+        if (anyCaption) r.notes.add("caption");
+        if (count(r.shape) < 50) return null;
+
+        // palette of the main elements, two colours
+        float[][] cols = rgbOf(px, r.shape, 20000);
+        Kmeans k2 = kmeans(cols, Math.min(2, cols.length), 20);
+        r.centers = k2.centers;
+        r.share = k2.share;
+        r.cls = new int[n * n];
+        Arrays.fill(r.cls, -1);
+        for (int i = 0; i < n * n; i++) {
+            if (r.shape[i]) r.cls[i] = k2.nearest(px[i]);
+        }
+        // an illustration: many colours or much detail
+        Kmeans k5 = kmeans(cols, Math.min(5, cols.length), 20);
+        int strong = 0;
+        for (float s : k5.share) if (s > 0.10f) strong++;
+        // detail inside the shapes (their outlines do not count): a flat logo has none, an
+        // illustration's eyes, teeth, shading do
+        float detail = edgeDensity(px, erode(r.shape, n, 2), n);
+        int families = hueFamilies(k5);
+        r.kind = (strong >= 3 || families >= 3 || detail > 0.08f)
+                ? KIND_ILLUSTRATION : KIND_LOGO;
+        r.notes.add(String.format(java.util.Locale.ROOT, "strong=%d families=%d detail=%.3f",
+                strong, families, detail));
+        r.whiteTile = lum(r.bgMean) > 0.85f && sat(r.bgMean) < 0.12f;
+        return r;
+    }
+
+    /** Robust fit: a linear gradient first, dropping far samples, then the quadratic one. */
+    private static double[][] fitBackground(int[] px, float[] lab, List<Integer> ring) {
+        int m = ring.size();
+        double[][] X = new double[m][];
+        double[][] C = new double[m][];
+        float[][] CL = new float[m][];
+        for (int k = 0; k < m; k++) {
+            int i = ring.get(k);
+            X[k] = basis((i % N) / (double) N, (i / N) / (double) N);
+            C[k] = new double[] {(px[i] >> 16) & 255, (px[i] >> 8) & 255, px[i] & 255};
+            CL[k] = new float[] {lab[i * 3], lab[i * 3 + 1], lab[i * 3 + 2]};
+        }
+        boolean[] keep = new boolean[m];
+        Arrays.fill(keep, true);
+        float[] tmpRgb = new float[3], tmpLab = new float[3];
+        for (int it = 0; it < 5; it++) {
+            double[][] lin = lstsq(X, C, keep, 3);
+            float[] res = new float[m];
+            List<Float> kr = new ArrayList<>();
+            for (int k = 0; k < m; k++) {
+                for (int c = 0; c < 3; c++) {
+                    tmpRgb[c] = (float) (lin[c][0] + lin[c][1] * X[k][1] + lin[c][2] * X[k][2]);
+                }
+                toLab(tmpRgb, tmpLab);
+                res[k] = (float) Math.sqrt(sq(CL[k][0] - tmpLab[0]) + sq(CL[k][1] - tmpLab[1])
+                        + sq(CL[k][2] - tmpLab[2]));
+                if (keep[k]) kr.add(res[k]);
+            }
+            float thr = Math.max(14f, percentile(kr, 60));
+            boolean[] nk = new boolean[m];
+            int cnt = 0;
+            boolean same = true;
+            for (int k = 0; k < m; k++) {
+                nk[k] = res[k] < thr;
+                if (nk[k]) cnt++;
+                if (nk[k] != keep[k]) same = false;
+            }
+            if (cnt < 0.3 * m || same) break;
+            keep = nk;
+        }
+        return lstsq(X, C, keep, 6);
+    }
+
+    /**
+     * Campaign decorations: a banner (from the bottom up, rows whose foreground spans the tile
+     * edge to edge; its slogan's letters are holes, so the span counts) and badges (a colour
+     * cluster small, compact and away from the middle). Their pixels, and what they enclose,
+     * are not the logo.
+     */
+    private static void dropOverlays(int[] px, float[] lab, boolean[] fg, Analysis r, int[] d) {
+        final int n = N;
+        int x0 = r.x0, y0 = r.y0, x1 = r.x1, y1 = r.y1, w = x1 - x0, h = y1 - y0;
+        // badges
+        List<Integer> idx = new ArrayList<>();
+        for (int i = 0; i < n * n; i++) if (fg[i]) idx.add(i);
+        if (idx.size() >= 100) {
+            float[][] pts = new float[idx.size()][];
+            for (int k = 0; k < pts.length; k++) {
+                int i = idx.get(k);
+                pts[k] = new float[] {lab[i * 3], lab[i * 3 + 1], lab[i * 3 + 2]};
+            }
+            Kmeans km = kmeans(pts, Math.min(6, pts.length), 30);
+            float cx = (x0 + x1) / 2f, cy = (y0 + y1) / 2f;
+            for (int c = 0; c < km.centers.length; c++) {
+                List<Integer> members = new ArrayList<>();
+                for (int k = 0; k < pts.length; k++) if (km.label[k] == c) members.add(idx.get(k));
+                if (members.size() < 30) continue;
+                float share = members.size() / (float) pts.length;
+                float[] xs = new float[members.size()], ys = new float[members.size()];
+                for (int k = 0; k < xs.length; k++) {
+                    xs[k] = members.get(k) % n;
+                    ys[k] = members.get(k) / n;
+                }
+                float bw = (pct(xs, 98) - pct(xs, 2)) / w, bh = (pct(ys, 98) - pct(ys, 2)) / h;
+                float off = (float) Math.hypot(pct(xs, 50) - cx, pct(ys, 50) - cy) / w;
+                if (share < 0.15f && bw < 0.32f && bh < 0.32f && off > 0.24f) {
+                    boolean[] m = new boolean[n * n];
+                    for (int i : members) m[i] = true;
+                    m = close(m, n, 4);
+                    boolean[] hull = convexHullOfLargest(m, n);
+                    hull = dilate(hull, n, 2);
+                    for (int i = 0; i < n * n; i++) if (hull[i]) fg[i] = false;
+                    r.notes.add("badge");
+                }
+            }
+        }
+        // banner
+        int rows = 0, top = -1;
+        for (int y = y1; y > y0; y--) {
+            int lo = -1, hi = -1;
+            for (int x = x0; x <= x1; x++) {
+                if (fg[y * n + x]) {
+                    if (lo < 0) lo = x;
+                    hi = x;
+                }
+            }
+            if (lo < 0 || (hi - lo) < 0.92 * w || lo - x0 > 0.04 * w || hi - x0 < 0.96 * w) break;
+            rows++;
+            top = y;
+        }
+        if (rows > 0.10 * h) {
+            float[] bcol = new float[3];
+            List<float[]> band = new ArrayList<>();
+            for (int y = top; y <= y1; y++) {
+                for (int x = x0; x <= x1; x++) {
+                    int i = y * n + x;
+                    if (fg[i]) band.add(new float[] {lab[i * 3], lab[i * 3 + 1], lab[i * 3 + 2]});
+                }
+            }
+            for (int c = 0; c < 3; c++) {
+                float[] v = new float[band.size()];
+                for (int k = 0; k < v.length; k++) v[k] = band.get(k)[c];
+                bcol[c] = pct(v, 50);
+            }
+            for (int y = top; y <= y1; y++) {
+                for (int x = x0; x <= x1; x++) fg[y * n + x] = false;
+            }
+            int above = Math.max(y0, top - (int) (0.12 * h));
+            for (int y = above; y < top; y++) {
+                for (int x = x0; x <= x1; x++) {
+                    int i = y * n + x;
+                    if (fg[i] && dist(lab, i * 3, bcol) < 7) fg[i] = false;
+                }
+            }
+            // what is left along the cut thinner than a stroke is the banner's rim
+            int k = Math.max(1, (int) (0.0175 * w));
+            boolean[] opened = open(fg, n, k);
+            int zone = Math.max(y0, top - (int) (0.15 * h));
+            for (int y = zone; y < top; y++) {
+                for (int x = x0; x <= x1; x++) {
+                    int i = y * n + x;
+                    if (!opened[i]) fg[i] = false;
+                }
+            }
+            r.notes.add("banner");
+        }
+    }
