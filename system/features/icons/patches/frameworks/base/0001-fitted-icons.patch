@@ -0,0 +1,26 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.lujarch.icons;
+
+import com.android.internal.lujarch.icons.LujarchIconLayers;
+
+/**
+ * Lujarch fitted icons (ICON-1): a legacy app icon becomes an adaptive one, redrawn or fitted. Reads are open to every app (an app's icon is public);
+ * changes need WRITE_SECURE_SETTINGS.
+ * @hide
+ */
+interface ILujarchIconService {
+    /** 0 when the icon stays as it is; else a token that changes when the fitted icon does. */
+    long getToken(String packageName, int iconRes, int userId);
+    /** The layers for the icon as it is set now, or null to keep the original. */
+    LujarchIconLayers getLayers(String packageName, int iconRes, int userId);
+    /** The layers a mode would give (the chooser's previews), null for the original. */
+    LujarchIconLayers getPreview(String packageName, int iconRes, int userId, int mode);
+    /** Whether the app's icon is one the system fits (a legacy icon). */
+    boolean isFittable(String packageName, int iconRes, int userId);
+
+    int getMode(String packageName);
+    void setMode(String packageName, int mode);
+}
