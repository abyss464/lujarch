@@ -0,0 +1,68 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.lujarch.icons;
+
+import android.annotation.Nullable;
+import android.graphics.Bitmap;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * The layers of a fitted icon, each the 108 dp canvas of an adaptive icon.
+ * @hide
+ */
+public final class LujarchIconLayers implements Parcelable {
+    /** A logo: redrawn as shapes. */
+    public static final int KIND_LOGO = 1;
+    /** An illustration: fitted, never redrawn. */
+    public static final int KIND_ILLUSTRATION = 2;
+
+    public final Bitmap background;
+    public final Bitmap foreground;
+    @Nullable
+    public final Bitmap monochrome;
+    public final int kind;
+
+    public LujarchIconLayers(Bitmap background, Bitmap foreground, @Nullable Bitmap monochrome,
+            int kind) {
+        this.background = background;
+        this.foreground = foreground;
+        this.monochrome = monochrome;
+        this.kind = kind;
+    }
+
+    private LujarchIconLayers(Parcel in) {
+        background = Bitmap.CREATOR.createFromParcel(in);
+        foreground = Bitmap.CREATOR.createFromParcel(in);
+        monochrome = in.readInt() != 0 ? Bitmap.CREATOR.createFromParcel(in) : null;
+        kind = in.readInt();
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+        background.writeToParcel(dest, flags);
+        foreground.writeToParcel(dest, flags);
+        dest.writeInt(monochrome != null ? 1 : 0);
+        if (monochrome != null) monochrome.writeToParcel(dest, flags);
+        dest.writeInt(kind);
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    public static final Creator<LujarchIconLayers> CREATOR = new Creator<>() {
+        @Override
+        public LujarchIconLayers createFromParcel(Parcel in) {
+            return new LujarchIconLayers(in);
+        }
+
+        @Override
+        public LujarchIconLayers[] newArray(int size) {
+            return new LujarchIconLayers[size];
+        }
+    };
+}
diff --git a/core/java/com/android/internal/lujarch/icons/LujarchIcons.java b/core/java/com/android/internal/lujarch/icons/LujarchIcons.java
new file mode 100644
index 0000000000000000000000000000000000000000..9d225495b9db091eb3c7e270bdb6211b6b8a6228
--- /dev/null
+++ b/core/java/com/android/internal/lujarch/icons/LujarchIcons.java
@@ -0,0 +1,125 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.lujarch.icons;
+
+import android.annotation.Nullable;
+import android.app.ActivityThread;
+import android.content.res.Resources;
+import android.graphics.Bitmap;
+import android.graphics.drawable.AdaptiveIconDrawable;
+import android.graphics.drawable.BitmapDrawable;
+import android.graphics.drawable.Drawable;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.UserHandle;
+import android.util.Log;
+import android.util.LruCache;
+
+/**
+ * The client of fitted icons: wherever an app's icon is loaded (PackageManager's item icons,
+ * LauncherActivityInfo, the launcher), a legacy icon is swapped for its fitted adaptive one.
+ * One service decides and draws (LujarchIconService), so every surface shows the same icon.
+ * @hide
+ */
+public final class LujarchIcons {
+    private static final String TAG = "lujarch_icons";
+    public static final String SERVICE = "lujarch_icons";
+    /** Settings.Global switch of fitted icons, 1 (the default) on. */
+    public static final String SETTING_FIT = "lujarch_icons_fit";
+    /** Sent to registered receivers when any fitted icon changed (a mode, the switch). */
+    public static final String ACTION_ICONS_CHANGED =
+            "com.android.internal.lujarch.icons.action.ICONS_CHANGED";
+
+    /** The owner's choices for one app; DEFAULT follows the system (redraw a logo). */
+    public static final int MODE_DEFAULT = 0;
+    public static final int MODE_ORIGINAL = 1;
+    public static final int MODE_FIT = 2;
+    public static final int MODE_REDRAW = 3;
+
+    private static final class Entry {
+        final long token;
+        final LujarchIconLayers layers;
+
+        Entry(long token, LujarchIconLayers layers) {
+            this.token = token;
+            this.layers = layers;
+        }
+    }
+
+    // The layers of the icons this process showed last; small: the launcher keeps its own
+    // cache and other apps show few icons at a time.
+    private static final LruCache<String, Entry> sCache = new LruCache<>(24);
+    private static volatile ILujarchIconService sService;
+
+    private LujarchIcons() {}
+
+    @Nullable
+    public static ILujarchIconService service() {
+        ILujarchIconService s = sService;
+        if (s == null) {
+            IBinder b = ServiceManager.getService(SERVICE);
+            if (b == null) return null;
+            s = ILujarchIconService.Stub.asInterface(b);
+            sService = s;
+        }
+        return s;
+    }
+
+    /**
+     * The icon to show for an app's icon resource: the fitted adaptive icon when the system
+     * fits this one, else {@code original}. Never throws; any failure keeps the original.
+     */
+    public static Drawable maybeFit(Resources res, String packageName, int iconRes, int userId,
+            Drawable original) {
+        if (original == null || original instanceof AdaptiveIconDrawable || iconRes == 0
+                || packageName == null || ActivityThread.isSystem()) {
+            return original;
+        }
+        try {
+            ILujarchIconService s = service();
+            if (s == null) return original;
+            long token = s.getToken(packageName, iconRes, userId);
+            if (token == 0) return original;
+            String key = packageName + "/" + iconRes + "/" + userId;
+            Entry e = sCache.get(key);
+            if (e == null || e.token != token) {
+                LujarchIconLayers layers = s.getLayers(packageName, iconRes, userId);
+                if (layers == null) return original;
+                e = new Entry(token, layers);
+                sCache.put(key, e);
+            }
+            return toDrawable(res, e.layers);
+        } catch (RemoteException | RuntimeException ex) {
+            Log.w(TAG, "Keeping the original icon of " + packageName, ex);
+            return original;
+        }
+    }
+
+    /** As {@link #maybeFit(Resources, String, int, int, Drawable)} for the calling user. */
+    public static Drawable maybeFit(Resources res, String packageName, int iconRes,
+            Drawable original) {
+        return maybeFit(res, packageName, iconRes, UserHandle.myUserId(), original);
+    }
+
+    /** The token of an app's fitted icon (0: not fitted), for caches keyed on the icon. */
+    public static long token(String packageName, int iconRes, int userId) {
+        try {
+            ILujarchIconService s = service();
+            return s == null ? 0 : s.getToken(packageName, iconRes, userId);
+        } catch (RemoteException | RuntimeException e) {
+            return 0;
+        }
+    }
+
+    public static AdaptiveIconDrawable toDrawable(Resources res, LujarchIconLayers l) {
+        return new AdaptiveIconDrawable(bitmap(res, l.background), bitmap(res, l.foreground),
+                l.monochrome != null ? bitmap(res, l.monochrome) : null);
+    }
+
+    private static Drawable bitmap(Resources res, Bitmap b) {
+        return new BitmapDrawable(res, b);
+    }
+}
