+    }
+
+    private Object result(ApplicationInfo ai, int iconRes, int mode, int userId) {
+        String key = key(ai, iconRes, mode);
+        Object r = mResults.get(key);
+        if (r != null) return r;
+        r = readCache(key);
+        if (r == null) {
+            r = compute(ai, iconRes, mode, userId);
+            writeCache(key, r);
+        }
+        mResults.put(key, r);
+        return r;
+    }
+
+    private Object compute(ApplicationInfo ai, int iconRes, int mode, int userId) {
+        long start = System.nanoTime();
+        try {
+            Resources res = getContext().getPackageManager().getResourcesForApplication(ai);
+            Drawable d = res.getDrawableForDensity(iconRes, RENDER_DENSITY, null);
+            if (d == null || d instanceof AdaptiveIconDrawable) return NONE;
+            int n = IconFitter.N;
+            Bitmap src = Bitmap.createBitmap(n, n, Bitmap.Config.ARGB_8888);
+            d.setBounds(0, 0, n, n);
+            d.draw(new Canvas(src));
+            int[] px = new int[n * n];
+            src.getPixels(px, 0, n, 0, 0, n, n);
+            src.recycle();
+            boolean redraw = mode != LujarchIcons.MODE_FIT;
+            IconFitter.Layers l = IconFitter.fit(px, redraw, CANVAS);
+            if (l == null) {
+                Slog.i(TAG, ai.packageName + ": nothing to fit, original kept");
+                return NONE;
+            }
+            Slog.i(TAG, ai.packageName + ": " + (l.kind == IconFitter.KIND_LOGO ? "logo" : "illustration")
+                    + (redraw ? ", redrawn " : ", fitted ") + l.notes + " in "
+                    + (System.nanoTime() - start) / 1_000_000 + " ms");
+            return new LujarchIconLayers(bitmap(l.background), bitmap(l.foreground),
+                    l.monochrome != null ? bitmap(l.monochrome) : null,
+                    l.kind == IconFitter.KIND_LOGO ? LujarchIconLayers.KIND_LOGO
+                            : LujarchIconLayers.KIND_ILLUSTRATION);
+        } catch (PackageManager.NameNotFoundException | Resources.NotFoundException e) {
+            return NONE;
+        } catch (RuntimeException | OutOfMemoryError e) {
+            Slog.e(TAG, ai.packageName + ": fitting failed, original kept", e);
+            return NONE;
+        }
+    }
+
+    /** Whether the icon is a legacy one (cheap: the drawable's type, nothing drawn). */
+    boolean isLegacy(String pkg, int iconRes, int userId) {
+        ApplicationInfo ai = appInfo(pkg, userId);
+        if (ai == null || iconRes == 0) return false;
+        Object cached = mResults.get(key(ai, iconRes, LujarchIcons.MODE_FIT));
+        if (cached != null) return cached != NONE;
+        try {
+            Resources res = getContext().getPackageManager().getResourcesForApplication(ai);
+            Drawable d = res.getDrawableForDensity(iconRes, RENDER_DENSITY, null);
+            return d != null && !(d instanceof AdaptiveIconDrawable);
+        } catch (PackageManager.NameNotFoundException | Resources.NotFoundException e) {
+            return false;
+        }
+    }
+
+    private static Bitmap bitmap(int[] argb) {
+        Bitmap b = Bitmap.createBitmap(argb, CANVAS, CANVAS, Bitmap.Config.ARGB_8888);
+        // the layer's intrinsic size is the 108 dp canvas
+        b.setDensity(Math.round(CANVAS * DisplayMetrics.DENSITY_DEFAULT / 108f));
+        return b;
+    }
+
+    private ApplicationInfo appInfo(String pkg, int userId) {
+        long id = Binder.clearCallingIdentity();
+        try {
+            return getContext().getPackageManager().getApplicationInfoAsUser(pkg, 0, userId);
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        } finally {
+            Binder.restoreCallingIdentity(id);
+        }
+    }
+
+    // ------------------------------------------------------------------ the disk cache
+
+    private Object readCache(String key) {
+        File none = new File(mCacheDir, key + ".none");
+        if (none.exists()) return NONE;
+        File bg = new File(mCacheDir, key + ".bg.png");
+        File fg = new File(mCacheDir, key + ".fg.png");
+        if (!bg.exists() || !fg.exists()) return null;
+        File mono = new File(mCacheDir, key + ".mono.png");
+        Bitmap b = decode(bg), f = decode(fg), m = mono.exists() ? decode(mono) : null;
+        if (b == null || f == null) return null;
+        int kind = m != null ? LujarchIconLayers.KIND_LOGO : LujarchIconLayers.KIND_ILLUSTRATION;
+        return new LujarchIconLayers(b, f, m, kind);
+    }
+
+    private static Bitmap decode(File f) {
+        Bitmap b = android.graphics.BitmapFactory.decodeFile(f.getPath());
+        if (b != null) b.setDensity(Math.round(CANVAS * DisplayMetrics.DENSITY_DEFAULT / 108f));
+        return b;
+    }
+
+    private void writeCache(String key, Object r) {
+        try {
+            if (r == NONE) {
+                new File(mCacheDir, key + ".none").createNewFile();
+                return;
+            }
+            LujarchIconLayers l = (LujarchIconLayers) r;
+            write(new File(mCacheDir, key + ".bg.png"), l.background);
+            write(new File(mCacheDir, key + ".fg.png"), l.foreground);
+            if (l.monochrome != null) write(new File(mCacheDir, key + ".mono.png"), l.monochrome);
+        } catch (Exception e) {
+            Slog.w(TAG, "Cannot cache " + key, e);
+        }
+    }
+
+    private static void write(File f, Bitmap b) throws Exception {
+        try (FileOutputStream out = new FileOutputStream(f)) {
+            b.compress(Bitmap.CompressFormat.PNG, 100, out);
+        }
+    }
+
+    /** Drops a removed app's entries and the owner's choice for it, as Android drops its other
+     * choices for an app with the app. */
+    private void forget(String pkg) {
+        File[] files = mCacheDir.listFiles((d, n) -> n.startsWith(pkg + "@"));
+        if (files != null) for (File f : files) f.delete();
+        mResults.evictAll();
+        boolean chosen;
+        synchronized (mLock) {
+            chosen = mModes.remove(pkg) != null;
+        }
+        if (chosen) {
+            Slog.i(TAG, pkg + ": removed, its icon choice with it");
+            writeState();
+        }
+    }
+
+    /** Drops entries of versions no longer installed and of older algorithm versions. */
+    private void trimCache() {
+        File[] files = mCacheDir.listFiles();
+        if (files == null) return;
+        PackageManager pm = getContext().getPackageManager();
+        for (File f : files) {
+            String[] p = f.getName().split("@");
+            boolean keep = false;
+            if (p.length >= 6 && p[5].startsWith(String.valueOf(ALGO_VERSION) + ".")) {
+                try {
+                    ApplicationInfo ai = pm.getApplicationInfo(p[0], 0);
+                    keep = String.valueOf(ai.longVersionCode).equals(p[1]);
+                } catch (PackageManager.NameNotFoundException e) {
+                    keep = false;
+                }
+            }
+            if (!keep) f.delete();
+        }
+    }
+
+    // ------------------------------------------------------------------ the owner's choices
+
+    private void readSwitch() {
+        boolean enabled = Settings.Global.getInt(getContext().getContentResolver(),
+                LujarchIcons.SETTING_FIT, 1) != 0;
+        synchronized (mLock) {
+            if (enabled == mEnabled) return;
+            mEnabled = enabled;
+        }
+        Slog.i(TAG, "fitted icons " + (enabled ? "on" : "off"));
+        changed();
+    }
+
+    private void changed() {
+        synchronized (mLock) {
+            mGeneration++;
+        }
+        mResults.evictAll();
+        writeState();
+        Intent i = new Intent(LujarchIcons.ACTION_ICONS_CHANGED)
+                .addFlags(Intent.FLAG_RECEIVER_REGISTERED_ONLY);
+        long id = Binder.clearCallingIdentity();
+        try {
+            getContext().sendBroadcastAsUser(i, UserHandle.ALL);
+        } finally {
+            Binder.restoreCallingIdentity(id);
+        }
+    }
+
+    private void readState() {
+        if (!mStateFile.getBaseFile().exists()) return;
+        try (FileInputStream in = mStateFile.openRead()) {
+            TypedXmlPullParser p = Xml.resolvePullParser(in);
+            int type;
+            while ((type = p.next()) != XmlPullParser.END_DOCUMENT) {
+                if (type != XmlPullParser.START_TAG) continue;
+                if ("app".equals(p.getName())) {
+                    mModes.put(p.getAttributeValue(null, "package"),
+                            p.getAttributeInt(null, "mode", LujarchIcons.MODE_DEFAULT));
+                }
+            }
+        } catch (Exception e) {
+            Slog.e(TAG, "Unreadable state, every icon follows the default", e);
+            mModes.clear();
+        }
+    }
+
+    private void writeState() {
+        FileOutputStream out = null;
+        try {
+            out = mStateFile.startWrite();
+            TypedXmlSerializer s = Xml.resolveSerializer(out);
+            s.startDocument(null, true);
+            s.startTag(null, "icons");
+            synchronized (mLock) {
+                for (Map.Entry<String, Integer> e : mModes.entrySet()) {
+                    s.startTag(null, "app");
+                    s.attribute(null, "package", e.getKey());
+                    s.attributeInt(null, "mode", e.getValue());
+                    s.endTag(null, "app");
+                }
+            }
+            s.endTag(null, "icons");
+            s.endDocument();
+            mStateFile.finishWrite(out);
+        } catch (Exception e) {
+            Slog.e(TAG, "Cannot save the fitted icons' state", e);
+            if (out != null) mStateFile.failWrite(out);
+        }
+    }
+
+    // ------------------------------------------------------------------ binder
+
+    private final class BinderService extends ILujarchIconService.Stub {
+        @Override
+        public long getToken(String packageName, int iconRes, int userId) {
+            long id = Binder.clearCallingIdentity();
+            try {
+                return token(packageName, iconRes, userId);
+            } finally {
+                Binder.restoreCallingIdentity(id);
+            }
+        }
+
+        @Override
+        public LujarchIconLayers getLayers(String packageName, int iconRes, int userId) {
+            long id = Binder.clearCallingIdentity();
+            try {
+                return layers(packageName, iconRes, userId, effectiveMode(packageName));
+            } finally {
+                Binder.restoreCallingIdentity(id);
+            }
+        }
+
+        @Override
+        public LujarchIconLayers getPreview(String packageName, int iconRes, int userId,
+                int mode) {
+            long id = Binder.clearCallingIdentity();
+            try {
+                return layers(packageName, iconRes, userId, mode);
+            } finally {
+                Binder.restoreCallingIdentity(id);
+            }
+        }
+
+        @Override
+        public boolean isFittable(String packageName, int iconRes, int userId) {
+            long id = Binder.clearCallingIdentity();
+            try {
+                return isLegacy(packageName, iconRes, userId);
+            } finally {
+                Binder.restoreCallingIdentity(id);
+            }
+        }
+
+        @Override
+        public int getMode(String packageName) {
+            synchronized (mLock) {
+                Integer m = mModes.get(packageName);
+                return m == null ? LujarchIcons.MODE_DEFAULT : m;
+            }
+        }
+
+        @Override
+        public void setMode(String packageName, int mode) {
+            getContext().enforceCallingOrSelfPermission(
+                    Manifest.permission.WRITE_SECURE_SETTINGS, TAG);
+            synchronized (mLock) {
+                if (mode == LujarchIcons.MODE_DEFAULT) {
+                    mModes.remove(packageName);
+                } else {
+                    mModes.put(packageName, mode);
+                }
+            }
+            Slog.i(TAG, packageName + ": mode " + mode);
+            changed();
+        }
+    }
+}
