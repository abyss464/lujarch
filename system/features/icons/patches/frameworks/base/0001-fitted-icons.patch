+    private final Object mLock = new Object();
+    private final File mDir = new File(Environment.getDataSystemDirectory(), "lujarch_icons");
+    private final File mCacheDir = new File(mDir, "cache");
+    private final AtomicFile mStateFile = new AtomicFile(new File(mDir, "state.xml"));
+    private final Map<String, Integer> mModes = new ArrayMap<>();
+    // Settings.Global lujarch_icons_fit, read when the system services are ready
+    private boolean mEnabled = true;
+    private int mGeneration;
