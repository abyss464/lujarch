+package com.android.settings.lujarch;
+
+import android.content.Context;
+import android.os.SystemProperties;
+import android.provider.Settings;
+import android.util.Log;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Settings > Battery > Lowest CPU frequency when idle (CPU-1): the switch lujarch_cpu_idle_floor,
+ * on devices whose build writes the floor (ro.lujarch.cpu.idle_floor).
+ */
+public class LujarchCpuIdleFloorController extends TogglePreferenceController {
+    private static final String TAG = "LujarchCpuIdleFloor";
+    private static final String SETTING = "lujarch_cpu_idle_floor";
+    private static final String SUPPORTED = "ro.lujarch.cpu.idle_floor";
+
+    public LujarchCpuIdleFloorController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SystemProperties.getBoolean(SUPPORTED, false) ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Global.getInt(mContext.getContentResolver(), SETTING, 1) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        if (!Settings.Global.putInt(mContext.getContentResolver(), SETTING, isChecked ? 1 : 0)) {
+            Log.e(TAG, "cannot write " + SETTING);
+            return false;
+        }
+        return true;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_battery;
+    }
+
+    @Override
+    public boolean isSliceable() {
+        return false;
+    }
+}
