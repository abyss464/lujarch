+package com.android.systemui.statusbar.phone;
+
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.SystemClock;
+import android.util.Log;
+
+import org.lujarch.proxy.IProxy;
+import org.lujarch.proxy.IProxyListener;
+
+import java.util.function.Consumer;
+
+/** The proxy's state from lujarch_proxy, for its status bar icon (PRX-19). */
+final class LujarchProxyIcon {
+    private static final String TAG = "lujarch_proxy";
+    private static final String SERVICE = "lujarch_proxy";
+
+    private static final long RETRY_MS = 1000;
+
+    // The binder the icon follows. Held, and read by its death notice, so that the notice, which
+    // starts the next watch when the service starts again, stays registered: a binder no one
+    // holds is collected with it, and a field that is only written is optimized away.
+    private static volatile IBinder sService;
+
+    private LujarchProxyIcon() {}
+
+    /** Tells listener, on handler, every state of the proxy; "" while the service is gone. */
+    static void watch(Handler handler, Consumer<String> listener) {
+        Thread thread = new Thread(() -> connect(handler, listener), "lujarch_proxy_icon");
+        thread.setDaemon(true);
+        thread.start();
+    }
+
+    private static void connect(Handler handler, Consumer<String> listener) {
+        while (true) {
+            IBinder binder = ServiceManager.waitForService(SERVICE);
+            if (binder == null) {
+                Log.e(TAG, SERVICE + " is not there; the status bar shows no proxy icon");
+                return;
+            }
+            sService = binder;
+            try {
+                binder.linkToDeath(() -> {
+                    if (sService != binder) return;
+                    sService = null;
+                    handler.post(() -> listener.accept(""));
+                    watch(handler, listener);
+                }, 0);
+            } catch (RemoteException e) {
+                // The service ended after it was looked up: its next start is waited for.
+                SystemClock.sleep(RETRY_MS);
+                continue;
+            }
+            try {
+                IProxy.Stub.asInterface(binder).watch(new IProxyListener.Stub() {
+                    @Override
+                    public void onState(String state) {
+                        handler.post(() -> listener.accept(state));
+                    }
+                });
+            } catch (RemoteException e) {
+                // Its death notice starts the next watch.
+                Log.w(TAG, "cannot follow the proxy's state", e);
+            }
+            return;
+        }
+    }
+
+    /** The icon shows while the proxy runs, and while it is on but not running. */
+    static boolean running(String state) {
+        return IProxy.STATE_RUNNING.equals(state) || IProxy.STATE_FALLBACK.equals(state);
+    }
+
+    static boolean failing(String state) {
+        return IProxy.STATE_NO_CONFIG.equals(state) || IProxy.STATE_CRASH_LOOP.equals(state);
+    }
+}
