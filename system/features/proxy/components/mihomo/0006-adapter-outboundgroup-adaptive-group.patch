+package outboundgroup
+
+// The adaptive group: for each new connection it uses the
+// member with the lowest expected time to a working connection on the network
+// the phone is on, learned from the connections that go through it, races a
+// second member when that is expected to pay, and keeps separate statistics
+// per network. adaptive_model.go has the model, adaptive_conn.go the racing
+// connection.
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net"
+	"net/netip"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/common/utils"
+	"github.com/metacubex/mihomo/component/dialer"
+	"github.com/metacubex/mihomo/component/iface"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+	"github.com/metacubex/mihomo/log"
+)
