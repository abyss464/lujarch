diff --git a/listener/sing_tun/owner_lujarch.go b/listener/sing_tun/owner_lujarch.go
new file mode 100644
index 0000000000000000000000000000000000000000..197410b7dc2e50f9a9c8b8cd63b045ac42c9b2c7
--- /dev/null
+++ b/listener/sing_tun/owner_lujarch.go
@@ -0,0 +1,50 @@
+package sing_tun
+
+// the name of a connection's owner on Android, for PROCESS-NAME rules.
+//
+// The owner is a uid (component/process). Android tells apart only uids, so the
+// name follows the uid: a uid that belongs to one package is named by that
+// package, also when the package declares a shared user (android:sharedUserId,
+// e.g. Firefox's org.mozilla.firefox.sharedID), so a route written for the app
+// by its package matches. A uid that several packages share (Google Play
+// services and its companions under com.google.uid.shared, android.uid.system)
+// is named by the shared user: its traffic is theirs together, and one route by
+// the shared user's name applies to all of them. The shared user's name stays a
+// second name of a uid named by its only package (ownerAlias), so a rule on the
+// shared user matches whichever name the uid has at the moment, however many of
+// its packages are installed.
+
+// packageLookup is the part of sing-tun's package manager (packages.xml) the
+// names come from.
+type packageLookup interface {
+	PackagesByID(id uint32) ([]string, bool)
+	SharedPackageByID(id uint32) (string, bool)
+}
+
+// ownerName is the name of uid's owner: its package when it has one, else its
+// shared user.
+func ownerName(pm packageLookup, uid uint32) (string, bool) {
+	id := uid % 100000
+	packages, _ := pm.PackagesByID(id)
+	if len(packages) == 1 {
+		return packages[0], true
+	}
+	if shared, loaded := pm.SharedPackageByID(id); loaded {
+		return shared, true
+	}
+	if len(packages) > 0 {
+		return packages[0], true
+	}
+	return "", false
+}
+
+// ownerAlias is the other name PROCESS-NAME rules match for uid: the shared user
+// of a uid that ownerName names by its only package; "" otherwise.
+func ownerAlias(pm packageLookup, uid uint32) string {
+	id := uid % 100000
+	if packages, _ := pm.PackagesByID(id); len(packages) != 1 {
+		return ""
+	}
+	shared, _ := pm.SharedPackageByID(id)
+	return shared
+}
