+// DefaultOwnerAliasResolver gives the second name of a connection's
+// owner that PROCESS-NAME rules match, "" for none. On Android: the shared user
+// of a uid that is named by its only package (listener/sing_tun), so a rule on
+// the shared user keeps matching that app.
+var DefaultOwnerAliasResolver func(metadata *C.Metadata) string
