+// subscribeRules makes ip rule changes trigger the default interface check.
+// Android switches its default network (Wi-Fi comes up while mobile data stays
+// connected, or the reverse) by rewriting the "fwmark 0x0/0xffff" rules that
+// the Android checkUpdate reads, while the routes and links of both networks
+// stay as they are; with route and link events alone the monitor keeps the
+// previous interface, and every outbound socket stays bound to it.
+func (m *networkUpdateMonitor) subscribeRules() error {
+	s, err := nl.Subscribe(unix.NETLINK_ROUTE, unix.RTNLGRP_IPV4_RULE, unix.RTNLGRP_IPV6_RULE)
+	if err != nil {
+		return err
+	}
+	go func() {
+		<-m.close
+		s.Close()
+	}()
+	go func() {
+		for {
+			msgs, _, err := s.Receive()
+			if err == unix.ENOBUFS {
+				// messages were lost (a network switch rewrites many rules at once): check anyway
+				m.signalRuleUpdate()
+				continue
+			}
+			if err != nil {
+				select {
+				case <-m.close:
+				default:
+					m.logger.Error("default interface monitor: receive ip rule changes: ", err)
+				}
+				return
+			}
+			for _, msg := range msgs {
+				if msg.Header.Type == unix.RTM_NEWRULE || msg.Header.Type == unix.RTM_DELRULE {
+					m.signalRuleUpdate()
+					break
+				}
+			}
+		}
+	}()
+	return nil
+}
+
+func (m *networkUpdateMonitor) signalRuleUpdate() {
+	select {
+	case m.ruleUpdate <- struct{}{}:
+	default:
+	}
+}
