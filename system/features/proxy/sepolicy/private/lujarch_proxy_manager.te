# lujarch_proxy_manager: the proxy's manager, run by lujarch_proxy for Lujarch Settings. It needs
# the network (subscriptions, the controller), the proxy's data and the core for its checks.
type lujarch_proxy_manager, domain, coredomain;
type lujarch_proxy_manager_exec, system_file_type, exec_type, file_type;
net_domain(lujarch_proxy_manager)

# stdout and stderr are the daemon's pipe, or the pipe of an export; stdin is /dev/null or the pipe
# of Lujarch Settings with an address or a file (ioctl: terminal checks).
allow lujarch_proxy_manager lujarch_proxy:fd use;
allow lujarch_proxy_manager lujarch_proxy:fifo_file { getattr ioctl read write };
allow lujarch_proxy_manager platform_app_all:fd use;
allow lujarch_proxy_manager platform_app_all:fifo_file { getattr ioctl read write };

# The proxy's data.
allow lujarch_proxy_manager system_data_file:dir search;
allow lujarch_proxy_manager lujarch_proxy_data_file:dir create_dir_perms;
allow lujarch_proxy_manager lujarch_proxy_data_file:file create_file_perms;

# The core's check of a configuration and the locating probe's second core, in this domain.
allow lujarch_proxy_manager lujarch_proxy_core_exec:file rx_file_perms;
allow lujarch_proxy_manager proc_net:file r_file_perms;
allow lujarch_proxy_manager proc_stat:file r_file_perms;
allow lujarch_proxy_manager self:tcp_socket { create_stream_socket_perms listen accept };
allow lujarch_proxy_manager self:udp_socket create_socket_perms;

# The proxy's switch and state (getprop from toolbox, which coredomain may run).
get_prop(lujarch_proxy_manager, lujarch_setting_prop)
get_prop(lujarch_proxy_manager, lujarch_proxy_prop)
