<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lujarch.root.settings">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application>
        <meta-data
            android:name="org.lujarch.settings.contribution.root"
            android:value="org.lujarch.root.settings.RootContribution" />

        <!-- Root access in Special app access, and one app's root from its App info row. -->
        <activity
            android:name="org.lujarch.root.settings.RootActivity"
            android:exported="true"
            android:label="@string/root_title"
            android:theme="@style/Theme.LujarchSettings">
            <intent-filter>
                <action android:name="org.lujarch.root.action.ROOT" />
                <action android:name="org.lujarch.root.action.APP_ROOT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.special_app_access" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="lujarch_root" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/root_title" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-120" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>
    </application>
</manifest>
