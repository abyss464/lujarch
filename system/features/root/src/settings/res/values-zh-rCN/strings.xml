    <string name="root_auth_title">身份验证</string>
    <string name="root_auth_unavailable_message">设置屏幕锁定后，Root 权限会要求验证；也可以仅凭刚才的确认继续。</string>
    <string name="root_auth_unavailable_no_lock">此手机未设置屏幕锁定，无法验证身份。点按即可设置。</string>
