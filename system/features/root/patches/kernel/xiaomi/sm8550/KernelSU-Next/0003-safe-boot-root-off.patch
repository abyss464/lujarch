+++ b/kernel/policy/allowlist.h
@@ -60,4 +60,12 @@ static inline bool is_isolated_process(uid_t uid)
 }
 extern bool allow_shell;
 
+// Lujarch safe boot (UPD-5): the recovery
+// menu writes /metadata/lujarch/safe-boot; a line "root=off" there keeps
+// the allowlist unloaded at post-fs-data, so no uid gets su for the rest of
+// the boot (the manager and adb shell included), and nothing writes the
+// allowlist file, which stays as stored for the next normal boot.
+extern bool ksu_lujarch_root_off;
+bool ksu_lujarch_read_root_off(void);
+
 #endif
