 #include <linux/compiler_types.h>
 #include <linux/hashtable.h>
@@ -69,6 +70,13 @@ static u16 allow_list_count = 0;
 
 #define KERNEL_SU_ALLOWLIST "/data/adb/ksu/.allowlist"
 
+// Lujarch safe boot (allowlist.h).
+#define LUJARCH_SAFE_BOOT_FILE "/metadata/lujarch/safe-boot"
+// The size every reader of the file honours (the recovery writes less).
+#define LUJARCH_SAFE_BOOT_MAX 4096
+
+bool ksu_lujarch_root_off __read_mostly = false;
+
 void ksu_persistent_allow_list(void);
 
 void ksu_show_allow_list(void)
@@ -258,6 +266,11 @@ bool __ksu_is_allow_uid(uid_t uid)
 {
 	struct perm_data *p;
 
+	if (unlikely(ksu_lujarch_root_off)) {
+		// Lujarch safe boot: no uid, not even the manager's.
+		return false;
+	}
+
 	if (forbid_system_uid(uid)) {
 		// do not bother going through the list if it's system
 		return false;
@@ -459,6 +472,13 @@ void ksu_persistent_allow_list()
 {
 	struct task_struct *tsk;
 
+	if (unlikely(ksu_lujarch_root_off)) {
+		// The list in memory is empty on purpose: writing it would
+		// delete every stored profile.
+		pr_info("lujarch safe boot: allowlist not saved\n");
+		return;
+	}
+
 	rcu_read_lock();
 	tsk = get_pid_task(find_vpid(1), PIDTYPE_PID);
 	if (!tsk) {
@@ -580,6 +600,58 @@ exit:
 	filp_close(fp, 0);
 }
 
+bool ksu_lujarch_read_root_off(void)
+{
+	const struct cred *saved = NULL;
+	struct file *fp;
+	char *buf, *cursor, *line;
+	loff_t off = 0;
+	ssize_t len;
+	bool root_off = false;
+
+	buf = kzalloc(LUJARCH_SAFE_BOOT_MAX + 1, GFP_KERNEL);
+	if (!buf) {
+		pr_err("lujarch safe boot: no memory to read %s\n", LUJARCH_SAFE_BOOT_FILE);
+		return false;
+	}
+
+	// Read as KernelSU itself, whichever process reached post-fs-data
+	// first (ksud or init starting zygote).
+	if (ksu_cred)
+		saved = override_creds(ksu_cred);
+	fp = filp_open(LUJARCH_SAFE_BOOT_FILE, O_RDONLY | O_NOFOLLOW, 0);
+	if (IS_ERR(fp)) {
+		// No file: the normal boot.
+		if (PTR_ERR(fp) != -ENOENT)
+			pr_err("lujarch safe boot: cannot open %s: %ld\n", LUJARCH_SAFE_BOOT_FILE, PTR_ERR(fp));
+		goto out;
+	}
+	len = kernel_read(fp, buf, LUJARCH_SAFE_BOOT_MAX, &off);
+	filp_close(fp, NULL);
+	if (len < 0) {
+		pr_err("lujarch safe boot: cannot read %s: %zd\n", LUJARCH_SAFE_BOOT_FILE, len);
+		goto out;
+	}
+	buf[len] = '\0';
+
+	// One "<name>=off" per line; only "root=off" concerns the kernel.
+	cursor = buf;
+	while ((line = strsep(&cursor, "\n")) != NULL) {
+		size_t n = strlen(line);
+
+		if (n > 0 && line[n - 1] == '\r')
+			line[n - 1] = '\0';
+		if (strcmp(line, "root=off") == 0)
+			root_off = true;
+	}
+
+out:
+	if (saved)
+		revert_creds(saved);
+	kfree(buf);
+	return root_off;
+}
+
 void ksu_prune_allowlist(bool (*is_uid_valid)(uid_t, char *, void *),
 				void *data)
 {
