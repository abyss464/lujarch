--- a/kernel/runtime/boot_event.c
+++ b/kernel/runtime/boot_event.c
@@ -28,7 +28,14 @@ void on_post_fs_data(void)
     done = true;
     pr_info("on_post_fs_data!\n");
 
-    ksu_load_allow_list();
+    if (ksu_lujarch_read_root_off()) {
+        // Lujarch safe boot (policy/allowlist.h): set before anything can
+        // ask, since apps start only after post-fs-data.
+        ksu_lujarch_root_off = true;
+        pr_warn("lujarch safe boot: root=off, the allowlist is not loaded and no uid gets su this boot\n");
+    } else {
+        ksu_load_allow_list();
+    }
     ksu_observer_init();
     // Sanity check for safe mode only needs early-boot input samples.
     ksu_stop_input_hook_runtime();
