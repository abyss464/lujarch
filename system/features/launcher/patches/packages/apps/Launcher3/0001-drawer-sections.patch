diff --git a/res/layout/lujarch_drawer_section_header.xml b/res/layout/lujarch_drawer_section_header.xml
new file mode 100644
index 0000000000000000000000000000000000000000..7f8ddc4be6f47c4bf49d12936366ba8720fbd7bd
--- /dev/null
+++ b/res/layout/lujarch_drawer_section_header.xml
@@ -0,0 +1,51 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Lujarch (LCH-1): the divider of a drawer section. A hairline across the list; the
+     section's name before it when the owner gave one; a faint chevron after it while the
+     section is folded. Nothing else. Tap: fold or unfold; long press: the section's actions.
+-->
+<LinearLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="@dimen/lujarch_drawer_divider_height"
+    android:paddingStart="@dimen/ps_header_layout_margin"
+    android:paddingEnd="@dimen/ps_header_layout_margin"
+    android:background="@android:color/transparent"
+    android:gravity="center_vertical"
+    android:orientation="horizontal"
+    android:clickable="true"
+    android:focusable="true"
+    android:importantForAccessibility="yes">
+
+    <TextView
+        android:id="@+id/lujarch_section_title"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginEnd="@dimen/lujarch_drawer_divider_text_gap"
+        android:maxLines="1"
+        android:ellipsize="end"
+        android:textDirection="locale"
+        android:textSize="12sp"
+        android:letterSpacing="0.06"
+        android:fontFamily="variable-label-medium"
+        android:textColor="@color/materialColorOnSurfaceVariant"
+        android:importantForAccessibility="no" />
+
+    <View
+        android:id="@+id/lujarch_section_line"
+        android:layout_width="0dp"
+        android:layout_height="@dimen/lujarch_drawer_divider_line"
+        android:layout_weight="1"
+        android:background="@color/materialColorOutlineVariant" />
+
+    <ImageView
+        android:id="@+id/lujarch_section_chevron"
+        android:layout_width="@dimen/lujarch_drawer_divider_chevron"
+        android:layout_height="@dimen/lujarch_drawer_divider_chevron"
+        android:layout_marginStart="@dimen/lujarch_drawer_divider_text_gap"
+        android:src="@drawable/ic_expand_more"
+        android:alpha="0.5"
+        app:tint="@color/materialColorOnSurfaceVariant"
+        android:importantForAccessibility="no" />
+</LinearLayout>
