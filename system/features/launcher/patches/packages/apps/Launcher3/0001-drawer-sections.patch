diff --git a/src/com/android/launcher3/lujarch/DrawerDropIndicator.java b/src/com/android/launcher3/lujarch/DrawerDropIndicator.java
new file mode 100644
index 0000000000000000000000000000000000000000..f8176eaef68421c0d2869b74c52a635da9ef6f4f
--- /dev/null
+++ b/src/com/android/launcher3/lujarch/DrawerDropIndicator.java
@@ -0,0 +1,121 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.launcher3.lujarch;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.view.View;
+
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.android.launcher3.DeviceProfile;
+import com.android.launcher3.R;
+import com.android.launcher3.allapps.AlphabeticalAppsList;
+import com.android.launcher3.allapps.BaseAllAppsAdapter.AdapterItem;
+import com.android.launcher3.views.ActivityContext;
+
+import java.util.List;
+
+/**
+ * While an app is dragged in the drawer, the divider of the section it would go into is
+ * drawn in the accent colour; below the last row, where a new section would start, a line in
+ * the accent colour shows the new divider. Nothing is shown for the main list.
+ */
+public class DrawerDropIndicator extends RecyclerView.ItemDecoration {
+    private final AlphabeticalAppsList mApps;
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final int mInset;
+    private final int mGap;
+    private final Context mContext;
+
+    public DrawerDropIndicator(Context context, AlphabeticalAppsList apps) {
+        mContext = context;
+        mApps = apps;
+        mPaint.setColor(context.getColor(R.color.materialColorPrimary));
+        mPaint.setStrokeWidth(context.getResources().getDimension(
+                R.dimen.lujarch_drawer_divider_drop_width));
+        mPaint.setStrokeCap(Paint.Cap.ROUND);
+        mInset = context.getResources().getDimensionPixelSize(R.dimen.ps_header_layout_margin);
+        mGap = context.getResources().getDimensionPixelSize(R.dimen.lujarch_drawer_divider_height);
+    }
+
+    /**
+     * While an app is dragged in the list, its end opens a slot to drop into a new section: the
+     * space a new section takes for its divider and one row, so the drop lands where the
+     * accent line showed.
+     */
+    @Override
+    public void getItemOffsets(Rect outRect, View view, RecyclerView parent,
+            RecyclerView.State state) {
+        int pos = parent.getChildAdapterPosition(view);
+        if (pos >= 0 && pos == state.getItemCount() - 1 && DrawerSectionDrag.dragging(parent)) {
+            outRect.bottom = newSectionHeight(parent, pos);
+        }
+    }
+
+    /**
+     * The height a new section takes: its divider and one app row, as the list lays them out
+     * (margins and decoration insets included), taken from a laid-out row of each kind; the
+     * configured sizes where the list shows none.
+     */
+    private int newSectionHeight(RecyclerView parent, int last) {
+        DeviceProfile dp = ActivityContext.lookupContext(mContext).getDeviceProfile();
+        int divider = mGap;
+        int row = dp.getAllAppsProfile().getCellHeightPx();
+        boolean sawDivider = false;
+        boolean sawRow = false;
+        List<AdapterItem> items = mApps.getAdapterItems();
+        RecyclerView.LayoutManager lm = parent.getLayoutManager();
+        for (int i = 0; lm != null && i < parent.getChildCount() && !(sawDivider && sawRow); i++) {
+            View child = parent.getChildAt(i);
+            int pos = parent.getChildAdapterPosition(child);
+            // Not the last row: its own height holds the slot being sized.
+            if (pos < 0 || pos >= last || pos >= items.size()) continue;
+            AdapterItem item = items.get(pos);
+            RecyclerView.LayoutParams lp = (RecyclerView.LayoutParams) child.getLayoutParams();
+            int h = lm.getDecoratedMeasuredHeight(child) + lp.topMargin + lp.bottomMargin;
+            if (item instanceof DrawerSectionHeaderItem && !sawDivider) {
+                divider = h;
+                sawDivider = true;
+            } else if (item.itemInfo != null && item.decorationInfo == null && !sawRow) {
+                row = h;
+                sawRow = true;
+            }
+        }
+        return divider + row;
+    }
+
+    @Override
+    public void onDrawOver(Canvas c, RecyclerView parent, RecyclerView.State state) {
+        int target = DrawerSectionDrag.activeTarget(parent);
+        if (target == DrawerSectionDrag.TARGET_NONE || target == DrawerSectionDrag.TARGET_MAIN) {
+            return;
+        }
+        List<AdapterItem> items = mApps.getAdapterItems();
+        float left = parent.getPaddingLeft() + mInset;
+        float right = parent.getWidth() - parent.getPaddingRight() - mInset;
+        int lastBottom = Integer.MIN_VALUE;
+        for (int i = 0; i < parent.getChildCount(); i++) {
+            View child = parent.getChildAt(i);
+            int pos = parent.getChildAdapterPosition(child);
+            if (pos < 0 || pos >= items.size()) continue;
+            AdapterItem item = items.get(pos);
+            if (item.itemInfo != null || item instanceof DrawerSectionHeaderItem) {
+                lastBottom = Math.max(lastBottom, child.getBottom());
+            }
+            if (target >= 0 && item instanceof DrawerSectionHeaderItem h && h.sectionId == target) {
+                float y = (child.getTop() + child.getBottom()) / 2f;
+                c.drawLine(left, y, right, y, mPaint);
+                return;
+            }
+        }
+        if (target == DrawerSectionDrag.TARGET_NEW && lastBottom != Integer.MIN_VALUE) {
+            float y = lastBottom + mGap / 2f;
+            c.drawLine(left, y, right, y, mPaint);
+        }
+    }
+}
diff --git a/src/com/android/launcher3/lujarch/DrawerSectionAnimations.java b/src/com/android/launcher3/lujarch/DrawerSectionAnimations.java
new file mode 100644
index 0000000000000000000000000000000000000000..219cc68c4a94af93865396415f2db9a03c49ede8
--- /dev/null
+++ b/src/com/android/launcher3/lujarch/DrawerSectionAnimations.java
@@ -0,0 +1,68 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.launcher3.lujarch;
+
+import androidx.recyclerview.widget.DefaultItemAnimator;
+import androidx.recyclerview.widget.RecyclerView;
+
+/**
+ * Motion for drawer section changes (LCH-1), in the native language: RecyclerView's own item
+ * animator, with its own durations, for the one list update a section change causes (an app
+ * moved, a section folded or unfolded, a divider added or gone): rows fade out and in, the rest
+ * slide to their places. The drawer list runs without an
+ * item animator otherwise (ActivityAllAppsContainerView), so installs and updates stay as
+ * they were.
+ */
+public final class DrawerSectionAnimations {
+    // True while the list update a section change causes is being computed: only the places
+    // of the app rows change then, not what they show.
+    private static boolean sSectionUpdate;
+
+    private DrawerSectionAnimations() {}
+
+    /**
+     * Whether the list update being computed is a section change. The app rows then keep their
+     * content (AdapterItem.isContentSame), so the rows that only shift are not rebound.
+     */
+    public static boolean isSectionUpdate() {
+        return sSectionUpdate;
+    }
+
+    /** Animates the next update of the list; call right before the update is dispatched. */
+    public static void animateNextUpdate(RecyclerView rv) {
+        if (rv != null) {
+            // The update is computed synchronously after this call; the flag ends with it.
+            sSectionUpdate = true;
+            rv.post(() -> sSectionUpdate = false);
+        }
+        attachAnimator(rv);
+    }
+
+    /**
+     * Animates the next layout of the list when it changes places without an adapter change (the
+     * slot below the last row closing): attaches the animator and asks the layout manager for
+     * simple animations, which RecyclerView otherwise runs only after an adapter change. Call
+     * before the layout is requested.
+     */
+    public static void animateNextLayout(RecyclerView rv) {
+        if (rv == null || !rv.isAttachedToWindow()) return;
+        attachAnimator(rv);
+        RecyclerView.LayoutManager lm = rv.getLayoutManager();
+        if (lm != null) lm.requestSimpleAnimationsInNextLayout();
+    }
+
+    private static void attachAnimator(RecyclerView rv) {
+        if (rv == null || !rv.isAttachedToWindow() || rv.getItemAnimator() != null) return;
+        DefaultItemAnimator animator = new DefaultItemAnimator();
+        // A rebound row keeps its place; a crossfade of the same icon would only flicker.
+        animator.setSupportsChangeAnimations(false);
+        rv.setItemAnimator(animator);
+        long settle = animator.getRemoveDuration() + animator.getMoveDuration()
+                + animator.getAddDuration();
+        rv.postDelayed(() -> animator.isRunning(() -> {
+            if (rv.getItemAnimator() == animator) rv.setItemAnimator(null);
+        }), settle);
+    }
+}
diff --git a/src/com/android/launcher3/lujarch/DrawerSectionDrag.java b/src/com/android/launcher3/lujarch/DrawerSectionDrag.java
new file mode 100644
index 0000000000000000000000000000000000000000..c048b6e5352ad0083eb72d254d4d22dd15b7a31d
--- /dev/null
+++ b/src/com/android/launcher3/lujarch/DrawerSectionDrag.java
@@ -0,0 +1,391 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.launcher3.lujarch;
+
+import static com.android.launcher3.LauncherSettings.Favorites.CONTAINER_ALL_APPS;
+import static com.android.launcher3.LauncherState.ALL_APPS;
+import static com.android.launcher3.LauncherState.SPRING_LOADED;
+
+import android.graphics.Rect;
+import android.view.View;
+import android.view.ViewTreeObserver;
+
+import androidx.annotation.Nullable;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.android.launcher3.BubbleTextView;
+import com.android.launcher3.DropTarget;
+import com.android.launcher3.Launcher;
+import com.android.launcher3.allapps.AllAppsRecyclerView;
+import com.android.launcher3.allapps.AlphabeticalAppsList;
+import com.android.launcher3.allapps.BaseAllAppsAdapter.AdapterItem;
+import com.android.launcher3.dragndrop.DragController;
+import com.android.launcher3.dragndrop.DragLayer;
+import com.android.launcher3.dragndrop.DragOptions;
+import com.android.launcher3.dragndrop.DragView;
+import com.android.launcher3.model.data.ItemInfo;
+import com.android.launcher3.pm.UserCache;
+
+import java.util.List;
+
+/**
+ * Long-press and drag inside the app drawer moves an app between drawer sections: over a
+ * section (its divider or its apps) it goes into that section, over the main list back to it,
+ * below everything into a new, unnamed section. The drawer stays open while the finger is over
+ * the list; dragged above the list (onto the search bar, the top edge) it closes and the drag
+ * carries on as Launcher3's own drag to the home screen.
+ *
+ * Highest-priority drop target (added after the drop target bar), enabled only for a drag
+ * that started in the drawer, so every other drag is untouched.
+ */
+public class DrawerSectionDrag implements DropTarget, DragController.DragListener {
+    /** Drop targets besides a section id. */
+    public static final int TARGET_NONE = Integer.MIN_VALUE;
+    public static final int TARGET_MAIN = -1;
+    public static final int TARGET_NEW = -2;
+
+    private static final float SCROLL_ZONE = 0.12f;
+    private static final int SCROLL_STEP_DP = 14;
+
+    @Nullable
+    private static DrawerSectionDrag sActive;
+    // The key of the app being dragged: its row stays hidden, in whichever view shows it, from
+    // the drag's start until its drag view has settled (or the drag ends). Part of what a row
+    // binds, so a recycled or rebound view never keeps or inherits the hidden state.
+    @Nullable
+    private static String sHiddenKey;
+
+    private final Launcher mLauncher;
+    private boolean mEnabled;
+    // The finger is up and the drop is settling: the drag no longer shows a slot or a target,
+    // while the drag itself (and its deferred end) lasts until the drop animation ends.
+    private boolean mDropped;
+    private int mTarget = TARGET_NONE;
+    @Nullable
+    private AllAppsRecyclerView mRecyclerView;
+    private int mScrollDir;
+    private final Runnable mScroller = this::scrollStep;
+
+    public DrawerSectionDrag(Launcher launcher) {
+        mLauncher = launcher;
+    }
+
+    /**
+     * Whether a drag stays in the drawer: it starts in the drawer (not from search results'
+     * other kinds or a private space app) while the drawer is open. Workspace asks this before
+     * it springs the home screen open.
+     */
+    public static boolean keepsDrawer(Launcher launcher, DragObject d, DragOptions options) {
+        if (options.isAccessibleDrag || !launcher.isInState(ALL_APPS)
+                || d.dragSource != launcher.getAppsView()) {
+            return false;
+        }
+        ItemInfo info = d.dragInfo;
+        if (info == null || info.container != CONTAINER_ALL_APPS
+                || DrawerSections.keyOf(info) == null) {
+            return false;
+        }
+        AllAppsRecyclerView rv = launcher.getAppsView().getActiveRecyclerView();
+        return rv != null && rv.getApps() != null && !launcher.getAppsView().isSearching()
+                && !UserCache.INSTANCE.get(launcher).getUserInfo(info.user).isPrivate();
+    }
+
+    /** Whether an app is being dragged in this list (the end of the list opens a slot). */
+    public static boolean dragging(RecyclerView rv) {
+        DrawerSectionDrag d = sActive;
+        return d != null && d.mEnabled && !d.mDropped && d.mRecyclerView == rv;
+    }
+
+    /** Whether the row of this app stays hidden: it is the app being dragged. */
+    public static boolean hides(@Nullable ItemInfo info) {
+        String hidden = sHiddenKey;
+        return hidden != null && info != null && hidden.equals(DrawerSections.keyOf(info));
+    }
+
+    /** The drop target of the drag in progress, for the indicator; TARGET_NONE when idle. */
+    public static int activeTarget(RecyclerView rv) {
+        DrawerSectionDrag d = sActive;
+        return d != null && d.mEnabled && !d.mDropped && d.mRecyclerView == rv ? d.mTarget
+                : TARGET_NONE;
+    }
+
+    @Override
+    public void onDragStart(DragObject dragObject, DragOptions options) {
+        mEnabled = keepsDrawer(mLauncher, dragObject, options);
+        mDropped = false;
+        mRecyclerView = mEnabled ? mLauncher.getAppsView().getActiveRecyclerView() : null;
+        mTarget = TARGET_NONE;
+        sActive = mEnabled ? this : null;
+        sHiddenKey = mEnabled ? DrawerSections.keyOf(dragObject.dragInfo) : null;
+        if (mRecyclerView != null) mRecyclerView.invalidateItemDecorations();
+    }
+
+    @Override
+    public void onDragEnd() {
+        stopScroll();
+        boolean slotOpen = mEnabled && !mDropped;
+        mEnabled = false;
+        mDropped = false;
+        mTarget = TARGET_NONE;
+        String hidden = sHiddenKey;
+        sHiddenKey = null;
+        if (mRecyclerView != null) {
+            if (hidden != null) {
+                // The app's row shows again wherever it is bound now.
+                for (int i = 0; i < mRecyclerView.getChildCount(); i++) {
+                    View child = mRecyclerView.getChildAt(i);
+                    if (child instanceof BubbleTextView
+                            && child.getTag() instanceof ItemInfo tag
+                            && hidden.equals(DrawerSections.keyOf(tag))) {
+                        child.setVisibility(View.VISIBLE);
+                    }
+                }
+            }
+            // The slot below the list closes with a layout only if it was still open: after a
+            // drop it closed with the update, and another layout pass has nothing to change.
+            if (slotOpen) {
+                DrawerSectionAnimations.animateNextLayout(mRecyclerView);
+                mRecyclerView.invalidateItemDecorations();
+            }
+        }
+        mRecyclerView = null;
+        if (sActive == this) sActive = null;
+    }
+
+    @Override
+    public boolean isDropEnabled() {
+        return mEnabled && mLauncher.isInState(ALL_APPS);
+    }
+
+    @Override
+    public void getHitRectRelativeToDragLayer(Rect outRect) {
+        // The whole drawer; above the list the drag is handed to the home screen (onDragOver).
+        mLauncher.getDragLayer().getDescendantRectRelativeToSelf(mLauncher.getAppsView(), outRect);
+    }
+
+    @Override
+    public View getDropView() {
+        return mRecyclerView;
+    }
+
+    @Override
+    public void onDragEnter(DragObject d) {}
+
+    @Override
+    public void onDragOver(DragObject d) {
+        AllAppsRecyclerView rv = mRecyclerView;
+        if (rv == null) return;
+        if (d.y < 0) {
+            // Above the list: the owner wants the home screen. Hand over to Launcher3's drag.
+            handOff();
+            return;
+        }
+        int zone = (int) (rv.getHeight() * SCROLL_ZONE);
+        int dir = d.y > rv.getHeight() - zone ? 1 : d.y < zone ? -1 : 0;
+        if (dir != mScrollDir) {
+            mScrollDir = dir;
+            rv.removeCallbacks(mScroller);
+            if (dir != 0) rv.postOnAnimation(mScroller);
+        }
+        setTarget(targetAt(rv, d.y));
+    }
+
+    @Override
+    public void onDragExit(DragObject d) {
+        if (!d.dragComplete) {
+            stopScroll();
+            setTarget(TARGET_NONE);
+        }
+    }
+
+    @Override
+    public boolean acceptDrop(DragObject d) {
+        return isDropEnabled();
+    }
+
+    @Override
+    public void onDrop(DragObject d, DragOptions options) {
+        AllAppsRecyclerView rv = mRecyclerView;
+        int target = rv == null ? TARGET_NONE : targetAt(rv, d.y);
+        String key = DrawerSections.keyOf(d.dragInfo);
+        if (key == null || target == TARGET_NONE || rv == null) {
+            d.deferDragViewCleanupPostAnimation = false;
+            return;
+        }
+        // The drop ends the autoscroll (the drag's end, and so onDragExit's stop, waits for the
+        // drop animation) and the slot below the list, in the same layout pass as the section
+        // update: the item animator then slides the gap closed with the rest of the update.
+        // A drop that changes nothing commits no update, so the slot's closing is animated
+        // by itself.
+        stopScroll();
+        mDropped = true;
+        DrawerSectionAnimations.animateNextLayout(rv);
+        rv.invalidateItemDecorations();
+        DrawerSections store = DrawerSections.get(mLauncher);
+        int current = store.sectionOf(key);
+        if (target == TARGET_MAIN) {
+            store.removeFromSection(key);
+        } else if (target == TARGET_NEW) {
+            store.createWith(key);
+        } else if (target != current) {
+            store.moveTo(key, target);
+        }
+        // The drag view settles into the app's new place once the list has laid it out, with
+        // Launcher3's own drop animation; that animation ends the drag.
+        DragView dragView = d.dragView;
+        rv.getViewTreeObserver().addOnPreDrawListener(new ViewTreeObserver.OnPreDrawListener() {
+            @Override
+            public boolean onPreDraw() {
+                rv.getViewTreeObserver().removeOnPreDrawListener(this);
+                settle(rv, dragView, key);
+                return true;
+            }
+        });
+    }
+
+    private void settle(AllAppsRecyclerView rv, DragView dragView, String key) {
+        DragLayer dragLayer = mLauncher.getDragLayer();
+        // By the app's place in the new list: while the list animates, the row it left can
+        // still be a child (fading out) and carry the same app.
+        View icon = null;
+        List<AdapterItem> items = rv.getApps().getAdapterItems();
+        for (int i = 0; i < items.size() && icon == null; i++) {
+            AdapterItem item = items.get(i);
+            if (item.itemInfo != null && key.equals(DrawerSections.keyOf(item.itemInfo))) {
+                RecyclerView.ViewHolder holder = rv.findViewHolderForAdapterPosition(i);
+                icon = holder == null ? null : holder.itemView;
+            }
+        }
+        if (!(icon instanceof BubbleTextView target)) {
+            // Folded away or off screen: the drag view fades where it is.
+            Rect at = new Rect();
+            dragLayer.getViewRectRelativeToSelf(dragView, at);
+            dragLayer.animateViewIntoPosition(dragView, at.left, at.top, 0f, 0.8f, 0.8f, null,
+                    DragLayer.ANIMATION_END_DISAPPEAR, -1, null);
+            return;
+        }
+        // The row may have been laid out below (or above) the visible area (a drop in the part
+        // of the slot under the list's padding), where the icon would settle out of sight: the
+        // list scrolls it in with its own smooth scroll, and the destination below is the row's
+        // place after that scroll.
+        int top = target.getTop();
+        int bottom = target.getBottom();
+        int visibleTop = rv.getPaddingTop();
+        int visibleBottom = rv.getHeight() - rv.getPaddingBottom();
+        int scroll = 0;
+        if (bottom > visibleBottom) {
+            scroll = bottom - visibleBottom;
+        } else if (top < visibleTop) {
+            scroll = top - visibleTop;
+        }
+        if (scroll != 0) rv.smoothScrollBy(0, scroll);
+        // As DragLayer.animateViewIntoPosition does for a workspace icon, from the row's laid
+        // out place (not its animated one: the item animator may still be moving it).
+        float[] coord = {target.getLeft(), target.getTop() - scroll};
+        float scale = dragLayer.getDescendantCoordRelativeToSelf(rv, coord);
+        Rect dest = new Rect();
+        target.getWorkspaceVisualDragBounds(dest);
+        float toScale = scale * dest.width()
+                / (dragView.getMeasuredWidth() - dragView.getBlurSizeOutline());
+        float shiftX = dragView.getMeasuredWidth() * (1 - toScale) / 2;
+        float shiftY = dragView.getMeasuredHeight() * (1 - toScale) / 2;
+        int toX = Math.round(coord[0] + scale * dest.left
+                - toScale * dragView.getBlurSizeOutline() / 2 - shiftX);
+        int toY = Math.round(coord[1] + scale * dest.top
+                - toScale * dragView.getBlurSizeOutline() / 2 - shiftY);
+        target.setVisibility(View.INVISIBLE);
+        dragLayer.animateViewIntoPosition(dragView, toX, toY, 1f, toScale, toScale,
+                () -> {
+                    if (key.equals(sHiddenKey)) sHiddenKey = null;
+                    // Unless a rebind gave the view to another app, which is already shown.
+                    if (target.getTag() instanceof ItemInfo tag
+                            && key.equals(DrawerSections.keyOf(tag))) {
+                        target.setVisibility(View.VISIBLE);
+                    }
+                }, DragLayer.ANIMATION_END_DISAPPEAR, -1,
+                null);
+    }
+
+    @Override
+    public void prepareAccessibilityDrop() {}
+
+    private void handOff() {
+        stopScroll();
+        setTarget(TARGET_NONE);
+        mEnabled = false;
+        if (sActive == this) sActive = null;
+        if (mRecyclerView != null) mRecyclerView.invalidateItemDecorations();
+        mLauncher.getStateManager().goToState(SPRING_LOADED);
+    }
+
+    private void setTarget(int target) {
+        if (target != mTarget) {
+            mTarget = target;
+            if (mRecyclerView != null) mRecyclerView.invalidate();
+        }
+    }
+
+    private void scrollStep() {
+        AllAppsRecyclerView rv = mRecyclerView;
+        if (rv == null || mScrollDir == 0 || !mEnabled) return;
+        float density = rv.getResources().getDisplayMetrics().density;
+        rv.scrollBy(0, (int) (mScrollDir * SCROLL_STEP_DP * density));
+        rv.postOnAnimation(mScroller);
+    }
+
+    private void stopScroll() {
+        mScrollDir = 0;
+        if (mRecyclerView != null) mRecyclerView.removeCallbacks(mScroller);
+    }
+
+    /**
+     * The target under y (the list's coordinates): the section of the row there (a divider is
+     * its section's), the main list for a main row, a new section below the last row.
+     */
+    static int targetAt(AllAppsRecyclerView rv, float y) {
+        AlphabeticalAppsList apps = rv.getApps();
+        List<AdapterItem> items = apps.getAdapterItems();
+        int lastPlaceable = -1;
+        for (int i = items.size() - 1; i >= 0 && lastPlaceable < 0; i--) {
+            if (isPlaceable(items.get(i))) lastPlaceable = i;
+        }
+        boolean lastShown = false;
+        int lastBottom = Integer.MIN_VALUE;
+        AdapterItem above = null;
+        int aboveBottom = Integer.MIN_VALUE;
+        for (int i = 0; i < rv.getChildCount(); i++) {
+            View child = rv.getChildAt(i);
+            int pos = rv.getChildAdapterPosition(child);
+            if (pos < 0 || pos >= items.size()) continue;
+            AdapterItem item = items.get(pos);
+            if (!isPlaceable(item)) continue;
+            int top = child.getTop();
+            int bottom = child.getBottom();
+            lastBottom = Math.max(lastBottom, bottom);
+            lastShown |= pos == lastPlaceable;
+            if (y >= top && y <= bottom) {
+                return sectionOf(item);
+            }
+            if (bottom < y && bottom > aboveBottom) {
+                above = item;
+                aboveBottom = bottom;
+            }
+        }
+        // Below the list's last row: the slot DrawerDropIndicator opens while dragging.
+        if (lastShown && y > lastBottom) {
+            return TARGET_NEW;
+        }
+        return above != null ? sectionOf(above) : TARGET_MAIN;
+    }
+
+    private static boolean isPlaceable(AdapterItem item) {
+        return item instanceof DrawerSectionHeaderItem
+                || (item.itemInfo != null && item.decorationInfo == null);
+    }
+
+    private static int sectionOf(AdapterItem item) {
+        return item.drawerSectionId >= 0 ? item.drawerSectionId : TARGET_MAIN;
+    }
+}
