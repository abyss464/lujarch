@@ -0,0 +1,59 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.launcher3.lujarch;
+
+import static com.android.launcher3.allapps.BaseAllAppsAdapter.VIEW_TYPE_DRAWER_SECTION_HEADER;
+
+import android.view.View;
+import android.widget.TextView;
+
+import com.android.launcher3.R;
+import com.android.launcher3.allapps.BaseAllAppsAdapter.AdapterItem;
+
+import java.util.Objects;
+
+/**
+ * The divider of a drawer section in the app list: a hairline, the section's name before it
+ * when it has one, a faint chevron after it while the section is folded.
+ */
+public class DrawerSectionHeaderItem extends AdapterItem {
+    public final int sectionId;
+    public final String name;
+    /** The name, or the section's place ("Section 2") when it has none. */
+    public final String label;
+    public final boolean collapsed;
+
+    public DrawerSectionHeaderItem(int sectionId, String name, String label, boolean collapsed) {
+        super(VIEW_TYPE_DRAWER_SECTION_HEADER);
+        this.sectionId = sectionId;
+        this.name = name;
+        this.label = label;
+        this.collapsed = collapsed;
+        this.drawerSectionId = sectionId;
+    }
+
+    public void bind(View view) {
+        TextView title = view.findViewById(R.id.lujarch_section_title);
+        View chevron = view.findViewById(R.id.lujarch_section_chevron);
+        title.setText(name);
+        title.setVisibility(name.isEmpty() ? View.GONE : View.VISIBLE);
+        chevron.setVisibility(collapsed ? View.VISIBLE : View.GONE);
+        view.setContentDescription(view.getContext().getString(collapsed
+                ? R.string.lujarch_drawer_section_expand
+                : R.string.lujarch_drawer_section_collapse, label));
+    }
+
+    @Override
+    public boolean isSameAs(AdapterItem other) {
+        return other instanceof DrawerSectionHeaderItem h && h.sectionId == sectionId;
+    }
+
+    @Override
+    public boolean isContentSame(AdapterItem other) {
+        return other instanceof DrawerSectionHeaderItem h
+                && h.collapsed == collapsed && Objects.equals(h.name, name)
+                && Objects.equals(h.label, label);
+    }
+}
diff --git a/src/com/android/launcher3/lujarch/DrawerSections.java b/src/com/android/launcher3/lujarch/DrawerSections.java
new file mode 100644
index 0000000000000000000000000000000000000000..c409c81e8d3f441256b847ae5563ac75cc1fe0a2
--- /dev/null
+++ b/src/com/android/launcher3/lujarch/DrawerSections.java
@@ -0,0 +1,237 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.launcher3.lujarch;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.UserHandle;
+import android.util.Log;
+
+import androidx.annotation.Nullable;
+
+import com.android.launcher3.model.data.ItemInfo;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.WeakHashMap;
+
+/**
+ * Drawer sections (LCH-1): groups of apps the owner makes in the app drawer by dragging, shown below the main list after a divider,
+ * unnamed unless the owner names them, foldable. A section exists while it holds apps. The
+ * system makes none and suggests none.
+ *
+ * One store for the drawer, the long-press menu and the settings page: a JSON document in
+ * its own preferences file. Apps are keyed by component and user, so a work profile's copy
+ * of an app is placed on its own. Called on the main thread only.
+ */
+public final class DrawerSections {
+    private static final String TAG = "LujarchDrawerSections";
+    private static final String PREFS = "lujarch_drawer_sections";
+    private static final String KEY_STATE = "state";
+
+    /** A section: its id never changes, its name is the owner's. */
+    public static final class Section {
+        public final int id;
+        public final String name;
+
+        Section(int id, String name) {
+            this.id = id;
+            this.name = name;
+        }
+    }
+
+    private static DrawerSections sInstance;
+
+    private final SharedPreferences mPrefs;
+    private final List<Section> mSections = new ArrayList<>();
+    private final Map<String, Integer> mMembers = new HashMap<>();
+    private final Set<Integer> mCollapsed = new HashSet<>();
+    private int mNextId = 1;
+    // Held weakly: a drawer list registers itself and goes with its all-apps view.
+    private final Set<Runnable> mListeners = Collections.newSetFromMap(new WeakHashMap<>());
+
+    public static DrawerSections get(Context context) {
+        if (sInstance == null) {
+            sInstance = new DrawerSections(context.getApplicationContext());
+        }
+        return sInstance;
+    }
+
+    private DrawerSections(Context context) {
+        mPrefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        load();
+    }
+
+    /** The key of an app in the store, or null for an item without a component. */
+    @Nullable
+    public static String keyOf(ItemInfo info) {
+        ComponentName cn = info.getTargetComponent();
+        return cn == null ? null : keyOf(cn, info.user);
+    }
+
+    public static String keyOf(ComponentName cn, UserHandle user) {
+        return cn.flattenToString() + "#" + user.getIdentifier();
+    }
+
+    public List<Section> getSections() {
+        return Collections.unmodifiableList(new ArrayList<>(mSections));
+    }
+
+    @Nullable
+    public Section getSection(int id) {
+        for (Section s : mSections) {
+            if (s.id == id) return s;
+        }
+        return null;
+    }
+
+    /** The id of the section the app is in, or -1 when it is in the main list. */
+    public int sectionOf(@Nullable String key) {
+        if (key == null) return -1;
+        Integer id = mMembers.get(key);
+        return id == null || getSection(id) == null ? -1 : id;
+    }
+
+    public boolean isCollapsed(int id) {
+        return mCollapsed.contains(id);
+    }
+
+    public void toggleCollapsed(int id) {
+        if (!mCollapsed.remove(id)) mCollapsed.add(id);
+        commit();
+    }
+
+    /** Puts the app in the section (out of any other). */
+    public void moveTo(String key, int id) {
+        if (getSection(id) == null) return;
+        mMembers.put(key, id);
+        commit();
+    }
+
+    /** Takes the app out of its section, back to the main list. */
+    public void removeFromSection(String key) {
+        if (mMembers.remove(key) != null) commit();
+    }
+
+    /** Makes an unnamed section at the end holding the app. */
+    public void createWith(String key) {
+        int id = mNextId++;
+        mSections.add(new Section(id, ""));
+        mMembers.put(key, id);
+        commit();
+    }
+
+    public void rename(int id, String name) {
+        for (int i = 0; i < mSections.size(); i++) {
+            if (mSections.get(i).id == id) {
+                mSections.set(i, new Section(id, name.trim()));
+                commit();
+                return;
+            }
+        }
+    }
+
+    /** Moves the section one place up (-1) or down (+1). */
+    public void move(int id, int by) {
+        for (int i = 0; i < mSections.size(); i++) {
+            if (mSections.get(i).id == id) {
+                int j = i + by;
+                if (j < 0 || j >= mSections.size()) return;
+                Collections.swap(mSections, i, j);
+                commit();
+                return;
+            }
+        }
+    }
+
+    /** Deletes the section; its apps go back to the main list. */
+    public void delete(int id) {
+        mSections.removeIf(s -> s.id == id);
+        mMembers.values().removeIf(v -> v == id);
+        mCollapsed.remove(id);
+        commit();
+    }
+
+    /** The caller keeps a strong reference to the listener for as long as it listens. */
+    public void addListener(Runnable listener) {
+        mListeners.add(listener);
+    }
+
+    public void removeListener(Runnable listener) {
+        mListeners.remove(listener);
+    }
+
+    private void commit() {
+        // A section exists while it holds apps: the last app dragged out ends it.
+        mSections.removeIf(s -> !mMembers.containsValue(s.id));
+        mCollapsed.removeIf(id -> getSection(id) == null);
+        save();
+        for (Runnable l : new ArrayList<>(mListeners)) l.run();
+    }
+
+    private void load() {
+        String json = mPrefs.getString(KEY_STATE, null);
+        if (json == null) return;
+        try {
+            JSONObject o = new JSONObject(json);
+            mNextId = o.optInt("nextId", 1);
+            JSONArray sections = o.optJSONArray("sections");
+            for (int i = 0; sections != null && i < sections.length(); i++) {
+                JSONObject s = sections.getJSONObject(i);
+                mSections.add(new Section(s.getInt("id"), s.getString("name")));
+            }
+            JSONObject members = o.optJSONObject("members");
+            if (members != null) {
+                for (java.util.Iterator<String> it = members.keys(); it.hasNext(); ) {
+                    String k = it.next();
+                    mMembers.put(k, members.getInt(k));
+                }
+            }
+            JSONArray collapsed = o.optJSONArray("collapsed");
+            for (int i = 0; collapsed != null && i < collapsed.length(); i++) {
+                mCollapsed.add(collapsed.getInt(i));
+            }
+        } catch (JSONException e) {
+            // A broken store shows every app in the main list; the owner's apps stay usable.
+            Log.e(TAG, "Unreadable drawer sections, starting empty", e);
+            mSections.clear();
+            mMembers.clear();
+            mCollapsed.clear();
+        }
+    }
+
+    private void save() {
+        try {
+            JSONObject o = new JSONObject();
+            o.put("nextId", mNextId);
+            JSONArray sections = new JSONArray();
+            for (Section s : mSections) {
+                sections.put(new JSONObject().put("id", s.id).put("name", s.name));
+            }
+            o.put("sections", sections);
+            JSONObject members = new JSONObject();
+            for (Map.Entry<String, Integer> e : mMembers.entrySet()) {
+                members.put(e.getKey(), (int) e.getValue());
+            }
+            o.put("members", members);
+            JSONArray collapsed = new JSONArray();
+            for (int id : mCollapsed) collapsed.put(id);
+            o.put("collapsed", collapsed);
+            mPrefs.edit().putString(KEY_STATE, o.toString()).apply();
+        } catch (JSONException e) {
+            Log.e(TAG, "Cannot save drawer sections", e);
+        }
+    }
+}
diff --git a/src/com/android/launcher3/lujarch/DrawerSectionsSettings.java b/src/com/android/launcher3/lujarch/DrawerSectionsSettings.java
new file mode 100644
index 0000000000000000000000000000000000000000..70bece983312860890e89b0939df3bed191f88c6
--- /dev/null
+++ b/src/com/android/launcher3/lujarch/DrawerSectionsSettings.java
@@ -0,0 +1,142 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.launcher3.lujarch;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.text.InputType;
+import android.view.WindowManager;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+
+import androidx.annotation.Nullable;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceFragmentCompat;
+import androidx.preference.PreferenceScreen;
+
+import com.android.launcher3.R;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Consumer;
+
+/**
+ * The actions of a drawer section (name, move up, move down, delete), from a long press on
+ * its divider in the drawer and from the settings page, which lists the sections in drawer
+ * order. Sections are made by dragging an app below the last row of the drawer; deleting one
+ * puts its apps back in the main list.
+ */
+public final class DrawerSectionsSettings {
+    public static final String KEY = "pref_drawer_sections";
+
+    private DrawerSectionsSettings() {}
+
+    /** Fills the settings page; called again after every change made on it. */
+    public static void fill(PreferenceFragmentCompat fragment) {
+        PreferenceScreen screen = fragment.getPreferenceScreen();
+        Context context = screen.getContext();
+        screen.removeAll();
+        List<DrawerSections.Section> sections = DrawerSections.get(context).getSections();
+        if (sections.isEmpty()) {
+            Preference none = new Preference(context);
+            none.setSummary(R.string.lujarch_drawer_sections_none);
+            none.setSelectable(false);
+            none.setPersistent(false);
+            screen.addPreference(none);
+        }
+        for (int i = 0; i < sections.size(); i++) {
+            DrawerSections.Section section = sections.get(i);
+            Preference row = new Preference(context);
+            row.setKey("lujarch_drawer_section_" + section.id);
+            row.setTitle(label(context, section, i));
+            row.setPersistent(false);
+            row.setOnPreferenceClickListener(p -> {
+                showActions(context, section.id, () -> fill(fragment));
+                return true;
+            });
+            screen.addPreference(row);
+        }
+    }
+
+    /** A section's name, or its place ("Section 2") when the owner gave it none. */
+    public static String label(Context context, DrawerSections.Section section, int index) {
+        return section.name.isEmpty()
+                ? context.getString(R.string.lujarch_drawer_section_numbered, index + 1)
+                : section.name;
+    }
+
+    /** The section's actions; onChange runs after one changed the store. */
+    public static void showActions(Context context, int sectionId, @Nullable Runnable onChange) {
+        DrawerSections store = DrawerSections.get(context);
+        List<DrawerSections.Section> sections = store.getSections();
+        int index = -1;
+        for (int i = 0; i < sections.size(); i++) {
+            if (sections.get(i).id == sectionId) index = i;
+        }
+        if (index < 0) return;
+        DrawerSections.Section section = sections.get(index);
+        Runnable changed = () -> {
+            if (onChange != null) onChange.run();
+        };
+        List<CharSequence> labels = new ArrayList<>();
+        List<Runnable> actions = new ArrayList<>();
+        labels.add(context.getString(R.string.lujarch_drawer_section_rename));
+        actions.add(() -> askName(context, R.string.lujarch_drawer_section_rename, section.name,
+                name -> {
+                    store.rename(section.id, name);
+                    changed.run();
+                }));
+        if (index > 0) {
+            labels.add(context.getString(R.string.lujarch_drawer_section_move_up));
+            actions.add(() -> {
+                store.move(section.id, -1);
+                changed.run();
+            });
+        }
+        if (index < sections.size() - 1) {
+            labels.add(context.getString(R.string.lujarch_drawer_section_move_down));
+            actions.add(() -> {
+                store.move(section.id, 1);
+                changed.run();
+            });
+        }
+        labels.add(context.getString(R.string.lujarch_drawer_section_delete));
+        actions.add(() -> {
+            store.delete(section.id);
+            changed.run();
+        });
+        new AlertDialog.Builder(context)
+                .setTitle(label(context, section, index))
+                .setItems(labels.toArray(new CharSequence[0]),
+                        (d, which) -> actions.get(which).run())
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    /** Asks for a name; an empty name is allowed and leaves the section unnamed. */
+    private static void askName(Context context, int titleRes, String initial,
+            Consumer<String> onName) {
+        EditText field = new EditText(context);
+        field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_SENTENCES);
+        field.setSingleLine(true);
+        field.setText(initial);
+        field.setSelection(initial.length());
+        FrameLayout frame = new FrameLayout(context);
+        int pad = context.getResources().getDimensionPixelSize(R.dimen.ps_header_layout_margin);
+        frame.setPadding(pad, pad / 2, pad, 0);
+        frame.addView(field);
+        AlertDialog dialog = new AlertDialog.Builder(context)
+                .setTitle(titleRes)
+                .setView(frame)
+                .setPositiveButton(android.R.string.ok,
+                        (d, w) -> onName.accept(field.getText().toString().trim()))
+                .setNegativeButton(android.R.string.cancel, null)
+                .create();
+        dialog.setOnShowListener(d -> field.requestFocus());
+        dialog.getWindow().setSoftInputMode(
+                WindowManager.LayoutParams.SOFT_INPUT_STATE_ALWAYS_VISIBLE);
+        dialog.show();
+    }
+}
diff --git a/src/com/android/launcher3/settings/SettingsActivity.java b/src/com/android/launcher3/settings/SettingsActivity.java
index d4b18483c008e22f85afc213c818c3ae7ba3ff7e..ca1d8fea93a392f9eb8091edd76f1d754cd9fbb3 100644
--- a/src/com/android/launcher3/settings/SettingsActivity.java
+++ b/src/com/android/launcher3/settings/SettingsActivity.java
