             PreferenceScreen screen = getPreferenceScreen();
             for (int i = screen.getPreferenceCount() - 1; i >= 0; i--) {
@@ -329,6 +336,12 @@ public class SettingsActivity extends FragmentActivity
             LauncherApps launcherApps = getContext().getSystemService(LauncherApps.class);
             LauncherDisplayInfo info = DisplayController.INSTANCE.get(getContext()).getInfo();
             switch (preference.getKey()) {
+                case com.android.launcher3.lujarch.DrawerSectionsSettings.KEY:
