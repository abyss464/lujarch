+status_t AudioFlinger::setAppVolumes(const std::vector<media::AppVolume>& volumes,
+                                     const std::vector<audio_stream_type_t>& mediaStreams) {
+    std::map<uid_t, float> table;
+    for (const auto& v : volumes) {
+        const uid_t uid = VALUE_OR_RETURN_STATUS(aidl2legacy_int32_t_uid_t(v.uid));
+        if (std::isnan(v.volume) || v.volume < 0.f || v.volume > 1.f) {
+            ALOGW("%s: uid %u volume %f is not in [0, 1]; table unchanged",
+                    __func__, uid, v.volume);
+            return BAD_VALUE;
+        }
+        if (v.volume != 1.f) {  // 1 is the default: no entry
+            table[uid] = v.volume;
+        }
+    }
+    uint32_t streams = 0;
+    for (const audio_stream_type_t stream : mediaStreams) {
+        if (static_cast<uint32_t>(stream) >= 32) {
+            ALOGW("%s: stream %d out of range; table unchanged", __func__, stream);
+            return BAD_VALUE;
+        }
+        streams |= 1u << stream;
+    }
+    // Under the AudioFlinger lock, which createTrack_l() also holds: a track created meanwhile
+    // reads either the old table and is updated below, or the new one.
+    audio_utils::lock_guard _l(mutex());
+    {
+        audio_utils::lock_guard _vl(mAppVolumesMutex);
+        mAppVolumes = std::move(table);
+        mAppVolumeStreams = streams;
+    }
+    ALOGV("%s: %zu app volume(s), streams %#x", __func__, volumes.size(), streams);
+    for (const auto& [_, thread] : mPlaybackThreads) {
+        thread->updateAppVolumes();
+    }
+    for (const auto& [_, thread] : mMmapThreads) {
+        thread->updateAppVolumes();
+    }
+    return NO_ERROR;
+}
+
+float AudioFlinger::getAppVolume(uid_t uid, audio_stream_type_t stream) const {
+    // AUDIO_STREAM_DEFAULT (-1) and the internal streams past 31 are never media streams
+    if (static_cast<uint32_t>(stream) >= 32) {
+        return 1.f;
+    }
+    audio_utils::lock_guard _l(mAppVolumesMutex);
+    if ((mAppVolumeStreams & (1u << stream)) == 0) {
+        return 1.f;
+    }
+    const auto it = mAppVolumes.find(uid);
+    return it != mAppVolumes.end() ? it->second : 1.f;
+}
