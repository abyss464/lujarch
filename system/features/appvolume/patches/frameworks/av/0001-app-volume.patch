+void MmapPlaybackThread::updateAppVolumes()
+{
+    audio_utils::lock_guard _l(mutex());
+    const audio_stream_type_t stream = streamType_l();
+    const sp<media::IMmapStreamCallback> callback =
+            mOpenedByAudioServer ? mCallback.promote() : nullptr;
+    // MMAP tracks exist only while they are active
+    for (const auto& track : mActiveMmapTracksView) {
+        const float volume = mAfThreadCallback->getAppVolume(track->uid(), stream);
+        if (volume == track->appVolume()) {
+            continue;
+        }
+        track->setAppVolume(volume);
+        if (callback != nullptr) {
+            // Under the thread lock, as in start(): the AAudio service keeps the gain of a port
+            // from its start to its stop (after stop() removed the track), so no stale gain
+            // outlives the client. The callback takes only the service's leaf lock.
+            callback->onAppVolumeChanged(track->portId(), volume);
+        }
+    }
+    // processVolume_l() applies an exclusive client's gain when the thread loop wakes
+    broadcast_l();
+}
