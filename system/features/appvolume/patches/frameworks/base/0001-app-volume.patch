+
+package com.android.systemui.volume.panel.component.volume.appvolume
+
+import android.app.ActivityManager
+import android.content.Context
+import android.content.pm.PackageManager
+import android.graphics.drawable.Drawable
+import android.media.AudioManager
+import android.media.AudioPlaybackConfiguration
+import android.os.Handler
+import android.os.Process
+import android.os.UserHandle
+import android.util.IconDrawableFactory
+import android.util.Log
+import com.android.systemui.dagger.qualifiers.Background
+import com.android.systemui.utils.coroutines.flow.conflatedCallbackFlow
+import javax.inject.Inject
+import kotlin.coroutines.CoroutineContext
+import kotlinx.coroutines.channels.awaitClose
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.flowOn
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.withContext
+
+/** An app of the volume panel's rows: its uid, name and icon (with a work profile's badge). */
+data class AppVolumeApp(val uid: Int, val label: String, val icon: Drawable)
+
+/**
+ * Lujarch per-app media volume (VOL-1): the apps playing on the media streams, from
+ * AudioManager's playback configurations (SystemUI holds MODIFY_AUDIO_ROUTING, so they carry
+ * uids), and their shares of the Media level through AudioManager's hidden app volume API.
+ */
+class AppVolumeRepository
+@Inject
+constructor(
+    private val context: Context,
+    private val audioManager: AudioManager,
+    @Background private val backgroundHandler: Handler,
+    @Background private val backgroundContext: CoroutineContext,
+) {
+
+    /** The apps with an active player on a media stream, by their earliest player. */
+    val playingApps: Flow<List<AppVolumeList.PlayingApp>> =
+        conflatedCallbackFlow<List<AudioPlaybackConfiguration>> {
+                val callback =
+                    object : AudioManager.AudioPlaybackCallback() {
+                        override fun onPlaybackConfigChanged(
+                            configs: List<AudioPlaybackConfiguration>
+                        ) {
+                            trySend(configs)
+                        }
+                    }
+                audioManager.registerAudioPlaybackCallback(callback, backgroundHandler)
+                trySend(audioManager.activePlaybackConfigurations)
+                awaitClose { audioManager.unregisterAudioPlaybackCallback(callback) }
+            }
+            .map { configs -> playingApps(configs) }
+            .distinctUntilChanged()
+            .flowOn(backgroundContext)
+
+    // the aliases change only with TalkBack's independent volume; asked once per stream
+    private val mediaStreams = HashMap<Int, Boolean>()
+
+    private fun isMediaStream(stream: Int): Boolean =
+        synchronized(mediaStreams) {
+            mediaStreams.getOrPut(stream) {
+                try {
+                    audioManager.getStreamTypeAlias(stream) == AppVolumeList.STREAM_MUSIC
+                } catch (e: RuntimeException) {
+                    Log.w(TAG, "no alias for stream $stream", e)
+                    false
+                }
+            }
+        }
+
+    private fun playingApps(
+        configs: List<AudioPlaybackConfiguration>
+    ): List<AppVolumeList.PlayingApp> {
+        val players =
+            configs.map {
+                AppVolumeList.Player(
+                    playerId = it.playerInterfaceId,
+                    uid = it.clientUid,
+                    pid = it.clientPid,
+                    active = it.isActive,
+                    volumeControlStream = it.audioAttributes.volumeControlStream,
+                )
+            }
+        return AppVolumeList.playingApps(players, Process.myUid(), ::isMediaStream)
+    }
+
+    /**
+     * The app's name and icon, from the package that runs the player: the uid's only package,
+     * or for a shared uid the one whose process is [app]'s. Null when no package has the uid.
+     */
+    suspend fun appOf(app: AppVolumeList.PlayingApp): AppVolumeApp? =
+        withContext(backgroundContext) {
+            val pm = context.packageManager
+            val userId = UserHandle.getUserId(app.uid)
+            val packages = pm.getPackagesForUid(app.uid)?.toList().orEmpty()
+            if (packages.isEmpty()) {
+                Log.w(TAG, "no package has uid ${app.uid}")
+                return@withContext null
+            }
+            val packageName =
+                packages.singleOrNull()
+                    ?: processPackage(app.pid, packages)
+                    ?: packages.sorted().first()
+            try {
+                val info = pm.getApplicationInfoAsUser(packageName, 0, userId)
+                AppVolumeApp(
+                    uid = app.uid,
+                    label = info.loadLabel(pm).toString(),
+                    icon = IconDrawableFactory.newInstance(context).getBadgedIcon(info, userId),
+                )
+            } catch (e: PackageManager.NameNotFoundException) {
+                Log.w(TAG, "$packageName of uid ${app.uid} is gone", e)
+                null
+            }
+        }
+
+    private fun processPackage(pid: Int, packages: List<String>): String? =
+        context
+            .getSystemService(ActivityManager::class.java)
+            ?.runningAppProcesses
+            ?.firstOrNull { it.pid == pid }
+            ?.pkgList
+            ?.firstOrNull { it in packages }
+
+    /** The app's share of the Media level in percent; 100 when it cannot be read (logged). */
+    suspend fun getAppVolume(uid: Int): Int =
+        withContext(backgroundContext) {
+            try {
+                audioManager.getAppVolume(uid)
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "cannot read the volume of uid $uid", e)
+                100
+            }
+        }
+
+    suspend fun setAppVolume(uid: Int, percent: Int) {
+        withContext(backgroundContext) {
+            try {
+                audioManager.setAppVolume(uid, percent)
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "cannot set the volume of uid $uid to $percent", e)
+            }
+        }
+    }
+
+    private companion object {
+        const val TAG = "AppVolumeRepository"
+    }
+}
