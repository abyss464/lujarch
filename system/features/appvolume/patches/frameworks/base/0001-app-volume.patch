+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.volume.panel.component.volume.appvolume
+
+/**
+ * Lujarch per-app media volume (VOL-1): which apps get a row in the volume panel.
+ * Plain Kotlin without Android classes, so it is tested on the host (design/tests/app-volume).
+ */
+object AppVolumeList {
+    // android.os.UserHandle and Process, restated for the host test
+    private const val PER_USER_RANGE = 100000
+    private const val FIRST_APPLICATION_UID = 10000
+    private const val LAST_APPLICATION_UID = 19999
+
+    /**
+     * AudioManager.STREAM_*: the streams AudioService may scale (MUSIC, TTS, ACCESSIBILITY,
+     * ASSISTANT), each only while its volume alias is STREAM_MUSIC (AppVolumes.mediaStreams).
+     */
+    const val STREAM_MUSIC = 3
+    val MEDIA_STREAM_CANDIDATES = listOf(STREAM_MUSIC, 9, 10, 11)
+
+    /** One player of AudioManager's playback configurations. */
+    data class Player(
+        val playerId: Int,
+        val uid: Int,
+        val pid: Int,
+        val active: Boolean,
+        val volumeControlStream: Int,
+    )
+
+    /** An app with an active player on a media stream, by its earliest such player. */
+    data class PlayingApp(val uid: Int, val pid: Int)
+
+    /** Whether the uid is an app's (app id 10000 to 19999, any user). */
+    fun isAppUid(uid: Int): Boolean {
+        if (uid < 0) return false
+        val appId = uid % PER_USER_RANGE
+        return appId in FIRST_APPLICATION_UID..LAST_APPLICATION_UID
+    }
+
+    /**
+     * The apps playing now: an active player on a media stream, of an app uid other than
+     * [ownUid], one entry per uid, in the order of their earliest player (the one created
+     * first). [isMediaStream] tells whether a stream's alias is STREAM_MUSIC.
+     */
+    fun playingApps(
+        players: List<Player>,
+        ownUid: Int,
+        isMediaStream: (Int) -> Boolean,
+    ): List<PlayingApp> =
+        players
+            .asSequence()
+            .filter { it.active && it.uid != ownUid && isAppUid(it.uid) }
+            .filter { it.volumeControlStream in MEDIA_STREAM_CANDIDATES }
+            .filter { isMediaStream(it.volumeControlStream) }
+            .sortedBy { it.playerId }
+            .distinctBy { it.uid }
+            .map { PlayingApp(it.uid, it.pid) }
+            .toList()
+
+    /**
+     * The panel's rows after [playing] was seen: the rows so far, in order, then the apps not
+     * among them in the order they came. A row never leaves while the panel is open, so a
+     * slider never vanishes under the finger.
+     */
+    fun grow(shown: List<PlayingApp>, playing: List<PlayingApp>): List<PlayingApp> {
+        val known = shown.mapTo(HashSet()) { it.uid }
+        val added = playing.filter { known.add(it.uid) }
+        return if (added.isEmpty()) shown else shown + added
+    }
+}
