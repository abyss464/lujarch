+package com.android.systemui.volume.panel.component.volume.ui.viewmodel
+
+import android.graphics.drawable.Drawable
+import android.util.Log
+import com.android.app.tracing.coroutines.launchTraced as launch
+import com.android.systemui.shared.settings.data.repository.SecureSettingsRepository
+import com.android.systemui.volume.panel.component.volume.appvolume.AppVolumeInteractor
+import com.android.systemui.volume.panel.component.volume.slider.ui.viewmodel.AppVolumeSliderViewModel
+import com.android.systemui.volume.panel.component.volume.slider.ui.viewmodel.SliderViewModel
+import com.android.systemui.volume.panel.dagger.scope.VolumePanelScope
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+
+/**
+ * Settings.Secure key of the owner's choice for the line of playing apps under Media: 1 open
+ * (the app rows shown), 0 (the default) folded.
+ */
+const val APPS_EXPANDED_SETTING = "lujarch_appvolume_expanded"
+
+/**
+ * Lujarch per-app media volume (VOL-1): the line under Media with the playing apps' icons and
+ * count, which opens one row per app.
+ */
+@VolumePanelScope
+class AppVolumesViewModel
+@Inject
+constructor(
+    @VolumePanelScope private val scope: CoroutineScope,
+    interactor: AppVolumeInteractor,
+    private val sliderViewModelFactory: AppVolumeSliderViewModel.Factory,
+    private val secureSettings: SecureSettingsRepository,
+) {
+
+    /** One app row: the slider, and the name and icon the line shows. */
+    data class Row(
+        val uid: Int,
+        val label: String,
+        val icon: Drawable,
+        val slider: SliderViewModel,
+    )
+
+    // one slider per app for the panel's life; touched only by the flow below
+    private val sliders = HashMap<Int, AppVolumeSliderViewModel>()
+
+    /** The rows in the order they appeared; the list only grows while the panel is open. */
+    val rows: StateFlow<List<Row>> =
+        interactor.rows
+            .map { apps ->
+                apps.map { app ->
+                    Row(
+                        uid = app.uid,
+                        label = app.label,
+                        icon = app.icon,
+                        slider =
+                            sliders.getOrPut(app.uid) {
+                                sliderViewModelFactory.create(app, scope)
+                            },
+                    )
+                }
+            }
+            .stateIn(scope, SharingStarted.Eagerly, emptyList())
+
+    // the owner's tap while the panel is open wins over the setting's echo of it
+    private val tapped = MutableStateFlow<Boolean?>(null)
+
+    /** Whether the rows are open; null until the stored choice is read. */
+    val isExpanded: StateFlow<Boolean?> =
+        combine(secureSettings.boolSetting(APPS_EXPANDED_SETTING, false), tapped) { stored, tap ->
+                tap ?: stored
+            }
+            .stateIn<Boolean?>(scope, SharingStarted.Eagerly, null)
+
+    fun onExpandedChanged(expanded: Boolean) {
+        tapped.value = expanded
+        scope.launch {
+            try {
+                secureSettings.setBoolean(APPS_EXPANDED_SETTING, expanded)
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "could not save $APPS_EXPANDED_SETTING=$expanded", e)
+            }
+        }
+    }
+
+    private companion object {
+        const val TAG = "AppVolumesViewModel"
+    }
+}
