+
+import android.content.Context
+import com.android.app.tracing.coroutines.launchTraced as launch
+import com.android.systemui.common.shared.model.Icon
+import com.android.systemui.haptics.slider.SliderHapticFeedbackFilter
+import com.android.systemui.haptics.slider.compose.ui.SliderHapticsViewModel
+import com.android.systemui.res.R
+import com.android.systemui.volume.panel.component.volume.appvolume.AppVolumeApp
+import com.android.systemui.volume.panel.component.volume.appvolume.AppVolumeInteractor
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedFactory
+import dagger.assisted.AssistedInject
+import java.text.NumberFormat
+import kotlin.math.roundToInt
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.filterNotNull
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+
+/**
+ * Lujarch per-app media volume: one app's row in the volume panel, 0 to 100 % of the Media
+ * level. A drag shows each value at once and sends the latest one, so a fast drag does not
+ * queue a call per step.
+ */
+class AppVolumeSliderViewModel
+@AssistedInject
+constructor(
+    @Assisted private val app: AppVolumeApp,
+    @Assisted private val coroutineScope: CoroutineScope,
+    private val context: Context,
+    private val interactor: AppVolumeInteractor,
+    private val hapticsViewModelFactory: SliderHapticsViewModel.Factory,
+) : SliderViewModel {
+
+    private val icon = Icon.Loaded(drawable = app.icon, contentDescription = null)
+    private val percent = MutableStateFlow<Int?>(null)
+    private val requested = MutableStateFlow<Int?>(null)
+
+    init {
+        coroutineScope.launch {
+            val stored = interactor.getAppVolume(app.uid)
+            // a drag that began before the read keeps its value
+            percent.compareAndSet(null, stored)
+        }
+        coroutineScope.launch {
+            requested.filterNotNull().collect { interactor.setAppVolume(app.uid, it) }
+        }
+    }
+
+    private val a11yName = context.getString(R.string.lujarch_volume_panel_app_volume, app.label)
+
+    override val slider: StateFlow<SliderState> =
+        percent
+            .map { value ->
+                if (value == null) {
+                    SliderState.Empty
+                } else {
+                    State(
+                        value = value.toFloat(),
+                        label = app.label,
+                        icon = icon,
+                        a11yContentDescription = a11yName,
+                        a11yStateDescription =
+                            NumberFormat.getPercentInstance().format(value / 100.0),
+                    )
+                }
+            }
+            .stateIn(coroutineScope, SharingStarted.Eagerly, SliderState.Empty)
+
+    override fun onValueChanged(state: SliderState, newValue: Float) {
+        val value = newValue.roundToInt().coerceIn(0, 100)
+        percent.value = value
+        requested.value = value
+    }
+
+    override fun onValueChangeFinished() {}
+
+    override fun toggleMuted(state: SliderState) {
+        // an app row has no mute: 0 % silences the app
+    }
+
+    override fun getSliderHapticsViewModelFactory(): SliderHapticsViewModel.Factory? =
+        if (slider.value != SliderState.Empty) hapticsViewModelFactory else null
+
+    private data class State(
+        override val value: Float,
+        override val label: String,
+        override val icon: Icon.Loaded,
+        override val a11yContentDescription: String,
+        override val a11yStateDescription: String,
+    ) : SliderState {
+        override val valueRange: ClosedFloatingPointRange<Float>
+            get() = 0f..100f
+
+        override val step: Float
+            get() = 1f
+
+        override val hapticFilter: SliderHapticFeedbackFilter
+            get() = SliderHapticFeedbackFilter()
+
+        override val isEnabled: Boolean
+            get() = true
+
+        override val a11yClickDescription: String?
+            get() = null
+
+        override val disabledMessage: String?
+            get() = null
+
+        override val isMutable: Boolean
+            get() = false
+    }
+
+    @AssistedFactory
+    interface Factory {
+        fun create(app: AppVolumeApp, coroutineScope: CoroutineScope): AppVolumeSliderViewModel
+    }
+}
