+
+package com.android.server.audio;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.TreeMap;
+import java.util.function.IntUnaryOperator;
+
+/**
+ * Lujarch per-app media volume (VOL-1): each user's table of apps' shares of the
+ * Media level, the taper from a share to a gain, and the table audioserver gets.
+ *
+ * <p>A share is a percent from 0 to 100, stored per user under the app's key (its package, or
+ * its shared user when several packages share its uid); 100 is the default and is stored as no
+ * entry. The gain is derived from it when the table is pushed, so the taper can change without
+ * touching stored shares.
+ *
+ * <p>Plain Java without Android dependencies, so the taper, the table and the uid mapping are
+ * tested on the host (design/tests/app-volume). Not thread safe: {@link AppVolumeHelper} holds
+ * its lock around every call.
+ */
+final class AppVolumes {
+    static final int DEFAULT_PERCENT = 100;
+
+    // android.os.Process and UserHandle, restated so this class needs no Android classes
+    static final int PER_USER_RANGE = 100000;
+    static final int FIRST_APPLICATION_UID = 10000;
+    static final int LAST_APPLICATION_UID = 19999;
+
+    // AudioSystem.STREAM_*: the streams the Media slider can control. A stream is a media stream
+    // while its volume alias is STREAM_MUSIC; DTMF, ring, notifications, alarms, calls and
+    // system sounds are never scaled, even on a platform that aliases them to Media.
+    static final int STREAM_MUSIC = 3;
+    private static final int[] MEDIA_STREAM_CANDIDATES = {
+            STREAM_MUSIC, 9 /* TTS */, 10 /* ACCESSIBILITY */, 11 /* ASSISTANT */};
+
+    /** The key an app's share is stored under. Ordered: packages first, then by name. */
+    static final class Key implements Comparable<Key> {
+        final boolean sharedUser;
+        final String name;
+
+        private Key(boolean sharedUser, String name) {
+            this.sharedUser = sharedUser;
+            this.name = Objects.requireNonNull(name);
+        }
+
+        static Key ofPackage(String packageName) {
+            return new Key(false, packageName);
+        }
+
+        static Key ofSharedUser(String sharedUserName) {
+            return new Key(true, sharedUserName);
+        }
+
+        @Override
+        public int compareTo(Key other) {
+            if (sharedUser != other.sharedUser) {
+                return sharedUser ? 1 : -1;
+            }
+            return name.compareTo(other.name);
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            return o instanceof Key k && k.sharedUser == sharedUser && k.name.equals(name);
+        }
+
+        @Override
+        public int hashCode() {
+            return Objects.hash(sharedUser, name);
+        }
+
+        @Override
+        public String toString() {
+            return (sharedUser ? "shared-user " : "package ") + name;
+        }
+    }
+
+    /** One stored share, as the file holds it. */
+    static final class Entry {
+        final Key key;
+        final int percent;
+
+        Entry(Key key, int percent) {
+            this.key = key;
+            this.percent = percent;
+        }
+
+        /**
+         * The entry of one element of the file, or null when it is not a valid one: exactly one
+         * of the names, a name of package characters, a percent from 0 to 99.
+         */
+        static Entry parse(String packageName, String sharedUserName, String percentText) {
+            if ((packageName == null) == (sharedUserName == null) || percentText == null) {
+                return null;
+            }
+            final String name = packageName != null ? packageName : sharedUserName;
+            if (!isValidName(name)) {
+                return null;
+            }
+            final int percent;
+            try {
+                percent = Integer.parseInt(percentText);
+            } catch (NumberFormatException e) {
+                return null;
+            }
+            if (percent < 0 || percent >= DEFAULT_PERCENT) {
+                return null;
+            }
+            return new Entry(packageName != null ? Key.ofPackage(name) : Key.ofSharedUser(name),
+                    percent);
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            return o instanceof Entry e && e.key.equals(key) && e.percent == percent;
+        }
+
+        @Override
+        public int hashCode() {
+            return Objects.hash(key, percent);
+        }
+
+        @Override
+        public String toString() {
+            return key + " " + percent + "%";
+        }
+    }
+
+    /** Resolves app uids to keys and back, from the package manager. */
+    interface Resolver {
+        /** The key of the app with this uid, or null when no package has the uid. */
+        Key keyOf(int uid);
+
+        /** The uid of the app under this key in the user, or -1 when it is not installed there. */
+        int uidOf(Key key, int userId);
+    }
+
+    /** What audioserver gets: parallel arrays of uids and gains, by uid, and the streams. */
+    static final class Push {
+        final int[] uids;
+        final float[] gains;
+        final int[] mediaStreams;
+
+        Push(int[] uids, float[] gains, int[] mediaStreams) {
+            this.uids = uids;
+            this.gains = gains;
+            this.mediaStreams = mediaStreams;
+        }
+    }
+
+    // user id -> key -> percent (never 100)
+    private final TreeMap<Integer, TreeMap<Key, Integer>> mTables = new TreeMap<>();
+
+    /**
+     * The taper: the gain a share gives, by the square law, the usual fader taper (-3 dB at
+     * 84 %, -6 dB at 71 %, -10 dB at 56 %, -20 dB at 32 %). Linear amplitude would put the
+     * whole range from 0 to -6 dB into the top half of the slider.
+     */
+    static float gainOf(int percent) {
+        final float share = Math.max(0, Math.min(DEFAULT_PERCENT, percent)) / 100f;
+        return share * share;
+    }
+
+    /** Whether the uid is an app's (app id 10000 to 19999, any user); system uids never are. */
+    static boolean isAppUid(int uid) {
+        if (uid < 0) {
+            return false;
+        }
+        final int appId = uid % PER_USER_RANGE;
+        return appId >= FIRST_APPLICATION_UID && appId <= LAST_APPLICATION_UID;
+    }
+
+    static int userIdOf(int uid) {
+        return uid / PER_USER_RANGE;
+    }
+
+    /**
+     * The streams the gains apply to: the candidates whose volume alias (by {@code aliasOf}) is
+     * STREAM_MUSIC, so the set follows the Media slider (accessibility leaves it when TalkBack
+     * makes its volume independent).
+     */
+    static int[] mediaStreams(IntUnaryOperator aliasOf) {
+        int count = 0;
+        final int[] streams = new int[MEDIA_STREAM_CANDIDATES.length];
+        for (int stream : MEDIA_STREAM_CANDIDATES) {
+            if (aliasOf.applyAsInt(stream) == STREAM_MUSIC) {
+                streams[count++] = stream;
+            }
+        }
+        final int[] result = new int[count];
+        System.arraycopy(streams, 0, result, 0, count);
+        return result;
+    }
+
+    /** The share of the key in the user, 100 without an entry. */
+    int get(int userId, Key key) {
+        final TreeMap<Key, Integer> table = mTables.get(userId);
+        final Integer percent = table == null ? null : table.get(key);
+        return percent == null ? DEFAULT_PERCENT : percent;
+    }
+
+    /**
+     * Sets the share of the key in the user; 100 removes the entry.
+     * @return whether the table changed
+     * @throws IllegalArgumentException for a percent out of 0..100
+     */
+    boolean set(int userId, Key key, int percent) {
+        if (percent < 0 || percent > DEFAULT_PERCENT) {
+            throw new IllegalArgumentException("percent " + percent + " is not in 0..100");
+        }
+        if (percent == DEFAULT_PERCENT) {
+            return remove(userId, key);
+        }
+        final Integer old = mTables.computeIfAbsent(userId, u -> new TreeMap<>()).put(key, percent);
+        return old == null || old != percent;
+    }
+
+    /** Removes the key's entry in the user (the app was uninstalled there). */
+    boolean remove(int userId, Key key) {
+        final TreeMap<Key, Integer> table = mTables.get(userId);
+        if (table == null || table.remove(key) == null) {
+            return false;
+        }
+        if (table.isEmpty()) {
+            mTables.remove(userId);
+        }
+        return true;
+    }
+
+    /** Whether the user has an entry for the key. */
+    boolean contains(int userId, Key key) {
+        final TreeMap<Key, Integer> table = mTables.get(userId);
+        return table != null && table.containsKey(key);
+    }
+
+    /** Forgets the user's table (the user stopped; its file keeps it). */
+    void unload(int userId) {
+        mTables.remove(userId);
+    }
+
+    /** The user's entries in key order, as the file holds them. */
+    List<Entry> entries(int userId) {
+        final List<Entry> entries = new ArrayList<>();
+        final TreeMap<Key, Integer> table = mTables.get(userId);
+        if (table != null) {
+            for (Map.Entry<Key, Integer> e : table.entrySet()) {
+                entries.add(new Entry(e.getKey(), e.getValue()));
+            }
+        }
+        return entries;
+    }
+
+    /**
+     * Replaces the user's table with the entries read from its file (the user started). A key
+     * that appears twice keeps its first entry.
+     * @return how many entries were dropped as duplicates
+     */
+    int load(int userId, Collection<Entry> entries) {
+        mTables.remove(userId);
+        int dropped = 0;
+        for (Entry e : entries) {
+            if (contains(userId, e.key)) {
+                dropped++;
+                continue;
+            }
+            set(userId, e.key, e.percent);
+        }
+        return dropped;
+    }
+
+    /**
+     * The table for audioserver: every entry of the given users resolved to its uid, with its
+     * gain, sorted by uid. An entry whose app is not installed in its user is left out.
+     */
+    Push push(Collection<Integer> userIds, Resolver resolver, int[] mediaStreams) {
+        final TreeMap<Integer, Float> byUid = new TreeMap<>();
+        for (int userId : userIds) {
+            final TreeMap<Key, Integer> table = mTables.get(userId);
+            if (table == null) {
+                continue;
+            }
+            for (Map.Entry<Key, Integer> e : table.entrySet()) {
+                final int uid = resolver.uidOf(e.getKey(), userId);
+                if (uid < 0 || !isAppUid(uid) || userIdOf(uid) != userId) {
+                    continue;
+                }
+                byUid.putIfAbsent(uid, gainOf(e.getValue()));
+            }
+        }
+        final int[] uids = new int[byUid.size()];
+        final float[] gains = new float[byUid.size()];
+        int i = 0;
+        for (Map.Entry<Integer, Float> e : byUid.entrySet()) {
+            uids[i] = e.getKey();
+            gains[i] = e.getValue();
+            i++;
+        }
+        return new Push(uids, gains, mediaStreams.clone());
+    }
+
+    /** Package names and shared user ids: letters, digits, '_' and '.', not empty. */
+    static boolean isValidName(String name) {
+        if (name == null || name.isEmpty() || name.length() > 255) {
+            return false;
+        }
+        for (int i = 0; i < name.length(); i++) {
+            final char c = name.charAt(i);
+            if (!(c == '.' || c == '_' || (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z')
+                    || (c >= 'A' && c <= 'Z'))) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
