+package com.android.server.audio;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.annotation.UserIdInt;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageManagerInternal;
+import android.media.AudioSystem;
+import android.os.Environment;
+import android.os.Handler;
+import android.os.Process;
+import android.os.UserHandle;
+import android.util.AtomicFile;
+import android.util.Slog;
+import android.util.SparseArray;
+import android.util.Xml;
+
+import com.android.internal.annotations.GuardedBy;
+import com.android.internal.util.XmlUtils;
+import com.android.modules.utils.TypedXmlPullParser;
+import com.android.modules.utils.TypedXmlSerializer;
+import com.android.server.LocalServices;
+import com.android.server.utils.EventLogger;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileNotFoundException;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.TreeSet;
+import java.util.function.IntUnaryOperator;
+
+/**
+ * Lujarch per-app media volume (VOL-1): the owner's per-app shares of the
+ * Media level, kept per user and package in /data/system_de/<user>/audio_app_volumes.xml and
+ * pushed to AudioFlinger as uids and gains, which applies them to the apps' playback on the
+ * media streams.
+ *
+ * <p>The whole table is pushed at once: when the system is ready, when a user starts or stops,
+ * after an audioserver restart, when the stream aliases change, when a share changes and when a
+ * package with a share is installed. An uninstall (not an update or an archive) drops the
+ * package's share in that user.
+ *
+ * <p>Every method may be called from any thread; they serialize on one lock, which is held
+ * while the table is pushed, so pushes never overtake each other. The file is written on the
+ * audio handler, {@link #PERSIST_DELAY_MS} after the last change, so a drag writes it once.
+ */
+final class AppVolumeHelper {
+    private static final String TAG = "AS.AppVolumeHelper";
+
+    private static final String FILE_NAME = "audio_app_volumes.xml";
+    private static final String TAG_ROOT = "app-volumes";
+    private static final String TAG_APP = "app";
+    private static final String ATTR_VERSION = "version";
+    private static final String ATTR_PACKAGE = "package";
+    private static final String ATTR_SHARED_USER = "shared-user";
+    private static final String ATTR_PERCENT = "percent";
+    private static final int VERSION = 1;
+
+    /** As AudioService's PERSIST_DELAY for the stream volumes. */
+    private static final long PERSIST_DELAY_MS = 500;
+
+    private final Context mContext;
+    private final AudioSystemAdapter mAudioSystem;
+    private final Handler mHandler;
+    private final IntUnaryOperator mStreamAlias;
+    private final EventLogger mLogger = new EventLogger(40, "app volume events");
+
+    private final Object mLock = new Object();
+    @GuardedBy("mLock")
+    private final AppVolumes mVolumes = new AppVolumes();
+    @GuardedBy("mLock")
+    private final TreeSet<Integer> mStartedUsers = new TreeSet<>();
+    @GuardedBy("mLock")
+    private final TreeSet<Integer> mDirtyUsers = new TreeSet<>();
+    @GuardedBy("mLock")
+    private boolean mSystemReady;
+    @GuardedBy("mLock")
+    private @Nullable AppVolumes.Push mLastPush;
+    @GuardedBy("mLock")
+    private int mLastPushStatus;
+
+    private final Runnable mPersistRunnable = this::persistDirtyUsers;
+
+    private final AppVolumes.Resolver mResolver = new AppVolumes.Resolver() {
+        @Override
+        public AppVolumes.Key keyOf(int uid) {
+            final PackageManagerInternal pmi = pm();
+            final String sharedUser = pmi.getAppsWithSharedUserIds().get(UserHandle.getAppId(uid));
+            if (sharedUser != null) {
+                return AppVolumes.Key.ofSharedUser(sharedUser);
+            }
+            final String name = pmi.getNameForUid(uid);
+            return name == null || !AppVolumes.isValidName(name)
+                    ? null : AppVolumes.Key.ofPackage(name);
+        }
+
+        @Override
+        public int uidOf(AppVolumes.Key key, int userId) {
+            final PackageManagerInternal pmi = pm();
+            if (key.sharedUser) {
+                final SparseArray<String> shared = pmi.getAppsWithSharedUserIds();
+                for (int i = 0; i < shared.size(); i++) {
+                    if (key.name.equals(shared.valueAt(i))) {
+                        return UserHandle.getUid(userId, shared.keyAt(i));
+                    }
+                }
+                return -1;
+            }
+            return pmi.getPackageUid(key.name, 0 /* flags */, userId);
+        }
+    };
+
+    AppVolumeHelper(@NonNull Context context, @NonNull AudioSystemAdapter audioSystem,
+            @NonNull Handler audioHandler, @NonNull IntUnaryOperator streamAlias) {
+        mContext = context;
+        mAudioSystem = audioSystem;
+        mHandler = audioHandler;
+        mStreamAlias = streamAlias;
+    }
+
+    private static PackageManagerInternal pm() {
+        return LocalServices.getService(PackageManagerInternal.class);
+    }
+
+    // ---- lifecycle
+
+    /** AudioService.onSystemReady(): the system user runs from boot. */
+    void onSystemReady() {
+        synchronized (mLock) {
+            mSystemReady = true;
+            startUserLocked(UserHandle.USER_SYSTEM);
+            pushLocked("system ready");
+        }
+        final IntentFilter filter = new IntentFilter();
+        filter.addAction(Intent.ACTION_PACKAGE_ADDED);
+        filter.addAction(Intent.ACTION_PACKAGE_FULLY_REMOVED);
+        filter.addDataScheme("package");
+        mContext.registerReceiverForAllUsers(mPackageReceiver, filter, null, mHandler);
+    }
+
+    void onUserStarting(@UserIdInt int userId) {
+        synchronized (mLock) {
+            startUserLocked(userId);
+            if (mSystemReady) {
+                pushLocked("user " + userId + " starting");
+            }
+        }
+    }
+
+    void onUserStopped(@UserIdInt int userId) {
+        synchronized (mLock) {
+            if (!mStartedUsers.remove(userId)) {
+                return;
+            }
+            if (mDirtyUsers.remove(userId)) {
+                writeLocked(userId);
+            }
+            mVolumes.unload(userId);
+            if (mSystemReady) {
+                pushLocked("user " + userId + " stopped");
+            }
+        }
+    }
+
+    /** audioserver restarted with an empty table; AudioService restores its uid state now. */
+    void onAudioServerDied() {
+        synchronized (mLock) {
+            if (mSystemReady) {
+                pushLocked("audioserver restarted");
+            }
+        }
+    }
+
+    /** The stream aliases changed, so the set of media streams may have. */
+    void onStreamAliasesChanged() {
+        synchronized (mLock) {
+            if (mSystemReady) {
+                pushLocked("stream aliases changed");
+            }
+        }
+    }
+
+    // ---- API
+
+    /**
+     * @throws IllegalArgumentException for a uid that is not an installed app's in a started
+     *     user, or a percent out of 0..100
+     */
+    void setAppVolume(int uid, int percent) {
+        if (percent < 0 || percent > AppVolumes.DEFAULT_PERCENT) {
+            throw new IllegalArgumentException("percent " + percent + " is not in 0..100");
+        }
+        final AppVolumes.Key key = keyOrThrow(uid);
+        final int userId = AppVolumes.userIdOf(uid);
+        synchronized (mLock) {
+            if (!mStartedUsers.contains(userId)) {
+                throw new IllegalArgumentException("user " + userId + " is not running");
+            }
+            if (!mVolumes.set(userId, key, percent)) {
+                return;
+            }
+            mLogger.enqueue(new EventLogger.StringEvent(
+                    "set user " + userId + " " + key + " " + percent + "% (uid " + uid + ")"));
+            scheduleWriteLocked(userId);
+            if (mSystemReady) {
+                pushLocked(null);
+            }
+        }
+    }
+
+    /**
+     * @throws IllegalArgumentException for a uid that is not an installed app's
+     */
+    int getAppVolume(int uid) {
+        final AppVolumes.Key key = keyOrThrow(uid);
+        synchronized (mLock) {
+            return mVolumes.get(AppVolumes.userIdOf(uid), key);
+        }
+    }
+
+    private AppVolumes.Key keyOrThrow(int uid) {
+        if (!AppVolumes.isAppUid(uid)) {
+            throw new IllegalArgumentException("uid " + uid + " is not an app's");
+        }
+        final AppVolumes.Key key = mResolver.keyOf(uid);
+        if (key == null) {
+            throw new IllegalArgumentException("no package has uid " + uid);
+        }
+        return key;
+    }
+
+    // ---- packages
+
+    private final BroadcastReceiver mPackageReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            final String packageName =
+                    intent.getData() == null ? null : intent.getData().getSchemeSpecificPart();
+            final int extraUid = intent.getIntExtra(Intent.EXTRA_UID, Process.INVALID_UID);
+            final int userId = getSendingUserId();
+            if (packageName == null || extraUid == Process.INVALID_UID || userId < 0) {
+                return;
+            }
+            final int uid = UserHandle.getUid(userId, UserHandle.getAppId(extraUid));
+            if (!AppVolumes.isAppUid(uid)) {
+                return;
+            }
+            final AppVolumes.Key key = AppVolumes.Key.ofPackage(packageName);
+            synchronized (mLock) {
+                if (Intent.ACTION_PACKAGE_FULLY_REMOVED.equals(intent.getAction())) {
+                    // Sent only when the package's data is removed for the user: not for an
+                    // update, not for an archive. A reinstall starts at 100 %.
+                    if (mVolumes.remove(userId, key)) {
+                        mLogger.enqueue(new EventLogger.StringEvent(
+                                "removed user " + userId + " " + key + " (uninstalled)"));
+                        scheduleWriteLocked(userId);
+                        pushLocked(null);
+                    }
+                } else if (mStartedUsers.contains(userId)) {
+                    // Installed (new, or an update): its uid is resolved again for the push.
+                    final AppVolumes.Key current = mResolver.keyOf(uid);
+                    if (current != null && mVolumes.contains(userId, current)) {
+                        pushLocked("package " + packageName + " added in user " + userId);
+                    }
+                }
+            }
+        }
+    };
+
+    // ---- push
+
+    @GuardedBy("mLock")
+    private void pushLocked(@Nullable String reason) {
+        final int[] streams = AppVolumes.mediaStreams(mStreamAlias);
+        final AppVolumes.Push push = mVolumes.push(mStartedUsers, mResolver, streams);
+        final int status = mAudioSystem.setAppVolumes(push.uids, push.gains, push.mediaStreams);
+        mLastPush = push;
+        mLastPushStatus = status;
+        if (status != AudioSystem.SUCCESS) {
+            Slog.w(TAG, "setAppVolumes failed with status " + status + " ("
+                    + push.uids.length + " app(s))");
+            mLogger.enqueue(new EventLogger.StringEvent("push failed, status " + status));
+        } else if (reason != null) {
+            mLogger.enqueue(new EventLogger.StringEvent(
+                    "pushed " + push.uids.length + " app(s): " + reason));
+        }
+    }
+
+    // ---- persistence
+
+    private File fileOf(@UserIdInt int userId) {
+        return new File(Environment.getDataSystemDeDirectory(userId), FILE_NAME);
+    }
+
+    @GuardedBy("mLock")
+    private void startUserLocked(@UserIdInt int userId) {
+        if (!mStartedUsers.add(userId)) {
+            return;
+        }
+        final List<AppVolumes.Entry> entries = read(userId);
+        final int dropped = mVolumes.load(userId, entries);
+        if (dropped > 0) {
+            Slog.w(TAG, "user " + userId + ": " + dropped + " duplicate entries dropped");
+        }
+        if (!entries.isEmpty()) {
+            mLogger.enqueue(new EventLogger.StringEvent(
+                    "loaded user " + userId + ": " + entries.size() + " app(s)"));
+        }
+    }
+
+    /** The user's entries; a missing file is an empty table, a bad one is logged and skipped. */
+    private List<AppVolumes.Entry> read(@UserIdInt int userId) {
+        final List<AppVolumes.Entry> entries = new ArrayList<>();
+        final AtomicFile file = new AtomicFile(fileOf(userId));
+        try (FileInputStream in = file.openRead()) {
+            final TypedXmlPullParser parser = Xml.resolvePullParser(in);
+            XmlUtils.beginDocument(parser, TAG_ROOT);
+            final int depth = parser.getDepth();
+            while (XmlUtils.nextElementWithin(parser, depth)) {
+                if (!TAG_APP.equals(parser.getName())) {
+                    continue;
+                }
+                final AppVolumes.Entry entry = AppVolumes.Entry.parse(
+                        parser.getAttributeValue(null, ATTR_PACKAGE),
+                        parser.getAttributeValue(null, ATTR_SHARED_USER),
+                        parser.getAttributeValue(null, ATTR_PERCENT));
+                if (entry == null) {
+                    Slog.w(TAG, "user " + userId + ": skipped a bad entry in " + FILE_NAME);
+                    continue;
+                }
+                entries.add(entry);
+            }
+        } catch (FileNotFoundException e) {
+            // no shares in this user
+        } catch (IOException | org.xmlpull.v1.XmlPullParserException | RuntimeException e) {
+            // A bad file must not take the system down at boot: the shares are lost, logged.
+            Slog.e(TAG, "user " + userId + ": cannot read " + FILE_NAME + "; starting empty", e);
+            mLogger.enqueue(new EventLogger.StringEvent(
+                    "user " + userId + ": unreadable file ignored: " + e));
+            entries.clear();
+        }
+        return entries;
+    }
+
+    @GuardedBy("mLock")
+    private void scheduleWriteLocked(@UserIdInt int userId) {
+        mDirtyUsers.add(userId);
+        mHandler.removeCallbacks(mPersistRunnable);
+        mHandler.postDelayed(mPersistRunnable, PERSIST_DELAY_MS);
+    }
+
+    private void persistDirtyUsers() {
+        synchronized (mLock) {
+            for (int userId : mDirtyUsers) {
+                writeLocked(userId);
+            }
+            mDirtyUsers.clear();
+        }
+    }
+
+    /** Writes the user's table; an empty table deletes the file. */
+    @GuardedBy("mLock")
+    private void writeLocked(@UserIdInt int userId) {
+        final AtomicFile file = new AtomicFile(fileOf(userId));
+        final List<AppVolumes.Entry> entries = mVolumes.entries(userId);
+        if (entries.isEmpty()) {
+            file.delete();
+            return;
+        }
+        FileOutputStream out = null;
+        try {
+            out = file.startWrite();
+            final TypedXmlSerializer serializer = Xml.resolveSerializer(out);
+            serializer.startDocument(null, true);
+            serializer.startTag(null, TAG_ROOT);
+            serializer.attributeInt(null, ATTR_VERSION, VERSION);
+            for (AppVolumes.Entry entry : entries) {
+                serializer.startTag(null, TAG_APP);
+                serializer.attribute(null,
+                        entry.key.sharedUser ? ATTR_SHARED_USER : ATTR_PACKAGE, entry.key.name);
+                serializer.attribute(null, ATTR_PERCENT, Integer.toString(entry.percent));
+                serializer.endTag(null, TAG_APP);
+            }
+            serializer.endTag(null, TAG_ROOT);
+            serializer.endDocument();
+            file.finishWrite(out);
+        } catch (IOException e) {
+            Slog.e(TAG, "user " + userId + ": cannot write " + FILE_NAME, e);
+            file.failWrite(out);
+        }
+    }
+
+    // ---- dump
+
+    void dump(PrintWriter pw) {
+        pw.println("\nApp volumes (Lujarch per-app media volume):");
+        synchronized (mLock) {
+            pw.println("  media streams: "
+                    + Arrays.toString(AppVolumes.mediaStreams(mStreamAlias)));
+            pw.println("  started users: " + mStartedUsers);
+            printTableLocked(pw, "  ");
+            if (mLastPush != null) {
+                pw.println("  last push: " + mLastPush.uids.length + " app(s), streams "
+                        + Arrays.toString(mLastPush.mediaStreams) + ", status "
+                        + mLastPushStatus);
+            }
+        }
+        mLogger.dump(pw, "  ");
+    }
+
+    @GuardedBy("mLock")
+    private void printTableLocked(PrintWriter pw, String indent) {
+        for (int userId : mStartedUsers) {
+            for (AppVolumes.Entry e : mVolumes.entries(userId)) {
+                final int uid = mResolver.uidOf(e.key, userId);
+                pw.println(String.format(java.util.Locale.ROOT,
+                        "%suser %d %s percent %d uid %d gain %.4f", indent, userId, e.key,
+                        e.percent, uid, AppVolumes.gainOf(e.percent)));
+            }
+        }
+    }
+}
