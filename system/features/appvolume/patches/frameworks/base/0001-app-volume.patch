+// Lujarch per-app media volume: AudioService's whole table, as uids with their gains.
+static jint android_media_AudioSystem_setAppVolumes(JNIEnv *env, jobject thiz, jintArray uids,
+                                                    jfloatArray volumes,
+                                                    jintArray mediaStreams) {
+    if (uids == nullptr || volumes == nullptr || mediaStreams == nullptr ||
+        env->GetArrayLength(uids) != env->GetArrayLength(volumes)) {
+        return AUDIO_JAVA_BAD_VALUE;
+    }
+    const std::vector<uid_t> nativeUids = convertJIntArrayToUidVector(env, uids);
+    std::vector<float> nativeGains(nativeUids.size());
+    if (!nativeGains.empty()) {
+        env->GetFloatArrayRegion(volumes, 0, static_cast<jsize>(nativeGains.size()),
+                                 nativeGains.data());
+    }
+    std::vector<std::pair<uid_t, float>> nativeVolumes;
+    nativeVolumes.reserve(nativeUids.size());
+    for (size_t i = 0; i < nativeUids.size(); i++) {
+        nativeVolumes.emplace_back(nativeUids[i], nativeGains[i]);
+    }
+    std::vector<audio_stream_type_t> nativeStreams;
+    for (const uid_t stream : convertJIntArrayToUidVector(env, mediaStreams)) {
+        nativeStreams.push_back(static_cast<audio_stream_type_t>(stream));
+    }
+    return nativeToJavaStatus(AudioSystem::setAppVolumes(nativeVolumes, nativeStreams));
+}
