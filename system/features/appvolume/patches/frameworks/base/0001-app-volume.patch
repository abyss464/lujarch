+// the icons the line shows at most; the count names them all
+private const val MAX_LINE_ICONS = 3
+
+/**
+ * Lujarch per-app media volume (VOL-1): under Media, one line with the playing apps' icons and
+ * count, which opens one row per app. There is no line while no app plays. The line is one button; its open or folded state is the owner's choice,
+ * kept in Settings.Secure. The rows open and fold with the panel's own slider transitions, and a
+ * row that appears while they are open enters with the same transition.
+ */
+@Composable
+fun MediaAppVolumes(
+    viewModel: AppVolumesViewModel,
+    sliderColors: PlatformSliderColors,
+    modifier: Modifier = Modifier,
+) {
+    val rows by viewModel.rows.collectAsStateWithLifecycle()
+    val storedExpanded by viewModel.isExpanded.collectAsStateWithLifecycle()
+    val expanded = storedExpanded
+    val visible = rows.isNotEmpty() && expanded != null
+    // Shown at once when the panel opens with apps playing; enters when the first app starts
+    // playing while the panel is open.
+    val lineState = remember { MutableTransitionState(visible) }
+    LaunchedEffect(visible) { lineState.targetState = visible }
+    AnimatedVisibility(
+        visibleState = lineState,
+        modifier = modifier,
+        enter = enterTransition(index = 0, totalCount = 1),
+        exit = ExitTransition.None,
+    ) {
+        if (expanded == null) return@AnimatedVisibility
+        Column(modifier = Modifier.fillMaxWidth()) {
+            AppsLine(
+                rows = rows,
+                isExpanded = expanded,
+                onToggle = { viewModel.onExpandedChanged(!expanded) },
+            )
+            AnimatedVisibility(
+                visible = expanded,
+                label = "MediaAppRows",
+                enter =
+                    expandVertically(animationSpec = tween(durationMillis = EXPAND_DURATION_MILLIS)),
+                exit =
+                    shrinkVertically(
+                        animationSpec = tween(durationMillis = COLLAPSE_DURATION_MILLIS)
+                    ),
+            ) {
+                // the rows there when the rows open ride the opening; later ones enter alone
+                val initialUids = remember { rows.map { it.uid }.toSet() }
+                Column {
+                    rows.forEachIndexed { index, row ->
+                        key(row.uid) {
+                            val rowModifier =
+                                Modifier.animateEnterExit(
+                                    enter =
+                                        if (row.uid in initialUids) {
+                                            enterTransition(index, rows.size)
+                                        } else {
+                                            EnterTransition.None
+                                        },
+                                    exit = exitTransition(index, rows.size),
+                                )
+                            if (row.uid in initialUids) {
+                                AppRow(row, sliderColors, rowModifier)
+                            } else {
+                                val rowState = remember {
+                                    MutableTransitionState(false).apply { targetState = true }
+                                }
+                                AnimatedVisibility(
+                                    visibleState = rowState,
+                                    modifier = rowModifier,
+                                    enter = enterTransition(index, rows.size),
+                                    exit = ExitTransition.None,
+                                ) {
+                                    AppRow(row, sliderColors)
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun AppsLine(
+    rows: List<AppVolumesViewModel.Row>,
+    isExpanded: Boolean,
+    onToggle: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val count = rows.size
+    val actionLabel =
+        stringResource(
+            if (isExpanded) {
+                R.string.lujarch_volume_panel_hide_app_volumes
+            } else {
+                R.string.lujarch_volume_panel_show_app_volumes
+            }
+        )
+    val chevronRotation by
+        animateFloatAsState(
+            targetValue = if (isExpanded) 180f else 0f,
+            animationSpec = tween(durationMillis = EXPAND_DURATION_MILLIS),
+            label = "MediaAppsChevron",
+        )
+    Row(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .height(40.dp)
+                .clickable(onClickLabel = actionLabel, role = Role.Button, onClick = onToggle)
+                .semantics(mergeDescendants = true) {
+                    // TalkBack says whether the rows are open
+                    if (isExpanded) {
+                        collapse(actionLabel) {
+                            onToggle()
+                            true
+                        }
+                    } else {
+                        expand(actionLabel) {
+                            onToggle()
+                            true
+                        }
+                    }
+                },
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        AppIconStack(rows.take(MAX_LINE_ICONS))
+        Text(
+            text = pluralStringResource(R.plurals.lujarch_volume_panel_apps_playing, count, count),
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            maxLines = 1,
+            modifier = Modifier.padding(start = 12.dp).weight(1f),
+        )
+        Box(modifier = Modifier.size(40.dp), contentAlignment = Alignment.Center) {
+            Icon(
+                painter = painterResource(R.drawable.ic_arrow_down_24dp),
+                contentDescription = null,
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.size(20.dp).graphicsLayer { rotationZ = chevronRotation },
+            )
+        }
+    }
+}
+
+/** The apps' icons, overlapping, the first on top, each on a ring of the sheet's colour. */
+@Composable
+private fun AppIconStack(rows: List<AppVolumesViewModel.Row>) {
+    val step = 14.dp
+    Box(modifier = Modifier.width(24.dp + step * (rows.size - 1)).height(24.dp)) {
+        rows.forEachIndexed { index, row ->
+            Box(
+                modifier =
+                    Modifier.offset(x = step * index)
+                        .zIndex((rows.size - index).toFloat())
+                        .size(24.dp)
+                        .background(MaterialTheme.colorScheme.surfaceContainer, CircleShape),
+                contentAlignment = Alignment.Center,
+            ) {
+                Image(
+                    painter = rememberDrawablePainter(row.icon),
+                    contentDescription = null,
+                    modifier = Modifier.size(20.dp),
+                )
+            }
+        }
+    }
+}
+
+/**
+ * One app's row: thinner than a stream's, named in the secondary text style, filled with the
+ * deeper tone of Media's colour; only the app's icon keeps its own colours.
+ */
+@Composable
+private fun AppRow(
+    row: AppVolumesViewModel.Row,
+    sliderColors: PlatformSliderColors,
+    modifier: Modifier = Modifier,
+) {
+    val sliderViewModel = row.slider
+    val sliderState by sliderViewModel.slider.collectAsStateWithLifecycle()
+    VolumeSlider(
+        modifier = modifier.fillMaxWidth(),
+        state = sliderState,
+        onValueChange = { newValue: Float ->
+            sliderViewModel.onValueChanged(sliderState, newValue)
+        },
+        onValueChangeFinished = { sliderViewModel.onValueChangeFinished() },
+        onIconTapped = { sliderViewModel.toggleMuted(sliderState) },
+        sliderColors = sliderColors,
+        hapticsViewModelFactory = sliderViewModel.getSliderHapticsViewModelFactory(),
+        dimensions = VolumeSliderDimensions.App,
+        labelStyle = MaterialTheme.typography.bodyMedium,
+        labelColor = MaterialTheme.colorScheme.onSurfaceVariant,
+        materialSliderColors =
+            VolumeSliderColors.Defaults.copy(
+                activeTrackColor = MaterialTheme.colorScheme.primaryContainer
+            ),
+        keepIconColors = true,
+    )
+}
