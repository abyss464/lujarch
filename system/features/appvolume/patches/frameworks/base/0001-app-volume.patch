+package com.android.systemui.volume.panel.component.volume.appvolume
+
+import com.android.systemui.volume.panel.dagger.scope.VolumePanelScope
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.scan
+import kotlinx.coroutines.flow.stateIn
+
+/**
+ * Lujarch per-app media volume: the volume panel's app rows. Only apps playing on a media
+ * stream get one (the owner's choice); a row that appeared stays until the panel closes, in the
+ * order the rows appeared, so a slider never vanishes under the finger. The list lives and ends
+ * with the panel's scope.
+ */
+@VolumePanelScope
+class AppVolumeInteractor
+@Inject
+constructor(
+    @VolumePanelScope scope: CoroutineScope,
+    private val repository: AppVolumeRepository,
+) {
+    // name and icon per uid, loaded once for the panel's life; touched only by the flow below
+    private val apps = HashMap<Int, AppVolumeApp?>()
+
+    val rows: StateFlow<List<AppVolumeApp>> =
+        repository.playingApps
+            .scan(emptyList<AppVolumeList.PlayingApp>()) { shown, playing ->
+                AppVolumeList.grow(shown, playing)
+            }
+            .distinctUntilChanged()
+            .map { shown ->
+                shown.mapNotNull { app ->
+                    if (app.uid !in apps) apps[app.uid] = repository.appOf(app)
+                    apps[app.uid]
+                }
+            }
+            .distinctUntilChanged()
+            .stateIn(scope, SharingStarted.Eagerly, emptyList())
+
+    suspend fun getAppVolume(uid: Int): Int = repository.getAppVolume(uid)
+
+    suspend fun setAppVolume(uid: Int, percent: Int) = repository.setAppVolume(uid, percent)
+}
