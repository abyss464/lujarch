+package com.android.internal.app;
+
+import android.os.Build;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.SystemProperties;
+
+/**
+ * Play Integrity device profile spoofing and keybox management (INT-1).
+ *
+ * @hide
+ */
+public final class LujarchIntegrity {
+    public static final String SERVICE_NAME = "lujarch_integrity";
+    public static final String PROP_ENABLED = "lujarch.setting.integrity.enabled";
+    public static final String PROP_KEYBOX = "lujarch.setting.integrity.keybox";
+
+    private static final String PROCESS_GMS_UNSTABLE = "com.google.android.gms.unstable";
+    private static final String FINGERPRINT =
+            "google/caiman/caiman:15/BP1A.250505.005/13277524:user/release-keys";
+    private static final String SECURITY_PATCH = "2025-05-05";
+
+    private static volatile boolean sIsGmsUnstable;
+    private static final ThreadLocal<Boolean> sInPropLookup =
+            ThreadLocal.withInitial(() -> Boolean.FALSE);
+
+    private LujarchIntegrity() {}
+
+    public static boolean isEnabled() {
+        return SystemProperties.getBoolean(PROP_ENABLED, true);
+    }
+
+    public static boolean hasKeybox() {
+        return SystemProperties.getBoolean(PROP_KEYBOX, false);
+    }
+
+    /**
+     * Called from {@link android.app.ActivityThread#handleBindApplication} before app code runs.
+     * Returns true when this process is DroidGuard ({@code com.google.android.gms.unstable}) and
+     * Play Integrity spoofing is active.
+     */
+    public static boolean bindProcess(String processName) {
+        if (!PROCESS_GMS_UNSTABLE.equals(processName)) {
+            return false;
+        }
+        sIsGmsUnstable = true;
+        if (!isEnabled()) {
+            return false;
+        }
+        Build.lujarchSpoofPlayIntegrity();
+        return true;
+    }
+
+    public static boolean isSpoofingProcess() {
+        return sIsGmsUnstable && isEnabled();
+    }
+
+    /**
+     * When Play Integrity is enabled and no hardware keybox is imported, block hardware key
+     * attestation in DroidGuard so it falls back to device profile evaluation instead of reading
+     * the bootloader state from the hardware TEE.
+     */
+    public static boolean shouldBlockHardwareAttestation() {
+        return sIsGmsUnstable && isEnabled() && !hasKeybox();
+    }
+
+    /**
+     * Returns a spoofed system property value for DroidGuard, or {@code null} to use the real
+     * property value.
+     */
+    public static String spoofProperty(String key) {
+        if (!sIsGmsUnstable || key == null || sInPropLookup.get()) {
+            return null;
+        }
+        sInPropLookup.set(Boolean.TRUE);
+        try {
+            if (!SystemProperties.getBoolean(PROP_ENABLED, true)) {
+                return null;
+            }
+            switch (key) {
+                case "ro.boot.vbmeta.device_state":
+                    return "locked";
+                case "ro.boot.verifiedbootstate":
+                case "vendor.boot.verifiedbootstate":
+                    return "green";
+                case "ro.boot.flash.locked":
+                    return "1";
+                case "ro.boot.veritymode":
+                    return "enforcing";
+                case "ro.boot.warranty_bit":
+                case "ro.warranty_bit":
+                case "ro.debuggable":
+                    return "0";
+                case "ro.secure":
+                    return "1";
+                case "ro.build.type":
+                case "ro.system.build.type":
+                case "ro.product.build.type":
+                case "ro.vendor.build.type":
+                case "ro.odm.build.type":
+                    return "user";
+                case "ro.build.tags":
+                case "ro.build.keys":
+                case "ro.system.build.tags":
+                case "ro.product.build.tags":
+                case "ro.vendor.build.tags":
+                case "ro.odm.build.tags":
+                    return "release-keys";
+                case "ro.product.first_api_level":
+                    return SystemProperties.getBoolean(PROP_KEYBOX, false) ? "33" : "25";
+                case "ro.build.version.security_patch":
+                case "ro.vendor.build.security_patch":
+                    return SECURITY_PATCH;
+                case "ro.build.fingerprint":
+                case "ro.system.build.fingerprint":
+                case "ro.product.build.fingerprint":
+                case "ro.vendor.build.fingerprint":
+                case "ro.bootimage.build.fingerprint":
+                    return FINGERPRINT;
+                case "ro.product.manufacturer":
+                case "ro.product.system.manufacturer":
+                case "ro.product.vendor.manufacturer":
+                    return "Google";
+                case "ro.product.brand":
+                case "ro.product.system.brand":
+                case "ro.product.vendor.brand":
+                    return "google";
+                case "ro.product.name":
+                case "ro.product.system.name":
+                case "ro.product.vendor.name":
+                case "ro.product.device":
+                case "ro.product.system.device":
+                case "ro.product.vendor.device":
+                    return "caiman";
+                case "ro.product.model":
+                case "ro.product.system.model":
+                case "ro.product.vendor.model":
+                    return "Pixel 9 Pro";
+                default:
+                    return null;
+            }
+        } finally {
+            sInPropLookup.set(Boolean.FALSE);
+        }
+    }
+
+    private static ILujarchIntegrity getService() {
+        final IBinder b = ServiceManager.getService(SERVICE_NAME);
+        return b != null ? ILujarchIntegrity.Stub.asInterface(b) : null;
+    }
+
+    public static LujarchIntegrityStatus getStatus() {
+        final ILujarchIntegrity service = getService();
+        if (service == null) {
+            throw new IllegalStateException("lujarch_integrity service unavailable");
+        }
+        try {
+            return service.getStatus();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public static boolean setKeybox(String xml) {
+        final ILujarchIntegrity service = getService();
+        if (service == null) {
+            throw new IllegalStateException("lujarch_integrity service unavailable");
+        }
+        try {
+            return service.setKeybox(xml);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public static void clearKeybox() {
+        final ILujarchIntegrity service = getService();
+        if (service == null) {
+            throw new IllegalStateException("lujarch_integrity service unavailable");
+        }
+        try {
+            service.clearKeybox();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+}
