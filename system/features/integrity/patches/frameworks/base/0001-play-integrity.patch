+package com.android.server.security;
+
+import android.Manifest;
+import android.content.Context;
+import android.os.FileUtils;
+import android.os.SystemProperties;
+import android.util.AtomicFile;
+import android.util.Slog;
+import android.util.Xml;
+
+import com.android.internal.app.ILujarchIntegrity;
+import com.android.internal.app.LujarchIntegrity;
+import com.android.internal.app.LujarchIntegrityStatus;
+import com.android.server.SystemService;
+
+import org.xmlpull.v1.XmlPullParser;
+
+import java.io.ByteArrayInputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.StringReader;
+import java.nio.charset.StandardCharsets;
+import java.security.cert.CertificateFactory;
+import java.util.Base64;
+
+/**
+ * Manages the imported {@code keybox.xml} for Play Integrity hardware attestation (INT-1).
+ *
+ * @hide
+ */
+public final class LujarchIntegrityService extends ILujarchIntegrity.Stub {
+    private static final String TAG = "LujarchIntegrity";
+    private static final File KEYBOX_FILE = new File("/data/lujarch/integrity/keybox.xml");
+    private static final int MAX_XML_LENGTH = 256 * 1024;
+
+    private final Context mContext;
+    private final Object mLock = new Object();
+    private final AtomicFile mAtomicFile = new AtomicFile(KEYBOX_FILE);
+    private LujarchIntegrityStatus mStatus = emptyStatus();
+
+    public static final class Lifecycle extends SystemService {
+        private LujarchIntegrityService mService;
+
+        public Lifecycle(Context context) {
+            super(context);
+        }
+
+        @Override
+        public void onStart() {
+            mService = new LujarchIntegrityService(getContext());
+            publishBinderService(LujarchIntegrity.SERVICE_NAME, mService);
+        }
+    }
+
+    public LujarchIntegrityService(Context context) {
+        mContext = context;
+        synchronized (mLock) {
+            loadExistingLocked();
+        }
+    }
+
+    @Override
+    public LujarchIntegrityStatus getStatus() {
+        mContext.enforceCallingOrSelfPermission(
+                Manifest.permission.LUJARCH_INTEGRITY, "getStatus");
+        synchronized (mLock) {
+            if (mStatus.hasKeybox && !KEYBOX_FILE.isFile()) {
+                mStatus = emptyStatus();
+            }
+            return copyStatus(mStatus);
+        }
+    }
+
+    @Override
+    public boolean setKeybox(String xml) {
+        mContext.enforceCallingOrSelfPermission(
+                Manifest.permission.LUJARCH_INTEGRITY, "setKeybox");
+        if (xml == null || xml.isEmpty() || xml.length() > MAX_XML_LENGTH) {
+            return false;
+        }
+        final LujarchIntegrityStatus parsed = validateKeyboxXml(xml);
+        if (parsed == null || !parsed.hasKeybox) {
+            return false;
+        }
+        synchronized (mLock) {
+            final File parent = KEYBOX_FILE.getParentFile();
+            if (parent != null && !parent.exists()) {
+                parent.mkdirs();
+            }
+            FileOutputStream out = null;
+            try {
+                out = mAtomicFile.startWrite();
+                out.write(xml.getBytes(StandardCharsets.UTF_8));
+                mAtomicFile.finishWrite(out);
+                KEYBOX_FILE.setReadable(true, false);
+                mStatus = parsed;
+                SystemProperties.set(LujarchIntegrity.PROP_KEYBOX, "1");
+                Slog.i(TAG, "Imported keybox (EC=" + parsed.hasEcKey
+                        + ", RSA=" + parsed.hasRsaKey
+                        + ", certs=" + parsed.certificateCount + ")");
+                return true;
+            } catch (IOException e) {
+                if (out != null) {
+                    mAtomicFile.failWrite(out);
+                }
+                Slog.e(TAG, "Failed to write keybox", e);
+                return false;
+            }
+        }
+    }
+
+    @Override
+    public void clearKeybox() {
+        mContext.enforceCallingOrSelfPermission(
+                Manifest.permission.LUJARCH_INTEGRITY, "clearKeybox");
+        synchronized (mLock) {
+            mAtomicFile.delete();
+            mStatus = emptyStatus();
+            SystemProperties.set(LujarchIntegrity.PROP_KEYBOX, "0");
+            Slog.i(TAG, "Cleared keybox");
+        }
+    }
+
+    private void loadExistingLocked() {
+        if (!KEYBOX_FILE.isFile()) {
+            mStatus = emptyStatus();
+            SystemProperties.set(LujarchIntegrity.PROP_KEYBOX, "0");
+            return;
+        }
+        try {
+            final byte[] bytes = mAtomicFile.readFully();
+            final String xml = new String(bytes, StandardCharsets.UTF_8);
+            final LujarchIntegrityStatus parsed = validateKeyboxXml(xml);
+            if (parsed != null && parsed.hasKeybox) {
+                KEYBOX_FILE.setReadable(true, false);
+                mStatus = parsed;
+                SystemProperties.set(LujarchIntegrity.PROP_KEYBOX, "1");
+                return;
+            }
+        } catch (IOException e) {
+            Slog.w(TAG, "Failed to read existing keybox", e);
+        }
+        mStatus = emptyStatus();
+        SystemProperties.set(LujarchIntegrity.PROP_KEYBOX, "0");
+    }
+
+    private static LujarchIntegrityStatus validateKeyboxXml(String xml) {
+        try {
+            final CertificateFactory certFactory = CertificateFactory.getInstance("X.509");
+            final XmlPullParser parser = Xml.newPullParser();
+            parser.setInput(new StringReader(xml));
+
+            boolean hasEc = false;
+            boolean hasRsa = false;
+            int totalCerts = 0;
+
+            String currentAlgo = null;
+            boolean hasPrivateKey = false;
+            int chainCerts = 0;
+            String currentTag = null;
+            final StringBuilder textBuf = new StringBuilder();
+
+            int event = parser.getEventType();
+            while (event != XmlPullParser.END_DOCUMENT) {
+                if (event == XmlPullParser.START_TAG) {
+                    final String name = parser.getName();
+                    if ("Key".equals(name)) {
+                        currentAlgo = parser.getAttributeValue(null, "algorithm");
+                        hasPrivateKey = false;
+                        chainCerts = 0;
+                    } else if ("PrivateKey".equals(name) || "Certificate".equals(name)) {
+                        currentTag = name;
+                        textBuf.setLength(0);
+                    }
+                } else if (event == XmlPullParser.TEXT) {
+                    if (currentTag != null) {
+                        textBuf.append(parser.getText());
+                    }
+                } else if (event == XmlPullParser.END_TAG) {
+                    final String name = parser.getName();
+                    if ("PrivateKey".equals(name) && "PrivateKey".equals(currentTag)) {
+                        if (!isValidPemPrivateKey(textBuf.toString())) {
+                            return null;
+                        }
+                        hasPrivateKey = true;
+                        currentTag = null;
+                    } else if ("Certificate".equals(name) && "Certificate".equals(currentTag)) {
+                        if (!isValidPemCertificate(certFactory, textBuf.toString())) {
+                            return null;
+                        }
+                        chainCerts++;
+                        currentTag = null;
+                    } else if ("Key".equals(name)) {
+                        if (hasPrivateKey && chainCerts > 0 && currentAlgo != null) {
+                            final String algo = currentAlgo.trim().toLowerCase();
+                            if ("ecdsa".equals(algo) || "ec".equals(algo)) {
+                                hasEc = true;
+                                totalCerts += chainCerts;
+                            } else if ("rsa".equals(algo)) {
+                                hasRsa = true;
+                                totalCerts += chainCerts;
+                            }
+                        }
+                        currentAlgo = null;
+                    }
+                }
+                event = parser.next();
+            }
+
+            if (!hasEc && !hasRsa) {
+                return null;
+            }
+            final LujarchIntegrityStatus status = new LujarchIntegrityStatus();
+            status.hasKeybox = true;
+            status.hasEcKey = hasEc;
+            status.hasRsaKey = hasRsa;
+            status.certificateCount = totalCerts;
+            return status;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static boolean isValidPemPrivateKey(String pem) {
+        if (pem == null) return false;
+        final String trimmed = pem.trim();
+        if (!trimmed.contains("-----BEGIN ") || !trimmed.contains("PRIVATE KEY-----")
+                || !trimmed.contains("-----END ")) {
+            return false;
+        }
+        final StringBuilder b64 = new StringBuilder();
+        for (String line : trimmed.split("\\r?\\n")) {
+            final String s = line.trim();
+            if (!s.isEmpty() && !s.startsWith("-----")) {
+                b64.append(s);
+            }
+        }
+        if (b64.length() < 32) return false;
+        try {
+            final byte[] der = Base64.getDecoder().decode(b64.toString());
+            return der.length > 16 && der[0] == 0x30;
+        } catch (IllegalArgumentException e) {
+            return false;
+        }
+    }
+
+    private static boolean isValidPemCertificate(CertificateFactory cf, String pem) {
+        if (pem == null) return false;
+        final String trimmed = pem.trim();
+        if (!trimmed.contains("-----BEGIN CERTIFICATE-----")
+                || !trimmed.contains("-----END CERTIFICATE-----")) {
+            return false;
+        }
+        try {
+            return cf.generateCertificate(
+                    new ByteArrayInputStream(trimmed.getBytes(StandardCharsets.UTF_8))) != null;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    private static LujarchIntegrityStatus emptyStatus() {
+        final LujarchIntegrityStatus s = new LujarchIntegrityStatus();
+        s.hasKeybox = false;
+        s.hasEcKey = false;
+        s.hasRsaKey = false;
+        s.certificateCount = 0;
+        return s;
+    }
+
+    private static LujarchIntegrityStatus copyStatus(LujarchIntegrityStatus src) {
+        final LujarchIntegrityStatus s = new LujarchIntegrityStatus();
+        s.hasKeybox = src.hasKeybox;
+        s.hasEcKey = src.hasEcKey;
+        s.hasRsaKey = src.hasRsaKey;
+        s.certificateCount = src.certificateCount;
+        return s;
+    }
+}
