+std::string toLowerAscii(std::string s) {
+    for (char& c : s) {
+        c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    }
+    return s;
+}
+
+bool parseKeyboxForAlgorithm(const std::string& xml, int32_t algorithm,
+                             bssl::UniquePtr<EVP_PKEY>* out_pkey,
+                             std::vector<bssl::UniquePtr<X509>>* out_chain) {
+    const bool want_ec = (algorithm == 3);
+    const bool want_rsa = (algorithm == 1);
+    if (!want_ec && !want_rsa) {
+        return false;
+    }
+
+    size_t pos = 0;
+    while (pos < xml.size()) {
+        size_t key_start = xml.find("<Key", pos);
+        if (key_start == std::string::npos) {
+            break;
+        }
+        if (key_start + 4 < xml.size()) {
+            char next = xml[key_start + 4];
+            if (next != ' ' && next != '\t' && next != '\n' && next != '\r' && next != '>') {
+                pos = key_start + 4;
+                continue;
+            }
+        }
+        size_t tag_end = xml.find('>', key_start);
+        if (tag_end == std::string::npos) {
+            break;
+        }
+        size_t key_end = xml.find("</Key>", tag_end);
+        if (key_end == std::string::npos) {
+            break;
+        }
+        std::string key_header = toLowerAscii(xml.substr(key_start, tag_end - key_start));
+        bool matches = false;
+        if (want_ec && (key_header.find("algorithm=\"ecdsa\"") != std::string::npos ||
+                        key_header.find("algorithm='ecdsa'") != std::string::npos ||
+                        key_header.find("algorithm=\"ec\"") != std::string::npos ||
+                        key_header.find("algorithm='ec'") != std::string::npos)) {
+            matches = true;
+        } else if (want_rsa && (key_header.find("algorithm=\"rsa\"") != std::string::npos ||
+                                key_header.find("algorithm='rsa'") != std::string::npos)) {
+            matches = true;
+        }
+
+        if (matches) {
+            std::string body = xml.substr(tag_end + 1, key_end - (tag_end + 1));
+            ArrayEraser body_eraser(reinterpret_cast<uint8_t*>(body.data()), body.size());
+
+            size_t pk_open = body.find("<PrivateKey");
+            size_t pk_gt = (pk_open != std::string::npos) ? body.find('>', pk_open) : std::string::npos;
+            size_t pk_close = (pk_gt != std::string::npos) ? body.find("</PrivateKey>", pk_gt) : std::string::npos;
+            if (pk_close == std::string::npos) {
+                pos = key_end + 6;
+                continue;
+            }
+            std::string pk_pem = body.substr(pk_gt + 1, pk_close - (pk_gt + 1));
+            ArrayEraser pk_eraser(reinterpret_cast<uint8_t*>(pk_pem.data()), pk_pem.size());
+            bssl::UniquePtr<BIO> pk_bio(BIO_new_mem_buf(pk_pem.data(), static_cast<int>(pk_pem.size())));
+            if (!pk_bio) {
+                return false;
+            }
+            bssl::UniquePtr<EVP_PKEY> pkey(
+                    PEM_read_bio_PrivateKey(pk_bio.get(), nullptr, nullptr, nullptr));
+            if (!pkey) {
+                pos = key_end + 6;
+                continue;
+            }
+            const int pkey_id = EVP_PKEY_id(pkey.get());
+            if ((want_ec && pkey_id != EVP_PKEY_EC) || (want_rsa && pkey_id != EVP_PKEY_RSA)) {
+                pos = key_end + 6;
+                continue;
+            }
+
+            std::vector<bssl::UniquePtr<X509>> certs;
+            size_t c_pos = 0;
+            while (c_pos < body.size()) {
+                size_t c_open = body.find("<Certificate", c_pos);
+                if (c_open == std::string::npos) {
+                    break;
+                }
+                if (body.compare(c_open, 17, "<CertificateChain") == 0) {
+                    c_pos = c_open + 17;
+                    continue;
+                }
+                size_t c_gt = body.find('>', c_open);
+                size_t c_close = (c_gt != std::string::npos) ? body.find("</Certificate>", c_gt) : std::string::npos;
+                if (c_close == std::string::npos) {
+                    break;
+                }
+                std::string cert_pem = body.substr(c_gt + 1, c_close - (c_gt + 1));
+                bssl::UniquePtr<BIO> cert_bio(
+                        BIO_new_mem_buf(cert_pem.data(), static_cast<int>(cert_pem.size())));
+                if (!cert_bio) {
+                    return false;
+                }
+                bssl::UniquePtr<X509> cert(
+                        PEM_read_bio_X509(cert_bio.get(), nullptr, nullptr, nullptr));
+                if (!cert) {
+                    certs.clear();
+                    break;
+                }
+                certs.push_back(std::move(cert));
+                c_pos = c_close + 14;
+            }
+
+            if (!certs.empty()) {
+                *out_pkey = std::move(pkey);
+                *out_chain = std::move(certs);
+                return true;
+            }
+        }
+        pos = key_end + 6;
+    }
+    return false;
+}
