+/// Re-signs a leaf attestation certificate with the imported Lujarch keybox and returns
+/// `(leaf_der, concatenated_chain_der)`.
+pub fn lujarch_sign_attestation_chain(
+    algorithm: i32,
+    leaf_in: &[u8],
+) -> Option<(Vec<u8>, Vec<u8>)> {
+    let mut leaf_out = vec![0u8; 16384];
+    let mut leaf_out_len = leaf_out.len();
+    let mut chain_out = vec![0u8; 65536];
+    let mut chain_out_len = chain_out.len();
+    // Safety: all buffers and lengths are valid for the duration of the call.
+    let ok = unsafe {
+        lujarchSignAttestationChain(
+            algorithm,
+            leaf_in.as_ptr(),
+            leaf_in.len(),
+            leaf_out.as_mut_ptr(),
+            &mut leaf_out_len,
+            chain_out.as_mut_ptr(),
+            &mut chain_out_len,
+        )
+    };
+    if !ok || leaf_out_len == 0 || chain_out_len == 0 {
+        return None;
+    }
+    leaf_out.truncate(leaf_out_len);
+    chain_out.truncate(chain_out_len);
+    Some((leaf_out, chain_out))
+}
