+bool isNonZero32(const CBS& cbs) {
+    if (CBS_len(&cbs) != 32) {
+        return false;
+    }
+    const uint8_t* data = CBS_data(&cbs);
+    for (size_t i = 0; i < 32; ++i) {
+        if (data[i] != 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool copyAuthorizationListWithVerifiedRot(CBS* auth_in, CBB* parent_cbb) {
+    CBB auth_cbb;
+    if (!CBB_add_asn1(parent_cbb, &auth_cbb, CBS_ASN1_SEQUENCE)) {
+        return false;
+    }
+    while (CBS_len(auth_in) > 0) {
+        CBS elem;
+        CBS_ASN1_TAG tag = 0;
+        size_t header_len = 0;
+        if (!CBS_get_any_asn1_element(auth_in, &elem, &tag, &header_len)) {
+            return false;
+        }
+        if (tag == kRootOfTrustTag) {
+            const uint8_t* vbk_ptr = kDefaultVerifiedBootKey;
+            const uint8_t* vbh_ptr = kDefaultVerifiedBootHash;
+
+            CBS rot_body = elem;
+            if (CBS_skip(&rot_body, header_len)) {
+                CBS rot_seq;
+                if (CBS_get_asn1(&rot_body, &rot_seq, CBS_ASN1_SEQUENCE)) {
+                    CBS vbk;
+                    if (CBS_get_asn1(&rot_seq, &vbk, CBS_ASN1_OCTETSTRING) && isNonZero32(vbk)) {
+                        vbk_ptr = CBS_data(&vbk);
+                    }
+                    CBS unused;
+                    CBS_ASN1_TAG unused_tag = 0;
+                    if (CBS_get_any_asn1_element(&rot_seq, &unused, &unused_tag, nullptr) &&
+                        CBS_get_any_asn1_element(&rot_seq, &unused, &unused_tag, nullptr)) {
+                        CBS vbh;
+                        if (CBS_len(&rot_seq) > 0 &&
+                            CBS_get_asn1(&rot_seq, &vbh, CBS_ASN1_OCTETSTRING) &&
+                            isNonZero32(vbh)) {
+                            vbh_ptr = CBS_data(&vbh);
+                        }
+                    }
+                }
+            }
+
+            CBB rot_tag_cbb, rot_seq_cbb, enum_cbb;
+            if (!CBB_add_asn1(&auth_cbb, &rot_tag_cbb, kRootOfTrustTag) ||
+                !CBB_add_asn1(&rot_tag_cbb, &rot_seq_cbb, CBS_ASN1_SEQUENCE) ||
+                !CBB_add_asn1_octet_string(&rot_seq_cbb, vbk_ptr, 32) ||
+                !CBB_add_asn1_bool(&rot_seq_cbb, 1) ||
+                !CBB_add_asn1(&rot_seq_cbb, &enum_cbb, CBS_ASN1_ENUMERATED) ||
+                !CBB_add_u8(&enum_cbb, 0) ||
+                !CBB_add_asn1_octet_string(&rot_seq_cbb, vbh_ptr, 32) ||
+                !CBB_flush(&auth_cbb)) {
+                return false;
+            }
+        } else {
+            if (!CBB_add_bytes(&auth_cbb, CBS_data(&elem), CBS_len(&elem))) {
+                return false;
+            }
+        }
+    }
+    return CBB_flush(parent_cbb);
+}
+
+bool patchKeyDescriptionExtension(X509* leaf) {
+    bssl::UniquePtr<ASN1_OBJECT> oid(OBJ_txt2obj(kKeyMintAttestationOid, 1));
+    if (!oid) {
+        return false;
+    }
+    int idx = X509_get_ext_by_OBJ(leaf, oid.get(), -1);
+    if (idx < 0) {
+        return true;
+    }
+    X509_EXTENSION* ext = X509_get_ext(leaf, idx);
+    if (!ext) {
+        return false;
+    }
+    const ASN1_OCTET_STRING* ext_data = X509_EXTENSION_get_data(ext);
+    if (!ext_data || ext_data->length <= 0) {
+        return false;
+    }
+
+    CBS outer, seq;
+    CBS_init(&outer, ASN1_STRING_get0_data(ext_data), static_cast<size_t>(ext_data->length));
+    if (!CBS_get_asn1(&outer, &seq, CBS_ASN1_SEQUENCE)) {
+        return false;
+    }
+
+    bssl::ScopedCBB cbb;
+    CBB out_seq;
+    if (!CBB_init(cbb.get(), static_cast<size_t>(ext_data->length) + 64) ||
+        !CBB_add_asn1(cbb.get(), &out_seq, CBS_ASN1_SEQUENCE)) {
+        return false;
+    }
+
+    // Copy the 6 header fields of KeyDescription verbatim.
+    for (int i = 0; i < 6; ++i) {
+        CBS elem;
+        CBS_ASN1_TAG tag = 0;
+        if (!CBS_get_any_asn1_element(&seq, &elem, &tag, nullptr) ||
+            !CBB_add_bytes(&out_seq, CBS_data(&elem), CBS_len(&elem))) {
+            return false;
+        }
+    }
+
+    CBS sw_enforced, tee_enforced;
+    if (!CBS_get_asn1(&seq, &sw_enforced, CBS_ASN1_SEQUENCE) ||
+        !CBS_get_asn1(&seq, &tee_enforced, CBS_ASN1_SEQUENCE)) {
+        return false;
+    }
+    if (!copyAuthorizationListWithVerifiedRot(&sw_enforced, &out_seq) ||
+        !copyAuthorizationListWithVerifiedRot(&tee_enforced, &out_seq)) {
+        return false;
+    }
+    while (CBS_len(&seq) > 0) {
+        CBS rest;
+        CBS_ASN1_TAG tag = 0;
+        if (!CBS_get_any_asn1_element(&seq, &rest, &tag, nullptr) ||
+            !CBB_add_bytes(&out_seq, CBS_data(&rest), CBS_len(&rest))) {
+            return false;
+        }
+    }
+    if (!CBB_flush(cbb.get())) {
+        return false;
+    }
+
+    bssl::UniquePtr<ASN1_OCTET_STRING> new_oct(ASN1_OCTET_STRING_new());
+    if (!new_oct ||
+        !ASN1_OCTET_STRING_set(new_oct.get(), CBB_data(cbb.get()),
+                               static_cast<int>(CBB_len(cbb.get()))) ||
+        !X509_EXTENSION_set_data(ext, new_oct.get())) {
+        return false;
+    }
+    return true;
+}
