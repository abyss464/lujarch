+bool lujarchSignAttestationChain(int32_t algorithm, const uint8_t* leaf_in, size_t leaf_in_len,
+                                 uint8_t* leaf_out, size_t* leaf_out_len,
+                                 uint8_t* chain_out, size_t* chain_out_len) {
+    if (!leaf_in || leaf_in_len == 0 || !leaf_out || !leaf_out_len || !chain_out || !chain_out_len) {
+        return false;
+    }
+
+    FILE* fp = std::fopen(kLujarchKeyboxPath, "rb");
+    if (!fp) {
+        return false;
+    }
+    std::string xml;
+    uint8_t buf[4096];
+    size_t n = 0;
+    while ((n = std::fread(buf, 1, sizeof(buf), fp)) > 0) {
+        if (xml.size() + n > kMaxKeyboxBytes) {
+            std::fclose(fp);
+            OPENSSL_cleanse(buf, sizeof(buf));
+            OPENSSL_cleanse(xml.data(), xml.size());
+            return false;
+        }
+        xml.append(reinterpret_cast<const char*>(buf), n);
+    }
+    std::fclose(fp);
+    OPENSSL_cleanse(buf, sizeof(buf));
+    ArrayEraser xml_eraser(reinterpret_cast<uint8_t*>(xml.data()), xml.size());
+
+    bssl::UniquePtr<EVP_PKEY> pkey;
+    std::vector<bssl::UniquePtr<X509>> chain;
+    if (!parseKeyboxForAlgorithm(xml, algorithm, &pkey, &chain) || !pkey || chain.empty()) {
+        return false;
+    }
+
+    const uint8_t* p = leaf_in;
+    bssl::UniquePtr<X509> leaf(d2i_X509(nullptr, &p, static_cast<long>(leaf_in_len)));
+    if (!leaf) {
+        return false;
+    }
+
+    X509_NAME* issuer = X509_get_subject_name(chain[0].get());
+    if (!issuer || !X509_set_issuer_name(leaf.get(), issuer)) {
+        return false;
+    }
+
+    int aki_idx = X509_get_ext_by_NID(leaf.get(), NID_authority_key_identifier, -1);
+    while (aki_idx >= 0) {
+        X509_EXTENSION* removed = X509_delete_ext(leaf.get(), aki_idx);
+        X509_EXTENSION_free(removed);
+        aki_idx = X509_get_ext_by_NID(leaf.get(), NID_authority_key_identifier, -1);
+    }
+
+    if (!patchKeyDescriptionExtension(leaf.get())) {
+        return false;
+    }
+
+    if (!X509_sign(leaf.get(), pkey.get(), EVP_sha256())) {
+        return false;
+    }
+
+    int new_leaf_len = i2d_X509(leaf.get(), nullptr);
+    if (new_leaf_len <= 0 || static_cast<size_t>(new_leaf_len) > *leaf_out_len) {
+        return false;
+    }
+    uint8_t* leaf_ptr = leaf_out;
+    if (i2d_X509(leaf.get(), &leaf_ptr) != new_leaf_len) {
+        return false;
+    }
+    *leaf_out_len = static_cast<size_t>(new_leaf_len);
+
+    size_t total_chain_len = 0;
+    for (const auto& cert : chain) {
+        int c_len = i2d_X509(cert.get(), nullptr);
+        if (c_len <= 0 || total_chain_len + static_cast<size_t>(c_len) > *chain_out_len) {
+            return false;
+        }
+        uint8_t* c_ptr = chain_out + total_chain_len;
+        if (i2d_X509(cert.get(), &c_ptr) != c_len) {
+            return false;
+        }
+        total_chain_len += static_cast<size_t>(c_len);
+    }
+    *chain_out_len = total_chain_len;
+    return true;
+}
