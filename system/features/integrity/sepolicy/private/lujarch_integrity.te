type lujarch_integrity_service, service_manager_type;
type lujarch_integrity_data_file, file_type, data_file_type, core_data_file_type;

add_service(system_server, lujarch_integrity_service)
allow platform_app lujarch_integrity_service:service_manager find;
allow system_app lujarch_integrity_service:service_manager find;

allow system_server lujarch_integrity_data_file:dir create_dir_perms;
allow system_server lujarch_integrity_data_file:file create_file_perms;

allow keystore lujarch_integrity_data_file:dir r_dir_perms;
allow keystore lujarch_integrity_data_file:file r_file_perms;
get_prop(keystore, lujarch_setting_prop)

