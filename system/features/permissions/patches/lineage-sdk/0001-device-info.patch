+    /**
+     * Whether the caller may read Lineage settings. The provider is exported with a write
+     * permission only. A uid below 10000, a system or platform-signed app and a holder of
+     * lineageos.permission.WRITE_SECURE_SETTINGS read them; every other app reads them as its
+     * device info permission decides, and a refused app reads nothing (null values, empty
+     * lists and cursors), logged once per uid. A failed lookup allows (logged).
+     */
+    private boolean lujarchMayRead() {
+        final int uid = Binder.getCallingUid();
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return true;
+        }
+        final Context context = getContext();
+        if (context.checkCallingPermission(
+                lineageos.platform.Manifest.permission.WRITE_SECURE_SETTINGS)
+                == PackageManager.PERMISSION_GRANTED) {
+            return true;
+        }
+        String[] packages = null;
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final PackageManager pm = context.getPackageManager();
+            packages = pm.getPackagesForUid(uid);
+            if (packages == null) {
+                Log.w(TAG, "no packages for uid " + uid + "; read allowed");
+                return true;
+            }
+            for (String packageName : packages) {
+                final ApplicationInfo ai = pm.getApplicationInfoAsUser(packageName,
+                        PackageManager.MATCH_UNINSTALLED_PACKAGES, UserHandle.getUserId(uid));
+                if (ai.isSystemApp() || ai.isSignedWithPlatformKey()) {
+                    return true;
+                }
+            }
+        } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+            Log.w(TAG, "read by uid " + uid + " not judged; allowed", e);
+            return true;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        if (!LujarchInfo.refuses(context, LujarchInfo.DEVICE, uid, null, null)) {
+            return true;
+        }
+        synchronized (mLujarchRefusedLogged) {
+            if (!mLujarchRefusedLogged.get(uid)) {
+                mLujarchRefusedLogged.put(uid, true);
+                Log.i(TAG, "reads by uid " + uid + " " + java.util.Arrays.toString(packages)
+                        + " answered empty: device info refused");
+            }
+        }
+        return false;
+    }
