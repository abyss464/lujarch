+int32_t SensorService::lujarchSensorMode(const Sensor& sensor, uid_t uid,
+        const String16& opPackageName) {
+    // Only sensors without a required permission are gated here; permissioned
+    // sensors (body sensors, heart rate, step counter/detector) keep their
+    // stock permission + AppOp checks.
+    if (sensor.getRequiredPermission().length() > 0) {
+        return AppOpsManager::MODE_ALLOWED;
+    }
+    // Guard rails: never restrict root, the system server or the audio server.
+    if (uid == AID_ROOT || isAudioServerOrSystemServerUid(uid)) {
+        return AppOpsManager::MODE_ALLOWED;
+    }
+    // checkOp never throws; a null AppOps service returns MODE_IGNORED. We only
+    // act on an explicit MODE_IGNORED/MODE_ERRORED and treat everything else as
+    // MODE_ALLOWED, so any lookup failure leaves sensors working (fail open).
+    int32_t mode = sAppOpsManager.checkOp(AppOpsManager::OP_LUJARCH_SENSORS, uid, opPackageName);
+    if (mode == AppOpsManager::MODE_IGNORED || mode == AppOpsManager::MODE_ERRORED) {
+        return mode;
+    }
+    return AppOpsManager::MODE_ALLOWED;
+}
+
+void SensorService::noteLujarchSensorUse(const Sensor& sensor, uid_t uid,
+        const String16& opPackageName, const char* message) {
+    if (sensor.getRequiredPermission().length() > 0 || uid == AID_ROOT
+            || isAudioServerOrSystemServerUid(uid)) {
+        return;
+    }
+    sAppOpsManager.noteOp(AppOpsManager::OP_LUJARCH_SENSORS, uid, opPackageName,
+            std::optional<String16>(), String16(message));
+}
+
+bool SensorService::noteLujarchSensorRefusal(const Sensor& sensor, uid_t uid,
+        const String16& opPackageName, const char* message) {
+    if (lujarchSensorMode(sensor, uid, opPackageName) == AppOpsManager::MODE_ALLOWED) {
+        return false;
+    }
+    sAppOpsManager.noteOp(AppOpsManager::OP_LUJARCH_SENSORS, uid, opPackageName,
+            std::optional<String16>(), String16(message));
+    return true;
+}
