+    /**
+     * Whether the basic phone info
+     * refuses the subscription id or slot the binder caller reads through
+     * {@code method} or {@code alias}; refused in any mode, the getter answers its "invalid"
+     * value, as these getters never throw. Only an app's own ISub call is decided: the phone
+     * process asks these for itself all the time, at times with an app's identity still on the
+     * thread, and SubscriptionManager caches the answers for the whole process. An app holding
+     * the Phone permission and uids below 10000 are never refused (LujarchPhoneInfo).
+     */
+    private boolean lujarchRefusesPhoneInfo(@NonNull String method, @Nullable String alias) {
+        final String incoming = sLujarchIncoming.get();
+        if (incoming == null || !(incoming.equals(method) || incoming.equals(alias))) {
+            return false;
+        }
+        return LujarchPhoneInfo.decideCaller(mContext, null, null)
+                != AppOpsManager.MODE_ALLOWED;
+    }
+
+    /**
+     * Apps keep the subscription ids this service answers in
+     * SubscriptionManager's IPC caches; a change of an app's phone info permission or Phone
+     * permission drops every process's cache, so the app's next read takes the new answer
+     * Instead of a refusal cached before the user's choice.
+     */
+    private void lujarchWatchPhoneInfo() {
+        for (String op : new String[] {LujarchInfo.PHONE, AppOpsManager.OPSTR_READ_PHONE_STATE,
+                AppOpsManager.OPSTR_READ_PHONE_NUMBERS}) {
+            try {
+                // One listener per op: AppOps keeps the first op of a reused listener.
+                mAppOpsManager.startWatchingMode(op, null,
+                        new AppOpsManager.OnOpChangedListener() {
+                            @Override
+                            public void onOpChanged(String changedOp, String packageName) {
+                                SubscriptionManager.invalidateSubscriptionManagerServiceCaches();
+                            }
+                        });
+            } catch (RuntimeException e) {
+                loge("lujarchWatchPhoneInfo: " + op + " not watched: " + e);
+            }
+        }
+    }
