+ *
+ * <p>An entry stands next to a package mode of MODE_IGNORED, which every enforcement point
+ * (Java and native) treats as Return empty data; that is the answer until the user answers. An
+ * access the entry holds (AppOpsService decides that under its lock) calls
+ * {@link #requestLocked}, which sends the question to the permission controller as the explicit
+ * broadcast {@link #ACTION_ASK}; no caller waits for an answer. Questions are limited per uid and
+ * op ({@link #MIN_INTERVAL_MS}), and the broadcast is sent from {@link BackgroundThread}, never
+ * under AppOpsService's lock.
+ *
+ * <p>Every method ending in {@code Locked} runs under AppOpsService's lock ({@link #mLock}),
+ * which also guards this object's state. The set is persisted in
+ * {@code /data/system/lujarch_ask.xml} (ops by public name), written on {@link BackgroundThread}
+ * after each change.
+ */
+final class LujarchAsk {
+    private static final String TAG = "LujarchAsk";
+
+    /** The question: an access to the op was answered with empty data and the user is asked. */
+    static final String ACTION_ASK = "org.lujarch.permissions.action.ASK";
+    /** The op's public name; the switch op of the access. */
+    static final String EXTRA_OP = "org.lujarch.permissions.extra.OP";
+    /** The attribution tag of the access, or absent. */
+    static final String EXTRA_ATTRIBUTION_TAG = "org.lujarch.permissions.extra.ATTRIBUTION_TAG";
+    /** Whether the app was on screen when the question left. */
+    static final String EXTRA_FOREGROUND = "org.lujarch.permissions.extra.FOREGROUND";
+    /** Wall-clock time of the access, in milliseconds. */
+    static final String EXTRA_TIME = "org.lujarch.permissions.extra.TIME";
+
+    /** At most one question per uid and op in this interval. */
+    static final long MIN_INTERVAL_MS = 30_000;
+
+    private static final String TAG_ROOT = "lujarch-ask";
+    private static final String TAG_ENTRY = "entry";
+    private static final String ATTR_VERSION = "v";
+    private static final String ATTR_UID = "uid";
+    private static final String ATTR_PACKAGE = "pkg";
+    private static final String ATTR_OP = "op";
+    private static final int VERSION = 1;
+
+    private final Context mContext;
+    /** AppOpsService itself: its lock guards the set, as it guards every mode. */
+    private final Object mLock;
+    private final AtomicFile mFile;
+    private final Handler mHandler = BackgroundThread.getHandler();
+
+    /** uid to package to the switch op codes of its entries. */
+    @GuardedBy("mLock")
+    private final SparseArray<ArrayMap<String, ArraySet<Integer>>> mEntries = new SparseArray<>();
+
+    /** Elapsed realtime of the last question per uid and op ({@link #key}). */
+    @GuardedBy("mLock")
+    private final LongSparseLongArray mLastRequest = new LongSparseLongArray();
+
+    LujarchAsk(@NonNull Context context, @NonNull Object lock, @NonNull File file) {
+        mContext = context;
+        mLock = lock;
+        mFile = new AtomicFile(file, "lujarch_ask");
+        read();
+    }
+
+    private static long key(int uid, int op) {
+        return ((long) uid << 32) | (op & 0xffffffffL);
+    }
+
+    // ---- the set ----
+
+    @GuardedBy("mLock")
+    boolean containsLocked(int uid, @NonNull String packageName, int switchCode) {
+        final ArrayMap<String, ArraySet<Integer>> packages = mEntries.get(uid);
+        if (packages == null) {
+            return false;
+        }
+        final ArraySet<Integer> ops = packages.get(packageName);
+        return ops != null && ops.contains(switchCode);
+    }
+
+    @GuardedBy("mLock")
+    void addLocked(int uid, @NonNull String packageName, int switchCode) {
+        ArrayMap<String, ArraySet<Integer>> packages = mEntries.get(uid);
+        if (packages == null) {
+            packages = new ArrayMap<>();
+            mEntries.put(uid, packages);
+        }
+        ArraySet<Integer> ops = packages.get(packageName);
+        if (ops == null) {
+            ops = new ArraySet<>();
+            packages.put(packageName, ops);
+        }
+        if (ops.add(switchCode)) {
+            Slog.i(TAG, "ask: " + packageName + " (" + uid + ") "
+                    + AppOpsManager.opToPublicName(switchCode));
+            scheduleWriteLocked();
+        }
+    }
+
+    /** Removes one entry; true when there was one. */
+    @GuardedBy("mLock")
+    boolean removeLocked(int uid, @NonNull String packageName, int switchCode, String reason) {
+        final ArrayMap<String, ArraySet<Integer>> packages = mEntries.get(uid);
+        if (packages == null) {
+            return false;
+        }
+        final ArraySet<Integer> ops = packages.get(packageName);
+        if (ops == null || !ops.remove(switchCode)) {
+            return false;
+        }
+        if (ops.isEmpty()) {
+            packages.remove(packageName);
+        }
+        if (packages.isEmpty()) {
+            mEntries.remove(uid);
+        }
+        mLastRequest.delete(key(uid, switchCode));
+        Slog.i(TAG, "ask ended: " + packageName + " (" + uid + ") "
+                + AppOpsManager.opToPublicName(switchCode) + " (" + reason + ")");
+        scheduleWriteLocked();
+        return true;
+    }
+
+    /** A uid mode of the op changed: every package of the uid leaves "ask" for it. */
+    @GuardedBy("mLock")
+    void removeUidOpLocked(int uid, int switchCode, String reason) {
+        final ArrayMap<String, ArraySet<Integer>> packages = mEntries.get(uid);
+        if (packages == null) {
+            return;
+        }
+        for (int i = packages.size() - 1; i >= 0; i--) {
+            removeLocked(uid, packages.keyAt(i), switchCode, reason);
+        }
+    }
+
+    @GuardedBy("mLock")
+    void removePackageLocked(int uid, @NonNull String packageName, String reason) {
+        final ArrayMap<String, ArraySet<Integer>> packages = mEntries.get(uid);
+        final ArraySet<Integer> ops = packages != null ? packages.get(packageName) : null;
+        if (ops == null) {
+            return;
+        }
+        for (int i = ops.size() - 1; i >= 0; i--) {
+            removeLocked(uid, packageName, ops.valueAt(i), reason);
+        }
+    }
+
+    @GuardedBy("mLock")
+    void removeUidLocked(int uid, String reason) {
+        final ArrayMap<String, ArraySet<Integer>> packages = mEntries.get(uid);
+        if (packages == null) {
+            return;
+        }
+        for (int i = packages.size() - 1; i >= 0; i--) {
+            removePackageLocked(uid, packages.keyAt(i), reason);
+        }
+    }
+
+    @GuardedBy("mLock")
+    void removeUserLocked(int userId, String reason) {
+        for (int i = mEntries.size() - 1; i >= 0; i--) {
+            final int uid = mEntries.keyAt(i);
+            if (UserHandle.getUserId(uid) == userId) {
+                removeUidLocked(uid, reason);
+            }
+        }
+    }
+
+    /** One entry of {@link #snapshotLocked}. */
+    record Entry(int uid, @NonNull String packageName, int op) {
+    }
+
+    /** The entries of [uid] (every uid when -1), of [packageName] when not null. */
+    @GuardedBy("mLock")
+    @NonNull
+    List<Entry> snapshotLocked(int uid, @Nullable String packageName) {
+        final ArrayList<Entry> out = new ArrayList<>();
+        for (int i = 0; i < mEntries.size(); i++) {
+            final int entryUid = mEntries.keyAt(i);
+            if (uid != -1 && entryUid != uid) {
+                continue;
+            }
+            final ArrayMap<String, ArraySet<Integer>> packages = mEntries.valueAt(i);
+            for (int j = 0; j < packages.size(); j++) {
+                final String pkg = packages.keyAt(j);
+                if (packageName != null && !packageName.equals(pkg)) {
+                    continue;
+                }
+                final ArraySet<Integer> ops = packages.valueAt(j);
+                for (int k = 0; k < ops.size(); k++) {
+                    out.add(new Entry(entryUid, pkg, ops.valueAt(k)));
+                }
+            }
+        }
+        return out;
+    }
+
+    /**
+     * Drops entries whose package is no longer installed under their uid (removed while the
+     * package broadcasts were not yet watched). PackageManager is asked outside the lock.
+     */
+    void prune() {
+        final List<Entry> entries;
+        synchronized (mLock) {
+            entries = snapshotLocked(-1, null);
+        }
+        if (entries.isEmpty()) {
+            return;
+        }
+        final PackageManagerInternal pmi = LocalServices.getService(PackageManagerInternal.class);
+        if (pmi == null) {
+            return;
+        }
+        final ArrayList<Entry> stale = new ArrayList<>();
+        for (Entry e : entries) {
+            try {
+                final int uid = pmi.getPackageUid(e.packageName(),
+                        PackageManager.MATCH_UNINSTALLED_PACKAGES,
+                        UserHandle.getUserId(e.uid()));
+                if (uid != e.uid()) {
+                    stale.add(e);
+                }
+            } catch (RuntimeException ex) {
+                Slog.w(TAG, "ask: " + e.packageName() + " not checked", ex);
+            }
+        }
+        synchronized (mLock) {
+            for (Entry e : stale) {
+                removeLocked(e.uid(), e.packageName(), e.op(), "package gone");
+            }
+        }
+    }
+
+    // ---- questions ----
+
+    /**
+     * An access to [switchCode] by [packageName] was answered with empty data because of its
+     * entry: asks the user, at most once per {@link #MIN_INTERVAL_MS} per uid and op.
+     * Only bookkeeping happens here; the broadcast goes out on {@link BackgroundThread}.
+     */
+    @GuardedBy("mLock")
+    void requestLocked(int switchCode, int uid, @NonNull String packageName,
+            @Nullable String attributionTag) {
+        final long now = SystemClock.elapsedRealtime();
+        final long k = key(uid, switchCode);
+        final long last = mLastRequest.get(k, -1);
+        if (last >= 0 && now - last < MIN_INTERVAL_MS) {
+            return;
+        }
+        mLastRequest.put(k, now);
+        final long time = System.currentTimeMillis();
+        mHandler.post(() -> send(switchCode, uid, packageName, attributionTag, time));
+    }
+
+    private void send(int switchCode, int uid, @NonNull String packageName,
+            @Nullable String attributionTag, long time) {
+        final String opName = AppOpsManager.opToPublicName(switchCode);
+        try {
+            // The process state now, a few milliseconds after the access. AppOps' own uid state
+            // keeps "top" for a settle time after the app left the screen, which would put a
+            // dialog over whatever came to the front.
+            final ActivityManagerInternal ami =
+                    LocalServices.getService(ActivityManagerInternal.class);
+            final boolean foreground = ami != null
+                    && ami.getUidProcessState(uid) <= ActivityManager.PROCESS_STATE_TOP;
+            final String controller =
+                    mContext.getPackageManager().getPermissionControllerPackageName();
+            final Intent intent = new Intent(ACTION_ASK)
+                    .setPackage(controller)
+                    .addFlags(Intent.FLAG_RECEIVER_FOREGROUND
+                            | Intent.FLAG_INCLUDE_STOPPED_PACKAGES)
+                    .putExtra(EXTRA_OP, opName)
+                    .putExtra(Intent.EXTRA_UID, uid)
+                    .putExtra(Intent.EXTRA_PACKAGE_NAME, packageName)
+                    .putExtra(EXTRA_FOREGROUND, foreground)
+                    .putExtra(EXTRA_TIME, time);
+            if (attributionTag != null) {
+                intent.putExtra(EXTRA_ATTRIBUTION_TAG, attributionTag);
+            }
+            Slog.i(TAG, "asking about " + packageName + " (" + uid + ") " + opName
+                    + (foreground ? " in the foreground" : " in the background"));
+            mContext.sendBroadcastAsUser(intent, UserHandle.getUserHandleForUid(uid));
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "question about " + packageName + " (" + uid + ") " + opName
+                    + " not sent", e);
+        }
+    }
+
+    // ---- persistence ----
+
+    private void read() {
+        final FileInputStream stream;
+        try {
+            stream = mFile.openRead();
+        } catch (FileNotFoundException e) {
+            return;
+        }
+        try (stream) {
+            final TypedXmlPullParser parser = Xml.resolvePullParser(stream);
+            int type;
+            while ((type = parser.next()) != XmlPullParser.END_DOCUMENT) {
+                if (type != XmlPullParser.START_TAG || !TAG_ENTRY.equals(parser.getName())) {
+                    continue;
+                }
+                final int uid = parser.getAttributeInt(null, ATTR_UID, -1);
+                final String pkg = parser.getAttributeValue(null, ATTR_PACKAGE);
+                final String opName = parser.getAttributeValue(null, ATTR_OP);
+                final int op;
+                try {
+                    op = AppOpsManager.strOpToOp(opName);
+                } catch (IllegalArgumentException | NullPointerException e) {
+                    Slog.w(TAG, "ask: unknown op " + opName + " of " + pkg + " dropped");
+                    continue;
+                }
+                if (uid < 0 || pkg == null) {
+                    Slog.w(TAG, "ask: damaged entry dropped");
+                    continue;
+                }
+                ArrayMap<String, ArraySet<Integer>> packages = mEntries.get(uid);
+                if (packages == null) {
+                    packages = new ArrayMap<>();
+                    mEntries.put(uid, packages);
+                }
+                ArraySet<Integer> ops = packages.get(pkg);
+                if (ops == null) {
+                    ops = new ArraySet<>();
+                    packages.put(pkg, ops);
+                }
+                ops.add(AppOpsManager.opToSwitch(op));
+            }
+        } catch (IOException | XmlPullParserException | RuntimeException e) {
+            // A damaged file loses the questions, not the answers: the package modes stay
+            // MODE_IGNORED.
+
+            Slog.e(TAG, "ask: " + mFile.getBaseFile() + " unreadable; no entries", e);
+            mEntries.clear();
+        }
+    }
+
+    @GuardedBy("mLock")
+    private void scheduleWriteLocked() {
+        final List<Entry> entries = snapshotLocked(-1, null);
+        mHandler.post(() -> write(entries));
+    }
+
+    private void write(@NonNull List<Entry> entries) {
+        synchronized (mFile) {
+            FileOutputStream stream = null;
+            try {
+                stream = mFile.startWrite();
+                final TypedXmlSerializer out = Xml.newFastSerializer();
+                out.setOutput(stream, StandardCharsets.UTF_8.name());
+                out.startDocument(null, true);
+                out.startTag(null, TAG_ROOT);
+                out.attributeInt(null, ATTR_VERSION, VERSION);
+                for (Entry e : entries) {
+                    out.startTag(null, TAG_ENTRY);
+                    out.attributeInt(null, ATTR_UID, e.uid());
+                    out.attribute(null, ATTR_PACKAGE, e.packageName());
+                    out.attribute(null, ATTR_OP, AppOpsManager.opToPublicName(e.op()));
+                    out.endTag(null, TAG_ENTRY);
+                }
+                out.endTag(null, TAG_ROOT);
+                out.endDocument();
+                mFile.finishWrite(stream);
+            } catch (IOException | RuntimeException e) {
+                Slog.e(TAG, "ask: " + mFile.getBaseFile() + " not written", e);
+                if (stream != null) {
+                    mFile.failWrite(stream);
+                }
+            }
+        }
+    }
+
+    @GuardedBy("mLock")
+    void dumpLocked(@NonNull PrintWriter pw) {
+        final List<Entry> entries = snapshotLocked(-1, null);
+        pw.println("Lujarch ask (" + entries.size() + "):");
+        for (Entry e : entries) {
+            pw.println("  " + e.uid() + " " + e.packageName() + " "
+                    + AppOpsManager.opToName(e.op()));
+        }
+    }
+}
