+    /**
+     * The "ask" set as package ops (each entry with the package's
+     * stored mode), for [uid] or every uid (-1), for [packageName] when not null.
+     * GET_APP_OPS_STATS unless the caller asks about itself, as getOpsForPackage.
+     */
+    @Override
+    public List<AppOpsManager.PackageOps> getLujarchAsks(int uid, @Nullable String packageName) {
+        enforceGetAppOpsStatsPermissionIfNeeded(uid, packageName);
+        final ArrayMap<String, AppOpsManager.PackageOps> byPackage = new ArrayMap<>();
+        synchronized (this) {
+            for (LujarchAsk.Entry e : mLujarchAsk.snapshotLocked(uid, packageName)) {
+                final String key = e.uid() + ":" + e.packageName();
+                AppOpsManager.PackageOps p = byPackage.get(key);
+                if (p == null) {
+                    p = new AppOpsManager.PackageOps(e.packageName(), e.uid(), new ArrayList<>());
+                    byPackage.put(key, p);
+                }
+                final int mode = mAppOpsCheckingService.getPackageMode(e.packageName(), e.op(),
+                        UserHandle.getUserId(e.uid()));
+                p.getOps().add(new OpEntry(e.op(), mode, Collections.emptyMap()));
+            }
+        }
+        return new ArrayList<>(byPackage.values());
+    }
