+    @Override
+    public void setLujarchAsk(int code, int uid, String packageName, boolean ask) {
+        enforceManageAppOpsModes(Binder.getCallingPid(), Binder.getCallingUid(), uid);
+        verifyIncomingOp(code);
+        Objects.requireNonNull(packageName);
+        final int switchCode = AppOpsManager.opToSwitch(code);
+        if (!ask) {
+            synchronized (this) {
+                mLujarchAsk.removeLocked(uid, packageName, switchCode, "unset");
+            }
+            return;
+        }
+        if (isOpAllowedForUid(uid)) {
+            Slog.w(TAG, "lujarch ask: uid " + uid + " is never restricted; not set");
+            return;
+        }
+        try {
+            verifyAndGetBypass(uid, packageName, null);
+        } catch (SecurityException e) {
+            logVerifyAndGetBypassFailure(uid, e, "setLujarchAsk");
+            return;
+        }
+        setMode(switchCode, uid, packageName, MODE_IGNORED, null, /* lujarchAsk */ true);
+        synchronized (this) {
+            // Only next to a stored MODE_IGNORED: the entry never stands for another answer.
+            if (mAppOpsCheckingService.getPackageMode(packageName, switchCode,
+                    UserHandle.getUserId(uid)) != MODE_IGNORED) {
+                Slog.w(TAG, "lujarch ask: " + packageName + " (" + uid + ") "
+                        + opToPublicName(switchCode) + " not set: the mode was not stored");
+                return;
+            }
+            mLujarchAsk.addLocked(uid, packageName, switchCode);
+        }
+    }
