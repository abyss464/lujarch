+     * refusal by the permission or by a restriction does not ask: answering would change
+     * nothing. The access keeps MODE_IGNORED, return empty data; {@link LujarchAsk} only posts
+     * the question (rate-limited), so no caller waits and no other lock is taken. Called from
+     * the note, start and proxy paths (and the proxied dry run of a proxy start); checks
+     * (checkOperation) never ask, as the system checks modes for its own purposes too.
+     */
+    @GuardedBy("this")
+    private void lujarchAskIfHeldLocked(int code, int switchCode, int uid,
+            @NonNull String packageName, @Nullable String attributionTag,
+            @NonNull UidState uidState, int virtualDeviceId, int resultMode) {
+        if (resultMode != MODE_IGNORED
+                || !mLujarchAsk.containsLocked(uid, packageName, switchCode)) {
+            return;
+        }
+        try {
+            if (mAppOpsCheckingService.getPackageMode(packageName, switchCode,
+                    UserHandle.getUserId(uid)) != MODE_IGNORED) {
+                return;
+            }
+            final int rawUidMode = mAppOpsCheckingService.getUidMode(uid,
+                    getPersistentDeviceIdForOp(virtualDeviceId, switchCode), switchCode);
+            if (rawUidMode != AppOpsManager.opToDefaultMode(switchCode)) {
+                final int uidOnly = uidState.evalMode(code, rawUidMode);
+                if (uidOnly != MODE_ALLOWED && uidOnly != MODE_DEFAULT) {
+                    return;
+                }
+            }
+            mLujarchAsk.requestLocked(switchCode, uid, packageName, attributionTag);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "lujarch ask: " + packageName + " (" + uid + ") not asked", e);
+        }
+    }
+
+    /**
+     * Puts the op of a package into the "ask" set (its package mode becomes MODE_IGNORED, the
+     * answer until the user answers), or takes it out (the entry
