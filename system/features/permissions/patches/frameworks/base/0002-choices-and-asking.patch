+package com.android.server.appop;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.ActivityManager;
+import android.app.ActivityManagerInternal;
+import android.app.AppOpsManager;
+import android.app.BroadcastOptions;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Handler;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.util.LongSparseLongArray;
+import android.util.Slog;
+
+import com.android.internal.os.BackgroundThread;
+import com.android.server.LocalServices;
+
+/**
+ * The questions of "ask every time": a package mode of MODE_DEFAULT on an op
+ * {@link AppOpsManager#isLujarchAskable} names. AppOpsService answers such an access with
+ * MODE_IGNORED and calls {@link #requestLocked}, which sends the question to the permission
+ * controller as the explicit broadcast {@link #ACTION_ASK}; no caller waits for an answer. The
+ * answer the user gives is written as the package's mode. Questions are limited per uid and op
+ * ({@link #MIN_INTERVAL_MS}) and sent from {@link BackgroundThread}, never under AppOpsService's
+ * lock, which guards this object's state.
+ */
+final class LujarchAsk {
+    private static final String TAG = "lujarch_permissions";
+
+    /** The question: an access to the op was answered with empty data and the user is asked. */
+    static final String ACTION_ASK = "org.lujarch.permissions.action.ASK";
+    /** The op's public name; the switch op of the access. */
+    static final String EXTRA_OP = "org.lujarch.permissions.extra.OP";
+    /** Whether the app was on screen when the question left. */
+    static final String EXTRA_FOREGROUND = "org.lujarch.permissions.extra.FOREGROUND";
+
+    /** At most one question per uid and op in this interval. */
+    static final long MIN_INTERVAL_MS = 30_000;
+
+    private final Context mContext;
+    private final Handler mHandler = BackgroundThread.getHandler();
+
+    /** Elapsed realtime of the last question per uid and op. */
+    private final LongSparseLongArray mLastRequest = new LongSparseLongArray();
+
+    LujarchAsk(@NonNull Context context) {
+        mContext = context;
+    }
+
+    /**
+     * An access to [switchCode] by [packageName] was answered with empty data because its package
+     * mode asks: asks the user, at most once per {@link #MIN_INTERVAL_MS} per uid and op. Only
+     * bookkeeping happens here; the broadcast goes out on {@link BackgroundThread}.
+     */
+    void requestLocked(int switchCode, int uid, @NonNull String packageName,
+            @Nullable String attributionTag) {
+        final long now = SystemClock.elapsedRealtime();
+        final long key = ((long) uid << 32) | (switchCode & 0xffffffffL);
+        final long last = mLastRequest.get(key, -1);
+        if (last >= 0 && now - last < MIN_INTERVAL_MS) {
+            return;
+        }
+        mLastRequest.put(key, now);
+        mHandler.post(() -> send(switchCode, uid, packageName));
+    }
+
+    private void send(int switchCode, int uid, @NonNull String packageName) {
+        final String opName = AppOpsManager.opToPublicName(switchCode);
+        try {
+            // The process state now: AppOps' own uid state keeps "top" for a settle time after
+            // the app left the screen, which would put a dialog over whatever came to the front.
+            final ActivityManagerInternal ami =
+                    LocalServices.getService(ActivityManagerInternal.class);
+            final boolean foreground = ami != null
+                    && ami.getUidProcessState(uid) <= ActivityManager.PROCESS_STATE_TOP;
+            final Intent intent = new Intent(ACTION_ASK)
+                    .setPackage(mContext.getPackageManager().getPermissionControllerPackageName())
+                    .addFlags(Intent.FLAG_RECEIVER_FOREGROUND
+                            | Intent.FLAG_INCLUDE_STOPPED_PACKAGES)
+                    .putExtra(EXTRA_OP, opName)
+                    .putExtra(Intent.EXTRA_UID, uid)
+                    .putExtra(Intent.EXTRA_PACKAGE_NAME, packageName)
+                    .putExtra(EXTRA_FOREGROUND, foreground);
+            Slog.i(TAG, "asking about " + packageName + " (" + uid + ") " + opName
+                    + (foreground ? " on screen" : " in the background"));
+            // The question may open a dialog over the app that asked.
+            final BroadcastOptions options = BroadcastOptions.makeBasic();
+            options.setBackgroundActivityStartsAllowed(true);
+            mContext.sendBroadcastAsUser(intent, UserHandle.getUserHandleForUid(uid), null,
+                    options.toBundle());
+
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "question about " + packageName + " (" + uid + ") " + opName
+                    + " not sent", e);
+        }
+    }
+}
