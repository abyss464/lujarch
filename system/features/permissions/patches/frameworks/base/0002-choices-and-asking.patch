+    /**
+     * The mode to evaluate when a uid mode other
+     * than the op's default is set. The permission system owns uid modes; the
+     * user's choice is the package mode. The
+     * result is the stricter of the two, so a restriction holds on
+     * permission-backed ops whose uid mode the permission policy keeps
+     * rewriting. Stock returns the uid mode alone here; while no restrictive
+     * package mode is set the result is the same. Only enforcement uses this
+     * (checkOp, noteOp, startOp and their proxy paths); raw reads keep the
+     * stored modes, which the permission policy synchronizes against. uid 0
+     * and 1000 are never restricted, and a failed lookup keeps the uid mode.
+     */
+    @GuardedBy("this")
+    private int lujarchStricterMode(int uid, int switchCode, @Nullable String packageName,
+            int rawUidMode) {
+        if (packageName == null || isOpAllowedForUid(uid)) {
+            return rawUidMode;
+        }
+        try {
+            final int packageMode = mAppOpsCheckingService.getPackageMode(packageName,
+                    switchCode, UserHandle.getUserId(uid));
+            return lujarchStricterMode(rawUidMode, packageMode,
+                    AppOpsManager.opToDefaultMode(switchCode));
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "lujarch: package mode lookup failed for " + packageName, e);
+            return rawUidMode;
+        }
+    }
+
+    /**
+     * The stricter of a uid mode and a package
+     * mode (errored > ignored > foreground > allowed). A package mode equal to
+     * the op's default, or MODE_DEFAULT, is no opinion. A package mode never
+     * loosens the uid mode: foreground only narrows allowed, and a package
+     * mode never turns MODE_DEFAULT (defer to the permission) into an allow.
+     * PermissionPolicyService keeps the same notion of stricter.
+     */
+    @VisibleForTesting
+    static int lujarchStricterMode(int uidMode, int packageMode, int defaultMode) {
+        if (packageMode == defaultMode || packageMode == MODE_DEFAULT) {
+            return uidMode;
+        }
+        switch (packageMode) {
+            case MODE_ERRORED:
+                return MODE_ERRORED;
+            case MODE_IGNORED:
+                return uidMode == MODE_ERRORED ? MODE_ERRORED : MODE_IGNORED;
+            case MODE_FOREGROUND:
+                return uidMode == MODE_ALLOWED ? MODE_FOREGROUND : uidMode;
+            default:
+                return uidMode;
+        }
+    }
