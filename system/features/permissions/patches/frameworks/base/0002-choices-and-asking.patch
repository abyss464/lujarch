+
+    private static int lujarchModeRank(int mode) {
+        switch (mode) {
+            case MODE_ALLOWED:
+                return 0;
+            case MODE_FOREGROUND:
+                return 1;
+            case MODE_IGNORED:
+                return 2;
+            case AppOpsManager.MODE_ERRORED:
+                return 3;
+            default:
+                return -1;
+        }
+    }
