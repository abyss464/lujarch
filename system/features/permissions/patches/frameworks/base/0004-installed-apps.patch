+            return;
+        }
+        if (!sLujarchLastNotedAt.compareAndSet(idx, last, now)) {
+            return;
+        }
+        final Handler h = sLujarchHandler;
+        if (h != null) {
+            h.post(() -> noteLujarchQuery(callingUid));
+        }
+    }
+
+    /**
+     * The permission hid a package from an app's own visibility
+     * check (the binder caller is the app, as for the note); records when.
+     */
+    private static void noteLujarchHidden(int callingUid) {
+        if (Binder.getCallingUid() != callingUid) {
+            return;
+        }
+        final int idx = UserHandle.getAppId(callingUid) - Process.FIRST_APPLICATION_UID;
+        if (idx >= 0 && idx < sLujarchLastHiddenAt.length()) {
+            sLujarchLastHiddenAt.lazySet(idx, System.currentTimeMillis());
+        }
+    }
+
+    /**
+     * The wall-clock time (ms) OP_LUJARCH_INSTALLED_APPS last
+     * hid a package from the app with this uid's own visibility check, or 0. Per app id:
+     * The permission's mode is per uid and user 0 is the one the user uses.
+     */
+    public static long lujarchLastHiddenAt(int uid) {
+        final int idx = UserHandle.getAppId(uid) - Process.FIRST_APPLICATION_UID;
+        return idx >= 0 && idx < sLujarchLastHiddenAt.length() ? sLujarchLastHiddenAt.get(idx) : 0;
+    }
+
+    private static void noteLujarchQuery(int uid) {
+        final Context context = sLujarchContext;
+        if (context == null) {
+            return;
+        }
+        try {
+            final String[] pkgs = context.getPackageManager().getPackagesForUid(uid);
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            if (pkgs == null || pkgs.length == 0 || appOps == null) {
+                return;
+            }
+            appOps.noteOpNoThrow(AppOpsManager.OP_LUJARCH_INSTALLED_APPS, uid, pkgs[0], null,
+                    "package visibility");
+        } catch (Exception e) {
+            Slog.w(TAG, "lujarch query_packages note failed for uid " + uid, e);
+        }
+    }
+
+    /**
+     * Seed the installed apps mode cache from AppOps
+     * and start watching for mode changes. Any failure leaves the cache empty,
+     * i.e. nothing is enforced (fail open). Runs at system-ready.
+     */
+    protected static void lujarchOnSystemReady() {
+        final Context context = sLujarchContext;
+        if (context == null) {
+            return;
+        }
+        try {
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            if (appOps == null) {
+                return;
+            }
+            // Watch every package's mode; null package means "all packages".
+            appOps.startWatchingMode(AppOpsManager.OP_LUJARCH_INSTALLED_APPS, null,
+                    new AppOpsManager.OnOpChangedListener() {
+                        @Override
+                        public void onOpChanged(@NonNull String op, @NonNull String packageName) {
+                            refreshLujarchQueryMode(packageName, UserHandle.USER_SYSTEM);
+                        }
+
+                        @Override
+                        public void onOpChanged(@NonNull String op, @NonNull String packageName,
+                                int userId) {
+                            refreshLujarchQueryMode(packageName, userId);
+                        }
+                    });
+            // Seed: only packages with a non-default mode need to be cached.
+            // Build a fresh map and publish it once (copy-on-write).
+            final List<AppOpsManager.PackageOps> pkgOps = appOps.getPackagesForOps(
+                    new String[]{AppOpsManager.OPSTR_LUJARCH_INSTALLED_APPS});
+            if (pkgOps != null) {
+                final SparseIntArray next = new SparseIntArray();
+                for (int i = 0; i < pkgOps.size(); i++) {
+                    final AppOpsManager.PackageOps po = pkgOps.get(i);
+                    final List<AppOpsManager.OpEntry> ops = po.getOps();
+                    for (int j = 0; j < ops.size(); j++) {
+                        final AppOpsManager.OpEntry e = ops.get(j);
+                        // The stored mode: "ask every time" hides as Return empty data does.
+                        final int mode = e.getMode() == AppOpsManager.MODE_DEFAULT
+                                ? AppOpsManager.MODE_IGNORED : e.getMode();
+                        if (e.getOp() == AppOpsManager.OP_LUJARCH_INSTALLED_APPS
+                                && mode != AppOpsManager.MODE_ALLOWED) {
+                            next.put(po.getUid(), mode);
+                        }
+                    }
+                }
+                synchronized (sLujarchLock) {
+                    sLujarchQueryModes = next;
+                }
+            }
+            refreshLujarchAllowedAppIds();
+        } catch (Exception e) {
+            Slog.w(TAG, "lujarch query_packages init failed; not enforcing", e);
+        }
+    }
+
+    private static void refreshLujarchQueryMode(String packageName, int userId) {
+        final Context context = sLujarchContext;
+        if (context == null || packageName == null) {
+            return;
+        }
+        try {
+            final PackageManagerInternal pmi =
+                    LocalServices.getService(PackageManagerInternal.class);
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            if (pmi == null || appOps == null) {
+                return;
+            }
+            final int uid = pmi.getPackageUid(packageName, 0, userId);
+            if (uid < 0) {
+                return;
+            }
+            final int mode = appOps.unsafeCheckOpNoThrow(
+                    AppOpsManager.OPSTR_LUJARCH_INSTALLED_APPS, uid, packageName);
+            final boolean changed;
+            synchronized (sLujarchLock) {
+                final int old = sLujarchQueryModes.get(uid, AppOpsManager.MODE_ALLOWED);
+                final int oldEff = (old == AppOpsManager.MODE_DEFAULT)
+                        ? AppOpsManager.MODE_ALLOWED : old;
+                final int newEff = (mode == AppOpsManager.MODE_DEFAULT)
+                        ? AppOpsManager.MODE_ALLOWED : mode;
+                changed = oldEff != newEff;
+                if (changed) {
+                    setLujarchModeLocked(uid, mode);
+                }
+            }
+            if (changed) {
+                // Visibility changed for this caller; drop the memoized package
+                // query results so the new mode takes effect immediately.
+                final int reason = PackageMetrics.INVALIDATION_REASON_APP_FILTER_CHANGE;
+                PackageManagerService.invalidatePackageInfoCache(reason);
+                PackageManagerService.invalidateGetPackagesForUidCache(reason);
+                ApplicationPackageManager.invalidateQueryIntentActivitiesCache();
+                AppOpsManager.invalidateCheckPackageCache();
+                refreshLujarchAllowedAppIds();
+            }
+        } catch (Exception e) {
+            Slog.w(TAG, "lujarch query_packages mode refresh failed for " + packageName, e);
+        }
+    }
+
+    @GuardedBy("sLujarchLock")
+    private static void setLujarchModeLocked(int uid, int mode) {
+        // Copy-on-write: clone, apply, publish. Store only non-default modes so
+        // an unrestricted uid stays absent and reads MODE_ALLOWED.
+        final SparseIntArray next = sLujarchQueryModes.clone();
+        if (mode == AppOpsManager.MODE_ALLOWED || mode == AppOpsManager.MODE_DEFAULT) {
+            next.delete(uid);
+        } else {
+            next.put(uid, mode);
+        }
+        sLujarchQueryModes = next;
+    }
+
+    /**
+     * Recompute the sorted allow-set of appIds a
+     * restricted caller may always see. Runs off the hot path. Each member is
+     * resolved defensively; a member that cannot be resolved is simply omitted.
+     */
+    private static void refreshLujarchAllowedAppIds() {
+        final Context context = sLujarchContext;
+        if (context == null) {
+            return;
+        }
+        final ArraySet<Integer> appIds = new ArraySet<>();
+        final PackageManagerInternal pmi = LocalServices.getService(PackageManagerInternal.class);
+        if (pmi == null) {
+            return;
+        }
+        final int userId = UserHandle.USER_SYSTEM;
+        // Fixed members: GmsCore and GSF.
+        for (String pkg : LUJARCH_ALLOWED_FIXED_PACKAGES) {
+            addLujarchAppId(appIds, pmi, pkg, userId);
+        }
+        // WebView providers: every package the system may pick as the provider
+        // (config_webview_packages); the current one is always among them. Read
+        // from the in-process webviewupdate service: WebViewUpdateManager has no
+        // instance in system_server (getInstance throws and logs a WTF), and
+        // getCurrentWebViewPackage would grant the caller implicit access. The
+        // configured list is static, so it is complete at system-ready, before
+        // WebView preparation picks the current provider.
+        try {
+            final IWebViewUpdateService webViewUpdate = IWebViewUpdateService.Stub.asInterface(
+                    ServiceManager.getService(Context.WEBVIEW_UPDATE_SERVICE));
+            final WebViewProviderInfo[] providers =
+                    webViewUpdate != null ? webViewUpdate.getAllWebViewPackages() : null;
+            if (providers != null) {
+                for (WebViewProviderInfo provider : providers) {
+                    addLujarchAppId(appIds, pmi, provider.packageName, userId);
+                }
+            } else {
+                Slog.w(TAG, "lujarch: no WebView providers known");
+            }
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "lujarch: could not resolve the WebView providers", e);
+        }
+        // Default launcher / home. The default comes from the home role, which
+        // the role service knows for a user only after the user's first unlock;
+        // until then getDefaultHomeActivity falls back to a direct-boot-aware
+        // home in a core uid (Settings' FallbackHome), and the launcher would be
+        // missing until a later refresh. Without a default home in an app uid,
+        // every installed home app counts, found whatever the lock state.
+        try {
+            final ComponentName home = pmi.getDefaultHomeActivity(userId);
+            final int homeUid = home == null ? -1
+                    : pmi.getPackageUid(home.getPackageName(), 0, userId);
+            if (home != null && UserHandle.getAppId(homeUid) >= Process.FIRST_APPLICATION_UID) {
+                addLujarchAppId(appIds, pmi, home.getPackageName(), userId);
+            } else {
+                final Intent homeIntent = new Intent(Intent.ACTION_MAIN)
+                        .addCategory(Intent.CATEGORY_HOME);
+                final List<ResolveInfo> homes = pmi.queryIntentActivities(homeIntent, null,
+                        PackageManager.MATCH_DIRECT_BOOT_AWARE
+                                | PackageManager.MATCH_DIRECT_BOOT_UNAWARE,
+                        Process.SYSTEM_UID, userId);
+                if (homes != null) {
+                    for (int i = 0; i < homes.size(); i++) {
+                        final ResolveInfo ri = homes.get(i);
+                        if (ri.activityInfo != null) {
+                            addLujarchAppId(appIds, pmi, ri.activityInfo.packageName, userId);
+                        }
+                    }
+                }
+            }
+        } catch (Exception e) {
+            Slog.w(TAG, "lujarch: could not resolve default launcher", e);
+        }
+        // Enabled input methods (the current IME is always among them).
+        try {
+            final InputMethodManagerInternal imm =
+                    LocalServices.getService(InputMethodManagerInternal.class);
+            if (imm != null) {
+                final List<InputMethodInfo> imes = imm.getEnabledInputMethodListAsUser(userId);
+                if (imes != null) {
+                    for (int i = 0; i < imes.size(); i++) {
+                        addLujarchAppId(appIds, pmi, imes.get(i).getPackageName(), userId);
+                    }
+                }
+            }
+        } catch (Exception e) {
+            Slog.w(TAG, "lujarch: could not resolve enabled IMEs", e);
+        }
+        final int[] sorted = new int[appIds.size()];
+        for (int i = 0; i < sorted.length; i++) {
+            sorted[i] = appIds.valueAt(i);
+        }
+        Arrays.sort(sorted);
+        sLujarchAllowedAppIds = sorted;
+        sLujarchAllowedRefreshedAt = SystemClock.uptimeMillis();
+    }
+
+    private static void addLujarchAppId(ArraySet<Integer> out, PackageManagerInternal pmi,
+            String packageName, int userId) {
+        if (packageName == null) {
+            return;
+        }
+        try {
+            final int uid = pmi.getPackageUid(packageName, 0, userId);
+            if (uid >= 0) {
+                out.add(UserHandle.getAppId(uid));
+            }
+        } catch (Exception e) {
+            // Package not installed for this user; omit it.
+        }
+    }
