+package com.android.server.lujarch;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.AppOpsManager;
+import android.content.Context;
+import android.content.pm.PackageManagerInternal;
+import android.os.Process;
+import android.os.UserHandle;
+import android.util.Slog;
+
+import com.android.internal.app.LujarchInfo;
+import com.android.server.LocalServices;
+import com.android.server.pm.pkg.PackageStateInternal;
+
+/**
+ * The installed apps permission ({@link AppOpsManager#OPSTR_LUJARCH_INSTALLED_APPS}) over
+ * lists system services build from other apps' components and hand to any app: accounts and
+ * account types (AccountManagerService) and the enabled accessibility services
+ * (AccessibilityManagerService).
+ *
+ * <p>Package visibility (AppsFilter) carries the permission's two levels, so an entry is
+ * judged as package visibility judges its owner, with what stock lists show regardless
+ * of visibility kept where the level keeps it:
+ * <ul>
+ * <li>allowed: stock;</li>
+ * <li>ignored (lenient): the entries of system packages stay; an entry of an app the
+ * owner installed stays only when package visibility shows that app to the caller (the
+ * permission's allow-set, an interaction);</li>
+ * <li>errored (strict): an entry stays only when package visibility shows its owner to
+ * the caller, which at this level is the allow-set alone.</li>
+ * </ul>
+ * At both levels the caller's own entries and those of packages with a uid below 10000
+ * stay, as package visibility shows them.
+ */
+public final class LujarchAppList {
+
+    private static final String TAG = "LujarchAppList";
+
+    private LujarchAppList() {
+    }
+
+    /**
+     * The permission's level for this read of a list: {@link AppOpsManager#MODE_ALLOWED},
+     * {@link AppOpsManager#MODE_IGNORED} (lenient) or {@link AppOpsManager#MODE_ERRORED}
+     * (strict). Notes the op as {@link LujarchInfo#decide} does (at most once a minute per
+     * uid while the mode is unchanged). uid below 10000: allowed. Never throws.
+     */
+    public static int mode(@NonNull Context context, int callingUid,
+            @Nullable String callingPackage) {
+        if (UserHandle.getAppId(callingUid) < Process.FIRST_APPLICATION_UID) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        final int mode = LujarchInfo.decide(context, AppOpsManager.OPSTR_LUJARCH_INSTALLED_APPS,
+                callingUid, callingPackage, null);
+        if (mode == AppOpsManager.MODE_ERRORED) {
+            return AppOpsManager.MODE_ERRORED;
+        }
+        return mode == AppOpsManager.MODE_ALLOWED ? AppOpsManager.MODE_ALLOWED
+                : AppOpsManager.MODE_IGNORED;
+    }
+
+    /**
+     * Whether the entry owned by {@code targetPackage} is left out of a list for the
+     * caller at {@code mode} (from {@link #mode}). An entry without a known owner is left
+     * out at a restricting level. A failed lookup keeps the entry (logged).
+     */
+    public static boolean hides(int mode, @Nullable String targetPackage, int callingUid,
+            int userId) {
+        if (mode == AppOpsManager.MODE_ALLOWED) {
+            return false;
+        }
+        if (targetPackage == null) {
+            return true;
+        }
+        try {
+            final PackageManagerInternal pmi =
+                    LocalServices.getService(PackageManagerInternal.class);
+            final PackageStateInternal target = pmi.getPackageStateInternal(targetPackage);
+            if (target == null) {
+                return true;
+            }
+            final int targetAppId = target.getAppId();
+            if (targetAppId == UserHandle.getAppId(callingUid)
+                    || targetAppId < Process.FIRST_APPLICATION_UID) {
+                return false;
+            }
+            if (mode == AppOpsManager.MODE_IGNORED && target.isSystem()) {
+                return false;
+            }
+            return pmi.filterAppAccess(targetPackage, callingUid, userId);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "installed apps: " + targetPackage + " for uid " + callingUid
+                    + " not judged; kept", e);
+            return false;
+        }
+    }
+
+    /**
+     * {@link #hides} at the caller's level ({@link #mode}), for a single entry; the
+     * caller's level is decided (and noted) for each call.
+     */
+    public static boolean hides(@NonNull Context context, int callingUid,
+            @Nullable String callingPackage, @Nullable String targetPackage, int userId) {
+        final int mode = mode(context, callingUid, callingPackage);
+        return mode != AppOpsManager.MODE_ALLOWED
+                && hides(mode, targetPackage, callingUid, userId);
+    }
+}
