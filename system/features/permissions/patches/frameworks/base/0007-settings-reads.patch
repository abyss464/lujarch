+    private static void lujarchAppendSettingToCursor(MatrixCursor cursor,
+            @Nullable LujarchSettingsPermissions.Reader lujarch, String name, Setting setting,
+            @Nullable ArrayMap<String, String> redactedSettingsMap) {
+        if (setting == null || setting.isNull()) {
