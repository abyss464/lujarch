+        return LujarchSettingsPermissions.opOf(name) != null ? lujarchReader() : null;
+    }
+
+    /** {@link #lujarchReaderForKey} for a read of a whole table, its ops decided up front. */
+    @Nullable
+    private LujarchSettingsPermissions.Reader lujarchReaderForTable(int settingsType) {
+        final LujarchSettingsPermissions.Reader reader = lujarchReader();
+        if (reader != null) {
+            reader.decideTable(settingsType);
