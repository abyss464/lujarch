+package com.android.providers.settings;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.AppOpsManager;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.IPackageManager;
+import android.content.pm.PackageManager;
+import android.os.Binder;
+import android.os.Process;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.util.ArrayMap;
+import android.util.ArraySet;
+import android.util.Slog;
+
+import com.android.internal.app.LujarchInfo;
+
+/**
+ * The settings keys Lujarch's permissions cover. An app's read of a key is answered as the
+ * key's permission decides for that app:
+ * <ul>
+ * <li>basic phone info, network info and device info: {@code null} unless allowed;
+ * Lujarch's own keys (any name starting with {@link #LUJARCH_PREFIX}, in every table) are
+ * device info;</li>
+ * <li>device identifiers (Secure {@code android_id}, the app's SSAID):
+ * {@link #EMPTY_ANDROID_ID} unless allowed;</li>
+ * <li>installed apps (keys naming other apps' components): the entries of packages the
+ * choice leaves out are dropped, in the value's own format.</li>
+ * </ul>
+ * SettingsProvider runs in system_server, so a read of any other key costs one map lookup
+ * and a prefix check.
+ */
+final class LujarchSettingsPermissions {
+
+    private static final String TAG = "lujarch_permissions";
+
+    /** What an app reads for android_id while its device identifiers permission refuses. */
+    static final String EMPTY_ANDROID_ID = "0000000000000000";
+
+    private static final String LUJARCH_PREFIX = "lujarch_";
+
+    private static final String OP_DEVICE_IDS = AppOpsManager.OPSTR_LUJARCH_DEVICE_IDS;
+    private static final String OP_INSTALLED_APPS = AppOpsManager.OPSTR_LUJARCH_INSTALLED_APPS;
+
+    /** Ops a whole-table read decides, per table (the tables' keys below). */
+    private static final String[] GLOBAL_OPS =
+            {LujarchInfo.PHONE, LujarchInfo.NETWORK, LujarchInfo.DEVICE};
+    private static final String[] SECURE_OPS =
+            {LujarchInfo.DEVICE, OP_DEVICE_IDS, OP_INSTALLED_APPS};
+    private static final String[] SYSTEM_OPS = {LujarchInfo.DEVICE};
+
+    /** Key name to the op of its permission. */
+    private static final ArrayMap<String, String> sKeyOps = new ArrayMap<>();
+    /** Keys telephony also keeps per subscription, as the name followed by the id. */
+    private static final ArraySet<String> sPerSubscriptionKeys = new ArraySet<>();
+    /** Installed-app list keys that hold one component or package (null once it is left out). */
+    private static final ArraySet<String> sSingleEntryKeys = new ArraySet<>();
+
+    static {
+        // Phone info (Global).
+        put(LujarchInfo.PHONE, "mobile_data", "data_roaming", "preferred_network_mode",
+                "enable_cellular_on_boot", "multi_sim_voice_call", "multi_sim_voice_prompt",
+                "multi_sim_sms", "multi_sim_sms_prompt", "multi_sim_data_call");
+        sPerSubscriptionKeys.add("mobile_data");
+        sPerSubscriptionKeys.add("data_roaming");
+        sPerSubscriptionKeys.add("preferred_network_mode");
+        // Network info (Global). The proxy's exclusion list and PAC URL belong with its host
+        // and port.
+        put(LujarchInfo.NETWORK, "airplane_mode_on", "wifi_on", "bluetooth_on",
+                "private_dns_mode", "private_dns_specifier", "http_proxy",
+                "global_http_proxy_host", "global_http_proxy_port",
+                "global_http_proxy_exclusion_list", "global_proxy_pac_url");
+        // Device info (Global, then Secure).
+        put(LujarchInfo.DEVICE, "device_name", "boot_count", "adb_enabled", "adb_wifi_enabled",
+                "development_settings_enabled", "usb_mass_storage_enabled",
+                "lock_screen_owner_info", "bluetooth_name", "bluetooth_address");
+        // Device identifiers (Secure): the SSAID as the app reads it.
+        put(OP_DEVICE_IDS, "android_id");
+        // Installed apps (Secure): keys naming the apps the user enabled for a role or
+        // service. Lists are ':'-separated; an entry is a component ("pkg/cls"), an input
+        // method id with its subtypes ("pkg/cls;subtype;subtype") or a package.
+        put(OP_INSTALLED_APPS, "default_input_method", "enabled_input_methods",
+                "disabled_system_input_methods", "enabled_accessibility_services",
+                "enabled_notification_listeners", "autofill_service", "credential_service",
+                "credential_service_primary", "voice_interaction_service",
+                "voice_recognition_service", "assistant", "selected_spell_checker",
+                "sms_default_application", "dialer_default_application",
+                "enabled_vr_listeners");
+        for (String key : new String[] {"default_input_method", "autofill_service",
+                "voice_interaction_service", "voice_recognition_service", "assistant",
+                "selected_spell_checker", "sms_default_application",
+                "dialer_default_application"}) {
+            sSingleEntryKeys.add(key);
+        }
+    }
+
+    private static void put(String op, String... keys) {
+        for (String key : keys) {
+            sKeyOps.put(key, op);
+        }
+    }
+
+    private LujarchSettingsPermissions() {
+    }
+
+    /** The op of the permission that covers this key, or null. */
+    @Nullable
+    static String opOf(@Nullable String name) {
+        if (name == null) {
+            return null;
+        }
+        final String op = sKeyOps.get(name);
+        if (op != null) {
+            return op;
+        }
+        if (name.startsWith(LUJARCH_PREFIX)) {
+            return LujarchInfo.DEVICE;
+        }
+        // "mobile_data1": a per-subscription copy. Most keys do not end in a digit.
+        final int length = name.length();
+        if (length == 0 || !Character.isDigit(name.charAt(length - 1))) {
+            return null;
+        }
+        int end = length - 1;
+        while (end > 0 && Character.isDigit(name.charAt(end - 1))) {
+            end--;
+        }
+        final String base = name.substring(0, end);
+        return sPerSubscriptionKeys.contains(base) ? sKeyOps.get(base) : null;
+    }
+
+    /**
+     * One read by an app the permissions cover (an app uid, neither a system app nor
+     * platform-signed: the callers SettingsProvider's own read checks exempt are not
+     * checked here either). Used on the binder thread of the read, with the caller's
+     * identity.
+     */
+    static final class Reader {
+        private static final long LOOKUP_FLAGS = PackageManager.MATCH_DISABLED_COMPONENTS
+                | PackageManager.MATCH_DIRECT_BOOT_AWARE
+                | PackageManager.MATCH_DIRECT_BOOT_UNAWARE
+                | PackageManager.MATCH_UNINSTALLED_PACKAGES;
+
+        private final Context mContext;
+        private final IPackageManager mPackageManager;
+        private final int mUid;
+        private final String mPackage;
+        private final String mAttributionTag;
+        private final int mUserId;
+        private final ArrayMap<String, Integer> mModes = new ArrayMap<>();
+        private final ArrayMap<String, Boolean> mKeptPackages = new ArrayMap<>();
+
+        Reader(@NonNull Context context, @NonNull IPackageManager packageManager, int uid,
+                @Nullable String packageName, @Nullable String attributionTag) {
+            mContext = context;
+            mPackageManager = packageManager;
+            mUid = uid;
+            mPackage = packageName;
+            mAttributionTag = attributionTag;
+            mUserId = UserHandle.getUserId(uid);
+        }
+
+        /**
+         * Decides the ops of a whole table up front, so a read of the table under the
+         * provider's lock makes no AppOps call. Each is noted, as the app reads every key.
+         */
+        void decideTable(int settingsType) {
+            final String[] ops = switch (settingsType) {
+                case SettingsState.SETTINGS_TYPE_GLOBAL -> GLOBAL_OPS;
+                case SettingsState.SETTINGS_TYPE_SECURE -> SECURE_OPS;
+                default -> SYSTEM_OPS;
+            };
+            for (String op : ops) {
+                mode(op);
+            }
+        }
+
+        private int mode(String op) {
+            Integer mode = mModes.get(op);
+            if (mode == null) {
+                mode = LujarchInfo.decide(mContext, op, mUid, mPackage, mAttributionTag);
+                mModes.put(op, mode);
+            }
+            return mode;
+        }
+
+        /** The value this app reads for the key whose stored value is {@code value}. */
+        @Nullable
+        String answer(@NonNull String name, @Nullable String value) {
+            final String op = opOf(name);
+            if (op == null) {
+                return value;
+            }
+            final int mode = mode(op);
+            if (mode == AppOpsManager.MODE_ALLOWED) {
+                return value;
+            }
+            if (OP_DEVICE_IDS.equals(op)) {
+                return EMPTY_ANDROID_ID;
+            }
+            if (OP_INSTALLED_APPS.equals(op)) {
+                return keptEntries(name, value, mode);
+            }
+            return null;
+        }
+
+        /**
+         * The entries of {@code value} whose package stays visible to this app under its
+         * installed apps choice, joined as stored: Don't allow (errored) shows only the app
+         * itself; anything else not allowed (also while asking) leaves out the apps the user
+         * installed.
+         */
+        @Nullable
+        private String keptEntries(String name, @Nullable String value, int mode) {
+            if (value == null || value.isEmpty()) {
+                return value;
+            }
+            final boolean strict = mode == AppOpsManager.MODE_ERRORED;
+            final StringBuilder kept = new StringBuilder(value.length());
+            for (String entry : value.split(":")) {
+                if (entry.isEmpty()) {
+                    continue;
+                }
+                final int semicolon = entry.indexOf(';');
+                final String id = semicolon >= 0 ? entry.substring(0, semicolon) : entry;
+                final int slash = id.indexOf('/');
+                final String packageName = slash >= 0 ? id.substring(0, slash) : id;
+                if (keeps(packageName, strict)) {
+                    if (kept.length() > 0) {
+                        kept.append(':');
+                    }
+                    kept.append(entry);
+                }
+            }
+            if (kept.length() == 0) {
+                return sSingleEntryKeys.contains(name) ? null : "";
+            }
+            return kept.toString();
+        }
+
+        /**
+         * Whether the package's entries stay: the app's own and those of packages with a
+         * uid below 10000 at both levels, every system package's at the lenient level,
+         * and otherwise what package visibility (AppsFilter, which carries the permission)
+         * shows the app. A failed lookup keeps the entry (logged).
+         */
+        private boolean keeps(String packageName, boolean strict) {
+            final Boolean cached = mKeptPackages.get(packageName);
+            if (cached != null) {
+                return cached;
+            }
+            boolean keep;
+            try {
+                final ApplicationInfo ai;
+                final long token = Binder.clearCallingIdentity();
+                try {
+                    ai = mPackageManager.getApplicationInfo(packageName, LOOKUP_FLAGS,
+                            mUserId);
+                } finally {
+                    Binder.restoreCallingIdentity(token);
+                }
+                if (ai == null) {
+                    keep = false;
+                } else {
+                    final int appId = UserHandle.getAppId(ai.uid);
+                    if (appId == UserHandle.getAppId(mUid)
+                            || appId < Process.FIRST_APPLICATION_UID
+                            || (!strict && ai.isSystemApp())) {
+                        keep = true;
+                    } else {
+                        // Under the caller's identity package visibility answers for it.
+                        keep = mPackageManager.getApplicationInfo(packageName, LOOKUP_FLAGS,
+                                mUserId) != null;
+                    }
+                }
+            } catch (RemoteException | RuntimeException e) {
+                Slog.w(TAG, "installed apps: " + packageName + " for uid " + mUid
+
+                        + " not judged; kept", e);
+                keep = true;
+            }
+            mKeptPackages.put(packageName, keep);
+            return keep;
+        }
+    }
+}
