+            String[] projection, @Nullable ArrayMap<String, String> redactedSettingsMap) {
+        final LujarchSettingsPermissions.Reader lujarch = lujarchReaderForKey(name);
+        if (lujarch == null || setting == null || setting.isNull()) {
+            return packageSettingForQuery(setting, projection, redactedSettingsMap);
+        }
