+        final int callingUid = Binder.getCallingUid();
+        if (UserHandle.getAppId(callingUid) < Process.FIRST_APPLICATION_UID) {
+            return null;
+        }
+        try {
+            final ApplicationInfo ai = getCallingApplicationInfoOrThrow();
+            if (ai.isSystemApp() || ai.isSignedWithPlatformKey()) {
+                return null;
+            }
+            return new LujarchSettingsPermissions.Reader(getContext(), mPackageManager,
+                    callingUid, ai.packageName, getCallingAttributionTag());
+        } catch (RuntimeException e) {
+            Slog.w(LOG_TAG, "Lujarch permissions: settings read by uid " + callingUid
+                    + " not judged; allowed", e);
