+    private static void lujarchKeepVerifiersHoldingAgentPermission(@NonNull Computer snapshot,
+            @NonNull List<String> requiredVerifierPackages, int userId) {
+        try {
+            final List<String> holding = new ArrayList<>();
+            for (String pkg : requiredVerifierPackages) {
+                final int uid = snapshot.getPackageUid(pkg, MATCH_DEBUG_TRIAGED_MISSING, userId);
+                if (uid >= 0 && snapshot.checkUidPermission(
+                        android.Manifest.permission.PACKAGE_VERIFICATION_AGENT, uid)
+                        == PackageManager.PERMISSION_GRANTED) {
+                    holding.add(pkg);
+                }
+            }
+            if (!holding.isEmpty() && holding.size() < requiredVerifierPackages.size()) {
+                Slog.i(TAG, "Required verifiers without PACKAGE_VERIFICATION_AGENT are not"
+                        + " waited for; verifying with " + holding);
+                requiredVerifierPackages.retainAll(holding);
+            }
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "lujarch: verifier permission filter failed, keeping all verifiers", e);
+        }
+    }
