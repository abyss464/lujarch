+package com.android.packageinstaller.lujarch
+
+import android.app.Activity
+import android.app.AlertDialog
+import android.app.AppOpsManager
+import android.app.KeyguardManager
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageInfo
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Bundle
+import android.os.PowerManager
+import android.os.Process
+import android.os.UserHandle
+import android.provider.Settings
+import android.util.Log
+import com.android.packageinstaller.R
+import java.io.File
+import java.util.concurrent.Executors
+
+/**
+ * Install unknown apps set to "Ask every time": every install and update by that app waits for
+ * the user. The system's install verifier reads the installer's choice: Allow lets the install
+ * go on, Don't allow refuses it with a notification, and Ask every time holds it for the wait
+ * the user chose and asks; without an answer in time the install is refused.
+ */
+object LujarchInstalls {
+    const val TAG = "lujarch_permissions"
+    const val OP = "android:lujarch_install"
+    const val SETTING_WAIT = "lujarch_permissions_install_wait_minutes"
+    private const val DEFAULT_WAIT_MINUTES = 10
+    private const val CHANNEL = "lujarch_install"
+
+    const val EXTRA_ID = "org.lujarch.permissions.extra.VERIFICATION_ID"
+    const val EXTRA_INSTALLER = "org.lujarch.permissions.extra.INSTALLER"
+    const val EXTRA_LABEL = "org.lujarch.permissions.extra.LABEL"
+    const val EXTRA_VERSION = "org.lujarch.permissions.extra.VERSION"
+    const val EXTRA_SIGNATURE_CHANGED = "org.lujarch.permissions.extra.SIGNATURE_CHANGED"
+    const val EXTRA_ALLOW = "org.lujarch.permissions.extra.ALLOW"
+    const val ACTION_ANSWER = "org.lujarch.permissions.action.INSTALL_ANSWER"
+
+    val executor = Executors.newSingleThreadExecutor { r -> Thread(r, "lujarch-install") }
+
+    fun waitMillis(context: Context): Long {
+        val minutes = Settings.Global.getInt(context.contentResolver, SETTING_WAIT, DEFAULT_WAIT_MINUTES)
+        return minutes.coerceIn(1, 60) * 60_000L
+    }
+
+    fun channel(context: Context): NotificationManager {
+        val nm = context.getSystemService(NotificationManager::class.java)!!
+        nm.createNotificationChannel(
+            NotificationChannel(CHANNEL, context.getString(R.string.lujarch_install_channel), NotificationManager.IMPORTANCE_HIGH)
+        )
+        return nm
+    }
+
+    fun answer(context: Context, id: Int, allow: Boolean) {
+        context.getSystemService(NotificationManager::class.java)!!.cancel(TAG, id)
+        try {
+            context.packageManager.verifyPendingInstall(
+                id,
+                if (allow) PackageManager.VERIFICATION_ALLOW else PackageManager.VERIFICATION_REJECT,
+            )
+            Log.i(TAG, "install $id ${if (allow) "allowed" else "refused"} by the user")
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "install $id: the answer was not taken", e)
+        }
+    }
+
+    fun notifyRefused(context: Context, installer: CharSequence, app: CharSequence, id: Int) {
+        val n =
+            Notification.Builder(context, CHANNEL)
+                .setSmallIcon(R.drawable.ic_file_download)
+                .setContentTitle(context.getString(R.string.lujarch_install_refused, app))
+                .setContentText(context.getString(R.string.lujarch_install_refused_text, installer))
+                .setAutoCancel(true)
+                .build()
+        channel(context).notify(TAG, id, n)
+    }
+}
+
+/** The system's install verifier. */
+class LujarchInstallVerifier : BroadcastReceiver() {
+    private companion object {
+        // PackageManager's verification extras outside the system API.
+        const val EXTRA_INSTALLER_UID = "android.content.pm.extra.VERIFICATION_INSTALLER_UID"
+        const val EXTRA_INSTALLER_PACKAGE = "android.content.pm.extra.VERIFICATION_INSTALLER_PACKAGE"
+        const val EXTRA_PACKAGE_NAME = "android.content.pm.extra.VERIFICATION_PACKAGE_NAME"
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Intent.ACTION_PACKAGE_NEEDS_VERIFICATION) return
+        val pending = goAsync()
+        LujarchInstalls.executor.execute {
+            try {
+                verify(context.applicationContext, intent)
+            } finally {
+                pending.finish()
+            }
+        }
+    }
+
+    private fun verify(context: Context, intent: Intent) {
+        val id = intent.getIntExtra(PackageManager.EXTRA_VERIFICATION_ID, -1)
+        if (id < 0) return
+        val pm = context.packageManager
+        val installerUid = intent.getIntExtra(EXTRA_INSTALLER_UID, -1)
+        val installer = intent.getStringExtra(EXTRA_INSTALLER_PACKAGE)
+        val packageName = intent.getStringExtra(EXTRA_PACKAGE_NAME)
+        val mode =
+            if (installer == null || UserHandle.getAppId(installerUid) < Process.FIRST_APPLICATION_UID) {
+                AppOpsManager.MODE_ALLOWED
+            } else {
+                try {
+                    context
+                        .getSystemService(AppOpsManager::class.java)!!
+                        .unsafeCheckOpRawNoThrow(LujarchInstalls.OP, installerUid, installer)
+                } catch (e: RuntimeException) {
+                    Log.e(LujarchInstalls.TAG, "install $id: choice of $installer not read; allowed", e)
+                    AppOpsManager.MODE_ALLOWED
+                }
+            }
+        if (mode == AppOpsManager.MODE_ALLOWED || mode == AppOpsManager.MODE_FOREGROUND) {
+            pm.verifyPendingInstall(id, PackageManager.VERIFICATION_ALLOW)
+            return
+        }
+        val archive = archive(pm, intent)
+        val app = archive?.applicationInfo?.loadLabel(pm) ?: packageName ?: "?"
+        val installerLabel =
+            try {
+                pm.getApplicationInfo(installer!!, 0).loadLabel(pm)
+            } catch (e: Exception) {
+                installer ?: "?"
+            }
+        if (mode != AppOpsManager.MODE_DEFAULT) {
+            pm.verifyPendingInstall(id, PackageManager.VERIFICATION_REJECT)
+            Log.i(LujarchInstalls.TAG, "install $id of $packageName by $installer refused")
+            LujarchInstalls.channel(context)
+            LujarchInstalls.notifyRefused(context, installerLabel, app, id)
+            return
+        }
+        // Ask every time: held for the user's wait, refused without an answer.
+        pm.extendVerificationTimeout(id, PackageManager.VERIFICATION_REJECT, LujarchInstalls.waitMillis(context))
+        val installed = packageName?.let { installedInfo(pm, it) }
+        val changed = installed != null && archive != null && signatureChanged(installed, archive)
+        val question =
+            Intent(context, LujarchInstallQuestionActivity::class.java)
+                .putExtra(LujarchInstalls.EXTRA_ID, id)
+                .putExtra(LujarchInstalls.EXTRA_INSTALLER, installerLabel)
+                .putExtra(LujarchInstalls.EXTRA_LABEL, app)
+                .putExtra(LujarchInstalls.EXTRA_VERSION, archive?.versionName)
+                .putExtra(LujarchInstalls.EXTRA_SIGNATURE_CHANGED, changed)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_MULTIPLE_TASK)
+        Log.i(LujarchInstalls.TAG, "install $id of $packageName by $installer: asking")
+        val keyguard = context.getSystemService(KeyguardManager::class.java)!!
+        val power = context.getSystemService(PowerManager::class.java)!!
+        if (power.isInteractive && !keyguard.isKeyguardLocked) {
+            try {
+                context.startActivity(question)
+                return
+            } catch (e: RuntimeException) {
+                Log.w(LujarchInstalls.TAG, "install $id: question not shown as a dialog", e)
+            }
+        }
+        val open = PendingIntent.getActivity(context, id, question, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+        val n =
+            Notification.Builder(context, "lujarch_install")
+                .setSmallIcon(R.drawable.ic_file_download)
+                .setContentTitle(context.getString(R.string.lujarch_install_question, installerLabel, app))
+                .setContentText(context.getString(R.string.lujarch_install_until_answered))
+                .setContentIntent(open)
+                .setVisibility(Notification.VISIBILITY_SECRET)
+                .build()
+        LujarchInstalls.channel(context).notify(LujarchInstalls.TAG, id, n)
+    }
+
+    private fun archive(pm: PackageManager, intent: Intent): PackageInfo? {
+        val path = intent.data?.path ?: return null
+        val file = File(path).let { f ->
+            if (f.isDirectory) f.listFiles()?.firstOrNull { it.name.endsWith(".apk") } else f
+        } ?: return null
+        return try {
+            pm.getPackageArchiveInfo(file.path, PackageManager.PackageInfoFlags.of(PackageManager.GET_SIGNING_CERTIFICATES.toLong()))
+                ?.also {
+                    it.applicationInfo?.sourceDir = file.path
+                    it.applicationInfo?.publicSourceDir = file.path
+                }
+        } catch (e: RuntimeException) {
+            Log.w(LujarchInstalls.TAG, "staged APK not read", e)
+            null
+        }
+    }
+
+    private fun installedInfo(pm: PackageManager, packageName: String): PackageInfo? =
+        try {
+            pm.getPackageInfo(packageName, PackageManager.PackageInfoFlags.of(PackageManager.GET_SIGNING_CERTIFICATES.toLong()))
+        } catch (e: PackageManager.NameNotFoundException) {
+            null
+        }
+
+    private fun signatureChanged(installed: PackageInfo, archive: PackageInfo): Boolean {
+        val a = installed.signingInfo?.apkContentsSigners?.toSet() ?: return false
+        val b = archive.signingInfo?.apkContentsSigners?.toSet() ?: return false
+        return a != b
+    }
+}
+
+/** The question about one install, in the look of the installer's own dialog. */
+class LujarchInstallQuestionActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val id = intent.getIntExtra(LujarchInstalls.EXTRA_ID, -1)
+        if (id < 0) {
+            finish()
+            return
+        }
+        val installer = intent.getCharSequenceExtra(LujarchInstalls.EXTRA_INSTALLER)
+        val app = intent.getCharSequenceExtra(LujarchInstalls.EXTRA_LABEL)
+        val version = intent.getStringExtra(LujarchInstalls.EXTRA_VERSION)
+        val changed = intent.getBooleanExtra(LujarchInstalls.EXTRA_SIGNATURE_CHANGED, false)
+        val lines =
+            listOfNotNull(
+                version?.let { getString(R.string.lujarch_install_version, it) },
+                getString(if (changed) R.string.lujarch_install_signature_changed else R.string.lujarch_install_signature_same),
+            )
+        AlertDialog.Builder(this)
+            .setTitle(getString(R.string.lujarch_install_question, installer, app))
+            .setMessage(lines.joinToString("\n"))
+            .setPositiveButton(R.string.lujarch_install_allow) { _, _ -> LujarchInstalls.answer(this, id, true) }
+            .setNegativeButton(R.string.lujarch_install_deny) { _, _ -> LujarchInstalls.answer(this, id, false) }
+            .setOnDismissListener { finish() }
+            .show()
+    }
+}
