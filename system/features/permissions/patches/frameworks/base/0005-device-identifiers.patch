+    /**
+     * Returns the effective OP_LUJARCH_DEVICE_IDS mode for the caller, or
+     * {@link AppOpsManager#MODE_ALLOWED} when the caller is a core uid (uid 0/1000 or any shared
+     * system uid), no package of the uid can be found, or the AppOps lookup fails, so any failure
+     * keeps device-id reads working (fail open). The op is noted so the access lands in history.
+     */
+    private static int checkLujarchDeviceIdsMode(Context context, int uid, String callingPackage,
+            String callingFeatureId, String message) {
+        try {
+            if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            if (appOps == null) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            String pkg = callingPackage;
+            if (pkg == null) {
+                // The no-argument IDeviceIdentifiersPolicyService.getSerial()
+                // passes no package, and any app can call it directly; attribute
+                // the access to the uid's most restricted package so that path
+                // cannot bypass the permission.
+                pkg = lujarchMostRestrictedPackage(context, appOps, uid);
+                if (pkg == null) {
+                    return AppOpsManager.MODE_ALLOWED;
+                }
+            }
+            int mode = appOps.noteOpNoThrow(AppOpsManager.OPSTR_LUJARCH_DEVICE_IDS, uid,
+                    pkg, callingFeatureId, message);
+            if (mode == AppOpsManager.MODE_IGNORED || mode == AppOpsManager.MODE_ERRORED) {
+                return mode;
+            }
+        } catch (Exception e) {
+            Log.w(LOG_TAG, "lujarch_device_ids check failed, allowing", e);
+        }
+        return AppOpsManager.MODE_ALLOWED;
+    }
+
+    /**
+     * The package of {@code uid} whose
+     * OP_LUJARCH_DEVICE_IDS mode is the most restrictive (errored, then ignored),
+     * or its first package when none is restricted; {@code null} if the uid has
+     * no package. Checks without noting, so only the caller notes once.
+     */
+    private static String lujarchMostRestrictedPackage(Context context, AppOpsManager appOps,
+            int uid) {
+        String[] pkgs = context.getPackageManager().getPackagesForUid(uid);
+        if (pkgs == null || pkgs.length == 0) {
+            return null;
+        }
+        String best = pkgs[0];
+        int bestRank = 0;
+        for (String p : pkgs) {
+            int m = appOps.unsafeCheckOpNoThrow(AppOpsManager.OPSTR_LUJARCH_DEVICE_IDS, uid, p);
+            int rank = m == AppOpsManager.MODE_ERRORED ? 2
+                    : m == AppOpsManager.MODE_IGNORED ? 1 : 0;
+            if (rank > bestRank) {
+                best = p;
+                bestRank = rank;
+            }
+        }
+        return best;
+    }
