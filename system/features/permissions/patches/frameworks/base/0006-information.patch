+
+package com.android.internal.telephony;
+
+import static android.content.pm.PackageManager.PERMISSION_GRANTED;
+
+import android.Manifest;
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.ActivityThread;
+import android.app.AppOpsManager;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Binder;
+import android.os.Process;
+import android.os.UserHandle;
+import android.util.Log;
+
+import com.android.internal.app.LujarchInfo;
+
+/**
+ * Basic phone info ({@link LujarchInfo#PHONE}) for the telephony reads an app reaches without
+ * READ_PHONE_STATE: carrier, its country and code, SIM state, signal strength, network type, data
+ * state and switches, subscription ids, carrier id and name, call state (target SDK 30 or lower)
+ * and the listeners that carry them.
+ *
+ * <p>An app allowed the Phone permission reads as stock: READ_PRIVILEGED_PHONE_STATE, or
+ * READ_PHONE_STATE or READ_PHONE_NUMBERS granted with its op allowed. The permission includes
+ * basic phone info; an app holding it as granted with its op ignored (Return empty data) is
+ * decided by {@link LujarchInfo#PHONE}.
+ *
+ * <p>Callers answer with the API's own "not known" value unless {@link #decide} returns
+ * {@link AppOpsManager#MODE_ALLOWED}; {@link AppOpsManager#MODE_ERRORED} throws only where the
+ * API throws for a missing permission. Uids below 10000 pass, and a failed lookup allows
+ * (logged).
+ */
+public final class LujarchPhoneInfo {
+
+    private static final String TAG = "LujarchPhoneInfo";
+
+    private LujarchPhoneInfo() {
+    }
+
+    /**
+     * The mode for a read by the binder caller. Call before
+     * {@link Binder#clearCallingIdentity()}.
+     *
+     * @param packageName the caller's package as the surrounding code verified it against the
+     *        calling uid, or null to take the uid's first package (never an unverified name:
+     *        AppOps answers a package of another uid with the op's default mode)
+     */
+    public static int decideCaller(@NonNull Context context, @Nullable String packageName,
+            @Nullable String attributionTag) {
+        return decide(context, Binder.getCallingPid(), Binder.getCallingUid(), packageName,
+                attributionTag);
+    }
+
+    /**
+     * The mode for a read inside the app's own process (TelephonyManager's getters
+     * over telephony system properties), attributed to the context's op package and tag.
+     *
+     * @param context the reading context, or null to take the process's application
+     */
+    public static int decideSelf(@Nullable Context context) {
+        final int uid = Process.myUid();
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        final Context ctx = context != null ? context : ActivityThread.currentApplication();
+        if (ctx == null) {
+            Log.w(TAG, "uid " + uid + " read phone info without a context; allowed");
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        return decide(ctx, Process.myPid(), uid, ctx.getOpPackageName(),
+                ctx.getAttributionTag());
+    }
+
+    /** The mode for a read by {@code uid} (listeners decide per delivery). */
+    public static int decide(@NonNull Context context, int pid, int uid,
+            @Nullable String packageName, @Nullable String attributionTag) {
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        final String pkg = packageName != null ? packageName : firstPackage(context, uid);
+        if (holdsPhonePermission(context, pid, uid, pkg)) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        return LujarchInfo.decide(context, LujarchInfo.PHONE, uid, pkg, attributionTag);
+    }
+
+    /**
+     * READ_PRIVILEGED_PHONE_STATE, or READ_PHONE_STATE or READ_PHONE_NUMBERS granted with its
+     * op allowed. Checked without noting: the read is not the permission's access.
+     */
+    private static boolean holdsPhonePermission(Context context, int pid, int uid,
+            @Nullable String pkg) {
+        try {
+            if (context.checkPermission(Manifest.permission.READ_PRIVILEGED_PHONE_STATE, pid,
+                    uid) == PERMISSION_GRANTED) {
+                return true;
+            }
+            final boolean state = context.checkPermission(Manifest.permission.READ_PHONE_STATE,
+                    pid, uid) == PERMISSION_GRANTED;
+            final boolean numbers = context.checkPermission(
+                    Manifest.permission.READ_PHONE_NUMBERS, pid, uid) == PERMISSION_GRANTED;
+            if ((!state && !numbers) || pkg == null) {
+                return false;
+            }
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            if (appOps == null) {
+                return false;
+            }
+            return (state && appOps.unsafeCheckOpNoThrow(AppOpsManager.OPSTR_READ_PHONE_STATE,
+                    uid, pkg) == AppOpsManager.MODE_ALLOWED)
+                    || (numbers && appOps.unsafeCheckOpNoThrow(
+                            AppOpsManager.OPSTR_READ_PHONE_NUMBERS, uid, pkg)
+                            == AppOpsManager.MODE_ALLOWED);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Phone permission of uid " + uid + " not checked", e);
+            return false;
+        }
+    }
+
+    @Nullable
+    private static String firstPackage(Context context, int uid) {
+        try {
+            final PackageManager pm = context.getPackageManager();
+            final String[] packages = pm != null ? pm.getPackagesForUid(uid) : null;
+            return packages != null && packages.length > 0 ? packages[0] : null;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Packages of uid " + uid + " not found", e);
+            return null;
+        }
+    }
+}
