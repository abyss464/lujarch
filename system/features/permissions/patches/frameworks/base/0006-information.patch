+    /**
+     * Whether basic phone info lets this listener receive events of
+     * {@link #LUJARCH_PHONE_INFO_EVENTS}. A refused listener stays registered and gets none of
+     * them (ignored and errored alike: a callback cannot throw); it gets every other event as
+     * stock. Decided at registration and at every delivery, so an answer applies from the next
+     * event; LujarchInfo notes at most once a minute per app and checks the mode in between.
+     * An app holding the Phone permission is not refused (LujarchPhoneInfo).
+     */
+    private boolean lujarchPhoneInfo(Record r) {
+        // Notifiers (the phone process, a carrier app) call in with their own identity; the
+        // decision is about the listener, and system_server notes on its behalf.
+        final long identity = Binder.clearCallingIdentity();
+        try {
+            return LujarchPhoneInfo.decide(mContext, r.callerPid, r.callerUid, r.callingPackage,
+                    r.callingFeatureId) == AppOpsManager.MODE_ALLOWED;
+        } finally {
+            Binder.restoreCallingIdentity(identity);
+        }
+    }
+
+    /** {@link #lujarchPhoneInfo} for a listener of any of {@code events}. */
+    private boolean lujarchPhoneInfo(Record r, Set<Integer> events) {
+        for (int event : LUJARCH_PHONE_INFO_EVENTS) {
+            if (events.contains(event)) {
+                return lujarchPhoneInfo(r);
+            }
+        }
+        return true;
+    }
