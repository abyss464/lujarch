+package com.android.internal.app;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.AppOpsManager;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Process;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.util.Log;
+
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * The decision of an information permission (phone, network or device info) for one read.
+ * Callers in system_server, the phone process and the app's own process ask {@link #decide}
+ * where the information leaves, and answer with the API's own "not known" value unless it
+ * returns {@link AppOpsManager#MODE_ALLOWED}.
+ *
+ * <p>The op is noted at most once a minute per uid and op while it allows, every two seconds
+ * while it refuses (the crash explanation looks three seconds back), and at once when the stored
+ * mode changed since the last note; in between only the mode is checked. Uids below 10000 pass,
+ * and a failed lookup allows (logged).
+ */
+public final class LujarchInfo {
+
+    private static final String TAG = "LujarchInfo";
+
+    /** Basic phone info: carrier, SIM state, signal, network type, data and call state. */
+    public static final String PHONE = "android:lujarch_phone_info";
+    /** Network info: addresses, DNS, proxy, VPN, Wi-Fi link, traffic, radio switches. */
+    public static final String NETWORK = "android:lujarch_network_info";
+    /** Device info: Build identity, battery, USB and audio devices, time zone, device state. */
+    public static final String DEVICE = "android:lujarch_device_info";
+
+    private static final long NOTE_INTERVAL_MS = 60_000L;
+    private static final long REFUSED_NOTE_INTERVAL_MS = 2_000L;
+
+    /** Packages verified to belong to their uid ("uid/package"); a package keeps its uid. */
+    private static final ConcurrentHashMap<String, Boolean> sVerified = new ConcurrentHashMap<>();
+
+    /** Last note per op and uid: elapsed realtime and the stored mode then. */
+    private static final ConcurrentHashMap<String, long[]> sLastNote = new ConcurrentHashMap<>();
+
+    private LujarchInfo() {
+    }
+
+    /**
+     * The permission's mode for this read: {@link AppOpsManager#MODE_ALLOWED},
+     * {@link AppOpsManager#MODE_IGNORED} (answer with empty data) or
+     * {@link AppOpsManager#MODE_ERRORED} (throw where the API can, else empty
+     * data). Never throws.
+     *
+     * @param op one of {@link #PHONE}, {@link #NETWORK}, {@link #DEVICE}
+     * @param uid the reading app's uid
+     * @param packageName its package, or null to take the uid's first package
+     * @param attributionTag its attribution tag, if known
+     */
+    public static int decide(@NonNull Context context, @NonNull String op, int uid,
+            @Nullable String packageName, @Nullable String attributionTag) {
+        if (Process.isSdkSandboxUid(uid)) {
+            // An app's SDK sandbox reads for the app.
+            uid = Process.getAppUidForSdkSandboxUid(uid);
+            packageName = null;
+        }
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        try {
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            if (appOps == null) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            final String pkg = verifiedPackage(context, appOps, uid, packageName);
+            if (pkg == null) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            final int raw = appOps.unsafeCheckOpRawNoThrow(op, uid, pkg);
+            final String key = op + '/' + uid;
+            final long now = SystemClock.elapsedRealtime();
+            final long[] last = sLastNote.get(key);
+            // Foreground-only needs a note to be resolved against the uid's state.
+            final long interval = raw == AppOpsManager.MODE_ALLOWED
+                    ? NOTE_INTERVAL_MS : REFUSED_NOTE_INTERVAL_MS;
+            if (last != null && last[1] == raw && now - last[0] < interval
+                    && raw != AppOpsManager.MODE_FOREGROUND) {
+                return raw == AppOpsManager.MODE_DEFAULT ? AppOpsManager.MODE_IGNORED : raw;
+            }
+            sLastNote.put(key, new long[] {now, raw});
+            final int mode = appOps.noteOpNoThrow(op, uid, pkg, attributionTag, null);
+            return mode == AppOpsManager.MODE_DEFAULT ? AppOpsManager.MODE_IGNORED : mode;
+        } catch (RuntimeException e) {
+            Log.w(TAG, op + " of uid " + uid + " not decided; allowed", e);
+            return AppOpsManager.MODE_ALLOWED;
+        }
+    }
+
+    /**
+     * The permission's stored mode for {@code uid} without noting, for information the system
+     * hands an app without the app asking (its Configuration's mcc and mnc). Ask reads as
+     * refused. Never throws.
+     */
+    public static int peek(@NonNull Context context, @NonNull String op, int uid,
+            @Nullable String packageName) {
+        if (Process.isSdkSandboxUid(uid)) {
+            uid = Process.getAppUidForSdkSandboxUid(uid);
+            packageName = null;
+        }
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        try {
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            final String pkg = appOps != null ? verifiedPackage(context, appOps, uid, packageName)
+                    : null;
+            if (pkg == null) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            final int raw = appOps.unsafeCheckOpRawNoThrow(op, uid, pkg);
+            if (raw == AppOpsManager.MODE_DEFAULT) {
+                return AppOpsManager.MODE_IGNORED;
+            }
+            return raw == AppOpsManager.MODE_FOREGROUND ? AppOpsManager.MODE_ALLOWED : raw;
+        } catch (RuntimeException e) {
+            Log.w(TAG, op + " of uid " + uid + " not read; allowed", e);
+            return AppOpsManager.MODE_ALLOWED;
+        }
+    }
+
+    /** {@link #decide} is anything but {@link AppOpsManager#MODE_ALLOWED}. */
+    public static boolean refuses(@NonNull Context context, @NonNull String op, int uid,
+            @Nullable String packageName, @Nullable String attributionTag) {
+        return decide(context, op, uid, packageName, attributionTag) != AppOpsManager.MODE_ALLOWED;
+    }
+
+    /**
+     * {@code packageName} when it belongs to {@code uid}, else the uid's first
+     * package: AppOps checks a package of another uid against the op's default
+     * (allowed), so a caller's unverified name must not decide.
+     */
+    @Nullable
+    private static String verifiedPackage(Context context, AppOpsManager appOps, int uid,
+            @Nullable String packageName) {
+        if (packageName != null) {
+            final String key = uid + "/" + packageName;
+            if (sVerified.containsKey(key)) {
+                return packageName;
+            }
+            try {
+                appOps.checkPackage(uid, packageName);
+                sVerified.put(key, Boolean.TRUE);
+                return packageName;
+            } catch (SecurityException e) {
+                // Not the uid's: decide by the uid's own package.
+            }
+        }
+        return firstPackage(context, uid);
+    }
+
+    @Nullable
+    private static String firstPackage(Context context, int uid) {
+        final PackageManager pm = context.getPackageManager();
+        final String[] packages = pm != null ? pm.getPackagesForUid(uid) : null;
+        return packages != null && packages.length > 0 ? packages[0] : null;
+    }
+}
