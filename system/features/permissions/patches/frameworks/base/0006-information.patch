+package com.android.server.am;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.AppOpsManager;
+import android.app.BroadcastStickyCache;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ResolveInfo;
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.Process;
+import android.os.UserHandle;
+import android.util.ArrayMap;
+import android.util.Slog;
+
+import com.android.internal.app.LujarchInfo;
+
+/**
+ * The system broadcasts that carry phone,
+ * network or device information to any app that registers for them, delivered without
+ * extras to an app whose permission refuses. The
+ * broadcast itself still arrives, so an app that waits for it keeps working; a sticky one
+ * is still returned by {@code registerReceiver(null, filter)}, and {@code getIntExtra}
+ * answers its default.
+ *
+ * <p>The decision is per receiving app, where the intent is handed over: the broadcast
+ * queue's delivery to a registered or manifest receiver (sticky replays to a new receiver
+ * included) and the sticky intent {@code registerReceiver} returns. Actions outside the
+ * table cost one map lookup; uids below 10000 are never touched.
+ */
+final class LujarchInfoBroadcasts {
+
+    private static final String TAG = "LujarchInfo";
+
+    /** Action to the permission that guards its extras. */
+    private static final ArrayMap<String, String> OPS = new ArrayMap<>();
+
+    static {
+        // Phone info: SIM state, operator names, network country, carrier identity and the
+        // default subscriptions.
+        OPS.put(Intent.ACTION_SIM_STATE_CHANGED, LujarchInfo.PHONE); // sticky
+        OPS.put("android.telephony.action.SERVICE_PROVIDERS_UPDATED", LujarchInfo.PHONE);
+        OPS.put("android.telephony.action.NETWORK_COUNTRY_CHANGED", LujarchInfo.PHONE);
+        OPS.put("android.telephony.action.SUBSCRIPTION_CARRIER_IDENTITY_CHANGED",
+                LujarchInfo.PHONE);
+        OPS.put("android.telephony.action.SUBSCRIPTION_SPECIFIC_CARRIER_IDENTITY_CHANGED",
+                LujarchInfo.PHONE);
+        OPS.put("android.telephony.action.DEFAULT_SUBSCRIPTION_CHANGED", LujarchInfo.PHONE);
+        OPS.put("android.telephony.action.DEFAULT_SMS_SUBSCRIPTION_CHANGED", LujarchInfo.PHONE);
+        OPS.put("android.intent.action.ACTION_DEFAULT_DATA_SUBSCRIPTION_CHANGED",
+                LujarchInfo.PHONE);
+        OPS.put("android.intent.action.ACTION_DEFAULT_VOICE_SUBSCRIPTION_CHANGED",
+                LujarchInfo.PHONE);
+        // Network info: connectivity (the legacy NetworkInfo extras), Wi-Fi, hotspot and
+        // tethering, Bluetooth, NFC and airplane mode state.
+        OPS.put("android.net.conn.CONNECTIVITY_CHANGE", LujarchInfo.NETWORK); // sticky
+        OPS.put("android.net.wifi.WIFI_STATE_CHANGED", LujarchInfo.NETWORK); // sticky
+        OPS.put("android.net.wifi.STATE_CHANGE", LujarchInfo.NETWORK); // sticky
+        OPS.put("android.net.wifi.supplicant.STATE_CHANGE", LujarchInfo.NETWORK); // sticky
+        OPS.put("android.net.wifi.RSSI_CHANGED", LujarchInfo.NETWORK);
+        OPS.put("android.net.wifi.WIFI_AP_STATE_CHANGED", LujarchInfo.NETWORK);
+        OPS.put("android.net.conn.TETHER_STATE_CHANGED", LujarchInfo.NETWORK); // sticky
+        OPS.put("android.bluetooth.adapter.action.STATE_CHANGED", LujarchInfo.NETWORK);
+        OPS.put("android.nfc.action.ADAPTER_STATE_CHANGED", LujarchInfo.NETWORK);
+        OPS.put(Intent.ACTION_AIRPLANE_MODE_CHANGED, LujarchInfo.NETWORK);
+        // Device info: battery, USB and headset state, and the new time zone's id (a refused
+        // app keeps UTC, ActivityThread).
+        OPS.put(Intent.ACTION_BATTERY_CHANGED, LujarchInfo.DEVICE); // sticky
+        OPS.put("android.hardware.usb.action.USB_STATE", LujarchInfo.DEVICE); // sticky
+        OPS.put("android.intent.action.HEADSET_PLUG", LujarchInfo.DEVICE); // sticky
+        OPS.put(Intent.ACTION_TIMEZONE_CHANGED, LujarchInfo.DEVICE);
+    }
+
+    private static volatile boolean sWatching;
+
+    private LujarchInfoBroadcasts() {
+    }
+
+    /**
+     * The intent the broadcast queue hands to {@code receiver} (a {@link BroadcastFilter} or
+     * a manifest receiver's {@link ResolveInfo}): {@code intent} itself, or a copy without
+     * extras when the receiving app's permission for the action refuses.
+     */
+    @Nullable
+    static Intent forReceiver(@NonNull Context context, @Nullable Intent intent,
+            @NonNull Object receiver) {
+        final String op = opOf(intent);
+        if (op == null) {
+            return intent;
+        }
+        try {
+            final int uid;
+            final String packageName;
+            final String attributionTag;
+            if (receiver instanceof BroadcastFilter) {
+                final BroadcastFilter filter = (BroadcastFilter) receiver;
+                uid = filter.owningUid;
+                packageName = filter.packageName;
+                attributionTag = filter.featureId;
+            } else {
+                final ResolveInfo info = (ResolveInfo) receiver;
+                uid = info.activityInfo.applicationInfo.uid;
+                packageName = info.activityInfo.packageName;
+                attributionTag = null;
+            }
+            return decided(context, op, intent, uid, packageName, attributionTag);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "broadcast " + intent.getAction() + " not decided; delivered", e);
+            return intent;
+        }
+    }
+
+    /**
+     * The sticky intent {@code registerReceiver} returns to its binder caller (identified by
+     * {@link Binder#getCallingUid}; the package was checked against the calling process).
+     */
+    @Nullable
+    static Intent forStickyCaller(@NonNull Context context, @Nullable Intent sticky,
+            @Nullable String callerPackage, @Nullable String callerFeatureId) {
+        final String op = opOf(sticky);
+        if (op == null) {
+            return sticky;
+        }
+        try {
+            return decided(context, op, sticky, Binder.getCallingUid(), callerPackage,
+                    callerFeatureId);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "sticky " + sticky.getAction() + " not decided; returned", e);
+            return sticky;
+        }
+    }
+
+    @Nullable
+    private static String opOf(@Nullable Intent intent) {
+        final String action = intent != null ? intent.getAction() : null;
+        return action != null ? OPS.get(action) : null;
+    }
+
+    @NonNull
+    private static Intent decided(@NonNull Context context, @NonNull String op,
+            @NonNull Intent intent, int uid, @Nullable String packageName,
+            @Nullable String attributionTag) {
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return intent;
+        }
+        watchModes(context);
+        if (LujarchInfo.decide(context, op, uid, packageName, attributionTag)
+                == AppOpsManager.MODE_ALLOWED) {
+            return intent;
+        }
+        final Intent stripped = new Intent(intent);
+        stripped.replaceExtras((Bundle) null);
+        return stripped;
+    }
+
+    /**
+     * Apps keep sticky intents in a per-process cache ({@link BroadcastStickyCache}) that is
+     * refreshed only when the sticky broadcast is sent again; a change of a permission's mode
+     * drops the cached intents of its actions, so the app's next registerReceiver asks again
+     * and gets the intent its new mode allows.
+     */
+    private static void watchModes(@NonNull Context context) {
+        if (sWatching) {
+            return;
+        }
+        synchronized (OPS) {
+            if (sWatching) {
+                return;
+            }
+            sWatching = true;
+            final long identity = Binder.clearCallingIdentity();
+            try {
+                final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+                // One listener per op (capturing it, so the instances differ): AppOps keeps
+                // the ops a listener is notified of from its first registration.
+                for (String watched : new String[] {
+                        LujarchInfo.PHONE, LujarchInfo.NETWORK, LujarchInfo.DEVICE}) {
+                    appOps.startWatchingMode(watched, null,
+                            (op, packageName) -> invalidateStickyCaches(watched));
+                }
+            } catch (RuntimeException e) {
+                Slog.w(TAG, "sticky broadcast caches not watched", e);
+            } finally {
+                Binder.restoreCallingIdentity(identity);
+            }
+        }
+    }
+
+    private static void invalidateStickyCaches(@NonNull String op) {
+        for (int i = OPS.size() - 1; i >= 0; i--) {
+            if (OPS.valueAt(i).equals(op)) {
+                // Ignores the actions the cache does not keep.
+                BroadcastStickyCache.invalidateCache(OPS.keyAt(i));
+            }
+        }
+    }
+}
