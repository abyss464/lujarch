+    private static final String LUJARCH_START = "lujarch:start:";
+    private static final String LUJARCH_STARTED = "lujarch:started:";
+    private static final String LUJARCH_STOPPED = "lujarch:stopped:";
+
+    /**
+     * The tag the system notes Autostart with: how the app would start, whether it starts even
+     * while its question waits ({@code whileAsking}), and the app that asked, null for the system.
+     */
+    public static String lujarchStartTag(String how, boolean whileAsking,
+            @Nullable String who) {
+        return LUJARCH_START + how + ":" + (whileAsking ? "1" : "0") + ":"
+                + (who != null ? who : "");
+    }
+
+    /** Whether a recorded tag is a start of an app. */
+    static boolean lujarchIsStart(@Nullable String tag) {
+        return tag != null && (tag.startsWith(LUJARCH_STARTED) || tag.startsWith(LUJARCH_STOPPED));
+    }
+
+    /** The start the system notes with {@code tag}; null for any other note. */
+    @Nullable
+    private static String lujarchStartOf(int code, @Nullable String tag) {
+        return code == AppOpsManager.OP_LUJARCH_AUTOSTART && tag != null
+                && tag.startsWith(LUJARCH_START)
+                && UserHandle.getAppId(Binder.getCallingUid()) == Process.SYSTEM_UID ? tag : null;
+    }
+
+    /** The recorded tag of a start: started, or stopped unless it starts while asking. */
+    private static String lujarchStartRecord(String start, boolean allowed, String outcome) {
+        final String[] f = start.substring(LUJARCH_START.length()).split(":", 3);
+        final boolean started = allowed
+                || LUJARCH_OUTCOME_ASKED.equals(outcome) && f.length > 1 && "1".equals(f[1]);
+        return (started ? LUJARCH_STARTED : LUJARCH_STOPPED) + f[0] + ":"
+                + (f.length > 2 ? f[2] : "");
+    }
+
+    /** The ops the privacy dashboard shows, by code: Lujarch's and those of runtime permissions. */
+    private volatile boolean[] mLujarchShownOps;
+
+    /** Runs once the package manager knows the platform's permissions. */
+    private void lujarchFindShownOps() {
+        final boolean[] shown = new boolean[AppOpsManager._NUM_OP];
+        final PackageManager pm = mContext.getPackageManager();
+        for (int op = 0; op < shown.length; op++) {
+            if (AppOpsManager.isLujarchAskable(op)) {
+                shown[op] = true;
+                continue;
+            }
+            final String permission = AppOpsManager.opToPermission(op);
+            if (permission == null) {
+                continue;
+            }
+            try {
+                shown[op] = pm.getPermissionInfo(permission, 0).getProtection()
+                        == PermissionInfo.PROTECTION_DANGEROUS;
+            } catch (PackageManager.NameNotFoundException e) {
+                // A permission the platform does not define: not a runtime permission.
+            }
+        }
+        mLujarchShownOps = shown;
+    }
+
+    /** The tag a refused use of {@code code} is recorded under. */
+    private String lujarchRejectedTag(int code, @Nullable String attributionTag,
+            @Nullable String start, String outcome) {
+        if (start != null) {
+            return lujarchStartRecord(start, false, outcome);
+        }
+        final boolean[] shown = mLujarchShownOps;
+        return shown != null && shown[code] ? outcome : attributionTag;
+    }
