+    /**
+     * The outcomes of a refused use the privacy dashboard shows. The dashboard reads uses through
+     * the public history alone, whose entries carry no reason, so a refused use of an op it shows
+     * is recorded under its outcome in place of its attribution tag. PermissionController's
+     * LujarchOutcome holds the same tags.
+     */
+    static final String LUJARCH_OUTCOME_EMPTY = "lujarch:empty";
+    static final String LUJARCH_OUTCOME_REFUSED = "lujarch:refused";
+    static final String LUJARCH_OUTCOME_ASKED = "lujarch:asked";
+
+    /** Whether a recorded tag is an outcome. */
+    static boolean lujarchIsOutcome(@Nullable String tag) {
+        return LUJARCH_OUTCOME_EMPTY.equals(tag) || LUJARCH_OUTCOME_REFUSED.equals(tag)
+                || LUJARCH_OUTCOME_ASKED.equals(tag);
+    }
+
+    /** The ops the privacy dashboard shows, by code: Lujarch's and those of runtime permissions. */
+    private volatile boolean[] mLujarchShownOps;
+
+    /** Runs once the package manager knows the platform's permissions. */
+    private void lujarchFindShownOps() {
+        final boolean[] shown = new boolean[AppOpsManager._NUM_OP];
+        final PackageManager pm = mContext.getPackageManager();
+        for (int op = 0; op < shown.length; op++) {
+            if (AppOpsManager.isLujarchAskable(op)) {
+                shown[op] = true;
+                continue;
+            }
+            final String permission = AppOpsManager.opToPermission(op);
+            if (permission == null) {
+                continue;
+            }
+            try {
+                shown[op] = pm.getPermissionInfo(permission, 0).getProtection()
+                        == PermissionInfo.PROTECTION_DANGEROUS;
+            } catch (PackageManager.NameNotFoundException e) {
+                // A permission the platform does not define: not a runtime permission.
+            }
+        }
+        mLujarchShownOps = shown;
+    }
+
+    /** The tag a refused use of {@code code} is recorded under. */
+    private String lujarchRejectedTag(int code, @Nullable String attributionTag, String outcome) {
+        final boolean[] shown = mLujarchShownOps;
+        return shown != null && shown[code] ? outcome : attributionTag;
+    }
+
+    /**
+     * The outcome of a use the uid mode refused: empty data when the permission allows it and the
+     * app's "Return empty data" (its package mode, ignored) refused it, else not allowed.
+     */
+    private static String lujarchUidOutcome(UidState uidState, int code, int uidMode,
+            int rawUidMode) {
+        return uidMode == MODE_IGNORED && uidState.evalMode(code, rawUidMode) == MODE_ALLOWED
+                ? LUJARCH_OUTCOME_EMPTY : LUJARCH_OUTCOME_REFUSED;
+    }
+
+    /** The outcome of a use the package mode refused. */
+    private static String lujarchPackageOutcome(int switchCode, int packageMode, int mode) {
+        if (packageMode == MODE_DEFAULT && AppOpsManager.isLujarchAskable(switchCode)) {
+            return LUJARCH_OUTCOME_ASKED;
+        }
+        return mode == MODE_IGNORED ? LUJARCH_OUTCOME_EMPTY : LUJARCH_OUTCOME_REFUSED;
+    }
+
