diff --git a/services/core/java/com/android/server/am/LujarchAutostart.java b/services/core/java/com/android/server/am/LujarchAutostart.java
new file mode 100644
index 0000000000000000000000000000000000000000..03a7d82ebbcc6088abc90769795a8017763e632c
--- /dev/null
+++ b/services/core/java/com/android/server/am/LujarchAutostart.java
@@ -0,0 +1,90 @@
