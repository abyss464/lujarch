+ * limitations under the License.
+ */
+
+package com.android.server.am;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.AppOpsManager;
+import android.content.pm.ApplicationInfo;
+import android.os.Binder;
+import android.os.Process;
+import android.os.UserHandle;
+import android.util.Slog;
+
+import com.android.server.appop.AppOpsService;
+
+/**
+ * Autostart: whether the system starts an app that is not running, for a broadcast or for another
+ * app's call. Each start is noted, so that it lands in the history with how and who asked. Uids
+ * below 10000 always start, and a failed check allows the start (logged).
+ */
+final class LujarchAutostart {
+    private static final String TAG = "lujarch_autostart";
+
+    private LujarchAutostart() {
+    }
+
+    /**
+     * Whether the start of {@code info} is refused. {@code how} is one of AppOpsService's
+     * LUJARCH_START_*; {@code whileAsking}: it still starts while its question waits; {@code who}:
+     * the app that asked, null for the system; {@code what} names the start in the log.
+     */
+    static boolean refuses(@NonNull AppOpsManager ops, @NonNull ApplicationInfo info,
+            @NonNull String how, boolean whileAsking, @Nullable String who, @NonNull String what) {
+        if (UserHandle.getAppId(info.uid) < Process.FIRST_APPLICATION_UID) {
+            return false;
+        }
+        // The system notes the start, also within another app's call.
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final int mode = ops.noteOpNoThrow(AppOpsManager.OP_LUJARCH_AUTOSTART, info.uid,
+                    info.packageName, AppOpsService.lujarchStartTag(how, whileAsking, who), what);
+            if (mode != AppOpsManager.MODE_IGNORED && mode != AppOpsManager.MODE_ERRORED) {
+                return false;
+            }
+            if (whileAsking && ops.unsafeCheckOpRawNoThrow(AppOpsManager.OP_LUJARCH_AUTOSTART,
+                    info.uid, info.packageName) == AppOpsManager.MODE_DEFAULT) {
+                Slog.i(TAG, "starting " + info.packageName + " (uid " + info.uid + ") for "
+                        + what + " while its question waits");
+                return false;
+            }
+            Slog.w(TAG, "not starting " + info.packageName + " (uid " + info.uid + ") for "
+                    + what);
+            return true;
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "check failed, allowing the start of " + info.packageName, e);
+            return false;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    /**
+     * Whether another app's call that would start {@code info}, which is not running, is refused.
+     * Only an app other than {@code info} is asked about: the system and the roles it binds for
+     * the owner call as the system. While the question waits, such a call is refused.
+     */
+    static boolean refusesCall(@NonNull ActivityManagerService am, @NonNull ApplicationInfo info,
+            int callingUid, @Nullable String callingPackage, @NonNull String how,
+            @NonNull String what) {
+        if (UserHandle.getAppId(callingUid) < Process.FIRST_APPLICATION_UID
+                || callingUid == info.uid || am.mProcessList.getUidRecordLOSP(info.uid) != null) {
+            return false;
+        }
+        return refuses(am.getAppOpsManager(), info, how, false, callingPackage, what);
+    }
+}
