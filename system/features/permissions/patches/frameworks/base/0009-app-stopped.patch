+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.am;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.app.AppOpsManager;
+import android.app.Notification;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.PermissionGroupInfo;
+import android.content.pm.PermissionInfo;
+import android.content.pm.VersionedPackage;
+import android.os.Process;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.permission.PermissionControllerManager;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.Slog;
+import android.util.SparseArray;
+import android.util.SparseLongArray;
+
+import com.android.internal.R;
+import com.android.internal.annotations.GuardedBy;
+import com.android.internal.messages.nano.SystemMessageProto.SystemMessage;
+import com.android.internal.notification.SystemNotificationChannels;
+import com.android.internal.os.BackgroundThread;
+import com.android.server.pm.AppsFilterBase;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * The reason an app stopped: the permissions the user restricted for the app that refused it in
+ * the seconds before it stopped. Android's crash dialog names them and offers to allow each; when
+ * the dialog does not show, a notification names them.
+ *
+ * <p>A permission counts when the app's package mode on it is a restriction (ignored, errored or
+ * allowed only while in use) other than the op's default, which only a choice of the user writes,
+ * and AppOps recorded a rejection of the app on it within {@link #WINDOW_MS} before the crash.
+ * Installed apps adds the moment AppsFilter last hid a package from the app, since its note is
+ * kept once a minute.
+ */
+final class LujarchCrashNotice {
+    private static final String TAG = "lujarch_permissions";
+
+    /** Settings.Global: 0 turns the explanation off; absent or 1, on. */
+    static final String SETTING = "lujarch_permissions_explain_crashes";
+
+    /** A refusal counts when it is at most this long before the crash. */
+    static final long WINDOW_MS = 3_000;
+    /** At most one explanation per uid in this interval. */
+    static final long MIN_INTERVAL_MS = 30_000;
+    private static final long LABEL_TIMEOUT_MS = 1_000;
+
+    /** The restricted permissions that refused one crashing app, newest refusal first. */
+    record Notice(int uid, @NonNull String packageName, @NonNull int[] ops,
+            @NonNull int[] modes, @NonNull CharSequence[] labels) {}
+
+    private final Context mContext;
+    @GuardedBy("mLastClaimed")
+    private final SparseLongArray mLastClaimed = new SparseLongArray();
+
+    LujarchCrashNotice(Context context) {
+        mContext = context;
+    }
+
+    /**
+     * The permissions that refused the crashing app within {@link #WINDOW_MS} before
+     * [crashTime], or null. Reads AppOps, settings and the permission controller: called with no
+     * ActivityManager lock held.
+     */
+    @Nullable
+    Notice find(@Nullable ProcessRecord r, long crashTime) {
+        if (r == null || r.info == null) {
+            return null;
+        }
+        // An isolated process runs for its app: the app's uid has the modes.
+        final int uid = r.info.uid;
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return null;
+        }
+        try {
+            if (Settings.Global.getInt(mContext.getContentResolver(), SETTING, 1) == 0) {
+                return null;
+            }
+            final AppOpsManager appOps = mContext.getSystemService(AppOpsManager.class);
+            if (appOps == null) {
+                return null;
+            }
+            // Per permission (switch op): its mode and latest refusal across the process's
+            // packages.
+            final SparseArray<long[]> found = new SparseArray<>();
+            for (VersionedPackage vp : r.getPackageListWithVersionCode()) {
+                final List<AppOpsManager.PackageOps> pkgOps =
+                        appOps.getOpsForPackage(uid, vp.getPackageName(), (int[]) null);
+                for (AppOpsManager.PackageOps po : pkgOps) {
+                    for (AppOpsManager.OpEntry e : po.getOps()) {
+                        final int op = AppOpsManager.opToSwitch(e.getOp());
+                        final int mode = e.getMode();
+                        if (!isRestriction(op, mode)
+                                || mode == AppOpsManager.opToDefaultMode(op)) {
+                            continue;
+                        }
+                        long refused = e.getLastRejectTime(AppOpsManager.OP_FLAGS_ALL);
+                        if (op == AppOpsManager.OP_LUJARCH_INSTALLED_APPS) {
+                            refused = Math.max(refused, AppsFilterBase.lujarchLastHiddenAt(uid));
+                        }
+                        if (refused <= 0 || crashTime - refused > WINDOW_MS) {
+                            continue;
+                        }
+                        final long[] prev = found.get(op);
+                        if (prev == null || prev[1] < refused) {
+                            found.put(op, new long[] {mode, refused});
+                        }
+                    }
+                }
+            }
+            if (found.size() == 0) {
+                return null;
+            }
+            final ArrayList<Integer> order = new ArrayList<>();
+            for (int i = 0; i < found.size(); i++) {
+                order.add(i);
+            }
+            order.sort((a, b) -> Long.compare(found.valueAt(b)[1], found.valueAt(a)[1]));
+            final int n = order.size();
+            final int[] ops = new int[n];
+            final int[] modes = new int[n];
+            final CharSequence[] labels = new CharSequence[n];
+            for (int i = 0; i < n; i++) {
+                final int at = order.get(i);
+                ops[i] = found.keyAt(at);
+                modes[i] = (int) found.valueAt(at)[0];
+                labels[i] = permissionLabel(ops[i]);
+            }
+            final Notice notice = new Notice(uid, r.info.packageName, ops, modes, labels);
+            Slog.i(TAG, r.info.packageName + " (" + uid + ") stopped after refusals of "
+                    + TextUtils.join(", ", labels));
+            return notice;
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "stop of " + r.info.packageName + " (" + uid + ") not checked", e);
+            return null;
+        }
+    }
+
+    /** Whether [notice] is explained: at most once per {@link #MIN_INTERVAL_MS} per uid. */
+    boolean claim(@NonNull Notice notice) {
+        final long now = SystemClock.elapsedRealtime();
+        synchronized (mLastClaimed) {
+            final long last = mLastClaimed.get(notice.uid(), -1);
+            if (last >= 0 && now - last < MIN_INTERVAL_MS) {
+                return false;
+            }
+            mLastClaimed.put(notice.uid(), now);
+        }
+        return true;
+    }
+
+    /** The explanation as a notification, for a stop the dialog does not show. */
+    void notify(@NonNull Notice notice) {
+        BackgroundThread.getHandler().post(() -> postNotification(notice));
+    }
+
+    private void postNotification(@NonNull Notice notice) {
+        final UserHandle user = UserHandle.getUserHandleForUid(notice.uid());
+        try {
+            final PackageManager pm = mContext.getPackageManager();
+            final CharSequence app = pm.getApplicationInfoAsUser(notice.packageName(), 0, user)
+                    .loadLabel(pm);
+            final Intent intent = new Intent(Intent.ACTION_MANAGE_APP_PERMISSIONS)
+                    .putExtra(Intent.EXTRA_PACKAGE_NAME, notice.packageName())
+                    .putExtra(Intent.EXTRA_USER, user)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            final PendingIntent open = PendingIntent.getActivityAsUser(mContext, notice.uid(),
+                    intent, PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT,
+                    null, user);
+            final CharSequence text = reason(mContext, notice);
+            final Notification n = new Notification.Builder(mContext,
+                    SystemNotificationChannels.LUJARCH_APP_STOPPED)
+                    .setSmallIcon(R.drawable.stat_sys_warning)
+                    .setContentTitle(mContext.getString(R.string.lujarch_app_stopped, app))
+                    .setContentText(text)
+                    .setStyle(new Notification.BigTextStyle().bigText(text))
+                    .setContentIntent(open)
+                    .setAutoCancel(true)
+                    .setColor(mContext.getColor(R.color.system_notification_accent_color))
+                    .build();
+            mContext.getSystemService(NotificationManager.class).notifyAsUser(
+                    notice.packageName(), SystemMessage.NOTE_LUJARCH_APP_STOPPED, n, user);
+        } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+            Slog.e(TAG, "stop of " + notice.packageName() + " (" + notice.uid()
+                    + ") not explained", e);
+        }
+    }
+
+    /** "Clipboard (Return empty data), Location (Return empty data)", in the user's language. */
+    @NonNull
+    static CharSequence reason(@NonNull Context context, @NonNull Notice notice) {
+        final ArrayList<String> items = new ArrayList<>();
+        for (int i = 0; i < notice.ops().length; i++) {
+            items.add(context.getString(R.string.lujarch_app_stopped_item, notice.labels()[i],
+                    context.getString(choiceLabel(notice.modes()[i]))));
+        }
+        return context.getString(R.string.lujarch_app_stopped_reason,
+                String.join(context.getString(R.string.lujarch_list_separator), items));
+    }
+
+    /** Sets the [i]th permission of [notice] to Allow. Never throws. */
+    static void allow(@NonNull Context context, @NonNull Notice notice, int i) {
+        final int op = notice.ops()[i];
+        try {
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            // A runtime permission's own grant decides once its restriction is cleared.
+            final int mode = AppOpsManager.opToPermission(op) != null
+                    ? AppOpsManager.opToDefaultMode(op) : AppOpsManager.MODE_ALLOWED;
+            appOps.setMode(op, notice.uid(), notice.packageName(), mode);
+            Slog.i(TAG, notice.packageName() + " (" + notice.uid() + ") allowed "
+                    + AppOpsManager.opToPublicName(op) + " from the crash dialog");
+        } catch (RuntimeException e) {
+            Slog.e(TAG, AppOpsManager.opToPublicName(op) + " of " + notice.packageName()
+                    + " not allowed", e);
+        }
+    }
+
+    /** The choice a restrictive mode shows as. */
+    static int choiceLabel(int mode) {
+        switch (mode) {
+            case AppOpsManager.MODE_ERRORED:
+                return R.string.lujarch_permission_choice_deny;
+            case AppOpsManager.MODE_FOREGROUND:
+                return R.string.lujarch_permission_choice_foreground;
+            case AppOpsManager.MODE_DEFAULT:
+                return R.string.lujarch_permission_choice_ask;
+            default:
+                return R.string.lujarch_permission_choice_empty;
+        }
+    }
+
+    /**
+     * The name of an op's permission as the permission manager shows it: Lujarch's permissions
+     * and the platform group of a runtime permission, else the permission's own label, else the
+     * op's name.
+     */
+    @NonNull
+    private CharSequence permissionLabel(int op) {
+        final String group = lujarchGroup(op);
+        if (group != null) {
+            final CharSequence label = groupLabel(group);
+            if (label != null) {
+                return label;
+            }
+        }
+        final String permission = AppOpsManager.opToPermission(op);
+        if (permission != null) {
+            final CompletableFuture<String> future = new CompletableFuture<>();
+            try {
+                mContext.getSystemService(PermissionControllerManager.class)
+                        .getGroupOfPlatformPermission(permission, BackgroundThread.getExecutor(),
+                                future::complete);
+                final String platformGroup =
+                        future.get(LABEL_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+                final CharSequence label = platformGroup != null ? groupLabel(platformGroup)
+                        : null;
+                if (label != null) {
+                    return label;
+                }
+            } catch (Exception e) {
+                Slog.w(TAG, "group of " + permission + " not found", e);
+            }
+            try {
+                final PackageManager pm = mContext.getPackageManager();
+                final PermissionInfo info = pm.getPermissionInfo(permission, 0);
+                return info.loadLabel(pm);
+            } catch (PackageManager.NameNotFoundException e) {
+                Slog.w(TAG, permission + " not found", e);
+            }
+        }
+        return AppOpsManager.opToPublicName(op);
+    }
+
+    @Nullable
+    private CharSequence groupLabel(@NonNull String group) {
+        try {
+            final PackageManager pm = mContext.getPackageManager();
+            final PermissionGroupInfo info = pm.getPermissionGroupInfo(group, 0);
+            return info.loadLabel(pm);
+        } catch (PackageManager.NameNotFoundException e) {
+            Slog.w(TAG, group + " not found", e);
+            return null;
+        }
+    }
+
+    @Nullable
+    private static String lujarchGroup(int op) {
+        switch (op) {
+            case AppOpsManager.OP_LUJARCH_SENSORS:
+                return "android.permission-group.LUJARCH_SENSORS";
+            case AppOpsManager.OP_READ_CLIPBOARD:
+                return "android.permission-group.LUJARCH_CLIPBOARD";
+            case AppOpsManager.OP_LUJARCH_INSTALLED_APPS:
+                return "android.permission-group.LUJARCH_INSTALLED_APPS";
+            case AppOpsManager.OP_LUJARCH_DEVICE_IDS:
+                return "android.permission-group.LUJARCH_DEVICE_IDS";
+            case AppOpsManager.OP_LUJARCH_DEVICE_INFO:
+                return "android.permission-group.LUJARCH_DEVICE_INFO";
+            case AppOpsManager.OP_LUJARCH_NETWORK_INFO:
+                return "android.permission-group.LUJARCH_NETWORK_INFO";
+            case AppOpsManager.OP_LUJARCH_PHONE_INFO:
+                return android.Manifest.permission_group.PHONE;
+            default:
+                return null;
+        }
+    }
+
+    /** A mode that refuses the app at least sometimes; "ask every time" until answered. */
+    private static boolean isRestriction(int op, int mode) {
+        return mode == AppOpsManager.MODE_IGNORED || mode == AppOpsManager.MODE_ERRORED
+                || mode == AppOpsManager.MODE_FOREGROUND
+                || (mode == AppOpsManager.MODE_DEFAULT && AppOpsManager.isLujarchAskable(op));
+    }
+
+}
