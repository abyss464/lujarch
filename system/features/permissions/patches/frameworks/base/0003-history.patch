+    @VisibleForTesting
+    static long lujarchMaxDatabaseBytes(long retentionMillis) {
+        final long week = Duration.ofDays(7).toMillis();
+        if (retentionMillis <= week) {
+            return LUJARCH_WEEK_DATABASE_BYTES;
+        }
+        return LUJARCH_WEEK_DATABASE_BYTES * retentionMillis / week;
+    }
