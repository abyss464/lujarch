+    /**
+     * Whether the cold start of {@code info} for {@code r} is refused by its autostart
+     * permission. Notes the op, so the refusal lands in history. Uids below 10000 always
+     * start, and a failed check allows the start (logged).
+     */
+
+    private boolean shouldSkipLujarchAutostart(@NonNull ApplicationInfo info,
+            @NonNull BroadcastRecord r) {
+        try {
+            final int uid = info.uid;
+            if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+                return false;
+            }
+            final String action = (r.intent != null) ? r.intent.getAction() : null;
+            final int mode = mService.getAppOpsManager().noteOpNoThrow(
+                    AppOpsManager.OP_LUJARCH_AUTOSTART, uid, info.packageName, null,
+                    "broadcast " + action);
+            if (mode == AppOpsManager.MODE_IGNORED || mode == AppOpsManager.MODE_ERRORED) {
+                if (lujarchStartsWhileAsking(r) && mService.getAppOpsManager()
+                        .unsafeCheckOpRawNoThrow(AppOpsManager.OP_LUJARCH_AUTOSTART, uid,
+                                info.packageName) == AppOpsManager.MODE_DEFAULT) {
+                    Slog.i(TAG, "lujarch_autostart: starting " + info.packageName + " (uid " + uid
+                            + ") for " + action + " while its question waits");
+                    return false;
+                }
+                Slog.w(TAG, "lujarch_autostart: skipping cold start of " + info.packageName
+                        + " (uid " + uid + ") for " + action);
+                return true;
+            }
+        } catch (Exception e) {
+            Slog.w(TAG, "lujarch_autostart check failed, allowing start", e);
+        }
+        return false;
+    }
+
+    /**
+     * Whether {@code r} still starts an app whose Autostart question waits for its answer: an
+     * alarm clock the app set, or a high-priority push message, as the broadcast's temporary
+     * allowlist names them.
+     */
+    private static boolean lujarchStartsWhileAsking(@NonNull BroadcastRecord r) {
+        if (r.options == null || r.options.getTemporaryAppAllowlistDuration() <= 0) {
+            return false;
+        }
+        final int reason = r.options.getTemporaryAppAllowlistReasonCode();
+        return reason == PowerExemptionManager.REASON_ALARM_MANAGER_ALARM_CLOCK
+                || reason == PowerExemptionManager.REASON_PUSH_MESSAGING
+                || reason == PowerExemptionManager.REASON_PUSH_MESSAGING_OVER_QUOTA;
+    }
