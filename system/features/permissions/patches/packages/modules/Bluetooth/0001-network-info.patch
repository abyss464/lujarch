+package com.android.server.bluetooth;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import android.app.AppOpsManager;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Binder;
+import android.os.Process;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.util.Log;
+
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * The network info permission ({@link #OP} 
+ * "Information permissions") for the reads the Bluetooth manager service answers.
+ *
+ * <p>The rules of the framework's com.android.internal.app.LujarchInfo, which code in a
+ * mainline module cannot call, through the public AppOpsManager API: uid 0, 1000 and every
+ * Uid below 10000 pass untouched; the op is noted (recorded, and with ask set the user is
+ * Asked) at most once a minute per uid while the permission allows, every two seconds while it
+ * refuses (so a crash right after a refused read finds the refusal, the crash notice's 3 s
+ * window), and at once when the stored mode differs from the one last noted; in between only
+ * The mode is checked, so a change of the user's choice applies at the next read. A failed
+ * lookup allows (logged). A framework that does not know the op (an image older than the op)
+ * throws for its name, which allows (logged once).
+ */
+public final class LujarchNetworkInfo {
+
+    private static final String TAG = "LujarchNetworkInfo";
+
+    /** The op's public name. */
+    public static final String OP = "android:lujarch_network_info";
+
+    private static final long NOTE_INTERVAL_MS = 60_000L;
+    private static final long REFUSED_NOTE_INTERVAL_MS = 2_000L;
+
+    /** Last note per uid: elapsed realtime and the stored mode then. */
+    private static final ConcurrentHashMap<Integer, long[]> sLastNote = new ConcurrentHashMap<>();
+
+    private static volatile boolean sUnknownOpLogged;
+
+    private LujarchNetworkInfo() {
+    }
+
+    /**
+     * The permission's mode for this read: {@link AppOpsManager#MODE_ALLOWED},
+     * {@link AppOpsManager#MODE_IGNORED} (answer with empty data) or
+     * {@link AppOpsManager#MODE_ERRORED} (throw where the API can, else empty data).
+     * Never throws.
+     *
+     * @param uid the reading app's uid
+     * @param packageName its package as the API verified it, or null to take the uid's first
+     * @param attributionTag its attribution tag, if known
+     */
+    public static int decide(@NonNull Context context, int uid, @Nullable String packageName,
+            @Nullable String attributionTag) {
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        try {
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            if (appOps == null) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            final String pkg = packageName != null ? packageName : firstPackage(context, uid);
+            if (pkg == null) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            final int raw = appOps.unsafeCheckOpRawNoThrow(OP, uid, pkg);
+            final long now = SystemClock.elapsedRealtime();
+            final long[] last = sLastNote.get(uid);
+            // Foreground-only needs a note to be resolved against the uid's state.
+            final long interval = raw == AppOpsManager.MODE_ALLOWED
+                    ? NOTE_INTERVAL_MS : REFUSED_NOTE_INTERVAL_MS;
+            if (last != null && last[1] == raw && now - last[0] < interval
+                    && raw != AppOpsManager.MODE_FOREGROUND) {
+                return raw == AppOpsManager.MODE_DEFAULT ? AppOpsManager.MODE_IGNORED : raw;
+            }
+            sLastNote.put(uid, new long[] {now, raw});
+            final int mode = appOps.noteOpNoThrow(OP, uid, pkg, attributionTag, null);
+            return mode == AppOpsManager.MODE_DEFAULT ? AppOpsManager.MODE_IGNORED : mode;
+        } catch (RuntimeException e) {
+            if (isUnknownOp(e)) {
+                if (!sUnknownOpLogged) {
+                    sUnknownOpLogged = true;
+                    Log.w(TAG, OP + " is not an op of this system; network info allowed", e);
+                }
+            } else {
+                Log.w(TAG, OP + " of uid " + uid + " not decided; allowed", e);
+            }
+            return AppOpsManager.MODE_ALLOWED;
+        }
+    }
+
+    /** {@link #decide} is anything but {@link AppOpsManager#MODE_ALLOWED}. */
+    public static boolean refuses(@NonNull Context context, int uid,
+            @Nullable String packageName, @Nullable String attributionTag) {
+        return decide(context, uid, packageName, attributionTag) != AppOpsManager.MODE_ALLOWED;
+    }
+
+    /**
+     * {@link #refuses} for a getter that throws for a missing permission: errored (deny)
+     * throws {@link SecurityException} as that getter does.
+     */
+    public static boolean refusesOrThrows(@NonNull Context context, int uid,
+            @Nullable String packageName, @Nullable String attributionTag) {
+        final int mode = decide(context, uid, packageName, attributionTag);
+        if (mode == AppOpsManager.MODE_ERRORED) {
+            throw new SecurityException("uid " + uid + " is denied network info (" + OP + ")");
+        }
+        return mode != AppOpsManager.MODE_ALLOWED;
+    }
+
+    private static boolean isUnknownOp(RuntimeException e) {
+        return e instanceof IllegalArgumentException && e.getMessage() != null
+                && e.getMessage().startsWith("Unknown operation string");
+    }
+
+    @Nullable
+    private static String firstPackage(Context context, int uid) {
+        final PackageManager pm = context.getPackageManager();
+        if (pm == null) {
+            return null;
+        }
+        // The caller may not see packages by uid (package visibility); the system does.
+        final long token = Binder.clearCallingIdentity();
+        try {
+            final String[] packages = pm.getPackagesForUid(uid);
+            return packages != null && packages.length > 0 ? packages[0] : null;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+}
