+
+package com.android.permissioncontroller.lujarch
+
+import android.content.Context
+import android.content.Intent
+import androidx.annotation.StringRes
+import androidx.preference.PreferenceFragmentCompat
+import androidx.recyclerview.widget.RecyclerView
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.ui.ManagePermissionsActivity
+import com.android.permissioncontroller.role.ui.specialappaccess.SpecialAppAccessListActivity
+import java.util.WeakHashMap
+
+/**
+ * The rows the permissions add to the permission controller's pages, found by Settings search
+ * through the controller's own search provider and opened with the row in view.
+ */
+object LujarchSearchRows {
+    /** The row a page brings into view, as Settings passes it to its own pages. */
+    const val EXTRA_HIGHLIGHT = ":settings:fragment_args_key"
+    const val KEY_EXPLAIN = "lujarch_explain_crashes"
+    const val KEY_OTHER_ACCESS = "lujarch_other_access"
+    /** The search result of every row; the row is the result's key. */
+    const val ACTION = "com.android.permissioncontroller.settingssearch.action.LUJARCH_ROW"
+
+    /** A row and the page that holds it. */
+    class Row(
+        val key: String,
+        @StringRes val title: Int,
+        @StringRes val screen: Int,
+        val page: (Context) -> Intent,
+    )
+
+    @JvmField
+    val ROWS =
+        listOf(
+            Row(KEY_EXPLAIN, R.string.lujarch_explain_crashes, R.string.app_permission_manager) {
+                Intent(it, ManagePermissionsActivity::class.java)
+                    .setAction(Intent.ACTION_MANAGE_PERMISSIONS)
+            },
+            Row(KEY_OTHER_ACCESS, R.string.lujarch_other_access, R.string.special_app_access) {
+                Intent(it, SpecialAppAccessListActivity::class.java)
+            },
+        )
+
+    /** The page of the row [key], to open with the row in view; null for a key of no row. */
+    @JvmStatic
+    fun page(context: Context, key: String?): Intent? =
+        ROWS.firstOrNull { it.key == key }?.let { it.page(context).putExtra(EXTRA_HIGHLIGHT, it.key) }
+
+    private val watched = WeakHashMap<RecyclerView, Boolean>()
+
+    /**
+     * Brings the row [key] into view when a search result opened [fragment]'s page for it, and
+     * again after each change while the page fills in, until the user scrolls it.
+     */
+    @JvmStatic
+    fun keepInView(fragment: PreferenceFragmentCompat, key: String) {
+        val intent = fragment.activity?.intent ?: return
+        if (intent.getStringExtra(EXTRA_HIGHLIGHT) != key) return
+        val list = fragment.listView
+        if (list == null) {
+            // Before the page has its list: it scrolls once the list is made.
+            fragment.scrollToPreference(key)
+            return
+        }
+        if (watched.put(list, true) == null) {
+            list.addOnScrollListener(
+                object : RecyclerView.OnScrollListener() {
+                    override fun onScrollStateChanged(view: RecyclerView, state: Int) {
+                        if (state == RecyclerView.SCROLL_STATE_DRAGGING) {
+                            intent.removeExtra(EXTRA_HIGHLIGHT)
+                        }
+                    }
+                }
+            )
+        }
+        // The list takes a change of the page on a later message: the row is found after it.
+        list.post {
+            if (intent.getStringExtra(EXTRA_HIGHLIGHT) == key) fragment.scrollToPreference(key)
+        }
+    }
+}
