+    distributed under the License is distributed on an "AS IS" BASIS,
+    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+    See the License for the specific language governing permissions and
+    limitations under the License.
+-->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <string name="lujarch_choice_empty">"返回空数据"</string>
+    <string name="lujarch_choice_basic_phone_info">"仅基本电话信息"</string>
+    <string name="lujarch_explain_crashes">"说明应用停止的原因"</string>
+    <string name="lujarch_explain_crashes_summary">"应用刚被您的某项设置拒绝就停止运行时，说明是哪一项，并提供允许按钮"</string>
+    <string name="lujarch_footer_sensors">"涵盖 Android 无需权限即可打开的运动和环境传感器：加速度计、陀螺仪、磁力计、气压计、光线、距离等。选择“返回空数据”时，应用的传感器不提供读数；选择“不允许”时，应用无法打开这些传感器。"</string>
+    <string name="lujarch_footer_clipboard">"涵盖应用读取您复制的内容。选择“返回空数据”时，应用读到的剪贴板为空。"</string>
+    <string name="lujarch_footer_installed_apps">"涵盖此应用能看到哪些其他应用：应用列表，以及会透露它们的账号、键盘、无障碍服务和通知监听器。选择“返回空数据”时，应用只能看到系统自带的应用和它自己，看不到您安装的任何应用；选择“不允许”时，它只能看到自己和每个应用都需要的系统组件，依赖其他应用的功能（例如分享，或通过其他应用登录）可能会失败。"</string>
+    <string name="lujarch_footer_device_ids">"涵盖识别这部手机的编号：IMEI、序列号、SIM 卡序列号和用户识别码，以及 Android ID。Android 允许读取硬件编号的应用（包括 Google Play 服务）也在其内。选择“返回空数据”时，这些编号读出为空或全零；选择“不允许”时，凡是 Android 会对无权限应用拒绝的读取都会被拒绝，其余读出为空。"</string>
+    <string name="lujarch_footer_device_info">"涵盖通过系统接口描述这部手机的信息：型号和制造商、系统版本、时区、电池、连接的 USB 设备、设备名称、开机次数、开发者选项是否开启，以及描述手机的设置。选择“返回空数据”时，型号和版本读出为“unknown”，时区为 UTC，电池和 USB 为空。更改从应用下次启动时生效。应用自己的原生代码仍可从系统属性读到型号和版本，并从内核读到处理器和图形芯片的名称。"</string>
+    <string name="lujarch_footer_network_info">"涵盖系统接口提供的网络信息：IP 地址、DNS 服务器、代理、VPN 是否开启、WLAN 信号和连接详情、数据流量总量，以及蓝牙和 NFC 是否开启。选择“返回空数据”时，这些信息读出为空，VPN 视为不存在，蓝牙和 NFC 视为关闭；应用自己的网络连接照常工作，已获准使用“附近的设备”的应用仍能看到蓝牙。选择“不允许”时，可以拒绝读取的接口会拒绝。应用自己的原生代码仍可从内核读到手机网络接口的地址，应用连接的任何服务器都能看到手机的公网地址。"</string>
+    <string name="lujarch_footer_phone">"基本电话信息包括运营商及其国家和代码、SIM 卡状态、信号强度、网络类型、数据和通话状态，以及订阅编号，即 Android 向每个没有“电话”权限的应用提供的信息。运营商代码由系统作为系统属性公开，应用自己的原生代码仍可读到。"</string>
+    <string name="lujarch_ask_channel">"访问询问"</string>
+    <string name="lujarch_ask_until_answered">"在您回答之前，该应用得到的是空数据。"</string>
+    <string name="lujarch_ask_until_started">"在您回答之前，该应用在关闭时仅会因其闹钟和高优先级消息而启动。"</string>
+    <string name="lujarch_ask_until_both">"在您回答之前，该应用得到的是空数据，且在关闭时仅会因其闹钟和高优先级消息而启动。"</string>
+    <string name="lujarch_ask_phone_info">"读取运营商、信号和网络类型"</string>
+    <string name="lujarch_ask_autostart">"在关闭时启动"</string>
+    <string name="lujarch_autostart">"自启动"</string>
+    <string name="lujarch_keep_history">"记录保留时长"</string>
+    <string name="lujarch_history_days">"{count,plural, =1{1 天}other{# 天}}"</string>
+    <string name="lujarch_history_shorter_title">"要删除较早的记录吗？"</string>
+    <string name="lujarch_history_shorter_message">"{count,plural, =1{超过 1 天的记录将被删除。}other{超过 # 天的记录将被删除。}}"</string>
+    <string name="lujarch_history_shorter_delete">"删除"</string>
+    <string name="lujarch_other_access">"其他访问"</string>
+    <string name="lujarch_other_apps">"{count,plural, =0{没有应用}other{# 个应用}}"</string>
+    <string name="lujarch_footer_other">"列出使用过此访问的应用。选择“不允许”时，Android 会忽略该应用的这类请求，且不告知该应用。"</string>
+    <string name="lujarch_access_vibrate">"控制振动"</string>
+    <string name="lujarch_access_wake_lock">"防止手机休眠"</string>
+    <string name="lujarch_access_play_audio">"播放音频"</string>
+    <string name="lujarch_access_toast_window">"显示弹出消息"</string>
+    <string name="lujarch_access_write_clipboard">"修改剪贴板内容"</string>
+    <string name="lujarch_access_mute_microphone">"将麦克风静音或取消静音"</string>
+    <string name="lujarch_access_start_foreground">"运行前台服务"</string>
+    <string name="lujarch_access_use_biometric">"使用生物特征硬件"</string>
+    <string name="lujarch_access_use_fingerprint">"使用指纹硬件"</string>
+    <string name="lujarch_access_audio_media_volume">"媒体音量"</string>
+    <string name="lujarch_access_audio_ring_volume">"铃声音量"</string>
+    <string name="lujarch_access_audio_notification_volume">"通知音量"</string>
+    <string name="lujarch_access_audio_alarm_volume">"闹钟音量"</string>
+    <string name="lujarch_access_audio_voice_volume">"语音音量"</string>
+    <string name="lujarch_outcome_empty">"返回了空数据"</string>
+    <string name="lujarch_outcome_asked">"已询问"</string>
+    <string name="lujarch_menu_show_days">"{count,plural, =1{显示过去 1 天内的访问记录}other{显示过去 # 天内的访问记录}}"</string>
+    <string name="lujarch_usage_subtitle_days">"{count,plural, =1{过去 1 天内应用使用“<xliff:g id="PERMGROUP">%1$s</xliff:g>”权限的时间轴}other{过去 # 天内应用使用“<xliff:g id="PERMGROUP">%1$s</xliff:g>”权限的时间轴}}"</string>
