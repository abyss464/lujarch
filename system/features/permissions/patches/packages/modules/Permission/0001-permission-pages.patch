+    distributed under the License is distributed on an "AS IS" BASIS,
+    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+    See the License for the specific language governing permissions and
+    limitations under the License.
+-->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <string name="lujarch_choice_empty">"空のデータを返す"</string>
+    <string name="lujarch_choice_basic_phone_info">"電話の基本情報のみ"</string>
+    <string name="lujarch_explain_crashes">"アプリが停止した理由を表示"</string>
+    <string name="lujarch_explain_crashes_summary">"設定による拒否の直後にアプリが停止したときに、どの設定かを表示し、許可するボタンを表示します"</string>
+    <string name="lujarch_footer_sensors">"Android が権限なしで開くモーション センサーと環境センサー（加速度計、ジャイロスコープ、磁力計、気圧計、光、近接など）が対象です。[空のデータを返す] では、アプリのセンサーは値を返しません。[許可しない] では、アプリはセンサーを開けません。"</string>
+    <string name="lujarch_footer_clipboard">"アプリによるコピーした内容の読み取りが対象です。[空のデータを返す] では、アプリにはクリップボードが空に見えます。"</string>
+    <string name="lujarch_footer_installed_apps">"このアプリから見える他のアプリが対象です。アプリのリストと、それらを明らかにするアカウント、キーボード、ユーザー補助サービス、通知リスナーを含みます。[空のデータを返す] では、アプリにはシステムに付属のアプリと自身だけが見え、インストールしたアプリは見えません。[許可しない] では、自身とすべてのアプリが必要とするシステムの部分だけが見え、他のアプリに依存する機能（共有や、他のアプリを使ったログインなど）が失敗することがあります。"</string>
+    <string name="lujarch_footer_device_ids">"このスマートフォンを識別する番号（IMEI、シリアル番号、SIM のシリアル番号と加入者番号、Android ID）が対象です。Android がハードウェアの番号の読み取りを認めているアプリ（Google Play 開発者サービスを含む）も対象です。[空のデータを返す] では、番号は空かゼロとして読み取られます。[許可しない] では、権限のないアプリに Android が拒否する読み取りは拒否され、それ以外は空として読み取られます。"</string>
+    <string name="lujarch_footer_device_info">"システムのインターフェースを通じてこのスマートフォンを説明する情報（モデルとメーカー、システム ビルド、タイムゾーン、バッテリー、接続されている USB デバイス、デバイス名、起動回数、開発者向けオプションが有効かどうか、スマートフォンを説明する設定）が対象です。[空のデータを返す] では、モデルとビルドは「unknown」、タイムゾーンは UTC、バッテリーと USB は空として読み取られます。変更はアプリの次回起動時に適用されます。アプリ自身のネイティブ コードは、システム プロパティからモデルとビルドを、カーネルからプロセッサとグラフィックスの名前を引き続き読み取れます。"</string>
+    <string name="lujarch_footer_network_info">"システムのインターフェースが伝えるネットワークの情報（IP アドレス、DNS サーバー、プロキシ、VPN が有効かどうか、Wi-Fi の信号と接続の詳細、データ使用量の合計、Bluetooth と NFC が有効かどうか）が対象です。[空のデータを返す] では、これらは空、VPN はなし、Bluetooth と NFC はオフとして読み取られます。アプリ自身の接続はそのまま使え、付近のデバイスを許可されたアプリには Bluetooth が見えます。[許可しない] では、拒否できるインターフェースは読み取りを拒否します。アプリ自身のネイティブ コードはカーネルからネットワーク インターフェースのアドレスを引き続き読み取れ、アプリが通信するサーバーにはスマートフォンのパブリック アドレスが見えます。"</string>
+    <string name="lujarch_footer_phone">"電話の基本情報とは、通信事業者とその国とコード、SIM の状態、信号強度、ネットワークの種類、データと通話の状態、サブスクリプション番号のことで、Android が電話の権限のないすべてのアプリに提供する情報です。通信事業者のコードはシステムがシステム プロパティとして公開しているため、アプリ自身のネイティブ コードは引き続き読み取れます。"</string>
+    <string name="lujarch_ask_channel">"アクセスの確認"</string>
+    <string name="lujarch_ask_until_answered">"回答するまで、アプリには空のデータが返されます。"</string>
+    <string name="lujarch_ask_phone_info">"通信事業者、信号、ネットワークの種類の読み取り"</string>
+</resources>
