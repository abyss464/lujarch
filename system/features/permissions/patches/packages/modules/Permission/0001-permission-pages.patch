+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <string name="lujarch_choice_empty">Return empty data</string>
+    <string name="lujarch_choice_basic_phone_info">Basic phone info only</string>
+    <string name="lujarch_explain_crashes">Explain why apps stop</string>
+    <string name="lujarch_explain_crashes_summary">When an app stops right after one of your choices refused it, say which, with a button to allow it</string>
+    <string name="lujarch_footer_sensors">Covers the motion and environment sensors Android opens without a permission: accelerometer, gyroscope, magnetometer, barometer, light, proximity and the like. With Return empty data, the app\'s sensors deliver no readings. With Don\'t allow, the app cannot open them.</string>
+    <string name="lujarch_footer_clipboard">Covers the app reading what you copied. With Return empty data, the app finds the clipboard empty.</string>
+    <string name="lujarch_footer_installed_apps">Covers which other apps this app can see: the app list, and the accounts, keyboards, accessibility services and notification listeners that reveal them. With Return empty data, the app sees the apps that come with the system and itself, and none you installed. With Don\'t allow, it sees only itself and the system parts every app needs; features that rely on another app, such as sharing or signing in through another app, can fail.</string>
+    <string name="lujarch_footer_device_ids">Covers the numbers that identify this phone: the IMEI, the serial number, the SIM\'s serial and subscriber numbers, and the Android ID. Apps that Android lets read the hardware numbers, Google Play services included, are covered too. With Return empty data, the numbers read as empty or zeros. With Don\'t allow, a read that Android refuses to an app without a permission is refused, and the others read empty.</string>
+    <string name="lujarch_footer_device_info">Covers what describes this phone through the system\'s interfaces: the model and maker, the system build, the time zone, the battery, connected USB devices, the device name, the number of boots, whether developer options are on, and the settings that describe the phone. With Return empty data, the model and build read \"unknown\", the time zone UTC, and the battery and USB nothing. A change applies from the app\'s next start. The app\'s own native code still reads the model and build from system properties, and the processor and graphics names from the kernel.</string>
+    <string name="lujarch_footer_network_info">Covers what the system\'s interfaces tell about the networks: IP addresses, DNS servers, the proxy, whether a VPN is on, Wi‑Fi signal and link details, data totals, and whether Bluetooth and NFC are on. With Return empty data, these read as empty, a VPN as absent, and Bluetooth and NFC as off; the app\'s own connections keep working, and an app allowed Nearby devices still sees Bluetooth. With Don\'t allow, a read whose interface can refuse is refused. The app\'s own native code still reads the addresses of the phone\'s network interfaces from the kernel, and any server the app talks to sees the phone\'s public address.</string>
+    <string name="lujarch_footer_phone">Basic phone info is the carrier and its country and code, the SIM\'s state, signal strength, the network type, the data and call state, and the subscription numbers: what Android gives every app without the Phone permission. The carrier\'s code, which the system publishes as a system property, stays readable to the app\'s own native code.</string>
+    <string name="lujarch_ask_channel">Questions about access</string>
+    <string name="lujarch_ask_until_answered">Until you answer, the app gets empty data.</string>
+    <string name="lujarch_ask_until_started">Until you answer, the app is started while it is closed only for its alarms and high-priority messages.</string>
+    <string name="lujarch_ask_until_both">Until you answer, the app gets empty data and is started while it is closed only for its alarms and high-priority messages.</string>
+    <string name="lujarch_ask_phone_info">read the carrier, signal and network type</string>
+    <string name="lujarch_ask_autostart">start while it is closed</string>
+    <string name="lujarch_autostart">Autostart</string>
+    <string name="lujarch_keep_history">Keep history</string>
+    <string name="lujarch_history_days">{count, plural,
+        =1      {1 day}
+        other   {# days}
+    }</string>
+    <string name="lujarch_history_shorter_title">Delete older history?</string>
+    <string name="lujarch_history_shorter_message">{count, plural,
+        =1      {Records older than 1 day are deleted.}
+        other   {Records older than # days are deleted.}
+    }</string>
+    <string name="lujarch_history_shorter_delete">Delete</string>
+    <string name="lujarch_other_access">Other access</string>
+    <string name="lujarch_other_apps">{count, plural,
+        =0      {No apps}
+        =1      {1 app}
+        other   {# apps}
+    }</string>
+    <string name="lujarch_footer_other">Lists the apps that have used this access. When it is not allowed, Android ignores the app\'s requests for it without telling the app.</string>
+    <string name="lujarch_access_vibrate">Control vibration</string>
+    <string name="lujarch_access_wake_lock">Prevent phone from sleeping</string>
+    <string name="lujarch_access_play_audio">Play audio</string>
+    <string name="lujarch_access_toast_window">Show pop-up messages</string>
+    <string name="lujarch_access_write_clipboard">Modify clipboard</string>
+    <string name="lujarch_access_mute_microphone">Mute/unmute microphone</string>
+    <string name="lujarch_access_start_foreground">Run foreground service</string>
+    <string name="lujarch_access_use_biometric">Use biometric hardware</string>
+    <string name="lujarch_access_use_fingerprint">Use fingerprint hardware</string>
+    <string name="lujarch_access_audio_media_volume">Media volume</string>
+    <string name="lujarch_access_audio_ring_volume">Ring volume</string>
+    <string name="lujarch_access_audio_notification_volume">Notification volume</string>
+    <string name="lujarch_access_audio_alarm_volume">Alarm volume</string>
+    <string name="lujarch_access_audio_voice_volume">Voice volume</string>
+    <string name="lujarch_outcome_empty">Returned empty data</string>
+    <string name="lujarch_outcome_asked">Asked</string>
+    <string name="lujarch_menu_show_days">{count, plural,
+        =1      {Show 1 day}
+        other   {Show # days}
+    }</string>
+    <string name="lujarch_usage_subtitle_days">{count, plural,
+        =1      {Timeline of when apps used your <xliff:g id="permgroup" example="Location">%1$s</xliff:g> in the past day}
+        other   {Timeline of when apps used your <xliff:g id="permgroup" example="Location">%1$s</xliff:g> in the past # days}
+    }</string>
+    <string name="lujarch_label_past_days">{count, plural,
+        =1      {Past\n1 day}
+        other   {Past\n# days}
+    }</string>
+</resources>
