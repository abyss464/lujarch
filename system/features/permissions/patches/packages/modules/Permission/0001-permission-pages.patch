+
+package com.android.permissioncontroller.lujarch
+
+import android.Manifest
+import android.app.AppOpsManager
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import android.graphics.drawable.Drawable
+import android.os.Process
+import android.os.UserHandle
+import android.util.Log
+import androidx.annotation.StringRes
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.utils.PermissionMapping
+import com.android.permissioncontroller.permission.utils.Utils
+
+/** A choice of a Lujarch permission, stored as the app's mode of the permission's op. */
+enum class LujarchChoice(@StringRes val label: Int, @StringRes val header: Int, val mode: Int) {
+    ALLOW(R.string.app_permission_button_allow, R.string.allowed_header, AppOpsManager.MODE_ALLOWED),
+    ALLOW_FOREGROUND(
+        R.string.app_permission_button_allow_foreground,
+        R.string.allowed_foreground_header,
+        AppOpsManager.MODE_FOREGROUND,
+    ),
+    // "Ask every time" is the default mode: the system answers with empty data and asks.
+    ASK(R.string.app_permission_button_ask, R.string.ask_header, AppOpsManager.MODE_DEFAULT),
+    EMPTY(R.string.lujarch_choice_empty, R.string.lujarch_choice_empty, AppOpsManager.MODE_IGNORED),
+    DENY(R.string.app_permission_button_deny, R.string.denied_header, AppOpsManager.MODE_ERRORED);
+
+    val allows: Boolean
+        get() = this == ALLOW || this == ALLOW_FOREGROUND
+
+    companion object {
+        fun ofMode(mode: Int): LujarchChoice = entries.firstOrNull { it.mode == mode } ?: ALLOW
+    }
+}
+
+/**
+ * One of Lujarch's permissions: an access every app has, defined as a permission group of the
+ * platform (its name, icon and description) and stored as one app op per app.
+ */
+data class LujarchPermission(
+    val group: String,
+    val op: String,
+    val choices: List<LujarchChoice>,
+    @StringRes val footer: Int,
+    /** Choices whose name here differs from the choice's own. */
+    val labels: Map<LujarchChoice, Int> = emptyMap(),
+) {
+    @StringRes fun label(choice: LujarchChoice): Int = labels[choice] ?: choice.label
+}
+
+/** Lujarch's permissions and the apps' choices of them. */
+object LujarchPermissions {
+    const val TAG = "lujarch_permissions"
+
+    private const val GROUP = "android.permission-group.LUJARCH_"
+
+    val ALL =
+        listOf(
+            LujarchPermission(
+                GROUP + "SENSORS",
+                "android:lujarch_sensors",
+                LujarchChoice.entries,
+                R.string.lujarch_footer_sensors,
+            ),
+            LujarchPermission(
+                GROUP + "CLIPBOARD",
+                AppOpsManager.OPSTR_READ_CLIPBOARD,
+                listOf(LujarchChoice.ALLOW, LujarchChoice.ASK, LujarchChoice.EMPTY),
+                R.string.lujarch_footer_clipboard,
+            ),
+            LujarchPermission(
+                GROUP + "INSTALLED_APPS",
+                "android:lujarch_installed_apps",
+                listOf(LujarchChoice.ALLOW, LujarchChoice.ASK, LujarchChoice.EMPTY, LujarchChoice.DENY),
+                R.string.lujarch_footer_installed_apps,
+            ),
+            LujarchPermission(
+                GROUP + "DEVICE_IDS",
+                "android:lujarch_device_ids",
+                listOf(LujarchChoice.ALLOW, LujarchChoice.ASK, LujarchChoice.EMPTY, LujarchChoice.DENY),
+                R.string.lujarch_footer_device_ids,
+            ),
+            LujarchPermission(
+                GROUP + "DEVICE_INFO",
+                "android:lujarch_device_info",
+                listOf(LujarchChoice.ALLOW, LujarchChoice.ASK, LujarchChoice.EMPTY),
+                R.string.lujarch_footer_device_info,
+            ),
+            LujarchPermission(
+                GROUP + "NETWORK_INFO",
+                "android:lujarch_network_info",
+                listOf(LujarchChoice.ALLOW, LujarchChoice.ASK, LujarchChoice.EMPTY, LujarchChoice.DENY),
+                R.string.lujarch_footer_network_info,
+            ),
+        )
+
+    /** The op of basic phone info, which the Phone permission's choices also set. */
+    const val PHONE_INFO_OP = "android:lujarch_phone_info"
+
+    /** The Phone permission of an app that never asked for it: its basic phone info alone. */
+    val PHONE_BASIC =
+        LujarchPermission(
+            Manifest.permission_group.PHONE,
+            PHONE_INFO_OP,
+            listOf(LujarchChoice.ALLOW, LujarchChoice.ASK, LujarchChoice.DENY),
+            R.string.lujarch_footer_phone,
+            mapOf(LujarchChoice.ALLOW to R.string.lujarch_choice_basic_phone_info),
+        )
+
+    @JvmStatic fun of(group: String?): LujarchPermission? = ALL.firstOrNull { it.group == group }
+
+    /**
+     * The page of [group] for [packageName] when it is Lujarch's: one of its permissions, or
+     * Phone for an app that requests none of the Phone permissions.
+     */
+    @JvmStatic
+    fun pageOf(context: Context, group: String?, packageName: String?, user: UserHandle): LujarchPermission? {
+        of(group)?.let { return it }
+        if (group != Manifest.permission_group.PHONE || packageName == null) return null
+        val requested =
+            try {
+                context
+                    .createContextAsUser(user, 0)
+                    .packageManager
+                    .getPackageInfo(packageName, PackageManager.GET_PERMISSIONS)
+                    .requestedPermissions
+                    ?.toSet() ?: emptySet()
+            } catch (e: PackageManager.NameNotFoundException) {
+                return null
+            }
+        val phone = PermissionMapping.getPlatformPermissionNamesOfGroup(group)
+        return if (phone.none { it in requested }) PHONE_BASIC else null
+    }
+
+    @JvmStatic fun isLujarchGroup(group: String?): Boolean = of(group) != null
+
+    @JvmStatic
+    fun label(context: Context, group: String): CharSequence =
+        try {
+            context.packageManager.getPermissionGroupInfo(group, 0).loadLabel(context.packageManager)
+        } catch (e: PackageManager.NameNotFoundException) {
+            Log.e(TAG, "$group is not defined", e)
+            group
+        }
+
+    @JvmStatic
+    fun description(context: Context, group: String): CharSequence? =
+        try {
+            context.packageManager.getPermissionGroupInfo(group, 0).loadDescription(context.packageManager)
+        } catch (e: PackageManager.NameNotFoundException) {
+            Log.e(TAG, "$group is not defined", e)
+            null
+        }
+
+    @JvmStatic
+    fun icon(context: Context, group: String): Drawable? =
+        try {
+            val info = context.packageManager.getPermissionGroupInfo(group, 0)
+            Utils.applyTint(context, info.loadIcon(context.packageManager), android.R.attr.colorControlNormal)
+        } catch (e: PackageManager.NameNotFoundException) {
+            Log.e(TAG, "$group is not defined", e)
+            null
+        }
+
+    /** The app's choice of [op]; a failed read shows Allow, the stock access (logged). */
+    @JvmStatic
+    fun choice(context: Context, op: String, uid: Int, packageName: String): LujarchChoice =
+        try {
+            val appOps = context.getSystemService(AppOpsManager::class.java)!!
+            LujarchChoice.ofMode(appOps.unsafeCheckOpRawNoThrow(op, uid, packageName))
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "$op of $packageName not read", e)
+            LujarchChoice.ALLOW
+        }
+
+    /** Sets the app's choice of [op]; whether it was written (a failure is logged). */
+    @JvmStatic
+    fun set(context: Context, op: String, uid: Int, packageName: String, choice: LujarchChoice): Boolean =
+        try {
+            context.getSystemService(AppOpsManager::class.java)!!.setMode(op, uid, packageName, choice.mode)
+            Log.i(TAG, "$packageName ($uid) $op: $choice")
+            true
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "$op of $packageName not set to $choice", e)
+            false
+        }
+
+    /** The ops of a platform permission group's permissions. */
+    @JvmStatic
+    fun opsOfGroup(group: String): List<String> =
+        PermissionMapping.getPlatformPermissionNamesOfGroup(group)
+            .mapNotNull { AppOpsManager.permissionToOp(it) }
+            .distinct()
+
+    /**
+     * The platform groups among [groups] whose access returns empty data to the app: a package
+     * mode of MODE_IGNORED on one of their ops, which only "Return empty data" writes.
+     */
+    @JvmStatic
+    fun emptyGroups(context: Context, uid: Int, packageName: String, groups: Collection<String>): Set<String> {
+        val ignored =
+            try {
+                context
+                    .getSystemService(AppOpsManager::class.java)!!
+                    .getOpsForPackage(uid, packageName, *groups.flatMap { opsOfGroup(it) }.toTypedArray())
+                    .flatMap { it.ops }
+                    .filter { it.mode == AppOpsManager.MODE_IGNORED }
+                    .map { it.opStr }
+                    .toSet()
+            } catch (e: RuntimeException) {
+                Log.e(TAG, "ops of $packageName not read", e)
+                emptySet()
+            }
+        return groups.filter { g -> opsOfGroup(g).any { it in ignored } }.toSet()
+    }
+
+    /**
+     * Sets or clears "Return empty data" on a platform group: MODE_IGNORED on each of its ops, or
+     * MODE_DEFAULT, which clears the restriction. Whether every op was written.
+     */
+    @JvmStatic
+    fun setEmpty(context: Context, uid: Int, packageName: String, group: String, empty: Boolean): Boolean {
+        val appOps = context.getSystemService(AppOpsManager::class.java)!!
+        var done = true
+        for (op in opsOfGroup(group)) {
+            try {
+                appOps.setMode(op, uid, packageName, if (empty) AppOpsManager.MODE_IGNORED else AppOpsManager.MODE_DEFAULT)
+            } catch (e: RuntimeException) {
+                Log.e(TAG, "$op of $packageName not ${if (empty) "set to empty data" else "cleared"}", e)
+                done = false
+            }
+        }
+        Log.i(TAG, "$packageName ($uid) $group: ${if (empty) "returns empty data" else "follows the permission"}")
+        return done
+    }
+
+    /** An app the permissions cover: every app with an app uid of [user]. */
+    data class App(val packageName: String, val uid: Int, val label: CharSequence, val system: Boolean)
+
+    /**
+     * The apps of [user], each marked system as the permission manager's lists mark them: a
+     * system app without a launcher entry. Blocks on the package manager.
+     */
+    @JvmStatic
+    fun apps(context: Context, user: UserHandle): List<App> {
+        val pm = context.createContextAsUser(user, 0).packageManager
+        return try {
+            val launchable =
+                pm.queryIntentActivities(
+                        Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER),
+                        0,
+                    )
+                    .map { it.activityInfo.packageName }
+                    .toSet()
+            pm.getInstalledApplications(0)
+                .filter { UserHandle.getAppId(it.uid) >= Process.FIRST_APPLICATION_UID }
+                .map { App(it.packageName, it.uid, it.loadLabel(pm), isSystem(it, launchable)) }
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "apps of $user not listed", e)
+            emptyList()
+        }
+    }
+
+    private fun isSystem(info: ApplicationInfo, launchable: Set<String>): Boolean =
+        info.flags and ApplicationInfo.FLAG_SYSTEM != 0 && info.packageName !in launchable
+}
