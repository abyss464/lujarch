index 0000000000000000000000000000000000000000..e890ba3ecb25b98e3c8bb80219f3a918e4ca345e
--- /dev/null
+++ b/PermissionController/src/com/android/permissioncontroller/lujarch/LujarchPermissionApps.kt
@@ -0,0 +1,226 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.permissioncontroller.lujarch
+
+import android.Manifest
+import android.app.AppOpsManager
+import android.os.Process
+import android.util.Log
+import androidx.lifecycle.DefaultLifecycleObserver
+import androidx.lifecycle.LifecycleOwner
+import androidx.lifecycle.lifecycleScope
+import androidx.navigation.fragment.findNavController
+import androidx.preference.Preference
+import androidx.preference.PreferenceCategory
+import androidx.preference.PreferenceFragmentCompat
+import androidx.preference.PreferenceScreen
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.compat.AppPermissionFragmentCompat
+import com.android.permissioncontroller.permission.ui.Category
+import com.android.permissioncontroller.permission.ui.handheld.PermissionPreference
+import com.android.permissioncontroller.permission.ui.handheld.PermissionPreferenceCategory
+import com.android.permissioncontroller.permission.ui.handheld.SmartIconLoadPackagePermissionPreference
+import com.android.permissioncontroller.permission.utils.navigateSafe
+import java.text.Collator
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * An Android permission's app list with Lujarch's choices counted in: apps set to Return empty
+ * data in their own section; on Phone, every app, those without the permission in the section of
+ * their basic phone info (Basic phone info only, Ask every time, Not allowed).
+ *
+ * PermissionAppsFragment creates it in onCreate and calls [apply] at the end of each
+ * onPackagesLoaded.
+ */
+class LujarchPermissionApps(
+    private val fragment: PreferenceFragmentCompat,
+    private val group: String,
+    private val sessionId: Long,
+    private val redraw: Runnable,
+) : DefaultLifecycleObserver {
+    private val active = group in LujarchRadios.EMPTY_GROUPS
+    private val phone = group == Manifest.permission_group.PHONE
+
+    private class State(
+        val empty: Set<String>,
+        val phoneInfo: Map<String, LujarchChoice>,
+        val apps: List<LujarchPermissions.App>,
+    )
+
+    private var state: State? = null
+
+    init {
+        fragment.lifecycle.addObserver(this)
+    }
+
+    override fun onStart(owner: LifecycleOwner) {
+        if (!active) return
+        val app = fragment.requireActivity().application
+        fragment.lifecycleScope.launch {
+            state =
+                withContext(Dispatchers.IO) {
+                    val appOps = app.getSystemService(AppOpsManager::class.java)!!
+                    val ops = LujarchPermissions.opsOfGroup(group)
+                    val empty =
+                        try {
+                            appOps.getPackagesForOps(ops.toTypedArray())
+                                .filter { po -> po.ops.any { it.mode == AppOpsManager.MODE_IGNORED } }
+                                .map { it.packageName }
+                                .toSet()
+                        } catch (e: RuntimeException) {
+                            Log.e(LujarchPermissions.TAG, "modes of $group not read", e)
+                            emptySet()
+                        }
+                    val phoneInfo =
+                        if (!phone) emptyMap()
+                        else
+                            try {
+                                appOps.getPackagesForOps(arrayOf(LujarchPermissions.PHONE_INFO_OP))
+                                    .associate { po ->
+                                        po.packageName to
+                                            LujarchPermissions.PHONE_BASIC.choiceOf(po.ops.firstOrNull()?.mode ?: AppOpsManager.MODE_ALLOWED)
+                                    }
+                            } catch (e: RuntimeException) {
+                                Log.e(LujarchPermissions.TAG, "basic phone info not read", e)
+                                emptyMap()
+                            }
+                    val apps = if (phone) LujarchPermissions.apps(app, Process.myUserHandle()) else emptyList()
+                    State(empty, phoneInfo, apps)
+                }
+            redraw.run()
+        }
+    }
+
+    fun apply(screen: PreferenceScreen?) {
+        if (!active || screen == null) return
+        val s = state ?: return
+        val ctx = fragment.preferenceManager.context
+        val user = Process.myUserHandle()
+        // PermissionAppsFragment keys an app's row by its user and package.
+        val prefix = user.toString()
+        val emptyCategory = category(screen, KEY_EMPTY, R.string.lujarch_choice_empty)
+        val moved = HashSet<PreferenceCategory>()
+        val listed = HashSet<String>()
+        for (c in listOf(Category.ALLOWED, Category.ALLOWED_FOREGROUND, Category.ASK, Category.DENIED)) {
+            val source = screen.findPreference<PreferenceCategory>(c.categoryName) ?: continue
+            for (pref in (0 until source.preferenceCount).map { source.getPreference(it) }) {
+                val pkg = pref.key?.removePrefix(prefix) ?: continue
+                listed.add(pkg)
+                val target =
+                    when {
+                        pkg in s.empty -> emptyCategory
+                        phone && c == Category.DENIED -> phoneCategory(screen, s.phoneInfo[pkg])
+                        else -> null
+                    } ?: continue
+                if (target != source) {
+                    source.removePreference(pref)
+                    target.addPreference(pref)
+                    moved.add(source)
+                    moved.add(target)
+                }
+            }
+        }
+        if (phone) {
+            for (a in s.apps.filter { !it.system && it.packageName !in listed }) {
+                if (screen.findPreference<Preference>(prefix + a.packageName) != null) continue
+                val target = phoneCategory(screen, s.phoneInfo[a.packageName]) ?: continue
+                val pref = SmartIconLoadPackagePermissionPreference(fragment.requireActivity().application, a.packageName, user, ctx)
+                pref.key = prefix + a.packageName
+                pref.title = a.label
+                pref.setOnPreferenceClickListener {
+                    val args =
+                        AppPermissionFragmentCompat.createArgs(
+                            a.packageName, null, group, user, fragment.javaClass.name, sessionId,
+                            null, null,
+                        )
+                    fragment.findNavController().navigateSafe(R.id.perm_apps_to_app, args)
+                    true
+                }
+                target.addPreference(pref)
+                moved.add(target)
+            }
+        }
+        tidy(moved)
+    }
+
+    /** The section of an app without the Phone permission, by its basic phone info. */
+    private fun phoneCategory(screen: PreferenceScreen, choice: LujarchChoice?): PreferenceCategory? =
+        when (choice ?: LujarchChoice.ALLOW) {
+            LujarchChoice.ALLOW,
+            LujarchChoice.ALLOW_FOREGROUND -> category(screen, KEY_BASIC, R.string.lujarch_choice_basic_phone_info)
+            LujarchChoice.ASK -> category(screen, KEY_ASK, R.string.ask_header)
+            else -> null
+        }
+
+    private fun category(screen: PreferenceScreen, key: String, title: Int): PreferenceCategory {
+        screen.findPreference<PreferenceCategory>(key)?.let { return it }
+        val ctx = fragment.preferenceManager.context
+        val c = PermissionPreferenceCategory(ctx).apply {
+            this.key = key
+            setTitle(title)
+        }
+        // Before Not allowed.
+        val denied = screen.findPreference<PreferenceCategory>(Category.DENIED.categoryName)
+        c.order = (denied?.order ?: Int.MAX_VALUE / 2) - 1
+        screen.addPreference(c)
+        return c
+    }
+
+    private fun tidy(changed: Set<PreferenceCategory>) {
+        val ctx = fragment.preferenceManager.context
+        val collator = Collator.getInstance(ctx.resources.configuration.locales.get(0))
+        for (category in changed) {
+            val emptyLine = category.key + KEY_EMPTY_LINE
+            val rows = (0 until category.preferenceCount).map { category.getPreference(it) }.filter { it.key != emptyLine }
+            if (rows.isEmpty()) {
+                val text =
+                    when (category.key) {
+                        Category.ALLOWED.categoryName -> R.string.no_apps_allowed
+                        Category.DENIED.categoryName -> R.string.no_apps_denied
+                        else -> null
+                    }
+                if (text == null) {
+                    category.isVisible = false
+                } else if (category.findPreference<Preference>(emptyLine) == null) {
+                    category.addPreference(
+                        PermissionPreference(ctx).apply {
+                            key = emptyLine
+                            isSelectable = false
+                            setTitle(text)
+                        }
+                    )
+                }
+            } else {
+                category.findPreference<Preference>(emptyLine)?.let { category.removePreference(it) }
+                category.isVisible = true
+                rows.sortedWith { l, r -> collator.compare(l.title.toString(), r.title.toString()) }
+                    .forEachIndexed { i, p -> p.order = i }
+            }
+        }
+    }
+
+    companion object {
+        private const val KEY_EMPTY = "lujarch_empty"
+        private const val KEY_BASIC = "lujarch_basic_phone_info"
+        private const val KEY_ASK = "lujarch_ask"
+
+        /** PermissionAppsFragment's key suffix of an empty section's line. */
+        private const val KEY_EMPTY_LINE = "_empty"
+    }
+}
