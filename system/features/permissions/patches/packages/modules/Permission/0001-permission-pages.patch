+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.permissioncontroller.lujarch
+
+import android.app.Activity
+import android.app.KeyguardManager
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.icu.text.ListFormatter
+import android.content.Intent
+import android.os.Bundle
+import android.os.PowerManager
+import android.os.Process
+import android.os.UserHandle
+import android.text.Html
+import android.util.Log
+import android.view.View
+import android.widget.Button
+import android.widget.ImageView
+import android.widget.TextView
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.utils.KotlinUtils
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.GlobalScope
+import kotlinx.coroutines.launch
+
+/**
+ * "Ask every time": the system answered an access with empty data and asks the user. The
+ * question is a dialog in the look of Android's permission dialog when the app is on screen and
+ * the phone is unlocked, otherwise a notification that is never shown on the lock screen and opens
+ * the dialog. Several permissions of one app asked about together are one question, one page per
+ * permission, the latest first; the notification names them all. The answer becomes the app's
+ * choice.
+ */
+object LujarchAsks {
+    const val ACTION_ASK = "org.lujarch.permissions.action.ASK"
+    const val EXTRA_OP = "org.lujarch.permissions.extra.OP"
+    const val EXTRA_FOREGROUND = "org.lujarch.permissions.extra.FOREGROUND"
+    const val EXTRA_OPS = "org.lujarch.permissions.extra.OPS"
+
+    private const val CHANNEL = "lujarch_ask"
+
+    /** The ops each app is being asked about, until answered, the latest first. */
+    private val pending = HashMap<String, List<String>>()
+
+    /** The permission whose page answers a question about [op]. */
+    fun permissionOf(op: String): LujarchPermission? =
+        LujarchPermissions.ALL.firstOrNull { it.op == op }
+            ?: listOf(LujarchPermissions.PHONE_BASIC, LujarchPermissions.AUTOSTART).firstOrNull { it.op == op }
+
+    @Synchronized
+    fun add(packageName: String, op: String): List<String> {
+        val ops = listOf(op) + pending[packageName].orEmpty().filter { it != op }
+        pending[packageName] = ops
+        return ops
+    }
+
+    @Synchronized
+    fun answered(context: Context, packageName: String, op: String) {
+        val ops = (pending[packageName] ?: return).filter { it != op }
+        if (ops.isEmpty()) {
+            pending.remove(packageName)
+            context.getSystemService(NotificationManager::class.java)!!.cancel(packageName, 0)
+        } else {
+            pending[packageName] = ops
+        }
+    }
+
+    fun ask(context: Context, packageName: String, uid: Int, op: String, foreground: Boolean) {
+        val ops = add(packageName, op)
+        val dialog =
+            Intent(context, LujarchAskActivity::class.java)
+                .putExtra(Intent.EXTRA_PACKAGE_NAME, packageName)
+                .putExtra(Intent.EXTRA_UID, uid)
+                .putExtra(EXTRA_OPS, ops.toTypedArray())
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+        val keyguard = context.getSystemService(KeyguardManager::class.java)!!
+        val power = context.getSystemService(PowerManager::class.java)!!
+        if (foreground && power.isInteractive && !keyguard.isKeyguardLocked) {
+            try {
+                context.startActivity(dialog)
+                return
+            } catch (e: RuntimeException) {
+                Log.w(LujarchPermissions.TAG, "question about $packageName not shown as a dialog", e)
+            }
+        }
+        notify(context, packageName, uid, ops, dialog)
+    }
+
+    private fun notify(context: Context, packageName: String, uid: Int, ops: List<String>, dialog: Intent) {
+        val nm = context.getSystemService(NotificationManager::class.java)!!
+        nm.createNotificationChannel(
+            NotificationChannel(
+                CHANNEL,
+                context.getString(R.string.lujarch_ask_channel),
+                NotificationManager.IMPORTANCE_HIGH,
+            )
+        )
+        val app = KotlinUtils.getPackageLabel(context.applicationContext as android.app.Application, packageName, UserHandle.getUserHandleForUid(uid))
+        val waiting = ops.mapNotNull { permissionOf(it) }
+        if (waiting.isEmpty()) return
+        val requests = ListFormatter.getInstance().format(waiting.map { request(context, it) })
+        val title =
+            Html.fromHtml(context.getString(R.string.permission_warning_template, app, requests), 0)
+        val notStarted = waiting.any { it == LujarchPermissions.AUTOSTART }
+        val emptyData = waiting.any { it != LujarchPermissions.AUTOSTART }
+        val until =
+            context.getString(
+                when {
+                    notStarted && emptyData -> R.string.lujarch_ask_until_both
+                    notStarted -> R.string.lujarch_ask_until_started
+                    else -> R.string.lujarch_ask_until_answered
+                }
+            )
+        val open =
+            PendingIntent.getActivity(
+                context,
+                packageName.hashCode(),
+                dialog,
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            )
+        val n =
+            Notification.Builder(context, CHANNEL)
+                .setSmallIcon(R.drawable.ic_info_outline)
+                .setContentTitle(title)
+                .setContentText(until)
+                .setContentIntent(open)
+                .setVisibility(Notification.VISIBILITY_SECRET)
+                .setAutoCancel(true)
+                .build()
+        nm.notify(packageName, 0, n)
+    }
+
+    /** What the app asks to do with [p], for "Allow <app> to <request>?". */
+    fun request(context: Context, p: LujarchPermission): CharSequence =
+        if (p.request != 0) context.getString(p.request)
+        else LujarchPermissions.description(context, p.group) ?: LujarchPermissions.label(context, p.group)
+}
+
+/** The question from the system. */
+class LujarchAskReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != LujarchAsks.ACTION_ASK) return
+        val op = intent.getStringExtra(LujarchAsks.EXTRA_OP) ?: return
+        val packageName = intent.getStringExtra(Intent.EXTRA_PACKAGE_NAME) ?: return
+        val uid = intent.getIntExtra(Intent.EXTRA_UID, Process.INVALID_UID)
+        if (LujarchAsks.permissionOf(op) == null || uid == Process.INVALID_UID) {
+            Log.w(LujarchPermissions.TAG, "question about $op of $packageName has no page")
+            return
+        }
+        LujarchAsks.ask(context, packageName, uid, op, intent.getBooleanExtra(LujarchAsks.EXTRA_FOREGROUND, false))
+    }
+}
+
+/** The question as a dialog in the look of Android's permission dialog, one page per permission. */
+class LujarchAskActivity : Activity() {
+    private lateinit var packageName: String
+    private var uid = Process.INVALID_UID
+    private var ops: List<String> = emptyList()
+    private var index = 0
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setFinishOnTouchOutside(false)
+        if (!read(intent)) {
+            finish()
+            return
+        }
+        index = savedInstanceState?.getInt(KEY_INDEX) ?: 0
+        setContentView(R.layout.lujarch_ask)
+        show()
+    }
+
+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        if (read(intent)) {
+            index = 0
+            show()
+        }
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        super.onSaveInstanceState(outState)
+        outState.putInt(KEY_INDEX, index)
+    }
+
+    private fun read(intent: Intent): Boolean {
+        packageName = intent.getStringExtra(Intent.EXTRA_PACKAGE_NAME) ?: return false
+        uid = intent.getIntExtra(Intent.EXTRA_UID, Process.INVALID_UID)
+        ops = intent.getStringArrayExtra(LujarchAsks.EXTRA_OPS)?.toList().orEmpty()
+        return uid != Process.INVALID_UID && ops.isNotEmpty()
+    }
+
+    private fun show() {
+        if (index >= ops.size) {
+            finish()
+            return
+        }
+        val op = ops[index]
+        val p = LujarchAsks.permissionOf(op) ?: run {
+            index++
+            show()
+            return
+        }
+        val app = KotlinUtils.getPackageLabel(application, packageName, UserHandle.getUserHandleForUid(uid))
+        findViewById<ImageView>(R.id.permission_icon).setImageDrawable(LujarchPermissions.icon(this, p.group))
+        findViewById<TextView>(R.id.permission_message).text =
+            Html.fromHtml(getString(R.string.permission_warning_template, app, LujarchAsks.request(this, p)), 0)
+        val count = findViewById<TextView>(R.id.current_page_text)
+        count.visibility = if (ops.size > 1) View.VISIBLE else View.GONE
+        count.text = getString(R.string.current_permission_template, index + 1, ops.size)
+        val buttons =
+            mapOf(
+                LujarchChoice.ALLOW to R.id.permission_allow_button,
+                LujarchChoice.ALLOW_FOREGROUND to R.id.permission_allow_foreground_only_button,
+                LujarchChoice.EMPTY to R.id.lujarch_empty_button,
+                LujarchChoice.DENY to R.id.permission_deny_button,
+            )
+        for ((choice, id) in buttons) {
+            val b = findViewById<Button>(id)
+            b.visibility = if (choice in p.choices) View.VISIBLE else View.GONE
+            b.text = getString(p.label(choice))
+            b.setOnClickListener { answer(p, op, choice) }
+        }
+    }
+
+    private fun answer(p: LujarchPermission, op: String, choice: LujarchChoice) {
+        val app = applicationContext
+        val pkg = packageName
+        val u = uid
+        GlobalScope.launch(Dispatchers.IO) {
+            LujarchPermissions.set(app, p, u, pkg, choice)
+            LujarchAsks.answered(app, pkg, op)
+        }
+        index++
+        show()
+    }
+
+    companion object {
+        private const val KEY_INDEX = "lujarch_index"
+    }
+}
