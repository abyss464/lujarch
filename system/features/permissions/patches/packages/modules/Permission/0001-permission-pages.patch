+import android.Manifest
+import android.app.AppOpsManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import android.os.UserHandle
+import android.util.Log
+import androidx.annotation.RequiresApi
+import androidx.lifecycle.DefaultLifecycleObserver
+import androidx.lifecycle.LifecycleOwner
+import androidx.lifecycle.lifecycleScope
+import androidx.preference.Preference
+import androidx.preference.PreferenceCategory
+import androidx.preference.PreferenceFragmentCompat
+import com.android.permissioncontroller.PermissionControllerStatsLog.APP_PERMISSION_FRAGMENT_ACTION_REPORTED__BUTTON_PRESSED__ALLOW_FOREGROUND
+import com.android.permissioncontroller.PermissionControllerStatsLog.APP_PERMISSION_FRAGMENT_ACTION_REPORTED__BUTTON_PRESSED__DENY
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.ui.handheld.PermissionFooterPreference
+import com.android.permissioncontroller.permission.ui.handheld.v36.PermissionSelectorWithWidgetPreference
+import com.android.permissioncontroller.permission.ui.model.AppPermissionViewModel
+import com.android.permissioncontroller.permission.ui.model.AppPermissionViewModel.ButtonState
+import com.android.permissioncontroller.permission.ui.model.AppPermissionViewModel.ButtonType
+import com.android.permissioncontroller.permission.ui.model.AppPermissionViewModel.ChangeRequest
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * Lujarch's choices on Android's permission page of one app (AppPermissionFragment): "Return
+ * empty data" on every group whose data has an empty answer, before "Don't allow"; on Phone also
+ * "Basic phone info only" and "Ask every time", which choose the app's basic phone info while the
+ * Phone permission is not allowed. What is checked is what the app gets: Android's own radios are
+ * unchecked while one of these decides.
+ *
+ * Return empty data holds the permission as granted with a package mode of MODE_IGNORED on each of
+ * its ops; any of Android's own radios clears those modes once tapped. On Phone, Allow also allows
+ * basic phone info and Don't allow refuses it.
+ */
+@RequiresApi(Build.VERSION_CODES.VANILLA_ICE_CREAM)
+class LujarchRadios(
+    private val fragment: PreferenceFragmentCompat,
+    private val confirmer: AppPermissionViewModel.ConfirmDialogShowingFragment,
+    private val viewModel: AppPermissionViewModel,
+    private val packageName: String,
+    private val group: String,
+    private val user: UserHandle,
+    private val redraw: Runnable,
+) : DefaultLifecycleObserver {
+    private val active = group in EMPTY_GROUPS && user == Process.myUserHandle()
+    private val phone = group == Manifest.permission_group.PHONE
+    private val main = Handler(Looper.getMainLooper())
+
+    private var uid = Process.INVALID_UID
+    private var empty = false
+    private var phoneInfo = LujarchChoice.ALLOW
+    private var loaded = false
+
+    /** One of ours chosen and not yet read back: shown checked meanwhile. */
+    private var writing: LujarchChoice? = null
+
+    private var category: PreferenceCategory? = null
+    private var deny: Preference? = null
+    private var denyForeground: Preference? = null
+    private val radios = LinkedHashMap<LujarchChoice, PermissionSelectorWithWidgetPreference>()
+
+    private val watcher =
+        AppOpsManager.OnOpChangedListener { _, pkg -> if (pkg == packageName) main.post { reload() } }
+
+    init {
+        fragment.lifecycle.addObserver(this)
+    }
+
+    override fun onStart(owner: LifecycleOwner) {
+        if (!active) return
+        val appOps = fragment.requireContext().getSystemService(AppOpsManager::class.java)!!
+        val ops = LujarchPermissions.opsOfGroup(group) + if (phone) listOf(LujarchPermissions.PHONE_INFO_OP) else emptyList()
+        for (op in ops) {
+            try {
+                appOps.startWatchingMode(op, packageName, watcher)
+            } catch (e: RuntimeException) {
+                Log.w(LujarchPermissions.TAG, "$op of $packageName not watched", e)
+            }
+        }
+        reload()
+    }
+
+    override fun onStop(owner: LifecycleOwner) {
+        if (!active) return
+        fragment.requireContext().getSystemService(AppOpsManager::class.java)!!.stopWatchingMode(watcher)
+        main.removeCallbacksAndMessages(null)
+    }
+
+    /** Places our radios in the page's radio category, before "Don't allow", and the footer. */
+    fun attach(category: PreferenceCategory, deny: Preference, denyForeground: Preference) {
+        if (!active) return
+        this.category = category
+        this.deny = deny
+        this.denyForeground = denyForeground
+        val ctx = fragment.preferenceManager.context
+        val ours =
+            if (phone) listOf(LujarchChoice.ALLOW, LujarchChoice.ASK, LujarchChoice.EMPTY)
+            else listOf(LujarchChoice.EMPTY)
+        for (choice in ours) {
+            val r = PermissionSelectorWithWidgetPreference(ctx)
+            r.key = "lujarch_$choice"
+            r.isPersistent = false
+            r.setTitle(
+                if (choice == LujarchChoice.ALLOW) R.string.lujarch_choice_basic_phone_info
+                else choice.label
+            )
+            r.setOnClickListener { choose(choice) }
+            r.isVisible = false
+            category.addPreference(r)
+            radios[choice] = r
+        }
+        val all = (0 until category.preferenceCount).map { category.getPreference(it) }.sortedBy { it.order }
+        val denies = listOf(deny, denyForeground)
+        var i = 0
+        for (p in all.filter { it !in denies && it !in radios.values } + radios.values + denies) p.order = i++
+        if (phone) {
+            fragment.preferenceScreen.addPreference(
+                PermissionFooterPreference(ctx).apply {
+                    key = "lujarch_phone_footer"
+                    setIcon(R.drawable.ic_info_outline)
+                    setTitle(R.string.lujarch_footer_phone)
+                    order = Int.MAX_VALUE - 2
+                }
+            )
+        }
+    }
+
+    private fun reload() {
+        if (!active) return
+        val app = fragment.requireActivity().application
+        fragment.lifecycleScope.launch {
+            withContext(Dispatchers.IO) {
+                try {
+                    uid = app.createContextAsUser(user, 0).packageManager.getPackageUid(packageName, 0)
+                } catch (e: Exception) {
+                    Log.e(LujarchPermissions.TAG, "$packageName not found", e)
+                    return@withContext
+                }
+                empty = group in LujarchPermissions.emptyGroups(app, uid, packageName, listOf(group))
+                if (phone) {
+                    phoneInfo = LujarchPermissions.choice(app, LujarchPermissions.PHONE_BASIC, uid, packageName)
+                }
+            }
+            loaded = true
+            writing = null
+            redraw.run()
+        }
+    }
+
+    /**
+     * The page's radio states with our choices counted in; called at the start of each
+     * setRadioButtonsState with the page's own states (or null).
+     */
+    fun fuse(states: Map<ButtonType, ButtonState>?): Map<ButtonType, ButtonState>? {
+        if (!active || states == null) return states
+        if (!loaded) return states.mapValues { (_, s) -> s.copy(isShown = false) }
+        val fixed = RADIO_BUTTONS.mapNotNull { states[it] }.filter { it.isShown }.let { shown ->
+            shown.isNotEmpty() && shown.none { it.isEnabled }
+        }
+        val denied = states[ButtonType.DENY]?.isChecked == true || states[ButtonType.DENY_FOREGROUND]?.isChecked == true
+        val checked: LujarchChoice? =
+            writing
+                ?: when {
+                    empty -> LujarchChoice.EMPTY
+                    phone && denied && phoneInfo == LujarchChoice.ALLOW -> LujarchChoice.ALLOW
+                    phone && denied && phoneInfo == LujarchChoice.ASK -> LujarchChoice.ASK
+                    else -> null
+                }
+        for ((choice, r) in radios) {
+            r.isVisible = true
+            r.isEnabled = !fixed
+            r.isChecked = choice == checked
+        }
+        if (checked == null) return states
+        return states.mapValues { (type, s) -> if (type in RADIO_BUTTONS) s.copy(isChecked = false) else s }
+    }
+
+    /** A tap on one of Android's own radios, before its own change: ours give way. */
+    fun onNativeChoice(button: ButtonType) {
+        if (!active || uid == Process.INVALID_UID) return
+        writing = null
+        val app = fragment.requireActivity().application
+        val allow = button != ButtonType.DENY && button != ButtonType.DENY_FOREGROUND && button != ButtonType.ASK
+        // Android's choice shows at once; the writes follow.
+        val wasEmpty = empty
+        empty = false
+        if (phone) phoneInfo = if (allow) LujarchChoice.ALLOW else LujarchChoice.DENY
+        fragment.lifecycleScope.launch {
+            withContext(Dispatchers.IO) {
+                if (wasEmpty) LujarchPermissions.setEmpty(app, uid, packageName, group, false)
+                if (phone) {
+                    LujarchPermissions.set(
+                        app,
+                        LujarchPermissions.PHONE_BASIC,
+                        uid,
+                        packageName,
+                        if (allow) LujarchChoice.ALLOW else LujarchChoice.DENY,
+                    )
+                }
+            }
+        }
+    }
+
+    private fun choose(choice: LujarchChoice) {
+        if (uid == Process.INVALID_UID || writing == choice) return
+        writing = choice
+        redraw.run()
+        val app = fragment.requireActivity().application
+        fragment.lifecycleScope.launch {
+            withContext(Dispatchers.IO) {
+                LujarchPermissions.setEmpty(app, uid, packageName, group, choice == LujarchChoice.EMPTY)
+                if (phone) {
+                    LujarchPermissions.set(
+                        app,
+                        LujarchPermissions.PHONE_BASIC,
+                        uid,
+                        packageName,
+                        if (choice == LujarchChoice.EMPTY) LujarchChoice.EMPTY else choice,
+                    )
+                }
+            }
+            // Return empty data holds the permission as granted; the phone's levels without it
+            // are below the permission.
+            if (choice == LujarchChoice.EMPTY) {
+                viewModel.requestChange(
+                    false,
+                    fragment,
+                    confirmer,
+                    ChangeRequest.GRANT_FOREGROUND_ONLY,
+                    APP_PERMISSION_FRAGMENT_ACTION_REPORTED__BUTTON_PRESSED__ALLOW_FOREGROUND,
+                )
+            } else {
+                viewModel.requestChange(
+                    false,
+                    fragment,
+                    confirmer,
+                    ChangeRequest.REVOKE_BOTH,
+                    APP_PERMISSION_FRAGMENT_ACTION_REPORTED__BUTTON_PRESSED__DENY,
+                )
+            }
+            reload()
+        }
+    }
+
+    companion object {
+        /** The groups whose data has an empty answer. */
+        val EMPTY_GROUPS =
+            setOf(
+                Manifest.permission_group.LOCATION,
+                Manifest.permission_group.CAMERA,
+                Manifest.permission_group.MICROPHONE,
+                Manifest.permission_group.CONTACTS,
+                Manifest.permission_group.CALENDAR,
+                Manifest.permission_group.CALL_LOG,
+                Manifest.permission_group.SMS,
+                Manifest.permission_group.PHONE,
+                Manifest.permission_group.READ_MEDIA_VISUAL,
+                Manifest.permission_group.READ_MEDIA_AURAL,
+                Manifest.permission_group.NEARBY_DEVICES,
+                Manifest.permission_group.ACTIVITY_RECOGNITION,
+            )
+
+        /** The page's buttons that describe the grant. */
+        private val RADIO_BUTTONS =
+            listOf(
+                ButtonType.ALLOW,
+                ButtonType.ALLOW_ALWAYS,
+                ButtonType.ALLOW_FOREGROUND,
+                ButtonType.ASK_ONCE,
+                ButtonType.ASK,
+                ButtonType.DENY,
+                ButtonType.DENY_FOREGROUND,
+                ButtonType.SELECT_PHOTOS,
+            )
+    }
+}
