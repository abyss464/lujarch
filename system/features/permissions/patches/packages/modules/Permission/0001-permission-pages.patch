+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.permissioncontroller.lujarch
+
+import android.content.Context
+import android.os.Process
+import android.provider.Settings
+import android.util.Log
+import android.widget.ImageView
+import androidx.lifecycle.DefaultLifecycleObserver
+import androidx.lifecycle.LifecycleOwner
+import androidx.lifecycle.lifecycleScope
+import androidx.navigation.fragment.findNavController
+import androidx.preference.Preference
+import androidx.preference.PreferenceFragmentCompat
+import androidx.preference.PreferenceScreen
+import androidx.preference.PreferenceViewHolder
+import androidx.preference.SwitchPreferenceCompat
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.ui.handheld.PermissionAppsFragment
+import com.android.permissioncontroller.permission.ui.handheld.PermissionFooterPreference
+import com.android.permissioncontroller.permission.ui.handheld.PermissionPreference
+import com.android.permissioncontroller.permission.utils.navigateSafe
+import java.text.Collator
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * The permission manager's part of Lujarch's permissions: each as an entry among the permission
+ * groups, ordered with them by name, "n of m apps allowed" and opening its app list; and, after
+ * Android's own rows, the switch "Explain why apps stop".
+ *
+ * ManageStandardPermissionsFragment creates it in onCreate and calls [apply] at the end of each
+ * updatePermissionsUi.
+ */
+class LujarchPermissionManager(
+    private val fragment: PreferenceFragmentCompat,
+    private val redraw: Runnable,
+) : DefaultLifecycleObserver {
+    /** Per group: allowed apps and all apps the list shows without system apps. */
+    private var counts: Map<String, Pair<Int, Int>> = emptyMap()
+    private val prefs = HashMap<String, Preference>()
+
+    init {
+        fragment.lifecycle.addObserver(this)
+    }
+
+    override fun onStart(owner: LifecycleOwner) {
+        val app = fragment.requireActivity().application
+        fragment.lifecycleScope.launch {
+            counts =
+                withContext(Dispatchers.IO) {
+                    val apps =
+                        LujarchPermissions.apps(app, Process.myUserHandle()).filter { !it.system }
+                    LujarchPermissions.ALL.associate { p ->
+                        val allowed =
+                            apps.count {
+                                LujarchPermissions.choice(app, p, it.uid, it.packageName).allows
+                            }
+                        p.group to (allowed to apps.size)
+                    }
+                }
+            redraw.run()
+        }
+    }
+
+    /**
+     * Adds the permissions to [screen] and sorts them with the permission groups ([groups]: the
+     * keys of the group rows); Android's other rows follow, then the switch, then the footers.
+     */
+    fun apply(screen: PreferenceScreen, groups: Collection<String>, sessionId: Long) {
+        val ctx = fragment.preferenceManager.context
+        val alternative = ctx.resources.getBoolean(R.bool.config_useAlternativePermGroupSummary)
+        for (p in LujarchPermissions.ALL) {
+            val pref = prefs.getOrPut(p.group) { LujarchIconPreference(ctx) }
+            pref.key = p.group
+            pref.title = LujarchPermissions.label(ctx, p.group)
+            LujarchPermissions.icon(ctx, p.group)?.let { pref.icon = it }
+            pref.summary =
+                counts[p.group]?.let { (allowed, total) ->
+                    ctx.getString(
+                        if (alternative) R.string.app_permissions_group_summary2
+                        else R.string.app_permissions_group_summary,
+                        allowed,
+                        total,
+                    )
+                }
+            pref.setOnPreferenceClickListener {
+                fragment
+                    .findNavController()
+                    .navigateSafe(
+                        R.id.manage_to_perm_apps,
+                        PermissionAppsFragment.createArgs(p.group, sessionId),
+                    )
+                true
+            }
+            if (screen.findPreference<Preference>(p.group) == null) screen.addPreference(pref)
+        }
+        val explain =
+            prefs.getOrPut(KEY_EXPLAIN) {
+                SwitchPreferenceCompat(ctx).apply {
+                    key = KEY_EXPLAIN
+                    isPersistent = false
+                    setTitle(R.string.lujarch_explain_crashes)
+                    setSummary(R.string.lujarch_explain_crashes_summary)
+                    setOnPreferenceChangeListener { _, value ->
+                        try {
+                            Settings.Global.putInt(
+                                ctx.contentResolver,
+                                SETTING_EXPLAIN,
+                                if (value as Boolean) 1 else 0,
+                            )
+                            true
+                        } catch (e: SecurityException) {
+                            Log.e(LujarchPermissions.TAG, "$SETTING_EXPLAIN not written", e)
+                            false
+                        }
+                    }
+                }
+            } as SwitchPreferenceCompat
+        explain.isChecked = Settings.Global.getInt(ctx.contentResolver, SETTING_EXPLAIN, 1) != 0
+        if (screen.findPreference<Preference>(KEY_EXPLAIN) == null) screen.addPreference(explain)
+        order(ctx, screen, groups)
+        LujarchSearchRows.keepInView(fragment, KEY_EXPLAIN)
+    }
+
+    /** Groups and permissions by name; then Android's other rows; the switch; the footers. */
+    private fun order(ctx: Context, screen: PreferenceScreen, groups: Collection<String>) {
+        val collator = Collator.getInstance(ctx.resources.configuration.locales.get(0))
+        val ours = LujarchPermissions.ALL.map { it.group }.toSet()
+        val all = (0 until screen.preferenceCount).map { screen.getPreference(it) }
+        val named =
+            all.filter { (it.key ?: "") in groups || (it.key ?: "") in ours }
+                .sortedWith { l, r -> collator.compare(l.title.toString(), r.title.toString()) }
+        val footers = all.filter { it is PermissionFooterPreference }
+        val explain = all.filter { it.key == KEY_EXPLAIN }
+        val others = all.filter { it !in named && it !in footers && it !in explain }
+        var i = 0
+        for (p in named + others + explain + footers) p.order = i++
+    }
+
+    companion object {
+        private const val KEY_EXPLAIN = LujarchSearchRows.KEY_EXPLAIN
+        const val SETTING_EXPLAIN = "lujarch_permissions_explain_crashes"
+    }
+}
+
+/**
+ * A permission manager row: the group icons' fixed size and the divider above, as
+ * ManagePermissionsFragment's own rows draw them.
+ */
+class LujarchIconPreference(context: Context) : PermissionPreference(context) {
+    init {
+        isPersistent = false
+    }
+
+    override fun onBindViewHolder(holder: PreferenceViewHolder) {
+        super.onBindViewHolder(holder)
+        val icon = holder.findViewById(android.R.id.icon) as? ImageView ?: return
+        icon.adjustViewBounds = true
+        val size =
+            context.resources.getDimensionPixelSize(
+                R.dimen.permission_preference_permission_group_icon_size
+            )
+        icon.maxWidth = size
+        icon.maxHeight = size
+        icon.layoutParams.width = size
+        icon.layoutParams.height = size
+        icon.scaleType = ImageView.ScaleType.FIT_CENTER
+        holder.isDividerAllowedAbove = true
+        holder.isDividerAllowedBelow = false
+    }
+}
