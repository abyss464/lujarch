+ * limitations under the License.
+ */
+
+@file:Suppress("DEPRECATION", "OVERRIDE_DEPRECATION")
+
+package com.android.permissioncontroller.lujarch
+
+import android.app.AppOpsManager
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import android.os.UserHandle
+import android.util.Log
+import android.view.LayoutInflater
+import android.view.MenuItem
+import android.view.View
+import android.view.ViewGroup
+import androidx.annotation.RequiresApi
+import androidx.lifecycle.lifecycleScope
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.ui.handheld.PermissionFooterPreference
+import com.android.permissioncontroller.permission.ui.handheld.PermissionPreferenceCategory
+import com.android.permissioncontroller.permission.ui.handheld.SettingsWithLargeHeader
+import com.android.permissioncontroller.permission.ui.handheld.pressBack
+import com.android.permissioncontroller.permission.ui.handheld.v36.AppPermissionFooterLinkPreference
+import com.android.permissioncontroller.permission.ui.handheld.v36.PermissionSelectorWithWidgetPreference
+import com.android.permissioncontroller.permission.utils.KotlinUtils
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * One of Lujarch's permissions for one app, in the place and the look of AppPermissionFragment:
+ * the app's header, "<permission> access for this app", the permission's choices as radios, the
+ * footer that says what the permission covers and what it does not reach, and the link to all
+ * the app's permissions.
+ */
+@RequiresApi(Build.VERSION_CODES.VANILLA_ICE_CREAM)
+class LujarchAppFragment : SettingsWithLargeHeader() {
+    private lateinit var packageName: String
+    private lateinit var permission: LujarchPermission
+    private lateinit var user: UserHandle
+    private var uid = Process.INVALID_UID
+    private lateinit var category: PermissionPreferenceCategory
+    private val radios = LinkedHashMap<LujarchChoice, PermissionSelectorWithWidgetPreference>()
+    private val main = Handler(Looper.getMainLooper())
+
+    /** A change made elsewhere (a question answered, another page) shows here at once. */
+    private val watcher =
+        AppOpsManager.OnOpChangedListener { _, pkg -> if (pkg == packageName) main.post { reload() } }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val args = requireArguments()
+        packageName = args.getString(Intent.EXTRA_PACKAGE_NAME)!!
+        val group =
+            args.getString(Intent.EXTRA_PERMISSION_GROUP_NAME)
+                ?: args.getString(Intent.EXTRA_PERMISSION_NAME)
+        user = args.getParcelable(Intent.EXTRA_USER) ?: Process.myUserHandle()
+        permission = LujarchPermissions.pageOf(requireContext(), group, packageName, user)!!
+        setHasOptionsMenu(true)
+        activity?.actionBar?.setDisplayHomeAsUpEnabled(true)
+    }
+
+    override fun onCreatePreferences(bundle: Bundle?, s: String?) {
+        super.onCreatePreferences(bundle, s)
+        val ctx = preferenceManager.context
+        val screen = preferenceManager.createPreferenceScreen(ctx)
+        setPreferenceScreen(screen)
+        val label = LujarchPermissions.label(ctx, permission.group)
+        category =
+            PermissionPreferenceCategory(ctx).apply {
+                key = "lujarch_choices"
+                title = ctx.getString(R.string.app_permission_header, label)
+            }
+        screen.addPreference(category)
+        for (choice in permission.choices) {
+            val r = PermissionSelectorWithWidgetPreference(ctx)
+            r.key = "lujarch_$choice"
+            r.isPersistent = false
+            r.setTitle(permission.label(choice))
+            r.setOnClickListener { choose(choice) }
+            category.addPreference(r)
+            radios[choice] = r
+        }
+        screen.addPreference(
+            PermissionFooterPreference(ctx).apply {
+                key = "lujarch_footer"
+                setIcon(R.drawable.ic_info_outline)
+                setTitle(permission.footer)
+            }
+        )
+        val app = requireActivity().application
+        screen.addPreference(
+            AppPermissionFooterLinkPreference(ctx).apply {
+                key = "lujarch_all_permissions"
+                summary =
+                    ctx.getString(
+                        R.string.app_permission_footer_app_permissions_link,
+                        KotlinUtils.getPackageLabel(app, packageName, user),
+                    )
+                setOnPreferenceClickListener {
+                    val intent =
+                        Intent(Intent.ACTION_MANAGE_APP_PERMISSIONS)
+                            .putExtra(Intent.EXTRA_PACKAGE_NAME, packageName)
+                            .putExtra(Intent.EXTRA_USER, user)
+                    startActivity(intent)
+                    true
+                }
+            }
+        )
+        activity?.title = ctx.getString(R.string.app_permission_title, label)
+    }
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val app = requireActivity().application
+        KotlinUtils.getBadgedPackageIcon(app, packageName, user)?.let {
+            setHeader(it, KotlinUtils.getPackageLabel(app, packageName, user), null, null, false)
+        }
+        return super.onCreateView(inflater, container, savedInstanceState)
+    }
+
+    override fun onStart() {
+        super.onStart()
+        try {
+            requireContext()
+                .getSystemService(AppOpsManager::class.java)!!
+                .startWatchingMode(permission.op, packageName, watcher)
+        } catch (e: RuntimeException) {
+            // The page still reads the choice whenever it starts.
+            Log.w(LujarchPermissions.TAG, "${permission.op} of $packageName not watched", e)
+        }
+        reload()
+    }
+
+    override fun onStop() {
+        requireContext().getSystemService(AppOpsManager::class.java)!!.stopWatchingMode(watcher)
+        main.removeCallbacksAndMessages(null)
+        super.onStop()
+    }
+
+    override fun onOptionsItemSelected(item: MenuItem): Boolean {
+        if (item.itemId == android.R.id.home) {
+            pressBack()
+            return true
+        }
+        return super.onOptionsItemSelected(item)
+    }
+
+    private fun reload() {
+        val app = requireActivity().application
+        lifecycleScope.launch {
+            val current =
+                withContext(Dispatchers.IO) {
+                    try {
+                        uid = app.createContextAsUser(user, 0).packageManager.getPackageUid(packageName, 0)
+                        LujarchPermissions.choice(app, permission.op, uid, packageName)
+                    } catch (e: Exception) {
+                        Log.e(LujarchPermissions.TAG, "$packageName not found", e)
+                        null
+                    }
+                }
+            if (current == null) {
+                pressBack()
+                return@launch
+            }
+            radios.forEach { (choice, r) -> r.isChecked = choice == current }
+        }
+    }
+
+    private fun choose(choice: LujarchChoice) {
+        if (uid == Process.INVALID_UID) return
+        radios.forEach { (c, r) -> r.isChecked = c == choice }
+        val app = requireActivity().application
+        lifecycleScope.launch {
+            withContext(Dispatchers.IO) {
+                LujarchPermissions.set(app, permission.op, uid, packageName, choice)
+            }
+            reload()
+        }
+    }
+}
