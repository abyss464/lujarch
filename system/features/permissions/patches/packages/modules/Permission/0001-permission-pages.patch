+package com.android.permissioncontroller.lujarch
+
+import android.app.AppOpsManager
+import android.content.Context
+import android.content.Intent
+import android.os.Process
+import android.util.Log
+import androidx.preference.Preference
+import androidx.preference.PreferenceCategory
+import androidx.preference.PreferenceFragmentCompat
+import androidx.preference.PreferenceScreen
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.utils.StringUtils
+import java.text.Collator
+
+/**
+ * The other accesses on Special app access > See more: every access Android records for apps that
+ * has no page of its own, each with the number of apps that used it and opening their list.
+ */
+object LujarchOtherAccess {
+    private const val KEY = LujarchSearchRows.KEY_OTHER_ACCESS
+
+    /** The packages of [user] that used each access, or have a choice of it, by op. */
+    @JvmStatic
+    fun users(context: Context): Map<String, Set<String>> =
+        try {
+            val ops = LujarchPermissions.OTHER.map { it.op }.toTypedArray()
+            val user = Process.myUserHandle()
+            context
+                .getSystemService(AppOpsManager::class.java)!!
+                .getPackagesForOps(ops)
+                .filter { android.os.UserHandle.getUserHandleForUid(it.uid) == user }
+                .flatMap { p -> p.ops.map { it.opStr to p.packageName } }
+                .groupBy({ it.first }, { it.second })
+                .mapValues { it.value.toSet() }
+        } catch (e: RuntimeException) {
+            Log.e(LujarchPermissions.TAG, "users of the other accesses not read", e)
+            emptyMap()
+        }
+
+    /**
+     * Adds the section of the other accesses at the end of the See more page, in view when a
+     * Settings search result opened the page for it.
+     */
+    @JvmStatic
+    fun addTo(fragment: PreferenceFragmentCompat, screen: PreferenceScreen, context: Context) {
+        val users = users(context)
+        val category =
+            PreferenceCategory(context).apply {
+                key = KEY
+                setTitle(R.string.lujarch_other_access)
+            }
+        screen.addPreference(category)
+        LujarchSearchRows.keepInView(fragment, KEY)
+        val collator = Collator.getInstance(context.resources.configuration.locales.get(0))
+        LujarchPermissions.OTHER.map { it to context.getString(it.title) }
+            .sortedWith { l, r -> collator.compare(l.second, r.second) }
+            .forEach { (p, title) ->
+                category.addPreference(
+                    Preference(context).apply {
+                        key = KEY + "_" + p.op
+                        this.title = title
+                        summary =
+                            StringUtils.getIcuPluralsString(
+                                context,
+                                R.string.lujarch_other_apps,
+                                users[p.op]?.size ?: 0,
+                            )
+                        isIconSpaceReserved = true
+                        isPersistent = false
+                        setOnPreferenceClickListener {
+                            context.startActivity(
+                                Intent(Intent.ACTION_MANAGE_PERMISSION_APPS)
+                                    .setPackage(context.packageName)
+                                    .putExtra(Intent.EXTRA_PERMISSION_GROUP_NAME, p.group)
+                            )
+                            true
+                        }
+                    }
+                )
+            }
+    }
+}
