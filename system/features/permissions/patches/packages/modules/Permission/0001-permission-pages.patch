+
+package com.android.permissioncontroller.lujarch
+
+import android.Manifest
+import android.os.Process
+import android.os.UserHandle
+import androidx.lifecycle.DefaultLifecycleObserver
+import androidx.lifecycle.LifecycleOwner
+import androidx.lifecycle.lifecycleScope
+import androidx.preference.Preference
+import androidx.preference.PreferenceFragmentCompat
+import androidx.preference.PreferenceGroup
+import androidx.preference.PreferenceScreen
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.ui.Category
+import com.android.permissioncontroller.permission.ui.handheld.AppPermissionGroupsFragment
+import com.android.permissioncontroller.permission.ui.handheld.PermissionControlPreference
+import com.android.permissioncontroller.permission.ui.handheld.PermissionPreference
+import com.android.permissioncontroller.permission.ui.model.AppPermissionGroupsViewModel.GroupUiInfo
+import com.android.permissioncontroller.permission.utils.KotlinUtils
+import com.android.permissioncontroller.permission.utils.PermissionMapping
+import java.text.Collator
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * App info > Permissions with Lujarch's permissions: each in the page's own sections (allowed,
+ * ask, not allowed) as the app's choice places it, opening its page for the app; an Android group
+ * set to Return empty data moves from Allowed to Not allowed and says so; the Phone permission of
+ * an app that never asked for it shows its basic phone info.
+ *
+ * AppPermissionGroupsFragment creates it in onCreate and calls [apply] at the end of each
+ * updatePreferences.
+ */
+class LujarchAppPermissions(
+    private val fragment: PreferenceFragmentCompat,
+    private val packageName: String,
+    private val user: UserHandle?,
+    private val sessionId: Long,
+    private val redraw: Runnable,
+) : DefaultLifecycleObserver {
+    private class State(
+        val choices: Map<String, LujarchChoice>,
+        val empty: Set<String>,
+        val phoneInfo: LujarchChoice,
+    )
+
+    private var state: State? = null
+    private var shownGroups: Set<String> = emptySet()
+
+    init {
+        fragment.lifecycle.addObserver(this)
+    }
+
+    override fun onStart(owner: LifecycleOwner) {
+        load()
+    }
+
+    private fun load() {
+        val app = fragment.requireActivity().application
+        val u = user ?: Process.myUserHandle()
+        val groups = shownGroups
+        fragment.lifecycleScope.launch {
+            state =
+                withContext(Dispatchers.IO) {
+                    val uid =
+                        try {
+                            app.createContextAsUser(u, 0).packageManager.getPackageUid(packageName, 0)
+                        } catch (e: Exception) {
+                            return@withContext null
+                        }
+                    State(
+                        LujarchPermissions.ALL.associate {
+                            it.group to LujarchPermissions.choice(app, it.op, uid, packageName)
+                        },
+                        LujarchPermissions.emptyGroups(app, uid, packageName, groups),
+                        LujarchPermissions.choice(
+                            app,
+                            LujarchPermissions.PHONE_INFO_OP,
+                            uid,
+                            packageName,
+                        ),
+                    )
+                }
+            redraw.run()
+        }
+    }
+
+    fun apply(screen: PreferenceScreen?, groups: Map<Category, List<GroupUiInfo>>?, systemScreen: Boolean) {
+        if (screen == null || groups == null || !systemScreen) return
+        if (user != null && user != Process.myUserHandle()) return
+        val platform =
+            groups.values.flatten().map { it.groupName }.filter {
+                PermissionMapping.isPlatformPermissionGroup(it)
+            }
+        if (platform.toSet() != shownGroups) {
+            shownGroups = platform.toSet()
+            load()
+        }
+        val s = state ?: return
+        val ctx = fragment.preferenceManager.context
+        val u = user ?: Process.myUserHandle()
+        val emptyText = ctx.getString(R.string.lujarch_choice_empty)
+
+        // Android's groups that return empty data: under Not allowed, saying so.
+        for (g in s.empty) {
+            val pref = findIn(screen, g) ?: continue
+            pref.summary = emptyText
+            val denied = screen.findPreference<PreferenceGroup>(Category.DENIED.categoryName)
+            if (denied != null && pref.parent != denied) {
+                pref.parent?.removePreference(pref)
+                denied.addPreference(pref)
+            }
+        }
+
+        // Phone: basic phone info for an app that never asked for the permission; the level of
+        // an app that did and is not allowed it.
+        val phone = Manifest.permission_group.PHONE
+        val phonePref = findIn(screen, phone)
+        if (phonePref == null) {
+            val section = sectionOf(s.phoneInfo)
+            screen.findPreference<PreferenceGroup>(section)?.addPreference(
+                row(ctx, phone, section).apply {
+                    title = KotlinUtils.getPermGroupLabel(ctx, phone)
+                    icon = KotlinUtils.getPermGroupIcon(ctx, phone)
+                    summary = phoneSummary(ctx, s.phoneInfo)
+                }
+            )
+        } else if (phone !in s.empty && phonePref.parent?.key == Category.DENIED.categoryName) {
+            phonePref.summary = phoneSummary(ctx, s.phoneInfo)
+            if (s.phoneInfo == LujarchChoice.ALLOW) {
+                val allowed = screen.findPreference<PreferenceGroup>(Category.ALLOWED.categoryName)
+                if (allowed != null) {
+                    phonePref.parent?.removePreference(phonePref)
+                    allowed.addPreference(phonePref)
+                }
+            }
+        }
+
+        // Lujarch's permissions.
+        for (p in LujarchPermissions.ALL) {
+            val choice = s.choices[p.group] ?: continue
+            val section = sectionOf(choice)
+            val target = screen.findPreference<PreferenceGroup>(section) ?: continue
+            target.addPreference(
+                row(ctx, p.group, section).apply {
+                    title = LujarchPermissions.label(ctx, p.group)
+                    LujarchPermissions.icon(ctx, p.group)?.let { icon = it }
+                    when (choice) {
+                        LujarchChoice.EMPTY -> summary = emptyText
+                        LujarchChoice.ALLOW_FOREGROUND ->
+                            summary = ctx.getString(R.string.app_permission_button_allow_foreground)
+                        else -> {}
+                    }
+                }
+            )
+        }
+        tidy(screen)
+    }
+
+    private fun row(ctx: android.content.Context, group: String, section: String) =
+        PermissionControlPreference(
+                ctx,
+                packageName,
+                group,
+                user ?: Process.myUserHandle(),
+                AppPermissionGroupsFragment::class.java.name,
+                sessionId,
+                section,
+            )
+            .apply { key = group }
+
+    private fun phoneSummary(ctx: android.content.Context, choice: LujarchChoice): String =
+        when (choice) {
+            LujarchChoice.ALLOW -> ctx.getString(R.string.lujarch_choice_basic_phone_info)
+            LujarchChoice.ASK -> ctx.getString(R.string.app_permission_button_ask)
+            else -> ctx.getString(R.string.app_permission_button_deny)
+        }
+
+    /** The page's section for a choice; Allow only while using shows under Allowed here. */
+    private fun sectionOf(choice: LujarchChoice): String =
+        when (choice) {
+            LujarchChoice.ALLOW,
+            LujarchChoice.ALLOW_FOREGROUND -> Category.ALLOWED.categoryName
+            LujarchChoice.ASK -> Category.ASK.categoryName
+            else -> Category.DENIED.categoryName
+        }
+
+    private fun findIn(screen: PreferenceScreen, key: String): Preference? {
+        for (c in CATEGORIES) {
+            screen.findPreference<PreferenceGroup>(c.categoryName)?.findPreference<Preference>(key)?.let {
+                return it
+            }
+        }
+        return null
+    }
+
+    /**
+     * After the additions and moves: a section that got a row loses its "no permissions" line
+     * and shows; one left empty gets the line back; rows by name, "Additional permissions" last.
+     */
+    private fun tidy(screen: PreferenceScreen) {
+        val ctx = fragment.preferenceManager.context
+        val none =
+            setOf(
+                ctx.getString(R.string.no_permissions_allowed),
+                ctx.getString(R.string.no_permissions_denied),
+            )
+        val collator = Collator.getInstance(ctx.resources.configuration.locales.get(0))
+        val additional = ctx.getString(R.string.additional_permissions)
+        for (c in CATEGORIES) {
+            val category = screen.findPreference<PreferenceGroup>(c.categoryName) ?: continue
+            val rows = (0 until category.preferenceCount).map { category.getPreference(it) }
+            val real = rows.filter { it.title?.toString() !in none }
+            if (real.isNotEmpty()) {
+                rows.filter { it.title?.toString() in none }.forEach { category.removePreference(it) }
+                category.isVisible = true
+            } else if (rows.isEmpty() && c != Category.ASK) {
+                val text =
+                    ctx.getString(
+                        if (c == Category.DENIED) R.string.no_permissions_denied
+                        else R.string.no_permissions_allowed
+                    )
+                category.addPreference(
+                    PermissionPreference(ctx).apply {
+                        key = text
+                        title = text
+                        isSelectable = false
+                    }
+                )
+            } else if (rows.isEmpty()) {
+                category.isVisible = false
+            }
+            val sorted =
+                (0 until category.preferenceCount).map { category.getPreference(it) }.sortedWith { l, r ->
+                    when {
+                        l.title == additional -> 1
+                        r.title == additional -> -1
+                        else -> collator.compare(l.title.toString(), r.title.toString())
+                    }
+                }
+            sorted.forEachIndexed { i, p -> p.order = i }
+        }
+    }
+
+    companion object {
+        private val CATEGORIES = listOf(Category.ALLOWED, Category.ASK, Category.DENIED)
+    }
+}
