+ * limitations under the License.
+ */
+
+// The page's options menu is the one PermissionController's list pages use (Fragment's, deprecated).
+@file:Suppress("DEPRECATION", "OVERRIDE_DEPRECATION")
+
+package com.android.permissioncontroller.lujarch
+
+import android.content.Intent
+import android.os.Bundle
+import android.os.Process
+import android.view.Menu
+import android.view.MenuInflater
+import android.view.MenuItem
+import android.view.View
+import androidx.lifecycle.lifecycleScope
+import androidx.navigation.fragment.findNavController
+import androidx.preference.Preference
+import com.android.permissioncontroller.Constants.EXTRA_SESSION_ID
+import com.android.permissioncontroller.Constants.INVALID_SESSION_ID
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.compat.AppPermissionFragmentCompat
+import com.android.permissioncontroller.permission.ui.handheld.PermissionPreference
+import com.android.permissioncontroller.permission.ui.handheld.PermissionPreferenceCategory
+import com.android.permissioncontroller.permission.ui.handheld.PermissionsFrameFragment.MENU_HIDE_SYSTEM
+import com.android.permissioncontroller.permission.ui.handheld.PermissionsFrameFragment.MENU_SHOW_SYSTEM
+import com.android.permissioncontroller.permission.ui.handheld.SettingsWithLargeHeader
+import com.android.permissioncontroller.permission.ui.handheld.SettingsWithLargeHeader.LargeHeaderPreference
+import com.android.permissioncontroller.permission.ui.handheld.SmartIconLoadPackagePermissionPreference
+import com.android.permissioncontroller.permission.ui.handheld.pressBack
+import com.android.permissioncontroller.permission.utils.navigateSafe
+import java.text.Collator
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * The apps of one of Lujarch's permissions, in the place and the look of PermissionAppsFragment:
+ * the permission's icon, name and description, then the apps in the sections of its choices,
+ * each opening the permission's page for the app. System apps come with "Show system".
+ */
+class LujarchAppsFragment : SettingsWithLargeHeader() {
+    private lateinit var permission: LujarchPermission
+    private var sessionId = INVALID_SESSION_ID
+    private var showSystem = false
+    private var hasSystem = false
+    private lateinit var collator: Collator
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val args = requireArguments()
+        val group =
+            args.getString(Intent.EXTRA_PERMISSION_GROUP_NAME)
+                ?: args.getString(Intent.EXTRA_PERMISSION_NAME)
+        permission = LujarchPermissions.of(group)!!
+        sessionId = args.getLong(EXTRA_SESSION_ID, INVALID_SESSION_ID)
+        showSystem = savedInstanceState?.getBoolean(KEY_SHOW_SYSTEM) ?: false
+        collator = Collator.getInstance(resources.configuration.locales.get(0))
+        setHasOptionsMenu(true)
+        activity?.actionBar?.setDisplayHomeAsUpEnabled(true)
+        setLoading(true, false)
+    }
+
+    override fun onCreatePreferences(bundle: Bundle?, s: String?) {
+        super.onCreatePreferences(bundle, s)
+        setPreferenceScreen(preferenceManager.createPreferenceScreen(preferenceManager.context))
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        super.onSaveInstanceState(outState)
+        outState.putBoolean(KEY_SHOW_SYSTEM, showSystem)
+    }
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+        val ctx = requireContext()
+        val label = LujarchPermissions.label(ctx, permission.group)
+        LujarchPermissions.icon(ctx, permission.group)?.let { setHeader(it, label, null, null, true) }
+        LujarchPermissions.description(ctx, permission.group)?.let { setSummary(it, null) }
+        activity?.title = label
+    }
+
+    override fun onStart() {
+        super.onStart()
+        reload()
+    }
+
+    override fun onCreateOptionsMenu(menu: Menu, inflater: MenuInflater) {
+        super.onCreateOptionsMenu(menu, inflater)
+        if (hasSystem) {
+            menu.add(Menu.NONE, MENU_SHOW_SYSTEM, Menu.NONE, R.string.menu_show_system).isVisible =
+                !showSystem
+            menu.add(Menu.NONE, MENU_HIDE_SYSTEM, Menu.NONE, R.string.menu_hide_system).isVisible =
+                showSystem
+        }
+    }
+
+    override fun onOptionsItemSelected(item: MenuItem): Boolean {
+        when (item.itemId) {
+            android.R.id.home -> {
+                pressBack()
+                return true
+            }
+            MENU_SHOW_SYSTEM,
+            MENU_HIDE_SYSTEM -> {
+                showSystem = item.itemId == MENU_SHOW_SYSTEM
+                activity?.invalidateOptionsMenu()
+                reload()
+                return true
+            }
+        }
+        return super.onOptionsItemSelected(item)
+    }
+
+    private fun reload() {
+        val app = requireActivity().application
+        val user = Process.myUserHandle()
+        lifecycleScope.launch {
+            val rows =
+                withContext(Dispatchers.IO) {
+                    LujarchPermissions.apps(app, user).map {
+                        it to LujarchPermissions.choice(app, permission.op, it.uid, it.packageName)
+                    }
+                }
+            render(rows)
+        }
+    }
+
+    private fun render(rows: List<Pair<LujarchPermissions.App, LujarchChoice>>) {
+        val ctx = context ?: return
+        setLoading(false, true)
+        val screen = preferenceScreen ?: return
+        for (i in screen.preferenceCount - 1 downTo 0) {
+            val p = screen.getPreference(i)
+            if (p !is LargeHeaderPreference) screen.removePreference(p)
+        }
+        val system = rows.any { it.first.system }
+        if (hasSystem != system) {
+            hasSystem = system
+            activity?.invalidateOptionsMenu()
+        }
+        val app = requireActivity().application
+        val user = Process.myUserHandle()
+        for (choice in permission.choices) {
+            val apps =
+                rows.filter { (a, c) -> c == choice && (showSystem || !a.system) }.map { it.first }
+            // Allowed and Not allowed always show, as the permission manager's own do.
+            val always = choice == LujarchChoice.ALLOW || choice == LujarchChoice.DENY
+            if (apps.isEmpty() && !always) continue
+            val category = PermissionPreferenceCategory(ctx)
+            category.key = "lujarch_section_$choice"
+            category.setTitle(choice.header)
+            screen.addPreference(category)
+            if (apps.isEmpty()) {
+                category.addPreference(
+                    PermissionPreference(ctx).apply {
+                        key = "lujarch_section_${choice}_empty"
+                        isSelectable = false
+                        setTitle(
+                            if (choice == LujarchChoice.ALLOW) R.string.no_apps_allowed
+                            else R.string.no_apps_denied
+                        )
+                    }
+                )
+                continue
+            }
+            val prefs = ArrayList<Preference>()
+            for (a in apps) {
+                val pref = SmartIconLoadPackagePermissionPreference(app, a.packageName, user, ctx)
+                pref.key = "lujarch_app_${a.packageName}"
+                pref.title = a.label
+                pref.setOnPreferenceClickListener {
+                    val args =
+                        AppPermissionFragmentCompat.createArgs(
+                            a.packageName,
+                            null,
+                            permission.group,
+                            user,
+                            javaClass.name,
+                            sessionId,
+                            null,
+                            null,
+                        )
+                    findNavController().navigateSafe(R.id.perm_apps_to_app, args)
+                    true
+                }
+                prefs.add(pref)
+            }
+            prefs.sortWith { l, r -> collator.compare(l.title.toString(), r.title.toString()) }
+            prefs.forEachIndexed { i, p ->
+                p.order = i
+                category.addPreference(p)
+            }
+        }
+    }
+
+    companion object {
+        private const val KEY_SHOW_SYSTEM = "lujarch_show_system"
+    }
+}
diff --git a/PermissionController/src/com/android/permissioncontroller/lujarch/LujarchAsk.kt b/PermissionController/src/com/android/permissioncontroller/lujarch/LujarchAsk.kt
