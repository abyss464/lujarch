+package com.android.permissioncontroller.lujarch
+
+import android.app.AlertDialog
+import android.content.Context
+import android.provider.Settings
+import android.util.Log
+import com.android.permissioncontroller.R
+import com.android.permissioncontroller.permission.utils.StringUtils
+
+/** Privacy dashboard > menu > Keep history: how many days the access history is kept. */
+object LujarchHistory {
+    private const val SETTING = "lujarch_permissions_history_days"
+    private val DAYS = intArrayOf(1, 7, 30, 90)
+    private const val DEFAULT_DAYS = 7
+
+    @JvmStatic
+    fun days(context: Context): Int =
+        Settings.Global.getInt(context.contentResolver, SETTING, DEFAULT_DAYS).takeIf { it in DAYS }
+            ?: DEFAULT_DAYS
+
+    /** The dashboard's longer range, the whole history: its menu item. */
+    @JvmStatic
+    fun showAllMenu(context: Context): String =
+        StringUtils.getIcuPluralsString(context, R.string.lujarch_menu_show_days, days(context))
+
+    /** Whether the dashboard has a range longer than its 24 hours. */
+    @JvmStatic fun hasLongerRange(context: Context): Boolean = days(context) > 1
+
+    /** The timeline's subtitle over the whole history. */
+    @JvmStatic
+    fun timelineSubtitle(context: Context, group: CharSequence): String =
+        StringUtils.getIcuPluralsString(context, R.string.lujarch_usage_subtitle_days, days(context), group)
+
+    /** The dashboard graphic's label over the whole history. */
+    @JvmStatic
+    fun pastLabel(context: Context): String =
+        StringUtils.getIcuPluralsString(context, R.string.lujarch_label_past_days, days(context))
+
+    @JvmStatic
+    fun choose(context: Context) {
+        val current = days(context)
+        val labels =
+            DAYS.map { StringUtils.getIcuPluralsString(context, R.string.lujarch_history_days, it) }
+                .toTypedArray()
+        AlertDialog.Builder(context)
+            .setTitle(R.string.lujarch_keep_history)
+            .setSingleChoiceItems(labels, DAYS.indexOf(current)) { dialog, which ->
+                dialog.dismiss()
+                val chosen = DAYS[which]
+                if (chosen < current) confirm(context, chosen) else write(context, chosen)
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    /** A shorter history deletes the older records: asked first. */
+    private fun confirm(context: Context, days: Int) {
+        AlertDialog.Builder(context)
+            .setTitle(R.string.lujarch_history_shorter_title)
+            .setMessage(StringUtils.getIcuPluralsString(context, R.string.lujarch_history_shorter_message, days))
+            .setPositiveButton(R.string.lujarch_history_shorter_delete) { _, _ -> write(context, days) }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun write(context: Context, days: Int) {
+        try {
+            Settings.Global.putInt(context.contentResolver, SETTING, days)
+            Log.i(LujarchPermissions.TAG, "history kept $days days")
+        } catch (e: SecurityException) {
+            Log.e(LujarchPermissions.TAG, "$SETTING not written", e)
+        }
+    }
+}
