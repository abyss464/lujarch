+
+package com.android.permissioncontroller.lujarch
+
+import android.Manifest
+import androidx.annotation.StringRes
+import com.android.permissioncontroller.R
+
+/**
+ * The outcome of a use the system refused. The system records such a use under its outcome in
+ * place of the attribution tag (AppOpsService's LUJARCH_OUTCOME_* hold the same tags); an allowed
+ * use keeps its tag and has no outcome.
+ */
+enum class LujarchOutcome(val tag: String, @StringRes val label: Int) {
+    EMPTY("lujarch:empty", R.string.lujarch_outcome_empty),
+    REFUSED("lujarch:refused", R.string.denied_header),
+    ASKED("lujarch:asked", R.string.lujarch_outcome_asked);
+
+    companion object {
+        @JvmStatic fun of(tag: String?): LujarchOutcome? = entries.firstOrNull { it.tag == tag }
+
+        /**
+         * Whether every app has [group], requested or not: Lujarch's permissions, and Phone, whose
+         * basic phone info every app reads.
+         */
+        @JvmStatic
+        fun everyAppHas(group: String): Boolean =
+            LujarchPermissions.of(group) != null || group == Manifest.permission_group.PHONE
+    }
+}
diff --git a/PermissionController/src/com/android/permissioncontroller/lujarch/LujarchPermissionApps.kt b/PermissionController/src/com/android/permissioncontroller/lujarch/LujarchPermissionApps.kt
