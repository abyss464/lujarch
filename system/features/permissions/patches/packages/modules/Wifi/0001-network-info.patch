+        blank.setWifiStandard(ScanResult.WIFI_STANDARD_UNKNOWN);
+        blank.setInetAddress(null);
+        blank.clearCurrentSecurityType();
+        blank.resetMultiLinkInfo();
+        return blank;
+    }
