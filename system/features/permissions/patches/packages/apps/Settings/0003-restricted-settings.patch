+/**
+ * Allow restricted settings: Decided by Android (the install source decides), Allow (after the
+ * screen lock, as Android's own Allow) or Lock (closed whatever the install source). The choice is
+ * the app's mode of android:access_restricted_settings, which Enhanced Confirmation reads; Lock is
+ * its errored mode, which Android itself never writes.
+ */
+private fun ApplicationInfo.chooseRestrictedSettings(context: Context) {
+    val modes =
+        intArrayOf(AppOpsManager.MODE_DEFAULT, AppOpsManager.MODE_ALLOWED, AppOpsManager.MODE_ERRORED)
+    val labels =
+        arrayOf<CharSequence>(
+            context.getString(R.string.lujarch_restricted_decided_by_android),
+            context.getString(R.string.lujarch_choice_allow),
+            context.getString(R.string.lujarch_restricted_lock),
         )
-        Toast.makeText(context, toastString, Toast.LENGTH_LONG).show()
-    }
+    @Suppress("DEPRECATION")
+    val current =
+        when (context.appOpsManager.unsafeCheckOpRawNoThrow(
+            AppOpsManager.OPSTR_ACCESS_RESTRICTED_SETTINGS, uid, packageName)) {
+            AppOpsManager.MODE_ALLOWED -> 1
+            AppOpsManager.MODE_ERRORED -> 2
+            else -> 0
+        }
+    AlertDialog.Builder(context)
+        .setTitle(R.string.app_restricted_settings_lockscreen_title)
+        .setSingleChoiceItems(labels, current) { dialog, which ->
+            dialog.dismiss()
+            if (which == current) return@setSingleChoiceItems
+            if (modes[which] == AppOpsManager.MODE_ALLOWED) {
+                AppInfoDashboardFragment.showLockScreen(context) {
+                    setRestrictedSettings(context, AppOpsManager.MODE_ALLOWED)
+                    val toastString = context.getString(
+                        R.string.toast_allows_restricted_settings_successfully,
+                        loadLabel(context.packageManager),
+                    )
+                    Toast.makeText(context, toastString, Toast.LENGTH_LONG).show()
+                }
+            } else {
+                setRestrictedSettings(context, modes[which])
+            }
+        }
+        .setNegativeButton(android.R.string.cancel, null)
+        .show()
+}
+
+private fun ApplicationInfo.setRestrictedSettings(context: Context, mode: Int) {
+    context.appOpsManager.setMode(AppOpsManager.OP_ACCESS_RESTRICTED_SETTINGS, uid, packageName, mode)
+    Log.i("lujarch_permissions", "$packageName restricted settings: $mode")
 }
 
