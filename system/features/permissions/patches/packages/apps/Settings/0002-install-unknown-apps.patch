+package com.android.settings.spa.app.specialaccess
+
+import android.Manifest
+import android.app.AppGlobals
+import android.app.AlertDialog
+import android.app.AppOpsManager
+import android.content.Context
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageInfo
+import android.content.pm.PackageManager
+import android.os.UserHandle
+import android.provider.Settings
+import android.util.Log
+import com.android.settings.R
+import com.android.settingslib.utils.StringUtil
+
+/**
+ * An installer's choice under Install unknown apps: Allow, Ask every time (each install and
+ * update waits for the user) or Don't allow. It is stored as the installer's mode of
+ * android:lujarch_install, which the system's install verifier reads, and, for an app installing
+ * from unknown sources, also as Android's own switch.
+ */
+object LujarchInstallChoice {
+    private const val TAG = "lujarch_permissions"
+
+    fun read(context: Context, app: ApplicationInfo, unknownSourcesAllowed: Boolean?): Int? {
+        val mode =
+            try {
+                context.getSystemService(AppOpsManager::class.java)!!
+                    .unsafeCheckOpRawNoThrow(AppOpsManager.OPSTR_LUJARCH_INSTALL, app.uid, app.packageName)
+            } catch (e: RuntimeException) {
+                Log.e(TAG, "install choice of ${app.packageName} not read", e)
+                return null
+            }
+        return when {
+            mode == AppOpsManager.MODE_DEFAULT -> AppOpsManager.MODE_DEFAULT
+            mode == AppOpsManager.MODE_ERRORED || mode == AppOpsManager.MODE_IGNORED ->
+                AppOpsManager.MODE_ERRORED
+            !requestsUnknownSources(app) -> AppOpsManager.MODE_ALLOWED
+            unknownSourcesAllowed == null -> null
+            unknownSourcesAllowed -> AppOpsManager.MODE_ALLOWED
+            else -> AppOpsManager.MODE_ERRORED
+        }
+    }
+
+    fun write(context: Context, app: ApplicationInfo, value: Int, setUnknownSources: (Boolean) -> Unit) {
+        try {
+            context.getSystemService(AppOpsManager::class.java)!!
+                .setMode(AppOpsManager.OP_LUJARCH_INSTALL, app.uid, app.packageName, value)
+            if (requestsUnknownSources(app)) setUnknownSources(value != AppOpsManager.MODE_ERRORED)
+            Log.i(TAG, "${app.packageName} installs: $value")
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "install choice of ${app.packageName} not written", e)
+        }
+    }
+
+    private const val SETTING_WAIT = "lujarch_permissions_install_wait_minutes"
+    private const val DEFAULT_WAIT = 10
+    private val WAITS = intArrayOf(1, 2, 5, 10, 15, 30, 60)
+
+    /** Wait for an answer: how long an install asked about waits before it is refused. */
+    fun chooseWait(context: Context) {
+        val current = Settings.Global.getInt(context.contentResolver, SETTING_WAIT, DEFAULT_WAIT)
+        val labels =
+            WAITS.map { StringUtil.getIcuPluralsString(context, it, R.string.lujarch_install_wait_minutes) }
+        AlertDialog.Builder(context)
+            .setTitle(R.string.lujarch_install_wait)
+            .setSingleChoiceItems(labels.toTypedArray(), WAITS.indexOf(current)) { dialog, which ->
+                Settings.Global.putInt(context.contentResolver, SETTING_WAIT, WAITS[which])
+                Log.i(TAG, "installs asked about wait ${WAITS[which]} min")
+                dialog.dismiss()
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    /** The apps that install without asking for unknown sources: the app stores. */
+    fun installers(userId: Int): Set<String> =
+        try {
+            AppGlobals.getPackageManager()
+                .getPackagesHoldingPermissions(arrayOf(Manifest.permission.INSTALL_PACKAGES), 0L, userId)
+                .list
+                .filterIsInstance<PackageInfo>()
+                .filter { info ->
+                    val system = info.applicationInfo?.isSystemApp ?: true
+                    !system || hasLauncher(info.packageName, userId)
+                }
+                .map { it.packageName }
+                .toSet()
+        } catch (e: Exception) {
+            Log.e(TAG, "installers of user $userId not listed", e)
+            emptySet()
+        }
+
+    private fun hasLauncher(packageName: String, userId: Int): Boolean =
+        AppGlobals.getPackageManager()
+            .queryIntentActivities(
+                android.content.Intent(android.content.Intent.ACTION_MAIN)
+                    .addCategory(android.content.Intent.CATEGORY_LAUNCHER)
+                    .setPackage(packageName),
+                null,
+                0L,
+                userId,
+            )
+            .list
+            .isNotEmpty()
+
+    private fun requestsUnknownSources(app: ApplicationInfo): Boolean =
+        try {
+            AppGlobals.getPackageManager()
+                .getPackageInfo(app.packageName, PackageManager.GET_PERMISSIONS.toLong(), UserHandle.getUserId(app.uid))
+                ?.requestedPermissions
+                ?.contains(Manifest.permission.REQUEST_INSTALL_PACKAGES) == true
+        } catch (e: Exception) {
+            Log.e(TAG, "permissions of ${app.packageName} not read", e)
+            false
+        }
+}
