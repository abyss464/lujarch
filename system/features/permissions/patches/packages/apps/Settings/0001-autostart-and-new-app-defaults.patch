+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge;
+
+import android.app.AppOpsManager;
+import android.content.Context;
+import android.os.Process;
+import android.os.UserHandle;
+import android.util.Log;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * App battery usage > Autostart: whether the system starts the app, while it is not running,
+ * for a broadcast (at boot, for an alarm or a push message).
+ */
+public class LujarchAutostartPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "lujarch_permissions";
+    static final String KEY = "lujarch_autostart";
+
+    private final String mPackageName;
+    private final int mUid;
+    private final AppOpsManager mAppOps;
+
+    public LujarchAutostartPreferenceController(Context context, String packageName, int uid) {
+        super(context, KEY);
+        mPackageName = packageName;
+        mUid = uid;
+        mAppOps = context.getSystemService(AppOpsManager.class);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mPackageName != null && UserHandle.getAppId(mUid) >= Process.FIRST_APPLICATION_UID
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ListPreference list = (ListPreference) preference;
+        list.setEntries(new CharSequence[] {
+                mContext.getString(R.string.lujarch_choice_allow),
+                mContext.getString(R.string.lujarch_choice_ask),
+                mContext.getString(R.string.lujarch_choice_deny)});
+        list.setEntryValues(new CharSequence[] {
+                String.valueOf(AppOpsManager.MODE_ALLOWED),
+                String.valueOf(AppOpsManager.MODE_DEFAULT),
+                String.valueOf(AppOpsManager.MODE_ERRORED)});
+        final int mode = mode();
+        list.setValue(String.valueOf(mode));
+        list.setSummary(mode == AppOpsManager.MODE_ALLOWED
+                ? mContext.getString(R.string.lujarch_choice_allow)
+                : mContext.getString(mode == AppOpsManager.MODE_DEFAULT
+                        ? R.string.lujarch_autostart_summary_ask
+                        : R.string.lujarch_autostart_summary_deny));
+    }
+
+    /** The stored choice; Return empty data refuses a start as Don't allow does. */
+    private int mode() {
+        try {
+            final int mode = mAppOps.unsafeCheckOpRawNoThrow(
+                    AppOpsManager.OPSTR_LUJARCH_AUTOSTART, mUid, mPackageName);
+            if (mode == AppOpsManager.MODE_IGNORED) {
+                return AppOpsManager.MODE_ERRORED;
+            }
+            return mode == AppOpsManager.MODE_DEFAULT || mode == AppOpsManager.MODE_ERRORED
+                    ? mode : AppOpsManager.MODE_ALLOWED;
+        } catch (RuntimeException e) {
+            Log.e(TAG, "autostart of " + mPackageName + " not read", e);
+            return AppOpsManager.MODE_ALLOWED;
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        try {
+            mAppOps.setMode(AppOpsManager.OP_LUJARCH_AUTOSTART, mUid, mPackageName,
+                    Integer.parseInt((String) newValue));
+        } catch (RuntimeException e) {
+            Log.e(TAG, "autostart of " + mPackageName + " not set", e);
+            return false;
+        }
+        updateState(preference);
+        return true;
+    }
+}
