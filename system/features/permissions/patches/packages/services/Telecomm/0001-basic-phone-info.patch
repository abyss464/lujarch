+package com.android.server.telecom;
+
+import android.Manifest;
+import android.app.AppOpsManager;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Binder;
+import android.os.Process;
+import android.os.UserHandle;
+import android.telecom.Log;
+
+/**
+ * Basic phone info for the call state Telecom answers an app without READ_PHONE_STATE, the rules
+ * of the framework's LujarchPhoneInfo, which Telecom cannot reach: an app allowed the Phone
+ * permission reads as stock, uids below 10000 pass, "Ask every time" answers as Return empty data,
+ * and a failed lookup allows (logged).
+ */
+final class LujarchPhoneInfo {
+    private static final String OP = "android:lujarch_phone_info";
+
+    private LujarchPhoneInfo() {
+    }
+
+    /** The mode of the binder caller's read; call before clearing the calling identity. */
+    static int decideCaller(Context context, String packageName, String attributionTag) {
+        final int uid = Binder.getCallingUid();
+        final int pid = Binder.getCallingPid();
+        if (UserHandle.getAppId(uid) < Process.FIRST_APPLICATION_UID) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        try {
+            final AppOpsManager appOps = context.getSystemService(AppOpsManager.class);
+            String pkg = packageName;
+            if (pkg == null) {
+                final String[] packages = context.getPackageManager().getPackagesForUid(uid);
+                pkg = packages != null && packages.length > 0 ? packages[0] : null;
+            }
+            if (pkg == null) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            if (holdsPhonePermission(context, appOps, pid, uid, pkg)) {
+                return AppOpsManager.MODE_ALLOWED;
+            }
+            final int mode = appOps.noteOpNoThrow(OP, uid, pkg, attributionTag, null);
+            return mode == AppOpsManager.MODE_DEFAULT ? AppOpsManager.MODE_IGNORED : mode;
+        } catch (RuntimeException e) {
+            Log.w("LujarchPhoneInfo", "basic phone info of uid %d not decided; allowed: %s",
+                    uid, e);
+            return AppOpsManager.MODE_ALLOWED;
+        }
+    }
+
+    private static boolean holdsPhonePermission(Context context, AppOpsManager appOps, int pid,
+            int uid, String pkg) {
+        if (context.checkPermission(Manifest.permission.READ_PRIVILEGED_PHONE_STATE, pid, uid)
+                == PackageManager.PERMISSION_GRANTED) {
+            return true;
+        }
+        final boolean state = context.checkPermission(Manifest.permission.READ_PHONE_STATE, pid,
+                uid) == PackageManager.PERMISSION_GRANTED;
+        final boolean numbers = context.checkPermission(Manifest.permission.READ_PHONE_NUMBERS,
+                pid, uid) == PackageManager.PERMISSION_GRANTED;
+        return (state && appOps.unsafeCheckOpNoThrow(AppOpsManager.OPSTR_READ_PHONE_STATE, uid,
+                pkg) == AppOpsManager.MODE_ALLOWED)
+                || (numbers && appOps.unsafeCheckOpNoThrow(AppOpsManager.OPSTR_READ_PHONE_NUMBERS,
+                        uid, pkg) == AppOpsManager.MODE_ALLOWED);
+    }
+}
