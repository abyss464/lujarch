+    /**
+     * The ITelephony method another process is calling on this thread
+     * ({@link #onTransact}); null on the phone process's own calls. Basic phone info
+     * answers an app's own read only: calls the phone process makes to itself (through
+     * TelephonyManager, or while it serves another interface to an app, with that app's identity
+     * still on the thread) keep their stock answers.
+     */
+    private static final ThreadLocal<String> sLujarchIncoming = new ThreadLocal<>();
+
+    @Override
+    public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+            throws RemoteException {
+        final String outer = sLujarchIncoming.get();
+        sLujarchIncoming.set(ITelephony.Stub.getDefaultTransactionName(code));
+        try {
+            return super.onTransact(code, data, reply, flags);
+        } finally {
+            sLujarchIncoming.set(outer);
+        }
+    }
+
+    /**
+     * The basic phone info mode
+     * for a read the binder caller makes through one of {@code methods}, the
+     * ITelephony methods that reach the getter; MODE_ALLOWED on any other call. An app holding
+     * the Phone permission and uids below 10000 are allowed (LujarchPhoneInfo). Call before
+     * clearCallingIdentity.
+     *
+     * @param verifiedPackage the caller's package where the method verified it, else null (the
+     *        uid's first package is taken)
+     */
+    private int lujarchPhoneInfo(@Nullable String verifiedPackage, @Nullable String featureId,
+            String... methods) {
+        final String incoming = sLujarchIncoming.get();
+        if (incoming == null || !ArrayUtils.contains(methods, incoming)) {
+            return AppOpsManager.MODE_ALLOWED;
+        }
+        return LujarchPhoneInfo.decideCaller(mApp, verifiedPackage,
+                verifiedPackage != null ? featureId : null);
+    }
+
+    /**
+     * {@link #lujarchPhoneInfo} refuses, for a getter without a permission:
+     * it answers its "not known" value in every refused mode, as it never throws.
+     */
+    private boolean lujarchRefusesPhoneInfo(String... methods) {
+        return lujarchPhoneInfo(null, null, methods) != AppOpsManager.MODE_ALLOWED;
+    }
+
+    /**
+     * Whether a read the caller reached through a normal permission
+     * (READ_BASIC_PHONE_STATE, ACCESS_NETWORK_STATE) is refused by basic phone info
+     * ({@code mode}), decided as if that permission were missing: {@code stockEnforce}, the stock
+     * check that remains (READ_PHONE_STATE, MODIFY_PHONE_STATE, READ_PRIVILEGED_PHONE_STATE,
+     * carrier privileges), still lets the read through. When it throws, errored rethrows its
+     * SecurityException (as for a missing permission) and ignored refuses, so the getter
+     * answers its empty value.
+     */
+    private static boolean lujarchRefused(int mode, Runnable stockEnforce) {
+        if (mode == AppOpsManager.MODE_ALLOWED) {
+            return false;
+        }
+        try {
+            stockEnforce.run();
+            return false;
+        } catch (SecurityException e) {
+            if (mode == AppOpsManager.MODE_ERRORED) {
+                throw e;
+            }
+            return true;
+        }
+    }
+
+    /**
+     * The READ_PHONE_STATE check of a read READ_BASIC_PHONE_STATE did not
+     * pass ({@code mode} MODE_ALLOWED: the stock path, the permission is missing) or basic phone
+     * info refused ({@code mode} ignored or errored), as {@link #lujarchRefused}: its
+     * SecurityException propagates on the stock path and when errored, and reads false when
+     * ignored.
+     */
+    private static boolean lujarchReadBasic(int mode, BooleanSupplier readPhoneState) {
+        try {
+            return readPhoneState.getAsBoolean();
+        } catch (SecurityException e) {
+            if (mode == AppOpsManager.MODE_ALLOWED || mode == AppOpsManager.MODE_ERRORED) {
+                throw e;
+            }
+            return false;
+        }
+    }
