+/*
+ * SPDX-FileCopyrightText: The Lujarch Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.updater.lujarch
+
+import android.content.Context
+import android.icu.text.DateFormat
+import android.icu.text.ListFormatter
+import android.icu.text.MessageFormat
+import android.os.PowerManager
+import android.os.ServiceManager
+import android.os.ServiceSpecificException
+import android.provider.Settings
+import android.util.Log
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.text.AnnotatedString
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import com.android.settingslib.spa.widget.card.CardButton
+import com.android.settingslib.spa.widget.card.CardModel
+import com.android.settingslib.spa.widget.card.SettingsCard
+import java.util.Date
+import java.util.Locale
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.lineageos.updater.R
+import org.lineageos.updater.updates.action.AlertDialogState
+import org.lujarch.updates.IUpdates
+import org.lujarch.updates.Status
+
+/** The running build's confirmation and the previous build, through lujarch_updates. */
+object LujarchBuild {
+    private const val TAG = "lujarch_updates"
+    private const val SERVICE = "lujarch_updates"
+
+    /** The auto-confirm choice, in minutes (settings.toml of updates). */
+    private const val SETTING_AUTO_CONFIRM = "lujarch_updates_auto_confirm"
+    val AUTO_CONFIRM_MINUTES = intArrayOf(0, 30, 1440, 4320, 10080, 20160, 43200)
+
+    private fun service(): IUpdates? =
+        IUpdates.Stub.asInterface(ServiceManager.checkService(SERVICE)).also {
+            if (it == null) Log.e(TAG, "lujarch_updates is not running")
+        }
+
+    /** The status, or null when lujarch_updates cannot be asked (logged). */
+    fun status(): Status? =
+        try {
+            service()?.status
+        } catch (e: Exception) {
+            Log.e(TAG, "status not read", e)
+            null
+        }
+
+    /** Null when done, else what failed (logged). */
+    private fun call(what: String, action: (IUpdates) -> Unit): String? {
+        val service = service() ?: return "lujarch_updates is not running"
+        return try {
+            action(service)
+            null
+        } catch (e: ServiceSpecificException) {
+            Log.e(TAG, "$what: ${e.message}")
+            e.message ?: what
+        } catch (e: Exception) {
+            Log.e(TAG, what, e)
+            e.toString()
+        }
+    }
+
+    fun confirm(): String? = call("confirm") { it.confirm() }
+
+    fun restorePrevious(): String? = call("restore the previous build") { it.restorePrevious() }
+
+    fun endSafeBoot(): String? = call("end safe boot") { it.endSafeBoot() }
+
+    private fun safeBootName(context: Context, name: String): String =
+        when (name) {
+            "proxy" -> context.getString(R.string.lujarch_safe_boot_proxy)
+            "sync" -> context.getString(R.string.lujarch_safe_boot_sync)
+            "linux" -> context.getString(R.string.lujarch_safe_boot_linux)
+            "root" -> context.getString(R.string.lujarch_safe_boot_root)
+            "test_updates" -> context.getString(R.string.lujarch_safe_boot_test_updates)
+            else -> name
+        }
+
+    fun setAutoConfirm(context: Context, minutes: Int) {
+        if (!Settings.Global.putInt(context.contentResolver, SETTING_AUTO_CONFIRM, minutes)) {
+            Log.e(TAG, "$SETTING_AUTO_CONFIRM not written")
+        }
+    }
+
+    /** Why no other update can be installed now, or null. */
+    fun installBlocker(context: Context): String? =
+        when (status()?.state) {
+            IUpdates.STATE_WAITING -> context.getString(R.string.lujarch_install_waits)
+            IUpdates.STATE_MERGING -> context.getString(R.string.lujarch_install_merging)
+            IUpdates.STATE_RESTORING -> context.getString(R.string.lujarch_install_restoring)
+            else -> null
+        }
+
+    /** "Never", "After 30 minutes", "After 1 day" and so on. */
+    fun autoConfirmLabel(context: Context, minutes: Int): String =
+        when {
+            minutes <= 0 -> context.getString(R.string.lujarch_auto_confirm_never)
+            minutes % 1440 == 0 -> plural(context, R.string.lujarch_auto_confirm_days, minutes / 1440)
+            else -> plural(context, R.string.lujarch_auto_confirm_minutes, minutes)
+        }
+
+    private fun plural(context: Context, id: Int, count: Int): String =
+        MessageFormat(context.getString(id), Locale.getDefault()).format(mapOf("count" to count))
+
+    private fun restoreBlockerText(context: Context, blocker: String): String =
+        context.getString(
+            when (blocker) {
+                IUpdates.RESTORE_ANDROID_VERSION -> R.string.lujarch_restore_android_version
+                IUpdates.RESTORE_PATCH_LEVEL -> R.string.lujarch_restore_patch_level
+                IUpdates.RESTORE_NOT_BOOTABLE -> R.string.lujarch_restore_not_bootable
+                IUpdates.RESTORE_UNKNOWN_BUILD -> R.string.lujarch_restore_unknown_build
+                else -> R.string.lujarch_restore_unknown
+            }
+        )
+
+    /** System slots (UPD-6): the build of each slot, and whether the other one can still start. */
+    private fun slotsModel(context: Context, s: Status): CardModel {
+        val date = DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT)
+        fun build(b: String, android: String, patch: String) =
+            context.getString(R.string.lujarch_slot_build, b, android, patch)
+        val running = buildString {
+            append(context.getString(R.string.lujarch_slot_running, s.runningSlot.uppercase(Locale.ROOT)))
+            append("\n")
+            append(build(s.runningBuild, s.runningAndroid, s.runningSecurityPatch))
+            if (s.runningFirstBoot > 0) {
+                append("\n")
+                append(context.getString(R.string.lujarch_slot_first_start, date.format(Date(s.runningFirstBoot * 1000))))
+            }
+        }
+        val other = buildString {
+            append(context.getString(R.string.lujarch_slot_other, s.otherSlot.uppercase(Locale.ROOT)))
+            append("\n")
+            if (s.previousBuild.isEmpty()) {
+                append(context.getString(R.string.lujarch_slot_no_record))
+            } else {
+                append(build(s.previousBuild, s.otherAndroid, s.otherSecurityPatch))
+            }
+            append("\n")
+            append(
+                when {
+                    s.state == IUpdates.STATE_RESTORING -> context.getString(R.string.lujarch_slot_starts_next)
+                    s.state == IUpdates.STATE_WAITING && s.restoreBlocker.isEmpty() ->
+                        context.getString(R.string.lujarch_slot_restorable)
+                    s.state == IUpdates.STATE_WAITING -> restoreBlockerText(context, s.restoreBlocker)
+                    s.otherBootable == 0 -> context.getString(R.string.lujarch_slot_not_bootable)
+                    else -> context.getString(R.string.lujarch_slot_replaced)
+                }
+            )
+        }
+        return CardModel(
+            title = context.getString(R.string.lujarch_slots_title),
+            text = running + "\n\n" + other,
+        )
+    }
+
+    /** The card of a build that waits for confirmation, is merged or gives way to the previous one. */
+    @Composable
+    fun Card(showDialog: (AlertDialogState) -> Unit) {
+        val context = LocalContext.current
+        val scope = rememberCoroutineScope()
+        var status by remember { mutableStateOf<Status?>(null) }
+        var refresh by remember { mutableIntStateOf(0) }
+        val lifecycleOwner = LocalLifecycleOwner.current
+        DisposableEffect(lifecycleOwner) {
+            val observer = LifecycleEventObserver { _, event ->
+                if (event == Lifecycle.Event.ON_RESUME) refresh++
+            }
+            lifecycleOwner.lifecycle.addObserver(observer)
+            onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }
+        }
+        LaunchedEffect(refresh) {
+            while (true) {
+                status = withContext(Dispatchers.IO) { status() }
+                if (status?.state != IUpdates.STATE_MERGING) break
+                delay(5_000)
+            }
+        }
+        val s = status ?: return
+        fun act(failure: Int, action: () -> String?, then: () -> Unit = {}) {
+            scope.launch {
+                val error = withContext(Dispatchers.IO) { action() }
+                if (error != null) {
+                    showDialog(
+                        AlertDialogState(
+                            title = context.getString(failure),
+                            text = AnnotatedString(context.getString(R.string.lujarch_action_failed, error)),
+                        )
+                    )
+                } else {
+                    then()
+                }
+                refresh++
+            }
+        }
+        val restart = {
+            context.getSystemService(PowerManager::class.java)!!.reboot(null)
+        }
+        // Safe boot (UPD-5): what its switches turned off at this start, and the way back.
+        if (s.safeBootSet || s.safeBootOff.isNotEmpty()) {
+            val names = s.safeBootOff.map { safeBootName(context, it) }
+            val lines = mutableListOf(
+                if (names.isEmpty()) {
+                    context.getString(R.string.lujarch_safe_boot_next)
+                } else {
+                    context.getString(R.string.lujarch_safe_boot_off, ListFormatter.getInstance().format(names))
+                }
+            )
+            val buttons =
+                if (s.safeBootSet) {
+                    lines += context.getString(R.string.lujarch_safe_boot_until)
+                    listOf(
+                        CardButton(context.getString(R.string.lujarch_safe_boot_end)) {
+                            act(R.string.lujarch_safe_boot_end_failed, ::endSafeBoot)
+                        }
+                    )
+                } else {
+                    lines += context.getString(R.string.lujarch_safe_boot_ended)
+                    listOf(CardButton(context.getString(R.string.lujarch_restart), onClick = restart))
+                }
+            SettingsCard(
+                CardModel(
+                    title = context.getString(R.string.lujarch_safe_boot_title),
+                    text = lines.joinToString("\n"),
+                    buttons = buttons,
+                )
+            )
+        }
+        val model =
+            when (s.state) {
+                IUpdates.STATE_WAITING -> {
+                    val lines = mutableListOf(context.getString(R.string.lujarch_waits_text))
+                    if (s.autoConfirmAt > 0) {
+                        val at =
+                            DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT)
+                                .format(Date(s.autoConfirmAt * 1000))
+                        lines += context.getString(R.string.lujarch_waits_auto, at)
+                    }
+                    if (s.restoreBlocker.isNotEmpty()) lines += restoreBlockerText(context, s.restoreBlocker)
+                    val buttons =
+                        mutableListOf(
+                            CardButton(context.getString(R.string.lujarch_confirm)) {
+                                showDialog(
+                                    AlertDialogState(
+                                        title = context.getString(R.string.lujarch_confirm_title),
+                                        text = AnnotatedString(context.getString(R.string.lujarch_confirm_message)),
+                                        showDismiss = true,
+                                        onConfirm = { act(R.string.lujarch_confirm_failed, ::confirm) },
+                                    )
+                                )
+                            }
+                        )
+                    if (s.restoreBlocker.isEmpty()) {
+                        buttons +=
+                            CardButton(context.getString(R.string.lujarch_restore)) {
+                                showDialog(
+                                    AlertDialogState(
+                                        title = context.getString(R.string.lujarch_restore_title),
+                                        text = AnnotatedString(context.getString(R.string.lujarch_restore_message)),
+                                        showDismiss = true,
+                                        onConfirm = {
+                                            act(R.string.lujarch_restore_failed, ::restorePrevious, restart)
+                                        },
+                                    )
+                                )
+                            }
+                    }
+                    CardModel(
+                        title = context.getString(R.string.lujarch_waits_title),
+                        text = lines.joinToString("\n"),
+                        buttons = buttons,
+                    )
+                }
+                IUpdates.STATE_MERGING ->
+                    CardModel(
+                        title = context.getString(R.string.lujarch_merging_title),
+                        text =
+                            if (s.mergeProgress >= 0) {
+                                context.getString(R.string.lujarch_merging_progress, s.mergeProgress)
+                            } else {
+                                context.getString(R.string.lujarch_merging_text)
+                            },
+                    )
+                IUpdates.STATE_RESTORING ->
+                    CardModel(
+                        title = context.getString(R.string.lujarch_restoring_title),
+                        text = context.getString(R.string.lujarch_restoring_text),
+                        buttons = listOf(CardButton(context.getString(R.string.lujarch_restart), onClick = restart)),
+                    )
+                else -> null
+            }
+        model?.let { SettingsCard(it) }
+        SettingsCard(slotsModel(context, s))
+    }
+}
