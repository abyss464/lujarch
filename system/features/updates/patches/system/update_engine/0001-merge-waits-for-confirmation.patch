+// While the merge of the running build waits for its confirmation, the previous build is still in
+// the other slot and no update can be written there (libsnapshot keeps the live snapshots).
+const char kLujarchWaitsForConfirmation[] =
+    "lujarch_updates: the running build waits for confirmation; no other update is installed";
