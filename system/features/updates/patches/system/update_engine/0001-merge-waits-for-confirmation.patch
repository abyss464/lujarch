+// Whether the merge of the running build waits for its confirmation: an update that runs on
+// snapshots, booted into its target slot, while the source slot still holds the previous build.
+// The boot is marked successful as before, so the bootloader never falls back on its own; the
+// previous build is restored only on request (lujarch_updates switches the active slot, and
+// libsnapshot cancels the snapshots at the next boot). Recovery merges as before.
+bool CleanupPreviousUpdateAction::LujarchMergeWaits() {
+  if (kIsRecovery)
+    return false;
+  // The decision SnapshotManager::InitiateMerge makes; which slot the update came from is
+  // libsnapshot's boot indicator, compared with the booted slot.
+  const auto gate = android::snapshot::lujarch::ReadGateInput(
+      snapshot_->GetUpdateState() == UpdateState::Unverified,
+      android::base::GetProperty("ro.boot.slot_suffix", ""));
+  lujarch_on_source_ = android::snapshot::lujarch::BootedFromSource(gate);
+  const bool waits = android::snapshot::lujarch::MergeAwaitsConfirmation(gate);
+  if (waits) {
+    LOG(INFO) << "lujarch_updates: the merge of " << gate.version << " in slot "
+              << gate.current_suffix << " waits: "
+              << android::snapshot::lujarch::WaitReason(gate);
+  }
+  return waits;
+}
+
+void CleanupPreviousUpdateAction::LujarchWaitForConfirmation() {
+  TEST_AND_RETURN(running_);
+  if (!lujarch_waiting_) {
+    lujarch_waiting_ = true;
+    LujarchPublish("waiting");
+  }
+  if (lujarch_watch_ != nullptr)
+    return;
+  lujarch_inotify_fd_.reset(inotify_init1(IN_NONBLOCK | IN_CLOEXEC));
+  // lujarch_updates renames a complete file into place (IN_MOVED_TO).
+  if (lujarch_inotify_fd_ < 0 ||
+      inotify_add_watch(lujarch_inotify_fd_.get(),
+                        kLujarchDir,
+                        IN_CLOSE_WRITE | IN_MOVED_TO | IN_DELETE |
+                            IN_DELETE_SELF | IN_MOVE_SELF) < 0) {
+    PLOG(ERROR) << "lujarch_updates: cannot watch " << kLujarchDir
+                << ", checking the confirmation every "
+                << kLujarchRecheckInterval.InSeconds() << " s";
+    lujarch_inotify_fd_.reset();
+    if (!scheduled_task_.PostTask(
+            FROM_HERE,
+            [this]() { LujarchRecheck(); },
+            kLujarchRecheckInterval)) {
+      CheckTaskScheduled("LujarchRecheck");
+    }
+    return;
+  }
+  lujarch_watch_ = base::FileDescriptorWatcher::WatchReadable(
+      lujarch_inotify_fd_.get(),
+      base::BindRepeating(&CleanupPreviousUpdateAction::LujarchOnGateEvent,
+                          base::Unretained(this)));
+}
+
+void CleanupPreviousUpdateAction::LujarchOnGateEvent() {
+  // The events only say that something changed; the file is read again.
+  char buf[4096];
+  while (read(lujarch_inotify_fd_.get(), buf, sizeof(buf)) > 0) {
+  }
+  LujarchRecheck();
+}
+
+void CleanupPreviousUpdateAction::LujarchRecheck() {
+  AcknowledgeTaskExecuted();
+  TEST_AND_RETURN(running_);
+  if (LujarchMergeWaits()) {
+    LujarchWaitForConfirmation();
+    return;
+  }
+  LOG(INFO) << "lujarch_updates: the running build is confirmed, merging";
+  LujarchStopWatching();
+  lujarch_waiting_ = false;
+  CheckForMergeDelay();
+}
+
+void CleanupPreviousUpdateAction::LujarchStopWatching() {
+  lujarch_watch_.reset();
+  lujarch_inotify_fd_.reset();
+}
