+bool LujarchMergeWaitsForConfirmation(ActionProcessor* processor) {
+  if (!processor->IsRunning())
+    return false;
+  AbstractAction* action = processor->current_action();
+  return action != nullptr &&
+         action->Type() == CleanupPreviousUpdateAction::StaticType() &&
+         static_cast<CleanupPreviousUpdateAction*>(action)->LujarchWaitingForConfirmation();
+}
