+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "lujarch_safe_boot.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <functional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <android-base/file.h>
+#include <android-base/logging.h>
+#include <android-base/stringprintf.h>
+#include <android-base/strings.h>
+#include <android-base/unique_fd.h>
+#include <private/android_filesystem_config.h>
+#include <selinux/android.h>
+#include <selinux/label.h>
+#include <selinux/selinux.h>
+
+#include "recovery_ui/ui.h"
+#include "recovery_utils/roots.h"
+
+using android::base::StringPrintf;
+using android::base::unique_fd;
+
+namespace {
+
+constexpr const char* kMetadataRoot = "/metadata";
+constexpr const char* kDir = "/metadata/lujarch";
+constexpr const char* kFile = "/metadata/lujarch/safe-boot";
+constexpr const char* kTmpFile = "/metadata/lujarch/safe-boot.tmp";
+// What every reader of the file reads at most (lujarch-safe-boot, the
+// services); this menu writes far less.
+constexpr size_t kMaxSize = 4096;
+
+struct Switch {
+  const char* name;    // "<name>=off" in the file
+  const char* normal;  // the menu item while the component runs normally
+  const char* off;     // the menu item while the switch is set
+};
+
+// The recovery font has ASCII only, so the menu is in English, as the rest
+// of Lineage's recovery; Settings > Security & privacy names the switches in the
+// owner's language. A menu line holds kMaxItem characters on this phone
+// (1080 px, 27 px menu glyphs, 24 px indent) and is cut beyond that.
+constexpr size_t kMaxItem = 39;
+constexpr Switch kSwitches[] = {
+  { "proxy", "Proxy: normal", "Proxy: OFF (direct connection)" },
+  { "sync", "Sync: normal", "Sync: OFF" },
+  { "linux", "Linux: normal", "Linux: OFF" },
+  { "root", "Root: normal", "Root: OFF (no su for any app)" },
+  // The test builds of Lujarch's apps installed over the image's copies.
+  { "test_updates", "App test updates: kept", "App test updates: REMOVED at boot" },
+};
+
+constexpr size_t Length(const char* text) {
+  size_t n = 0;
+  while (text[n] != '\0') ++n;
+  return n;
+}
+
+constexpr bool ItemsFit() {
+  for (const Switch& s : kSwitches) {
+    if (Length(s.normal) > kMaxItem || Length(s.off) > kMaxItem) return false;
+  }
+  return true;
+}
+static_assert(ItemsFit(), "a safe boot menu line is longer than the menu shows");
+
+using Flags = std::set<std::string>;
+
+bool IsSwitch(const std::string& name) {
+  for (const Switch& s : kSwitches) {
+    if (name == s.name) return true;
+  }
+  return false;
+}
+
+// The label file_contexts gives a path (lujarch_safe_boot_file, product
+// policy), set for the files this menu creates as recovery labels the files
+// it installs (otautil/dirutil.cpp).
+class ScopedCreateContext {
+ public:
+  ScopedCreateContext(const char* path, mode_t mode) {
+    static selabel_handle* handle = selinux_android_file_context_handle();
+    char* context = nullptr;
+    if (handle == nullptr || selabel_lookup(handle, &context, path, mode) != 0) {
+      PLOG(WARNING) << "Lujarch safe boot: no SELinux label for " << path;
+      return;
+    }
+    if (setfscreatecon(context) == 0) {
+      set_ = true;
+    } else {
+      PLOG(WARNING) << "Lujarch safe boot: setfscreatecon " << context;
+    }
+    freecon(context);
+  }
+  ~ScopedCreateContext() {
+    if (set_) setfscreatecon(nullptr);
+  }
+
+ private:
+  bool set_ = false;
+};
+
+bool FsyncDir(const char* path, std::string* error) {
+  unique_fd fd(open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+  if (fd == -1 || fsync(fd.get()) != 0) {
+    *error = StringPrintf("cannot sync %s: %s", path, strerror(errno));
+    return false;
+  }
+  return true;
+}
+
+// The switches in the file; no file is the normal boot.
+bool ReadFlags(Flags* flags, std::string* error) {
+  flags->clear();
+  unique_fd fd(open(kFile, O_RDONLY | O_CLOEXEC | O_NOFOLLOW));
+  if (fd == -1) {
+    if (errno == ENOENT) return true;
+    *error = StringPrintf("cannot open %s: %s", kFile, strerror(errno));
+    return false;
+  }
+  std::string text(kMaxSize, '\0');
+  size_t size = 0;
+  while (size < text.size()) {
+    ssize_t n = TEMP_FAILURE_RETRY(read(fd.get(), &text[size], text.size() - size));
+    if (n < 0) {
+      *error = StringPrintf("cannot read %s: %s", kFile, strerror(errno));
+      return false;
+    }
+    if (n == 0) break;
+    size += static_cast<size_t>(n);
+  }
+  text.resize(size);
+  for (std::string line : android::base::Split(text, "\n")) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    if (!android::base::EndsWith(line, "=off")) continue;
+    std::string name = line.substr(0, line.size() - 4);
+    if (IsSwitch(name)) flags->insert(name);
+  }
+  return true;
+}
+
+// /metadata/lujarch: 0750 root:system, readable by lujarch-safe-boot (uid
+// system), writable by lujarch_updates (uid root). Init creates it at every boot;
+// it is missing only after /metadata was formatted.
+bool EnsureDir(std::string* error) {
+  struct stat st;
+  if (lstat(kDir, &st) == 0) {
+    if (S_ISDIR(st.st_mode)) return true;
+    *error = StringPrintf("%s is not a directory", kDir);
+    return false;
+  }
+  if (errno != ENOENT) {
+    *error = StringPrintf("cannot stat %s: %s", kDir, strerror(errno));
+    return false;
+  }
+  {
+    ScopedCreateContext context(kDir, S_IFDIR);
+    if (mkdir(kDir, 0750) != 0 && errno != EEXIST) {
+      *error = StringPrintf("cannot create %s: %s", kDir, strerror(errno));
+      return false;
+    }
+  }
+  if (chown(kDir, AID_ROOT, AID_SYSTEM) != 0 || chmod(kDir, 0750) != 0) {
+    *error = StringPrintf("cannot set the owner of %s: %s", kDir, strerror(errno));
+    return false;
+  }
+  return FsyncDir(kMetadataRoot, error);
+}
+
+// Replaces the file atomically, or removes it when every switch is normal.
+bool WriteFlags(const Flags& flags, std::string* error) {
+  if (flags.empty()) {
+    if (unlink(kFile) != 0 && errno != ENOENT) {
+      *error = StringPrintf("cannot remove %s: %s", kFile, strerror(errno));
+      return false;
+    }
+    unlink(kTmpFile);
+    struct stat st;
+    if (lstat(kDir, &st) != 0) return true;
+    return FsyncDir(kDir, error);
+  }
+  if (!EnsureDir(error)) return false;
+
+  std::string text = "# Lujarch safe boot, set in recovery; read at every boot until cleared\n";
+  for (const Switch& s : kSwitches) {
+    if (flags.count(s.name) != 0) text += std::string(s.name) + "=off\n";
+  }
+
+  unique_fd fd;
+  {
+    ScopedCreateContext context(kTmpFile, S_IFREG);
+    fd.reset(open(kTmpFile, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0640));
+  }
+  if (fd == -1) {
+    *error = StringPrintf("cannot create %s: %s", kTmpFile, strerror(errno));
+    return false;
+  }
+  // root:system 0640: lujarch-safe-boot reads it as uid system.
+  if (fchown(fd.get(), AID_ROOT, AID_SYSTEM) != 0 || fchmod(fd.get(), 0640) != 0 ||
+      !android::base::WriteStringToFd(text, fd.get()) || fsync(fd.get()) != 0) {
+    *error = StringPrintf("cannot write %s: %s", kTmpFile, strerror(errno));
+    unlink(kTmpFile);
+    return false;
+  }
+  fd.reset();
+  if (rename(kTmpFile, kFile) != 0) {
+    *error = StringPrintf("cannot replace %s: %s", kFile, strerror(errno));
+    unlink(kTmpFile);
+    return false;
+  }
+  return FsyncDir(kDir, error);
+}
+
+std::string Describe(const Flags& flags) {
+  if (flags.empty()) return "normal boot";
+  std::vector<std::string> names(flags.begin(), flags.end());
+  return "off: " + android::base::Join(names, ", ");
+}
+
+}  // namespace
+
+void ShowLujarchSafeBootMenu(Device* device) {
+  RecoveryUI* ui = device->GetUI();
+  if (ensure_path_mounted(kMetadataRoot) != 0) {
+    LOG(ERROR) << "Lujarch safe boot: cannot mount " << kMetadataRoot;
+    ui->Print("Lujarch safe boot: cannot mount %s.\n", kMetadataRoot);
+    return;
+  }
+  Flags flags;
+  std::string error;
+  if (!ReadFlags(&flags, &error)) {
+    LOG(ERROR) << "Lujarch safe boot: " << error;
+    ui->Print("Lujarch safe boot: %s\n", error.c_str());
+    return;
+  }
+  LOG(INFO) << "Lujarch safe boot: " << Describe(flags);
+
+  const std::vector<std::string> headers{
+    "Lujarch safe boot",
+    "A switch takes effect at the next boot and stays until it is switched back here or "
+    "cleared in Settings > Security & privacy.",
+  };
+  size_t selected = 0;
+  for (;;) {
+    std::vector<std::string> items;
+    for (const Switch& s : kSwitches) {
+      items.push_back(flags.count(s.name) != 0 ? s.off : s.normal);
+    }
+    const size_t all_normal = items.size();
+    items.push_back("All back to normal");
+
+    size_t chosen = ui->ShowMenu(
+        headers, items, selected, true /* menu_only */,
+        std::bind(&Device::HandleMenuKey, device, std::placeholders::_1, std::placeholders::_2));
+    // Back, home, a timeout or an interrupt (each a negative code) leave
+    // the menu; the switches are already saved.
+    if (chosen >= items.size()) return;
+    selected = chosen;
+
+    Flags next = flags;
+    if (chosen == all_normal) {
+      next.clear();
+    } else if (next.erase(std::string(kSwitches[chosen].name)) == 0) {
+      next.insert(kSwitches[chosen].name);
+    }
+    if (next == flags) continue;
+    if (!WriteFlags(next, &error)) {
+      LOG(ERROR) << "Lujarch safe boot: " << error;
+      ui->Print("Lujarch safe boot: %s\n", error.c_str());
+      continue;
+    }
+    flags = next;
+    LOG(INFO) << "Lujarch safe boot: " << Describe(flags);
+    ui->Print("Lujarch safe boot from the next boot: %s.\n", Describe(flags).c_str());
+  }
+}
