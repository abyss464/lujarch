+#include "recovery_ui/device.h"
+
+// Lujarch system slots (UPD-6):
+// the build of each slot and whether the previous build can still be
+// started. After an update the new build runs on snapshots, and the previous
+// build stays whole in the other slot until the owner confirms the new one in
+// Settings > System > System updates (update_engine merges only then). Until the merge this
+// menu can set the other slot active, after a confirmation, and restart into
+// it; libsnapshot then cancels the update once the previous build has booted.
+// The builds are named from /metadata/lujarch/updates/slots (written by
+// lujarch_updates at every boot) and, for the running slot, from this recovery's own
+// properties: recovery is an A/B partition written by every update.
+//
+// Returns Device::REBOOT after the other slot was set active, else NO_ACTION.
+Device::BuiltinAction ShowLujarchSlotsMenu(Device* device);
