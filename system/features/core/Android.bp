// Lujarch's services in system_server.
java_library {
    name: "lujarch-services",
    srcs: ["src/services/**/*.java"],
    libs: ["services"],
    platform_apis: true,
    installable: true,
    system_ext_specific: true,
}

// The Global switches of every feature's settings.toml, generated by tools/lujarch.
prebuilt_etc {
    name: "lujarch-settings-mirror",
    src: "generated/settings-mirror.txt",
    filename_from_src: true,
    sub_dir: "lujarch",
    system_ext_specific: true,
}

// The base every Lujarch daemon is built on (lujarch/daemon.h), its HTTP client for the local
// APIs of the programs it runs (lujarch/http.h) and text helpers (lujarch/text.h), and Lujarch's
// user ids (lujarch/aid.h).
cc_library_static {
    name: "liblujarch_daemon",
    srcs: ["src/daemon/*.cpp"],
    export_include_dirs: ["src/daemon/include"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libjsoncpp",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror"],
    cpp_std: "c++20",
    system_ext_specific: true,
}

// What a feature adds to App info and search, for the features' page libraries.
java_library {
    name: "LujarchSettingsContribution",
    srcs: ["src/contribution/**/*.kt"],
    platform_apis: true,
}

// The page framework of Lujarch's pages in Settings, for the features' page libraries: the page
// activity, the base page with its error banner, page dialogs, app lists.
android_library {
    name: "LujarchSettingsPages",
    srcs: ["src/pages/**/*.kt"],
    manifest: "src/pages/AndroidManifest.xml",
    resource_dirs: ["src/pages/res"],
    platform_apis: true,
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.core_core",
        "androidx.fragment_fragment",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.preference_preference",
        "kotlinx_coroutines_android",
        "SettingsLibActionButtonsPreference",
        "SettingsLibAppPreference",
        "SettingsLibBannerMessagePreference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibFooterPreference",
        "SettingsLibMainSwitchPreference",
        "SettingsLibSelectorWithWidgetPreference",
        "SettingsLibSettingsTheme",
        "SettingsLibTopIntroPreference",
        "SettingsLibUsageProgressBarPreference",
        "SettingsLibZeroStatePreference",
    ],
}

// Lujarch's pages in Settings: this framework and every feature's page library.
android_app {
    name: "LujarchSettings",
    defaults: ["lujarch_settings_features"],
    static_libs: ["LujarchSettingsContribution"],
    optimize: {
        proguard_flags_files: ["src/settings/proguard.flags"],
    },
    srcs: ["src/settings/**/*.kt"],
    manifest: "src/settings/AndroidManifest.xml",
    resource_dirs: ["src/settings/res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
}
