+package com.android.settings.spa.app.appinfo
+
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.UserHandle
+import android.util.Log
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.ui.platform.LocalContext
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.android.settingslib.spa.widget.preference.Preference
+import com.android.settingslib.spa.widget.preference.PreferenceModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.flow.flowOn
+
+private const val TAG = "lujarch_core"
+private const val AUTHORITY = "org.lujarch.settings.appinfo"
+private const val LUJARCH_SETTINGS = "org.lujarch.settings"
+
+private data class LujarchRow(val title: String, val summary: String, val action: String)
+
+/** The rows Lujarch's features contribute to this app's App info, read from Lujarch Settings. */
+@Composable
+fun LujarchAppInfoRows(app: ApplicationInfo) {
+    val context = LocalContext.current
+    val rows by remember(app) {
+        flow { emit(lujarchRows(context, app)) }.flowOn(Dispatchers.IO)
+    }.collectAsStateWithLifecycle(initialValue = emptyList())
+    for (row in rows) {
+        Preference(object : PreferenceModel {
+            override val title = row.title
+            override val summary = { row.summary }
+            override val onClick = { openRow(context, app, row) }
+        })
+    }
+}
+
+private fun lujarchRows(context: Context, app: ApplicationInfo): List<LujarchRow> {
+    // Only a system app may provide these rows.
+    val provider = context.packageManager.resolveContentProvider(
+        AUTHORITY,
+        PackageManager.ComponentInfoFlags.of(PackageManager.MATCH_SYSTEM_ONLY.toLong()),
+    ) ?: return emptyList()
+    if (provider.packageName != LUJARCH_SETTINGS) return emptyList()
+    val uri = Uri.Builder().scheme("content").authority(AUTHORITY)
+        .appendPath(app.packageName)
+        .appendQueryParameter("user", UserHandle.getUserId(app.uid).toString())
+        .build()
+    return try {
+        context.contentResolver.query(uri, null, null, null, null)?.use { cursor ->
+            buildList {
+                while (cursor.moveToNext()) {
+                    add(LujarchRow(
+                        title = cursor.getString(cursor.getColumnIndexOrThrow("title")),
+                        summary = cursor.getString(cursor.getColumnIndexOrThrow("summary")),
+                        action = cursor.getString(cursor.getColumnIndexOrThrow("action")),
+                    ))
+                }
+            }
+        } ?: emptyList()
+    } catch (e: RuntimeException) {
+        Log.e(TAG, "cannot read Lujarch's App info rows for ${app.packageName}", e)
+        emptyList()
+    }
+}
+
+private fun openRow(context: Context, app: ApplicationInfo, row: LujarchRow) {
+    val intent = Intent(row.action)
+        .setPackage(LUJARCH_SETTINGS)
+        .putExtra(Intent.EXTRA_PACKAGE_NAME, app.packageName)
+        .putExtra(Intent.EXTRA_USER, UserHandle.getUserHandleForUid(app.uid))
+    try {
+        context.startActivityAsUser(intent, UserHandle.getUserHandleForUid(app.uid))
+    } catch (e: ActivityNotFoundException) {
+        Log.e(TAG, "no page for ${row.action}", e)
+    }
+}
