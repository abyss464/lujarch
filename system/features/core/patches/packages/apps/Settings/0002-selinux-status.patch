+
+package com.android.settings.deviceinfo.firmwareversion
+
+import android.content.Context
+import android.os.SELinux
+import androidx.preference.Preference
+import com.android.settings.R
+import com.android.settingslib.metadata.PreferenceMetadata
+import com.android.settingslib.metadata.PreferenceSummaryProvider
+import com.android.settingslib.preference.PreferenceBinding
+
+/** Lujarch (CORE-9): Android version shows whether SELinux is enforcing. */
+class SelinuxStatusPreference : PreferenceMetadata, PreferenceSummaryProvider, PreferenceBinding {
+
+    override val key: String
+        get() = "lujarch_selinux_status"
+
+    override val purpose: Int
+        get() = R.string.lujarch_selinux_status_purpose
+
+    override val title: Int
+        get() = R.string.lujarch_selinux_status
+
+    override val indexable
+        get() = false
+
+    override fun bind(preference: Preference, metadata: PreferenceMetadata) {
+        super.bind(preference, metadata)
+        preference.isCopyingEnabled = true
+        preference.isSelectable = false
+    }
+
+    override fun getSummary(context: Context): CharSequence =
+        context.getString(
+            when {
+                !SELinux.isSELinuxEnabled() -> R.string.lujarch_selinux_disabled
+                SELinux.isSELinuxEnforced() -> R.string.lujarch_selinux_enforcing
+                else -> R.string.lujarch_selinux_permissive
+            }
+        )
+}
