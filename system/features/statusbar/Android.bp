// Status bar > Status bar items: LineageOS' row to the page takes the page's name.
runtime_resource_overlay {
    name: "LujarchStatusBarLineagePartsOverlay",
    manifest: "src/overlay/lineageparts/AndroidManifest.xml",
    resource_dirs: ["src/overlay/lineageparts/res"],
    system_ext_specific: true,
}

// The switches of Status bar items in Settings search.
android_library {
    name: "LujarchStatusbarSettings",
    srcs: ["src/settings/**/*.kt"],
    manifest: "src/settings/AndroidManifest.xml",
    platform_apis: true,
    libs: ["LujarchSettingsContribution"],
}
