+     * holds a visible icon, so a claim that stops being true is found.
+     */
+    val NEVER_APPEARS: Map<String, String> =
+        mapOf(
+            "no_calling" to "nothing sets it",
+            "call_strength" to "nothing sets it; the mobile icon carries the signal",
+            "sync_failing" to "nothing sets it",
+            "sync_active" to "nothing sets it",
+            "nfc" to "the NFC service sets no status bar icon",
+            "cdma_eri" to "nothing sets it; CDMA roaming is in the mobile icon",
+            "data_connection" to "nothing sets it; the network type is in the mobile icon",
+            "phone_evdo_signal" to "nothing sets it",
+            "phone_signal" to "nothing sets it; the signal is the mobile icon",
+            "secure" to "nothing sets it under this name",
+            "camera" to "always set invisible; the privacy indicators show camera use",
+            "microphone" to "always set invisible; the privacy indicators show microphone use",
+            "screen_record" to "always set invisible; the screen recording chip shows it",
+            "assist_attention__external" to "config_enableVisualQueryAttentionDetection is false",
+        )
+
+    /** The switches of [group] that can appear on this device, in page order. */
+    @JvmStatic
+    fun itemsFor(context: Context, group: StatusBarGroup): List<StatusBarItem> =
+        ITEMS.filter { it.group == group && it.appears.onThisDevice(context) }
+}
