+package com.android.systemui.statusbar.lujarch.lyrics
+
+import android.animation.ValueAnimator
+import android.app.ActivityOptions
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.graphics.Rect
+import android.os.UserHandle
+import android.util.AttributeSet
+import android.util.Log
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.animation.PathInterpolator
+import android.widget.FrameLayout
+import android.widget.TextView
+import com.android.systemui.plugins.DarkIconDispatcher
+import com.android.systemui.res.R
+import java.util.ArrayList
+
+/**
+ * Lujarch: the lyric line on the start side of the status bar (SB-3). One line at a
+ * time; a new line rises in as the old one rises out. A line wider than the view rests, then slides to
+ * its end within the time it stays, and rests again. The text takes the clock's look and its tint. A tap
+ * opens the app that plays.
+ */
+class LyricsView(context: Context, attrs: AttributeSet?) :
+    FrameLayout(context, attrs), DarkIconDispatcher.DarkReceiver {
+
+    private var shown = newText()
+    private var leaving = newText()
+    private var line: StatusBarLyrics.Line? = null
+    private var color = 0
+    private var scroll: ValueAnimator? = null
+
+    init {
+        clipChildren = true
+        clipToPadding = true
+        addView(leaving)
+        addView(shown)
+        leaving.visibility = INVISIBLE
+        color = shown.currentTextColor
+        setOnClickListener { open() }
+        contentDescription = null
+    }
+
+    private fun newText() =
+        TextView(context).apply {
+            layoutParams =
+                LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.MATCH_PARENT, Gravity.START or Gravity.CENTER_VERTICAL)
+            setTextAppearance(R.style.TextAppearance_StatusBar_Default)
+            gravity = Gravity.CENTER_VERTICAL or Gravity.START
+            isSingleLine = true
+            setHorizontallyScrolling(true)
+            ellipsize = null
+            includeFontPadding = false
+            importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+        }
+
+    /** Shows [next], or hides the view for null. */
+    fun show(next: StatusBarLyrics.Line?) {
+        val old = line
+        line = next
+        if (next == null) {
+            stopScroll()
+            visibility = GONE
+            return
+        }
+        contentDescription = next.text
+        if (visibility != VISIBLE || old == null) {
+            // A change still running from before the view went away would leave the line half faded.
+            shown.animate().cancel()
+            leaving.animate().cancel()
+            stopScroll()
+            visibility = VISIBLE
+            shown.text = next.text
+            shown.scrollTo(0, 0)
+            shown.translationY = 0f
+            shown.alpha = 1f
+            leaving.visibility = INVISIBLE
+            post { startScroll(next) }
+            return
+        }
+        if (old.text == next.text) return
+        // The old line becomes the leaving one; the new one rises in.
+        val out = shown
+        shown = leaving
+        leaving = out
+        bringChildToFront(shown)
+        stopScroll()
+        shown.text = next.text
+        shown.scrollTo(0, 0)
+        shown.setTextColor(color)
+        shown.visibility = VISIBLE
+        val rise = height * RISE_FRACTION
+        shown.translationY = rise
+        shown.alpha = 0f
+        shown.animate().translationY(0f).alpha(1f).setDuration(CHANGE_MS).setInterpolator(EMPHASIZED)
+            .withEndAction { startScroll(next) }.start()
+        leaving.animate().translationY(-rise).alpha(0f).setDuration(CHANGE_MS).setInterpolator(EMPHASIZED)
+            .withEndAction { leaving.visibility = INVISIBLE }.start()
+    }
+
+    /**
+     * A line wider than the view: rest, scroll its text to the end, rest, all within the time it stays.
+     * The text scrolls inside its view (scrollX): the view is as wide as this one, and moving the view
+     * itself would carry away a text cut at its edge.
+     */
+    private fun startScroll(forLine: StatusBarLyrics.Line) {
+        if (line !== forLine || shown.width == 0) return
+        val visible = shown.width - shown.totalPaddingLeft - shown.totalPaddingRight
+        val overflow = shown.paint.measureText(shown.text.toString()) - visible
+        shown.scrollTo(0, 0)
+        if (overflow <= 0f) return
+        val stay = if (forLine.durationMs > 0) forLine.durationMs else DEFAULT_STAY_MS
+        val travel = (stay - CHANGE_MS - 2 * REST_MS).coerceAtLeast(MIN_TRAVEL_MS)
+        val px = overflow + dp(4f)
+        scroll =
+            ValueAnimator.ofFloat(0f, px).apply {
+                startDelay = REST_MS
+                duration = travel
+                interpolator = null
+                addUpdateListener { shown.scrollTo((it.animatedValue as Float).toInt(), 0) }
+                start()
+            }
+    }
+
+    private fun stopScroll() {
+        scroll?.cancel()
+        scroll = null
+    }
+
+    private fun open() {
+        val playing = line ?: return
+        val options =
+            ActivityOptions.makeBasic()
+                .setPendingIntentBackgroundActivityStartMode(
+                    ActivityOptions.MODE_BACKGROUND_ACTIVITY_START_ALLOW_ALWAYS
+                )
+                .toBundle()
+        try {
+            playing.launch?.let {
+                it.send(context, 0, null, null, null, null, options)
+                return
+            }
+        } catch (e: PendingIntent.CanceledException) {
+            Log.w(TAG, "the session's activity is gone; opening the app instead", e)
+        }
+        val intent =
+            context.packageManager.getLaunchIntentForPackage(playing.packageName)
+                ?.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED)
+        if (intent == null) {
+            Log.w(TAG, "${playing.packageName} has no launcher activity")
+            return
+        }
+        context.startActivityAsUser(intent, options, UserHandle.CURRENT)
+    }
+
+    override fun onDarkChanged(areas: ArrayList<Rect>, darkIntensity: Float, tint: Int) {
+        color = DarkIconDispatcher.getTint(areas, this, tint)
+        shown.setTextColor(color)
+        leaving.setTextColor(color)
+    }
+
+    override fun onDetachedFromWindow() {
+        stopScroll()
+        super.onDetachedFromWindow()
+    }
+
+    private fun dp(v: Float) = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, resources.displayMetrics)
+
+    private companion object {
+        const val TAG = "LujarchLyrics"
+        const val CHANGE_MS = 350L
+        const val REST_MS = 600L
+        const val MIN_TRAVEL_MS = 1500L
+        const val DEFAULT_STAY_MS = 6000L
+        const val RISE_FRACTION = 0.6f
+        val EMPHASIZED = PathInterpolator(0.2f, 0f, 0f, 1f)
+    }
+}
