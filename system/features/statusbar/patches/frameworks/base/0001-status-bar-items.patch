+package com.android.systemui.statusbar.lujarch.lyrics
+
+import android.app.PendingIntent
+import android.content.Context
+import android.media.MediaMetadata
+import android.media.session.MediaController
+import android.media.session.MediaSession
+import android.media.session.MediaSessionManager
+import android.media.session.PlaybackState
+import android.os.Handler
+import android.os.SystemClock
+import android.util.Log
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Application
+import com.android.systemui.dagger.qualifiers.Main
+import javax.inject.Inject
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONException
+import org.json.JSONObject
+
+/**
+ * Lujarch: the lyric line to show in the status bar (SB-3). The playing media
+ * session's metadata carries the song's timed lyrics (LRC): FeelUOwn puts them in `lyricInfo`, JSON
+ * whose `lyric` is the whole song (the ColorOS lock screen convention), and its raw lyrics in `lyrics`.
+ * The playback state gives the position, so the line follows the song without the app's help: a seek,
+ * a pause or a speed change comes as a new state and the line is worked out again.
+ *
+ * [current] is null while nothing plays, while the playing song has no lyrics, and before the first
+ * line. Only the session that plays counts: of several, the most recently active one (the list is in
+ * that order).
+ */
+@SysUISingleton
+class StatusBarLyrics
+@Inject
+constructor(@Application private val context: Context, @Main private val handler: Handler) {
+
+    /** One line: its text, how long it stays (until the next line, 0 when it is the last), its app. */
+    data class Line(
+        val text: String,
+        val durationMs: Long,
+        val packageName: String,
+        val launch: PendingIntent?,
+    )
+
+    private val _current = MutableStateFlow<Line?>(null)
+    val current: StateFlow<Line?> = _current.asStateFlow()
+
+    private val sessionManager = context.getSystemService(MediaSessionManager::class.java)
+    private val controllers = mutableMapOf<MediaController, MediaController.Callback>()
+    private val lyricsCache = mutableMapOf<String, List<LrcLine>>()
+    private val tick = Runnable { update() }
+    // The song last logged, so the log has one line per song.
+    private var loggedSong: String? = null
+    // The active sessions in the manager's order: most recently active first.
+    private var order = emptyList<MediaSession.Token>()
+
+    init {
+        try {
+            sessionManager?.addOnActiveSessionsChangedListener({ track(it) }, null, handler)
+            handler.post { track(sessionManager?.getActiveSessions(null)) }
+        } catch (e: SecurityException) {
+            Log.w(TAG, "no access to media sessions; no lyrics", e)
+        }
+    }
+
+    private fun track(sessions: List<MediaController>?) {
+        val now = sessions.orEmpty()
+        val gone = controllers.keys.filter { c -> now.none { it.sessionToken == c.sessionToken } }
+        for (c in gone) controllers.remove(c)?.let { c.unregisterCallback(it) }
+        for (c in now) {
+            if (controllers.keys.any { it.sessionToken == c.sessionToken }) continue
+            val callback =
+                object : MediaController.Callback() {
+                    override fun onPlaybackStateChanged(state: PlaybackState?) = update()
+
+                    override fun onMetadataChanged(metadata: MediaMetadata?) = update()
+
+                    override fun onSessionDestroyed() = update()
+                }
+            c.registerCallback(callback, handler)
+            controllers[c] = callback
+        }
+        order = now.map { it.sessionToken }
+        update()
+    }
+
+    // Buffering in the middle of a song counts as playing: the line stays rather than the clock
+    // flickering back for a moment.
+    private fun playing(): MediaController? =
+        order
+            .mapNotNull { token -> controllers.keys.firstOrNull { it.sessionToken == token } }
+            .firstOrNull {
+                val state = it.playbackState?.state
+                state == PlaybackState.STATE_PLAYING || state == PlaybackState.STATE_BUFFERING
+            }
+
+    /** Works out the line for now and wakes up again when the next one is due. */
+    private fun update() {
+        handler.removeCallbacks(tick)
+        val controller = playing()
+        val state = controller?.playbackState
+        val lines = controller?.metadata?.let { lyricsOf(it) }
+        if (controller != null) logSong(controller, lines)
+        if (controller == null || state == null || lines.isNullOrEmpty()) {
+            publish(null)
+            return
+        }
+        val speed = if (state.playbackSpeed > 0f) state.playbackSpeed else 1f
+        // While it buffers the position stands still: no running ahead, and no wake-up until it moves.
+        val moving = state.state == PlaybackState.STATE_PLAYING
+        val elapsed = if (moving) SystemClock.elapsedRealtime() - state.lastPositionUpdateTime else 0L
+        val position = state.position + (elapsed * speed).toLong()
+        val index = lines.indexOfLast { it.timeMs <= position }
+        if (index < 0) {
+            publish(null)
+            if (moving) schedule(lines[0].timeMs - position, speed)
+            return
+        }
+        val next = lines.getOrNull(index + 1)
+        publish(
+            Line(
+                text = lines[index].text,
+                durationMs = next?.let { ((it.timeMs - lines[index].timeMs) / speed).toLong() } ?: 0L,
+                packageName = controller.packageName,
+                launch = controller.sessionActivity,
+            )
+        )
+        if (next != null && moving) schedule(next.timeMs - position, speed)
+    }
+
+    private fun logSong(controller: MediaController, lines: List<LrcLine>?) {
+        val metadata = controller.metadata ?: return
+        // A song is its lyrics where it has them: an app may update the title as it plays (FeelUOwn's
+        // "send lyrics to media" puts the current line in it).
+        val song = controller.packageName + "/" +
+            (lyricText(metadata)?.hashCode()?.toString() ?: metadata.getString(MediaMetadata.METADATA_KEY_TITLE))
+        if (song == loggedSong) return
+        loggedSong = song
+        if (lines.isNullOrEmpty()) {
+            Log.i(TAG, "${controller.packageName}: no lyrics in the metadata (keys ${metadata.keySet()})")
+        } else {
+            Log.i(TAG, "${controller.packageName}: ${lines.size} lyric lines")
+        }
+    }
+
+    private fun schedule(untilMs: Long, speed: Float) {
+        handler.postDelayed(tick, (untilMs / speed).toLong().coerceAtLeast(MIN_DELAY_MS))
+    }
+
+    private fun publish(line: Line?) {
+        // A line keeps its identity while it stays, so the view does not play its change again.
+        val old = _current.value
+        if (line != null && old != null && line.text == old.text && line.packageName == old.packageName) {
+            return
+        }
+        _current.value = line
+    }
+
+    private fun lyricsOf(metadata: MediaMetadata): List<LrcLine>? {
+        val raw = lyricText(metadata) ?: return null
+        lyricsCache[raw]?.let { return it }
+        val parsed = Lrc.parse(raw)
+        if (lyricsCache.size >= CACHE_SIZE) lyricsCache.clear()
+        lyricsCache[raw] = parsed
+        return parsed
+    }
+
+    private fun lyricText(metadata: MediaMetadata): String? {
+        metadata.getString(KEY_LYRIC_INFO)?.let { info ->
+            try {
+                val lyric = JSONObject(info).optString("lyric")
+                if (lyric.isNotBlank()) return lyric
+            } catch (e: JSONException) {
+                Log.d(TAG, "lyricInfo is not JSON: ${e.message}")
+            }
+        }
+        for (key in RAW_KEYS) metadata.getString(key)?.takeIf { it.isNotBlank() }?.let { return it }
+        return null
+    }
+
+    private companion object {
+        const val TAG = "LujarchLyrics"
+        const val KEY_LYRIC_INFO = "lyricInfo"
+        val RAW_KEYS = listOf("lyrics", "lyric", "android.media.metadata.LYRICS")
+        const val MIN_DELAY_MS = 50L
+        const val CACHE_SIZE = 8
+    }
+}
+
+/** A timed line of LRC lyrics. */
+data class LrcLine(val timeMs: Long, val text: String)
+
+/** LRC as music apps write it, for [StatusBarLyrics]. */
+object Lrc {
+    private val TIME = Regex("""\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?]""")
+    private val WORD_TIME = Regex("""<\d{1,3}:\d{1,2}(?:[.:]\d{1,3})?>""")
+    private val OFFSET = Regex("""\[offset:\s*([+-]?\d+)\s*]""", RegexOption.IGNORE_CASE)
+
+    /**
+     * The lines in time order. A line may carry several times. A line with the time of an earlier
+     * one is its translation (the original comes first) and is dropped, as are empty lines (the
+     * line before stays) and the tags ([ti:], [ar:], ...). Word times (<mm:ss.xx>) are removed.
+     */
+    fun parse(text: String): List<LrcLine> {
+        val offset = OFFSET.find(text)?.groupValues?.get(1)?.toLongOrNull() ?: 0L
+        val byTime = LinkedHashMap<Long, String>()
+        for (rawLine in text.lineSequence()) {
+            val line = rawLine.trim()
+            val times = mutableListOf<Long>()
+            var rest = line
+            while (true) {
+                val m = TIME.matchAt(rest, 0) ?: break
+                val (min, sec, frac) = m.destructured
+                val fracMs =
+                    when (frac.length) {
+                        0 -> 0L
+                        1 -> frac.toLong() * 100
+                        2 -> frac.toLong() * 10
+                        else -> frac.take(3).toLong()
+                    }
+                times += min.toLong() * 60_000 + sec.toLong() * 1_000 + fracMs
+                rest = rest.substring(m.range.last + 1)
+            }
+            if (times.isEmpty()) continue
+            val words = WORD_TIME.replace(rest, "").trim()
+            if (words.isEmpty()) continue
+            for (t in times) {
+                val at = (t - offset).coerceAtLeast(0)
+                if (at !in byTime) byTime[at] = words
+            }
+        }
+        return byTime.entries.sortedBy { it.key }.map { LrcLine(it.key, it.value) }
+    }
+}
