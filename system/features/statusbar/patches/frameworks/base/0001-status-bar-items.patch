+package com.android.systemui.statusbar.lujarch
+
+import android.content.Context
+import android.content.pm.PackageManager
+import android.location.flags.Flags.locationIndicatorsEnabled
+import android.telephony.TelephonyManager
+import androidx.annotation.StringRes
+import com.android.systemui.res.R
+import com.android.systemui.statusbar.core.NewStatusBarIcons
+
+/**
+ * Everything the status bar can show has a switch (SB-1). This file is the one registry: the
+ * status bar items page (`tuner/StatusBarTuner`) is generated from [ITEMS]; a slot of
+ * `config_statusBarIcons` without an item is in [NEVER_APPEARS] with the reason.
+ *
+ * The key of an item is what the switch writes into Settings.Secure `icon_blacklist`
+ * ([StatusBarHideList]): the slot name of an icon SystemUI holds, `<slot>__external` for an icon
+ * another package sets (a plain `<slot>` hides it too), or a `lujarch_` key for an element that is
+ * not an icon slot. A new element ships with its item here; one without is a bug.
+ */
+enum class StatusBarGroup(@StringRes val title: Int) {
+    CONNECTIVITY(R.string.lujarch_sb_group_connectivity),
+    SOUND(R.string.lujarch_sb_group_sound),
+    STATUS(R.string.lujarch_sb_group_status),
+    CHIPS(R.string.lujarch_sb_group_chips),
+    PRIVACY(R.string.lujarch_sb_group_privacy),
+    GENERAL(R.string.lujarch_sb_group_general),
+}
+
+/** Whether an item can appear on this device; the page shows no switch for what never will. */
+enum class StatusBarAppears {
+    ALWAYS,
+    TELEPHONY,
+    SATELLITE,
+    STACKED_MOBILE,
+    /** The location symbol is an icon only while the privacy indicators do not carry location. */
+    LOCATION_ICON,
+    LOCATION_INDICATORS;
+
+    fun onThisDevice(context: Context): Boolean =
+        when (this) {
+            ALWAYS -> true
+            TELEPHONY -> context.packageManager.hasSystemFeature(PackageManager.FEATURE_TELEPHONY)
+            SATELLITE ->
+                context.packageManager.hasSystemFeature(PackageManager.FEATURE_TELEPHONY_SATELLITE)
+            STACKED_MOBILE ->
+                NewStatusBarIcons.isEnabled &&
+                    (context.getSystemService(TelephonyManager::class.java)?.supportedModemCount
+                        ?: 1) > 1
+            LOCATION_ICON -> !locationIndicatorsEnabled()
+            LOCATION_INDICATORS -> locationIndicatorsEnabled()
+        }
+}
+
+class StatusBarItem(
+    val key: String,
+    @StringRes val title: Int,
+    val group: StatusBarGroup,
+    val appears: StatusBarAppears = StatusBarAppears.ALWAYS,
+    /** A line under the title, or 0. */
+    @StringRes val summary: Int = 0,
+)
+
+object StatusBarItems {
+    // Keys of the elements that are not icon slots.
+    const val OPERATOR_NAME = "lujarch_operator_name"
+    const val CARRIER_TEXT = "lujarch_carrier_text"
+    const val NOTIFICATION_ICONS = "lujarch_notification_icons"
+    const val LYRICS = "lujarch_lyrics"
+    const val CHIP_SCREEN_RECORD = "lujarch_chip_screen_record"
+    const val CHIP_SHARE = "lujarch_chip_share"
+    // `cast` is a slot name in config_statusBarIcons that no icon uses: the cast chip takes it.
+    const val CHIP_CAST = "cast"
+    const val CHIP_CALL = "lujarch_chip_call"
+    const val CHIP_BATTERY_PLUG = "lujarch_chip_battery_plug"
