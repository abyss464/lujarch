+package com.android.systemui.statusbar.lujarch
+
+import android.content.Context
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.statusbar.phone.ui.StatusBarIconController
+import com.android.systemui.tuner.TunerService
+import java.util.concurrent.CopyOnWriteArraySet
+import javax.inject.Inject
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+
+/**
+ * The items of the status bar the user hides (SB-1): Settings.Secure `icon_blacklist`, the list
+ * SystemUI already keeps for its icon slots, is the one place every switch of the status bar page
+ * writes. An entry is an item's key ([StatusBarItems]): a live icon slot, an icon set from outside
+ * (`<slot>__external`), or a `lujarch_` key of an element that is not an icon slot (chips,
+ * privacy indicators, the carrier texts, the notification icons).
+ *
+ * A null setting means the config's default (rotate, headset); the empty string hides nothing, as
+ * [StatusBarIconController.getIconHideList] reads it.
+ */
+@SysUISingleton
+class StatusBarHideList
+@Inject
+constructor(private val context: Context, tunerService: TunerService) : TunerService.Tunable {
+
+    /** Called on the main thread when the list changed. */
+    fun interface Listener {
+        fun onHideListChanged()
+    }
+
+    private val hiddenKeys = MutableStateFlow<Set<String>>(emptySet())
+    private val listeners = CopyOnWriteArraySet<Listener>()
+
+    /** The keys the user hides, as the setting last had them. */
+    val hidden: StateFlow<Set<String>> = hiddenKeys.asStateFlow()
+
+    init {
+        tunerService.addTunable(this, StatusBarIconController.ICON_HIDE_LIST)
+    }
+
+    override fun onTuningChanged(key: String?, newValue: String?) {
+        if (StatusBarIconController.ICON_HIDE_LIST != key) return
+        hiddenKeys.value = StatusBarIconController.getIconHideList(context, newValue)
+        listeners.forEach { it.onHideListChanged() }
+    }
+
+    /** Whether the user hides the item [key]. */
+    fun isHidden(key: String): Boolean = isHidden(hiddenKeys.value, key)
+
+    /** [isHidden] as a flow that emits when the answer changes. */
+    fun isHiddenFlow(key: String): Flow<Boolean> =
+        hiddenKeys.map { isHidden(it, key) }.distinctUntilChanged()
+
+    fun addListener(listener: Listener) {
+        listeners.add(listener)
+    }
+
+    fun removeListener(listener: Listener) {
+        listeners.remove(listener)
+    }
+
+    companion object {
+        /**
+         * Whether [key] is in [hidden]. An icon set from outside has the slot `<slot>__external`;
+         * the plain name hides it too, so an entry such as `ime` or `speakerphone` works.
+         */
+        @JvmStatic
+        fun isHidden(hidden: Set<String>, key: String): Boolean {
+            if (hidden.contains(key)) return true
+            val base = key.removeSuffix(EXTERNAL_SLOT_SUFFIX)
+            return base != key && hidden.contains(base)
+        }
+
+        /** The suffix SystemUI gives the slot of an icon another package sets. */
+        const val EXTERNAL_SLOT_SUFFIX = "__external"
+    }
+}
