// Screen record's settings, profiles and pages, the strings they show, and what the settings come
// to on the phone's encoders: used by the recorder and its card in SystemUI and by the settings
// pages.
android_library {
    name: "LujarchRecorder",
    srcs: [
        "src/recorder/**/*.java",
        "src/recorder/**/*.kt",
    ],
    manifest: "src/recorder/AndroidManifest.xml",
    resource_dirs: ["src/recorder/res"],
    platform_apis: true,
    visibility: ["//visibility:public"],
}

// Screen record's pages in Lujarch Settings: Settings > System > Screen record.
android_library {
    name: "LujarchRecorderSettings",
    srcs: ["src/settings/**/*.kt"],
    manifest: "src/settings/AndroidManifest.xml",
    resource_dirs: ["src/settings/res"],
    platform_apis: true,
    static_libs: [
        "LujarchSettingsPages",
        "LujarchRecorder",
    ],
    libs: ["LujarchSettingsContribution"],
}
