+/** What a typed text asks for, written by [write] once [validate] finds nothing wrong. */
+private class TextAsk(
+    val title: String,
+    val initial: String,
+    val hint: String?,
+    val numeric: Boolean,
+    val neutral: Pair<String, () -> Unit>?,
+    val validate: (String) -> String?,
+    val write: (String) -> Boolean,
+)
+
+private fun textAsk(recorder: RecorderState, what: TextFor): TextAsk? {
+    val context = recorder.context
+    return when (what) {
+        TextFor.NewProfile ->
+            TextAsk(
+                title = context.getString(RecR.string.rec_profile_save),
+                initial = "",
+                hint = context.getString(RecR.string.rec_profile_name),
+                numeric = false,
+                neutral = null,
+                validate = { profileNameProblem(context, it.trim()) },
+                write = {
+                    RecorderProfiles.saveCurrent(context, it.trim()) &&
+                        recorder.useProfile(it.trim())
+                },
+            )
+        is TextFor.RenamedProfile ->
+            TextAsk(
+                title = context.getString(RecR.string.rec_profile_rename),
+                initial = what.name,
+                hint = context.getString(RecR.string.rec_profile_name),
+                numeric = false,
+                neutral = null,
+                validate = {
+                    if (it.trim() == what.name) null else profileNameProblem(context, it.trim())
+                },
+                write = {
+                    it.trim() == what.name ||
+                        RecorderProfiles.rename(context, what.name, it.trim())
+                },
+            )
+        is TextFor.Value -> {
+            val setting = what.page.settings(context).firstOrNull { it.key == what.key }
+            val entry =
+                if (what.entry == null) setting
+                else
+                    (setting as? Choice)?.options?.firstNotNullOfOrNull { o ->
+                        o.entry?.takeIf { it.key == what.entry }
+                    }
+            when (entry) {
+                is Entry ->
+                    TextAsk(
+                        title = entry.title,
+                        initial = entry.initial,
+                        hint = entry.hint,
+                        numeric = entry.numeric,
+                        neutral = null,
+                        validate = entry.validate,
+                        write = entry.write,
+                    )
+                is Count ->
+                    TextAsk(
+                        title = entry.title,
+                        initial =
+                            if (entry.noLimit != null && entry.value == 0) ""
+                            else entry.value.toString(),
+                        hint = null,
+                        numeric = true,
+                        neutral = entry.noLimit?.let { label -> label to { entry.write(0); Unit } },
+                        validate = { entry.problem(context, it.trim().toIntOrNull()) },
+                        write = { entry.write(it.trim().toInt()) },
+                    )
+                else -> null
+            }
+        }
+    }
+}
