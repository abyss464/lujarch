+/**
+ * Start, which counts down the seconds of the countdown in a ring and becomes Cancel; while
+ * recording, Stop (REC-1, REC-7).
+ */
+@Composable
+fun RecorderPrimaryButton(
+    status: ScreenRecordingStatus,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val motion = MaterialTheme.motionScheme
+    AnimatedContent(
+        targetState = status is ScreenRecordingStatus.Started,
+        transitionSpec = {
+            (fadeIn(motion.fastEffectsSpec()) + scaleIn(motion.fastSpatialSpec(), 0.92f))
+                .togetherWith(fadeOut(motion.fastEffectsSpec()) + scaleOut(targetScale = 0.92f))
+                .using(SizeTransform { _, _ -> motion.fastSpatialSpec() })
+        },
+        modifier = modifier,
+        label = "RecorderPrimaryButton",
+    ) { live ->
+        if (live) {
+            StopButton(onClick)
+        } else {
+            StartButton(status as? ScreenRecordingStatus.Starting, onClick)
+        }
+    }
+}
+
+@Composable
+private fun StartButton(starting: ScreenRecordingStatus.Starting?, onClick: () -> Unit) {
+    val motion = MaterialTheme.motionScheme
+    val colors = MaterialTheme.colorScheme
+    val counting = starting != null
+    val shift by animateFloatAsState(if (counting) 1f else 0f, motion.fastSpatialSpec())
+    val fade by animateFloatAsState(if (counting) 1f else 0f, motion.fastEffectsSpec())
+    val radius by animateDpAsState(if (counting) 12.dp else 20.dp, motion.fastSpatialSpec())
+    val container by
+        animateColorAsState(
+            if (counting) colors.surfaceContainerHighest else colors.primary,
+            motion.fastEffectsSpec(),
+        )
+    val content by
+        animateColorAsState(
+            if (counting) colors.onSurface else colors.onPrimary,
+            motion.fastEffectsSpec(),
+        )
+    val label =
+        stringResource(
+            if (counting) RecR.string.rec_cancel else R.string.screenrecord_start_description
+        )
+    Box(
+        contentAlignment = Alignment.Center,
+        modifier =
+            Modifier.height(40.dp)
+                .widthIn(min = 132.dp)
+                .clip(RoundedCornerShape(radius))
+                .background(container)
+                .clickable(onClick = onClick)
+                .semantics {
+                    role = Role.Button
+                    contentDescription = label
+                }
+                .padding(horizontal = 14.dp),
+    ) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            modifier =
+                Modifier.graphicsLayer {
+                    alpha = 1 - fade
+                    translationY = -10.dp.toPx() * shift
+                },
+        ) {
+            Icon(RecIcons.record, contentDescription = null, tint = content, modifier = Modifier.size(18.dp))
+            Text(
+                text = stringResource(R.string.screenrecord_continue),
+                color = content,
+                fontSize = 14.sp,
+                fontWeight = FontWeight.Medium,
+            )
+        }
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            modifier =
+                Modifier.graphicsLayer {
+                    alpha = fade
+                    translationY = 10.dp.toPx() * (1 - shift)
+                },
+        ) {
+            CountdownRing(starting)
+            Text(
+                text = stringResource(RecR.string.rec_cancel),
+                color = content,
+                fontSize = 14.sp,
+                fontWeight = FontWeight.Medium,
+            )
+        }
+    }
+}
