+enum class ChipLook {
+    Plain,
+    On,
+    Changed,
+}
+
+/**
+ * A profile to choose: square-cornered and outlined; rounded and filled with the mark when in use;
+ * rounded with a dashed outline when a setting has changed since it was chosen.
+ */
+@Composable
+private fun ProfileChip(label: String, look: ChipLook, onClick: () -> Unit) {
+    val motion = MaterialTheme.motionScheme
+    val colors = MaterialTheme.colorScheme
+    val marked = look != ChipLook.Plain
+    val radius by animateDpAsState(if (marked) 18.dp else 10.dp, motion.fastSpatialSpec())
+    val mark by animateDpAsState(if (marked) 18.dp else 0.dp, motion.fastSpatialSpec())
+    val fill by
+        animateColorAsState(
+            if (look == ChipLook.On) colors.secondaryContainer else Color.Transparent,
+            motion.fastEffectsSpec(),
+        )
+    val line by
+        animateColorAsState(
+            when (look) {
+                ChipLook.Plain -> colors.outlineVariant
+                ChipLook.On -> colors.secondaryContainer
+                ChipLook.Changed -> colors.secondary
+            },
+            motion.fastEffectsSpec(),
+        )
+    val ink by
+        animateColorAsState(
+            if (look == ChipLook.On) colors.onSecondaryContainer else colors.onSurfaceVariant,
+            motion.fastEffectsSpec(),
+        )
+    val changedLabel = stringResource(RecR.string.rec_profile_changed, label)
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier =
+            Modifier.height(36.dp)
+                .clip(RoundedCornerShape(radius))
+                .background(fill)
+                .drawBehind {
+                    val w = 1.dp.toPx()
+                    drawRoundRect(
+                        color = line,
+                        topLeft = Offset(w / 2, w / 2),
+                        size = Size(size.width - w, size.height - w),
+                        cornerRadius = CornerRadius(radius.toPx() - w / 2),
+                        style =
+                            Stroke(
+                                width = w,
+                                pathEffect =
+                                    if (look == ChipLook.Changed) {
+                                        PathEffect.dashPathEffect(
+                                            floatArrayOf(4.dp.toPx(), 3.dp.toPx())
+                                        )
+                                    } else null,
+                            ),
+                    )
+                }
+                .clickable(onClick = onClick)
+                .semantics {
+                    role = Role.Button
+                    selected = look == ChipLook.On
+                    if (look == ChipLook.Changed) contentDescription = changedLabel
+                }
+                .padding(start = (12 - 4 * (mark / 18.dp).coerceIn(0f, 1f)).dp, end = 12.dp),
+    ) {
+        Box(
+            contentAlignment = Alignment.CenterStart,
+            modifier = Modifier.width(mark.coerceAtLeast(0.dp)),
+        ) {
+            Icon(
+                imageVector = RecIcons.check,
+                contentDescription = null,
+                tint = ink,
+                modifier = Modifier.size(18.dp).alpha((mark / 18.dp).coerceIn(0f, 1f)),
+            )
+        }
+        Spacer(Modifier.width((mark / 3).coerceAtLeast(0.dp)))
+        Text(
+            text = label,
+            fontSize = 13.sp,
+            fontWeight = FontWeight.Medium,
+            color = ink,
+            maxLines = 1,
+        )
+    }
+}
