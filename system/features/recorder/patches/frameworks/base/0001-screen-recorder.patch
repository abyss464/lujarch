+package com.android.systemui.screenrecord;
+
+import android.annotation.SuppressLint;
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.Context;
+import android.media.AudioAttributes;
+import android.media.AudioFormat;
+import android.media.AudioPlaybackCaptureConfiguration;
+import android.media.AudioRecord;
+import android.media.MediaCodec;
+import android.media.MediaFormat;
+import android.media.MediaMuxer;
+import android.media.MediaRecorder;
+import android.media.audiofx.AcousticEchoCanceler;
+import android.media.audiofx.NoiseSuppressor;
+import android.media.projection.MediaProjection;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.ParcelFileDescriptor;
+import android.provider.MediaStore;
+import android.util.Log;
+import android.view.Surface;
+
+import com.android.systemui.res.R;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Encodes the screen and its sound as LujarchRecorderConfig says, straight into MediaStore
+ * items: the picture through a video encoder fed by a surface, the sound read from the
+ * microphone and the playback capture, mixed or kept apart, and each file published as it ends.
+ */
+final class LujarchScreenEncoder {
+    private static final String TAG = LujarchRecorderConfig.TAG;
+    private static final long TIMEOUT_US = 10_000;
+    private static final int AUDIO_FRAME_MS = 20;
+
+    interface Listener {
+        /** A limit was reached and the recording stops (MediaRecorder's info codes). */
+        void onLimit(int what);
+
+        /** The recording failed; what was recorded is kept. */
+        void onFailed(String reason);
+    }
+
+    private final Context mContext;
+    private final LujarchRecorderConfig mConfig;
+    private final LujarchRecorderConfig.Resolved mResolved;
+    private final MediaProjection mProjection;
+    private final Listener mListener;
+    private final long mStartMillis = System.currentTimeMillis();
+
+    private final boolean mMic;
+    private final boolean mInternal;
+    private final int mAudioTracks;
+
+    private MediaCodec mVideo;
+    private Surface mSurface;
+    private final List<MediaCodec> mAudioCodecs = new ArrayList<>();
+    private AudioRecord mMicRecord;
+    private AudioRecord mInternalRecord;
+    private NoiseSuppressor mNoiseSuppressor;
+    private AcousticEchoCanceler mEchoCanceler;
+    private Thread mVideoThread;
+    private Thread mAudioThread;
+    private volatile boolean mStopping;
+    private volatile boolean mFailed;
+
+    private final Object mLock = new Object();
+    // Guarded by mLock.
+    private final MediaFormat[] mFormats;
+    private MediaMuxer mMuxer;
+    private ParcelFileDescriptor mFd;
+    private Uri mUri;
+    private final List<Uri> mFinished = new ArrayList<>();
+    private boolean mStarted;
+    private final List<Pending> mWaiting = new ArrayList<>();
+    private int mPart = 1;
+    private long mSegmentBaseUs;
+    private long mSegmentBytes;
+    private long mLastVideoUs = -1;
+    private final long[] mLastPts;
+    private boolean mRotate;
+    private boolean mLimitSent;
+    private long mBaseUs = -1;
+    private boolean mPaused;
+    private long mPausedAtUs;
+    private long mPausedUs;
+
+    private record Pending(int track, ByteBuffer data, MediaCodec.BufferInfo info) {
+    }
+
+    LujarchScreenEncoder(Context context, LujarchRecorderConfig config,
+            LujarchRecorderConfig.Resolved resolved, MediaProjection projection,
+            ScreenRecordingAudioSource source, Listener listener) {
+        mContext = context;
+        mConfig = config;
+        mResolved = resolved;
+        mProjection = projection;
+        mListener = listener;
+        mMic = source == ScreenRecordingAudioSource.MIC
+                || source == ScreenRecordingAudioSource.MIC_AND_INTERNAL;
+        mInternal = source == ScreenRecordingAudioSource.INTERNAL
+                || source == ScreenRecordingAudioSource.MIC_AND_INTERNAL;
+        mAudioTracks = !mMic && !mInternal ? 0 : (mMic && mInternal && config.separateTracks)
+                ? 2 : 1;
+        mFormats = new MediaFormat[1 + mAudioTracks];
+        mLastPts = new long[1 + mAudioTracks];
+    }
+
+    // -------------------------------------------------------------------------------------
+    // Setting up
+
+    /** Prepares the encoders and the first file; returns the surface the screen is drawn on. */
+    Surface prepare() throws IOException, LujarchRecorderConfig.Unusable {
+        if (mAudioTracks == 2 && mResolved.muxerFormat
+                == MediaMuxer.OutputFormat.MUXER_OUTPUT_WEBM) {
+            throw new LujarchRecorderConfig.Unusable(
+                    mContext.getString(R.string.lujarch_recorder_error_webm_tracks));
+        }
+        mVideo = createVideoCodec();
+        mSurface = mVideo.createInputSurface();
+        if (mAudioTracks > 0) {
+            createAudioRecords();
+            for (int i = 0; i < mAudioTracks; i++) mAudioCodecs.add(createAudioCodec());
+        }
+        openFile();
+        return mSurface;
+    }
+
+    private MediaCodec createVideoCodec() throws IOException, LujarchRecorderConfig.Unusable {
+        LujarchRecorderConfig.Resolved r = mResolved;
+        MediaFormat f = MediaFormat.createVideoFormat(r.videoMime, r.width, r.height);
+        f.setInteger(MediaFormat.KEY_COLOR_FORMAT,
+                android.media.MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface);
+        f.setInteger(MediaFormat.KEY_FRAME_RATE, r.frameRate);
+        f.setFloat(MediaFormat.KEY_MAX_FPS_TO_ENCODER, r.frameRate);
+        f.setInteger(MediaFormat.KEY_BIT_RATE, r.bitrate);
+        if (r.bitrateMode >= 0) f.setInteger(MediaFormat.KEY_BITRATE_MODE, r.bitrateMode);
+        if (r.quality >= 0) f.setInteger(MediaFormat.KEY_QUALITY, r.quality);
+        if (r.profile >= 0) f.setInteger(MediaFormat.KEY_PROFILE, r.profile);
+        if (r.level >= 0) f.setInteger(MediaFormat.KEY_LEVEL, r.level);
+        f.setFloat(MediaFormat.KEY_I_FRAME_INTERVAL, mConfig.keyInterval);
+        if (mConfig.bFrames > 0) f.setInteger(MediaFormat.KEY_MAX_B_FRAMES, mConfig.bFrames);
+        if (mConfig.everyFrame) {
+            f.setLong(MediaFormat.KEY_REPEAT_PREVIOUS_FRAME_AFTER, 1_000_000L / r.frameRate);
+        }
+        MediaCodec codec = MediaCodec.createByCodecName(r.videoEncoder.getName());
+        try {
+            codec.configure(f, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE);
+        } catch (RuntimeException e) {
+            codec.release();
+            Log.e(TAG, "video encoder refused " + f, e);
+            throw new LujarchRecorderConfig.Unusable(mContext.getString(
+                    R.string.lujarch_recorder_error_configure, r.videoEncoder.getName()));
+        }
+        Log.i(TAG, "video " + r.videoEncoder.getName() + " " + f);
+        return codec;
+    }
+
+    private MediaCodec createAudioCodec() throws IOException, LujarchRecorderConfig.Unusable {
+        LujarchRecorderConfig.Resolved r = mResolved;
+        MediaFormat f = MediaFormat.createAudioFormat(r.audioMime, r.sampleRate, mConfig.channels);
+        f.setInteger(MediaFormat.KEY_BIT_RATE, r.audioBitrate);
+        if (MediaFormat.MIMETYPE_AUDIO_AAC.equals(r.audioMime)) {
+            f.setInteger(MediaFormat.KEY_AAC_PROFILE, r.aacProfile);
+        }
+        f.setInteger(MediaFormat.KEY_MAX_INPUT_SIZE, frameBytes() * 2);
+        MediaCodec codec;
+        try {
+            codec = MediaCodec.createByCodecName(
+                    new android.media.MediaCodecList(android.media.MediaCodecList.REGULAR_CODECS)
+                            .findEncoderForFormat(f));
+        } catch (NullPointerException | IllegalArgumentException e) {
+            throw new LujarchRecorderConfig.Unusable(
+                    mContext.getString(R.string.lujarch_recorder_error_audio_codec));
+        }
+        try {
+            codec.configure(f, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE);
+        } catch (RuntimeException e) {
+            codec.release();
+            Log.e(TAG, "audio encoder refused " + f, e);
+            throw new LujarchRecorderConfig.Unusable(
+                    mContext.getString(R.string.lujarch_recorder_error_audio_codec));
+        }
+        Log.i(TAG, "audio " + codec.getName() + " " + f);
+        return codec;
+    }
+
+    private int frameBytes() {
+        return mResolved.sampleRate * AUDIO_FRAME_MS / 1000 * mConfig.channels * 2;
+    }
+
+    @SuppressLint("MissingPermission")
+    private void createAudioRecords() throws LujarchRecorderConfig.Unusable {
+        int mask = mConfig.channels == 1 ? AudioFormat.CHANNEL_IN_MONO
+                : AudioFormat.CHANNEL_IN_STEREO;
+        AudioFormat format = new AudioFormat.Builder()
+                .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                .setSampleRate(mResolved.sampleRate)
+                .setChannelMask(mask)
+                .build();
+        int buffer = Math.max(AudioRecord.getMinBufferSize(mResolved.sampleRate, mask,
+                AudioFormat.ENCODING_PCM_16BIT), frameBytes()) * 4;
+        if (mMic) {
+            mMicRecord = new AudioRecord.Builder()
+                    .setAudioSource(mConfig.echoCancellation
+                            ? MediaRecorder.AudioSource.VOICE_COMMUNICATION
+                            : MediaRecorder.AudioSource.DEFAULT)
+                    .setAudioFormat(format)
+                    .setBufferSizeInBytes(buffer)
+                    .build();
+            if (mMicRecord.getState() != AudioRecord.STATE_INITIALIZED) {
+                throw new LujarchRecorderConfig.Unusable(
+                        mContext.getString(R.string.lujarch_recorder_error_microphone));
+            }
+            int session = mMicRecord.getAudioSessionId();
+            if (mConfig.noiseSuppression) {
+                if (NoiseSuppressor.isAvailable()) {
+                    mNoiseSuppressor = NoiseSuppressor.create(session);
+                    if (mNoiseSuppressor != null) mNoiseSuppressor.setEnabled(true);
+                } else {
+                    Log.w(TAG, "noise suppression is not available");
+                }
+            }
+            if (mConfig.echoCancellation) {
+                if (AcousticEchoCanceler.isAvailable()) {
+                    mEchoCanceler = AcousticEchoCanceler.create(session);
+                    if (mEchoCanceler != null) mEchoCanceler.setEnabled(true);
+                } else {
+                    Log.w(TAG, "echo cancellation is not available");
+                }
+            }
+        }
+        if (mInternal) {
+            AudioPlaybackCaptureConfiguration capture =
+                    new AudioPlaybackCaptureConfiguration.Builder(mProjection)
+                            .addMatchingUsage(AudioAttributes.USAGE_MEDIA)
+                            .addMatchingUsage(AudioAttributes.USAGE_UNKNOWN)
+                            .addMatchingUsage(AudioAttributes.USAGE_GAME)
+                            .build();
+            mInternalRecord = new AudioRecord.Builder()
+                    .setAudioFormat(format)
+                    .setAudioPlaybackCaptureConfig(capture)
+                    .setBufferSizeInBytes(buffer)
+                    .build();
+            if (mInternalRecord.getState() != AudioRecord.STATE_INITIALIZED) {
+                throw new LujarchRecorderConfig.Unusable(
+                        mContext.getString(R.string.lujarch_recorder_error_device_audio));
+            }
+        }
+    }
+
+    // -------------------------------------------------------------------------------------
+    // Files (REC-4)
+
+    // Called with mLock held, or before the threads start.
+    private void openFile() throws IOException {
+        ContentValues values = new ContentValues();
+        values.put(MediaStore.Video.Media.DISPLAY_NAME,
+                mConfig.fileName(mStartMillis, mPart, mResolved.extension));
+        values.put(MediaStore.Video.Media.MIME_TYPE, mResolved.fileMime);
+        values.put(MediaStore.Video.Media.RELATIVE_PATH, mConfig.relativePath());
+        values.put(MediaStore.Video.Media.DATE_TAKEN, mStartMillis);
+        values.put(MediaStore.Video.Media.IS_PENDING, 1);
+        ContentResolver resolver = mContext.getContentResolver();
+        Uri uri = resolver.insert(
+                MediaStore.Video.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY), values);
+        if (uri == null) throw new IOException("MediaStore did not take " + values);
+        mFd = resolver.openFileDescriptor(uri, "rw");
+        if (mFd == null) throw new IOException("no file for " + uri);
+        mMuxer = new MediaMuxer(mFd.getFileDescriptor(), mResolved.muxerFormat);
+        mUri = uri;
+        mStarted = false;
+        mSegmentBytes = 0;
+        java.util.Arrays.fill(mLastPts, -1);
+        Log.i(TAG, "file " + uri + " " + values.get(MediaStore.Video.Media.DISPLAY_NAME));
+    }
+
+    // Called with mLock held.
+    private void startMuxerIfReady() {
+        for (MediaFormat f : mFormats) if (f == null) return;
+        for (MediaFormat f : mFormats) mMuxer.addTrack(f);
+        mMuxer.start();
+        mStarted = true;
+        for (Pending p : mWaiting) write(p.track, p.data, p.info);
+        mWaiting.clear();
+    }
+
+    // Called with mLock held. Ends the current file and publishes it.
+    private void closeFile() {
+        if (mMuxer == null) return;
+        boolean written = mStarted;
+        try {
+            if (mStarted) mMuxer.stop();
+        } catch (RuntimeException e) {
+            Log.e(TAG, "file " + mUri + " not finished", e);
+            written = false;
+        }
+        mMuxer.release();
+        mMuxer = null;
+        try {
+            mFd.close();
+        } catch (IOException e) {
+            Log.e(TAG, "file " + mUri + " not closed", e);
+        }
+        ContentResolver resolver = mContext.getContentResolver();
+        if (written) {
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.Video.Media.IS_PENDING, 0);
+            resolver.update(mUri, values, null, null);
+            mFinished.add(mUri);
+            Log.i(TAG, "file " + mUri + " saved");
+        } else {
+            resolver.delete(mUri, null, null);
+            Log.w(TAG, "file " + mUri + " had nothing and is deleted");
+        }
+        mUri = null;
+    }
+
+    // -------------------------------------------------------------------------------------
+    // Running
+
+    void start() {
+        mVideo.start();
+        for (MediaCodec c : mAudioCodecs) c.start();
+        mVideoThread = new Thread(this::drainVideo, "lujarch_recorder_video");
+        mVideoThread.start();
+        if (mAudioTracks > 0) {
+            if (mMicRecord != null) mMicRecord.startRecording();
+            if (mInternalRecord != null) mInternalRecord.startRecording();
+            mAudioThread = new Thread(this::runAudio, "lujarch_recorder_audio");
+            mAudioThread.start();
+        }
+    }
+
+    /** Pauses the picture and the sound (REC-7). */
+    void pause() {
+        synchronized (mLock) {
+            if (mPaused) return;
+            mPaused = true;
+            mPausedAtUs = System.nanoTime() / 1000;
+        }
+        Bundle b = new Bundle();
+        b.putInt(MediaCodec.PARAMETER_KEY_SUSPEND, 1);
+        mVideo.setParameters(b);
+        Log.i(TAG, "paused");
+    }
+
+    void resume() {
+        synchronized (mLock) {
+            if (!mPaused) return;
+            mPaused = false;
+            mPausedUs += System.nanoTime() / 1000 - mPausedAtUs;
+        }
+        Bundle b = new Bundle();
+        b.putInt(MediaCodec.PARAMETER_KEY_SUSPEND, 0);
+        b.putInt(MediaCodec.PARAMETER_KEY_REQUEST_SYNC_FRAME, 0);
+        mVideo.setParameters(b);
+        Log.i(TAG, "resumed");
+    }
+
+    boolean isPaused() {
+        synchronized (mLock) {
+            return mPaused;
+        }
+    }
+
+    /** Ends the recording; every file with something in it is saved. */
+    void stop() {
+        if (mStopping) return;
+        mStopping = true;
+        try {
+            if (!mFailed) mVideo.signalEndOfInputStream();
+        } catch (RuntimeException e) {
+            Log.e(TAG, "video end not signalled", e);
+        }
+        join(mVideoThread);
+        join(mAudioThread);
+        if (mMicRecord != null) mMicRecord.release();
+        if (mInternalRecord != null) mInternalRecord.release();
+        if (mNoiseSuppressor != null) mNoiseSuppressor.release();
+        if (mEchoCanceler != null) mEchoCanceler.release();
+        release(mVideo);
+        for (MediaCodec c : mAudioCodecs) release(c);
+        if (mSurface != null) mSurface.release();
+        synchronized (mLock) {
+            closeFile();
+        }
+    }
+
+    /** The files saved, the first first. */
+    List<Uri> files() {
+        synchronized (mLock) {
+            return new ArrayList<>(mFinished);
+        }
+    }
+
+    /** The file being written, or the last one saved. */
+    Uri currentUri() {
+        synchronized (mLock) {
+            if (mUri != null) return mUri;
+            return mFinished.isEmpty() ? null : mFinished.get(mFinished.size() - 1);
+        }
+    }
+
+    /** Deletes a file still being written: one that was never finished. */
+    void discardUnfinished() {
+        synchronized (mLock) {
+            if (mMuxer != null) {
+                mMuxer.release();
+                mMuxer = null;
+            }
+            if (mUri != null) {
+                mContext.getContentResolver().delete(mUri, null, null);
+                mUri = null;
+            }
+        }
+    }
+
+    private static void join(Thread t) {
+        if (t == null) return;
+        try {
+            t.join(5000);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    private static void release(MediaCodec c) {
+        if (c == null) return;
+        try {
+            c.stop();
+        } catch (RuntimeException e) {
+            // A codec that failed cannot be stopped; it is released all the same.
+        }
+        c.release();
+    }
+
+    private void fail(String what, Throwable e) {
+        Log.e(TAG, what, e);
+        if (mFailed || mStopping) return;
+        mFailed = true;
+        mListener.onFailed(mContext.getString(R.string.lujarch_recorder_error_encoding, what,
+                e.getMessage() == null ? e.getClass().getSimpleName() : e.getMessage()));
+    }
+
+    private void drainVideo() {
+        MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+        try {
+            while (true) {
+                int index = mVideo.dequeueOutputBuffer(info, TIMEOUT_US);
+                if (index == MediaCodec.INFO_TRY_AGAIN_LATER) {
+                    if (mFailed) return;
+                    continue;
+                }
+                if (index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                    trackReady(0, mVideo.getOutputFormat());
+                    continue;
+                }
+                if (index < 0) continue;
+                ByteBuffer data = mVideo.getOutputBuffer(index);
+                boolean end = (info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0;
+                if ((info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) == 0 && info.size > 0
+                        && data != null) {
+                    sample(0, data, info);
+                }
+                mVideo.releaseOutputBuffer(index, false);
+                if (end) return;
+            }
+        } catch (RuntimeException e) {
+            fail(mResolved.videoEncoder.getName(), e);
+        }
+    }
+
+    private void runAudio() {
+        int bytes = frameBytes();
+        ByteBuffer mic = mMicRecord != null
+                ? ByteBuffer.allocateDirect(bytes).order(ByteOrder.nativeOrder()) : null;
+        ByteBuffer internal = mInternalRecord != null
+                ? ByteBuffer.allocateDirect(bytes).order(ByteOrder.nativeOrder()) : null;
+        long frames = 0;
+        int frameSize = mConfig.channels * 2;
+        MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+        try {
+            while (!mStopping && !mFailed) {
+                int n = Integer.MAX_VALUE;
+                if (mic != null) n = Math.min(n, read(mMicRecord, mic, bytes));
+                if (internal != null) n = Math.min(n, read(mInternalRecord, internal, bytes));
+                if (n <= 0) continue;
+                boolean paused;
+                synchronized (mLock) {
+                    paused = mPaused;
+                }
+                if (!paused) {
+                    long ptsUs = frames * 1_000_000L / mResolved.sampleRate;
+                    if (mic != null) scale(mic, n, mConfig.micVolume);
+                    if (internal != null) scale(internal, n, mConfig.internalVolume);
+                    if (mAudioTracks == 2) {
+                        feed(0, internal, n, ptsUs, false);
+                        feed(1, mic, n, ptsUs, false);
+                    } else if (mic != null && internal != null) {
+                        mix(internal, mic, n);
+                        feed(0, internal, n, ptsUs, false);
+                    } else {
+                        feed(0, mic != null ? mic : internal, n, ptsUs, false);
+                    }
+                    frames += n / frameSize;
+                }
+                for (int t = 0; t < mAudioTracks; t++) drainAudio(t, info, false);
+            }
+            long ptsUs = frames * 1_000_000L / mResolved.sampleRate;
+            for (int t = 0; t < mAudioTracks; t++) {
+                feed(t, null, 0, ptsUs, true);
+                drainAudio(t, info, true);
+            }
+        } catch (RuntimeException e) {
+            fail(mAudioCodecs.isEmpty() ? "audio" : mAudioCodecs.get(0).getName(), e);
+        }
+    }
+
+    private static int read(AudioRecord record, ByteBuffer buffer, int bytes) {
+        buffer.clear();
+        int n = record.read(buffer, bytes, AudioRecord.READ_BLOCKING);
+        if (n < 0) throw new IllegalStateException("audio read failed: " + n);
+        buffer.limit(n);
+        return n;
+    }
+
+    /** Scales 16-bit samples by [percent], clipping. */
+    private static void scale(ByteBuffer b, int n, int percent) {
+        if (percent == 100) return;
+        for (int i = 0; i + 1 < n; i += 2) {
+            int v = b.getShort(i) * percent / 100;
+            b.putShort(i, (short) Math.max(Short.MIN_VALUE, Math.min(Short.MAX_VALUE, v)));
+        }
+    }
+
+    /** Adds [other] into [into], clipping. */
+    private static void mix(ByteBuffer into, ByteBuffer other, int n) {
+        for (int i = 0; i + 1 < n; i += 2) {
+            int v = into.getShort(i) + other.getShort(i);
+            into.putShort(i, (short) Math.max(Short.MIN_VALUE, Math.min(Short.MAX_VALUE, v)));
+        }
+    }
+
+    private void feed(int track, ByteBuffer pcm, int n, long ptsUs, boolean end) {
+        MediaCodec codec = mAudioCodecs.get(track);
+        int index;
+        do {
+            index = codec.dequeueInputBuffer(TIMEOUT_US);
+            if (index < 0) drainAudio(track, new MediaCodec.BufferInfo(), false);
+        } while (index < 0 && !mFailed);
+        if (index < 0) return;
+        ByteBuffer in = codec.getInputBuffer(index);
+        int size = 0;
+        if (pcm != null && in != null) {
+            pcm.position(0).limit(n);
+            in.clear();
+            in.put(pcm);
+            size = n;
+        }
+        codec.queueInputBuffer(index, 0, size, ptsUs,
+                end ? MediaCodec.BUFFER_FLAG_END_OF_STREAM : 0);
+    }
+
+    private void drainAudio(int track, MediaCodec.BufferInfo info, boolean untilEnd) {
+        MediaCodec codec = mAudioCodecs.get(track);
+        while (true) {
+            int index = codec.dequeueOutputBuffer(info, untilEnd ? TIMEOUT_US : 0);
+            if (index == MediaCodec.INFO_TRY_AGAIN_LATER) {
+                if (untilEnd && !mFailed) continue;
+                return;
+            }
+            if (index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                trackReady(1 + track, codec.getOutputFormat());
+                continue;
+            }
+            if (index < 0) continue;
+            ByteBuffer data = codec.getOutputBuffer(index);
+            boolean end = (info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0;
+            if ((info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) == 0 && info.size > 0
+                    && data != null) {
+                sample(1 + track, data, info);
+            }
+            codec.releaseOutputBuffer(index, false);
+            if (end) return;
+        }
+    }
+
+    // -------------------------------------------------------------------------------------
+    // Writing
+
+    private void trackReady(int track, MediaFormat format) {
+        synchronized (mLock) {
+            mFormats[track] = format;
+            if (mMuxer != null && !mStarted) startMuxerIfReady();
+        }
+    }
+
+    /**
+     * Writes one encoded sample: video times are the screen's clock less the pauses, sound
+     * times count the samples recorded; both start at the first picture.
+     */
+    private void sample(int track, ByteBuffer data, MediaCodec.BufferInfo info) {
+        synchronized (mLock) {
+            if (mMuxer == null) return;
+            long us = info.presentationTimeUs;
+            if (track == 0) {
+                if (mBaseUs < 0) mBaseUs = us;
+                us = us - mBaseUs - mPausedUs;
+                boolean key = (info.flags & MediaCodec.BUFFER_FLAG_KEY_FRAME) != 0;
+                if (mRotate && key) rotate(us);
+                mLastVideoUs = us;
+            } else if (mBaseUs < 0) {
+                return;
+            }
+            us -= mSegmentBaseUs;
+            if (us < 0) return;
+            MediaCodec.BufferInfo out = new MediaCodec.BufferInfo();
+            out.set(0, info.size, us, info.flags);
+            data.position(info.offset).limit(info.offset + info.size);
+            if (!mStarted) {
+                ByteBuffer copy = ByteBuffer.allocate(info.size);
+                copy.put(data);
+                copy.flip();
+                mWaiting.add(new Pending(track, copy, out));
+                return;
+            }
+            write(track, data, out);
+            checkLimits(us);
+        }
+    }
+
+    // Called with mLock held.
+    private void write(int track, ByteBuffer data, MediaCodec.BufferInfo info) {
+        if (info.presentationTimeUs <= mLastPts[track]) {
+            info.presentationTimeUs = mLastPts[track] + 1;
+        }
+        mLastPts[track] = info.presentationTimeUs;
+        mMuxer.writeSampleData(track, data, info);
+        mSegmentBytes += info.size;
+    }
+
+    // Called with mLock held.
+    private void checkLimits(long us) {
+        if (mRotate || mLimitSent) return;
+        boolean time = mConfig.longestMinutes > 0
+                && us >= mConfig.longestMinutes * 60_000_000L;
+        boolean size = mConfig.largestMb > 0
+                && mSegmentBytes >= mConfig.largestMb * 1_000_000L * 98 / 100;
+        if (!time && !size) return;
+        if (mConfig.newFileAtLimit) {
+            Log.i(TAG, "limit reached; a new file follows");
+            mRotate = true;
+            Bundle b = new Bundle();
+            b.putInt(MediaCodec.PARAMETER_KEY_REQUEST_SYNC_FRAME, 0);
+            mVideo.setParameters(b);
+        } else {
+            Log.i(TAG, "limit reached; the recording stops");
+            mLimitSent = true;
+            mListener.onLimit(time ? MediaRecorder.MEDIA_RECORDER_INFO_MAX_DURATION_REACHED
+                    : MediaRecorder.MEDIA_RECORDER_INFO_MAX_FILESIZE_REACHED);
+        }
+    }
+
+    // Called with mLock held, at a key frame at [us] of the recording.
+    private void rotate(long us) {
+        mRotate = false;
+        closeFile();
+        mPart++;
+        try {
+            openFile();
+        } catch (IOException e) {
+            fail(mContext.getString(R.string.lujarch_recorder_error_file), e);
+            return;
+        }
+        mSegmentBaseUs = us;
+        startMuxerIfReady();
+    }
+}
