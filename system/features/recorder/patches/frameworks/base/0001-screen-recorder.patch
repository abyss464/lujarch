+/**
+ * Quality and file: the profiles, the size a minute takes, the line of what a recording gets, and
+ * the four parts, each opening its page (REC-1).
+ */
+@Composable
+fun RecorderQuality(
+    recorder: RecorderState,
+    onRoute: (RecorderRoute) -> Unit,
+    onChanged: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val context = LocalContext.current
+    Column(modifier = modifier.fillMaxWidth()) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            modifier = Modifier.fillMaxWidth().height(44.dp).padding(start = 20.dp, end = 8.dp),
+        ) {
+            Text(
+                text = stringResource(RecR.string.rec_quality_and_file),
+                style = MaterialTheme.typography.labelLarge,
+                color = MaterialTheme.colorScheme.primary,
+                modifier = Modifier.weight(1f).semantics { heading() },
+            )
+            TextButton(onClick = { onRoute(RecorderRoute.Profiles) }) {
+                Text(stringResource(RecR.string.rec_manage_profiles))
+            }
+        }
+
+        val chosen = recorder.chosenProfile
+        val changed = recorder.profileChanged
+        Row(
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            modifier = Modifier.horizontalScroll(rememberScrollState()).padding(horizontal = 16.dp),
+        ) {
+            for ((name, label) in recorder.profiles()) {
+                val look =
+                    when {
+                        name != chosen -> ChipLook.Plain
+                        changed -> ChipLook.Changed
+                        else -> ChipLook.On
+                    }
+                ProfileChip(label = label, look = look) {
+                    if (!recorder.useProfile(name)) {
+                        toast(context, context.getString(RecR.string.rec_error_profile))
+                    }
+                    onChanged()
+                }
+            }
+            AddChip { onRoute(RecorderRoute.Text(RecorderRoute.Main, TextFor.NewProfile)) }
+        }
+
+        RecorderSize(recorder, Modifier.padding(start = 20.dp, end = 20.dp, top = 10.dp))
+
+        Column(
+            verticalArrangement = Arrangement.spacedBy(6.dp),
+            modifier = Modifier.padding(start = 16.dp, end = 16.dp, top = 12.dp, bottom = 8.dp),
+        ) {
+            Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                PartTile(recorder, RecorderPage.VIDEO, Corner.TopStart, onRoute)
+                PartTile(recorder, RecorderPage.AUDIO, Corner.TopEnd, onRoute)
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                PartTile(recorder, RecorderPage.FILE, Corner.BottomStart, onRoute)
+                PartTile(recorder, RecorderPage.RECORDING, Corner.BottomEnd, onRoute)
+            }
+        }
+    }
+}
