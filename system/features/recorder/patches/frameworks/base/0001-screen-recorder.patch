+/** Video, Audio, File or Recording, with every setting the settings page has (REC-2 to REC-6). */
+@Composable
+fun RecorderPageContent(
+    recorder: RecorderState,
+    page: RecorderPage,
+    onRoute: (RecorderRoute) -> Unit,
+    onChanged: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val context = LocalContext.current
+    val settings = remember(recorder) { page.settings(recorder.context) }
+    fun write(ok: Boolean, key: String) {
+        if (!ok) Log.e(RecorderConfig.TAG, "$key not written")
+        onChanged()
+    }
+    Column(modifier = modifier.fillMaxWidth().padding(bottom = 12.dp)) {
+        PageHeader(stringResource(page.title)) { onRoute(RecorderRoute.Main) }
+        for (setting in settings) {
+            when (setting) {
+                is Group -> GroupTitle(setting.title)
+                is Toggle ->
+                    SwitchRow(
+                        title = setting.title,
+                        summary = setting.summary,
+                        checked = setting.checked,
+                        enabled = setting.available,
+                    ) {
+                        write(setting.write(it), setting.key)
+                    }
+                is Choice ->
+                    ChoiceBlock(setting) { option ->
+                        when {
+                            option.problem != null -> toast(context, option.problem!!)
+                            option.entry != null ->
+                                onRoute(
+                                    RecorderRoute.Text(
+                                        RecorderRoute.Page(page),
+                                        TextFor.Value(page, setting.key, option.entry!!.key),
+                                    )
+                                )
+                            else -> write(setting.write(option.value), setting.key)
+                        }
+                    }
+                is Level -> LevelBlock(setting) { write(setting.write(it), setting.key) }
+                is Count ->
+                    CountRow(
+                        setting = setting,
+                        onValue = { write(setting.write(it), setting.key) },
+                        onType = {
+                            onRoute(
+                                RecorderRoute.Text(
+                                    RecorderRoute.Page(page),
+                                    TextFor.Value(page, setting.key, null),
+                                )
+                            )
+                        },
+                    )
+                is Entry ->
+                    NavigationRow(setting.title, setting.summary) {
+                        onRoute(
+                            RecorderRoute.Text(
+                                RecorderRoute.Page(page),
+                                TextFor.Value(page, setting.key, null),
+                            )
+                        )
+                    }
+            }
+        }
+    }
+}
