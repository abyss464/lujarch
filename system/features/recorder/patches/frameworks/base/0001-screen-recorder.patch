+            Modifier.fillMaxWidth()
+                .heightIn(min = 64.dp)
+                .clickable(onClick = onClick)
+                .semantics { role = Role.Button }
+                .padding(horizontal = 20.dp, vertical = 8.dp),
+    ) {
+        TitleAndSummary(title, summary, Modifier.weight(1f).padding(end = 12.dp))
+        Icon(
