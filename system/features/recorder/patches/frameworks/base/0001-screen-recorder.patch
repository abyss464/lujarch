+/** The card's line icons, drawn as the design draws them: 2 dp strokes with round ends. */
+object RecIcons {
+    private fun line(vararg paths: String, filled: Set<Int> = emptySet()): ImageVector =
+        ImageVector.Builder(
+                defaultWidth = 24.dp,
+                defaultHeight = 24.dp,
+                viewportWidth = 24f,
+                viewportHeight = 24f,
+            )
+            .apply {
+                paths.forEachIndexed { i, d ->
+                    if (i in filled) {
+                        addPath(pathData = addPathNodes(d), fill = SolidColor(Color.Black))
+                    } else {
+                        addPath(
+                            pathData = addPathNodes(d),
+                            stroke = SolidColor(Color.Black),
+                            strokeLineWidth = 2f,
+                            strokeLineCap = StrokeCap.Round,
+                            strokeLineJoin = StrokeJoin.Round,
+                        )
+                    }
+                }
+            }
+            .build()
+
+    private fun circle(cx: Float, cy: Float, r: Float) =
+        "M${cx - r},${cy}a$r,$r 0 1,0 ${2 * r},0a$r,$r 0 1,0 ${-2 * r},0"
+
+    val check by lazy { line("M5 12l5 5 9-10") }
+    val add by lazy { line("M12 5v14M5 12h14") }
+    val remove by lazy { line("M5 12h14") }
+    val back by lazy { line("M19 12H5M11 6l-6 6 6 6") }
+    val forward by lazy { line("M9 6l6 6-6 6") }
+    val expand by lazy { line("M6 9l6 6 6-6") }
+    val edit by lazy { line("M4 20l4-1 11-11-3-3L5 16z") }
+    val delete by lazy { line("M4.5 7h15M10 11v6M14 11v6M6.5 7l1 13h9l1-13M9.5 7V4h5v3") }
+    val record by lazy { line(circle(12f, 12f, 8f), circle(12f, 12f, 3.5f), filled = setOf(1)) }
+    val pause by lazy {
+        line(
+            "M8 5.5h1A1.5 1.5 0 0 1 10.5 7v10A1.5 1.5 0 0 1 9 18.5H8A1.5 1.5 0 0 1 6.5 17V7A1.5 1.5 0 0 1 8 5.5z",
+            "M15 5.5h1A1.5 1.5 0 0 1 17.5 7v10A1.5 1.5 0 0 1 16 18.5h-1A1.5 1.5 0 0 1 13.5 17V7A1.5 1.5 0 0 1 15 5.5z",
+            filled = setOf(0, 1),
+        )
+    }
+    val resume by lazy { line("M8 5.5v13l10.5-6.5z", filled = setOf(0)) }
+    val stop by lazy {
+        line(
+            "M8.5 6h7A2.5 2.5 0 0 1 18 8.5v7a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 6 15.5v-7A2.5 2.5 0 0 1 8.5 6z",
+            filled = setOf(0),
+        )
+    }
+    val close by lazy { line("M6 6l12 12M18 6L6 18") }
+}
