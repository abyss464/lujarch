+/**
+ * A choice: connected buttons when its options are few and short, otherwise its value with the
+ * options opening below it.
+ */
+@Composable
+private fun ChoiceBlock(choice: Choice, onPick: (Option) -> Unit) {
+    val short =
+        choice.options.size in 2..4 &&
+            choice.options.none { it.entry != null } &&
+            choice.options.sumOf { it.label.length } <= 30
+    if (short) {
+        Column(
+            verticalArrangement = Arrangement.spacedBy(10.dp),
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 12.dp),
+        ) {
+            Text(
+                text = choice.title,
+                style = MaterialTheme.typography.titleSmall,
+                color = MaterialTheme.colorScheme.onSurface,
+            )
+            Segments(choice, onPick)
+        }
+    } else {
+        OptionList(choice, onPick)
+    }
+}
+
+@Composable
+private fun Segments(choice: Choice, onPick: (Option) -> Unit) {
+    Row(
+        horizontalArrangement = Arrangement.spacedBy(ButtonGroupDefaults.ConnectedSpaceBetween),
+        modifier = Modifier.fillMaxWidth(),
+    ) {
+        choice.options.forEachIndexed { i, option ->
+            val shapes =
+                when (i) {
+                    0 -> ButtonGroupDefaults.connectedLeadingButtonShapes()
+                    choice.options.lastIndex -> ButtonGroupDefaults.connectedTrailingButtonShapes()
+                    else -> ButtonGroupDefaults.connectedMiddleButtonShapes()
+                }
+            ToggleButton(
+                checked = option.value == choice.value,
+                onCheckedChange = { onPick(option) },
+                shapes = shapes,
+                colors =
+                    ToggleButtonDefaults.toggleButtonColors(
+                        containerColor = MaterialTheme.colorScheme.surfaceContainerHigh,
+                        contentColor = MaterialTheme.colorScheme.onSurface,
+                        checkedContainerColor = MaterialTheme.colorScheme.secondary,
+                        checkedContentColor = MaterialTheme.colorScheme.onSecondary,
+                    ),
+                modifier =
+                    Modifier.weight(1f)
+                        .height(44.dp)
+                        .alpha(if (option.problem != null) 0.38f else 1f),
+            ) {
+                Text(
+                    text = option.label,
+                    fontSize = 13.sp,
+                    fontWeight = FontWeight.Medium,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
