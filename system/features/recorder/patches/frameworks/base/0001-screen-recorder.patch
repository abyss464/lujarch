+import com.android.systemui.dagger.qualifiers.Background
+import com.android.systemui.plugins.ActivityStarter
+import com.android.systemui.res.R
+import com.android.systemui.screencapture.record.smallscreen.ui.compose.RecIcons
+import com.android.systemui.screenrecord.shared.model.ScreenRecording
+import com.android.systemui.statusbar.phone.DialogDelegate
+import com.android.systemui.statusbar.phone.SystemUIDialog
+import com.android.systemui.statusbar.phone.SystemUIDialog.DIALOG_WINDOW_TYPE
+import com.android.systemui.statusbar.phone.SystemUIDialogFactory
+import com.android.systemui.statusbar.phone.create
+import javax.inject.Inject
+import kotlin.time.Duration.Companion.seconds
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withContext
+
+private const val TAG = "RecordingSavedShelf"
+
+/** The pill at the bottom of the screen that says a recording was saved and opens it. */
+@SysUISingleton
+class RecordingSavedShelf
+@Inject
+constructor(
+    @Application private val context: Context,
+    @Background private val backgroundDispatcher: CoroutineDispatcher,
+    private val dialogFactory: SystemUIDialogFactory,
+    private val activityStarter: ActivityStarter,
+    private val accessibilityManager: AccessibilityManager,
+) {
+    private var shown: SystemUIDialog? = null
+
+    fun show(recording: ScreenRecording.Saved, display: Display) {
+        shown?.dismiss()
+        val visible = MutableTransitionState(false).apply { targetState = true }
+        val dialog =
+            dialogFactory.create(
+                context = context.createWindowContext(display, DIALOG_WINDOW_TYPE, null),
+                theme = R.style.ScreenCapture_PostRecord_SnackbarDialog,
+                dialogDelegate = ShelfDelegate,
+            ) { dialog ->
+                if (!visible.targetState && visible.isIdle) {
+                    LaunchedEffect(Unit) { dialog.dismiss() }
+                }
+                LaunchedEffect(Unit) {
+                    delay(
+                        accessibilityManager
+                            .getRecommendedTimeoutMillis(
+                                TIMEOUT.inWholeMilliseconds.toInt(),
+                                AccessibilityManager.FLAG_CONTENT_TEXT or
+                                    AccessibilityManager.FLAG_CONTENT_CONTROLS,
+                            )
+                            .toLong()
+                    )
+                    visible.targetState = false
+                }
+                AnimatedVisibility(
+                    visibleState = visible,
+                    enter =
+                        slideInVertically(MaterialTheme.motionScheme.defaultSpatialSpec()) {
+                            it * 2
+                        } + fadeIn(MaterialTheme.motionScheme.fastEffectsSpec()),
+                    exit =
+                        slideOutVertically(MaterialTheme.motionScheme.fastSpatialSpec()) {
+                            it * 2
+                        } + fadeOut(MaterialTheme.motionScheme.fastEffectsSpec()),
+                ) {
+                    Shelf(
+                        recording = recording,
+                        onView = {
+                            visible.targetState = false
+                            view(recording)
+                        },
+                        onClose = { visible.targetState = false },
+                    )
+                }
+            }
+        dialog.setOnDismissListener { if (shown === dialog) shown = null }
+        dialog.window?.setType(DIALOG_WINDOW_TYPE)
+        shown = dialog
+        dialog.show()
+    }
+
+    private fun view(recording: ScreenRecording.Saved) {
+        activityStarter.startActivityDismissingKeyguard(
+            /* intent = */ SmallScreenPostRecordingActivity.showRecording(
+                context = context,
+                videoUri = recording.uri,
+                notificationId = recording.notificationId,
+            ),
+            /* onlyProvisioned = */ true,
+            /* dismissShade = */ true,
+            /* customMessage = */ null,
+        )
+    }
+
+    @Composable
+    private fun Shelf(recording: ScreenRecording.Saved, onView: () -> Unit, onClose: () -> Unit) {
+        var details by remember { mutableStateOf<String?>(null) }
+        LaunchedEffect(recording.uri) {
+            details = withContext(backgroundDispatcher) { details(recording.uri) }
+        }
+        val bottom = WindowInsets.navigationBars.asPaddingValues().calculateBottomPadding()
+        Surface(
+            shape = CircleShape,
+            color = MaterialTheme.colorScheme.surfaceContainerHighest,
+            shadowElevation = 4.dp,
+            modifier =
+                Modifier.padding(start = 16.dp, end = 16.dp, bottom = bottom + 28.dp)
+                    .fillMaxWidth()
+                    .height(64.dp),
+        ) {
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                modifier = Modifier.padding(start = 10.dp, end = 4.dp),
+            ) {
+                Box(
+                    contentAlignment = Alignment.Center,
+                    modifier =
+                        Modifier.size(44.dp)
+                            .clip(CircleShape)
+                            .background(MaterialTheme.colorScheme.surfaceContainer)
+                            .clickable(onClick = onView),
+                ) {
+                    val thumbnail = remember(recording) { recording.thumbnail?.bitmap }
+                    if (thumbnail != null) {
+                        Image(
+                            bitmap = thumbnail.asImageBitmap(),
+                            contentDescription = null,
+                            contentScale = ContentScale.Crop,
+                            modifier = Modifier.size(44.dp),
+                        )
+                    } else {
+                        Icon(
+                            painterResource(org.lujarch.recorder.R.drawable.rec_ic_video),
+                            contentDescription = null,
+                            tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                            modifier = Modifier.size(20.dp).clip(RoundedCornerShape(4.dp)),
+                        )
+                    }
+                }
+                Spacer(Modifier.width(12.dp))
+                Column(Modifier.weight(1f)) {
+                    Text(
+                        stringResource(R.string.screenrecord_save_title),
+                        style = MaterialTheme.typography.titleSmall,
+                        color = MaterialTheme.colorScheme.onSurface,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                    details?.let {
+                        Text(
+                            it,
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis,
+                        )
+                    }
+                }
+                TextButton(onClick = onView) {
+                    Text(stringResource(org.lujarch.recorder.R.string.rec_view))
+                }
+                IconButton(onClick = onClose) {
+                    Icon(
+                        RecIcons.close,
+                        contentDescription =
+                            stringResource(R.string.underlay_close_button_content_description),
+                        tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                        modifier = Modifier.size(20.dp),
+                    )
+                }
+            }
+        }
+    }
+
+    /** "2:14 · 48 MB · MP4 · Movies", from what MediaStore holds for the saved file. */
+    private fun details(uri: Uri): String? =
+        try {
+            context.contentResolver
+                .query(
+                    uri,
+                    arrayOf(
+                        MediaStore.Video.Media.DURATION,
+                        MediaStore.MediaColumns.SIZE,
+                        MediaStore.MediaColumns.MIME_TYPE,
+                        MediaStore.MediaColumns.RELATIVE_PATH,
+                    ),
+                    null,
+                    null,
+                )
+                ?.use { c ->
+                    if (!c.moveToFirst()) return@use null
+                    listOfNotNull(
+                        c.getLong(0).takeIf { it > 0 }?.let { DateUtils.formatElapsedTime(it / 1000) },
+                        c.getLong(1).takeIf { it > 0 }?.let { Formatter.formatShortFileSize(context, it) },
+                        c.getString(2)?.substringAfter('/')?.uppercase(),
+                        c.getString(3)?.trimEnd('/')?.takeIf { it.isNotEmpty() },
+                    )
+                        .joinToString(" · ")
+                }
+        } catch (e: RuntimeException) {
+            Log.e(TAG, "Couldn't read the saved recording $uri", e)
+            null
+        }
+
+    private object ShelfDelegate : DialogDelegate<SystemUIDialog> {
+        override fun onCreate(dialog: SystemUIDialog, savedInstanceState: Bundle?) {
+            super.onCreate(dialog, savedInstanceState)
+            with(dialog.window!!) {
+                setGravity(Gravity.BOTTOM)
+                clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND)
+                addFlags(
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                        WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
+                        WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED
+                )
+                addPrivateFlags(WindowManager.LayoutParams.PRIVATE_FLAG_TRUSTED_OVERLAY)
+                setWindowAnimations(-1)
+            }
+        }
+
+        override fun getWidth(dialog: SystemUIDialog): Int =
+            WindowManager.LayoutParams.MATCH_PARENT
+
+        override fun getHeight(dialog: SystemUIDialog): Int =
+            WindowManager.LayoutParams.WRAP_CONTENT
+    }
+
+    private companion object {
+        val TIMEOUT = 6.seconds
+    }
+}
