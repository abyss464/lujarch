+/** Pause, or Resume while paused (REC-7). */
+@Composable
+fun RecorderPauseButton(visible: Boolean, paused: Boolean, onClick: () -> Unit) {
+    val motion = MaterialTheme.motionScheme
+    AnimatedVisibility(
+        visible = visible,
+        enter =
+            expandHorizontally(motion.fastSpatialSpec(), expandFrom = Alignment.End) +
+                fadeIn(motion.fastEffectsSpec()),
+        exit =
+            shrinkHorizontally(motion.fastSpatialSpec(), shrinkTowards = Alignment.End) +
+                fadeOut(motion.fastEffectsSpec()),
+    ) {
+        val source = remember { MutableInteractionSource() }
+        val pressed by source.collectIsPressedAsState()
+        val radius by
+            animateDpAsState(
+                when {
+                    pressed -> 14.dp
+                    paused -> 16.dp
+                    else -> 24.dp
+                },
+                motion.fastSpatialSpec(),
+            )
+        val container by
+            animateColorAsState(
+                if (paused) MaterialTheme.colorScheme.primary
+                else MaterialTheme.colorScheme.secondaryContainer,
+                motion.fastEffectsSpec(),
+            )
+        val content =
+            if (paused) MaterialTheme.colorScheme.onPrimary
+            else MaterialTheme.colorScheme.onSecondaryContainer
+        val label = stringResource(if (paused) RecR.string.rec_resume else RecR.string.rec_pause)
+        Box(
+            contentAlignment = Alignment.Center,
+            modifier =
+                Modifier.padding(end = 8.dp)
+                    .size(48.dp)
+                    .clip(RoundedCornerShape(radius))
+                    .background(container)
+                    .clickable(interactionSource = source, indication = null, onClick = onClick)
+                    .semantics {
+                        role = Role.Button
+                        contentDescription = label
+                    },
+        ) {
+            Icon(
+                if (paused) RecIcons.resume else RecIcons.pause,
+                contentDescription = null,
+                tint = content,
+                modifier = Modifier.size(22.dp),
+            )
+        }
+    }
+}
