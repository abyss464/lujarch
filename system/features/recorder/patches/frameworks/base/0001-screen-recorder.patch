+
+    // ---------------------------------------------------------------------------------------
+    // Profiles (REC-5)
+
+    /** Every profile's name, the built-in ones first. */
+    public static List<String> profileNames(Context context) {
+        return RecorderProfiles.names(context);
+    }
+
+    /** The name a profile shows. */
