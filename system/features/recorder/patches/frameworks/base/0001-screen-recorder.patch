+/** A value on a scale; with Automatic, a switch above it and the scale resting while it is on. */
+@Composable
+private fun LevelBlock(level: Level, onValue: (Int) -> Unit) {
+    val automatic = level.automatic != null && level.value == 0
+    if (level.automatic != null) {
+        SwitchRow(
+            title = stringResource(RecR.string.rec_automatic),
+            summary = level.automatic,
+            checked = automatic,
+        ) { on ->
+            onValue(if (on) 0 else level.min + (level.max - level.min) / level.step / 2 * level.step)
+        }
+    }
+    val value = if (automatic) level.min else level.value
+    var dragged by remember(level.value) { mutableFloatStateOf(value.toFloat()) }
+    val shown = (dragged / level.step).roundToInt() * level.step
+    Column(
+        verticalArrangement = Arrangement.spacedBy(4.dp),
+        modifier =
+            Modifier.fillMaxWidth()
+                .alpha(if (automatic) 0.38f else 1f)
+                .padding(horizontal = 20.dp, vertical = 8.dp),
+    ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Text(
+                text = level.title,
+                style = MaterialTheme.typography.titleSmall,
+                color = MaterialTheme.colorScheme.onSurface,
+                modifier = Modifier.weight(1f),
+            )
+            Text(
+                text = if (automatic) "" else level.label(shown),
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+                modifier = Modifier.widthIn(max = 200.dp),
+            )
+        }
+        Slider(
+            value = dragged,
+            onValueChange = { dragged = it },
+            onValueChangeFinished = { if (shown != level.value) onValue(shown) },
+            valueRange = level.min.toFloat()..level.max.toFloat(),
+            steps = ((level.max - level.min) / level.step - 1).coerceIn(0, 200),
+            enabled = !automatic,
+        )
+    }
+}
