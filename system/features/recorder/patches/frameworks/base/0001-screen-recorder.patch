+/**
+ * The time recorded with a dot that beats while it records, and under it Paused or what the
+ * recording takes so far (REC-7).
+ */
+@Composable
+fun RecorderLiveTime(
+    time: LujarchRecordingClock.Time?,
+    recorder: RecorderState,
+    modifier: Modifier = Modifier,
+) {
+    val motion = MaterialTheme.motionScheme
+    AnimatedVisibility(
+        visible = time != null,
+        modifier = modifier,
+        enter =
+            expandHorizontally(motion.fastSpatialSpec(), expandFrom = Alignment.Start) +
+                fadeIn(motion.fastEffectsSpec()),
+        exit =
+            shrinkHorizontally(motion.fastSpatialSpec(), shrinkTowards = Alignment.Start) +
+                fadeOut(motion.fastEffectsSpec()),
+    ) {
+        val t = time ?: return@AnimatedVisibility
+        val context = LocalContext.current
+        var now by remember { mutableLongStateOf(SystemClock.elapsedRealtime()) }
+        LaunchedEffect(t) {
+            while (!t.isPaused) {
+                now = SystemClock.elapsedRealtime()
+                delay(1000 - t.recorded(now) % 1000)
+            }
+        }
+        val recorded = t.recorded(if (t.isPaused) t.pausedAt!! else now)
+        val beat = rememberInfiniteTransition(label = "RecordingDot")
+        val dot by
+            beat.animateFloat(
+                initialValue = 1f,
+                targetValue = 0.35f,
+                animationSpec = infiniteRepeatable(tween(800), RepeatMode.Reverse),
+                label = "RecordingDotAlpha",
+            )
+        val size: String?
+        val sub: String
+        if (t.isPaused) {
+            size = null
+            sub = stringResource(RecR.string.rec_paused)
+        } else {
+            val r = recorder.resolved
+            if (r == null) {
+                size = null
+                sub = ""
+            } else {
+                val tracks = recorder.audioTracks
+                val perMinute = r.bytesPerMinute(tracks > 0, tracks)
+                size =
+                    if (perMinute >= 0) {
+                        Formatter.formatShortFileSize(context, perMinute * recorded / 60_000)
+                    } else null
+                sub =
+                    listOfNotNull(
+                            size,
+                            Encoders.codecName(r.videoMime) + " " +
+                                context.getString(RecR.string.rec_fps, r.frameRate),
+                        )
+                        .joinToString(" · ")
+            }
+        }
+        var subFits by remember(sub.isEmpty(), t.isPaused) { mutableStateOf(true) }
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            modifier = Modifier.padding(start = 8.dp, end = 4.dp),
+        ) {
+            Box(
+                Modifier.size(8.dp)
+                    .graphicsLayer { alpha = if (t.isPaused) 1f else dot }
+                    .clip(CircleShape)
+                    .background(
+                        if (t.isPaused) MaterialTheme.colorScheme.onSurfaceVariant
+                        else MaterialTheme.colorScheme.error
+                    )
+            )
+            Column(modifier = Modifier.padding(start = 6.dp)) {
+                Text(
+                    text = DateUtils.formatElapsedTime(recorded / 1000),
+                    fontSize = 18.sp,
+                    lineHeight = 22.sp,
+                    fontWeight = FontWeight.Medium,
+                    color = MaterialTheme.colorScheme.onSurface,
+                    maxLines = 1,
+                    softWrap = false,
+                )
+                if (sub.isNotEmpty()) {
+                    Text(
+                        text = if (subFits || size == null) sub else size,
+                        fontSize = 12.sp,
+                        lineHeight = 16.sp,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                        onTextLayout = { if (subFits && it.hasVisualOverflow) subFits = false },
+                    )
+                }
+            }
+        }
+    }
+}
