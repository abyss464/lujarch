+/** A text typed inside the card: a value, a size, a name (REC-1 to REC-5). */
+@Composable
+fun RecorderTextContent(
+    recorder: RecorderState,
+    route: RecorderRoute.Text,
+    onRoute: (RecorderRoute) -> Unit,
+    onChanged: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val ask = remember(recorder, route) { textAsk(recorder, route.what) }
+    if (ask == null) {
+        // The setting it was for is no longer on its page.
+        LaunchedEffect(Unit) { onRoute(route.back) }
+        return
+    }
+    var text by rememberSaveable(route) { mutableStateOf(ask.initial) }
+    var tried by rememberSaveable(route) { mutableStateOf(false) }
+    val problem = ask.validate(text)
+    val focus = remember { FocusRequester() }
+    LaunchedEffect(Unit) { focus.requestFocus() }
+    fun done() {
+        tried = true
+        if (problem != null) return
+        if (!ask.write(text)) Log.e(RecorderConfig.TAG, "${ask.title} not written")
+        onChanged()
+        onRoute(route.back)
+    }
+    Column(modifier = modifier.fillMaxWidth().padding(bottom = 16.dp)) {
+        PageHeader(ask.title) { onRoute(route.back) }
+        OutlinedTextField(
+            value = text,
+            onValueChange = {
+                text = it
+                tried = false
+            },
+            singleLine = true,
+            placeholder = ask.hint?.let { hint -> @Composable { Text(hint) } },
+            isError = tried && problem != null,
+            supportingText = (if (tried) problem else ask.hint)?.let { note -> @Composable { Text(note) } },
+            keyboardOptions =
+                KeyboardOptions(
+                    keyboardType = if (ask.numeric) KeyboardType.Number else KeyboardType.Text,
+                    imeAction = ImeAction.Done,
+                ),
+            keyboardActions = KeyboardActions(onDone = { done() }),
+            modifier =
+                Modifier.fillMaxWidth().padding(horizontal = 20.dp).focusRequester(focus),
+        )
+        Row(
+            horizontalArrangement = Arrangement.spacedBy(8.dp, Alignment.End),
+            verticalAlignment = Alignment.CenterVertically,
+            modifier = Modifier.fillMaxWidth().padding(start = 20.dp, end = 20.dp, top = 12.dp),
+        ) {
+            ask.neutral?.let { (label, act) ->
+                TextButton(
+                    onClick = {
+                        act()
+                        onChanged()
+                        onRoute(route.back)
+                    }
+                ) {
+                    Text(label)
+                }
+                Spacer(Modifier.weight(1f))
+            }
+            TextButton(onClick = { onRoute(route.back) }) {
+                Text(stringResource(RecR.string.rec_cancel))
+            }
+            Button(onClick = { done() }) { Text(stringResource(RecR.string.rec_done)) }
+        }
+    }
+}
