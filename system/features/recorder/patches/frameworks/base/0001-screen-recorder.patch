+/** A number with steps down and up; its value opens a text to type it. */
+@Composable
+private fun CountRow(setting: Count, onValue: (Int) -> Unit, onType: () -> Unit) {
+    val none = setting.noLimit != null && setting.value == 0
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier =
+            Modifier.fillMaxWidth()
+                .heightIn(min = 64.dp)
+                .padding(start = 20.dp, end = 12.dp, top = 8.dp, bottom = 8.dp),
+    ) {
+        Text(
+            text = setting.title,
+            style = MaterialTheme.typography.titleSmall,
+            color = MaterialTheme.colorScheme.onSurface,
+            modifier = Modifier.weight(1f).padding(end = 8.dp),
+        )
+        StepButton(RecIcons.remove, stringResource(RecR.string.rec_decrease)) {
+            val next =
+                when {
+                    none -> return@StepButton
+                    setting.value - setting.step < setting.min ->
+                        if (setting.noLimit != null) 0 else setting.min
+                    else -> setting.value - setting.step
+                }
+            if (next != setting.value) onValue(next)
+        }
+        Text(
+            text = if (none) setting.noLimit!! else setting.label(setting.value),
+            style = MaterialTheme.typography.titleSmall,
+            color = MaterialTheme.colorScheme.onSurface,
+            maxLines = 1,
+            modifier =
+                Modifier.widthIn(min = 72.dp)
+                    .clip(RoundedCornerShape(8.dp))
+                    .clickable(onClick = onType)
+                    .padding(horizontal = 6.dp, vertical = 8.dp),
+            textAlign = TextAlign.Center,
+        )
+        StepButton(RecIcons.add, stringResource(RecR.string.rec_increase)) {
+            val next =
+                when {
+                    none -> setting.min
+                    else -> (setting.value + setting.step).coerceAtMost(setting.max)
+                }
+            if (next != setting.value) onValue(next)
+        }
+    }
+}
