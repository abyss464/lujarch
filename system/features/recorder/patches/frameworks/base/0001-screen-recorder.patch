+/** The seconds left, in a ring that empties as they pass. */
+@Composable
+private fun CountdownRing(starting: ScreenRecordingStatus.Starting?) {
+    val colors = MaterialTheme.colorScheme
+    val motion = MaterialTheme.motionScheme
+    val left = starting?.untilStarted?.inWholeMilliseconds ?: 0L
+    val counting = starting != null
+    // The ring runs on its own clock from the first second seen, so it moves smoothly.
+    val total = remember(counting) { left.coerceAtLeast(1L) }
+    val ring = remember { Animatable(1f) }
+    LaunchedEffect(counting) {
+        if (counting) {
+            ring.snapTo(1f)
+            ring.animateTo(0f, tween(total.toInt(), easing = LinearEasing))
+        }
+    }
+    val seconds = ceil(left / 1000.0).toInt().coerceAtLeast(1)
+    Box(
+        contentAlignment = Alignment.Center,
+        modifier =
+            Modifier.size(28.dp).semantics { liveRegion = LiveRegionMode.Polite },
+    ) {
+        Canvas(Modifier.size(28.dp)) {
+            val w = 2.5.dp.toPx()
+            val inset = w / 2 + 0.5.dp.toPx()
+            val arc = Size(size.width - 2 * inset, size.height - 2 * inset)
+            drawArc(colors.outlineVariant, 0f, 360f, false, Offset(inset, inset), arc, style = Stroke(w))
+            drawArc(
+                colors.primary,
+                -90f,
+                360f * ring.value,
+                false,
+                Offset(inset, inset),
+                arc,
+                style = Stroke(w, cap = StrokeCap.Round),
+            )
+        }
+        AnimatedContent(
+            targetState = seconds,
+            transitionSpec = {
+                (slideInVertically(motion.fastSpatialSpec()) { it / 3 } +
+                        scaleIn(motion.fastSpatialSpec(), 0.7f) +
+                        fadeIn(motion.fastEffectsSpec()))
+                    .togetherWith(
+                        slideOutVertically(motion.fastSpatialSpec()) { -it / 3 } +
+                            scaleOut(targetScale = 0.7f) +
+                            fadeOut(motion.fastEffectsSpec())
+                    )
+            },
+            label = "CountdownSeconds",
+        ) { n ->
+            Text(
+                text = n.toString(),
+                fontSize = 13.sp,
+                fontWeight = FontWeight.SemiBold,
+                color = colors.onSurface,
+            )
+        }
+    }
+}
