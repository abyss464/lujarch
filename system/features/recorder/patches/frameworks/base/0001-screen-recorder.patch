+package com.android.systemui.screenrecord
+
+import android.os.SystemClock
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * The time the recording of this process has recorded and whether it is paused, kept by the
+ * recording service for its notification and the screen record toolbar (REC-7).
+ */
+object LujarchRecordingClock {
+    /** Started at [since], paused at [pausedAt] if it is, after [pausedFor] of earlier pauses. */
+    data class Time(val since: Long, val pausedAt: Long?, val pausedFor: Long) {
+        val isPaused: Boolean
+            get() = pausedAt != null
+
+        /** The milliseconds recorded at [now], on the elapsed realtime clock. */
+        fun recorded(now: Long = SystemClock.elapsedRealtime()): Long =
+            (pausedAt ?: now) - since - pausedFor
+    }
+
+    private val state = MutableStateFlow<Time?>(null)
+    val time: StateFlow<Time?> = state.asStateFlow()
+
+    /** Pauses or resumes the recording; set by the service while it records. */
+    @Volatile var pause: ((Boolean) -> Unit)? = null
+
+    fun started() {
+        state.value = Time(SystemClock.elapsedRealtime(), null, 0)
+    }
+
+    fun paused(paused: Boolean) {
+        val t = state.value ?: return
+        val now = SystemClock.elapsedRealtime()
+        state.value =
+            when {
+                paused && t.pausedAt == null -> t.copy(pausedAt = now)
+                !paused && t.pausedAt != null ->
+                    t.copy(pausedAt = null, pausedFor = t.pausedFor + now - t.pausedAt)
+                else -> t
+            }
+    }
+
+    fun stopped() {
+        state.value = null
+        pause = null
+    }
+}
