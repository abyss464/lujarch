+/** A part of the settings with what it is set to; it rounds while pressed and opens its page. */
+@Composable
+private fun RowScope.PartTile(
+    recorder: RecorderState,
+    page: RecorderPage,
+    corner: Corner,
+    onRoute: (RecorderRoute) -> Unit,
+) {
+    val motion = MaterialTheme.motionScheme
+    val source = remember { MutableInteractionSource() }
+    val pressed by source.collectIsPressedAsState()
+    fun radius(c: Corner) = if (pressed) 22.dp else if (c == corner) 20.dp else 6.dp
+    val ts by animateDpAsState(radius(Corner.TopStart), motion.fastSpatialSpec())
+    val te by animateDpAsState(radius(Corner.TopEnd), motion.fastSpatialSpec())
+    val bs by animateDpAsState(radius(Corner.BottomStart), motion.fastSpatialSpec())
+    val be by animateDpAsState(radius(Corner.BottomEnd), motion.fastSpatialSpec())
+    val fill by
+        animateColorAsState(
+            if (pressed) MaterialTheme.colorScheme.surfaceContainerHigh
+            else MaterialTheme.colorScheme.surfaceContainer,
+            motion.fastEffectsSpec(),
+        )
+    val (first, second) = recorder.summary(page)
+    Column(
+        verticalArrangement = Arrangement.spacedBy(2.dp),
+        modifier =
+            Modifier.weight(1f)
+                .height(84.dp)
+                .clip(RoundedCornerShape(ts, te, be, bs))
+                .background(fill)
+                .clickable(interactionSource = source, indication = null) {
+                    onRoute(RecorderRoute.Page(page))
+                }
+                .semantics { role = Role.Button }
+                .padding(horizontal = 14.dp, vertical = 12.dp),
+    ) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            modifier = Modifier.height(24.dp),
+        ) {
+            Icon(
+                painter = painterResource(page.icon),
+                contentDescription = null,
+                tint = MaterialTheme.colorScheme.primary,
+                modifier = Modifier.size(20.dp),
+            )
+            Text(
+                text = stringResource(page.title),
+                style = MaterialTheme.typography.titleSmall,
+                color = MaterialTheme.colorScheme.onSurface,
+                maxLines = 1,
+            )
+        }
+        for (line in listOf(first, second)) {
+            Text(
+                text = line,
+                fontSize = 12.sp,
+                lineHeight = 16.sp,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
