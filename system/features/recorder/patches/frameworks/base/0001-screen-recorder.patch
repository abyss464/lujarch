+/** Both sources: mixed into one track or separate tracks, under the two audio switches (REC-3). */
+@Composable
+fun RecorderBothSources(recorder: RecorderState, onChanged: () -> Unit) {
+    val context = LocalContext.current
+    val choice =
+        remember(recorder) {
+            RecorderPage.AUDIO.settings(recorder.context).firstOrNull {
+                it.key == "separate_tracks"
+            } as? Choice
+        }
+    AnimatedVisibility(
+        visible = choice != null,
+        enter =
+            expandVertically(MaterialTheme.motionScheme.fastSpatialSpec()) +
+                fadeIn(MaterialTheme.motionScheme.fastEffectsSpec()),
+        exit =
+            shrinkVertically(MaterialTheme.motionScheme.fastSpatialSpec()) +
+                fadeOut(MaterialTheme.motionScheme.fastEffectsSpec()),
+    ) {
+        val c = choice ?: return@AnimatedVisibility
+        Box(modifier = Modifier.padding(start = 60.dp, end = 20.dp, bottom = 12.dp)) {
+            Segments(c) { option ->
+                if (option.problem != null) {
+                    toast(context, option.problem!!)
+                } else {
+                    if (!c.write(option.value)) Log.e(RecorderConfig.TAG, "${c.key} not written")
+                    onChanged()
+                }
+            }
+        }
+    }
+}
