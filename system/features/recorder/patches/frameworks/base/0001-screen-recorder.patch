+/** Where the screen record card is (REC-1): its first page, a page of settings, or a text. */
+sealed interface RecorderRoute {
+    val depth: Int
+
+    data object Main : RecorderRoute {
+        override val depth = 0
+    }
+
+    data class Page(val page: RecorderPage) : RecorderRoute {
+        override val depth = 1
+    }
+
+    data object Profiles : RecorderRoute {
+        override val depth = 1
+    }
+
+    /** A text typed for [what]; Back returns to [back]. */
+    data class Text(val back: RecorderRoute, val what: TextFor) : RecorderRoute {
+        override val depth = 2
+    }
+}
+
+/** What a typed text is for. */
+sealed interface TextFor {
+    /** The setting [key] of [page], or the value its option's entry [entry] asks for. */
+    data class Value(val page: RecorderPage, val key: String, val entry: String?) : TextFor
+
+    data object NewProfile : TextFor
+
+    data class RenamedProfile(val name: String) : TextFor
+}
+
+val RecorderRoute.back: RecorderRoute
+    get() = if (this is RecorderRoute.Text) back else RecorderRoute.Main
+
+/**
+ * The card's pages, the one shown sliding in from the side it is on (the shared X axis) while the
+ * card takes its height.
+ */
+@Composable
+fun RecorderRouteContent(
+    route: RecorderRoute,
+    modifier: Modifier = Modifier,
+    content: @Composable (RecorderRoute) -> Unit,
+) {
+    val motion = MaterialTheme.motionScheme
+    val shift = with(LocalDensity.current) { 64.dp.roundToPx() }
+    val ltr = if (LocalLayoutDirection.current == LayoutDirection.Ltr) 1 else -1
+    AnimatedContent(
+        targetState = route,
+        transitionSpec = {
+            val side = ltr * if (targetState.depth >= initialState.depth) 1 else -1
+            (slideInHorizontally(motion.defaultSpatialSpec()) { side * shift } +
+                    fadeIn(motion.defaultEffectsSpec()))
+                .togetherWith(
+                    slideOutHorizontally(motion.defaultSpatialSpec()) { -side * shift } +
+                        fadeOut(motion.fastEffectsSpec())
+                )
+                .using(SizeTransform(clip = true) { _, _ -> motion.defaultSpatialSpec() })
+        },
+        contentAlignment = Alignment.TopCenter,
+        modifier = modifier,
+        label = "RecorderRoute",
+    ) {
+        content(it)
+    }
+}
