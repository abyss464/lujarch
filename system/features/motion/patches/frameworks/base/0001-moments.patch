+
+package com.android.systemui.surfaceeffects.lujarch
+
+import kotlin.math.cos
+import kotlin.math.exp
+import kotlin.math.pow
+import kotlin.math.sin
+
+/**
+ * The lit wave front (target/motion.md, "The water"): a crest ring of radius R round a
+ * source, drawn as five rings (a glow, the crest, two trailing rings, a black trough outside)
+ * stroked with the lit gradient, and glints on the crest where it faces the key light. A moment
+ * sets it each frame from its own R(t); [WaterPainter] draws it. Lengths are in the caller's units.
+ */
+class WaveFront {
+    @JvmField var cx = 0.0
+    @JvmField var cy = 0.0
+    /**
+     * Ring radius, stroke width and opacity; ring [TROUGH] is black, the others take the lit
+     * gradient.
+     */
+    @JvmField val ringR = DoubleArray(RINGS)
+    @JvmField val ringWidth = DoubleArray(RINGS)
+    @JvmField val ringAlpha = DoubleArray(RINGS)
+    /** Glints on the crest: position and brightness b (drawn when b >= [GLINT_MIN]). */
+    @JvmField val glintX = DoubleArray(GLINTS)
+    @JvmField val glintY = DoubleArray(GLINTS)
+    @JvmField val glintB = DoubleArray(GLINTS)
+    @JvmField var visible = false
+
+    /**
+     * The front at radius [r] round ([cx], [cy]) with progress [u] (0..1) and amplitude [amp] at
+     * time [t] seconds (the glints twinkle on it); rings at or inside [minR] are not drawn.
+     */
+    fun set(cx: Double, cy: Double, r: Double, u: Double, amp: Double, minR: Double, t: Double) {
+        this.cx = cx
+        this.cy = cy
+        visible = true
+        val cw = 2.2 + 3 * u
+        val lam = 16 + 26 * u
+        ring(GLOW, r, 10 + 18 * u, 0.28 * amp, minR)
+        ring(CREST, r, cw, amp, minR)
+        ring(TRAIL1, r - lam, cw * 0.8, 0.5 * amp, minR)
+        ring(TRAIL2, r - 2 * lam, cw * 0.7, 0.25 * amp, minR)
+        ring(TROUGH, r + 1.6 * cw, 2 * cw, 0.35 * amp, minR)
+        for (k in 0 until GLINTS) {
+            val th = k * 2 * Math.PI / GLINTS + 0.37 * sin(k * 2.3)
+            val face = Math.max(0.0, cos(th - SymbolLight.THETA_LIGHT)).pow(3)
+            glintX[k] = cx + r * cos(th)
+            glintY[k] = cy + r * sin(th)
+            glintB[k] = amp * face * (0.55 + 0.45 * sin(2 * Math.PI * (4 + (k % 5)) * t + k * 1.7))
+        }
+    }
+
+    fun hide() {
+        visible = false
+    }
+
+    private fun ring(i: Int, r: Double, w: Double, a: Double, minR: Double) {
+        ringR[i] = Math.max(1.0, r)
+        ringWidth[i] = w
+        ringAlpha[i] = if (r > minR) a else 0.0
+    }
+
+    companion object {
+        const val GLOW = 0
+        const val CREST = 1
+        const val TRAIL1 = 2
+        const val TRAIL2 = 3
+        const val TROUGH = 4
+        const val RINGS = 5
+        const val GLINTS = 28
+        const val GLINT_MIN = 0.02
+
+        /**
+         * The amplitude of a front with initial amplitude [a0] at progress [u] and radius [r]:
+         * spreading and damping, `a0 (1 - 0.85 u)^0.7 (70 / (r + 35))^0.35`; [tail] fades it after
+         * the front ends.
+         */
+        @JvmStatic
+        fun amplitude(a0: Double, u: Double, r: Double, tail: Double): Double =
+            a0 * (1 - 0.85 * u).pow(0.7) * (70 / (r + 35)).pow(0.35) * tail
+
+        /** A glint's size (its star's half span) for brightness [b]. */
+        @JvmStatic fun glintSize(b: Double): Double = 1.4 + 2.2 * b
+
+        /** A glint's opacity for brightness [b]. */
+        @JvmStatic fun glintAlpha(b: Double): Double = Math.min(1.0, 1.6 * b)
+    }
+}
+
+/**
+ * The waterline (target/motion.md): a horizontal surface at level yw over a screen
+ * [WIDTH] units wide, `y(x) = yw + a1 sin(2 pi x / l1 + c1 a + p1) + a2 sin(2 pi x / l2 + c2 a +
+ * p2) + tilt (x - 180) / 180 - meniscus(x)`, sampled every [STEP] units.
+ * Below the line a gradient from DEEPER to black; on it a LIGHTC line and three glints riding it.
+ * [WaterPainter] draws it.
+ */
+class Waterline {
+    /** The surface at x = i * STEP. */
+    @JvmField val surfaceY = DoubleArray(SAMPLES)
+    @JvmField var level = 0.0
+    @JvmField var lineAlpha = 0.0
+    /** How far the fill's top colour has come from black to DEEPER (the drain's first 100 ms). */
+    @JvmField var colorIn = 1.0
+    @JvmField val glintX = DoubleArray(SURFACE_GLINTS)
+    @JvmField val glintY = DoubleArray(SURFACE_GLINTS)
+    @JvmField val glintB = DoubleArray(SURFACE_GLINTS)
+    @JvmField var visible = false
+
+    /**
+     * The surface at [level] with two travelling waves (amplitude, wavelength, speed, phase), a
+     * [tilt] (the slosh) and the meniscus, [a] seconds into the motion at progress [u]; [lineAlpha]
+     * is the line's opacity (the glints follow it).
+     */
+    fun set(
+        level: Double,
+        a1: Double,
+        l1: Double,
+        c1: Double,
+        p1: Double,
+        a2: Double,
+        l2: Double,
+        c2: Double,
+        p2: Double,
+        tilt: Double,
+        a: Double,
+        u: Double,
+        lineAlpha: Double,
+        colorIn: Double = 1.0,
+    ) {
+        visible = true
+        this.level = level
+        this.lineAlpha = lineAlpha
+        this.colorIn = colorIn
+        for (i in 0 until SAMPLES) {
+            surfaceY[i] = surface(i * STEP, level, a1, l1, c1, p1, a2, l2, c2, p2, tilt, a)
+        }
+        for (k in 0 until SURFACE_GLINTS) {
+            val x = (60 + 130 * k + 70 * a * (1 + 0.3 * k)) % WIDTH
+            glintX[k] = x
+            glintY[k] = surface(x, level, a1, l1, c1, p1, a2, l2, c2, p2, tilt, a) - 0.4
+            glintB[k] =
+                0.85 * (0.5 + 0.5 * sin(2 * Math.PI * 5 * a + k)) * (1 - u * u) * lineAlpha / 0.6
+        }
+    }
+
+    /**
+     * Screen off (spec 1.5): the water rises from the bottom over 550 ms, sloshing; [a] seconds
+     * since the screen went off.
+     */
+    fun setRising(a: Double) {
+        val u = a / 0.55
+        val tilt = 7 * exp(-a / 0.3) * sin(2 * Math.PI * a / 0.42)
+        set(
+            HEIGHT * (1 - accDec(u)),
+            3.5 * (1 - 0.4 * u),
+            110.0,
+            9.0,
+            0.0,
+            1.4,
+            47.0,
+            -6.0,
+            1.3,
+            tilt,
+            a,
+            u,
+            0.6 * (1 - 0.5 * u),
+        )
+    }
+
+    /**
+     * The power wake (spec 1.7): the water drains off the glass from the top over 620 ms; [a]
+     * seconds since the drain began (50 ms after the press).
+     */
+    fun setDraining(a: Double) {
+        val u = Math.min(1.0, a / DRAIN)
+        val tilt = 6 * exp(-a / 0.35) * sin(2 * Math.PI * a / 0.5 + 0.4)
+        set(
+            drainLevel(a),
+            3.2,
+            104.0,
+            -8.0,
+            0.0,
+            1.3,
+            43.0,
+            5.5,
+            0.7,
+            tilt,
+            a,
+            u,
+            0.6 * (1 - 0.4 * u) * SpringResponse.ramp(a, 0.0, 0.08),
+            SpringResponse.ramp(a, 0.0, 0.1),
+        )
+    }
+
+    fun hide() {
+        visible = false
+    }
+
+    companion object {
+        const val WIDTH = 360.0
+        const val HEIGHT = 800.0
+        const val STEP = 8.0
+        const val SAMPLES = 46
+        /** The fill's bottom, below the screen so the slosh never shows its edge. */
+        const val BOTTOM = 840.0
+        /** The fill's gradient: DEEPER at the level to black this far below. */
+        const val DEPTH = 140.0
+        const val SURFACE_GLINTS = 3
+        /** How long the drain takes, seconds. */
+        const val DRAIN = 0.62
+
+        /** The water climbs the frame at both edges. */
+        @JvmStatic fun meniscus(x: Double): Double = 5 * (exp(-x / 9) + exp(-(WIDTH - x) / 9))
+
+        @JvmStatic
+        fun surface(
+            x: Double,
+            level: Double,
+            a1: Double,
+            l1: Double,
+            c1: Double,
+            p1: Double,
+            a2: Double,
+            l2: Double,
+            c2: Double,
+            p2: Double,
+            tilt: Double,
+            a: Double,
+        ): Double =
+            level +
+                a1 * sin(2 * Math.PI * x / l1 + c1 * a + p1) +
+                a2 * sin(2 * Math.PI * x / l2 + c2 * a + p2) +
+                tilt * (x - 180) / 180 - meniscus(x)
+
+        /**
+         * (1 - cos(pi u)) / 2 for u clamped to 0..1, in the form AccelerateDecelerateInterpolator
+         * uses.
+         */
+        @JvmStatic
+        fun accDec(u: Double): Double =
+            cos((Math.min(1.0, Math.max(0.0, u)) + 1) * Math.PI) / 2 + 0.5
+
+        /** The drain's mean level [a] seconds in: fast past the clock, easing out below. */
+        @JvmStatic
+        fun drainLevel(a: Double): Double =
+            -30 + 860 * (1 - (1 - SpringResponse.ramp(a, 0.0, DRAIN)).pow(2.2))
+
+        /** When the draining level passes [y], seconds after the drain began. */
+        @JvmStatic
+        fun drainPass(y: Double): Double =
+            DRAIN * (1 - (1 - Math.min(1.0, Math.max(0.0, (y + 30) / 860))).pow(1 / 2.2))
+    }
+}
