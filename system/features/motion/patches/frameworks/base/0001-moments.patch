+package com.android.systemui.surfaceeffects.lujarch
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.Shader
+
+/**
+ * Draws a [VolumeTank] as VolumeOurs draws the slider (MOT-7), in the
+ * tank's units: the track in its inactive colour, and inside it the water (a vertical gradient from
+ * the active colour 12 % towards white at the surface to 18 % towards black at the bottom), the
+ * float lit by the symbol's light, the water again at 45 % over the float so its submerged part is
+ * seen through it, and the surface line. No thumb: the water and the float mark the level.
+ *
+ * Nothing is allocated per frame: the water's gradient is fixed in a unit box and the water is
+ * drawn with the canvas scaled so the box spans the gradient's span that frame.
+ */
+class VolumeTankPainter(light: SymbolLight = SymbolLight()) {
+    /** The float, posed each frame. */
+    @JvmField val shard = ShardPose(light)
+    private val symbolPainter = SymbolPainter()
+
+    private val trackPath = Path()
+    private val waterPath = Path()
+    private val linePath = Path()
+    private val trackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val waterPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    // The line's caps are round; its ends lie on the walls, where the track's clip cuts them.
+    private val linePaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = LINE_WIDTH
+        }
+
+    private var primary = 0
+    private var hasColors = false
+    private var waterAlpha = 1.0
+    /** The water's colour at the surface and at the bottom (opaque). */
+    var waterTop = 0
+        private set
+
+    var waterBottom = 0
+        private set
+
+    // the geometry the track path was built for
+    private var pathX0 = Double.NaN
+    private var pathTop = Double.NaN
+    private var pathWidth = Double.NaN
+    private var pathHeight = Double.NaN
+    private var pathCorner = Double.NaN
+
+    /**
+     * The slider's colours: [track] for the track (its inactive part), [primary] for the water (its
+     * active part); a translucent colour keeps its alpha (the disabled slider).
+     */
+    fun setColors(track: Int, primary: Int) {
+        trackPaint.color = track
+        if (hasColors && primary == this.primary) return
+        hasColors = true
+        this.primary = primary
+        waterAlpha = (primary ushr 24) / 255.0
+        waterTop = SymbolLight.blend(primary or OPAQUE, Color.WHITE, 0.12)
+        waterBottom = SymbolLight.blend(primary or OPAQUE, Color.BLACK, 0.18)
+        waterPaint.shader =
+            LinearGradient(
+                0f,
+                0f,
+                0f,
+                1f,
+                intArrayOf(waterTop, waterBottom),
+                null,
+                Shader.TileMode.CLAMP,
+            )
+    }
+
+    /** Draws [tank] in its own units onto [canvas]. */
+    fun draw(canvas: Canvas, tank: VolumeTank) {
+        buildTrack(tank)
+        canvas.drawPath(trackPath, trackPaint)
+        val count = canvas.save()
+        canvas.clipPath(trackPath)
+
+        val level = tank.level
+        val water = level > MIN_LEVEL
+        // the gradient runs from 4 units above the level to the bottom; the water is built in that
+        // span's unit box
+        val bottom = tank.top + tank.height
+        val g1 = bottom - level - 4
+        val span = bottom - g1
+        if (water) {
+            waterPath.reset()
+            linePath.reset()
+            for (k in 0..SURFACE_SEGMENTS) {
+                val x = tank.x0 + tank.width * k / SURFACE_SEGMENTS
+                val y = tank.surfaceY(x)
+                if (k == 0) {
+                    waterPath.moveTo(x.toFloat(), ((y - g1) / span).toFloat())
+                    linePath.moveTo(x.toFloat(), y.toFloat())
+                } else {
+                    waterPath.lineTo(x.toFloat(), ((y - g1) / span).toFloat())
+                    linePath.lineTo(x.toFloat(), y.toFloat())
+                }
+            }
+            val under = ((bottom + 1 - g1) / span).toFloat()
+            waterPath.lineTo((tank.x0 + tank.width + 1).toFloat(), under)
+            waterPath.lineTo((tank.x0 - 1).toFloat(), under)
+            waterPath.close()
+            drawWater(canvas, g1, span, 1.0)
+        }
+
+        shard.set(
+            tank.floatBaseX,
+            tank.floatBaseY,
+            VolumeTank.FL,
+            VolumeTank.FB / 2 / SymbolData.CANON_BASE_HALF_WIDTH,
+            tank.floatAngle * 180 / Math.PI + 90,
+            1.0,
+            0.35 + 0.6 * Math.min(1.0, level / 10),
+            0.0,
+        )
+        symbolPainter.draw(canvas, shard)
+
+        if (water) {
+            drawWater(canvas, g1, span, OVER_FLOAT)
+            linePaint.color = SymbolLight.withAlpha(SymbolLight.GLINT, LINE_ALPHA * tank.fade)
+            canvas.drawPath(linePath, linePaint)
+        }
+        canvas.restoreToCount(count)
+    }
+
+    private fun drawWater(canvas: Canvas, g1: Double, span: Double, alpha: Double) {
+        waterPaint.alpha =
+            Math.round(Math.max(0.0, Math.min(1.0, alpha * waterAlpha)) * 255).toInt()
+        val count = canvas.save()
+        canvas.translate(0f, g1.toFloat())
+        canvas.scale(1f, span.toFloat())
+        canvas.drawPath(waterPath, waterPaint)
+        canvas.restoreToCount(count)
+    }
+
+    /**
+     * The track's outline, a rounded rectangle (quarter circles as cubics), rebuilt on a change.
+     */
+    private fun buildTrack(tank: VolumeTank) {
+        if (
+            tank.x0 == pathX0 &&
+                tank.top == pathTop &&
+                tank.width == pathWidth &&
+                tank.height == pathHeight &&
+                tank.corner == pathCorner
+        ) {
+            return
+        }
+        pathX0 = tank.x0
+        pathTop = tank.top
+        pathWidth = tank.width
+        pathHeight = tank.height
+        pathCorner = tank.corner
+        val l = tank.x0.toFloat()
+        val t = tank.top.toFloat()
+        val r = (tank.x0 + tank.width).toFloat()
+        val b = (tank.top + tank.height).toFloat()
+        val rad = Math.min(tank.corner, Math.min(tank.width, tank.height) / 2).toFloat()
+        val k = rad * KAPPA
+        trackPath.reset()
+        trackPath.moveTo(l + rad, t)
+        trackPath.lineTo(r - rad, t)
+        trackPath.cubicTo(r - rad + k, t, r, t + rad - k, r, t + rad)
+        trackPath.lineTo(r, b - rad)
+        trackPath.cubicTo(r, b - rad + k, r - rad + k, b, r - rad, b)
+        trackPath.lineTo(l + rad, b)
+        trackPath.cubicTo(l + rad - k, b, l, b - rad + k, l, b - rad)
+        trackPath.lineTo(l, t + rad)
+        trackPath.cubicTo(l, t + rad - k, l + rad - k, t, l + rad, t)
+        trackPath.close()
+    }
+
+    companion object {
+        /** Below this level (units) the tank is empty: no water, no line. */
+        const val MIN_LEVEL = 0.05
+        /** The surface is drawn as this many segments across the track. */
+        const val SURFACE_SEGMENTS = 14
+        const val LINE_WIDTH = 1.1f
+        const val LINE_ALPHA = 0.85
+        /** The water drawn again over the float. */
+        const val OVER_FLOAT = 0.45
+        private const val OPAQUE = 0xff000000.toInt()
+        // a quarter circle's cubic control distance, as a fraction of the radius
+        private const val KAPPA = 0.5522848f
+    }
+}
