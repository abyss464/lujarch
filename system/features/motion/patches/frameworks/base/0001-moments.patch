+package com.android.systemui.surfaceeffects.lujarch
+
+import kotlin.math.atan2
+import kotlin.math.cos
+import kotlin.math.exp
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+/**
+ * A spring stepped once per frame in closed form, as androidx.dynamicanimation's SpringForce steps
+ * it: stiffness [stiffness], damping ratio [damping], unit mass. Every state change of a moment
+ * runs on one of these, advanced by the integer-millisecond gap between frame times as
+ * Choreographer delivers them, so a moment follows the same trajectory at any frame rate
+ * (target/motion.md).
+ */
+class FrameSpring(
+    @JvmField var pos: Double = 0.0,
+    @JvmField var vel: Double = 0.0,
+    @JvmField var fin: Double = pos,
+    @JvmField var stiffness: Double = 1500.0,
+    @JvmField var damping: Double = 0.5,
+) {
+    /**
+     * Moves the target and the spring; a non-NaN [velocity] replaces the current velocity (a kick).
+     */
+    fun set(target: Double, stiffness: Double, damping: Double, velocity: Double = Double.NaN) {
+        fin = target
+        this.stiffness = stiffness
+        this.damping = damping
+        if (!velocity.isNaN()) vel = velocity
+    }
+
+    /** Places the spring at rest at [value]. */
+    fun snap(value: Double) {
+        pos = value
+        fin = value
+        vel = 0.0
+    }
+
+    /** Advances by [ms] milliseconds (the gap between two frame times). */
+    fun step(ms: Long) {
+        val t = ms / 1000.0
+        val w0 = sqrt(stiffness)
+        val z = damping
+        val x0 = pos - fin
+        val v0 = vel
+        val x: Double
+        val v: Double
+        if (z > 1) {
+            val r = sqrt(z * z - 1)
+            val gp = -z * w0 + w0 * r
+            val gm = -z * w0 - w0 * r
+            val cb = (gm * x0 - v0) / (gm - gp)
+            val ca = x0 - cb
+            x = ca * exp(gm * t) + cb * exp(gp * t)
+            v = ca * gm * exp(gm * t) + cb * gp * exp(gp * t)
+        } else if (z == 1.0) {
+            val ca = x0
+            val cb = v0 + w0 * x0
+            val e = exp(-w0 * t)
+            x = (ca + cb * t) * e
+            v = (ca + cb * t) * e * -w0 + cb * e
+        } else {
+            val wd = w0 * sqrt(1 - z * z)
+            val sc = (z * w0 * x0 + v0) / wd
+            val e = exp(-z * w0 * t)
+            x = e * (x0 * cos(wd * t) + sc * sin(wd * t))
+            v = x * -w0 * z + e * (-wd * x0 * sin(wd * t) + wd * sc * cos(wd * t))
+        }
+        pos = x + fin
+        vel = v
+    }
+
+    /** True when the spring is within [threshold] of its target and nearly still. */
+    fun isAtRest(threshold: Double): Boolean =
+        Math.abs(pos - fin) < threshold && Math.abs(vel) < threshold * 62.5
+}
+
+/**
+ * The responses to a passing wave or the water (target/motion.md): natural frequency
+ * [f] in Hz, damping ratio [z] < 1, [tau] seconds since the event; both are 0 before it.
+ */
+object SpringResponse {
+    /** The step response, 0 to 1: `1 - e^(-z w tau) (cos(wd tau) + z w / wd sin(wd tau))`. */
+    @JvmStatic
+    fun step(tau: Double, f: Double, z: Double): Double {
+        if (tau <= 0) return 0.0
+        val w = 2 * Math.PI * f
+        val wd = w * sqrt(1 - z * z)
+        return 1 - exp(-z * w * tau) * (cos(wd * tau) + z * w / wd * sin(wd * tau))
+    }
+
+    /**
+     * The impulse response scaled to a first peak of 1: `e^(-z w tau) sin(wd tau) / (same at its
+     * peak)`.
+     */
+    @JvmStatic
+    fun bob(tau: Double, f: Double, z: Double): Double {
+        if (tau <= 0) return 0.0
+        val w = 2 * Math.PI * f
+        val wd = w * sqrt(1 - z * z)
+        val tp = atan2(wd, z * w) / wd
+        return exp(-z * w * tau) * sin(wd * tau) / (exp(-z * w * tp) * sin(wd * tp))
+    }
+
+    /** A flash of [peak] as a half sine over [duration] seconds from the event. */
+    @JvmStatic
+    fun flash(tau: Double, peak: Double, duration: Double = 0.14): Double =
+        if (tau >= 0 && tau < duration) peak * sin(Math.PI * tau / duration) else 0.0
+
+    /**
+     * The lockscreen's flash: a triangle up to [peak] and back over [duration] seconds
+     * (LockscreenOurs' `flashAt`, which the owner approved; its text in the spec says sine).
+     */
+    @JvmStatic
+    fun flashTriangle(tau: Double, peak: Double, duration: Double = 0.14): Double {
+        if (tau < 0 || tau >= duration) return 0.0
+        val q = tau / (duration / 2)
+        return peak * (if (q < 1) q else Math.max(0.0, 2 - q))
+    }
+
+    /** (x - a) / (b - a) clamped to 0..1. */
+    @JvmStatic
+    fun ramp(x: Double, a: Double, b: Double): Double =
+        Math.min(1.0, Math.max(0.0, (x - a) / (b - a)))
+}
