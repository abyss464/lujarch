+
+package com.android.systemui.animation.lujarch
+
+import android.graphics.Matrix
+import android.view.View
+import com.android.systemui.surfaceeffects.lujarch.Entry
+import com.android.systemui.surfaceeffects.lujarch.SensorFront
+import com.android.systemui.surfaceeffects.lujarch.WakeDrain
+
+/**
+ * Makes the lockscreen's date or status icons ([kind]) answer the lockscreen's water
+ * (MOT-2). The unlock wave's crest fades the date as it passes it. The power
+ * key's wake frees each as the draining water passes its centre: the status icons fade in (120 ms),
+ * the date goes from 0.7 to 1 over 300 ms (from a black screen it fades in over 180 ms), and both
+ * rise -3 bob(2.4 Hz, 0.45). The fade goes through the view's transition alpha and the rise through
+ * its animation matrix, which SystemUI's own animations leave alone. Per frame it allocates
+ * nothing.
+ */
+class EntryRider(private val view: View, private val kind: Int) :
+    Entry.Listener, View.OnAttachStateChangeListener, Runnable {
+    private val matrix = Matrix()
+    private val location = IntArray(2)
+    private var pass = Double.NaN
+    private var fromAod = true
+    private var until = Double.NEGATIVE_INFINITY
+    private var running = false
+
+    init {
+        view.addOnAttachStateChangeListener(this)
+        if (view.isAttachedToWindow) Entry.addListener(this)
+    }
+
+    override fun onViewAttachedToWindow(v: View) {
+        Entry.addListener(this)
+    }
+
+    override fun onViewDetachedFromWindow(v: View) {
+        Entry.removeListener(this)
+        stop()
+    }
+
+    override fun onEntry(event: Int, t: Double, arg: Int) {
+        when (event) {
+            Entry.WAKE -> {
+                pass = Double.NaN
+                if (arg == 1 && !Entry.drainStart.isNaN()) {
+                    view.getLocationOnScreen(location)
+                    val y = (location[1] + view.height / 2.0) / unitPx()
+                    pass = WakeDrain.pass(Entry.drainStart, y)
+                    fromAod = Entry.wokeFromAod
+                    until = pass + SETTLE
+                    start()
+                }
+            }
+            // the unlock wave leaves the sensor shortly after the bite
+            Entry.AUTH ->
+                if (kind == DATE) {
+                    until = t + FRONT_WAIT
+                    start()
+                }
+            // ... or once what it uncovers is there: its crest passes the date by its end
+            Entry.FRONT ->
+                if (kind == DATE && arg == 1) {
+                    until = Math.max(until, t + SensorFront.DURATION + SensorFront.TAIL)
+                    start()
+                }
+            Entry.SLEEP -> stop()
+        }
+    }
+
+    private fun start() {
+        if (!running) {
+            running = true
+            view.postOnAnimation(this)
+        }
+    }
+
+    override fun run() {
+        if (!running) return
+        val t = MotionClock.now()
+        var alpha = 1.0
+        var dy = 0.0
+        val u = unitPx()
+        if (!pass.isNaN() && t < pass + SETTLE) {
+            if (kind == STATUS) {
+                alpha = WakeDrain.statusAlpha(t, pass)
+                dy = WakeDrain.statusRise(t, pass)
+            } else {
+                alpha = WakeDrain.dateAlpha(t, pass, fromAod)
+                dy = WakeDrain.dateRise(t, pass)
+            }
+        }
+        val front = if (kind == DATE) Entry.activeFront(t) else null
+        if (front != null && t >= front.start) {
+            view.getLocationOnScreen(location)
+            val x = (location[0] + view.width / 2.0) / front.unitPx
+            val y = (location[1] + view.height / 2.0) / front.unitPx
+            alpha *= front.fade(x, y, t)
+            until = Math.max(until, front.end)
+        }
+        view.transitionAlpha = alpha.toFloat()
+        matrix.setTranslate(0f, (dy * u).toFloat())
+        view.setAnimationMatrix(matrix)
+        if (t < until) view.postOnAnimation(this) else stop()
+    }
+
+    private fun stop() {
+        view.removeCallbacks(this)
+        if (running) {
+            running = false
+            view.transitionAlpha = 1f
+            view.setAnimationMatrix(null)
+        }
+    }
+
+    private fun unitPx(): Double =
+        Math.min(
+            view.resources.displayMetrics.widthPixels,
+            view.resources.displayMetrics.heightPixels,
+        ) / 360.0
+
+    companion object {
+        const val DATE = 1
+        const val STATUS = 2
+        /** The rise has settled this long after the water passed, seconds. */
+        private const val SETTLE = 1.5
+        /** How long after the bite the rider waits for the unlock wave, seconds. */
+        private const val FRONT_WAIT = 1.2
+    }
+}
