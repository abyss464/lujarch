+    /** Whether the symbol stands for the device-entry icon now ([shown]), and on AOD ([aod]). */
+    fun setMode(shown: Boolean, aod: Boolean) {
+        if (shown == symbolShown && aod == this.aod) return
+        val now = MotionClock.now()
+        if (shown && !aod && (!symbolShown || this.aod)) restSince = now
+        // the screen's events set the symbol's state; this catches a state they did not announce
+        // (SystemUI started on AOD, a wake without the lifecycle's callback)
+        if (aod && !symbol.isDark) symbol.sleep(now, false)
+        if (!aod && this.aod && symbol.isDark) symbol.wake(now, Double.NaN, sensorY(), true)
+        symbolShown = shown
+        this.aod = aod
+        invalidate()
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        Charge.addListener(this)
+        Entry.addListener(this)
+        Entry.overlay = this
+        if (Charge.plugged && !gauge.isCharging && Moment.CHARGING.isOn) {
+            gauge.settle(MotionClock.now(), Charge.level)
+        }
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        Charge.removeListener(this)
+        Entry.removeListener(this)
+        if (Entry.overlay === this) Entry.overlay = null
+        removeCallbacks(lightInPlace)
+        removeCallbacks(placeEnd)
+    }
+
+    /**
+     * True from a recognition until the symbol's let-go has melted: the symbol answers it in the
+     * icon's place, never the fingerprint icon turning into the unlocked padlock.
+     */
+    fun holdsPlace(t: Double): Boolean = symbol.isBitten(t)
+
+    /**
+     * True while the symbol answers a recognition with the unlock wave on its way: it is drawn with
+     * the wave, above what the wave uncovers and whatever the unlock does to this view's alpha
+     * (drawOverlay).
+     */
+    private fun isOverlaid(t: Double): Boolean =
+        symbol.isBitten(t) && Entry.activeFront(t) != null
+
+    /** Tells the icon when the symbol takes or gives back its place. */
+    private fun placeChanged() {
+        removeCallbacks(placeEnd)
+        onPlaceChanged?.run()
+        val t = MotionClock.now()
+        if (symbol.isBitten(t)) {
+            val end = symbol.releaseTime + SensorSymbol.LEAP_GONE
+            postDelayed(placeEnd, Math.max(0L, Math.ceil((end - t) * 1000).toLong() + 1))
+        }
+    }
+
+    override fun onEntry(event: Int, t: Double, arg: Int) {
+        when (event) {
+            Entry.TOUCH -> {
+                symbol.touch(t, arg == 1)
+                rings.touch(t, arg == 1)
+            }
+            Entry.LIFT -> {
+                symbol.lift(t)
+                rings.stop(t)
+            }
+            Entry.FAIL -> {
+                symbol.fail(t)
+                rings.fail(t)
+            }
+            Entry.AUTH -> {
+                symbol.auth(t)
+                rings.stop(t)
+            }
+            Entry.SLEEP -> symbol.sleep(t, arg == 1)
+            Entry.WAKE ->
+                symbol.wake(
+                    t,
+                    if (arg == 1) Entry.drainStart else Double.NaN,
+                    sensorY(),
+                    Entry.wokeFromAod,
+                )
+            // the let-go is the unlock wave's: the bite holds while the wave waits for what it
+            // uncovers, and lets go as its front leaves
+            Entry.FRONT ->
