+package com.android.systemui.volume.dialog.ui.utils
+
+import com.android.systemui.volume.dialog.dagger.scope.VolumeDialogScope
+import javax.inject.Inject
+
+/**
+ * The volume dialog sliding in and out (VolumeDialogViewBinder's show and hide spring) as a
+ * velocity along x, for the sliders' water (Lujarch, MOT-7): the
+ * water feels the slide, scaled down.
+ */
+@VolumeDialogScope
+class VolumeDialogSlideMotion @Inject constructor() {
+    /** The dialog's velocity along x, px/s, positive rightwards; 0 at rest. */
+    var velocityX = 0f
+        private set
+
+    private val listeners = ArrayList<Runnable>()
+
+    /** A frame of the slide: the dialog now moves at [velocityX] px/s. */
+    fun onSlide(velocityX: Float) {
+        this.velocityX = velocityX
+        for (i in listeners.indices) listeners[i].run()
+    }
+
+    /** [listener] runs on each frame of the slide, on the main thread. */
+    fun addListener(listener: Runnable) {
+        listeners += listener
+    }
+
+    fun removeListener(listener: Runnable) {
+        listeners -= listener
+    }
+}
