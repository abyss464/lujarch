+package com.android.systemui.volume.dialog.ui.utils
+
+import android.hardware.Sensor
+import android.hardware.SensorEvent
+import android.hardware.SensorEventListener
+import android.hardware.SensorManager
+import android.os.SystemClock
+import android.util.Log
+import android.view.Surface
+import android.view.View
+import com.android.systemui.surfaceeffects.lujarch.VolumeTilt
+import com.android.systemui.util.sensors.AsyncSensorManager
+import com.android.systemui.volume.dialog.dagger.scope.VolumeDialogScope
+import javax.inject.Inject
+import kotlinx.coroutines.awaitCancellation
+
+/**
+ * How the phone is held, for the sliders' water (Lujarch, MOT-7): the fused gravity
+ * (`Sensor.TYPE_GRAVITY`, from the accelerometer and the gyroscope), or the accelerometer
+ * low-passed where there is none, in the dialog's screen frame, as the slope of the water's rest
+ * surface ([VolumeTilt]).
+ *
+ * The sensor is registered only while [listen] runs, which VolumeDialogViewBinder does while the
+ * dialog is attached (shown, sliding in or out), at the game rate; nothing is registered while the
+ * dialog is hidden. SystemUI's uid is subject to Lujarch Channels' `lujarch_sensors` op: ignored,
+ * no events arrive; denied, the registration is refused (AsyncSensorManager logs it). Either way
+ * the slope stays 0 and the water is the untilted tank; nothing else of the dialog depends on it.
+ * Events arrive on the main thread, where the water reads [tilt].
+ */
+@VolumeDialogScope
+class VolumeDialogGravity @Inject constructor(private val sensorManager: AsyncSensorManager) {
+    private val model = VolumeTilt()
+    private val listeners = ArrayList<Runnable>()
+
+    /** The rest surface's slope (dh/dx, h up, x right); 0 until the sensor reports a tilt. */
+    val tilt: Double
+        get() = model.tilt
+
+    /** [listener] runs on the main thread when [tilt] changes. */
+    fun addListener(listener: Runnable) {
+        listeners += listener
+    }
+
+    fun removeListener(listener: Runnable) {
+        listeners -= listener
+    }
+
+    /**
+     * Listens until cancelled, the display's rotation read from [view] with each sample. Logs,
+     * when it stops, how many samples came and the largest surface angle.
+     */
+    suspend fun listen(view: View) {
+        val sensor =
+            sensorManager.getDefaultSensor(Sensor.TYPE_GRAVITY)
+                ?: sensorManager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)
+        if (sensor == null) {
+            Log.w(TAG, "no gravity sensor or accelerometer: the water stays level")
+            awaitCancellation()
+        }
+        val fused = sensor.type == Sensor.TYPE_GRAVITY
+        var samples = 0
+        var largest = 0.0
+        val listener =
+            object : SensorEventListener {
+                override fun onSensorChanged(event: SensorEvent) {
+                    val v = event.values
+                    if (v.size < 3) return
+                    samples++
+                    val rotation = view.display?.rotation ?: Surface.ROTATION_0
+                    val x = v[0].toDouble()
+                    val y = v[1].toDouble()
+                    val z = v[2].toDouble()
+                    val changed =
+                        if (fused) {
+                            model.onGravity(x, y, z, rotation)
+                        } else {
+                            model.onAcceleration(x, y, z, event.timestamp, rotation)
+                        }
+                    if (!changed) return
+                    largest = Math.max(largest, Math.abs(model.angle))
+                    for (i in listeners.indices) listeners[i].run()
+                }
+
+                override fun onAccuracyChanged(sensor: Sensor, accuracy: Int) {}
+            }
+        model.reset()
+        val since = SystemClock.uptimeMillis()
+        sensorManager.registerListener(listener, sensor, SensorManager.SENSOR_DELAY_GAME)
+        try {
+            awaitCancellation()
+        } finally {
+            sensorManager.unregisterListener(listener)
+            model.reset()
+            val ms = SystemClock.uptimeMillis() - since
+            if (samples == 0 && ms > NO_SAMPLES_MS) {
+                // an ignored lujarch_sensors op for SystemUI, or a refused registration
+                Log.w(TAG, "no samples from ${sensor.name} in $ms ms: the water stayed level")
+            } else {
+                Log.i(
+                    TAG,
+                    "stopped ${sensor.name} (${if (fused) "fused gravity" else "accelerometer"}) " +
+                        "after $ms ms: $samples samples, surface up to " +
+                        "%.1f degrees".format(Math.toDegrees(largest)),
+                )
+            }
+        }
+    }
+
+    private companion object {
+        const val TAG = "lujarch_motion"
+        // the first sample arrives within about 100 ms of the registration
+        const val NO_SAMPLES_MS = 500L
+    }
+}
