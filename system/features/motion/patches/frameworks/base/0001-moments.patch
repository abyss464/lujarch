+package com.android.systemui.statusbar.events
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Point
+import android.graphics.RectF
+import android.graphics.drawable.Drawable
+import android.os.SystemClock
+import android.view.View
+import android.view.animation.AnimationUtils
+import com.android.app.animation.Interpolators
+import com.android.systemui.animation.lujarch.Moment
+import com.android.systemui.surfaceeffects.lujarch.PrivacyWatcher
+import com.android.systemui.surfaceeffects.lujarch.SymbolPainter
+import kotlin.math.ceil
+
+/**
+ * Lujarch (MOT-5): the privacy indicator drawn round the camera,
+ * in ScreenDecorations' overlay over the camera cutout, as FaceScanningOverlay draws round it. The
+ * symbol opens round the hole (its empty centre holds the hole at the lockscreen size), in the
+ * privacy green, with the sensor's glyph beside it for the chip's time; then a ring of teeth stays
+ * as the persistent indicator until the access stops and the teeth sink into the hole. It replaces
+ * the status bar's privacy chip and the corner dot; [PrivacyDotViewController] drives it from the
+ * scheduler's events and the shade's state. The choreography is [PrivacyWatcher]'s, a closed form
+ * of the time since each event, so a frame depends only on its frame time.
+ *
+ * Owned by the ScreenDecorations thread: every method runs there, except [isOnWatcher]. Frames are
+ * asked for only while something moves and the view is shown; onDraw allocates nothing.
+ */
+class PrivacyWatcherView(context: Context) : View(context) {
+
+    /** Told when the view starts or stops showing, for the overlay window's visibility. */
+    interface Listener {
+        fun onWatcherShown(view: View)
+
+        fun onWatcherHidden(view: View)
+    }
+
+    var listener: Listener? = null
+
+    private val watcher = PrivacyWatcher()
+    private val painter = SymbolPainter()
+    private val holePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.BLACK }
+    private val location = IntArray(2)
+    private val glyphs = arrayOfNulls<Drawable>(MAX_GLYPHS)
+    private var glyphCount = 0
+    private var glyphHalfPx = 0
+
+    // The camera in screen coordinates of the current rotation and the pixels per artboard unit:
+    // the hole's radius over [CAMERA_RADIUS] units, so the hole always fits the symbol's centre.
+    private var camX = 0f
+    private var camY = 0f
+    private var unitPx = 0f
+    @Volatile private var edge = EDGE_NONE
+    private var displayWidth = 0
+    private var displayHeight = 0
+    private var glyphDir = 1f
+
+    /** Whether the shade leaves the indicator on screen (the corner dot's rule). */
+    private var allowed = true
+
+    // Where a tap opens the privacy dialog, in screen coordinates; read on the main thread.
+    @Volatile private var hitX = 0f
+    @Volatile private var hitY = 0f
+    @Volatile private var hitRadius = 0f
+
+    private val hideWhenGone = Runnable { onEvent() }
+
+    init {
+        visibility = GONE
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_YES
+    }
+
+    /** Whether a camera cutout was found to open round. */
+    val hasCamera: Boolean
+        get() = edge != EDGE_NONE
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        updateCutout()
+    }
+
+    /** Reads the camera cutout for the current rotation; call on attach and on display changes. */
+    fun updateCutout() {
+        val display = context.display
+        val path = display?.cutout?.cutoutPath
+        val bounds = RectF()
+        if (path != null) path.computeBounds(bounds, true)
+        if (display == null || bounds.isEmpty) {
+            edge = EDGE_NONE
+        } else {
+            val size = Point()
+            display.getRealSize(size)
+            displayWidth = size.x
+            displayHeight = size.y
+            camX = bounds.centerX()
+            camY = bounds.centerY()
+            unitPx = Math.min(bounds.width(), bounds.height()) / 2 / CAMERA_RADIUS
+            val top = camY
+            val bottom = displayHeight - camY
+            val left = camX
+            val right = displayWidth - camX
+            val nearest = minOf(top, bottom, left, right)
+            edge =
+                when (nearest) {
+                    top -> EDGE_TOP
+                    bottom -> EDGE_BOTTOM
+                    left -> EDGE_LEFT
+                    else -> EDGE_RIGHT
+                }
+            // the glyph reads after the eye (to the right, to the left in RTL), away from an edge
+            glyphDir = if (layoutDirection == LAYOUT_DIRECTION_RTL) -1f else 1f
+            val reach = (PrivacyWatcher.GLYPH_REACH + PrivacyWatcher.GLYPH_UNITS) * unitPx
+            if (camX + glyphDir * reach !in 0f..displayWidth.toFloat()) glyphDir = -glyphDir
+            glyphHalfPx = Math.round(PrivacyWatcher.GLYPH_UNITS * unitPx / 2).toInt()
+            for (k in 0 until glyphCount) {
+                glyphs[k]?.setBounds(-glyphHalfPx, -glyphHalfPx, glyphHalfPx, glyphHalfPx)
+            }
+        }
+        // an event may have come before the cutout was known (the view attaches after it is set up)
+        updateVisibility(animate = false)
+        requestLayout()
+        invalidate()
+    }
+
+    /**
+     * An app started sensing at [timeMs] (uptime): the symbol opens in [color] with [icons], the
+     * sensors' glyphs as the chip shows them.
+     */
+    fun open(timeMs: Long, color: Int, icons: List<Drawable>) {
+        glyphCount = Math.min(MAX_GLYPHS, icons.size)
+        for (k in 0 until MAX_GLYPHS) {
+            glyphs[k] =
+                if (k < glyphCount) {
+                    icons[k].mutate().apply {
+                        setTint(color)
+                        setBounds(-glyphHalfPx, -glyphHalfPx, glyphHalfPx, glyphHalfPx)
+                    }
+                } else null
+        }
+        watcher.liveColor = color
+        watcher.open(eventSec(timeMs))
+        onEvent()
+    }
+
+    /** The chip's time is over at [timeMs]: teeth if [persistent], otherwise the symbol closes. */
+    fun settle(timeMs: Long, persistent: Boolean) {
+        watcher.settle(eventSec(timeMs), persistent)
+        onEvent()
+    }
+
+    /** The persistent indicator at [timeMs] in [color], without the chip's moment. */
+    fun teeth(timeMs: Long, color: Int) {
+        watcher.liveColor = color
+        watcher.teeth(eventSec(timeMs))
+        onEvent()
+    }
+
+    /** The access stopped at [timeMs]: the teeth sink into the hole. */
+    fun close(timeMs: Long) {
+        watcher.close(eventSec(timeMs))
+        onEvent()
+    }
+
+    /** Whether the shade leaves the indicator on screen; it fades as the corner dot does. */
+    fun setAllowed(allowed: Boolean) {
+        if (this.allowed == allowed) return
+        this.allowed = allowed
+        updateVisibility(animate = true)
+        if (allowed) invalidate()
+    }
+
+    /** Whether ([rawX], [rawY]) on screen is on the indicator while it shows. */
+    fun isOnWatcher(rawX: Float, rawY: Float): Boolean {
+        val r = hitRadius
+        if (r <= 0f) return false
+        val dx = rawX - hitX
+        val dy = rawY - hitY
+        return dx * dx + dy * dy <= r * r
+    }
+
+    private fun nowSec() = SystemClock.uptimeMillis() / 1000.0
+
+    /**
+     * An event's time on the watcher's clock. With Remove animations on, every event is taken as
+     * long past, so each moment shows its end at once.
+     */
+    private fun eventSec(timeMs: Long): Double =
+        timeMs / 1000.0 - if (Moment.animating()) 0.0 else ENDED_SEC
+
+    private fun onEvent() {
+        removeCallbacks(hideWhenGone)
+        val gone = watcher.goneTime()
+        if (!gone.isNaN()) {
+            if (watcher.isGone(nowSec())) {
+                watcher.reset()
+            } else {
+                postDelayed(
+                    hideWhenGone,
+                    Math.max(1L, (gone * 1000).toLong() - SystemClock.uptimeMillis() + 1),
+                )
+            }
+        }
+        updateVisibility(animate = false)
+        invalidate()
+    }
+
+    private fun updateVisibility(animate: Boolean) {
+        val active = hasCamera && !watcher.isGone(nowSec())
+        val show = active && allowed
+        if (show) {
+            if (visibility != VISIBLE) {
+                animate().cancel()
+                visibility = VISIBLE
+                if (animate) {
+                    alpha = 0f
+                    animate()
+                        .alpha(1f)
+                        .setDuration(FADE_MS)
+                        .setInterpolator(Interpolators.ALPHA_IN)
+                        .start()
+                } else {
+                    alpha = 1f
+                }
+                listener?.onWatcherShown(this)
+            } else if (animate) {
+                // back from a fade the shade started
+                animate().cancel()
+                animate()
+                    .alpha(1f)
+                    .setDuration(FADE_MS)
+                    .setInterpolator(Interpolators.ALPHA_IN)
+                    .start()
+            }
+        } else if (visibility == VISIBLE) {
+            animate().cancel()
+            if (animate && active) {
+                // the shade covers it: fade as the corner dot fades, then leave the overlay
+                animate()
+                    .alpha(0f)
+                    .setDuration(FADE_MS)
+                    .setInterpolator(Interpolators.ALPHA_OUT)
+                    .withEndAction { hide() }
+                    .start()
+            } else {
+                hide()
+            }
+        }
+        updateHitArea()
+    }
+
+    private fun hide() {
+        visibility = GONE
+        updateHitArea()
+        listener?.onWatcherHidden(this)
+    }
+
+    private fun updateHitArea() {
+        hitX = camX
+        hitY = camY
+        hitRadius =
+            if (hasCamera && allowed && visibility == VISIBLE && !watcher.isGone(nowSec())) {
+                TOUCH_RADIUS * unitPx
+            } else 0f
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val w = MeasureSpec.getSize(widthMeasureSpec)
+        val h = MeasureSpec.getSize(heightMeasureSpec)
+        // across the edge: to the camera and past it by the ring, or by the glyphs where they run
+        // away from the edge (a camera on the left or right edge)
+        val ring = PrivacyWatcher.RING_EXTENT.toFloat() * unitPx
+        val side = SIDE_EXTENT * unitPx
+        when (edge) {
+            EDGE_TOP -> setMeasuredDimension(w, ceil(camY + ring).toInt())
+            EDGE_BOTTOM -> setMeasuredDimension(w, ceil(displayHeight - camY + ring).toInt())
+            EDGE_LEFT -> setMeasuredDimension(ceil(camX + side).toInt(), h)
+            EDGE_RIGHT -> setMeasuredDimension(ceil(displayWidth - camX + side).toInt(), h)
+            else -> setMeasuredDimension(0, 0)
+        }
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        if (!hasCamera) return
+        val t = AnimationUtils.currentAnimationTimeMillis() / 1000.0
+        watcher.update(t, 0.0, 0.0)
+        if (watcher.shown && !watcher.isGone(t)) {
+            getLocationOnScreen(location)
+            val cx = camX - location[0]
+            val cy = camY - location[1]
+            canvas.save()
+            canvas.translate(cx, cy)
+            canvas.scale(unitPx, unitPx)
+            painter.draw(canvas, watcher.pose)
+            canvas.restore()
+            if (watcher.glyphAlpha > 0) {
+                val a = Math.round(watcher.glyphAlpha * 255).toInt()
+                val s = watcher.glyphScale.toFloat()
+                for (k in 0 until glyphCount) {
+                    val g = glyphs[k] ?: continue
+                    val reach = watcher.glyphReach * (PrivacyWatcher.GLYPH_REACH + k * GLYPH_STEP)
+                    canvas.save()
+                    canvas.translate(cx + glyphDir * unitPx * reach.toFloat(), cy)
+                    canvas.scale(s, s)
+                    g.alpha = a
+                    g.draw(canvas)
+                    canvas.restore()
+                }
+            }
+            // the hole over the shards' roots: they rise out of its rim
+            canvas.drawCircle(cx, cy, CAMERA_RADIUS * unitPx, holePaint)
+        }
+        if (allowed && watcher.isMoving(t)) postInvalidateOnAnimation()
+    }
+
+    companion object {
+        /** How long past an event is taken with Remove animations on, seconds. */
+        private const val ENDED_SEC = 60.0
+
+        /**
+         * The overlay view's id (ScreenDecorations tells its overlay windows' views apart by id).
+         */
+        @JvmField val VIEW_ID = generateViewId()
+
+        private const val CAMERA_RADIUS = PrivacyWatcher.CAMERA_RADIUS.toFloat()
+        /** A tap within this many units of the camera centre is on the indicator. */
+        private const val TOUCH_RADIUS = 35f
+        /** The chip shows up to three sensors: camera, microphone, location. */
+        private const val MAX_GLYPHS = 3
+        /** From one glyph to the next, units: the chip's 16 dp icons and 4 dp margins. */
+        private const val GLYPH_STEP = PrivacyWatcher.GLYPH_UNITS + 3.5
+        /** How far the glyphs reach from the camera centre at their springs' overshoot, units. */
+        private const val SIDE_EXTENT =
+            (PrivacyWatcher.GLYPH_REACH +
+                    (MAX_GLYPHS - 1) * GLYPH_STEP +
+                    0.55 * PrivacyWatcher.GLYPH_UNITS +
+                    2)
+                .toFloat()
+        /** The corner dot's fade (PrivacyDotViewController's DURATION). */
+        private const val FADE_MS = 160L
+
+        private const val EDGE_NONE = 0
+        private const val EDGE_TOP = 1
+        private const val EDGE_BOTTOM = 2
+        private const val EDGE_LEFT = 3
+        private const val EDGE_RIGHT = 4
+    }
+}
