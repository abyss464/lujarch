+
+package com.android.systemui.surfaceeffects.lujarch
+
+import kotlin.math.PI
+import kotlin.math.asin
+import kotlin.math.exp
+import kotlin.math.sqrt
+import kotlin.math.tan
+
+/**
+ * The volume tank's slight gravity (MOT-7): how the phone is held, as the
+ * gravity vector a sensor reports, turned into the slope of the water's rest surface that
+ * [VolumeTank.step] takes. VolumeOurs' `tiltAngle` (gravity = tilted).
+ *
+ * The vector is the reaction to gravity in the device's axes, m/s^2, as `Sensor.TYPE_GRAVITY`
+ * (fused from the accelerometer and the gyroscope) reports it: (0, 9.8, 0) upright, (0, 0, 9.8)
+ * lying face up. The display's rotation turns it into the screen's axes. Its roll in the screen's
+ * plane tilts the rest surface towards the true down by [GAIN] of the roll, folded at 90 degrees
+ * (upside down the water is level again), at most [CAP]; weighted by the share of gravity in the
+ * screen's plane, from nothing at [FLAT] (lying within 11.5 degrees of flat, where the roll is
+ * noise) to all at [FULL] (30 degrees). The published angle moves in steps of [STEP], so a still
+ * hand's tremor leaves the water at rest. Without a gravity sensor, [onAcceleration] low-passes
+ * the accelerometer first.
+ *
+ * Nothing is allocated. Not thread-safe: the sensor's events and the drawing share a thread.
+ */
+class VolumeTilt {
+    /**
+     * The rest surface's angle, radians, positive when the true down lies to the screen's right
+     * (the water stands higher at the right wall); 0 until a sample moves it.
+     */
+    var angle = 0.0
+        private set
+
+    /** Its slope, dh/dx (h up, x right), as [VolumeTank.step] takes it. */
+    var tilt = 0.0
+        private set
+
+    // the accelerometer's low-pass (the gravity it leaves) and the last sample's time
+    private var lowX = 0.0
+    private var lowY = 0.0
+    private var lowZ = 0.0
+    private var lowNs = 0L
+    private var lowStarted = false
+
+    /**
+     * A gravity sample ([gx], [gy], [gz], device axes) with the display at [rotation] (0-3, as
+     * `Surface.ROTATION_*`). True when the published tilt changed.
+     */
+    fun onGravity(gx: Double, gy: Double, gz: Double, rotation: Int): Boolean {
+        val a = angleOf(gx, gy, gz, rotation)
+        if (Math.abs(a - angle) >= STEP || (a == 0.0 && angle != 0.0)) {
+            angle = a
+            tilt = tan(a)
+            return true
+        }
+        return false
+    }
+
+    /**
+     * An accelerometer sample at [timestampNs]: low-passed with a [LOW_PASS_S] time constant (what
+     * is left is gravity; a hand's shake is not), then as [onGravity].
+     */
+    fun onAcceleration(
+        ax: Double,
+        ay: Double,
+        az: Double,
+        timestampNs: Long,
+        rotation: Int,
+    ): Boolean {
+        if (!(ax + ay + az).isFinite()) return false
+        val dt = (timestampNs - lowNs) / 1e9
+        if (!lowStarted || dt <= 0 || dt > MAX_SAMPLE_GAP_S) {
+            lowX = ax
+            lowY = ay
+            lowZ = az
+            lowStarted = true
+        } else {
+            val k = 1 - exp(-dt / LOW_PASS_S)
+            lowX += (ax - lowX) * k
+            lowY += (ay - lowY) * k
+            lowZ += (az - lowZ) * k
+        }
+        lowNs = timestampNs
+        return onGravity(lowX, lowY, lowZ, rotation)
+    }
+
+    /** Level again, the low-pass forgotten (the sensor stopped). */
+    fun reset() {
+        angle = 0.0
+        tilt = 0.0
+        lowStarted = false
+    }
+
+    companion object {
+        /** The rest surface turns by this share of the phone's roll. */
+        const val GAIN = 0.3
+        /** At most 4 degrees: 2.45 units across the 35-unit tank, under a third of a step. */
+        const val CAP = 4 * PI / 180
+        /** The share of gravity in the screen's plane below which the roll counts for nothing. */
+        const val FLAT = 0.2
+        /** ... and from which it counts fully. */
+        const val FULL = 0.5
+        /** The published angle's step: 0.1 degree, 0.06 units across the tank. */
+        const val STEP = 0.1 * PI / 180
+        /** Below this magnitude (m/s^2) the vector is no gravity (free fall, no data). */
+        const val MIN_GRAVITY = 1.0
+        /** The accelerometer's low-pass time constant, s. */
+        const val LOW_PASS_S = 0.2
+        /** A longer gap between accelerometer samples starts the low-pass afresh. */
+        const val MAX_SAMPLE_GAP_S = 0.5
+
+        /** The rest surface's angle for gravity ([gx], [gy], [gz]) at display [rotation]. */
+        @JvmStatic
+        fun angleOf(gx: Double, gy: Double, gz: Double, rotation: Int): Double {
+            // the reaction in the screen's axes, y up
+            val ux =
+                when (rotation) {
+                    1 -> -gy
+                    2 -> -gx
+                    3 -> gy
+                    else -> gx
+                }
+            val uy =
+                when (rotation) {
+                    1 -> gx
+                    2 -> -gy
+                    3 -> -gx
+                    else -> gy
+                }
+            val inPlane = sqrt(ux * ux + uy * uy)
+            val all = sqrt(ux * ux + uy * uy + gz * gz)
+            if (!(all >= MIN_GRAVITY && all < Double.POSITIVE_INFINITY) || !(inPlane > 0)) {
+                return 0.0
+            }
+            val q = Math.min(1.0, Math.max(0.0, (inPlane / all - FLAT) / (FULL - FLAT)))
+            val weight = q * q * (3 - 2 * q)
+            // the roll: the true down's share towards the screen's right, folded at 90 degrees
+            val roll = asin(Math.min(1.0, Math.max(-1.0, -ux / inPlane)))
+            return weight * Math.min(CAP, Math.max(-CAP, GAIN * roll))
+        }
+    }
+}
