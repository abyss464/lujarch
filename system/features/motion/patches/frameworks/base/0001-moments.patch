+
+package com.android.systemui.surfaceeffects.lujarch
+
+import kotlin.math.cos
+import kotlin.math.exp
+import kotlin.math.floor
+import kotlin.math.pow
+import kotlin.math.sin
+
+/**
+ * The symbol on the fingerprint sensor (MOT-2; as the battery, 2.1, through
+ * [gauge]). At rest it breathes and sways. A finger parts its jaws round the white dot, each shard
+ * on its own springs (r0 to 31, kr to 0.15 on 700/0.55, round the ring from the top 9 ms apart),
+ * and it lights. Recognised, it bites (2500/0.5, a flash) and 140 ms later lets go: the shards
+ * burst outward, tumble, grow towards the eye and melt. Refused, the jaws take a kick outward
+ * (900/0.28, 320 units/s), the light drops to 0.35 and comes back once the finger lifts, and the
+ * jaws close (500/0.7). The screen going off from an unlocked phone makes it float up from under
+ * the water on AOD (lit 0.3); the power key's wake frees it last: it lights, shakes the water off
+ * (its jaws flutter, it twists) and breathes again. A finger on the dark screen runs the same bite
+ * on AOD's light.
+ *
+ * Events come in time order; [pose] may be asked for any time on or after the last one. The jaws'
+ * springs are stepped on a 120 Hz grid with integer-millisecond frame times; everything else is
+ * closed form. Per frame it allocates nothing. Lengths are artboard
+ * units, times seconds.
+ */
+class SensorSymbol {
+    /** The gauge while the phone charges. */
+    @JvmField val gauge = ChargingGauge()
+
+    private var phase = REST
+
+    // the touch sequence on the sensor
+    private var firstTouch = Double.NaN
+    private var touchAt = Double.NaN
+    private var down = false
+    private var dark = false
+    private var failAt = Double.NaN
+    private var liftAt = Double.NaN
+    private var authAt = Double.NaN
+    private var releaseAt = Double.NaN
+    private var reformAt = Double.NaN
+    // the screen
+    private var sleepAt = Double.NaN
+    private var floats = false
+    private var drainPass = Double.NaN
+    private var fromAod = true
+    private var aodShows = true
+    private var wokeAt = Double.NEGATIVE_INFINITY
+
+    // the jaws: a pair of springs per shard, the events queued with their times
+    private val r0 = Array(SymbolPose.N) { FrameSpring(0.0, 0.0, 0.0, 700.0, 0.55) }
+    private val kr = Array(SymbolPose.N) { FrameSpring(KS, 0.0, KS, 700.0, 0.55) }
+    private val evT = DoubleArray(EVENTS)
+    private val evK = IntArray(EVENTS)
+    private var evN = 0
+    private val ei = IntArray(SymbolPose.N)
+    private var nextN = 0L
+    private var prevMs = 0L
+
+    /** The symbol's opacity in this frame. */
+    @JvmField var alpha = 1.0
+    /** The symbol's offset from its rest in this frame, units. */
+    @JvmField var offsetX = 0.0
+    @JvmField var offsetY = 0.0
+
+    /** True while the symbol shows the lockscreen's dark (AOD) light. */
+    val isDark: Boolean
+        get() = phase == AOD || (phase == REST && dark)
+
+    /**
+     * True from just before the symbol lets go until its shards have melted: the unlock wave's
+     * front leaves then, and the symbol is drawn above it ([Entry.Overlay]).
+     */
+    fun isLeaping(t: Double): Boolean =
+        !releaseAt.isNaN() && t >= releaseAt - LEAP_OVERLAY && t < releaseAt + LEAP_GONE
+
+    /** True after the symbol let go (its shards gone) until it is formed again. */
+    fun isGone(t: Double): Boolean = !releaseAt.isNaN() && t >= releaseAt + LEAP_GONE
+
+    /** A finger landed at [t]; [onDark] when the screen was dark (AOD or off). */
+    fun touch(t: Double, onDark: Boolean) {
+        if (!releaseAt.isNaN()) return
+        if (onDark && (phase == AOD || !dark)) {
+            // a finger on the dark screen: the bite runs on AOD's light, from the jaws at rest
+            phase = REST
+            clearSequence()
+            resetJaws(t)
+            dark = true
+        } else if (phase != REST) {
+            phase = REST
+            clearSequence()
+            resetJaws(t)
+        }
+        if (firstTouch.isNaN()) firstTouch = t
+        touchAt = t
+        down = true
+        queue(t, OPEN)
+    }
+
+    /** The finger left the sensor at [t]. */
+    fun lift(t: Double) {
+        if (!down) return
+        down = false
+        liftAt = t
+        if (authAt.isNaN()) queue(t, CLOSE)
+    }
+
+    /** The matcher refused the finger at [t]. */
+    fun fail(t: Double) {
+        if (touchAt.isNaN() || !releaseAt.isNaN()) return
+        failAt = t
+        queue(t, REFUSE)
+    }
+
+    /** The finger was recognised at [t]: the bite, then the let-go [RELEASE] later. */
+    fun auth(t: Double) {
+        if (!releaseAt.isNaN()) return
+        if (touchAt.isNaN()) {
+            // recognised without a finger seen landing (a late callback): the jaws part and bite
+            touch(t, dark)
+        }
+        authAt = t
+        releaseAt = t + RELEASE
+        queue(t, BITE)
+    }
+
+    /**
+     * At [t] the unlock wave waits for what it uncovers: the bite holds until [letGo], at the
+     * latest until [latest]. The let-go is the wave's, so it waits with it.
+     */
+    fun holdBite(t: Double, latest: Double) {
+        if (authAt.isNaN() || releaseAt.isNaN() || t >= releaseAt) return
+        releaseAt = Math.max(releaseAt, latest)
+    }
+
+    /**
+     * At [t] the symbol is told to let go at [at] (the unlock wave's front leaves just before), no
+     * sooner than [RELEASE] after the bite; one already letting go goes on.
+     */
+    fun letGo(t: Double, at: Double) {
+        if (authAt.isNaN() || releaseAt.isNaN() || t >= releaseAt) return
+        releaseAt = Math.max(authAt + RELEASE, Math.max(t, at))
+    }
+
+    /** When the symbol lets go, or NaN. */
+    val releaseTime: Double
+        get() = releaseAt
+
+    /**
+     * True from the recognition until the let-go's shards have melted: the symbol answers the
+     * recognition, whatever icon the unlock brings.
+     */
+    fun isBitten(t: Double): Boolean =
+        !authAt.isNaN() && !releaseAt.isNaN() && t >= authAt && t < releaseAt + LEAP_GONE
+
+    /**
+     * The symbol lets go at [t] with nothing unlocked after (the lockscreen stays): formed again.
+     */
+    fun reform(t: Double) {
+        phase = REST
+        clearSequence()
+        resetJaws(t)
+        reformAt = t
+    }
+
+    /**
+     * The screen began to go off at [t]; [fromUnlocked]: it floats up from under the water on AOD.
+     * [aod] false: no AOD follows (the screen goes black), so nothing surfaces.
+     */
+    fun sleep(t: Double, fromUnlocked: Boolean, aod: Boolean = true) {
+        phase = AOD
+        clearSequence()
+        sleepAt = t
+        floats = fromUnlocked
+        aodShows = aod
+    }
+
+    /**
+     * The screen woke at [t]. [drainStart] is when the water began to drain (a power wake), or NaN;
+     * [symbolY] the symbol's centre (units) for the moment the water frees it; [aod]: AOD showed.
+     */
+    fun wake(t: Double, drainStart: Double, symbolY: Double, aod: Boolean) {
+        if (phase == REST && dark && !touchAt.isNaN()) return // a finger woke it: its bite runs on
+        clearSequence()
+        resetJaws(t)
+        fromAod = aod
+        if (drainStart.isNaN()) {
+            phase = REST
+            wokeAt = t
+            return
+        }
+        phase = DRAIN
+        drainPass = drainStart + Waterline.drainPass(symbolY)
+        queue(drainPass, SHIVER)
+    }
+
+    /** True while something moves at [t] besides the breathing. */
+    fun isMoving(t: Double): Boolean =
+        when (phase) {
+            AOD -> floats && t < sleepAt + RISE + SETTLE
+            DRAIN -> t < drainPass + SETTLE
+            else ->
+                down ||
+                    (!touchAt.isNaN() && (t < liftAt + SETTLE || t < releaseAt + LEAP_GONE)) ||
+                    t < wokeAt + WAKE_LIT ||
+                    t < reformAt + REFORM
+        } || gauge.isMoving(t)
+
+    private fun clearSequence() {
+        firstTouch = Double.NaN
+        touchAt = Double.NaN
+        down = false
+        dark = false
+        failAt = Double.NaN
+        liftAt = Double.NaN
+        authAt = Double.NaN
+        releaseAt = Double.NaN
+        reformAt = Double.NaN
+    }
+
+    /** The jaws at rest, their springs starting at [t]. */
+    private fun resetJaws(t: Double) {
+        for (i in 0 until SymbolPose.N) {
+            r0[i].pos = 0.0
+            r0[i].vel = 0.0
+            r0[i].set(0.0, 700.0, 0.55)
+            kr[i].pos = KS
+            kr[i].vel = 0.0
+            kr[i].set(KS, 700.0, 0.55)
+            ei[i] = 0
+        }
+        evN = 0
+        nextN = Math.ceil(t * FPS).toLong()
+        prevMs = floor(t * 1000).toLong()
+    }
+
+    private fun queue(t: Double, kind: Int) {
+        if (evN == EVENTS) return
+        evT[evN] = t
+        evK[evN] = kind
+        evN++
+    }
+
+    /** Steps the jaws on the 120 Hz grid up to [t] (no further than [until]). */
+    private fun stepJaws(t: Double, until: Double) {
+        val last = floor(Math.min(t, until) * FPS).toLong()
+        if (last - nextN > MAX_STEPS) nextN = last - MAX_STEPS
+        while (nextN <= last) {
+            val n = nextN
+            val ms = floor(n * 1000.0 / FPS).toLong()
+            val tt = n / FPS
+            for (i in 0 until SymbolPose.N) {
+                while (ei[i] < evN) {
+                    val k = evK[ei[i]]
+                    val at =
+                        evT[ei[i]] + (if (k == OPEN) OPEN_STAGGER * SymbolPose.RANK[i] else 0.0)
+                    if (at > tt) break
+                    when (k) {
+                        OPEN -> {
+                            r0[i].set(RING, 700.0, 0.55)
+                            kr[i].set(KR_OPEN, 700.0, 0.55)
+                        }
+                        REFUSE -> r0[i].set(RING, 900.0, 0.28, 320.0)
+                        CLOSE -> {
+                            r0[i].set(0.0, 500.0, 0.7)
+                            kr[i].set(KS, 500.0, 0.7)
+                        }
+                        BITE -> {
+                            r0[i].set(0.0, 2500.0, 0.5)
+                            kr[i].set(KS, 2500.0, 0.5)
+                        }
+                        SHIVER -> r0[i].set(0.0, 900.0, 0.3, r0[i].vel + 150)
+                    }
+                    ei[i]++
+                }
+                r0[i].step(ms - prevMs)
+                kr[i].step(ms - prevMs)
+            }
+            prevMs = ms
+            nextN = n + 1
+        }
+    }
+
+    /**
+     * Fills [pose] (and [fill], the charging gauge's) at [t] for the symbol resting at ([cx],
+     * [cy]); [alpha], [offsetX] and [offsetY] with it. [restBreath] (0..1) is the breathing when
+     * nothing here sets it (after a wake that did not drain the water). [burnIn]: the AOD
+     * offset (1.3, 4) units, which the phone's own burn-in replaces.
+     */
+    fun pose(
+        t: Double,
+        cx: Double,
+        cy: Double,
+        restBreath: Double,
+        pose: SymbolPose,
+        fill: GaugeFill,
+        burnIn: Boolean = false,
+    ) {
+        if (phase == REST && !releaseAt.isNaN() && t >= releaseAt) phase = LEAP
+        var lit = 0.75
+        var flash = 0.0
+        var breath = 0.0
+        var rot = 0.0
+        var jaws = false
+        var leapA = Double.NaN
+        alpha = 1.0
+        offsetX = 0.0
+        offsetY = 0.0
+        // what the light rises from or falls to: the rest's (0.75) or, charging, the gauge's
+        var litMode = LIT_REST
+        var litRamp = 0.0
+        when (phase) {
+            REST -> {
+                stepJaws(t, if (releaseAt.isNaN()) Double.MAX_VALUE else releaseAt)
+                jaws = true
+                val held = !touchAt.isNaN() && (failAt.isNaN() || failAt < touchAt)
+                if (held && (down || !authAt.isNaN())) {
+                    litMode = if (dark) LIT_DARK_HELD else LIT_HELD
+                    litRamp = SpringResponse.ramp(t, touchAt, touchAt + 0.15)
+                } else if (!failAt.isNaN()) {
+                    litMode = LIT_REFUSED
+                    litRamp =
+                        if (liftAt.isNaN()) 0.0 else SpringResponse.ramp(t, liftAt, liftAt + 0.5)
+                } else if (held) {
+                    // the finger left without an answer: the light goes back
+                    litMode = if (dark) LIT_DARK_BACK else LIT_BACK
+                    litRamp =
+                        SpringResponse.ramp(liftAt, touchAt, touchAt + 0.15) *
+                            (1 - SpringResponse.ramp(t, liftAt, liftAt + 0.3))
+                } else if (t < wokeAt + WAKE_LIT) {
+                    litMode = LIT_WAKE
+                    litRamp = (t - wokeAt) / WAKE_LIT
+                }
+                if (!authAt.isNaN()) flash = SpringResponse.flashTriangle(t - authAt, 0.55, 0.14)
+                breath =
+                    if (dark) 0.0
+                    else if (firstTouch.isNaN()) restBreath
+                    else {
+                        var b = 1 - SpringResponse.ramp(t, firstTouch, firstTouch + 0.15)
+                        if (!down && authAt.isNaN() && !liftAt.isNaN()) {
+                            b = Math.max(b, SpringResponse.ramp(t, liftAt + 1.5, liftAt + 2.3))
+                        }
+                        b
+                    }
+                if (!reformAt.isNaN()) alpha = SpringResponse.ramp(t, reformAt, reformAt + REFORM)
+            }
+            LEAP -> {
+                leapA = t - releaseAt
+                rot = 18 * (1 - exp(-leapA / 0.15))
+                lit = 1.0
+                litMode = LIT_FIXED
+            }
+            AOD -> {
+                lit = 0.3
+                litMode = LIT_FIXED
+                val sunk = sleepAt + RISE
+                if (floats) {
+                    alpha = if (aodShows) WakeDrain.floatAlpha(t, sunk) else 0.0
+                    offsetY = WakeDrain.floatOffset(t, sunk)
+                } else {
+                    // from the lockscreen: the light dims as the water rises under it
+                    litMode = LIT_SLEEP
+                    litRamp = SpringResponse.ramp(t, sleepAt, sleepAt + WAKE_LIT)
+                }
+                if (burnIn) {
+                    offsetX += 1.3
+                    offsetY += 4.0
+                }
+            }
+            DRAIN -> {
+                stepJaws(t, Double.MAX_VALUE)
+                jaws = true
+                val tp = drainPass
+                litMode = LIT_DRAIN
+                litRamp = SpringResponse.ramp(t, tp, tp + 0.3)
+                alpha = if (fromAod) 1.0 else SpringResponse.ramp(t, tp, tp + 0.2)
+                if (burnIn) {
+                    val q = SpringResponse.step(t - tp, 2.0, 0.7)
+                    offsetX = 1.3 * (1 - q)
+                    offsetY = 4 * (1 - q)
+                }
+                rot = 4 * SpringResponse.bob(t - tp, 3.0, 0.3)
+                breath = SpringResponse.ramp(t, tp + 0.4, tp + 1.2)
+            }
+        }
+        val bf = 1 + 0.02 * breath * sin(2 * Math.PI * t / 2.4)
+        rot += 2 * breath * sin(2 * Math.PI * t / 4.8)
+        val sway = 0.05 * breath * sin(2 * Math.PI * t / 2.4)
+        val charging = gauge.frame(t, 0.75)
+        fill.rank = -1
+        val ks = if (charging) gauge.frameScale else KS
+        val grow = ks / KS
+        val gulp = if (charging) gauge.frameGulp else 1.0
+        val bite = if (charging) gauge.frameBite else 0.0
+        if (charging) {
+            offsetY += gauge.frameLift
+            flash = Math.max(flash, gauge.frameFlash)
+        }
+        val x0 = cx + offsetX
+        val y0 = cy + offsetY
+        for (i in 0 until SymbolPose.N) {
+            val base = if (charging) gauge.frameLit[i] else 0.75
+            // the resting light, plus the sway when not charging (the gauge does not sway its light)
+            val li =
+                when (litMode) {
+                    LIT_FIXED -> lit
+                    LIT_REST -> if (charging) base else lit
+                    LIT_HELD -> if (charging) base + (1 - base) * litRamp else 0.75 + 0.25 * litRamp
+                    LIT_DARK_HELD -> 0.3 + 0.7 * litRamp
+                    LIT_REFUSED ->
+                        if (charging) 0.35 + (base - 0.35) * litRamp else 0.35 + 0.4 * litRamp
+                    LIT_BACK -> base + (1 - base) * litRamp
+                    LIT_DARK_BACK -> 0.3 + 0.7 * litRamp
+                    LIT_WAKE -> 0.3 + (base - 0.3) * litRamp
+                    LIT_SLEEP -> base + (0.3 - base) * litRamp
+                    // LIT_DRAIN
+                    else -> if (charging) 0.3 + (base - 0.3) * litRamp else 0.3 + 0.45 * litRamp
+                } + (if (charging) 0.0 else sway)
+            val ang = SymbolPose.ANGLE[i]
+            if (!leapA.isNaN()) {
+                // let go: the shards burst outward against drag and towards the eye, tumble, melt
+                val a = leapA
+                val f = 0.75 + 0.5 * (((i * 7) % 10) / 10.0)
+                val rr = SymbolPose.DIST[i] * KS + 60 * f * (1 - exp(-a / 0.11))
+                val a0 = ang + rot * Math.PI / 180
+                pose.place(
+                    i,
+                    x0,
+                    y0,
+                    KS * bf,
+                    0.0,
+                    0.0,
+                    rot,
+                    dx = cos(a0) * rr,
+                    dy = sin(a0) * rr,
+                    drot = (if (i % 2 == 1) 1 else -1) * (55 + 40 * f) * (1 - exp(-a / 0.2)),
+                    ds = 1 + 0.35 * sin(Math.PI * Math.min(1.0, a / 0.3)),
+                    op = Math.max(0.0, 1 - a / (0.24 + 0.08 * f)).pow(1.3),
+                )
+            } else {
+                val jr0 = if (jaws) r0[i].pos else 0.0
+                val jkr = if (jaws) kr[i].pos else KS
+                val rr =
+                    if (charging) ((SymbolPose.DIST[i] * jkr + jr0) * grow + bite) * bf * gulp
+                    else (SymbolPose.DIST[i] * jkr + jr0) * bf
+                val a0 = ang + rot * Math.PI / 180
+                pose.place(
+                    i,
+                    x0,
+                    y0,
+                    if (charging) ks * bf * gulp else KS * bf,
+                    0.0,
+                    0.0,
+                    rot,
+                    dx = cos(a0) * rr,
+                    dy = sin(a0) * rr,
+                    ds = if (charging) gauge.frameGulps[i] else 1.0,
+                )
+            }
+            pose.light(i, li, flash)
+        }
+        if (charging && phase != AOD && leapA.isNaN()) gauge.placeFill(t, pose, fill, rot)
+    }
+
+    companion object {
+        /** The symbol's scale on the sensor: the sensor's size. */
+        const val KS = 0.35
+        /** The jaws part to this ring offset and radius scale round the finger. */
+        const val RING = 31.0
+        const val KR_OPEN = 0.15
+        /** Round the ring from the top, 9 ms apart by rank. */
+        const val OPEN_STAGGER = 0.009
+        /** The bite holds this long before the symbol lets go, seconds. */
+        const val RELEASE = 0.14
+        /** The water rises over the screen this long, seconds (MOT-2). */
+        const val RISE = 0.55
+        /** After this long the let-go's shards have melted, seconds. */
+        const val LEAP_GONE = 0.35
+        /** The symbol is drawn above the unlock wave from this long before it lets go, seconds. */
+        const val LEAP_OVERLAY = 0.05
+        private const val SETTLE = 2.5
+        private const val REFORM = 0.3
+        private const val WAKE_LIT = 0.3
+        private const val FPS = 120.0
+        private const val MAX_STEPS = 600L
+        private const val EVENTS = 16
+
+        private const val REST = 0
+        private const val LEAP = 1
+        private const val AOD = 2
+        private const val DRAIN = 3
+
+        private const val OPEN = 1
+        private const val REFUSE = 2
+        private const val CLOSE = 3
+        private const val BITE = 4
+        private const val SHIVER = 5
+
+        private const val LIT_FIXED = 0
+        private const val LIT_REST = 1
+        private const val LIT_HELD = 2
+        private const val LIT_DARK_HELD = 3
+        private const val LIT_REFUSED = 4
+        private const val LIT_BACK = 5
+        private const val LIT_DARK_BACK = 6
+        private const val LIT_WAKE = 7
+        private const val LIT_SLEEP = 8
+        private const val LIT_DRAIN = 9
+    }
+}
