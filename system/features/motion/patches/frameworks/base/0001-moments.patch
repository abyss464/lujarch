+            if (gauge.isCharging) gauge.unplug(t)
+            awaitingWave = Double.NaN
+            removeCallbacks(lightInPlace)
+        } else if (plugged && !gauge.isCharging && !Moment.animating()) {
+            // Remove animations: the gauge the moment ends in
+            gauge.settle(t, level)
+        } else if (plugged && !gauge.isCharging) {
+            // the power came in: the wave's crest lifts the gauge; without a wave it lights in
+            // place
+            awaitingWave = t
+            removeCallbacks(lightInPlace)
+            postDelayed(lightInPlace, (Charge.WAIT * 1000).toLong())
+        } else if (plugged) {
+            gauge.setLevel(t, level)
+        } else {
+            awaitingWave = Double.NaN
+            removeCallbacks(lightInPlace)
+            gauge.unplug(t)
+        }
+        invalidate()
+    }
+
+    override fun onSwell(swell: Swell) {
+        if (awaitingWave.isNaN() || !Charge.plugged) return
+        awaitingWave = Double.NaN
+        removeCallbacks(lightInPlace)
+        // the crest reaches the symbol's lower edge: the sensor's rim below its centre
+        getLocationOnScreen(location)
+        val x = location[0] / unitPx + HALF_WIDTH
+        val y = location[1] / unitPx + UP + SENSOR_RADIUS
+        val crest = swell.passTime(x, y)
+        val lift = isLockscreenShown()
+        gauge.charge(crest, Charge.level, lift)
+        Log.i(TAG, "gauge: crest at $crest s, level ${Charge.level}, lifted $lift")
+        invalidate()
+    }
+
+    private fun chargeInPlace() {
+        if (awaitingWave.isNaN() || !Charge.plugged) return
+        awaitingWave = Double.NaN
+        gauge.charge(MotionClock.now(), Charge.level, lift = false)
+        Log.i(TAG, "gauge: no wave, lit in place, level ${Charge.level}")
+        invalidate()
+    }
+
+    private fun isLockscreenShown(): Boolean = symbolShown && !aod && MotionClock.isLit(this)
+
+    override fun onDraw(canvas: Canvas) {
+        if (!symbolShown) return
+        val t = MotionClock.now()
+        val lockscreen = isLockscreenShown()
+        // let go with the lockscreen still up (nothing unlocked after all): formed again
+        if (lockscreen && symbol.isGone(t) && t > symbol.releaseTime + REFORM_AFTER) {
+            symbol.reform(t)
+        }
+        val breath =
+            if (lockscreen) SpringResponse.ramp(t, restSince, restSince + BREATH_IN) else 0.0
+        symbol.pose(t, HALF_WIDTH, UP, breath, pose, fill)
+        rings.update(t)
+        val u = unitPx.toFloat()
+        val count = canvas.save()
+        canvas.scale(u, u)
+        // the rings of water under the shards, from the dot's edge
+        for (i in 0 until rings.count) {
+            ringPainter.drawLitRing(
+                canvas,
+                HALF_WIDTH,
+                UP,
+                rings.r[i],
+                rings.width[i],
+                rings.alpha[i],
+                rings.white[i],
+            )
+        }
+        if (rings.failAlpha > 0) {
+            ringPainter.drawRing(
+                canvas,
+                HALF_WIDTH,
+                UP,
+                rings.failR,
+                DwellRings.FAIL_WIDTH,
+                deepColor,
+                rings.failAlpha,
+            )
+        }
+        // answering a recognition with the unlock wave on its way, the symbol is drawn with the
+        // wave, above what the wave uncovers (drawOverlay)
+        if (!isOverlaid(t)) {
+            painter.draw(canvas, pose, symbol.alpha)
+            fill.draw(canvas, painter, pose, symbol.alpha)
+        }
+        canvas.restoreToCount(count)
+        if (lockscreen || symbol.isMoving(t) || rings.isMoving(t)) postInvalidateOnAnimation()
+    }
+
+    override fun drawOverlay(canvas: Canvas, t: Double): Boolean {
+        if (!symbolShown || !isOverlaid(t) || !isAttachedToWindow) return false
+        symbol.pose(t, HALF_WIDTH, UP, 0.0, pose, fill)
+        getLocationOnScreen(location)
+        val u = unitPx.toFloat()
+        val count = canvas.save()
+        canvas.translate(location[0].toFloat(), location[1].toFloat())
+        canvas.scale(u, u)
+        painter.draw(canvas, pose, symbol.alpha)
+        canvas.restoreToCount(count)
+        return true
+    }
+
+    companion object {
+        private const val TAG = "lujarch_motion"
+        /**
+         * The view's extent round the sensor's centre, units: the refusal's ring (120), the gauge's
+         * lift and growth (up 185) fit.
+         */
+        const val HALF_WIDTH = 124.0
+        const val UP = 195.0
+        const val DOWN = 124.0
+        /** The sensor's radius, units: the symbol's lower edge rests on its rim. */
+        private const val SENSOR_RADIUS = 35.0
+        /** The breathing comes back over this long after a wake, seconds. */
+        private const val BREATH_IN = 0.8
+        /** A symbol let go with the lockscreen still showing forms again after this long. */
+        private const val REFORM_AFTER = 1.2
+    }
+}
