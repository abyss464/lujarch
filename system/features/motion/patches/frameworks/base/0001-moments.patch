+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.surfaceeffects.lujarch
+
+import android.graphics.Canvas
+import kotlin.math.exp
+import kotlin.math.hypot
+import kotlin.math.pow
+import kotlin.math.sqrt
+
+/**
+ * The lockscreen and fingerprint moment's events (MOT-2), where the views
+ * that answer them hear them, in SystemUI's process: a finger on the sensor, the matcher's answer,
+ * the screen going off and waking. AuthRippleController reports the fingerprint's events and the
+ * screen's; the symbol on the sensor, the unlock wave, the clock, the date and the status icons
+ * listen. Times are seconds on the frame clock. Main thread only.
+ */
+object Entry {
+    /** A finger landed on the sensor; arg 1 when the screen was dark (AOD or off). */
+    const val TOUCH = 1
+    /** The finger left the sensor. */
+    const val LIFT = 2
+    /** The matcher refused the finger. */
+    const val FAIL = 3
+    /** The finger was recognised: the symbol bites, lets go, and the unlock wave follows. */
+    const val AUTH = 4
+    /** The screen began to go off; arg 1 when it went off from an unlocked phone. */
+    const val SLEEP = 5
+    /** The screen began to wake; arg 1 when the power key woke it (the water drains). */
+    const val WAKE = 6
+    /**
+     * The unlock wave's front: arg 0, a recognition's wave waits for what it uncovers (t: the
+     * earliest it may leave, [holdFront]); arg 1, it leaves at t ([releaseFront]).
+     */
+    const val FRONT = 7
+
+    interface Listener {
+        fun onEntry(event: Int, t: Double, arg: Int)
+    }
+
+    /**
+     * Something drawn above the unlock wave (the symbol's bite and let-go): the wave uncovers the
+     * home screen inside its circle, where the lockscreen's own views are cut away, so what must
+     * stay visible over the home screen is drawn with the wave.
+     */
+    interface Overlay {
+        /** Draws at [t] on the screen-sized [canvas]; false when there is nothing to draw. */
+        fun drawOverlay(canvas: Canvas, t: Double): Boolean
+    }
+
+    /** The overlay the unlock wave draws above itself, or null. */
+    @JvmStatic var overlay: Overlay? = null
+
+    private val listeners = ArrayList<Listener>()
+
+    /** The latest unlock wave front, or null. */
+    @JvmStatic
+    var front: SensorFront? = null
+        private set
+
+    /** When the finger was last recognised, or NaN. */
+    @JvmStatic
+    var lastAuth = Double.NaN
+        private set
+
+    /**
+     * True while the unlock wave carries the lockscreen away (from the bite while the wave waits
+     * for what it uncovers, until the wave has uncovered the screen): the lockscreen's views are
+     * cut by its circle instead of fading.
+     */
+    @JvmStatic
+    fun isUnlocking(t: Double): Boolean =
+        (!lastAuth.isNaN() && t - lastAuth in 0.0..UNLOCK_HOLD) || holdsLockscreen(t)
+
+    /** From the bite, how long the lockscreen waits for the wave, seconds. */
+    const val UNLOCK_HOLD = 1.0
+
+    /**
+     * How long past its time a recognition's wave waits at most for the surface behind the
+     * keyguard, seconds; then it leaves without it (whoever holds it releases it).
+     */
+    const val FRONT_WAIT = 1.5
+
+    /** A wave still waiting this long after [FRONT_WAIT] was left by its holder: it is dropped. */
+    private const val FRONT_EXPIRY = 0.5
+
+    /**
+     * True while the unlock wave holds the lockscreen whole where its circle has not reached: it
+     * waits for the surface behind the keyguard, or its circle has not yet covered the screen.
+     */
+    @JvmStatic fun holdsLockscreen(t: Double): Boolean = t < lockscreenHeldUntil()
+
+    /** Until when the latest unlock wave holds the lockscreen ([holdsLockscreen]), or -inf. */
+    @JvmStatic
+    fun lockscreenHeldUntil(): Double {
+        val f = front ?: return Double.NEGATIVE_INFINITY
+        return if (f.isHeld) f.planned + FRONT_WAIT + FRONT_EXPIRY
+        else f.start + SensorFront.DURATION
+    }
+
+    /** When the latest power wake began to drain the water, or NaN. */
+    @JvmStatic
+    var drainStart = Double.NaN
+        private set
+
+    /** Whether AOD showed before the latest wake (the water drains off AOD, not off black). */
+    @JvmStatic
+    var wokeFromAod = true
+        private set
+
+    @JvmStatic
+    fun addListener(l: Listener) {
+        if (!listeners.contains(l)) listeners.add(l)
+    }
+
+    @JvmStatic
+    fun removeListener(l: Listener) {
+        listeners.remove(l)
+    }
+
+    /** Tells every listener of [event] at [t]. */
+    @JvmStatic
+    fun post(event: Int, t: Double, arg: Int = 0) {
+        if (event == WAKE && arg == 1) drainStart = t + WakeDrain.DEBOUNCE
+        if (event == AUTH) lastAuth = t
+        if (event == SLEEP) {
+            lastAuth = Double.NaN
+            // the screen went off before anything came to uncover: no wave
+            if (front?.isHeld == true) front = null
+        }
+        for (l in listeners.toTypedArray()) l.onEntry(event, t, arg)
+    }
+
+    /** The wake that follows drains the water off AOD ([aod]) or off a black screen. */
+    @JvmStatic
+    fun setWokeFromAod(aod: Boolean) {
+        wokeFromAod = aod
+    }
+
+    /**
+     * A recognition's unlock wave that waits for what it uncovers (the surface behind the
+     * keyguard): [f] ([SensorFront.held]) leaves when [releaseFront] says it is there, no earlier
+     * than [SensorFront.planned]. Until then the lockscreen stays whole and the symbol holds its
+     * bite.
+     */
+    @JvmStatic
+    fun holdFront(f: SensorFront) {
+        front = f
+        post(FRONT, f.planned, 0)
+    }
+
+    /**
+     * What the waiting wave uncovers is there at [t]: its front leaves at [t], or at its planned
+     * time if that is later. Returns the front, or null when no wave waits.
+     */
+    @JvmStatic
+    fun releaseFront(t: Double): SensorFront? {
+        val f = front ?: return null
+        if (!f.isHeld) return null
+        f.leave(t)
+        post(FRONT, f.start, 1)
+        return f
+    }
+
+    /**
+     * The unlock wave whose front is still on the screen at [t], or waits to leave, or null.
+     */
+    @JvmStatic
+    fun activeFront(t: Double): SensorFront? {
+        val f = front ?: return null
+        if (f.isHeld) return if (t < f.planned + FRONT_WAIT + FRONT_EXPIRY) f else null
+        return if (t >= f.start - 0.5 && t < f.end) f else null
+    }
+
+    /** Forgets everything (tests). */
+    @JvmStatic
+    fun reset() {
+        listeners.clear()
+        front = null
+        lastAuth = Double.NaN
+        drainStart = Double.NaN
+        wokeFromAod = true
+    }
+}
+
+/**
+ * The unlock wave (MOT-2): a lit wave front leaving the sensor's edge [LEAD]
+ * before the symbol lets go, `R = 35 + 745 (1 - (1 - u)^2.6)` over [DURATION], its rings drawn only
+ * beyond the sensor. Inside it the home screen, outside it the lockscreen (or the dark, from AOD).
+ * As the crest passes, each digit is pushed outward by 9 g and swallowed (it fades and shrinks by
+ * 12 %), and the date fades. Lengths in artboard units ([unitPx] px each), times seconds.
+ *
+ * A recognition's wave may wait for what it uncovers ([held], [Entry.holdFront]): until it leaves,
+ * [start] is +inf, so it is still on the sensor at any time; it then leaves at [planned] or later.
+ */
+class SensorFront(
+    start: Double,
+    @JvmField val cx: Double,
+    @JvmField val cy: Double,
+    @JvmField val unitPx: Double = 3.0,
+) {
+    /** The earliest the front leaves: the design's time, [LEAD] before the symbol lets go. */
+    @JvmField val planned: Double = start
+
+    /** When the front leaves the sensor's edge; +inf while it waits ([isHeld]). */
+    var start: Double = start
+        private set
+
+    /** When the front has faded out. */
+    val end: Double
+        get() = start + DURATION + TAIL
+
+    /** True while the front waits for what it uncovers. */
+    val isHeld: Boolean
+        get() = start == Double.POSITIVE_INFINITY
+
+    /** The front leaves at [t], or at [planned] if that is later ([Entry.releaseFront]). */
+    internal fun leave(t: Double) {
+        start = Math.max(planned, t)
+    }
+
+    fun radius(t: Double): Double {
+        if (t <= start) return R0
+        val u = SpringResponse.ramp(t, start, start + DURATION)
+        return R0 + (R_END - R0) * (1 - (1 - u).pow(2.6))
+    }
+
+    /** When the crest reaches ([x], [y]). */
+    fun passTime(x: Double, y: Double): Double {
+        val d = hypot(x - cx, y - cy)
+        if (d <= R0) return start
+        val q = (d - R0) / (R_END - R0)
+        return if (q >= 1) start + DURATION else start + DURATION * (1 - (1 - q).pow(1 / 2.6))
+    }
+
+    /**
+     * The home screen's circle at [t]; past the front's run everything is home
+     * ([Double.MAX_VALUE]).
+     */
+    fun reveal(t: Double): Double = if (t < start + DURATION) radius(t) else Double.MAX_VALUE
+
+    /**
+     * The scale of what the wave uncovers at [t], about the sensor: it grows from 0.8 on
+     * stepR(2.4 Hz, 0.5) from the front's start (the home icons' bloom, 1.3), overshooting past 1
+     * and settling on it.
+     */
+    fun grow(t: Double): Double = 0.8 + 0.2 * SpringResponse.step(t - start, 2.4, 0.5)
+
+    /**
+     * True when at [t] what the wave uncovers, grown about the sensor ([grow]) and cut to the
+     * circle ([reveal]), covers the whole [widthPx] x [heightPx] screen, so that nothing under it
+     * shows anywhere: the circle holds every corner, and the uncovered surface is at least its
+     * full size (smaller, grown about a point inside the screen, it leaves the screen's edges).
+     */
+    fun coversScreen(t: Double, widthPx: Double, heightPx: Double): Boolean {
+        if (t < start || grow(t) < 1.0) return false
+        val r = reveal(t)
+        if (r == Double.MAX_VALUE) return true
+        val w = widthPx / unitPx
+        val h = heightPx / unitPx
+        return hypot(cx, cy) <= r &&
+            hypot(w - cx, cy) <= r &&
+            hypot(cx, h - cy) <= r &&
+            hypot(w - cx, h - cy) <= r
+    }
+
+    /** Sets [out] to the front at [t], or hides it outside its life. */
+    fun front(out: WaveFront, t: Double) {
+        if (t < start || t >= end) {
+            out.hide()
+            return
+        }
+        val a = t - start
+        val u = Math.min(1.0, a / DURATION)
+        val r = radius(t)
+        val tail = 1 - SpringResponse.ramp(a, DURATION, DURATION + TAIL)
+        out.set(cx, cy, r, u, WaveFront.amplitude(A0, u, r, tail), R0, t)
+    }
+
+    /**
+     * A digit centred at ([x], [y]) at [t]: pushed 9 g outward, g = exp(-((R - d + 14) / 26)^2),
+     * and swallowed by s = ramp(R, d - 6, d + 30). [out] gets the push (units), the opacity factor
+     * (1-s) and the scale (1-0.12s).
+     */
+    fun swallow(x: Double, y: Double, t: Double, out: DoubleArray) {
+        val r = radius(t)
+        val d = hypot(x - cx, y - cy)
+        val g = exp(-((r - d + 14) / 26).pow(2))
+        out[0] = 9 * g * (x - cx) / d
+        out[1] = 9 * g * (y - cy) / d
+        val s = SpringResponse.ramp(r, d - 6, d + 30)
+        out[2] = 1 - s
+        out[3] = 1 - 0.12 * s
+    }
+
+    /** What the crest leaves of the date centred at ([x], [y]): 1 - ramp(R, d - 6, d + 30). */
+    fun fade(x: Double, y: Double, t: Double): Double =
+        1 - SpringResponse.ramp(radius(t), hypot(x - cx, y - cy) - 6, hypot(x - cx, y - cy) + 30)
+
+    companion object {
+        /**
+         * A front that waits for what it uncovers, to leave no earlier than [planned]
+         * ([Entry.holdFront]).
+         */
+        @JvmStatic
+        fun held(planned: Double, cx: Double, cy: Double, unitPx: Double): SensorFront =
+            SensorFront(planned, cx, cy, unitPx).apply { start = Double.POSITIVE_INFINITY }
+
+        /** The front leaves this long before the symbol lets go, seconds. */
+        const val LEAD = 0.02
+        const val DURATION = 0.72
+        const val TAIL = 0.3
+        /** The sensor's radius: the front leaves its edge. */
+        const val R0 = 35.0
+        const val R_END = 780.0
+        const val A0 = 0.55
+    }
+}
+
+/**
+ * The rings of water the finger raises on the sensor (MOT-2): while it rests,
+ * one leaves the white dot's edge every 240 ms from 50 ms after the touch, `r = 35 + 75 (1 -
+ * e^(-a/0.42))`, width max(0.5, 1.8 - a), opacity 0.55 e^(-a/0.45) sqrt(35 / r), each for 1.3 s,
+ * with the lit stroke (white on the dark screen); a refusal raises one dull ring (DEEP, width 2.4)
+ * over 500 ms. [update] fills the rings at a time, oldest touch first, at most [MAX] of them.
+ */
+class DwellRings {
+    private val down = DoubleArray(TOUCHES)
+    private val end = DoubleArray(TOUCHES)
+    private val dark = BooleanArray(TOUCHES)
+    private var touches = 0
+    private var failAt = Double.NaN
+
+    @JvmField val r = DoubleArray(MAX)
+    @JvmField val width = DoubleArray(MAX)
+    @JvmField val alpha = DoubleArray(MAX)
+    @JvmField val white = BooleanArray(MAX)
+    @JvmField var count = 0
+    @JvmField var failR = 0.0
+    @JvmField var failAlpha = 0.0
+
+    /** A finger landed at [t] (on the dark screen: [dark]). */
+    fun touch(t: Double, dark: Boolean) {
+        if (touches == TOUCHES) {
+            System.arraycopy(down, 1, down, 0, TOUCHES - 1)
+            System.arraycopy(end, 1, end, 0, TOUCHES - 1)
+            System.arraycopy(this.dark, 1, this.dark, 0, TOUCHES - 1)
+            touches--
+        }
+        down[touches] = t
+        end[touches] = Double.POSITIVE_INFINITY
+        this.dark[touches] = dark
+        touches++
+    }
+
+    /** The resting finger's rings stop at [t]: the matcher answered, or the finger left. */
+    fun stop(t: Double) {
+        if (touches > 0 && end[touches - 1] > t) end[touches - 1] = t
+    }
+
+    /** The matcher refused the finger at [t]. */
+    fun fail(t: Double) {
+        stop(t)
+        failAt = t
+    }
+
+    /** True while a ring is on the sensor at [t]. */
+    fun isMoving(t: Double): Boolean {
+        if (t < failAt + FAIL_LIFE) return true
+        if (touches == 0) return false
+        val last = touches - 1
+        return end[last] == Double.POSITIVE_INFINITY || t < end[last] + LIFE
+    }
+
+    fun update(t: Double) {
+        count = 0
+        for (k in 0 until touches) {
+            var te = down[k] + 0.05
+            while (te < end[k] && te <= t) {
+                val a = t - te
+                if (a >= 0 && a < LIFE && count < MAX) {
+                    val rr = 35 + 75 * (1 - exp(-a / 0.42))
+                    r[count] = rr
+                    width[count] = Math.max(0.5, 1.8 - a)
+                    alpha[count] = 0.55 * exp(-a / 0.45) * sqrt(35 / rr)
+                    white[count] = dark[k]
+                    count++
+                }
+                te += 0.24
+            }
+        }
+        failAlpha = 0.0
+        if (t >= failAt && t < failAt + FAIL_LIFE) {
+            val u = (t - failAt) / FAIL_LIFE
+            failR = 35 + 85 * (1 - (1 - u).pow(3))
+            failAlpha = 0.6 * (1 - u)
+        }
+    }
+
+    companion object {
+        const val MAX = 6
+        const val LIFE = 1.3
+        const val FAIL_LIFE = 0.5
+        const val FAIL_WIDTH = 2.4
+        private const val TOUCHES = 4
+    }
+}
+
+/**
+ * What the draining water frees on a power wake (MOT-2), each at the moment the
+ * mean level passes its centre ([pass]). The status icons fade in over 120 ms and rise by -3
+ * bob(2.4 Hz, 0.45). The date goes from 0.7 to 1 over 300 ms (from black it fades in over 180 ms)
+ * and rises the same. Each digit fills from the AOD axes to the lockscreen's over 450 ms on the
+ * emphasized curve, rises by -5 bob(2.2 Hz, 0.42) and from black fades in over 180 ms. AOD content
+ * floats up from under the water on a buoyant spring (1.6).
+ */
+object WakeDrain {
+    /** When the draining water passes [y] (units), for a drain that began at [drainStart]. */
+    @JvmStatic fun pass(drainStart: Double, y: Double): Double = drainStart + Waterline.drainPass(y)
+
+    @JvmStatic
+    fun statusAlpha(t: Double, pass: Double): Double = SpringResponse.ramp(t, pass, pass + 0.12)
+
+    @JvmStatic
+    fun statusRise(t: Double, pass: Double): Double = -3 * SpringResponse.bob(t - pass, 2.4, 0.45)
+
+    @JvmStatic
+    fun dateAlpha(t: Double, pass: Double, fromAod: Boolean): Double =
+        if (fromAod) 0.7 + 0.3 * SpringResponse.ramp(t, pass, pass + 0.3)
+        else SpringResponse.ramp(t, pass, pass + 0.18)
+
+    @JvmStatic
+    fun dateRise(t: Double, pass: Double): Double = -3 * SpringResponse.bob(t - pass, 2.4, 0.45)
+
+    /** How far a digit still is from the lockscreen's axes towards AOD's (1 AOD, 0 lockscreen). */
+    @JvmStatic
+    fun digitAod(t: Double, pass: Double, fromAod: Boolean): Double =
+        if (fromAod) 1 - Curves.emphasized(SpringResponse.ramp(t, pass, pass + DIGIT_FILL)) else 0.0
+
+    @JvmStatic
+    fun digitAlpha(t: Double, pass: Double, fromAod: Boolean): Double =
+        if (fromAod) 1.0 else SpringResponse.ramp(t, pass, pass + 0.18)
+
+    @JvmStatic
+    fun digitRise(t: Double, pass: Double): Double = -5 * SpringResponse.bob(t - pass, 2.2, 0.42)
+
+    /** AOD content floats up from under the water: 36 units times 1 - step(1.5 Hz, 0.6). */
+    @JvmStatic
+    fun floatOffset(t: Double, sunk: Double): Double =
+        36 * (1 - SpringResponse.step(t - sunk, 1.5, 0.6))
+
+    /** ... and its opacity rises over 400 ms. */
+    @JvmStatic
+    fun floatAlpha(t: Double, sunk: Double): Double = SpringResponse.ramp(t, sunk, sunk + 0.4)
+
+    /** A digit's fill from AOD to the lockscreen, seconds. */
+    const val DIGIT_FILL = 0.45
+    /** The water starts to drain this long after the press (the native wake debounce), seconds. */
+    const val DEBOUNCE = 0.05
+}
+
+/** Material's curves, computed the same way every frame. */
+object Curves {
+    /**
+     * Material's emphasized curve: two cubics, (0, 0)-(0.166666, 0.4) with (0.05, 0), (0.133333,
+     * 0.06), then to (1, 1) with (0.208333, 0.82), (0.25, 1), solved for x by bisection
+     * (as PathInterpolator's table gives it).
+     */
+    @JvmStatic
+    fun emphasized(x: Double): Double {
+        if (x <= 0) return 0.0
+        if (x >= 1) return 1.0
+        val seg2 = x > 0.166666
+        val p0 = if (seg2) 0.166666 else 0.0
+        val p1 = if (seg2) 0.208333 else 0.05
+        val p2 = if (seg2) 0.25 else 0.133333
+        val p3 = if (seg2) 1.0 else 0.166666
+        val q0 = if (seg2) 0.4 else 0.0
+        val q1 = if (seg2) 0.82 else 0.0
+        val q2 = if (seg2) 1.0 else 0.06
+        val q3 = if (seg2) 1.0 else 0.4
+        var lo = 0.0
+        var hi = 1.0
+        var s = 0.5
+        for (i in 0 until 40) {
+            s = (lo + hi) / 2
+            if (cubic(p0, p1, p2, p3, s) < x) lo = s else hi = s
+        }
+        return cubic(q0, q1, q2, q3, s)
+    }
+
+    private fun cubic(p0: Double, p1: Double, p2: Double, p3: Double, s: Double): Double {
+        val m = 1 - s
+        return m * m * m * p0 + 3 * m * m * s * p1 + 3 * m * s * s * p2 + s * s * s * p3
+    }
+}
