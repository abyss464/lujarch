+package com.android.systemui.decor
+
+import android.content.Context
+import android.view.DisplayCutout
+import android.view.DisplayInfo
+import android.view.Gravity
+import android.view.Surface
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import com.android.systemui.statusbar.events.PrivacyWatcherView
+
+/**
+ * Lujarch (MOT-5): the privacy indicator round the camera
+ * ([PrivacyWatcherView]) in the overlay on the camera cutout's side, for a display with one cutout
+ * on its natural top edge and the privacy dot enabled ([dotFactory]). Without that the stock chip
+ * and dot stay.
+ */
+class PrivacyWatcherDecorProviderFactory(
+    private val context: Context,
+    private val dotFactory: DecorProviderFactory,
+) : DecorProviderFactory {
+    private val displayInfo = DisplayInfo()
+
+    override val hasProviders: Boolean
+        get() {
+            if (!dotFactory.hasProviders) return false
+            val display = context.display ?: return false
+            display.getDisplayInfo(displayInfo)
+            val bounds = displayInfo.displayCutout?.getBoundBaseOnCurrentRotation() ?: return false
+            return bounds.size == 1 &&
+                bounds[0].baseOnRotation0(displayInfo.rotation) == DisplayCutout.BOUNDS_POSITION_TOP
+        }
+
+    override val providers: List<DecorProvider>
+        get() = if (hasProviders) listOf(PrivacyWatcherDecorProvider) else emptyList()
+}
+
+/** The watcher's view on the natural top bound, laid out along the edge the camera is on. */
+object PrivacyWatcherDecorProvider : BoundDecorProvider() {
+    override val alignedBound: Int = DisplayCutout.BOUNDS_POSITION_TOP
+    override val viewId: Int = PrivacyWatcherView.VIEW_ID
+
+    override fun onReloadResAndMeasure(
+        view: View,
+        reloadToken: Int,
+        @Surface.Rotation rotation: Int,
+        tintColor: Int,
+        displayUniqueId: String?,
+    ) {
+        (view.layoutParams as FrameLayout.LayoutParams).let {
+            updateLayoutParams(it, rotation)
+            view.layoutParams = it
+        }
+        (view as? PrivacyWatcherView)?.updateCutout()
+    }
+
+    override fun inflateView(
+        context: Context,
+        parent: ViewGroup,
+        @Surface.Rotation rotation: Int,
+        tintColor: Int,
+    ): View {
+        val view = PrivacyWatcherView(context)
+        view.id = viewId
+        val lp =
+            FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+            )
+        updateLayoutParams(lp, rotation)
+        parent.addView(view, lp)
+        return view
+    }
+
+    // Along the camera's edge the view spans the screen; across it, the view measures what the
+    // symbol and the glyphs need (PrivacyWatcherView.onMeasure). The natural top edge is on the
+    // left at ROTATION_90, at the bottom at ROTATION_180 and on the right at ROTATION_270, as for
+    // the face scanning overlay.
+    private fun updateLayoutParams(lp: FrameLayout.LayoutParams, @Surface.Rotation rotation: Int) {
+        when (rotation) {
+            Surface.ROTATION_90,
+            Surface.ROTATION_270 -> {
+                lp.width = ViewGroup.LayoutParams.WRAP_CONTENT
+                lp.height = ViewGroup.LayoutParams.MATCH_PARENT
+            }
+            else -> {
+                lp.width = ViewGroup.LayoutParams.MATCH_PARENT
+                lp.height = ViewGroup.LayoutParams.WRAP_CONTENT
+            }
+        }
+        lp.gravity =
+            when (rotation) {
+                Surface.ROTATION_90 -> Gravity.LEFT or Gravity.START
+                Surface.ROTATION_180 -> Gravity.BOTTOM or Gravity.END
+                Surface.ROTATION_270 -> Gravity.RIGHT or Gravity.END
+                else -> Gravity.TOP or Gravity.START
+            }
+    }
+}
