+/**
+ * The privacy indicator (MOT-5): the symbol opens round the camera. At its
+ * lockscreen size (0.35) the symbol's empty centre (13.81 units) holds the camera hole (11.33), so
+ * the camera becomes the symbol's eye.
+ * - [open]: an app starts sensing (after the scheduler's native debounce). The ten shards rise out
+ *   of the hole's rim clockwise from the top, 30 ms apart, the ring turning into place, in the
+ *   privacy green lit by the key light; the sensor's glyph comes in 44 units right of the hole.
+ * - [settle]: the native chip's 3 s are over. With a persistent indicator the shards shrink to a
+ *   ring of small teeth round the camera and the glyph fades; without one they sink into the hole.
+ * - [close]: the access stopped: the teeth sink into the hole, 20 ms apart.
+ * - [teeth]: the persistent indicator without the chip's moment (the scheduler's path when an event
+ *   is not animated): the shards rise straight into teeth.
+ * - [open] with `empty` (Lujarch Channels answered the access with empty data): the symbol opens in
+ *   its own seed colour and bites shut into the hole, swallowing the glyph; nothing stays.
+ *
+ * Every value is a closed form of the time since each event, so a frame depends only on the frame
+ * time and the events' times. Times are seconds on one clock; positions are artboard units round the
+ * camera centre given to [update]. [update] allocates nothing.
+ */
+class PrivacyWatcher(light: SymbolLight = SymbolLight()) {
+    /** The ten shards, placed and coloured by [update]. */
+    @JvmField val pose = SymbolPose(light)
+
+    /** Whether the symbol is drawn at all: from the opening on. */
+    @JvmField var shown = false
+
+    /**
+     * The glyph's reach: the first glyph's centre sits `44 * reach` units right of the camera
+     * centre (1, pulled to 0 into the hole by the bite).
+     */
+    @JvmField var glyphReach = 1.0
+
+    /** The glyph's size relative to [GLYPH_UNITS] (0.6 growing to 1 on a spring). */
+    @JvmField var glyphScale = 0.6
+
+    /** The glyph's opacity. */
+    @JvmField var glyphAlpha = 0.0
+
+    /** The shards' base colour while live: the privacy green (the native chip's colour). */
+    @JvmField var liveColor = PRIVACY_GREEN
+
+    private var t0 = Double.NaN
+    private var t1 = Double.NaN
+    private var stop = Double.NaN
+    private var persistent = true
+    /**
+     * Whether the access was answered with empty data: the symbol bites shut instead of staying.
+     */
+    var empty = false
+        private set
+
+    /** An app started sensing at [timeSec] (T0: after the scheduler's debounce). */
+    fun open(timeSec: Double, empty: Boolean = false) {
+        t0 = timeSec
+        t1 = Double.NaN
+        stop = Double.NaN
+        persistent = true
+        this.empty = empty
+    }
+
+    /**
+     * The chip's time is over at [timeSec] (T1): with [persistent] the shards become the teeth,
+     * otherwise (the access stopped meanwhile) they sink into the hole from here.
+     */
+    fun settle(timeSec: Double, persistent: Boolean) {
+        if (t0.isNaN() || empty || !t1.isNaN()) return
+        t1 = timeSec
+        this.persistent = persistent
+        if (!persistent) stop = timeSec
+    }
+
+    /**
+     * The persistent indicator at [timeSec] without the chip's moment: the shards rise straight
+     * into the teeth (the opening with a chip time of zero). Nothing changes if the teeth are
+     * already there or on their way.
+     */
+    fun teeth(timeSec: Double) {
+        if (!t0.isNaN() && !empty && stop.isNaN() && (t1.isNaN() || persistent)) return
+        open(timeSec)
+        t1 = timeSec
+    }
+
+    /** The access stopped at [timeSec] (STOP): the teeth sink into the hole. */
+    fun close(timeSec: Double) {
+        if (t0.isNaN() || empty || !stop.isNaN()) return
+        if (t1.isNaN()) {
+            settle(timeSec, persistent = false)
+        } else {
+            stop = timeSec
+        }
+    }
+
+    /** Nothing is shown. */
+    fun reset() {
+        t0 = Double.NaN
+        t1 = Double.NaN
+        stop = Double.NaN
+        shown = false
+        glyphAlpha = 0.0
+    }
+
+    /** Whether the teeth stay (or are on their way) at [timeSec]: the persistent indicator. */
+    fun isPersistent(timeSec: Double): Boolean =
+        !t0.isNaN() && !empty && persistent && stop.isNaN() && !t1.isNaN() && timeSec >= t1
+
+    /**
+     * Whether nothing is left to draw at [timeSec]: with nothing opened, after the bite (empty), or
+     * once the shards have sunk into the hole (what the springs' last undershoot leaves is shards
+     * under 0.05 units at under 0.003 opacity, less than half a level on any pixel).
+     */
+    fun isGone(timeSec: Double): Boolean {
+        if (t0.isNaN()) return true
+        val gone = goneTime()
+        return !gone.isNaN() && timeSec >= gone
+    }
+
+    /**
+     * When nothing will be left to draw, seconds: the end of the bite or of the sink; NaN while
+     * nothing is open or while the indicator stays.
+     */
+    fun goneTime(): Double =
+        when {
+            t0.isNaN() -> Double.NaN
+            empty -> t0 + BITE_DELAY + BITE_FADE_END
+            !stop.isNaN() -> stop + SINK_DONE
+            else -> Double.NaN
+        }
+
+    /**
+     * Whether a frame at [timeSec] still differs from the resting frame: the springs are within
+     * 0.002 units and the colours are exact after the horizons below, so a view can stop asking for
+     * frames and keep the last one.
+     */
+    fun isMoving(timeSec: Double): Boolean {
+        if (t0.isNaN()) return false
+        // a frame timed before the opening (its vsync came before the event): the opening is ahead
+        if (timeSec < t0) return true
+        if (isGone(timeSec)) return false
+        if (!stop.isNaN()) return true
+        if (!t1.isNaN()) return timeSec < t1 + SETTLE_DONE || timeSec < t0 + OPEN_DONE
+        return timeSec < t0 + (if (empty) BITE_DELAY + BITE_FADE_END else OPEN_DONE)
+    }
+
+    /**
+     * Poses the shards and the glyph at [timeSec] round the camera centre ([cx], [cy]) in artboard
+     * units.
+     */
+    fun update(timeSec: Double, cx: Double, cy: Double) {
+        val t = timeSec
+        shown = !t0.isNaN() && t >= t0
+        if (!shown) {
+            glyphAlpha = 0.0
+            return
+        }
+        val tBite = t0 + BITE_DELAY
+        // the ring turns into place as it opens
+        val turn = -24 * (1 - SpringResponse.step(t - t0, 2.2, 0.6))
+        val settled = !t1.isNaN() && t >= t1
+        val lit =
+            if (empty) 1.0 else if (settled) 1 - 0.3 * SpringResponse.ramp(t, t1, t1 + 0.4) else 1.0
+        val fl =
+            if (empty) SpringResponse.flash(t - tBite, 0.5, 0.14)
+            else SpringResponse.flash(t - (t0 + 0.35), 0.5, 0.14)
+        val dim = 0.55 + 0.45 * lit
+        for (i in 0 until SymbolPose.N) {
+            // rise out of the hole's rim: ring radius and size on springs, 30 ms apart round the
+            // ring
+            val ti = t0 + 0.03 * RANK[i]
+            val rise = SpringResponse.step(t - ti, 3.2, 0.55)
+            val grow = SpringResponse.step(t - ti, 3.6, 0.6)
+            var kr = 0.12 + (KS - 0.12) * rise
+            var ks = KS * grow
+            var op = SpringResponse.ramp(t, ti, ti + 0.08)
+            if (!empty && settled && persistent) {
+                // shrink to the ring of teeth: the persistent indicator
+                val q = SpringResponse.step(t - t1, 2.4, 0.7)
+                kr += (0.28 - KS) * q
+                ks += (0.16 - KS) * q
+            }
+            if (empty && t >= tBite) {
+                // bite shut into the hole (the lockscreen's 2500 / 0.5 snap), fading
+                val q = Math.min(1.15, SpringResponse.step(t - tBite, 50 / (2 * Math.PI), 0.5))
+                kr += (0.1 - KS) * q
+                ks *= 1 - 0.35 * q
+                op *= 1 - SpringResponse.ramp(t, tBite + 0.12, tBite + BITE_FADE_END)
+            }
+            if (!empty && !stop.isNaN() && t >= stop) {
+                // sink into the hole, 20 ms apart
+                val q = SpringResponse.step(t - stop - 0.02 * RANK[i], 2.6, 0.75)
+                kr += (0.1 - kr) * q
+                ks *= 1 - Math.min(1.0, q)
+                op *= 1 - SpringResponse.ramp(q, 0.6, 1.0)
+            }
+            ks = Math.max(0.0, ks)
+            val a0 = ANGLE[i] + turn * Math.PI / 180
+            val rr = DIST[i] * kr
+            pose.place(
+                i,
+                cx,
+                cy,
+                KS,
+                0.0,
+                0.0,
+                turn,
+                dx = cos(a0) * rr,
+                dy = sin(a0) * rr,
+                ds = ks / KS,
+                op = op,
+            )
+            if (empty) {
+                pose.light(i, lit, fl)
+            } else {
+                pose.lightWithBase(i, liveColor, fl, dim)
+            }
+        }
+        // the sensor's glyph beside the symbol for the chip's time; swallowed with the bite (empty)
+        val gIn = SpringResponse.step(t - (t0 + 0.2), 2.6, 0.55)
+        var reach = 1.0
+        var gOp = if (t >= t0 + 0.2) SpringResponse.ramp(t, t0 + 0.2, t0 + 0.32) else 0.0
+        var gs = 0.6 + 0.4 * gIn
+        if (!empty) {
+            if (!t1.isNaN()) gOp *= 1 - SpringResponse.ramp(t, t1, t1 + 0.15)
+        } else if (t >= tBite) {
+            val q = SpringResponse.step(t - tBite, 4.0, 0.8)
+            reach = 1 - q
+            gs *= 1 - 0.8 * q
+            gOp *= 1 - SpringResponse.ramp(t, tBite + 0.1, tBite + 0.25)
+        }
+        glyphReach = reach
+        glyphScale = gs
+        glyphAlpha = gOp
+    }
+
+    companion object {
+        /** The symbol's scale round the camera: its lockscreen size. */
+        const val KS = 0.35
+        /** The camera hole's radius the symbol is drawn round, units (34 px at 3 px per unit). */
+        const val CAMERA_RADIUS = 34.0 / 3
+        /** How far right of the camera centre the glyph sits, units. */
+        const val GLYPH_REACH = 44.0
+        /** The glyph's size at scale 1, units: a 24-unit icon at 0.5833 (16 dp). */
+        const val GLYPH_UNITS = 24 * 0.5833
+        /** The native privacy chip's green (privacy_chip_background). */
+        const val PRIVACY_GREEN = 0xff3ddc84.toInt()
+        /**
+         * How far the drawing reaches from the camera centre, units: the ring at its springs'
+         * overshoot (below 40) with room to spare.
+         */
+        const val RING_EXTENT = 45.0
+
+        private const val BITE_DELAY = 0.55
+        private const val BITE_FADE_END = 0.3
+        // After these the springs are within 0.002 units of rest and every colour is exact
+        // (checked against the model's resting frame in PrivacyWatcherTest).
+        private const val OPEN_DONE = 1.6
+        private const val SETTLE_DONE = 1.0
+        // the last shard (rank 9) starts 0.18 s after the stop; its step response reaches 1 at
+        // 0.224 s (2.6 Hz, 0.75), where its opacity is 0
+        private const val SINK_DONE = 0.45
+
+        // Each shard's direction and distance from the symbol's centre and its rank clockwise from
+        // the top, as SymbolPose defines them. Computed here with plain loops rather than read
+        // from SymbolPose's companion: kotlinc 2.2.0 miscompiles SymbolPose's static initialiser
+        // (its array-constructor loops lose their index, a VerifyError) when another file reads
+        // those arrays.
+        private val ANGLE = DoubleArray(SymbolPose.N)
+        private val DIST = DoubleArray(SymbolPose.N)
+        private val RANK = IntArray(SymbolPose.N)
+
+        init {
+            val fromTop = DoubleArray(SymbolPose.N)
+            for (i in 0 until SymbolPose.N) {
+                ANGLE[i] = atan2(SymbolData.CENTRE_Y[i], SymbolData.CENTRE_X[i])
+                DIST[i] = hypot(SymbolData.CENTRE_X[i], SymbolData.CENTRE_Y[i])
+                fromTop[i] = (ANGLE[i] + Math.PI / 2 + 4 * Math.PI) % (2 * Math.PI)
+            }
+            for (i in 0 until SymbolPose.N) {
+                var r = 0
+                for (j in 0 until SymbolPose.N) if (fromTop[j] < fromTop[i]) r++
+                RANK[i] = r
+            }
+        }
+    }
+}
