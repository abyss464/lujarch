@@ -0,0 +1,369 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.surfaceeffects.lujarch
+
+/**
+ * The back gesture's indicator (MOT-6): one line of the navigation handle's
+ * material that is simulated as a body. Each of its two arms is two rigid halves with unit point
+ * masses at the elbow and the tip, a torsion spring at the fold and one at the elbow, moving
+ * through a medium (linear drag). The fold follows the native back panel's own animated values, so
+ * its springs shake the line. The design is the springs' rest angles: straight along the edge
+ * while the gesture is undecided, the native arrow's angle (bowed [BOW] each way, as the symbol's
+ * shards) when armed, a dart when launched. A change of state moves the rest angle at once and the
+ * arms snap over by their own inertia; nothing is tweened.
+ *
+ * Coordinates are the mirrored view's: x from the screen's edge inwards, y down, in the unit the
+ * caller uses for its input. [dp] is that unit's length of one dp (px per dp on the phone, kept
+ * current by the view on a density change), which scales the constants written in dp. The model
+ * is pure math on doubles and allocates nothing per frame: the outputs are fields.
+ *
+ * It matches design/canvas/BackGestureOurs.dc.html's `rodSim` (generated by `back_ours()` in
+ * design/tools/m_custom.py), which is authoritative for every number here.
+ */
+class BackLine(var dp: Double) {
+    /** The native panel's gesture states (BackPanelController.GestureState), by name. */
+    enum class State {
+        GONE,
+        ENTRY,
+        ACTIVE,
+        INACTIVE,
+        FLUNG,
+        COMMITTED,
+        CANCELLED,
+    }
+
+    // Outputs of the last [step] that returned true. Index UPPER is the arm above the fold (smaller
+    // y), LOWER the arm below it.
+    @JvmField var foldX = 0.0
+    @JvmField var foldY = 0.0
+    @JvmField val elbowX = DoubleArray(2)
+    @JvmField val elbowY = DoubleArray(2)
+    @JvmField val tipX = DoubleArray(2)
+    @JvmField val tipY = DoubleArray(2)
+
+    /** The line's opacity, 0..1: the background's alpha times the growth; 1 when launched. */
+    @JvmField var alpha = 0.0
+
+    /** True while the line has to be drawn again next frame (MOT-6). */
+    var animating = false
+        private set
+
+    /** True while the launch runs. Both copies of a long swipe fly. */
+    var launching = false
+        private set
+
+    var state = State.GONE
+        private set
+
+    // The body: per arm, the inner half's angle t1, the outer half's absolute angle t2, and their
+    // angular velocities.
+    private val t1 = DoubleArray(2)
+    private val t2 = DoubleArray(2)
+    private val w1 = DoubleArray(2)
+    private val w2 = DoubleArray(2)
+
+    // The fold's last position and velocity, held for the frame's substeps.
+    private var px = 0.0
+    private var py = 0.0
+    private var vx = 0.0
+    private var vy = 0.0
+
+    private var live = false
+    // Launched and gone, until the panel closes: the native panel is still fading when the line has
+    // left, and without this the line would reappear and launch again.
+    private var spent = false
+    private var launchAge = 0.0
+    private var launchX = 0.0
+    private var launchY = 0.0
+    private var launchLength = 0.0
+
+    /**
+     * The panel changed state. GONE clears the body, the launch and the spent flag: the next ENTRY
+     * starts again. The launch itself starts in [step], on the first frame that finds the state
+     * COMMITTED or FLUNG.
+     */
+    /** Remove animations is on: the line stands at its rest for each state and leaves unlaunched. */
+    var removed = false
+
+    fun onState(newState: State) {
+        state = newState
+        if (newState == State.GONE) reset()
+    }
+
+    /** Back to the start; the panel is not visible. */
+    fun reset() {
+        live = false
+        spent = false
+        launching = false
+        animating = false
+    }
+
+    /**
+     * Advances the body by one drawn frame of [dtSec] seconds (clamped to 1/240..1/30) and sets the
+     * outputs from the native panel's values: the translations, scale and pivot, the background's
+     * width and alpha, and the arrow's length and height, all in the caller's unit and read from
+     * the animated values (`.pos`); [centreY] is the panel's vertical centre in the view.
+     *
+     * @return false when nothing is to be drawn (not visible, or launched and gone)
+     */
+    fun step(
+        dtSec: Double,
+        horizontalTranslation: Double,
+        verticalTranslation: Double,
+        centreY: Double,
+        scale: Double,
+        scalePivotX: Double,
+        backgroundWidth: Double,
+        arrowLength: Double,
+        arrowHeight: Double,
+        backgroundAlpha: Double,
+    ): Boolean {
+        animating = false
+        if (state == State.GONE) {
+            reset()
+            return false
+        }
+        if (spent) {
+            live = false
+            return false
+        }
+        val dt = Math.min(Math.max(dtSec, DT_MIN), DT_MAX)
+        val launchState = state == State.COMMITTED || state == State.FLUNG
+        val fold =
+            when (state) {
+                State.ACTIVE -> 1.0
+                State.COMMITTED,
+                State.FLUNG -> FOLD_DART
+                else -> 0.0
+            }
+        // The native arrow's angle from the x axis; the rest angles interpolate from the straight
+        // line (fold 0) to it, bowed inwards (fold 1), and on to the dart (fold 1.5).
+        val th = Math.atan2(arrowHeight, arrowLength)
+        val phi = Math.PI / 2 - fold * (Math.PI / 2 - (th - BOW))
+        val beta = 2 * BOW * fold
+        val room = sat((backgroundWidth - ROOM_MIN * dp) / (ROOM_SPAN * dp))
+        val grow = room * room * (3 - 2 * room)
+        var length = Math.hypot(arrowLength, arrowHeight) * grow * scale
+        var started = false
+        if (launchState && removed) {
+            live = false
+            spent = true
+            return false
+        }
+        if (launchState && !launching && live) {
+            launching = true
+            started = true
+            launchAge = 0.0
+            launchX = px
+            launchY = py
+            launchLength = length
+        }
+        val x: Double
+        val y: Double
+        if (launching) {
+            if (!started) launchAge += dt
+            length = launchLength
+            x = launchX - V0 * dp * launchAge - 0.5 * ACC * dp * launchAge * launchAge
+            y = launchY
+            alpha = 1.0
+            if (x < -2 * length) {
+                launching = false
+                live = false
+                spent = true
+                return false
+            }
+        } else {
+            // The fold stands where the armed arrowhead is centred in the native panel, folded or
+            // not, so it does not move when the gesture arms.
+            val ext = length / 2 * (Math.cos(th - BOW) + Math.cos(th + BOW))
+            val xl = backgroundWidth / 2 - ext / 2
+            x = horizontalTranslation + scalePivotX + scale * (xl - scalePivotX)
+            y = centreY + verticalTranslation
+            alpha = backgroundAlpha * grow
+        }
+        val l = length / 2
+        if (!live) {
+            live = true
+            px = x
+            py = y
+            vx = 0.0
+            vy = 0.0
+            toRest(phi, beta)
+        }
+        val moved = x != px || y != py
+        val vNx = (x - px) / dt
+        val vNy = (y - py) / dt
+        var ax = (vNx - vx) / dt
+        var ay = (vNy - vy) / dt
+        val am = Math.hypot(ax, ay)
+        if (am > A_MAX * dp) {
+            ax = ax * (A_MAX * dp) / am
+            ay = ay * (A_MAX * dp) / am
+        }
+        if (removed) {
+            toRest(phi, beta)
+        } else if (l > MIN_HALF * dp) {
+            val sub = Math.max(1, Math.ceil(dt * SUBSTEPS_PER_SEC - 1e-9).toInt())
+            val h = dt / sub
+            // Stiffness and damping scale with l squared, so the frequencies do not depend on the
+            // length.
+            val ih = 5 * l * l
+            val i2 = l * l
+            val k1 = ih * W1 * W1
+            val d1 = 2 * Z1 * ih * W1
+            val k2 = i2 * W2 * W2
+            val d2 = 2 * Z2 * i2 * W2
+            // Drag grows with the line's length.
+            val dg = DRAG * l / (LREF * dp)
+            for (k in 0 until sub) {
+                for (i in 0..1) {
+                    val sg = SIGN[i]
+                    val a1 = t1[i]
+                    val a2 = t2[i]
+                    val o1 = w1[i]
+                    val o2 = w2[i]
+                    val c1 = Math.cos(a1)
+                    val s1 = Math.sin(a1)
+                    val c2 = Math.cos(a2)
+                    val s2 = Math.sin(a2)
+                    val v1x = vNx - l * o1 * s1
+                    val v1y = vNy + l * o1 * c1
+                    val v2x = v1x - l * o2 * s2
+                    val v2y = v1y + l * o2 * c2
+                    val f1x = -IN * ax - dg * v1x
+                    val f1y = -IN * ay - dg * v1y
+                    val f2x = -IN * ax - dg * v2x
+                    val f2y = -IN * ay - dg * v2y
+                    val tau2 = -k2 * (a2 - a1 - sg * beta) - d2 * (o2 - o1)
+                    val tau1 = -k1 * (a1 - sg * phi) - d1 * o1
+                    val sd = Math.sin(a1 - a2)
+                    val cd = Math.cos(a1 - a2)
+                    val q1 =
+                        tau1 - tau2 +
+                            l * ((f1x + f2x) * -s1 + (f1y + f2y) * c1) -
+                            l * l * sd * o2 * o2
+                    val q2 = tau2 + l * (f2x * -s2 + f2y * c2) + l * l * sd * o1 * o1
+                    val m11 = 2 * l * l
+                    val m12 = l * l * cd
+                    val m22 = l * l
+                    val det = m11 * m22 - m12 * m12
+                    val n1 = o1 + h * (m22 * q1 - m12 * q2) / det
+                    val n2 = o2 + h * (m11 * q2 - m12 * q1) / det
+                    w1[i] = n1
+                    w2[i] = n2
+                    t1[i] = a1 + h * n1
+                    t2[i] = a2 + h * n2
+                }
+            }
+        } else {
+            toRest(phi, beta)
+        }
+        px = x
+        py = y
+        vx = vNx
+        vy = vNy
+        foldX = x
+        foldY = y
+        var still = !moved && !launching
+        for (i in 0..1) {
+            val ex = x + l * Math.cos(t1[i])
+            val ey = y + l * Math.sin(t1[i])
+            elbowX[i] = ex
+            elbowY[i] = ey
+            tipX[i] = ex + l * Math.cos(t2[i])
+            tipY[i] = ey + l * Math.sin(t2[i])
+            if (
+                Math.abs(w1[i]) >= REST_OMEGA ||
+                    Math.abs(w2[i]) >= REST_OMEGA ||
+                    Math.abs(t1[i] - SIGN[i] * phi) > REST_ANGLE ||
+                    Math.abs(t2[i] - SIGN[i] * (phi + beta)) > REST_ANGLE
+            ) {
+                still = false
+            }
+        }
+        animating = !still
+        return true
+    }
+
+    private fun toRest(phi: Double, beta: Double) {
+        for (i in 0..1) {
+            t1[i] = SIGN[i] * phi
+            t2[i] = SIGN[i] * (phi + beta)
+            w1[i] = 0.0
+            w2[i] = 0.0
+        }
+    }
+
+    private fun sat(v: Double) = Math.max(0.0, Math.min(1.0, v))
+
+    companion object {
+        const val UPPER = 0
+        const val LOWER = 1
+
+        /** The arm's sign: the upper arm is -1 (up the screen), the lower +1. */
+        private val SIGN = doubleArrayOf(-1.0, 1.0)
+
+        /** How far each arm bows from the native arrow's angle: inwards when armed. */
+        const val BOW = 6 * Math.PI / 180
+
+        /** The rest fold of a launched line: the dart, one and a half times the native arrow. */
+        private const val FOLD_DART = 1.5
+
+        // The fold's torsion spring and the elbow's, as (natural frequency, damping ratio).
+        private const val W1 = 2 * Math.PI * 5.5
+        private const val Z1 = 0.3
+        private const val W2 = 2 * Math.PI * 13
+        private const val Z2 = 0.45
+
+        // Linear drag per second (scaled by the length over LREF), and the share of the fold's
+        // acceleration the line feels: it moves in the deep, which moves with the panel, so the
+        // panel's jolts reach it softened.
+        private const val DRAG = 5.0
+        private const val IN = 0.12
+
+        // An artboard unit is 3 px: at 420 dpi 1 dp = 0.875 units. The numbers below are in units
+        // and converted.
+        private const val UNITS_PER_DP = 0.875
+
+        /** Half the armed arm, dp: the length at which drag is DRAG. */
+        private const val LREF = 4.2 / UNITS_PER_DP
+
+        /** The launch's initial speed and acceleration, dp/s and dp/s^2. */
+        private const val V0 = 200.0 / UNITS_PER_DP
+        private const val ACC = 4000.0 / UNITS_PER_DP
+
+        /** The largest acceleration of the fold the line feels, dp/s^2. */
+        private const val A_MAX = 1e5 / UNITS_PER_DP
+
+        /** Below this half length (dp) the arms are set to rest and not stepped. */
+        private const val MIN_HALF = 0.15 / UNITS_PER_DP
+
+        // The line grows with the panel's width: from 8 dp to 36 dp, smoothly.
+        private const val ROOM_MIN = 8.0
+        private const val ROOM_SPAN = 28.0
+
+        private const val DT_MIN = 1.0 / 240
+        private const val DT_MAX = 1.0 / 30
+
+        /** 16 substeps for a 120 Hz frame. */
+        private const val SUBSTEPS_PER_SEC = 1920.0
+
+        // A frame is asked for while any of these holds (MOT-6).
+        private const val REST_OMEGA = 0.02
+        private const val REST_ANGLE = 0.001
+    }
+}
