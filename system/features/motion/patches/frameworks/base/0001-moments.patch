+     * place whatever icon the unlock brings ([DeviceEntryIconView]).
+     */
+    var onPlaceChanged: Runnable? = null
+    private val placeEnd = Runnable { onPlaceChanged?.run() }
+
+    init {
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+    }
