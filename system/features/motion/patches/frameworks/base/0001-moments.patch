+import com.android.systemui.surfaceeffects.lujarch.Swell
+import com.android.systemui.surfaceeffects.lujarch.WaterPainter
+import com.android.systemui.surfaceeffects.lujarch.WaveFront
+
+/**
+ * Draws a charging [Swell]'s lit wave front (MOT-4) where the charging
+ * ripple was: the view fills its window, which covers the display, so its px are the screen's. It
+ * draws a frame at a time until the front has faded, then calls the end action once.
+ */
+class SwellView @JvmOverloads constructor(context: Context, attrs: AttributeSet? = null) :
+    View(context, attrs) {
+
+    /** Told each frame's time (seconds) before the front is drawn. */
+    fun interface FrameListener {
+        fun onFrame(t: Double)
+    }
+
+    private val front = WaveFront()
+    private val painter = WaterPainter()
+    private var swell: Swell? = null
+    private var onEnd: Runnable? = null
+    var frameListener: FrameListener? = null
+
+    /** The swell this view draws, or null. */
+    val current: Swell?
+        get() = swell
+
+    /** Draws [s] from the next frame on; [end] runs once after its front has faded. */
+    fun start(s: Swell, end: Runnable?) {
+        swell = s
+        onEnd = end
+        postInvalidateOnAnimation()
+    }
+
+    /** True while a swell is being drawn. */
+    fun isRunning(): Boolean = swell != null
+
+    override fun onDraw(canvas: Canvas) {
+        val s = swell ?: return
+        val t = MotionClock.now()
+        frameListener?.onFrame(t)
+        s.front(front, t)
+        val u = s.unitPx.toFloat()
+        val count = canvas.save()
+        canvas.scale(u, u)
+        painter.draw(canvas, front)
+        canvas.restoreToCount(count)
+        if (t < s.end) {
+            postInvalidateOnAnimation()
+        } else {
+            swell = null
+            val end = onEnd
+            onEnd = null
+            if (end != null) post(end)
+        }
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        swell = null
+        onEnd = null
+    }
+}
