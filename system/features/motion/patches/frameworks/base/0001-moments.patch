+
+package com.android.systemui.surfaceeffects.lujarch
+
+import kotlin.math.hypot
+import kotlin.math.pow
+
+/**
+ * Plugging in (MOT-4): a lit wave front from where the power comes in, the
+ * USB port for a cable, the coil behind the screen's centre for a wireless charger. It leaves its
+ * source [LATENCY] after the plug and spreads to [rEnd] over [duration] with a long deceleration,
+ * `R = 4 + (rEnd - 4) (1 - (1 - u)^2.4)`, then fades for [TAIL]. Whatever it passes on the
+ * lockscreen answers when the crest reaches it ([passTime]): the digits pulse and ride it, the date
+ * and the status icons ride it, the battery turns green, the indication text is lifted into place,
+ * the symbol rises into the gauge ([ChargingGauge]).
+ *
+ * Lengths are artboard units: the screen's short side is 360 of them, [unitPx] px each (3 on the
+ * 1080 px panel). Times are seconds on the frame clock.
+ */
+class Swell(
+    @JvmField val cx: Double,
+    @JvmField val cy: Double,
+    @JvmField val rEnd: Double,
+    @JvmField val duration: Double,
+    /** When the power came in; the wave leaves [LATENCY] later. */
+    @JvmField val plug: Double,
+    @JvmField val wireless: Boolean,
+    @JvmField val unitPx: Double = 3.0,
+) {
+    /** When the wave leaves its source. */
+    @JvmField val start = plug + LATENCY
+    /** When the front has faded out. */
+    @JvmField val end = start + duration + TAIL
+
+    /** The crest's radius at [t]. */
+    fun radius(t: Double): Double =
+        R_START +
+            (rEnd - R_START) * (1 - (1 - SpringResponse.ramp(t, start, start + duration)).pow(2.4))
+
+    /** When the crest reaches ([x], [y]) (units). */
+    fun passTime(x: Double, y: Double): Double {
+        val q = (hypot(x - cx, y - cy) - R_START) / (rEnd - R_START)
+        return when {
+            q <= 0 -> start
+            q >= 1 -> start + duration
+            else -> start + duration * (1 - (1 - q).pow(1 / 2.4))
+        }
+    }
+
+    /** [passTime] for a point in screen px. */
+    fun passTimePx(x: Double, y: Double): Double = passTime(x / unitPx, y / unitPx)
+
+    /** Sets [out] to the front at [t], or hides it outside the wave's life. */
+    fun front(out: WaveFront, t: Double) {
+        if (t < start || t >= end) {
+            out.hide()
+            return
+        }
+        val a = t - start
+        val u = Math.min(1.0, a / duration)
+        val r = radius(t)
+        val tail = 1 - SpringResponse.ramp(a, duration, duration + TAIL)
+        out.set(cx, cy, r, u, WaveFront.amplitude(A0, u, r, tail), MIN_R, t)
+    }
+
+    /**
+     * What the crest reaches rides it: carried [amp] units outward from the source on the impulse
+     * response bob(2.2 Hz, 0.45) from the moment it passes ([x], [y]), then back. Leaves dx, dy
+     * (units) and the response itself in [out].
+     */
+    fun ride(x: Double, y: Double, amp: Double, t: Double, out: DoubleArray) {
+        val b = SpringResponse.bob(t - passTime(x, y), 2.2, 0.45)
+        val d = Math.max(1.0, hypot(x - cx, y - cy))
+        out[0] = amp * b * (x - cx) / d
+        out[1] = amp * b * (y - cy) / d
+        out[2] = b
+    }
+
+    /**
+     * Wireless: the upwelling parts the clock's rows, the top row up and the bottom row down 16
+     * units, each when the crest reaches it ([pass]); they close from 920 ms after the plug. Two
+     * step responses superposed: the spring's target moves out, then back.
+     */
+    fun rowGap(t: Double, pass: Double, topRow: Boolean): Double =
+        (if (topRow) -ROW_GAP else ROW_GAP) *
+            (SpringResponse.step(t - pass, 2.2, 0.6) -
+                SpringResponse.step(t - (plug + 0.92), 2.0, 0.7))
+
+    /**
+     * Wireless: the big level's opacity, surfacing 80 ms after the plug and sinking at 920-1120.
+     */
+    fun levelAlpha(t: Double): Double {
+        val wt = t - (start + 0.03)
+        return if (wt >= 0) SpringResponse.ramp(wt, 0.0, 0.12) * (1 - levelSink(t)) else 0.0
+    }
+
+    /**
+     * Wireless: the big level's scale, 0.6 + 0.4 step(2.2 Hz, 0.55), shrinking by 12 % as it sinks.
+     */
+    fun levelScale(t: Double): Double {
+        val wt = t - (start + 0.03)
+        return Math.max(
+            0.01,
+            (0.6 + 0.4 * SpringResponse.step(wt, 2.2, 0.55)) * (1 - 0.12 * levelSink(t)),
+        )
+    }
+
+    private fun levelSink(t: Double): Double = SpringResponse.ramp((t - plug) * 1000, 920.0, 1120.0)
+
+    /** True while the wave or anything it set moving may still move at [t]. */
+    fun isMoving(t: Double): Boolean = t < end + SETTLE
+
+    companion object {
+        /** The controllers react to the battery broadcast: the wave leaves 50 ms after the plug. */
+        const val LATENCY = 0.05
+        const val TAIL = 0.3
+        const val R_START = 4.0
+        const val A0 = 0.5
+        /** Rings at or inside this radius are not drawn. */
+        const val MIN_R = 3.0
+        const val ROW_GAP = 16.0
+        /** How long a ride or a lift still moves after the front has faded, seconds. */
+        const val SETTLE = 2.5
+
+        /** The wired wave from the port at ([x], [y]) units. */
+        @JvmStatic
+        fun wired(plug: Double, x: Double, y: Double, unitPx: Double): Swell =
+            Swell(x, y, 860.0, 1.1, plug, false, unitPx)
+
+        /** The wireless wave from the coil at ([x], [y]) units. */
+        @JvmStatic
+        fun wireless(plug: Double, x: Double, y: Double, unitPx: Double): Swell =
+            Swell(x, y, 460.0, 1.0, plug, true, unitPx)
+
+        /** The digits' ride, units. */
+        const val DIGIT_RIDE = 4.0
+        /** The date's ride, units. */
+        const val DATE_RIDE = 3.0
+        /** The status icons' ride, units. */
+        const val STATUS_RIDE = 2.5
+
+        /** A digit's scale on the crest: 1 + 0.03 of its ride's response. */
+        @JvmStatic fun digitScale(b: Double): Double = 1 + 0.03 * b
+
+        /** The battery's charging look: green and the bolt, over 100 ms from [pass]. */
+        @JvmStatic
+        fun batteryOn(t: Double, pass: Double): Double =
+            if (t >= pass) SpringResponse.ramp(t, pass, pass + 0.1) else 0.0
+
+        /** The bolt's scale: 0.4 to 1 on step(3 Hz, 0.5) from [pass]. */
+        @JvmStatic
+        fun boltScale(t: Double, pass: Double): Double =
+            0.4 + 0.6 * SpringResponse.step(t - pass, 3.0, 0.5)
+
+        /** The indication text fades in over 150 ms from [pass]. */
+        @JvmStatic
+        fun indicationAlpha(t: Double, pass: Double): Double =
+            if (t >= pass) SpringResponse.ramp(t, pass, pass + 0.15) else 0.0
+
+        /** The indication text is lifted into place: 12 units times 1 - step(2 Hz, 0.6). */
+        @JvmStatic
+        fun indicationLift(t: Double, pass: Double): Double =
+            12 * (1 - SpringResponse.step(t - pass, 2.0, 0.6))
+    }
+}
+
+/**
+ * Where the charging moment's events meet the views that answer them, in SystemUI's process. The
+ * battery's state comes from WiredChargingRippleController's BatteryController callback; a swell
+ * comes from the wired ripple controller or the wireless charging animation. The clock, the date,
+ * the status icons, the battery, the indication text and the device-entry symbol listen. Main
+ * thread only.
+ */
+object Charge {
+    interface Listener {
+        /** A wave front was started. */
+        fun onSwell(swell: Swell)
+
+        /** The power came in or went ([plugged]), or the level changed, at [t]. */
+        fun onPower(plugged: Boolean, level: Int, t: Double)
+    }
+
+    private val listeners = ArrayList<Listener>()
+
+    /** The latest wave front, or null. */
+    @JvmStatic
+    var swell: Swell? = null
+        private set
+
+    @JvmStatic
+    var plugged = false
+        private set
+
+    @JvmStatic
+    var level = -1
+        private set
+
+    /** When the power last came in, or NaN. */
+    @JvmStatic
+    var pluggedAt = Double.NaN
+        private set
+
+    @JvmStatic
+    fun addListener(l: Listener) {
+        if (!listeners.contains(l)) listeners.add(l)
+    }
+
+    @JvmStatic
+    fun removeListener(l: Listener) {
+        listeners.remove(l)
+    }
+
+    /** Starts [s] and tells every listener. */
+    @JvmStatic
+    fun startSwell(s: Swell) {
+        swell = s
+        for (l in listeners.toTypedArray()) l.onSwell(s)
+    }
+
+    /** The battery's state at [t]; listeners hear only changes. */
+    @JvmStatic
+    fun reportPower(plugged: Boolean, level: Int, t: Double) {
+        if (plugged == this.plugged && level == this.level) return
+        if (plugged && !this.plugged) pluggedAt = t
+        this.plugged = plugged
+        this.level = level
+        for (l in listeners.toTypedArray()) l.onPower(plugged, level, t)
+    }
+
+    /**
+     * The swell whose power came in within [within] seconds before [t], or null: a view that is
+     * asked to answer a plug checks whether the wave will drive it.
+     */
+    @JvmStatic
+    fun recentSwell(t: Double, within: Double): Swell? {
+        val s = swell ?: return null
+        return if (t - s.plug in -WAIT..within) s else null
+    }
+
+    /** Forgets everything (tests). */
+    @JvmStatic
+    fun reset() {
+        listeners.clear()
+        swell = null
+        plugged = false
+        level = -1
+        pluggedAt = Double.NaN
+    }
+
+    /**
+     * How long a view that saw the power come in waits for a wave before it answers without one (a
+     * debounced cable, a charger docked at rest), seconds.
+     */
+    const val WAIT = 0.6
+}
