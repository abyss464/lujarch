+
+import android.animation.Animator
+import android.animation.AnimatorListenerAdapter
+import android.animation.ValueAnimator
+import android.content.Context
+import android.content.pm.PackageManager
+import android.graphics.drawable.Icon
+import android.util.Log
+import android.view.ViewGroup
+import android.view.animation.LinearInterpolator
+import com.android.systemui.Dumpable
+import com.android.systemui.animation.ActivityTransitionAnimator
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Application
+import com.android.systemui.dagger.qualifiers.Background
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.dump.DumpManager
+import com.android.systemui.media.controls.ui.controller.MediaCarouselController
+import com.android.systemui.plugins.FalsingManager
+import com.android.systemui.res.R
+import com.android.systemui.shade.ShadeDisplayAware
+import com.android.systemui.shared.settings.data.repository.SecureSettingsRepository
+import com.android.systemui.statusbar.notification.row.ExpandableView
+import com.android.systemui.util.concurrency.DelayableExecutor
+import java.io.PrintWriter
+import java.util.concurrent.Executor
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+
+private const val TAG = "lujarch_motion"
+
+/**
+ * The lockscreen's media shown as a circle at the card's app icon until the owner taps it (Lujarch,
+ * MOT-3). KeyguardMediaController puts a [KeyguardMediaChipLayout] into the
+ * notification stack's media container and the media host into its card slot; this controller
+ * keeps the owner's choice (Settings.Secure [KEYGUARD_MEDIA_EXPANDED_SETTING], per user, default
+ * collapsed), morphs between the circle and the card on the native container transform (the
+ * emphasized curve over 500 ms, the content fading after the shape leads), and gives the circle
+ * the app icon of the card the carousel shows. The shade's and Quick Settings' media, AOD and the
+ * bouncer are untouched: the stack, and the circle with it, is hidden there as the card was.
+ */
+@SysUISingleton
+class KeyguardMediaChipController
+@Inject
+constructor(
+    @ShadeDisplayAware private val context: Context,
+    @Application private val scope: CoroutineScope,
+    private val secureSettings: SecureSettingsRepository,
+    private val falsingManager: FalsingManager,
+    private val carousel: MediaCarouselController,
+    @Main private val mainExecutor: DelayableExecutor,
+    @Background private val bgExecutor: Executor,
+    dumpManager: DumpManager,
+) : Dumpable, KeyguardMediaChipLayout.Listener {
+
+    private val timings =
+        ActivityTransitionAnimator.TIMINGS.let {
+            ChipTimings(
+                totalMs = it.totalDuration.toFloat(),
+                fadeOutDelayMs = it.contentBeforeFadeOutDelay.toFloat(),
+                fadeOutMs = it.contentBeforeFadeOutDuration.toFloat(),
+                fadeInDelayMs = it.contentAfterFadeInDelay.toFloat(),
+                fadeInMs = it.contentAfterFadeInDuration.toFloat(),
+            )
+        }
+
+    private val model =
+        ActivityTransitionAnimator.INTERPOLATORS.let {
+            KeyguardMediaChipModel(
+                timings,
+                ChipCurves(
+                    // DialogTransitionAnimator's choice: the same curve on both axes, so the
+                    // shape grows from the circle's corner without swinging.
+                    shape = it.positionInterpolator::getInterpolation,
+                    fadeOut = it.contentBeforeFadeOutInterpolator::getInterpolation,
+                    fadeIn = it.contentAfterFadeInInterpolator::getInterpolation,
+                ),
+            )
+        }
+
+    private var layout: KeyguardMediaChipLayout? = null
+    private var container: ViewGroup? = null
+
+    private var iconSource: IconSource? = null
+    private var iconRequested = false
+    private var icon: ChipIcon? = null
+    private var iconRefreshPosted = false
+
+    private val animator =
+        ValueAnimator.ofFloat(0f, 1f).apply {
+            duration = timings.totalMs.toLong()
+            interpolator = LinearInterpolator()
+            addUpdateListener { advance(it.animatedFraction * timings.totalMs) }
+            addListener(
+                object : AnimatorListenerAdapter() {
+                    private var cancelled = false
+
+                    override fun onAnimationStart(animation: Animator) {
+                        cancelled = false
+                    }
+
+                    override fun onAnimationCancel(animation: Animator) {
+                        cancelled = true
+                    }
+
+                    override fun onAnimationEnd(animation: Animator) {
+                        if (!cancelled) advance(timings.totalMs)
+                    }
+                }
+            )
+        }
+
+    init {
+        dumpManager.registerNormalDumpable(TAG, this)
+        carousel.onVisibleCardUpdated = ::scheduleIconRefresh
+        scope.launch {
+            secureSettings.boolSetting(KEYGUARD_MEDIA_EXPANDED_SETTING, false).collect {
+                onSetting(it)
+            }
+        }
+    }
+
+    /**
+     * Puts the circle and the card's slot into the lockscreen's media [container] (a new one after
+     * each reinflation of the stack's sections) and returns the slot, where the media host goes.
+     */
+    fun attach(container: ViewGroup): ViewGroup {
+        layout?.let {
+            if (it.parent === container) return it.cardSlot
+            it.release()
+        }
+        if (model.animating) {
+            animator.cancel()
+            model.finish()
+        }
+        val l = KeyguardMediaChipLayout(container.context, this)
+        container.addView(
+            l,
+            ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
+        )
+        this.container = container
+        layout = l
+        l.setIcon(icon)
+        render()
+        scheduleIconRefresh()
+        Log.i(TAG, "attached: $model")
+        return l.cardSlot
+    }
+
+    override fun onToggle() {
+        if (falsingManager.isFalseTap(FalsingManager.LOW_PENALTY)) {
+            Log.i(TAG, "tap taken as false, ignored")
+            return
+        }
+        val animate = layout?.canMorph() == true
+        val expanded = model.tap(animate)
+        Log.i(TAG, (if (expanded) "expand" else "collapse") + " (tap, animate=$animate)")
+        // A long-press menu left open would come back with the card.
+        if (!expanded) carousel.closeGuts(immediate = false)
+        start(animate)
+        scope.launch {
+            try {
+                secureSettings.setBoolean(KEYGUARD_MEDIA_EXPANDED_SETTING, expanded)
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "could not save $KEYGUARD_MEDIA_EXPANDED_SETTING=$expanded", e)
+            } finally {
+                model.writeDone()
+            }
+        }
+    }
+
+    override fun onShownChanged(shown: Boolean) {
+        if (!shown && model.animating) {
+            // The media left the lockscreen (or the screen) mid-morph: land on the choice.
+            animator.cancel()
+            model.finish()
+            render()
+            Log.i(TAG, "hidden mid-morph, landed: $model")
+        }
+    }
+
+    override fun onHeightSettled() {
+        // The stack recounts the notifications that fit on the lockscreen (NSSL's height change
+        // listeners); the container's layout alone does not tell it.
+        (container as? ExpandableView)
+            ?.notifyHeightChanged(/* needsAnimation= */ false, "LujarchMediaChip")
+    }
+
+    private fun onSetting(value: Boolean) {
+        val animate = layout?.canMorph() == true
+        if (model.setting(value, animate)) {
+            Log.i(TAG, "setting $KEYGUARD_MEDIA_EXPANDED_SETTING=$value applied, $model")
+            start(model.animating)
+        }
+    }
+
+    private fun start(animate: Boolean) {
+        animator.cancel()
+        if (animate) animator.start() else render()
+    }
+
+    private fun advance(ms: Float) {
+        model.advance(ms)
+        render()
+    }
+
+    private fun render() {
+        layout?.render(model.frame, model.expanded, model.cardInteractive, model.animating)
+        // The container is clickable so the card's area keeps touches; around the circle the
+        // lockscreen's own gestures (the long press, the empty space) must get them.
+        container?.isClickable = model.cardInteractive
+    }
+
+    private fun scheduleIconRefresh() {
+        // Posted: the carousel calls back while reordering, before its visible order is updated.
+        if (iconRefreshPosted) return
+        iconRefreshPosted = true
+        mainExecutor.execute {
+            iconRefreshPosted = false
+            refreshIcon()
+        }
+    }
+
+    private fun refreshIcon() {
+        val data = carousel.visibleCardData()
+        val source = data?.let { IconSource(it.packageName, if (it.resumption) null else it.appIcon) }
+        if (iconRequested && source == iconSource) return
+        iconRequested = true
+        iconSource = source
+        bgExecutor.execute {
+            val loaded = load(source)
+            mainExecutor.execute {
+                if (iconSource == source) {
+                    icon = loaded
+                    layout?.setIcon(loaded)
+                }
+            }
+        }
+    }
+
+    /** As the card's app icon: the notification's small icon, a resumed player's launcher icon. */
+    private fun load(source: IconSource?): ChipIcon {
+        source?.appIcon?.loadDrawable(context)?.let {
+            return ChipIcon(it, monochrome = true)
+        }
+        if (source != null) {
+            try {
+                return ChipIcon(
+                    context.packageManager.getApplicationIcon(source.packageName),
+                    monochrome = false,
+                )
+            } catch (e: PackageManager.NameNotFoundException) {
+                Log.w(TAG, "no icon for ${source.packageName}", e)
+            }
+        }
+        return ChipIcon(context.getDrawable(R.drawable.ic_music_note)!!, monochrome = true)
+    }
+
+    override fun dump(pw: PrintWriter, args: Array<out String>) {
+        pw.println("KeyguardMediaChipController: $model")
+        pw.println("  attached=${layout?.isAttachedToWindow} icon=${iconSource?.packageName}")
+    }
+
+    /** The circle's icon's source; the same icon (Icon.sameAs) is not loaded again. */
+    private class IconSource(val packageName: String, val appIcon: Icon?) {
+        override fun equals(other: Any?): Boolean =
+            other is IconSource &&
+                other.packageName == packageName &&
+                (if (appIcon == null) other.appIcon == null
+                else other.appIcon != null && appIcon.sameAs(other.appIcon))
+
+        override fun hashCode() = packageName.hashCode()
+    }
+}
