+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.Shader
+
+/**
+ * Draws lit rings, glints, the wave front ([WaveFront]) and the waterline ([Waterline]) in the
+ * caller's units. Shaders, paints and paths are made once: a ring's gradient is fixed in a unit box
+ * and the canvas is scaled to each ring's box, and the water's fill gradient is picked from a
+ * precomputed ramp, so drawing allocates nothing.
+ */
+class WaterPainter(light: SymbolLight = SymbolLight()) {
+    // The lit stroke: across the ring's bounding box from the upper left to the lower right,
+    // #fff5ee to LIGHTC fading, so the crest is lit where it faces the key light. The white variant
+    // is for the dark (AOD) screen.
+    private val litShader = unitRingShader(SymbolLight.GLINT, light.lightColor, 0.65)
+    private val whiteShader = unitRingShader(Color.WHITE, Color.WHITE, 0.6)
+    private val litRingPaint = ringPaint(litShader)
+    private val whiteRingPaint = ringPaint(whiteShader)
+    private val solidRingPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
+    private val glintPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val star =
+        Path().apply {
+            moveTo(0f, -1f)
+            lineTo(0.26f, 0f)
+            lineTo(0f, 1f)
+            lineTo(-0.26f, 0f)
+            close()
+            moveTo(-1f, 0f)
+            lineTo(0f, -0.26f)
+            lineTo(1f, 0f)
+            lineTo(0f, 0.26f)
+            close()
+        }
+
+    private val lightColor = light.lightColor
+    // The fill's top colour from black to DEEPER (the drain's first 100 ms), in FILL_STEPS steps.
+    private val fillShaders =
+        Array(FILL_STEPS + 1) {
+            val top = SymbolLight.blend(Color.BLACK, light.deeperColor, it / FILL_STEPS.toDouble())
+            LinearGradient(
+                0f,
+                0f,
+                0f,
+                1f,
+                intArrayOf(SymbolLight.withAlpha(top, 0.96), Color.BLACK),
+                floatArrayOf(0f, 1f),
+                Shader.TileMode.CLAMP,
+            )
+        }
+    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val linePaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = 1.2f
+        }
+    private val fillPath = Path()
+    private val linePath = Path()
+
+    /**
+     * A ring of radius [r] and width [width] round ([cx], [cy]) at [alpha], stroked with the lit
+     * gradient ([white] for the dark screen's white one).
+     */
+    fun drawLitRing(
+        canvas: Canvas,
+        cx: Double,
+        cy: Double,
+        r: Double,
+        width: Double,
+        alpha: Double,
+        white: Boolean = false,
+    ) {
+        if (alpha <= 0.0 || width <= 0.0 || r <= 0.0) return
+        val d = (2 * r).toFloat()
+        val count = canvas.save()
+        canvas.translate((cx - r).toFloat(), (cy - r).toFloat())
+        canvas.scale(d, d)
+        val paint = if (white) whiteRingPaint else litRingPaint
+        paint.strokeWidth = width.toFloat() / d
+        paint.alpha = alpha255(alpha)
+        canvas.drawCircle(0.5f, 0.5f, 0.5f, paint)
+        canvas.restoreToCount(count)
+    }
+
+    /** A plain ring in [color] (the trough, the refusal's dull ring). */
+    fun drawRing(
+        canvas: Canvas,
+        cx: Double,
+        cy: Double,
+        r: Double,
+        width: Double,
+        color: Int,
+        alpha: Double,
+    ) {
+        if (alpha <= 0.0 || width <= 0.0 || r <= 0.0) return
+        solidRingPaint.color = SymbolLight.withAlpha(color, alpha)
+        solidRingPaint.strokeWidth = width.toFloat()
+        canvas.drawCircle(cx.toFloat(), cy.toFloat(), r.toFloat(), solidRingPaint)
+    }
+
+    /** A four-point glint of brightness [b] at ([x], [y]); faint ones are not drawn. */
+    fun drawGlint(canvas: Canvas, x: Double, y: Double, b: Double) {
+        if (b < WaveFront.GLINT_MIN) return
+        val s = WaveFront.glintSize(b).toFloat()
+        val count = canvas.save()
+        canvas.translate(x.toFloat(), y.toFloat())
+        canvas.scale(s, s)
+        glintPaint.color = SymbolLight.withAlpha(SymbolLight.GLINT, WaveFront.glintAlpha(b))
+        canvas.drawPath(star, glintPaint)
+        canvas.restoreToCount(count)
+    }
+
+    /** The wave front: glow, crest, two trailing rings, the trough, then the glints. */
+    fun draw(canvas: Canvas, front: WaveFront) {
+        if (!front.visible) return
+        for (i in 0 until WaveFront.TROUGH) {
+            drawLitRing(
+                canvas,
+                front.cx,
+                front.cy,
+                front.ringR[i],
+                front.ringWidth[i],
+                front.ringAlpha[i],
+            )
+        }
+        val t = WaveFront.TROUGH
+        drawRing(
+            canvas,
+            front.cx,
+            front.cy,
+            front.ringR[t],
+            front.ringWidth[t],
+            Color.BLACK,
+            front.ringAlpha[t],
+        )
+        for (k in 0 until WaveFront.GLINTS) drawGlint(
+            canvas,
+            front.glintX[k],
+            front.glintY[k],
+            front.glintB[k],
+        )
+    }
+
+    /** The waterline: the water below it, the lit line, the glints riding it. */
+    fun draw(canvas: Canvas, water: Waterline) {
+        if (!water.visible) return
+        // The fill in a frame where the gradient's unit box spans the level to DEPTH below it.
+        val level = water.level
+        fillPath.reset()
+        for (i in 0 until Waterline.SAMPLES) {
+            val x = (i * Waterline.STEP).toFloat()
+            val y = ((water.surfaceY[i] - level) / Waterline.DEPTH).toFloat()
+            if (i == 0) fillPath.moveTo(x, y) else fillPath.lineTo(x, y)
+        }
+        val bottom = ((Waterline.BOTTOM - level) / Waterline.DEPTH).toFloat()
+        fillPath.lineTo(Waterline.WIDTH.toFloat(), bottom)
+        fillPath.lineTo(0f, bottom)
+        fillPath.close()
+        val step = Math.round(Math.max(0.0, Math.min(1.0, water.colorIn)) * FILL_STEPS).toInt()
+        fillPaint.shader = fillShaders[step]
+        val count = canvas.save()
+        canvas.translate(0f, level.toFloat())
+        canvas.scale(1f, Waterline.DEPTH.toFloat())
+        canvas.drawPath(fillPath, fillPaint)
+        canvas.restoreToCount(count)
+
+        if (water.lineAlpha > 0.0) {
+            linePath.reset()
+            for (i in 0 until Waterline.SAMPLES) {
+                val x = (i * Waterline.STEP).toFloat()
+                val y = water.surfaceY[i].toFloat()
+                if (i == 0) linePath.moveTo(x, y) else linePath.lineTo(x, y)
+            }
+            linePaint.color = SymbolLight.withAlpha(lightColor, water.lineAlpha)
+            canvas.drawPath(linePath, linePaint)
+        }
+        for (k in 0 until Waterline.SURFACE_GLINTS) {
+            drawGlint(canvas, water.glintX[k], water.glintY[k], water.glintB[k])
+        }
+    }
+
+    companion object {
+        const val FILL_STEPS = 16
+
+        private fun alpha255(a: Double): Int =
+            Math.round(Math.max(0.0, Math.min(1.0, a)) * 255).toInt()
+
+        private fun ringPaint(unitShader: Shader) =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.STROKE
+                shader = unitShader
+            }
+
+        private fun unitRingShader(start: Int, end: Int, midAlpha: Double) =
+            LinearGradient(
+                0.12f,
+                0.05f,
+                0.88f,
+                0.95f,
+                intArrayOf(
+                    start,
+                    SymbolLight.withAlpha(end, midAlpha),
+                    SymbolLight.withAlpha(end, 0.1),
+                ),
+                floatArrayOf(0f, 0.45f, 1f),
+                Shader.TileMode.CLAMP,
+            )
+    }
+}
