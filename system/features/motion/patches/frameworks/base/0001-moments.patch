+
+package com.android.systemui.surfaceeffects.lujarch
+
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.Path
+
+/** Builds [path] from a [SymbolData] command array. */
+internal fun buildPath(commands: FloatArray, path: Path = Path()): Path {
+    path.reset()
+    var i = 0
+    while (i < commands.size) {
+        when (commands[i]) {
+            SymbolData.MOVE -> {
+                path.moveTo(commands[i + 1], commands[i + 2])
+                i += 3
+            }
+            SymbolData.LINE -> {
+                path.lineTo(commands[i + 1], commands[i + 2])
+                i += 3
+            }
+            SymbolData.CUBIC -> {
+                path.cubicTo(
+                    commands[i + 1],
+                    commands[i + 2],
+                    commands[i + 3],
+                    commands[i + 4],
+                    commands[i + 5],
+                    commands[i + 6],
+                )
+                i += 7
+            }
+            SymbolData.CLOSE -> {
+                path.close()
+                i += 1
+            }
+            else -> throw IllegalArgumentException("bad path command ${commands[i]} at $i")
+        }
+    }
+    return path
+}
+
+/**
+ * Draws the symbol's shards ([SymbolPose]) and the canonical shard ([ShardPose]) with their facets'
+ * colours. The paths are built once; drawing allocates nothing, so it can run in onDraw every
+ * frame.
+ */
+class SymbolPainter {
+    private val facetA = Array(SymbolData.SHARDS) { buildPath(SymbolData.FACET_A[it]) }
+    private val facetB = Array(SymbolData.SHARDS) { buildPath(SymbolData.FACET_B[it]) }
+    private val canonA = buildPath(SymbolData.CANON_FACET_A)
+    private val canonB = buildPath(SymbolData.CANON_FACET_B)
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+
+    /** Draws every shard of [pose], each at its own opacity times [alpha]. */
+    fun draw(canvas: Canvas, pose: SymbolPose, alpha: Double = 1.0) {
+        for (i in 0 until SymbolData.SHARDS) drawShard(canvas, pose, i, alpha)
+    }
+
+    /**
+     * Draws shard [i] of [pose] alone, for a caller that clips it first (the charging gauge's
+     * filling shard) or colours it again ([colorA], [colorB]).
+     */
+    fun drawShard(
+        canvas: Canvas,
+        pose: SymbolPose,
+        i: Int,
+        alpha: Double = 1.0,
+        colorA: Int = pose.colorA[i],
+        colorB: Int = pose.colorB[i],
+    ) {
+        val a = pose.alpha[i] * alpha
+        val s = pose.scale[i].toFloat()
+        if (a <= 0.0 || s == 0f) return
+        val count = canvas.save()
+        canvas.translate(pose.x[i].toFloat(), pose.y[i].toFloat())
+        canvas.rotate(pose.rot[i].toFloat())
+        canvas.scale(s, s)
+        canvas.translate(-SymbolData.CENTRE_X[i].toFloat(), -SymbolData.CENTRE_Y[i].toFloat())
+        paint.color = SymbolLight.withAlpha(colorA, a)
+        canvas.drawPath(facetA[i], paint)
+        paint.color = SymbolLight.withAlpha(colorB, a)
+        canvas.drawPath(facetB[i], paint)
+        canvas.restoreToCount(count)
+    }
+
+    /**
+     * Draws the canonical shard of [shard] as `translate(x, y) rotate(rot) scale(w, len)` at its
+     * opacity times [alpha]. A mirrored pose is lit for a canvas the caller has mirrored; the
+     * geometry is not mirrored here.
+     */
+    fun draw(canvas: Canvas, shard: ShardPose, alpha: Double = 1.0) {
+        val a = shard.alpha * alpha
+        if (a <= 0.0 || shard.w == 0.0 || shard.len == 0.0) return
+        val count = canvas.save()
+        canvas.translate(shard.x.toFloat(), shard.y.toFloat())
+        canvas.rotate(shard.rot.toFloat())
+        canvas.scale(shard.w.toFloat(), shard.len.toFloat())
+        paint.color = SymbolLight.withAlpha(shard.colorA, a)
+        canvas.drawPath(canonA, paint)
+        paint.color = SymbolLight.withAlpha(shard.colorB, a)
+        canvas.drawPath(canonB, paint)
+        canvas.restoreToCount(count)
+    }
+}
diff --git a/packages/SystemUI/animation/src/com/android/systemui/surfaceeffects/lujarch/SymbolPose.kt b/packages/SystemUI/animation/src/com/android/systemui/surfaceeffects/lujarch/SymbolPose.kt
new file mode 100644
index 0000000000000000000000000000000000000000..a6c49d9e72bf079a61f0b8578f011316ef6ba6e4
--- /dev/null
+++ b/packages/SystemUI/animation/src/com/android/systemui/surfaceeffects/lujarch/SymbolPose.kt
@@ -0,0 +1,198 @@
+/*
+ * Copyright (C) 2026 The Lujarch Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.surfaceeffects.lujarch
+
+import kotlin.math.atan2
+import kotlin.math.cos
+import kotlin.math.hypot
+import kotlin.math.sin
+
+/**
+ * Where each of the symbol's ten shards is drawn and in what colours, in the caller's units
+ * (artboard units: the screen's short side is 360, 3 px each on the phone). A shard is placed by
+ * the symbol's own transform `translate(x, y) rotate(rot) scale(scale) translate(-centre)`; a
+ * moment fills a pose each frame and [SymbolPainter] draws it.
+ */
+class SymbolPose(@JvmField val light: SymbolLight = SymbolLight()) {
+    @JvmField val x = DoubleArray(N)
+    @JvmField val y = DoubleArray(N)
+    @JvmField val rot = DoubleArray(N)
+    @JvmField val scale = DoubleArray(N)
+    @JvmField val alpha = DoubleArray(N)
+    @JvmField val colorA = IntArray(N)
+    @JvmField val colorB = IntArray(N)
+
+    /**
+     * Places shard [i] on a ring round ([cx], [cy]) at the radius
+     * `(dist(centre) * kr + r0) * (1 - 0.2 bite) * (1 + 1.3 open)`, turned [rotDeg] with the ring,
+     * scaled `ks * (1 + 0.06 bite)`, then moved by the shard's own offsets ([dx], [dy], [drot],
+     * size [ds], opacity [op]); [alpha] is the symbol's opacity.
+     */
+    fun place(
+        i: Int,
+        cx: Double,
+        cy: Double,
+        ks: Double,
+        kr: Double,
+        r0: Double,
+        rotDeg: Double,
+        bite: Double = 0.0,
+        open: Double = 0.0,
+        alpha: Double = 1.0,
+        dx: Double = 0.0,
+        dy: Double = 0.0,
+        drot: Double = 0.0,
+        ds: Double = 1.0,
+        op: Double = 1.0,
+    ) {
+        val a0 = ANGLE[i] + rotDeg * Math.PI / 180
+        val rr = (DIST[i] * kr + r0) * (1 - 0.2 * bite) * (1 + 1.3 * open)
+        x[i] = cx + cos(a0) * rr + dx
+        y[i] = cy + sin(a0) * rr + dy
+        scale[i] = ks * (1 + 0.06 * bite) * ds
+        rot[i] = rotDeg + drot
+        this.alpha[i] = (1 - SpringResponse.ramp(open, 0.0, 1.0)) * op * alpha
+    }
+
+    /** Colours shard [i] (lit 0..1, a flash, an optional tilt) at its current rotation. */
+    fun light(i: Int, lit: Double, flash: Double, tiltX: Double = 0.0, tiltY: Double = 0.0) {
+        colorA[i] =
+            light.facet(
+                SymbolData.NORMAL_A_X[i],
+                SymbolData.NORMAL_A_Y[i],
+                rot[i],
+                lit,
+                flash,
+                tiltX,
+                tiltY,
+            )
+        colorB[i] =
+            light.facet(
+                SymbolData.NORMAL_B_X[i],
+                SymbolData.NORMAL_B_Y[i],
+                rot[i],
+                lit,
+                flash,
+                tiltX,
+                tiltY,
+            )
+    }
+
+    /**
+     * Colours shard [i] lit in another base colour (the privacy green), dimmed by [dim], as
+     * PrivacyOurs shades its shards: the lit colour only, no blend with the unlit one.
+     */
+    fun lightWithBase(i: Int, base: Int, flash: Double, dim: Double) {
+        val r = (base shr 16 and 0xff).toDouble()
+        val g = (base shr 8 and 0xff).toDouble()
+        val b = (base and 0xff).toDouble()
+        light.facetNormal(SymbolData.NORMAL_A_X[i], SymbolData.NORMAL_A_Y[i], rot[i])
+        colorA[i] = light.shade(flash, dim, r, g, b)
+        light.facetNormal(SymbolData.NORMAL_B_X[i], SymbolData.NORMAL_B_Y[i], rot[i])
+        colorB[i] = light.shade(flash, dim, r, g, b)
+    }
+
+    companion object {
+        const val N = SymbolData.SHARDS
+
+        /** Each shard's direction from the symbol's centre, radians. */
+        @JvmField val ANGLE = DoubleArray(N)
+
+        /** Each shard's distance from the symbol's centre, in symbol units. */
+        @JvmField val DIST = DoubleArray(N)
+
+        /**
+         * Each shard's rank clockwise from the top (angle + 90 degrees, mod 360): the order the
+         * jaws open and the gauge lights.
+         */
+        @JvmField val RANK = IntArray(N)
+
+        // Plain loops, not the array constructors' lambdas: kotlinc 2.2.0 drops the index's
+        // initialisation from those in this static initialiser when a file compiled before this one
+        // reads these arrays (VerifyError "Bad local variable type" in <clinit>).
+        init {
+            for (i in 0 until N) {
+                ANGLE[i] = atan2(SymbolData.CENTRE_Y[i], SymbolData.CENTRE_X[i])
+                DIST[i] = hypot(SymbolData.CENTRE_X[i], SymbolData.CENTRE_Y[i])
+            }
+            for (i in 0 until N) {
+                var rank = 0
+                for (j in 0 until N) if (fromTop(ANGLE[j]) < fromTop(ANGLE[i])) rank++
+                RANK[i] = rank
+            }
+        }
+
+        private fun fromTop(a: Double): Double = (a + Math.PI / 2 + 4 * Math.PI) % (2 * Math.PI)
+    }
+}
+
+/**
+ * One canonical shard (base middle at the origin, tip at (0, -1)) drawn as `translate(x, y)
+ * rotate(rot) scale(w, len)`: the back gesture's arrowhead, the
+ * volume dialog's float. [mirrored] draws it mirrored in x about [x] (a panel on the right edge),
+ * lit as the mirrored body is, from the same upper-left light.
+ */
+class ShardPose(@JvmField val light: SymbolLight = SymbolLight()) {
+    @JvmField var x = 0.0
+    @JvmField var y = 0.0
+    @JvmField var rot = 0.0
+    @JvmField var w = 1.0
+    @JvmField var len = 1.0
+    @JvmField var alpha = 1.0
+    @JvmField var mirrored = false
+    @JvmField var colorA = 0
+    @JvmField var colorB = 0
+
+    fun set(
+        x: Double,
+        y: Double,
+        len: Double,
+        w: Double,
+        rotDeg: Double,
+        alpha: Double,
+        lit: Double,
+        flash: Double,
+        mirrored: Boolean = false,
+    ) {
+        this.x = x
+        this.y = y
+        this.len = len
+        this.w = w
+        this.rot = rotDeg
+        this.alpha = alpha
+        this.mirrored = mirrored
+        // In the world a mirrored facet has the mirrored normal and the opposite turn; the light
+        // stays put.
+        val m = if (mirrored) -1.0 else 1.0
+        colorA =
+            light.facet(
+                m * SymbolData.CANON_NORMAL_A_X,
+                SymbolData.CANON_NORMAL_A_Y,
+                m * rotDeg,
+                lit,
+                flash,
+            )
+        colorB =
+            light.facet(
+                m * SymbolData.CANON_NORMAL_B_X,
+                SymbolData.CANON_NORMAL_B_Y,
+                m * rotDeg,
+                lit,
+                flash,
+            )
+    }
+}
