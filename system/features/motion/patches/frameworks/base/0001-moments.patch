+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.surfaceeffects.lujarch
+
+import kotlin.math.cos
+import kotlin.math.floor
+import kotlin.math.pow
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+/**
+ * The symbol's lighting (target/motion.md): a key
+ * light from the upper left, each facet bevelled 48 degrees, a lit colour with a flash term and a
+ * specular highlight, an unlit colour, and the drawn colour blended between them by `lit`. Colours
+ * are opaque ARGB ints rounded per channel at fixed steps, so every frame of a shard is the same
+ * colour wherever it is drawn.
+ *
+ * Not thread-safe: one instance per drawing thread (it keeps a scratch normal to stay
+ * allocation-free).
+ */
+class SymbolLight(base: Int = SEED) {
+    @JvmField val baseR = (base shr 16 and 0xff).toDouble()
+    @JvmField val baseG = (base shr 8 and 0xff).toDouble()
+    @JvmField val baseB = (base and 0xff).toDouble()
+
+    /** LIGHTC: the base 45 % towards white; crests, glints and water lines. */
+    @JvmField val lightColor = mix(0.45, 255.0)
+    /** DEEP: the base 55 % towards black. */
+    @JvmField val deepColor = mix(0.55, 0.0)
+    /** DEEPER: the base 78 % towards black; the water below the line. */
+    @JvmField val deeperColor = mix(0.78, 0.0)
+
+    private val n = DoubleArray(3)
+
+    private fun mix(w: Double, other: Double): Int =
+        rgb(baseR + (other - baseR) * w, baseG + (other - baseG) * w, baseB + (other - baseB) * w)
+
+    /**
+     * The facet normal: the 2D normal ([n2x], [n2y]) bevelled, turned by the shard's rotation
+     * [rotDeg] (z), then tilted by [tiltX] and [tiltY] degrees. Left in the scratch normal.
+     */
+    fun facetNormal(
+        n2x: Double,
+        n2y: Double,
+        rotDeg: Double,
+        tiltX: Double = 0.0,
+        tiltY: Double = 0.0,
+    ) {
+        var x = n2x * SIN_BEVEL
+        var y = n2y * SIN_BEVEL
+        var z = -COS_BEVEL
+        var c = cos(rad(rotDeg))
+        var s = sin(rad(rotDeg))
+        val x1 = x * c - y * s
+        val y1 = x * s + y * c
+        x = x1
+        y = y1
+        c = cos(rad(tiltX))
+        s = sin(rad(tiltX))
+        val y2 = y * c - z * s
+        val z2 = y * s + z * c
+        y = y2
+        z = z2
+        c = cos(rad(tiltY))
+        s = sin(rad(tiltY))
+        val x3 = x * c + z * s
+        val z3 = -x * s + z * c
+        n[0] = x3
+        n[1] = y
+        n[2] = z3
+    }
+
+    /** The lit colour of the scratch normal with the base colour ([r], [g], [b]). */
+    fun shade(
+        flash: Double,
+        dim: Double,
+        r: Double = baseR,
+        g: Double = baseG,
+        b: Double = baseB,
+    ): Int {
+        val d = Math.max(0.0, n[0] * LX + n[1] * LY + n[2] * LZ)
+        val sp0 = Math.max(0.0, n[0] * HX + n[1] * HY + n[2] * HZ).pow(28)
+        val k = (0.18 + 0.95 * d + 0.9 * flash) * dim
+        val sp = 0.8 * sp0 + 0.5 * flash * sp0
+        return rgb(r * k + 255 * sp, g * k + 236 * sp, b * k + 222 * sp)
+    }
+
+    /** The unlit colour of the scratch normal. */
+    fun unlit(): Int {
+        val k = 0.16 + 0.22 * Math.max(0.0, n[0] * LX + n[1] * LY + n[2] * LZ)
+        return rgb(baseR * k, baseG * k, baseB * k)
+    }
+
+    /**
+     * A facet's drawn colour: the unlit colour blended towards the lit one by [lit].
+     */
+    fun facet(
+        n2x: Double,
+        n2y: Double,
+        rotDeg: Double,
+        lit: Double,
+        flash: Double,
+        tiltX: Double = 0.0,
+        tiltY: Double = 0.0,
+    ): Int {
+        facetNormal(n2x, n2y, rotDeg, tiltX, tiltY)
+        return blend(unlit(), shade(flash, 1.0), lit)
+    }
+
+    companion object {
+        /** The seed colour, red ochre. */
+        const val SEED = 0xffb5462b.toInt()
+        /** The glints' and crest's white. */
+        const val GLINT = 0xfffff5ee.toInt()
+
+        // degrees to radians as d * pi / 180, to the last bit
+        private fun rad(deg: Double): Double = deg * Math.PI / 180
+
+        private val SIN_BEVEL = sin(rad(48.0))
+        private val COS_BEVEL = cos(rad(48.0))
+        private val LX: Double
+        private val LY: Double
+        private val LZ: Double
+        private val HX: Double
+        private val HY: Double
+        private val HZ: Double
+
+        init {
+            val l = sqrt(0.45 * 0.45 + 0.72 * 0.72 + 0.55 * 0.55)
+            LX = -0.45 / l
+            LY = -0.72 / l
+            LZ = -0.55 / l
+            val h = sqrt(LX * LX + LY * LY + (LZ - 1) * (LZ - 1))
+            HX = LX / h
+            HY = LY / h
+            HZ = (LZ - 1) / h
+        }
+
+        /** The key light's direction in the screen plane (up-left): the glints face it. */
+        @JvmField val THETA_LIGHT = Math.atan2(-0.72, -0.45)
+
+        private fun channel(x: Double): Int = floor(Math.max(0.0, Math.min(255.0, x)) + 0.5).toInt()
+
+        /** An opaque colour from channels, each rounded half up and clamped to 0..255. */
+        @JvmStatic
+        fun rgb(r: Double, g: Double, b: Double): Int =
+            (0xff shl 24) or (channel(r) shl 16) or (channel(g) shl 8) or channel(b)
+
+        /**
+         * [a] blended towards [b] by [u], rounded per channel; alpha from [a].
+         */
+        @JvmStatic
+        fun blend(a: Int, b: Int, u: Double): Int {
+            if (u <= 0) return a
+            if (u >= 1) return b
+            val ar = (a shr 16 and 0xff).toDouble()
+            val ag = (a shr 8 and 0xff).toDouble()
+            val ab = (a and 0xff).toDouble()
+            return rgb(
+                ar + ((b shr 16 and 0xff) - ar) * u,
+                ag + ((b shr 8 and 0xff) - ag) * u,
+                ab + ((b and 0xff) - ab) * u,
+            )
+        }
+
+        /** [color] with its alpha set to [alpha] (0..1). */
+        @JvmStatic
+        fun withAlpha(color: Int, alpha: Double): Int =
+            (channel(alpha * 255) shl 24) or (color and 0xffffff)
+    }
+}
