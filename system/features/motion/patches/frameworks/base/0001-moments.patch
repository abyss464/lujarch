+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.animation.lujarch
+
+import android.graphics.Matrix
+import android.view.Display
+import android.view.View
+import android.view.animation.AnimationUtils
+import com.android.systemui.surfaceeffects.lujarch.Charge
+import com.android.systemui.surfaceeffects.lujarch.Swell
+
+/**
+ * The frame clock Lujarch's moments run on, in seconds: the frame's vsync time while Choreographer runs a
+ * frame, uptime otherwise (AnimationUtils), so a moment's events and its frames share one clock.
+ */
+object MotionClock {
+    @JvmStatic fun now(): Double = AnimationUtils.currentAnimationTimeMillis() / 1000.0
+
+    /** True when [view] is shown on a display that is on: not off, and not dozing (AOD). */
+    @JvmStatic
+    fun isLit(view: View): Boolean = view.isShown && view.display?.state == Display.STATE_ON
+}
+
+/**
+ * Makes [view] ride the charging wave's crest (MOT-4): when a [Swell] starts while
+ * the view is shown with the screen on, the view is carried [amplitude] units outward from the
+ * wave's source on bob(2.2 Hz, 0.45) from the moment the crest passes its centre, then settles
+ * back; on AOD it stays still. The ride goes through the view's animation matrix, which SystemUI's
+ * own animations leave alone, so it adds to whatever translation and alpha the view has. Per frame
+ * it allocates nothing.
+ */
+class SwellRider(private val view: View, private val amplitude: Double) :
+    Charge.Listener, View.OnAttachStateChangeListener, Runnable {
+    private val matrix = Matrix()
+    private val out = DoubleArray(3)
+    private val location = IntArray(2)
+    private var swell: Swell? = null
+    private var x = 0.0
+    private var y = 0.0
+
+    init {
+        view.addOnAttachStateChangeListener(this)
+        if (view.isAttachedToWindow) Charge.addListener(this)
+    }
+
+    override fun onViewAttachedToWindow(v: View) {
+        Charge.addListener(this)
+    }
+
+    override fun onViewDetachedFromWindow(v: View) {
+        Charge.removeListener(this)
+        stop()
+    }
+
+    override fun onSwell(swell: Swell) {
+        stop()
+        if (!MotionClock.isLit(view) || view.width == 0) return
+        view.getLocationOnScreen(location)
+        x = (location[0] + view.width / 2.0) / swell.unitPx
+        y = (location[1] + view.height / 2.0) / swell.unitPx
+        this.swell = swell
+        view.postOnAnimation(this)
+    }
+
+    override fun onPower(plugged: Boolean, level: Int, t: Double) {}
+
+    override fun run() {
+        val s = swell ?: return
+        val t = MotionClock.now()
+        s.ride(x, y, amplitude, t, out)
+        matrix.setTranslate((out[0] * s.unitPx).toFloat(), (out[1] * s.unitPx).toFloat())
+        view.setAnimationMatrix(matrix)
+        if (s.isMoving(t)) view.postOnAnimation(this) else stop()
+    }
+
+    private fun stop() {
+        view.removeCallbacks(this)
+        if (swell != null) {
+            swell = null
+            view.setAnimationMatrix(null)
+        }
+    }
+}
+
+/**
+ * Starts [pulse] (the clock's native charge pulse) when the charging wave's crest reaches [view]'s
+ * centre, so the pulse climbs the clock with the wave (MOT-4). [request] is the
+ * native trigger (the clock's charge animation): a wave that has started drives the pulse, and
+ * without one (a cable plugged in again within the ripple's debounce, a charger docked at rest, the
+ * ripple switched off) the pulse runs [Charge.WAIT] after the request.
+ */
+class SwellPulse(private val view: View, private val pulse: Runnable) :
+    Charge.Listener, View.OnAttachStateChangeListener {
+    private val fallback = Runnable { pulse.run() }
+    private val location = IntArray(2)
+    private var handled: Swell? = null
+
+    init {
+        view.addOnAttachStateChangeListener(this)
+        if (view.isAttachedToWindow) Charge.addListener(this)
+    }
+
+    /** The native trigger: pulse with the wave that drives it, or alone if none comes. */
+    fun request() {
+        val recent = Charge.recentSwell(MotionClock.now(), RECENT)
+        if (recent != null) {
+            if (recent !== handled) onSwell(recent)
+            return
+        }
+        view.removeCallbacks(fallback)
+        view.postDelayed(fallback, (Charge.WAIT * 1000).toLong())
+    }
+
+    override fun onSwell(swell: Swell) {
+        handled = swell
+        view.removeCallbacks(fallback)
+        view.removeCallbacks(pulse)
+        if (!view.isShown) return
+        view.getLocationOnScreen(location)
+        val pass =
+            swell.passTimePx(
+                location[0] + view.width * view.scaleX / 2.0,
+                location[1] + view.height * view.scaleY / 2.0,
+            )
+        val delay = Math.max(0L, ((pass - MotionClock.now()) * 1000).toLong())
+        view.postOnAnimationDelayed(pulse, delay)
+    }
+
+    override fun onPower(plugged: Boolean, level: Int, t: Double) {}
+
+    override fun onViewAttachedToWindow(v: View) {
+        Charge.addListener(this)
+    }
+
+    override fun onViewDetachedFromWindow(v: View) {
+        Charge.removeListener(this)
+        view.removeCallbacks(fallback)
+        view.removeCallbacks(pulse)
+    }
+
+    private companion object {
+        /** A wave whose power came in this recently drives the pulse. */
+        const val RECENT = 1.5
+    }
+}
