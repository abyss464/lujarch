+            try {
+                windowManager.removeView(view)
+            } catch (e: IllegalArgumentException) {
+                Log.w(TAG, "held touch: the overlay's window was already gone", e)
+            }
+        }
+        Log.i(
+            ENTRY_TAG,
+            "keyguard touch: $how at ${at / 1000.0} s (uptime)${sinceAuth(at)}, " +
+                "${at - heldAt} ms after it was held, $consumed new pointer(s) consumed; the " +
+                "next touch is free",
