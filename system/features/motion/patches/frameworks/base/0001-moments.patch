+
+/** An app icon for the circle: a notification's small icon (tinted) or a launcher icon (grey). */
+class ChipIcon(val drawable: Drawable, val monochrome: Boolean)
+
+/**
+ * The lockscreen's media (Lujarch, patch 0019), inside the notification stack's media container:
+ * the native card in [cardSlot] (where KeyguardMediaController puts the media host) and the
+ * circle at the card's app icon, drawn here. The layout's height is the media's height at the
+ * current [ChipFrame], so the stack below follows every frame of the morph. The card is clipped
+ * to the shape through its outline and not drawn at all while collapsed, so its seek bar's
+ * squiggle stops asking for frames. A button over the circle's spot takes the taps (and is the
+ * accessibility node) in both states; while the card is not fully out, every other touch passes
+ * to the stack behind.
+ */
+class KeyguardMediaChipLayout(context: Context, private var listener: Listener?) :
+    FrameLayout(context) {
+
+    interface Listener {
+        /** The circle, or the card's app icon spot, was tapped (or clicked by accessibility). */
+        fun onToggle()
+
+        /** The layout became visible or hidden (the media left the lockscreen, the screen). */
+        fun onShownChanged(shown: Boolean)
+
