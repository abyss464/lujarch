+
+package com.android.systemui.surfaceeffects.lujarch
+
+import kotlin.math.cos
+import kotlin.math.exp
+import kotlin.math.hypot
+import kotlin.math.sin
+import kotlin.math.sqrt
+import kotlin.math.tanh
+
+/**
+ * The volume slider as a tank (MOT-7): the water and the shard floating in
+ * it, one physical system, as VolumeOurs computes it.
+ *
+ * The water is the level (the native value spring, given each frame) with a tank's first two
+ * sloshing modes on it, `cos(n pi xi)` across the track, their frequencies from the dispersion
+ * relation at the current depth and forced by the keys (water comes in and goes out at the right
+ * wall, the keys' side) and by the dialog's slide (scaled down: a UI transition is not a shove); a
+ * meniscus climbs the walls.
+ *
+ * The float is a rigid body: the canonical shard, length [FL] and base [FB], with its heavy end in
+ * the tip (the owner's idea: a foam-light body and a tip ballast, solved so its centre of mass lies
+ * [GM0] units nearer the tip than its centre of buoyancy), so it hangs point down with its base out
+ * of the water, a sounding weight. Each substep: gravity at the centre of mass, buoyancy from the
+ * part of its outline under the surface (area and centroid, with the water's vertical
+ * acceleration), the surface's slope pushing it downhill, drag and added mass in its own axes
+ * turned into the world, the accelerating water carrying the added mass, the dialog's frame
+ * acceleration, and contacts with the track's rounded interior.
+ *
+ * Gravity may be tilted ([VolumeTilt]): the rest surface is then the line of the given
+ * slope through the tank's middle. Mode 1 carries its projection on `cos(pi xi)` (as its target, so
+ * a change sloshes), the rest of the line stands with the level, and the float's gravity leans with
+ * it, so it floats at rest anywhere on the tilted surface. Level (slope 0) is the untilted tank.
+ *
+ * Units are the canvas's artboard units (3 px at 420 dpi, [UNITS_PER_DP] per dp), seconds, y down.
+ * One frame is [step]ped per frame time; the float runs [SUBSTEPS] substeps per 120 Hz frame.
+ * Nothing is allocated after construction.
+ */
+class VolumeTank {
+    // ---- the tank: its interior, rounded at the corners ----
+    var x0 = 0.0
+        private set
+
+    var top = 0.0
+        private set
+
+    var width = 35.0
+        private set
+
+    var height = 222.25
+        private set
+
+    var corner = 10.5
+        private set
+
+    // ---- the water: level, rate and acceleration of the level; the modes as springs ----
+    @JvmField val mode1 = FrameSpring(0.0, 0.0, 0.0, 1.0, MODE1_DAMPING)
+    @JvmField val mode2 = FrameSpring(0.0, 0.0, 0.0, 1.0, MODE2_DAMPING)
+    /** The water at the end of the last frame (what is drawn) and at the start of this one. */
+    private val end = WaterState()
+    private val start = WaterState()
+    private val mid = WaterState()
+
+    // ---- the float: its centre of mass, angle (0: tip towards +x) and their rates ----
+    var floatX = 0.0
+        private set
+
+    var floatY = 0.0
+        private set
+
+    var floatAngle = 0.0
+        private set
+
+    var floatVx = 0.0
+        private set
+
+    var floatVy = 0.0
+        private set
+
+    var floatW = 0.0
+        private set
+
+    private var dialogVx = 0.0
+
+    // scratch for one substep: the outline in the world, its depth under the surface, the part
+    // under water
+    private val px = DoubleArray(POINTS)
+    private val py = DoubleArray(POINTS)
+    private val depth = DoubleArray(POINTS)
+    private val subX = DoubleArray(2 * POINTS)
+    private val subY = DoubleArray(2 * POINTS)
+
+    /** The water's level above the bottom, as drawn. */
+    val level: Double
+        get() = end.lvl
+
+    /** How much of the slosh and meniscus shows: none on an empty tank, all from 6 units up. */
+    val fade: Double
+        get() = end.fade
+
+    /** The rest surface's slope (dh/dx, h up), as last stepped. */
+    val tilt: Double
+        get() = end.tl
+
+    /**
+     * Sets the tank's interior: left and top edges, width, height and corner radius. Returns true
+     * when it changed; the caller then places the float afresh ([reset]).
+     */
+    fun setGeometry(
+        x0: Double,
+        top: Double,
+        width: Double,
+        height: Double,
+        corner: Double,
+    ): Boolean {
+        if (
+            x0 == this.x0 &&
+                top == this.top &&
+                width == this.width &&
+                height == this.height &&
+                corner == this.corner
+        ) {
+            return false
+        }
+        this.x0 = x0
+        this.top = top
+        this.width = width
+        this.height = height
+        this.corner = corner
+        return true
+    }
+
+    /**
+     * The water still at [level], at rest on the slope [tilt], and the float hanging point down at
+     * its waterline, settled (a second of substeps).
+     */
+    fun reset(level: Double, tilt: Double = 0.0) {
+        val tl = clampTilt(tilt)
+        mode1.snap(mode1Rest(tl))
+        mode2.snap(0.0)
+        mode1.stiffness = modeK(1, level)
+        mode2.stiffness = modeK(2, level)
+        end.set(level, 0.0, 0.0, mode1, mode2, tl, 0.0)
+        dialogVx = 0.0
+        floatX = x0 + width / 2
+        floatAngle = Math.PI / 2
+        floatY = surfaceY(end, floatX) + (UCM - UW)
+        floatVx = 0.0
+        floatVy = 0.0
+        floatW = 0.0
+        for (k in 0 until SETTLE_STEPS) stepFloat(end, 0.0, 1.0 / SETTLE_STEPS)
+    }
+
+    /**
+     * One frame of [ms] milliseconds (the gap between two frame times). The level is [level] units
+     * above the bottom at the frame's end, rising at [levelVel] units/s; [levelAccStart] is its
+     * acceleration at the frame's start (with this frame's target) and [levelAccEnd] at its end.
+     * [dialogVx] is the dialog's velocity along x at the frame's end, units/s. [tilt] is the rest
+     * surface's slope at the frame's end (dh/dx, [VolumeTilt.tilt]), reached linearly through the
+     * frame.
+     */
+    fun step(
+        ms: Long,
+        level: Double,
+        levelVel: Double,
+        levelAccStart: Double,
+        levelAccEnd: Double,
+        dialogVx: Double,
+        tilt: Double = 0.0,
+    ) {
+        if (ms <= 0) return
+        val dt = ms / 1000.0
+        val tl = clampTilt(tilt)
+        val tv = (tl - end.tl) / dt
+        // the water at the frame's start: last frame's end, with the level's new acceleration and
+        // the slope's rate through this frame
+        start.copyFrom(end)
+        start.la = clampAcc(levelAccStart)
+        start.tv = tv
+        // the slide's acceleration, scaled down
+        val ax = (dialogVx - this.dialogVx) / dt * K_SLIDE
+        this.dialogVx = dialogVx
+        // the modes: frequencies at the new depth; mode 1 tilts with the slide and carries the
+        // rest surface's line, both take the inflow at the right wall
+        mode1.stiffness = modeK(1, level)
+        mode2.stiffness = modeK(2, level)
+        mode1.fin = clampTarget(0.405 * width * ax / GRAV - K_IN * levelVel - P1 * width * tl)
+        mode2.fin = clampTarget(K_IN * levelVel)
+        mode1.step(ms)
+        mode2.step(ms)
+        end.set(level, levelVel, clampAcc(levelAccEnd), mode1, mode2, tl, tv)
+        // the float, through the frame in substeps, the water between its start and end
+        val n = SUBSTEPS * Math.max(1L, Math.round(ms / FRAME_MS)).toInt()
+        for (k in 0 until n) {
+            mid.mix(start, end, (k + 0.5) / n)
+            stepFloat(mid, ax, dt / n)
+        }
+    }
+
+    /**
+     * True when nothing visibly moves this frame: the float and the slosh (as much of it as shows)
+     * still, the level and the dialog at rest (the last frame's inputs). Mode 1 rests on the rest
+     * surface's line (0 when level).
+     */
+    fun isAtRest(): Boolean =
+        Math.abs(end.lv) < REST_LEVEL_VEL &&
+            Math.abs(end.la) < REST_LEVEL_ACC &&
+            dialogVx == 0.0 &&
+            end.fade * Math.abs(mode1.pos - mode1Rest(end.tl)) < REST_MODE &&
+            end.fade * Math.abs(mode1.vel) < REST_MODE_VEL &&
+            end.fade * Math.abs(mode2.pos) < REST_MODE &&
+            end.fade * Math.abs(mode2.vel) < REST_MODE_VEL &&
+            Math.abs(floatVx) < REST_FLOAT_VEL &&
+            Math.abs(floatVy) < REST_FLOAT_VEL &&
+            Math.abs(floatW) < REST_FLOAT_W
+
+    /** The surface's y at [x], as drawn. */
+    fun surfaceY(x: Double): Double = surfaceY(end, x)
+
+    /** The float's base middle (the canonical shard's origin), x. */
+    val floatBaseX: Double
+        get() = floatX - cos(floatAngle) * UCM
+
+    /** The float's base middle, y. */
+    val floatBaseY: Double
+        get() = floatY - sin(floatAngle) * UCM
+
+    private fun surfaceHeight(w: WaterState, x: Double): Double {
+        // the water lies between the walls: a point pressed into a wall reads the wall's surface
+        // (the meniscus grows without bound outside)
+        val x = Math.max(x0, Math.min(x0 + width, x))
+        val xi = (x - x0) / width
+        return w.lvl +
+            w.fade *
+                (w.m1 * cos(Math.PI * xi) +
+                    w.m2 * cos(2 * Math.PI * xi) +
+                    MENISCUS *
+                        (exp(-(x - x0) / MENISCUS_RANGE) +
+                            exp(-(x0 + width - x) / MENISCUS_RANGE)) +
+                    w.tl * width * (xi - 0.5 + P1 * cos(Math.PI * xi)))
+    }
+
+    private fun surfaceY(w: WaterState, x: Double): Double = top + height - surfaceHeight(w, x)
+
+    private fun cosTerms(x: Double, a1: Double, a2: Double): Double {
+        val xi = (x - x0) / width
+        return a1 * cos(Math.PI * xi) + a2 * cos(2 * Math.PI * xi)
+    }
+
+    /** The rest surface's line but for its mode-1 part, at [x], times [a]. */
+    private fun restTerm(x: Double, a: Double): Double {
+        val xi = (x - x0) / width
+        return a * width * (xi - 0.5 + P1 * cos(Math.PI * xi))
+    }
+
+    /** The surface's vertical velocity at [x] (screen y). */
+    private fun waterVel(w: WaterState, x: Double): Double =
+        -(w.lv + w.fade * (cosTerms(x, w.m1v, w.m2v) + restTerm(x, w.tv)))
+
+    /** The surface's vertical acceleration at [x] (screen y). */
+    private fun waterAcc(w: WaterState, x: Double): Double =
+        -(w.la + w.fade * cosTerms(x, w.m1a, w.m2a))
+
+    /** How fast the surface's slope turns at [x]. */
+    private fun slopeRate(w: WaterState, x: Double): Double {
+        val xi = (x - x0) / width
+        return w.fade *
+            (w.m1v * Math.PI / width * sin(Math.PI * xi) +
+                w.m2v * 2 * Math.PI / width * sin(2 * Math.PI * xi) +
+                w.tv * (P1 * Math.PI * sin(Math.PI * xi) - 1))
+    }
+
+    // The float feels the level's acceleration up to [MAX_LEVEL_ACC]: a press gives under 5 g (one
+    // step of the value spring), a jump across the range would throw it against the walls.
+    private fun clampAcc(a: Double): Double = Math.max(-MAX_LEVEL_ACC, Math.min(MAX_LEVEL_ACC, a))
+
+    // A slosh never tilts the surface by more than a quarter of the width (presses and slides stay
+    // under a sixth); a whole range poured in at once would otherwise fling it past the walls.
+    private fun clampTarget(f: Double): Double =
+        Math.max(-MAX_MODE_TARGET * width, Math.min(MAX_MODE_TARGET * width, f))
+
+    /** Mode 1 at rest on the slope [tl]: the line's projection (exactly 0 when level). */
+    private fun mode1Rest(tl: Double): Double = if (tl == 0.0) 0.0 else clampTarget(-P1 * width * tl)
+
+    // The rest surface's slope within a quarter (14 degrees): the phone's gives at most 4 degrees.
+    private fun clampTilt(t: Double): Double =
+        if (t.isNaN()) 0.0 else Math.max(-MAX_TILT, Math.min(MAX_TILT, t))
+
+    private fun modeK(n: Int, depth: Double): Double =
+        (n * Math.PI * GRAV / width) * tanh(n * Math.PI * Math.max(1.0, depth) / width)
+
+    /**
+     * One substep of the float in water [w], the dialog accelerating at [ax], for [dt] seconds.
+     * When many of its points press on the walls at once (a flat side on the bottom) their summed
+     * contact damping would overshoot in one explicit step, so the substep is split among them, at
+     * most [SPLIT_CONTACTS] ways.
+     */
+    private fun stepFloat(w: WaterState, ax: Double, dt: Double) {
+        val contacts = forces(w, ax)
+        if (contacts > peakContacts) peakContacts = contacts
+        if (contacts <= SPLIT_CONTACTS) {
+            integrate(dt)
+        } else {
+            val k = (contacts + SPLIT_CONTACTS - 1) / SPLIT_CONTACTS
+            integrate(dt / k)
+            for (j in 1 until k) {
+                forces(w, ax)
+                integrate(dt / k)
+            }
+        }
+        if (!inBounds()) {
+            rescue(w)
+            rescues++
+        }
+    }
+
+    /**
+     * The most points that pressed on the walls in one substep, how often the float's speed was
+     * limited, how often it was put back.
+     */
+    internal var peakContacts = 0
+    internal var limited = 0
+    internal var rescues = 0
+
+    // the forces of one substep, and the added mass they act against
+    private var fx = 0.0
+    private var fy = 0.0
+    private var torque = 0.0
+    private var mxx = 0.0
+    private var mxy = 0.0
+    private var myy = 0.0
+    private var ia = 0.0
+
+    /**
+     * The forces on the float in water [w], the dialog accelerating at [ax]; returns the contacts.
+     */
+    private fun forces(w: WaterState, ax: Double): Int {
+        val c = cos(floatAngle)
+        val s = sin(floatAngle)
+        for (i in 0 until POINTS) {
+            px[i] = floatX + P0U[i] * c - P0V[i] * s
+            py[i] = floatY + P0U[i] * s + P0V[i] * c
+            depth[i] = py[i] - surfaceY(w, px[i])
+        }
+        // the part under the surface (depth >= 0), clipped where the surface crosses the outline
+        var m = 0
+        for (i in 0 until POINTS) {
+            val j = (i + 1) % POINTS
+            val da = depth[i]
+            val db = depth[j]
+            if (da >= 0) {
+                subX[m] = px[i]
+                subY[m] = py[i]
+                m++
+            }
+            if ((da >= 0) != (db >= 0)) {
+                val q = da / (da - db)
+                subX[m] = px[i] + (px[j] - px[i]) * q
+                subY[m] = py[i] + (py[j] - py[i]) * q
+                m++
+            }
+        }
+        var area = 0.0
+        var bx = 0.0
+        var by = 0.0
+        for (i in 0 until m) {
+            val j = (i + 1) % m
+            val cr = subX[i] * subY[j] - subX[j] * subY[i]
+            area += cr
+            bx += (subX[i] + subX[j]) * cr
+            by += (subY[i] + subY[j]) * cr
+        }
+        if (Math.abs(area) > 1e-9) {
+            bx /= 3 * area
+            by /= 3 * area
+        }
+        area = Math.abs(area) / 2
+        val fw = Math.min(1.0, area / SUB0_AREA)
+        // the submerged length along the shard
+        var us = 0.0
+        if (m > 2) {
+            var lo = 1e9
+            var hi = -1e9
+            for (i in 0 until m) {
+                val uu = (subX[i] - floatX) * c + (subY[i] - floatY) * s
+                lo = Math.min(lo, uu)
+                hi = Math.max(hi, uu)
+            }
+            us = hi - lo
+        }
+        val mau = MA_U * fw
+        val mav = RHO_W * Math.PI * us * us / 8
+        ia = RHO_W * Math.PI * Math.pow(us, 4.0) / 256
+        // the added mass tensor in the world: m_u e_u e_u' + m_v e_v e_v', e_u = (c, s), e_v = (-s,
+        // c)
+        mxx = mau * c * c + mav * s * s
+        mxy = (mau - mav) * c * s
+        myy = mau * s * s + mav * c * c
+        // gravity, leaning with the rest surface's slope; the dialog's acceleration in its frame
+        fx = -MASS * (ax - GRAV * w.tl)
+        fy = MASS * GRAV
+        torque = 0.0
+        if (area > 1e-6) {
+            // the surface's slope over the centre of buoyancy
+            val sl = surfaceY(w, bx + 0.5) - surfaceY(w, bx - 0.5)
+            val buoyX = RHO_W * GRAV * area * sl
+            val buoyY = -RHO_W * (GRAV - waterAcc(w, bx)) * area
+            fx += buoyX
+            fy += buoyY
+            torque += (bx - floatX) * buoyY - (by - floatY) * buoyX
+            // drag relative to the water, along and across the shard, at the centre of buoyancy
+            val rvx = floatVx - floatW * (by - floatY)
+            val rvy = floatVy + floatW * (bx - floatX) - waterVel(w, bx)
+            val vu = rvx * c + rvy * s
+            val vv = -rvx * s + rvy * c
+            val fu = -CU * fw * vu
+            val fv = -CV * us * vv
+            val dx = fu * c - fv * s
+            val dy = fu * s + fv * c
+            fx += dx
+            fy += dy
+            torque += (bx - floatX) * dy - (by - floatY) * dx
+            torque += -CR * Math.pow(us, 3.0) * (floatW - slopeRate(w, floatX))
+            // the accelerating water carries its added mass
+            val wa = waterAcc(w, floatX)
+            fx += mxy * wa
+            fy += myy * wa
+        }
+        // contacts with the track's rounded interior
+        var contacts = 0
+        for (i in 0 until POINTS) {
+            val x = px[i]
+            val y = py[i]
+            val xa = x0 + corner
+            val xb = x0 + width - corner
+            val ya = top + corner
+            val yb = top + height - corner
+            val qx = Math.min(Math.max(x, xa), xb)
+            val qy = Math.min(Math.max(y, ya), yb)
+            val ddx = x - qx
+            val ddy = y - qy
+            val d = hypot(ddx, ddy)
+            if (d < 1e-9) continue
+            val pen = d - corner
+            if (pen <= 0) continue
+            val nx = ddx / d
+            val ny = ddy / d
+            val rx = x - floatX
+            val ry = y - floatY
+            val vx = floatVx - floatW * ry
+            val vy = floatVy + floatW * rx
+            val vn = vx * nx + vy * ny
+            val vt = -vx * ny + vy * nx
+            val fn = -KC * pen - CC * vn
+            val cfx = fn * nx + MU * vt * ny
+            val cfy = fn * ny - MU * vt * nx
+            fx += cfx
+            fy += cfy
+            torque += rx * cfy - ry * cfx
+            contacts++
+        }
+        return contacts
+    }
+
+    /** Moves the float by the last [forces] for [dt] seconds. */
+    private fun integrate(dt: Double) {
+        val x1 = floatX
+        val y1 = floatY
+        val a1 = floatAngle
+        val a11 = MASS + mxx
+        val a12 = mxy
+        val a22 = MASS + myy
+        val det = a11 * a22 - a12 * a12
+        floatVx += (a22 * fx - a12 * fy) / det * dt
+        floatVy += (a11 * fy - a12 * fx) / det * dt
+        floatW += torque / (INERTIA + ia) * dt
+        // A terminal speed: the drag is linear and light along the shard, as fits a press (a
+        // pressed float stays under 250 units/s and 11 rad/s); a drag that starts far from the
+        // level puts it deep under water at once, and it would shoot out of the water and ring
+        // round the tank.
+        val v2 = floatVx * floatVx + floatVy * floatVy
+        if (v2 > MAX_SPEED * MAX_SPEED) {
+            val k = MAX_SPEED / sqrt(v2)
+            floatVx *= k
+            floatVy *= k
+            limited++
+        }
+        if (Math.abs(floatW) > MAX_SPIN) {
+            floatW = Math.copySign(MAX_SPIN, floatW)
+            limited++
+        }
+        floatX += floatVx * dt
+        floatY += floatVy * dt
+        floatAngle += floatW * dt
+        if (!(floatX + floatY + floatAngle + floatVx + floatVy + floatW).isFinite()) {
+            // never break the dialog: back to the last good pose, at rest
+            floatX = x1
+            floatY = y1
+            floatAngle = a1
+            floatVx = 0.0
+            floatVy = 0.0
+            floatW = 0.0
+        }
+    }
+
+    /** False when the float has left the tank (which nothing a slider gives should do). */
+    private fun inBounds(): Boolean =
+        floatX > x0 - ESCAPE &&
+            floatX < x0 + width + ESCAPE &&
+            floatY > top - ESCAPE &&
+            floatY < top + height + ESCAPE
+
+    /** Puts the float back, hanging point down at the surface of [w] within the tank, at rest. */
+    private fun rescue(w: WaterState) {
+        floatX = x0 + width / 2
+        floatAngle = Math.PI / 2
+        floatY =
+            Math.max(
+                top + UCM + 1,
+                Math.min(surfaceY(w, floatX) + (UCM - UW), top + height - (FL - UCM) - 1),
+            )
+        floatVx = 0.0
+        floatVy = 0.0
+        floatW = 0.0
+    }
+
+    /** The water's state: level, its rate and acceleration, the modes with theirs, the fade. */
+    private class WaterState {
+        @JvmField var lvl = 0.0
+        @JvmField var lv = 0.0
+        @JvmField var la = 0.0
+        @JvmField var m1 = 0.0
+        @JvmField var m1v = 0.0
+        @JvmField var m1a = 0.0
+        @JvmField var m2 = 0.0
+        @JvmField var m2v = 0.0
+        @JvmField var m2a = 0.0
+        @JvmField var fade = 0.0
+        /** The rest surface's slope and its rate (constant through a frame). */
+        @JvmField var tl = 0.0
+        @JvmField var tv = 0.0
+
+        fun set(
+            level: Double,
+            vel: Double,
+            acc: Double,
+            mode1: FrameSpring,
+            mode2: FrameSpring,
+            tilt: Double,
+            tiltRate: Double,
+        ) {
+            lvl = level
+            lv = vel
+            la = acc
+            m1 = mode1.pos
+            m1v = mode1.vel
+            m1a = springAcc(mode1.pos, mode1.vel, mode1.fin, mode1.stiffness, mode1.damping)
+            m2 = mode2.pos
+            m2v = mode2.vel
+            m2a = springAcc(mode2.pos, mode2.vel, mode2.fin, mode2.stiffness, mode2.damping)
+            fade = Math.min(1.0, level / FADE_DEPTH)
+            tl = tilt
+            tv = tiltRate
+        }
+
+        fun copyFrom(o: WaterState) {
+            lvl = o.lvl
+            lv = o.lv
+            la = o.la
+            m1 = o.m1
+            m1v = o.m1v
+            m1a = o.m1a
+            m2 = o.m2
+            m2v = o.m2v
+            m2a = o.m2a
+            fade = o.fade
+            tl = o.tl
+            tv = o.tv
+        }
+
+        fun mix(a: WaterState, b: WaterState, f: Double) {
+            lvl = a.lvl + (b.lvl - a.lvl) * f
+            lv = a.lv + (b.lv - a.lv) * f
+            la = a.la + (b.la - a.la) * f
+            m1 = a.m1 + (b.m1 - a.m1) * f
+            m1v = a.m1v + (b.m1v - a.m1v) * f
+            m1a = a.m1a + (b.m1a - a.m1a) * f
+            m2 = a.m2 + (b.m2 - a.m2) * f
+            m2v = a.m2v + (b.m2v - a.m2v) * f
+            m2a = a.m2a + (b.m2a - a.m2a) * f
+            fade = a.fade + (b.fade - a.fade) * f
+            tl = a.tl + (b.tl - a.tl) * f
+            tv = a.tv + (b.tv - a.tv) * f
+        }
+    }
+
+    companion object {
+        /** Artboard units per dp at the design's 420 dpi: 1 dp = 2.625 px = 0.875 units. */
+        const val UNITS_PER_DP = 0.875
+
+        /**
+         * Gravity, units/s^2: the tank seen as a large one, so the float and the water share a
+         * scale.
+         */
+        const val GRAV = 2800.0
+        const val RHO_W = 1.0
+        /** How much of the dialog's slide reaches the water. */
+        const val K_SLIDE = 0.01
+        /** The inflow at the right wall: the modes' targets per unit/s of the level's rate. */
+        const val K_IN = 0.008
+        const val MODE1_DAMPING = 0.08
+        const val MODE2_DAMPING = 0.1
+        /** The meniscus: its height at the wall and how far it reaches. */
+        const val MENISCUS = 1.3
+        const val MENISCUS_RANGE = 1.8
+        /** The slosh and meniscus fade in over the first units of depth. */
+        const val FADE_DEPTH = 6.0
+        /**
+         * A line across the tank projected on mode 1, `cos(pi xi)`: 4 / pi^2 of its slope times the
+         * width.
+         */
+        const val P1 = 4 / (Math.PI * Math.PI)
+        /** The largest rest-surface slope taken. */
+        const val MAX_TILT = 0.25
+
+        /** The float: the canonical shard, length and base width. */
+        const val FL = 22.0
+        const val FB = 9.0
+        /** Its resting waterline, from the base, and its ballast, from the base. */
+        const val UW = 0.4 * FL
+        const val U_TIP = 0.94 * FL
+        /** The centre of mass lies this much nearer the tip than the centre of buoyancy. */
+        const val GM0 = 2.0
+
+        /** Substeps of the float per 120 Hz frame, and the settling before the first frame. */
+        const val SUBSTEPS = 16
+        const val SETTLE_STEPS = 960
+        private const val FRAME_MS = 1000.0 / 120
+
+        // drag along and across the shard, rotational drag
+        private const val CU = 40.0
+        private const val CV = 70.0
+        private const val CR = 1.2
+        // contacts: penalty stiffness and viscous friction
+        private const val KC = 1e6
+        private const val MU = 300.0
+        /** More points pressing on the walls than this split a substep among them. */
+        const val SPLIT_CONTACTS = 4
+        // the modes' targets, as a fraction of the width; the level's acceleration, units/s^2
+        private const val MAX_MODE_TARGET = 0.25
+        private const val MAX_LEVEL_ACC = 6 * GRAV
+        // the float's terminal speed (units/s) and spin (rad/s); beyond ESCAPE units outside the
+        // tank it is put back
+        private const val MAX_SPEED = 800.0
+        private const val MAX_SPIN = 40.0
+        private const val ESCAPE = 10.0
+
+        // at rest: the slosh under a hundredth of a unit (0.03 px), nothing moving faster than a
+        // twentieth of a unit (0.15 px) a second
+        private const val REST_LEVEL_VEL = 1e-3
+        private const val REST_LEVEL_ACC = 1e-2
+        private const val REST_MODE = 1e-2
+        private const val REST_MODE_VEL = 5e-2
+        private const val REST_FLOAT_VEL = 5e-2
+        private const val REST_FLOAT_W = 2e-3
+
+        /**
+         * The canonical shard's outline (SymbolData.CANON_FACET_A and _B): tip to the right base
+         * corner, on to the base's middle, to the left base corner, back to the tip; four cubics.
+         */
+        internal val OUTLINE =
+            arrayOf(
+                doubleArrayOf(0.0, -1.0, 0.0305, -0.6123, 0.1522, -0.1882, 0.401, 0.0869),
+                doubleArrayOf(0.401, 0.0869, 0.2566, 0.029, 0.1283, -0.0, -0.0, 0.0),
+                doubleArrayOf(-0.0, 0.0, -0.1283, -0.0, -0.2566, 0.029, -0.401, 0.0869),
+                doubleArrayOf(-0.401, 0.0869, -0.1522, -0.1882, -0.0305, -0.6123, 0.0, -1.0),
+            )
+        private const val PER_CUBIC = 6
+        const val POINTS = 4 * PER_CUBIC
+
+        /** The outline in body axes: u from the base's middle to the tip, v across. */
+        private val POLY_U = DoubleArray(POINTS)
+        private val POLY_V = DoubleArray(POINTS)
+
+        /** Point [i] of the outline in body axes, u (from the base's middle to the tip). */
+        @JvmStatic fun polyU(i: Int): Double = POLY_U[i]
+
+        /** Point [i] of the outline in body axes, v (across). */
+        @JvmStatic fun polyV(i: Int): Double = POLY_V[i]
+
+        /** The float's area, its centroid (u), the submerged area at rest. */
+        @JvmField val AREA: Double
+        @JvmField val CENTROID_U: Double
+        @JvmField val CENTROID_V: Double
+        /** The second moment of area about the centroid. */
+        @JvmField val J: Double
+        @JvmField val SUB0_AREA: Double
+        /** The centre of buoyancy at rest (u). */
+        @JvmField val COB: Double
+        /** The mass: the water the tip side displaces below the resting waterline. */
+        @JvmField val MASS: Double
+        /** The body's density (foam-light) and the tip ballast. */
+        @JvmField val RHO_B: Double
+        @JvmField val M_TIP: Double
+        /** The centre of mass (u) and the moment of inertia about it. */
+        @JvmField val UCM: Double
+        @JvmField val INERTIA: Double
+        // added mass along the shard; contact damping per vertex, stable at 16 substeps a frame
+        private val MA_U: Double
+        private val CC: Double
+
+        /** The outline about the centre of mass, body axes. */
+        private val P0U = DoubleArray(POINTS)
+        private val P0V = DoubleArray(POINTS)
+
+        init {
+            var n = 0
+            for (seg in OUTLINE) {
+                for (k in 1..PER_CUBIC) {
+                    val t = k.toDouble() / PER_CUBIC
+                    val m = 1 - t
+                    val cx =
+                        m * m * m * seg[0] +
+                            3 * m * m * t * seg[2] +
+                            3 * m * t * t * seg[4] +
+                            t * t * t * seg[6]
+                    val cy =
+                        m * m * m * seg[1] +
+                            3 * m * m * t * seg[3] +
+                            3 * m * t * t * seg[5] +
+                            t * t * t * seg[7]
+                    POLY_U[n] = -cy * FL
+                    POLY_V[n] = cx * FB / (2 * SymbolData.CANON_BASE_HALF_WIDTH)
+                    n++
+                }
+            }
+            val whole = DoubleArray(3)
+            areaOf(POLY_U, POLY_V, POINTS, whole)
+            AREA = whole[0]
+            CENTROID_U = whole[1]
+            CENTROID_V = whole[2]
+            var j = 0.0
+            for (i in 0 until POINTS) {
+                val q = (i + 1) % POINTS
+                val au = POLY_U[i] - CENTROID_U
+                val av = POLY_V[i] - CENTROID_V
+                val bu = POLY_U[q] - CENTROID_U
+                val bv = POLY_V[q] - CENTROID_V
+                val cr = au * bv - bu * av
+                j += cr * (au * au + au * bu + bu * bu + av * av + av * bv + bv * bv)
+            }
+            J = Math.abs(j) / 12
+            // the tip side beyond the resting waterline
+            val su = DoubleArray(2 * POINTS)
+            val sv = DoubleArray(2 * POINTS)
+            var m = 0
+            for (i in 0 until POINTS) {
+                val q = (i + 1) % POINTS
+                val dp = POLY_U[i] - UW
+                val dq = POLY_U[q] - UW
+                if (dp >= 0) {
+                    su[m] = POLY_U[i]
+                    sv[m] = POLY_V[i]
+                    m++
+                }
+                if ((dp >= 0) != (dq >= 0)) {
+                    val f = dp / (dp - dq)
+                    su[m] = POLY_U[i] + (POLY_U[q] - POLY_U[i]) * f
+                    sv[m] = POLY_V[i] + (POLY_V[q] - POLY_V[i]) * f
+                    m++
+                }
+            }
+            val sub0 = DoubleArray(3)
+            areaOf(su, sv, m, sub0)
+            SUB0_AREA = sub0[0]
+            COB = sub0[1]
+            MASS = RHO_W * SUB0_AREA
+            RHO_B = Math.max(0.03, MASS * (COB + GM0 - U_TIP) / (AREA * (CENTROID_U - U_TIP)))
+            M_TIP = MASS - RHO_B * AREA
+            UCM = (RHO_B * AREA * CENTROID_U + M_TIP * U_TIP) / MASS
+            INERTIA =
+                RHO_B *
+                    (J +
+                        AREA *
+                            ((CENTROID_U - UCM) * (CENTROID_U - UCM) + CENTROID_V * CENTROID_V)) +
+                    M_TIP * (U_TIP - UCM) * (U_TIP - UCM)
+            for (i in 0 until POINTS) {
+                P0U[i] = POLY_U[i] - UCM
+                P0V[i] = POLY_V[i]
+            }
+            MA_U = 0.1 * MASS
+            CC = 2 * 0.25 * sqrt(KC * MASS)
+        }
+
+        /** A polygon's area and centroid into [out] (area, u, v); zero for a degenerate one. */
+        private fun areaOf(u: DoubleArray, v: DoubleArray, n: Int, out: DoubleArray) {
+            var a = 0.0
+            var cu = 0.0
+            var cv = 0.0
+            for (i in 0 until n) {
+                val q = (i + 1) % n
+                val cr = u[i] * v[q] - u[q] * v[i]
+                a += cr
+                cu += (u[i] + u[q]) * cr
+                cv += (v[i] + v[q]) * cr
+            }
+            if (Math.abs(a) < 1e-12) {
+                out[0] = 0.0
+                out[1] = 0.0
+                out[2] = 0.0
+            } else {
+                out[0] = Math.abs(a) / 2
+                out[1] = cu / (3 * a)
+                out[2] = cv / (3 * a)
+            }
+        }
+
+        /** A spring's acceleration: `-k (pos - fin) - 2 z sqrt(k) vel`, unit mass. */
+        @JvmStatic
+        fun springAcc(pos: Double, vel: Double, fin: Double, k: Double, z: Double): Double =
+            -k * (pos - fin) - 2 * z * sqrt(k) * vel
+    }
+}
