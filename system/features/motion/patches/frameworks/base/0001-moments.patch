+    fun start() {
+        view.visibility = View.VISIBLE
+        view.setOnHoverListener(null)
+        view.setOnTouchListener(this)
+        view.postDelayed(this, MAX_MS)
+        Log.i(
+            ENTRY_TAG,
+            "keyguard touch: held at ${heldAt / 1000.0} s (uptime)${sinceAuth(heldAt)}, " +
+                "$pointers pointer(s) down; the rest of it and any new pointer of it reach no " +
+                "other window or gesture monitor",
