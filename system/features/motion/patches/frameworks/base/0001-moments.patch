+
+package com.android.systemui.surfaceeffects.lujarch
+
+import android.graphics.Canvas
+import kotlin.math.cos
+import kotlin.math.floor
+import kotlin.math.sin
+
+/**
+ * The symbol on the fingerprint sensor, at rest and as the battery (MOT-2 and
+ * 2.1): the offline charger's gauge on the lockscreen. At rest it breathes and sways. When the
+ * charging wave's crest reaches its lower edge it is lifted off the sensor and grows, gulps, every
+ * shard dims and the charged ones light clockwise from the top, one per 10 %, each with a gulp of
+ * its own; the shard being charged fills from below; it bites once and sinks back onto the sensor,
+ * keeping the gauge while the phone charges. Unplugged, the gauge relights to rest.
+ *
+ * [pose] is a pure function of the events and the time, so a frame is the same whenever it is
+ * drawn: the bite's spring is stepped on a 120 Hz grid from its start each frame (at most
+ * 91 steps), which allocates nothing. Lengths are artboard units, times seconds.
+ */
+class ChargingGauge {
+    private var crest = Double.NaN
+    private var lifted = false
+    private var unplugAt = Double.NaN
+    /** When each rank lights (charged), or NaN. */
+    private val litAt = DoubleArray(SymbolPose.N) { Double.NaN }
+    /** The rank being charged, or -1 (full, or not charging). */
+    private var fillRank = -1
+    private var fillFrom = 0.0
+    private var fillTo = 0.0
+    private var fillAt = 0.0
+    private var glowAt = 0.0
+    private val bite = FrameSpring()
+
+    /** True from the start of charging until it has settled back to rest after the unplug. */
+    val isActive: Boolean
+        get() = !crest.isNaN()
+
+    /** True while the phone charges. */
+    val isCharging: Boolean
+        get() = isActive && unplugAt.isNaN()
+
+    /**
+     * Charging, [level] %: the gauge answers the crest reaching the symbol at [t]. [lift]: the wave
+     * carries it (lift, grow, gulp, bite, sink); false lights the gauge in place (no wave).
+     */
+    fun charge(t: Double, level: Int, lift: Boolean) {
+        crest = t
+        lifted = lift
+        unplugAt = Double.NaN
+        val n = charged(level)
+        for (k in 0 until SymbolPose.N) litAt[k] = if (k < n) lightTime(k) else Double.NaN
+        fillRank = if (n < SymbolPose.N) n else -1
+        fillFrom = 0.0
+        fillTo = fraction(level)
+        fillAt = lightTime(n)
+        glowAt = fillAt
+    }
+
+    /** Charging already, at rest: the gauge as it stands once settled (a view attached late). */
+    fun settle(t: Double, level: Int) {
+        charge(t - SETTLED, level, false)
+    }
+
+    /** The level changed to [level] % at [t] while charging. */
+    fun setLevel(t: Double, level: Int) {
+        if (!isCharging) return
+        val n = charged(level)
+        for (k in 0 until SymbolPose.N) {
+            if (k < n && litAt[k].isNaN()) litAt[k] = Math.max(t, lightTime(k))
+            if (k >= n) litAt[k] = Double.NaN
+        }
+        val rank = if (n < SymbolPose.N) n else -1
+        if (rank != fillRank) {
+            fillRank = rank
+            fillFrom = 0.0
+            fillAt = Math.max(t, lightTime(n))
+            glowAt = fillAt
+        } else {
+            fillFrom = fillFraction(t)
+            fillAt = t
+        }
+        fillTo = fraction(level)
+    }
+
+    /** The power went at [t]. */
+    fun unplug(t: Double) {
+        if (!isActive) return
+        if (t < crest) {
+            crest = Double.NaN
+            return
+        }
+        if (unplugAt.isNaN()) unplugAt = t
+    }
+
+    /** True while something still moves at [t] apart from the breathing and the fill's glow. */
+    fun isMoving(t: Double): Boolean = isActive && (t < crest + SETTLED || !unplugAt.isNaN())
+
+    private fun lightTime(k: Int): Double = crest + 0.38 + 0.05 * k
+
+    private fun fillFraction(t: Double): Double =
+        fillFrom + (fillTo - fillFrom) * SpringResponse.step(t - fillAt, 2.0, 0.7)
+
+    // The gauge's frame (lift, growth, gulps, bite, light and gulps per shard), for [pose] and for
+    // a caller that composes it with the lockscreen's motion (SensorSymbol). Set by [frame].
+    /** The ring's scale (KS at rest). */
+    @JvmField var frameScale = KS
+    /** How far the gauge floats above its rest, units (negative: up). */
+    @JvmField var frameLift = 0.0
+    @JvmField var frameGulp = 1.0
+    /** The bite's ring offset at the gauge's scale. */
+    @JvmField var frameBite = 0.0
+    @JvmField var frameFlash = 0.0
+    /** Each shard's light (by shard index), before the rest's breathing. */
+    @JvmField val frameLit = DoubleArray(SymbolPose.N)
+    /** Each shard's own gulp (by shard index). */
+    @JvmField val frameGulps = DoubleArray(SymbolPose.N)
+    /** How far the unplugged gauge has relit to rest (0..1). */
+    @JvmField var frameBack = 0.0
+
+    /**
+     * Computes the gauge's frame at [t] into the frame fields; [restLit] is the light at rest (with
+     * its breathing). Returns false when the gauge is at rest (nothing charging or settling).
+     */
+    fun frame(t: Double, restLit: Double): Boolean {
+        // Settled back to rest after the unplug: forget it, so the rest pose is exact.
+        if (!unplugAt.isNaN() && t >= unplugAt + RELIGHT && t >= crest + SETTLED) crest = Double.NaN
+        if (crest.isNaN()) {
+            frameScale = KS
+            frameLift = 0.0
+            frameGulp = 1.0
+            frameBite = 0.0
+            frameFlash = 0.0
+            frameBack = 0.0
+            for (i in 0 until SymbolPose.N) {
+                frameLit[i] = restLit
+                frameGulps[i] = 1.0
+            }
+            return false
+        }
+        val ts = crest
+        val tBite = ts + 1.25
+        val tSink = tBite + 0.25
+        var up = 0.0
+        var gr = 0.0
+        var gulpAll = 1.0
+        var r0 = 0.0
+        var flash = 0.0
+        if (lifted) {
+            // rise and sink as two step responses superposed: the buoyant spring's target moves up,
+            // then back down
+            up = SpringResponse.step(t - ts, 1.6, 0.55) - SpringResponse.step(t - tSink, 1.4, 0.7)
+            gr = SpringResponse.step(t - ts, 1.8, 0.6) - SpringResponse.step(t - tSink, 1.5, 0.75)
+            gulpAll = 1 + 0.05 * SpringResponse.bob(t - ts, 2.6, 0.45)
+            flash = SpringResponse.flash(t - tBite, 0.55, 0.14)
+        }
+        frameLift = (LIFT_Y - REST_Y) * up
+        val ks = KS + (KB - KS) * gr
+        if (lifted) r0 = biteRing(t, tBite) * ks / KB
+        frameScale = ks
+        frameGulp = gulpAll
+        frameBite = r0
+        frameFlash = flash
+        val plugged = unplugAt.isNaN() || t < unplugAt
+        val back =
+            if (unplugAt.isNaN()) 0.0 else SpringResponse.ramp(t, unplugAt, unplugAt + RELIGHT)
+        frameBack = back
+        for (i in 0 until SymbolPose.N) {
+            val k = SymbolPose.RANK[i]
+            val lk = litAt[k]
+            frameGulps[i] =
+                if (!lk.isNaN() && plugged) 1 + 0.16 * SpringResponse.bob(t - lk, 3.0, 0.4) else 1.0
+            frameLit[i] =
+                if (t < ts) restLit
+                else if (unplugAt.isNaN() || t < unplugAt) gaugeLit(k, t)
+                else gaugeLit(k, unplugAt) + (restLit - gaugeLit(k, unplugAt)) * back
+        }
+        return true
+    }
+
+    /**
+     * Fills [pose] and [fill] at [t] for the symbol resting at ([cx], [cy]). [breath] (0..1) scales
+     * the breathing and the sway; [litBreath] (0..1) the light's breathing at rest (the lockscreen
+     * breathes its light, the gauge does not).
+     */
+    fun pose(
+        t: Double,
+        cx: Double,
+        cy: Double,
+        breath: Double,
+        litBreath: Double,
+        pose: SymbolPose,
+        fill: GaugeFill,
+    ) {
+        val bf = 1 + 0.02 * breath * sin(2 * Math.PI * t / 2.4)
+        val rot = 2 * breath * sin(2 * Math.PI * t / 4.8)
+        val restLit = 0.75 + 0.05 * litBreath * sin(2 * Math.PI * t / 2.4)
+        fill.rank = -1
+        if (!frame(t, restLit)) {
+            // at rest, as LockscreenOurs places it: the ring at the sensor's size, breathing
+            for (i in 0 until SymbolPose.N) {
+                val rr = (SymbolPose.DIST[i] * KS + 0.0) * bf
+                val a0 = SymbolPose.ANGLE[i] + rot * Math.PI / 180
+                pose.place(i, cx, cy, KS * bf, 0.0, 0.0, rot, dx = cos(a0) * rr, dy = sin(a0) * rr)
+                pose.light(i, restLit, 0.0)
+            }
+            return
+        }
+        val my = cy + frameLift
+        val ks = frameScale
+        val r0 = frameBite
+        val gulpAll = frameGulp
+        val ksAll = ks * bf * gulpAll
+        for (i in 0 until SymbolPose.N) {
+            val rr = (SymbolPose.DIST[i] * ks + r0) * bf * gulpAll
+            val a0 = SymbolPose.ANGLE[i] + rot * Math.PI / 180
+            pose.place(
+                i,
+                cx,
+                my,
+                ksAll,
+                0.0,
+                0.0,
+                rot,
+                dx = cos(a0) * rr,
+                dy = sin(a0) * rr,
+                ds = frameGulps[i],
+            )
+            pose.light(i, frameLit[i], frameFlash)
+        }
+        placeFill(t, pose, fill, rot)
+    }
+
+    /**
+     * The shard being charged, drawn again lit and clipped from below to its fraction, glowing: its
+     * clip and colours from [pose] as posed (the symbol's ring turned [rot]) at [t], from the
+     * frame.
+     */
+    fun placeFill(t: Double, pose: SymbolPose, fill: GaugeFill, rot: Double) {
+        fill.rank = -1
+        val rank = fillRank
+        if (crest.isNaN() || rank < 0 || t < glowAt) return
+        val i = SymbolPose.RANK.indexOf(rank)
+        val ff = fillFraction(t)
+        fill.rank = rank
+        fill.shard = i
+        fill.alpha = (0.75 + 0.25 * sin(2 * Math.PI * (t - glowAt) / 1.2)) * (1 - frameBack)
+        val sc = pose.scale[i]
+        val y0 = pose.y[i] + sc * (BOX_TOP[i] - SymbolData.CENTRE_Y[i])
+        val y1 = pose.y[i] + sc * (BOX_BOTTOM[i] - SymbolData.CENTRE_Y[i])
+        fill.top = y1 - (y1 - y0) * ff
+        val light = pose.light
+        light.facetNormal(SymbolData.NORMAL_A_X[i], SymbolData.NORMAL_A_Y[i], rot)
+        fill.colorA = light.shade(frameFlash, 1.0)
+        light.facetNormal(SymbolData.NORMAL_B_X[i], SymbolData.NORMAL_B_Y[i], rot)
+        fill.colorB = light.shade(frameFlash, 1.0)
+    }
+
+    /**
+     * Rank [k]'s light at [t]: every shard dims from 0.75 to 0.25 over 200 ms from the crest, the
+     * charged ones light to 0.25 + 0.7 step(3 Hz, 0.6).
+     */
+    private fun gaugeLit(k: Int, t: Double): Double {
+        val lk = litAt[k]
+        return if (!lk.isNaN() && t >= lk) 0.25 + 0.7 * SpringResponse.step(t - lk, 3.0, 0.6)
+        else 0.75 - 0.5 * SpringResponse.ramp(t, crest, crest + 0.2)
+    }
+
+    /**
+     * The bite's ring offset at [t] (at the gauge's scale): the jaws part to 10 on 900/0.75 from
+     * 160 ms before [tBite], then snap shut on 2500/0.5; stepped on the 120 Hz grid with
+     * integer-millisecond frame times.
+     */
+    private fun biteRing(t: Double, tBite: Double): Double {
+        bite.snap(0.0)
+        var prev = floor((tBite - 0.16) * 1000).toLong()
+        val n0 = Math.ceil((tBite - 0.16) * FPS).toLong()
+        val n1 = floor(Math.min(t, tBite + 0.6) * FPS).toLong()
+        for (n in n0..n1) {
+            val ms = floor(n * 1000.0 / FPS).toLong()
+            if (n / FPS >= tBite) bite.set(0.0, 2500.0, 0.5) else bite.set(10.0, 900.0, 0.75)
+            bite.step(ms - prev)
+            prev = ms
+        }
+        return bite.pos
+    }
+
+    companion object {
+        /** The symbol's scale on the sensor: the sensor's size. */
+        const val KS = 0.35
+        /** Its scale as the gauge. */
+        const val KB = 0.72
+        /** Where the gauge floats and where it rests (the sensor's centre), units. */
+        const val LIFT_Y = 628.0
+        const val REST_Y = 716.667
+        /** The unplugged gauge relights to rest over this long, seconds. */
+        const val RELIGHT = 0.4
+        /** Long enough for the lift, the bite and the sink to settle, seconds. */
+        const val SETTLED = 6.0
+        private const val FPS = 120.0
+
+        /**
+         * Each shard's box in the symbol's coordinates, top and bottom (the extremes of its facets'
+         * points, to 0.01): the fill's clip runs between them.
+         */
+        @JvmField
+        val BOX_TOP =
+            doubleArrayOf(-21.63, -57.62, -91.87, -65.97, -64.29, -12.23, 18.39, 31.9, 47.84, 12.68)
+        @JvmField
+        val BOX_BOTTOM =
+            doubleArrayOf(12.44, -12.16, -42.19, -32.22, -16.2, 16.85, 52.14, 76.39, 96.51, 31.94)
+
+        private fun charged(level: Int): Int = Math.max(0, Math.min(SymbolPose.N, level / 10))
+
+        private fun fraction(level: Int): Double {
+            val n = level / 10
+            return if (n >= SymbolPose.N) 0.0 else (level - 10 * n) / 10.0
+        }
+    }
+}
+
+/** The gauge's filling shard in a frame: which, where its clip starts, how bright. */
+class GaugeFill {
+    /** The rank being charged, or -1 (nothing to draw). */
+    @JvmField var rank = -1
+    /** Its shard index. */
+    @JvmField var shard = 0
+    /** The clip's top (units): the shard is drawn lit below it. */
+    @JvmField var top = 0.0
+    @JvmField var alpha = 0.0
+    @JvmField var colorA = 0
+    @JvmField var colorB = 0
+
+    /** Draws the fill over a symbol already drawn by [painter] from [pose]. */
+    fun draw(canvas: Canvas, painter: SymbolPainter, pose: SymbolPose, alpha: Double = 1.0) {
+        if (rank < 0 || this.alpha <= 0.0) return
+        val count = canvas.save()
+        canvas.clipRect(-CLIP, top.toFloat(), CLIP, top.toFloat() + CLIP)
+        painter.drawShard(canvas, pose, shard, this.alpha * alpha, colorA, colorB)
+        canvas.restoreToCount(count)
+    }
+
+    private companion object {
+        const val CLIP = 4000f
+    }
+}
