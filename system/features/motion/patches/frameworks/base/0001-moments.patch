+
+package com.android.systemui.animation.lujarch
+
+import android.animation.ValueAnimator
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.database.ContentObserver
+import android.os.Handler
+import android.os.UserHandle
+import android.provider.Settings
+import android.util.Log
+
+/**
+ * Lujarch's moments that have a switch (Settings > Accessibility > Color and motion > Lujarch
+ * motion). A moment whose switch is off leaves its place to Android's own animation, and with
+ * Remove animations on a moment shows its end at once. A moment reads both as it starts, so a
+ * change applies from the next one.
+ */
+enum class Moment(val key: String) {
+    LOCK_SCREEN("lujarch_motion_lock_screen"),
+    CHARGING("lujarch_motion_charging"),
+    BACK_GESTURE("lujarch_motion_back_gesture"),
+    VOLUME("lujarch_motion_volume");
+
+    /** Whether this moment plays for the current user, as [watch] keeps it. */
+    @Volatile
+    var isOn = true
+        private set
+
+    /** Whether this moment plays now: its switch is on and animations are not removed. */
+    fun plays(): Boolean = isOn && animating()
+
+    companion object {
+        private const val TAG = "lujarch_motion"
+
+        /** False while Remove animations is on: a moment jumps to its end. */
+        @JvmStatic fun animating(): Boolean = ValueAnimator.areAnimatorsEnabled()
+
+        /**
+         * Keeps every moment's [isOn] to its setting for the current user from now on, through
+         * setting changes and user switches, on [handler]'s thread.
+         */
+        @JvmStatic
+        fun watch(context: Context, handler: Handler) {
+            val resolver = context.contentResolver
+            val read = Runnable {
+                for (m in entries) {
+                    m.isOn =
+                        Settings.Secure.getIntForUser(resolver, m.key, 1, UserHandle.USER_CURRENT) !=
+                            0
+                }
+                Log.i(TAG, entries.joinToString { "${it.name.lowercase()} ${it.isOn}" })
+            }
+            val observer =
+                object : ContentObserver(handler) {
+                    override fun onChange(selfChange: Boolean) = read.run()
+                }
+            for (m in entries) {
+                resolver.registerContentObserver(
+                    Settings.Secure.getUriFor(m.key),
+                    false,
+                    observer,
+                    UserHandle.USER_ALL,
+                )
+            }
+            context.registerReceiverAsUser(
+                object : BroadcastReceiver() {
+                    override fun onReceive(c: Context, intent: Intent) = read.run()
+                },
+                UserHandle.ALL,
+                IntentFilter(Intent.ACTION_USER_SWITCHED),
+                null,
+                handler,
+            )
+            handler.post(read)
+        }
+    }
+}
diff --git a/packages/SystemUI/animation/src/com/android/systemui/animation/lujarch/SwellViews.kt b/packages/SystemUI/animation/src/com/android/systemui/animation/lujarch/SwellViews.kt
