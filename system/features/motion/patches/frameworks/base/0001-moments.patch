+                    symbol.holdBite(
+                        MotionClock.now(),
+                        t + Entry.FRONT_WAIT + SensorFront.LEAD,
+                    )
+                } else {
+                    symbol.letGo(MotionClock.now(), t + SensorFront.LEAD)
+                }
+        }
+        if (
+            event == Entry.AUTH ||
+                event == Entry.FRONT ||
+                event == Entry.SLEEP ||
+                event == Entry.WAKE
+        ) {
+            placeChanged()
+        }
+        invalidate()
+    }
+
+    /** The sensor's centre on the screen, units. */
+    private fun sensorY(): Double {
+        getLocationOnScreen(location)
+        return location[1] / unitPx + UP
+    }
+
+    override fun onPower(plugged: Boolean, level: Int, t: Double) {
+        if (plugged && !Moment.CHARGING.isOn) {
