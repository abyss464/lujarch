+package com.android.systemui.media.controls.ui.lujarch
+
+import kotlin.math.roundToInt
+
+/*
+ * The lockscreen's media as a circle or as the native card (Lujarch, patch 0019): the owner's
+ * choice, the morph between the two, where the circle sits and which player it shows. Plain
+ * Kotlin without Android types, so design/tests/keyguard-media runs it on the JVM; the views are
+ * KeyguardMediaChipLayout, the wiring KeyguardMediaChipController.
+ */
+
+/** Settings.Secure key of the owner's choice: 1 the card, 0 (the default) the circle. */
+const val KEYGUARD_MEDIA_EXPANDED_SETTING = "lujarch_motion_media_open"
+
+/**
+ * The circle's backdrop opacity over the wallpaper, on the keyguard buttons' colours (surface
+ * container high under an on-surface icon). 0.75 is the least that keeps the icon at 4.5:1 or
+ * more over any wallpaper in both themes (tones 17 under 90 over white, 92 under 10 over black):
+ * 0.70 gives 4.2:1 on a white wallpaper in the dark theme.
+ */
+const val KEYGUARD_MEDIA_BACKDROP_ALPHA = 0.75f
+
+/**
+ * The container transform's timings in ms, the native ones (ActivityTransitionAnimator.TIMINGS):
+ * the shape over [totalMs]; what the shape leaves fades out over [fadeOutMs] after
+ * [fadeOutDelayMs], what it becomes fades in over [fadeInMs] after [fadeInDelayMs].
+ */
+class ChipTimings(
+    val totalMs: Float,
+    val fadeOutDelayMs: Float,
+    val fadeOutMs: Float,
+    val fadeInDelayMs: Float,
+    val fadeInMs: Float,
+)
+
+/** The transform's curves: the shape's (emphasized), the fade out's and the fade in's. */
+class ChipCurves(
+    val shape: (Float) -> Float,
+    val fadeOut: (Float) -> Float,
+    val fadeIn: (Float) -> Float,
+)
+
+/**
+ * One frame of the lockscreen's media: [shape] 0 is the circle and 1 the card (eased), the
+ * circle's icon at [circleAlpha], the card's content at [cardAlpha]. The circle's backdrop fills
+ * the shape under the card while the card is not fully in.
+ */
+data class ChipFrame(val shape: Float, val circleAlpha: Float, val cardAlpha: Float) {
+    val backdropAlpha: Float
+        get() = 1f - cardAlpha
+
+    companion object {
+        val COLLAPSED = ChipFrame(0f, 1f, 0f)
+        val EXPANDED = ChipFrame(1f, 0f, 1f)
+
+        fun at(expanded: Boolean) = if (expanded) EXPANDED else COLLAPSED
+    }
+}
+
+/**
+ * The state machine. [expanded] is the owner's choice (collapsed until the setting is read); a tap
+ * flips it and is persisted by the caller, who calls [writeDone] when the write returns. The
+ * setting's reads apply only when they differ from the choice with no write in flight, so the echo
+ * of a write (or of two quick taps) never flips the state back; the first read lands without a
+ * morph. A change morphs when the caller says the media is shown, else it lands at once; [finish]
+ * lands a running morph (the media left the lockscreen). Main thread only.
+ */
+class KeyguardMediaChipModel(private val timings: ChipTimings, private val curves: ChipCurves) {
+    var expanded = false
+        private set
+
+    var frame = ChipFrame.COLLAPSED
+        private set
+
+    var animating = false
+        private set
+
+    /** The card takes touches only when it is fully out; otherwise only the circle's spot does. */
+    val cardInteractive: Boolean
+        get() = expanded && !animating
+
+    private var from = frame
+    private var settingRead = false
+    private var writesInFlight = 0
+
+    /** A tap on the circle or on the card's app icon: returns the new choice, to persist. */
+    fun tap(animate: Boolean): Boolean {
+        writesInFlight++
+        moveTo(!expanded, animate)
+        return expanded
+    }
+
+    /** The write of a tap's choice has returned (or failed). */
+    fun writeDone() {
+        if (writesInFlight > 0) writesInFlight--
+    }
+
+    /** The setting as read; returns true when it changed the choice. */
+    fun setting(value: Boolean, animate: Boolean): Boolean {
+        val first = !settingRead
+        settingRead = true
+        if (writesInFlight > 0 || value == expanded) return false
+        moveTo(value, animate && !first)
+        return true
+    }
+
+    /** Lands a running morph on the choice. */
+    fun finish() {
+        animating = false
+        frame = ChipFrame.at(expanded)
+        from = frame
+    }
+
+    /**
+     * The running morph [ms] after it started (from wherever the last one was, so a tap during a
+     * morph turns it round without a jump); returns false once it has landed.
+     */
+    fun advance(ms: Float): Boolean {
+        if (!animating) return false
+        if (ms >= timings.totalMs) {
+            finish()
+            return false
+        }
+        val s = curves.shape(fraction(ms, 0f, timings.totalMs))
+        val out = curves.fadeOut(fraction(ms, timings.fadeOutDelayMs, timings.fadeOutMs))
+        val fadeIn = curves.fadeIn(fraction(ms, timings.fadeInDelayMs, timings.fadeInMs))
+        frame =
+            if (expanded) {
+                ChipFrame(
+                    lerp(from.shape, 1f, s),
+                    lerp(from.circleAlpha, 0f, out),
+                    lerp(from.cardAlpha, 1f, fadeIn),
+                )
+            } else {
+                ChipFrame(
+                    lerp(from.shape, 0f, s),
+                    lerp(from.circleAlpha, 1f, fadeIn),
+                    lerp(from.cardAlpha, 0f, out),
+                )
+            }
+        return true
+    }
+
+    private fun moveTo(target: Boolean, animate: Boolean) {
+        expanded = target
+        if (animate) {
+            from = frame
+            animating = true
+        } else {
+            finish()
+        }
+    }
+
+    override fun toString() = "expanded=$expanded animating=$animating frame=$frame"
+}
+
+/**
+ * Where the circle sits and how it grows into the card, in px. The circle is centred on the
+ * card's app icon ([centerX] from the card's start edge, [centerY] from its top); the lockscreen
+ * gives it the same inset below as above, so the collapsed media is [collapsedHeight] tall. The
+ * shape's edges and corner radius follow the eased shape fraction, as the native transform does.
+ */
+class ChipGeometry(
+    val centerX: Float,
+    val centerY: Float,
+    val circleRadius: Float,
+    val cardRadius: Float,
+) {
+    val collapsedHeight: Int
+        get() = (2f * centerY).roundToInt()
+
+    /** The media's height on the lockscreen at [shape], the card being [cardHeight] tall. */
+    fun height(shape: Float, cardHeight: Int): Int =
+        lerp(collapsedHeight.toFloat(), cardHeight.toFloat(), shape).roundToInt()
+
+    /** The circle's centre x in a card [width] px wide. */
+    fun centerX(width: Int, rtl: Boolean): Float = if (rtl) width - centerX else centerX
+
+    /** The shape at [shape] into [out]: left, top, right, bottom, corner radius. */
+    fun bounds(shape: Float, width: Int, cardHeight: Int, rtl: Boolean, out: FloatArray) {
+        val cx = centerX(width, rtl)
+        out[0] = lerp(cx - circleRadius, 0f, shape)
+        out[1] = lerp(centerY - circleRadius, 0f, shape)
+        out[2] = lerp(cx + circleRadius, width.toFloat(), shape)
+        out[3] = lerp(centerY + circleRadius, cardHeight.toFloat(), shape)
+        out[4] = lerp(circleRadius, cardRadius, shape)
+    }
+}
+
+/**
+ * Which player the circle shows when there are several: the one whose card the carousel shows
+ * (the one the card opens on), else the first in the carousel's order, which puts a playing one
+ * first; null without players.
+ */
+fun <T> keyguardMediaChipPlayer(players: List<T>, visibleIndex: Int): T? =
+    players.getOrNull(visibleIndex) ?: players.firstOrNull()
+
+private fun fraction(ms: Float, delay: Float, duration: Float): Float =
+    if (duration <= 0f) {
+        if (ms >= delay) 1f else 0f
+    } else {
+        ((ms - delay) / duration).coerceIn(0f, 1f)
+    }
+
+private fun lerp(a: Float, b: Float, t: Float) = a + (b - a) * t
