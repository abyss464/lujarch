+package com.android.systemui.surfaceeffects.lujarch
+
+import android.graphics.Canvas
+
+/**
+ * The volume slider's water (MOT-7), driven by the native slider: the value
+ * as the slider's own value spring moves it (each frame's value, velocity and target, or a drag's
+ * values), the dialog's slide as a velocity, the phone's gravity as the rest surface's slope
+ * ([VolumeTilt]). Each frame it advances the [VolumeTank] to the frame time and draws it with a
+ * [VolumeTankPainter].
+ *
+ * The level is the track's height times the value's fraction of its range. The value spring's
+ * stiffness and damping ratio give the level's acceleration, which the float feels. Frame gaps are
+ * the frame times' integer milliseconds; a gap after the water rested is
+ * one display frame. Nothing is allocated per frame.
+ */
+class VolumeSliderWater(
+    private val valueStiffness: Double,
+    private val valueDamping: Double,
+    light: SymbolLight = SymbolLight(),
+) {
+    @JvmField val tank = VolumeTank()
+    @JvmField val painter = VolumeTankPainter(light)
+
+    private var min = 0.0
+    private var max = 1.0
+
+    // the value as last given, and whether it came since the last frame
+    private var value = Double.NaN
+    private var velocity = 0.0
+    private var target = Double.NaN
+    private var fresh = false
+    // the rest surface's slope, as last given
+    private var tilt = 0.0
+
+    // the last frame's value and rate (value units), level and rate (tank units)
+    private var lastValue = 0.0
+    private var lastVelocity = 0.0
+    private var lastLevel = 0.0
+    private var lastLevelVel = 0.0
+    private var lastMs = 0L
+    private var started = false
+    private var idle = false
+    private var restFrames = 0
+
+    /** The display's frame interval, ms: the gap of the first frame after the water rested. */
+    var frameIntervalMs = 1000.0 / 120
+
+    /** Remove animations is on: the water stands at the value and the float hangs settled. */
+    var removed = false
+
+    /** True while the water, the float or their inputs move: frames are needed. */
+    var isMoving = false
+        private set
+
+    /** The value's range; a change places the water afresh at the next frame. */
+    fun setRange(min: Double, max: Double) {
+        if (min == this.min && max == this.max) return
+        this.min = min
+        this.max = max
+        started = false
+    }
+
+    /**
+     * The slider's value at rest (the value it shows before anything moves it), if nothing has been
+     * given yet.
+     */
+    fun setInitialValue(value: Double) {
+        if (!this.value.isNaN()) return
+        this.value = value
+        target = value
+        velocity = 0.0
+    }
+
+    /**
+     * The value this frame: the value spring's [value], [velocity] and [target], or a drag's value
+     * with a NaN [velocity] (the rate then comes from the frames).
+     */
+    fun onValue(value: Double, velocity: Double, target: Double) {
+        this.value = value
+        this.velocity = velocity
+        this.target = target
+        fresh = true
+        isMoving = true
+    }
+
+    /**
+     * The rest surface's slope from the phone's gravity ([VolumeTilt.tilt]); a change sloshes the
+     * water, so frames are needed.
+     */
+    fun setTilt(tilt: Double) {
+        if (tilt == this.tilt) return
+        this.tilt = tilt
+        isMoving = true
+    }
+
+    /**
+     * Advances to frame time [nowMs] with the tank's interior ([width], [height], [corner], units,
+     * at the origin) and the dialog moving at [dialogVx] units/s along x, then draws onto [canvas]
+     * in tank units (nothing before the slider has a value and a size).
+     */
+    fun draw(
+        canvas: Canvas,
+        nowMs: Long,
+        width: Double,
+        height: Double,
+        corner: Double,
+        dialogVx: Double,
+    ) {
+        if (advance(nowMs, width, height, corner, dialogVx)) painter.draw(canvas, tank)
+    }
+
+    /** Advances to frame time [nowMs] (see [draw]); false while there is nothing to draw. */
+    fun advance(
+        nowMs: Long,
+        width: Double,
+        height: Double,
+        corner: Double,
+        dialogVx: Double,
+    ): Boolean {
+        if (value.isNaN() || width <= 2 * corner || height <= 2 * corner || max <= min)
+            return started
+        val per = height / (max - min)
+        val level = per * (Math.max(min, Math.min(max, value)) - min)
+        if (removed) {
+            tank.setGeometry(0.0, 0.0, width, height, corner)
+            tank.reset(level, tilt)
+            started = true
+            fresh = false
+            isMoving = false
+            idle = true
+            return true
+        }
+        if (tank.setGeometry(0.0, 0.0, width, height, corner) || !started) {
+            tank.reset(level, tilt)
+            started = true
+            lastMs = nowMs
+            remember(level, 0.0)
+            fresh = false
+            isMoving = dialogVx != 0.0
+            idle = !isMoving
+            restFrames = if (isMoving) 0 else REST_FRAMES
+            return true
+        }
+        var ms = nowMs - lastMs
+        if (ms <= 0) return true
+        lastMs = nowMs
+        // after a rest the frame clock slept: the first frame is one display frame, not the pause
+        if (idle && ms > 1.5 * frameIntervalMs) ms = Math.max(1L, Math.round(frameIntervalMs))
+        ms = Math.min(ms, MAX_GAP_MS)
+        val dt = ms / 1000.0
+        if (fresh && !velocity.isNaN()) {
+            // the value spring: its acceleration at the frame's start (last frame's state, this
+            // frame's target) and end
+            val acc0 =
+                per *
+                    VolumeTank.springAcc(
+                        lastValue,
+                        lastVelocity,
+                        target,
+                        valueStiffness,
+                        valueDamping,
+                    )
+            val acc1 =
+                per * VolumeTank.springAcc(value, velocity, target, valueStiffness, valueDamping)
+            tank.step(ms, level, per * velocity, acc0, acc1, dialogVx, tilt)
+            remember(level, velocity)
+        } else if (fresh) {
+            // a drag: the rate and acceleration from the frames
+            val lv = (level - lastLevel) / dt
+            val la = Math.max(-MAX_DRAG_ACC, Math.min(MAX_DRAG_ACC, (lv - lastLevelVel) / dt))
+            tank.step(ms, level, lv, la, la, dialogVx, tilt)
+            lastValue = value
+            lastVelocity = lv / per
+            lastLevel = level
+            lastLevelVel = lv
+        } else {
+            // nothing new: the value holds still
+            tank.step(ms, level, 0.0, 0.0, 0.0, dialogVx, tilt)
+            remember(level, 0.0)
+        }
+        fresh = false
+        // at rest for a few frames in a row, not just at the turn of a sway
+        restFrames = if (tank.isAtRest()) restFrames + 1 else 0
+        isMoving = restFrames < REST_FRAMES
+        idle = !isMoving
+        return true
+    }
+
+    private fun remember(level: Double, velocity: Double) {
+        lastValue = value
+        lastVelocity = velocity
+        lastLevel = level
+        lastLevelVel = velocity * tank.height / (max - min)
+    }
+
+    companion object {
+        /** The longest frame gap simulated at once; a longer stall is not caught up. */
+        const val MAX_GAP_MS = 50L
+        /** Frames in a row at rest before the water stops asking for frames. */
+        const val REST_FRAMES = 12
+        /** A drag's acceleration is kept within this, units/s^2 (touch samples are uneven). */
+        const val MAX_DRAG_ACC = 4 * VolumeTank.GRAV
+    }
+}
