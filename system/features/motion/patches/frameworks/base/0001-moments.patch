+                    ENTRY_TAG,
+                    "keyguard touch: a new pointer at (${event.getRawX(i).toInt()}, " +
+                        "${event.getRawY(i).toInt()}) px at ${event.eventTime / 1000.0} s " +
+                        "(uptime) is consumed",
+                )
+            }
+            MotionEvent.ACTION_UP -> release("lifted", event.eventTime)
+            MotionEvent.ACTION_CANCEL -> release("cancelled", event.eventTime)
