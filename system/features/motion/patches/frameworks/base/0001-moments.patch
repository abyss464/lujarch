+/**
+ * Lujarch, the volume dialog (MOT-7): the slider's active part is
+ * water and one of the symbol's shards floats in it, its point weighted so it hangs point down (a
+ * sounding weight), one physical system ([VolumeTank]). The slider stays native: its value spring,
+ * steps, icons, haptics and touch; this draws the water behind it over the track's whole length,
+ * from the value spring's frames ([SliderValueObserver]), the dialog's slide
+ * ([VolumeDialogSlideMotion]) and how the phone is held ([VolumeDialogGravity]: the water's rest
+ * surface tilts slightly towards the true down). It ticks with the frame clock while
+ * anything moves, then waits; it stops with the dialog's composition.
+ */
+@Stable
+class VolumeDialogWater(
+    private val slide: VolumeDialogSlideMotion,
+    private val gravity: VolumeDialogGravity,
+) : SliderValueObserver {
+    private val water =
+        VolumeSliderWater(Spring.StiffnessMedium.toDouble(), Spring.DampingRatioNoBouncy.toDouble())
+            .apply { removed = !Moment.animating() }
+    // read by the draw, so every write draws the water again in that frame
+    private val frame = mutableIntStateOf(0)
+    private var waiting: CancellableContinuation<Unit>? = null
+    private val onSlide = Runnable { invalidate() }
+    private val onTilt = Runnable {
+        water.setTilt(gravity.tilt)
+        invalidate()
+    }
+
+    override fun onValue(value: Float, velocity: Float, target: Float) {
+        water.onValue(value.toDouble(), velocity.toDouble(), target.toDouble())
+        invalidate()
+    }
+
+    /** The slider's value range and its value before anything moves it. */
+    fun setValue(value: Float, range: ClosedFloatingPointRange<Float>) {
+        water.setRange(range.start.toDouble(), range.endInclusive.toDouble())
+        water.setInitialValue(value.toDouble())
+    }
+
+    private fun invalidate() {
+        frame.intValue++
+        waiting?.let {
+            waiting = null
+            it.resume(Unit)
+        }
+    }
+
+    /** Runs while the dialog shows: a frame while the water or the dialog moves, else waits. */
+    suspend fun animate(frameIntervalMs: Double) {
+        water.frameIntervalMs = frameIntervalMs
+        slide.addListener(onSlide)
+        gravity.addListener(onTilt)
+        water.setTilt(gravity.tilt)
+        try {
+            while (true) {
+                if (water.isMoving || slide.velocityX != 0f) {
+                    withFrameNanos { frame.intValue++ }
+                } else {
+                    suspendCancellableCoroutine<Unit> { waiting = it }
+                }
+            }
+        } finally {
+            waiting = null
+            slide.removeListener(onSlide)
+            gravity.removeListener(onTilt)
+        }
+    }
+
+    /**
+     * Advances the water to this frame and draws it: the track in [trackColor], the water from
+     * [waterColor], centred in the slider, [TRACK_WIDTH] wide and as long as the slider.
+     */
+    fun draw(scope: DrawScope, trackColor: Color, waterColor: Color) =
+        with(scope) {
+            frame.intValue // subscribes the draw to the frames
+            val unitPx = density / VolumeTank.UNITS_PER_DP.toFloat()
+            val trackPx = TRACK_WIDTH.toPx()
+            water.painter.setColors(trackColor.toArgb(), waterColor.toArgb())
+            drawIntoCanvas {
+                val canvas = it.nativeCanvas
+                val count = canvas.save()
+                canvas.translate((size.width - trackPx) / 2, 0f)
+                canvas.scale(unitPx, unitPx)
+                water.draw(
+                    canvas,
+                    AnimationUtils.currentAnimationTimeMillis(),
+                    (trackPx / unitPx).toDouble(),
+                    (size.height / unitPx).toDouble(),
+                    (TRACK_CORNER.toPx() / unitPx).toDouble(),
+                    (slide.velocityX / unitPx).toDouble(),
+                )
+                canvas.restoreToCount(count)
+            }
+        }
+
+    companion object {
+        /** SliderTrack's trackSize and trackCornerSize, as the native track draws them. */
+        val TRACK_WIDTH = 40.dp
+        val TRACK_CORNER = 12.dp
+    }
+}
+
+/** A [VolumeDialogWater] for this slider, ticking while its composition lives. */
+@Composable
+fun rememberVolumeDialogWater(
+    slide: VolumeDialogSlideMotion,
+    gravity: VolumeDialogGravity,
+    value: Float,
+    range: ClosedFloatingPointRange<Float>,
+): VolumeDialogWater {
+    val water = remember(slide, gravity) { VolumeDialogWater(slide, gravity) }
+    SideEffect { water.setValue(value, range) }
+    val refreshRate = LocalView.current.display?.refreshRate ?: 120f
+    LaunchedEffect(water) { water.animate(1000.0 / refreshRate) }
+    return water
+}
+
+/** Draws [water] behind the slider (see [VolumeDialogWater.draw]). */
+fun Modifier.volumeDialogWater(water: VolumeDialogWater, trackColor: Color, waterColor: Color) =
+    drawBehind {
+        water.draw(this, trackColor, waterColor)
+    }
