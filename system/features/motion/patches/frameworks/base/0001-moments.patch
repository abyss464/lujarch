+/**
+ * The Lujarch symbol on the fingerprint sensor, in place of the fingerprint icon and its disc
+ * (MOT-2, [SensorSymbol]): at rest it breathes and sways while the
+ * lockscreen shows with the screen on; a finger parts its jaws round the white dot and raises rings
+ * of water from the dot's edge; recognised, it bites and lets go as the unlock wave leaves (the bite
+ * holds while the wave waits for what it uncovers), in the icon's place whatever icon the unlock
+ * brings; refused, it takes a kick and dims. On AOD it is still and dim (lit 0.3); from an unlocked
+ * phone it floats up from under the water; the power key's wake frees it last and it shakes the
+ * water off. While the phone charges it is the battery (2.1): the charging wave's crest lifts it
+ * into the offline charger's gauge.
+ *
+ * [DeviceEntryIconView] lays it out larger than the sensor, with the sensor's centre at
+ * ([HALF_WIDTH], [UP]) units from its top left, so its bounds hold the gauge's lift and the rings.
+ * It draws in artboard units (the screen's short side is 360), and per frame it allocates nothing.
+ */
+class DeviceEntrySymbolView(context: Context) :
+    View(context), Charge.Listener, Entry.Listener, Entry.Overlay {
+    private val symbol = SensorSymbol()
+    private val gauge = symbol.gauge
+    private val rings = DwellRings()
+    private val pose = SymbolPose(SymbolLight())
+    private val fill = GaugeFill()
+    private val painter = SymbolPainter()
+    private val ringPainter = WaterPainter()
+    private val deepColor = SymbolLight().deepColor
+    private val location = IntArray(2)
+
+    /** px per artboard unit: the screen's short side is 360 units. */
+    val unitPx: Double =
+        Math.min(resources.displayMetrics.widthPixels, resources.displayMetrics.heightPixels) /
+            360.0
+
+    private var symbolShown = false
+    private var aod = false
+    /** When the lockscreen (not AOD) began to show the symbol: the breathing comes back from it. */
+    private var restSince = Double.NEGATIVE_INFINITY
+    /** When the power came in and no wave has answered yet, or NaN. */
+    private var awaitingWave = Double.NaN
+    private val lightInPlace = Runnable { chargeInPlace() }
+
+    /**
