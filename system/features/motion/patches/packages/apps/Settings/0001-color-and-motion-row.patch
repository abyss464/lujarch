+ * limitations under the License.
+ */
+
+package com.android.settings.accessibility.colorandmotion.ui
+
+import android.content.Context
+import android.content.Intent
+import com.android.settings.R
+import com.android.settingslib.metadata.PreferenceMetadata
+import com.android.settingslib.metadata.UI_ONLY_PREFERENCE
+
+/**
+ * Lujarch motion's row (MOT-2, MOT-4, MOT-6, MOT-7): its page in Lujarch Settings, where the
+ * switch of each of Lujarch's moments is. Lujarch Settings indexes the page for search.
+ */
+class LujarchMotionPreference : PreferenceMetadata {
+    override val key: String
+        get() = KEY
+
+    override val purpose: Int
+        get() = R.string.lujarch_motion_purpose
+
+    override val title: Int
+        get() = R.string.lujarch_motion_title
+
+    override val summary: Int
+        get() = R.string.lujarch_motion_summary
+
+    override val indexable
+        get() = false
+
+    override fun tags(context: Context) = arrayOf(UI_ONLY_PREFERENCE)
+
+    override fun intent(context: Context): Intent? = Intent(ACTION_MOTION)
+
+    companion object {
+        const val KEY = "lujarch_motion"
+        private const val ACTION_MOTION = "org.lujarch.motion.action.MOTION"
+    }
+}
