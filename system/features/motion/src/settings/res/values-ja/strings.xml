<resources>
    <string name="motion_title">Lujarch モーション</string>
    <string name="motion_summary">Android のアニメーションの代わりに Lujarch 独自のアニメーションを再生します</string>
    <string name="motion_color_and_motion">色と動き</string>
    <string name="motion_intro">Lujarch の各モーションは、Android 独自のアニメーションがある場所で再生されます。オフにすると、そこでは Android のアニメーションが再生されます。「アニメーションを無効化」がオンのときは、各モーションの最後の状態がすぐに表示されます。</string>
    <string name="motion_lock_screen">ロック画面と指紋</string>
    <string name="motion_lock_screen_summary">指紋センサー上のマーク、ロックを解除する波、画面のオフとオンのときの水</string>
    <string name="motion_charging">充電</string>
    <string name="motion_charging_summary">充電器から広がる波と、電池のように満ちていくマーク</string>
    <string name="motion_back_gesture">「戻る」ジェスチャー</string>
    <string name="motion_back_gesture_summary">端から引き出された線がダーツになります</string>
    <string name="motion_volume">音量</string>
    <string name="motion_volume_summary">音量スライダーの水と浮かぶ破片</string>
    <string name="motion_keywords">アニメーション, モーション, エフェクト, ロック画面, 指紋, 充電, 戻る, 音量, animation, motion</string>
</resources>
