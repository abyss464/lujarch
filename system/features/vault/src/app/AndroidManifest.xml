<?xml version="1.0" encoding="utf-8"?>
<!--
    Lujarch Vault: KeePass and Aegis reader, 2FA codes, autofill.
    Platform-signed so that it may reach the sync service, not privileged, no launcher
    icon; its one dangerous permission is the camera, asked for when the QR
    scanner opens. Decrypted data lives only in this process.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lujarch.vault">

    <!-- Opening the vault's home directly: Settings (the preferred service's
         gear, as the system uid) passes it; platform-signed apps may hold it. -->
    <permission
        android:name="org.lujarch.vault.permission.OPEN"
        android:description="@string/permission_open_description"
        android:label="@string/permission_open_label"
        android:protectionLevel="signature" />

    <!-- Reveal and copy ask for a fingerprint or the screen lock (BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The clipboard clear is an exact alarm (normal permission, granted at install). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- The QR scanner of new 2FA accounts (ui/ScanActivity.kt). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <!-- Apps with a launcher entry: the list to exclude from autofill. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Document providers: the name of the app a chosen database comes from. -->
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
    </queries>

    <!--
        largeHeap: databases of up to 64 MiB (the KDBX reader's limit) need the
        file, its decrypted payload and the decompressed XML in memory at once,
        more than the default 256 MB heap limit leaves; small databases use no more.
    -->
    <application
        android:name=".VaultApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.LujarchVault">

        <!-- The vault's home: Settings > Passwords & passkeys > Preferred service:
             Lujarch Vault (the autofill service's settings activity). -->
        <activity
            android:name=".ui.VaultActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="org.lujarch.vault.permission.OPEN" />

        <!-- The Quick Settings tile's long press (SystemUI resolves
             QS_TILE_PREFERENCES in the tile's package): the vault's home. It
             answers only that intent, and every page decrypts only while the
             phone is unlocked. -->
        <activity-alias
            android:name=".ui.VaultTileSettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".ui.VaultActivity">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.SubPageActivity"
            android:exported="false" />

        <!-- The QR scanner of the 2FA codes page; its result stays in this process. -->
        <activity
            android:name=".ui.ScanActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- otpauth:// links (sites, other QR scanners): the codes page asks
             before adding the account to the Aegis vault. -->
        <activity
            android:name=".ui.OtpLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="otpauth" />
            </intent-filter>
        </activity>

        <!-- Settings search results: only search and Settings (READ_SEARCH_INDEXABLES) start it. -->
        <activity
            android:name=".ui.SearchResultActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.READ_SEARCH_INDEXABLES"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.lujarch.vault.action.SEARCH_RESULT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Started only through the autofill framework with our own pending intents. -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/app_name"
            android:taskAffinity="" />

        <service
            android:name=".autofill.VaultAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Quick Settings tile: opens the 2FA codes page (unlock first on the
             lock screen); its long press opens the vault's home. -->
        <service
            android:name=".system.CodesTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_codes"
            android:label="@string/codes_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Settings search: titles and keywords of the vault pages (SettingsIntelligence
            reads it). SearchIndexablesProvider refuses to start unless it is exported,
            grants URI permissions and is protected by READ_SEARCH_INDEXABLES.
        -->
        <provider
            android:name=".system.VaultSearchIndexablesProvider"
            android:authorities="org.lujarch.vault.search"
            android:exported="true"
            android:grantUriPermissions="true"
            android:multiprocess="false"
            android:permission="android.permission.READ_SEARCH_INDEXABLES">
            <intent-filter>
                <action android:name="android.content.action.SEARCH_INDEXABLES_PROVIDER" />
            </intent-filter>
        </provider>


        <!-- The clipboard clear's alarm (data/Clipboard.kt). -->
        <receiver
            android:name=".data.ClipboardClearReceiver"
            android:exported="false" />
    </application>
</manifest>
