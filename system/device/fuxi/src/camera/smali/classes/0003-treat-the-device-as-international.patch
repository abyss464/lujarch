+++ b/u7/c.smali
@@ -233,7 +233,7 @@
 
     invoke-virtual {v0, v3}, Ljava/lang/String;->contains(Ljava/lang/CharSequence;)Z
 
-    move-result v0
+    const/4 v0, 0x1
 
     sput-boolean v0, Lu7/c;->m:Z
 
