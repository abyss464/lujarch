<?xml version="1.0" encoding="utf-8"?>
<!--
     The camera's application icon, mipmap/etk: its resource names are obfuscated and it has
     bitmaps for xhdpi to xxxhdpi only, so an anydpi icon of the same name wins at every density.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/aperture_launcher_background" />
    <foreground android:drawable="@drawable/aperture_launcher_foreground" />
    <monochrome android:drawable="@drawable/aperture_launcher_monochrome" />
</adaptive-icon>
