# Xiaomi's camera is platform-signed without a shared user id and runs as platform_app.

# IBGService: offline processing of captures (multi-frame, night, Leica looks).
hal_client_domain(platform_app, vendor_hal_camerapostproc_xiaomi)

# Sensor module information and the P3 colour space switch.
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_camera_p3enable_prop)

# DSP algorithms through libcdsprpc look up their skeletons in /vendor/dsp.
allow platform_app adsprpcd_file:dir { getattr search };
