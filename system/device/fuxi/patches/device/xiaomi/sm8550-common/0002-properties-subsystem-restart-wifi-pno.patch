diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
index b6adce50b9baaf4436ccc4f60725eac7cf1db4ff..385d8c585c5af519e61660ee2542c05f4689ef0f 100644
--- a/sepolicy/vendor/file_contexts
+++ b/sepolicy/vendor/file_contexts
@@ -51,3 +51,10 @@
 /sys/{class,devices/virtual}/thermal/thermal_message/flash_state u:object_r:sys_thermal_flash_state:s0
 /sys/{class,devices/virtual}/thermal/thermal_message/torch_real_level u:object_r:sys_thermal_torch_real_level:s0
 /sys/{class,devices/virtual}/thermal/thermal_message/wifi_limit u:object_r:sys_thermal_wifi_limit:s0
+
+# Subsystem restart nodes ssr_setup writes (qcom sepolicy_vndr labels only
+# the recovery files; ssr_setup also writes coredump for each subsystem
+# and stops at the first denied write).
+/sys/devices/platform/soc/4080000\.remoteproc-mss/remoteproc/remoteproc[0-9]+/coredump      u:object_r:vendor_sysfs_ssr_toggle:s0
+/sys/devices/platform/soc/3000000\.remoteproc-adsp/remoteproc/remoteproc[0-9]+/coredump     u:object_r:vendor_sysfs_ssr_toggle:s0
+/sys/devices/platform/soc/32300000\.remoteproc-cdsp/remoteproc/remoteproc[0-9]+/coredump    u:object_r:vendor_sysfs_ssr_toggle:s0
