diff --git a/init/init.target.rc b/init/init.target.rc
index ee257dc55496c46f15374a541dfa4e5222d95235..d4fd84edcb234711f01e07968585d3ddd1226e09 100644
--- a/init/init.target.rc
+++ b/init/init.target.rc
@@ -182,3 +182,11 @@ service fan_control_turn_off /vendor/bin/fan_service 0
     user root
     disabled
     oneshot
+
+# WLAN firmware and PCSS recovery follow the subsystem restart level, as in
+# the stock init.target.rc.
+on property:persist.vendor.ssr.restart_level=ALL_ENABLE
+    write /sys/kernel/cnss/recovery 3
+
+on property:persist.vendor.ssr.restart_level=ALL_DISABLE
+    write /sys/kernel/cnss/recovery 0
